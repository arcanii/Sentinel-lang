// std::sys::ffi — OS buffer FFI over the `ptr` opaque type (ADR 0057 Phase 1b).
//
// The VALUE-only `std::sys::posix` covers libc calls that take/return the native
// word (`i64`). This module adds the OS-specific calls that take a POINTER +
// length: `getentropy` (POSIX randomness) and `getenv`. The PORTABLE C-string
// helpers (`cstr` / `cstr_len` / `cstr_read`) live in `std::c` (ADR 0057 A8);
// this module `use`s them. The `ptr` opaque type is a raw C address: it is NOT
// dereferenceable in Sentinel and is produced only by `ptr_of(&[u8])` /
// `ptr_of_mut(&mut [u8])` or an FFI return, and consumed only by passing it back
// to an `extern` call.
//
// FFI is the public, unverified boundary: these are NOT constant-time and the
// compiler rejects a `secret` (or a `&[secret u8]` via `ptr_of`) crossing an
// `extern` argument — the FFI fence. A crypto caller that wants OS randomness
// for a secret key takes the PUBLIC bytes here and WIDENS them to `secret` at
// the call site (an explicit, auditable boundary), exactly like the socket /
// declassify boundaries.

use std::c::cstr;
use std::c::cstr_read;

extern "C" {
    // int getentropy(void *buf, size_t buflen) — fill `buf` with `buflen`
    // cryptographically-strong random bytes (buflen <= 256). Returns 0 on
    // success; we treat a valid small buffer as always succeeding. POSIX-only
    // (macOS / Linux); not available on Windows.
    fn getentropy(buf: ptr, len: i64) -> i64;
    // char *getenv(const char *name) — the value of environment variable
    // `name`, or NULL if unset. The returned pointer is owned by the
    // environment (do NOT free it); we copy its bytes out immediately.
    fn getenv(name: ptr) -> ptr;
}

// `n` cryptographically-strong random bytes from the OS (`getentropy`). The
// buffer is a Sentinel `[u8]`; its data pointer crosses to libc via
// `ptr_of_mut` (an exclusive borrow, so C may write through it), and the filled
// buffer is returned. PUBLIC bytes — a caller widens them to `secret` to seed a
// key. `n` should be in 1..=256 (getentropy's limit).
pub fn random_bytes(n: i64) -> [u8] {
    let mut buf: Vec<u8> = vec_new();
    let mut i: i64 = 0;
    while i < n {
        push(&mut buf, i64_to_u8(0));
        i = i + 1;
    }
    let mut bytes: [u8] = vec_to_array(buf);
    getentropy(ptr_of_mut(&mut bytes), n);
    bytes
}

// The value of environment variable `name`, copied into an owned `[u8]`. An
// UNSET variable (and, indistinguishably, an empty one) yields an empty `[u8]`.
// PUBLIC bytes — the FFI boundary; a caller that needs them secret widens them.
pub fn env_get(name: &[u8]) -> [u8] {
    let c: [u8] = cstr(name);
    let v: ptr = getenv(ptr_of(&c));
    cstr_read(v)
}
