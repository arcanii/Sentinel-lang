// std::text::str — text-oriented string functions over `[u8]` (the string type).
//
// These complement `std::bytes` (raw single-byte search/eq) with the higher-level
// operations a "string library" needs: ASCII case folding, trimming, substring search,
// slicing, concatenation, character replacement, lexicographic comparison, decimal
// integer parsing/formatting, padding, and field splitting.
//
// Like `std::bytes`, these are PUBLIC, ordinary (NOT constant-time) operations: they
// branch on and index by byte values, so they must not be used on `secret` data (the
// compiler rejects a secret reaching an `if`/index). Buffers are taken by shared borrow
// (`&[u8]`) so a caller can pass the same string to several of them.
//
// NOTE on splitting: the D.3 `Vec<T>` MVP does not support `Vec<[u8]>`, so `split`
// cannot return a list of substrings. Instead `split_count` + `split_nth` let a caller
// iterate the fields by index — `for i in 0..split_count(s, sep): field = split_nth(...)`.

// ---- ASCII case folding -----------------------------------------------------------

// A copy of `s` with ASCII 'a'..'z' folded to upper case.
pub fn to_upper(s: &[u8]) -> [u8] {
    let n: i64 = len(*s);
    let mut out: Vec<u8> = vec_new();
    let mut i: i64 = 0;
    while i < n {
        let c: i64 = u8_to_i64((*s)[i]);
        let u: i64 = if c >= 97 && c <= 122 { c - 32 } else { c };
        push(&mut out, i64_to_u8(u));
        i = i + 1;
    }
    vec_to_array(out)
}

// A copy of `s` with ASCII 'A'..'Z' folded to lower case.
pub fn to_lower(s: &[u8]) -> [u8] {
    let n: i64 = len(*s);
    let mut out: Vec<u8> = vec_new();
    let mut i: i64 = 0;
    while i < n {
        let c: i64 = u8_to_i64((*s)[i]);
        let l: i64 = if c >= 65 && c <= 90 { c + 32 } else { c };
        push(&mut out, i64_to_u8(l));
        i = i + 1;
    }
    vec_to_array(out)
}

// ---- trimming (ASCII whitespace: space, tab, LF, CR) ------------------------------

fn is_ws(c: i64) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

// The index of the first non-whitespace byte (or `len` if all whitespace).
fn first_non_ws(s: &[u8]) -> i64 {
    let n: i64 = len(*s);
    let mut i: i64 = 0;
    let mut stop: bool = false;
    while i < n && stop == false {
        if is_ws(u8_to_i64((*s)[i])) { i = i + 1; 0 } else { stop = true; 0 };
    }
    i
}

// One past the last non-whitespace byte (or 0 if all whitespace).
fn last_non_ws(s: &[u8]) -> i64 {
    let n: i64 = len(*s);
    let mut j: i64 = n;
    let mut stop: bool = false;
    while j > 0 && stop == false {
        if is_ws(u8_to_i64((*s)[j - 1])) { j = j - 1; 0 } else { stop = true; 0 };
    }
    j
}

fn copy_range(s: &[u8], start: i64, end: i64) -> [u8] {
    let mut out: Vec<u8> = vec_new();
    let mut i: i64 = start;
    while i < end { push(&mut out, (*s)[i]); i = i + 1; }
    vec_to_array(out)
}

pub fn trim_start(s: &[u8]) -> [u8] {
    copy_range(s, first_non_ws(s), len(*s))
}

pub fn trim_end(s: &[u8]) -> [u8] {
    copy_range(s, 0, last_non_ws(s))
}

pub fn trim(s: &[u8]) -> [u8] {
    let a: i64 = first_non_ws(s);
    let b: i64 = last_non_ws(s);
    if a >= b { copy_range(s, 0, 0) } else { copy_range(s, a, b) }
}

// ---- substring search + predicates ------------------------------------------------

// The index of the first occurrence of substring `needle` in `hay`, or -1 if absent.
// (`std::bytes::find` is the single-byte version.) Naive O(n*m) scan.
pub fn find_sub(hay: &[u8], needle: &[u8]) -> i64 {
    let hn: i64 = len(*hay);
    let nn: i64 = len(*needle);
    if nn == 0 {
        0
    } else {
        let mut idx: i64 = 0 - 1;
        let mut i: i64 = 0;
        while i + nn <= hn && idx < 0 {
            let mut matched: bool = true;
            let mut j: i64 = 0;
            while j < nn && matched {
                if (*hay)[i + j] != (*needle)[j] { matched = false; 0 } else { 0 };
                j = j + 1;
            }
            if matched { idx = i; 0 } else { 0 };
            i = i + 1;
        }
        idx
    }
}

pub fn contains_sub(hay: &[u8], needle: &[u8]) -> bool {
    find_sub(hay, needle) >= 0
}

// Whether `s` ends with `suffix`.
pub fn ends_with(s: &[u8], suffix: &[u8]) -> bool {
    let sn: i64 = len(*s);
    let fn_: i64 = len(*suffix);
    if fn_ > sn {
        false
    } else {
        let mut ok: bool = true;
        let mut i: i64 = 0;
        while i < fn_ {
            if (*s)[sn - fn_ + i] != (*suffix)[i] { ok = false; 0 } else { 0 };
            i = i + 1;
        }
        ok
    }
}

// ---- slicing / building -----------------------------------------------------------

// A copy of up to `n` bytes of `s` starting at `start` (bounds are clamped).
pub fn substr(s: &[u8], start: i64, n: i64) -> [u8] {
    let sn: i64 = len(*s);
    let a: i64 = if start < 0 { 0 } else { if start > sn { sn } else { start } };
    let want: i64 = a + n;
    let b: i64 = if want > sn { sn } else { want };
    copy_range(s, a, b)
}

// `a` followed by `b`.
pub fn concat(a: &[u8], b: &[u8]) -> [u8] {
    let mut out: Vec<u8> = vec_new();
    let an: i64 = len(*a);
    let bn: i64 = len(*b);
    let mut i: i64 = 0;
    while i < an { push(&mut out, (*a)[i]); i = i + 1; }
    let mut j: i64 = 0;
    while j < bn { push(&mut out, (*b)[j]); j = j + 1; }
    vec_to_array(out)
}

// `s` repeated `n` times.
pub fn repeat_str(s: &[u8], n: i64) -> [u8] {
    let sn: i64 = len(*s);
    let mut out: Vec<u8> = vec_new();
    let mut r: i64 = 0;
    while r < n {
        let mut i: i64 = 0;
        while i < sn { push(&mut out, (*s)[i]); i = i + 1; }
        r = r + 1;
    }
    vec_to_array(out)
}

// A copy of `s` with every byte equal to `from` replaced by `to`.
pub fn replace_char(s: &[u8], from: u8, to: u8) -> [u8] {
    let n: i64 = len(*s);
    let mut out: Vec<u8> = vec_new();
    let mut i: i64 = 0;
    while i < n {
        let c: u8 = (*s)[i];
        if c == from { push(&mut out, to); 0 } else { push(&mut out, c); 0 };
        i = i + 1;
    }
    vec_to_array(out)
}

// Lexicographic byte comparison: -1 if a < b, 0 if equal, 1 if a > b.
pub fn compare(a: &[u8], b: &[u8]) -> i64 {
    let an: i64 = len(*a);
    let bn: i64 = len(*b);
    let m: i64 = if an < bn { an } else { bn };
    let mut i: i64 = 0;
    let mut r: i64 = 0;
    while i < m && r == 0 {
        let ca: i64 = u8_to_i64((*a)[i]);
        let cb: i64 = u8_to_i64((*b)[i]);
        if ca < cb { r = 0 - 1; 0 } else { if ca > cb { r = 1; 0 } else { 0 } };
        i = i + 1;
    }
    if r != 0 {
        r
    } else {
        if an < bn { 0 - 1 } else { if an > bn { 1 } else { 0 } }
    }
}

// ---- decimal integer parsing + formatting -----------------------------------------

// Parse a leading optional '-' then decimal digits; stops at the first non-digit.
// Returns 0 for an empty / non-numeric string.
pub fn parse_int(s: &[u8]) -> i64 {
    let n: i64 = len(*s);
    let mut i: i64 = 0;
    let mut neg: bool = false;
    if n > 0 && u8_to_i64((*s)[0]) == 45 { neg = true; i = 1; 0 } else { 0 };
    let mut acc: i64 = 0;
    let mut stop: bool = false;
    while i < n && stop == false {
        let c: i64 = u8_to_i64((*s)[i]);
        if c >= 48 && c <= 57 { acc = acc * 10 + (c - 48); i = i + 1; 0 } else { stop = true; 0 };
    }
    if neg { 0 - acc } else { acc }
}

// Format `n` as a decimal string (handles zero and negatives). No `%` operator, so the
// last digit is `m - (m / 10) * 10`.
pub fn int_to_str(n: i64) -> [u8] {
    if n == 0 {
        let mut z: Vec<u8> = vec_new();
        push(&mut z, i64_to_u8(48));
        vec_to_array(z)
    } else {
        let neg: bool = n < 0;
        let mut m: i64 = if neg { 0 - n } else { n };
        let mut digs: Vec<u8> = vec_new();
        let mut count: i64 = 0;
        while m > 0 {
            let d: i64 = m - (m / 10) * 10;
            push(&mut digs, i64_to_u8(48 + d));
            m = m / 10;
            count = count + 1;
        }
        let mut out: Vec<u8> = vec_new();
        if neg { push(&mut out, i64_to_u8(45)); 0 } else { 0 };
        let mut i: i64 = count - 1;
        while i >= 0 { push(&mut out, digs[i]); i = i - 1; }
        vec_to_array(out)
    }
}

// ---- splitting (by index, since Vec<[u8]> is unavailable) --------------------------

// The number of fields `s` splits into on byte `sep` (= occurrences of `sep` + 1).
pub fn split_count(s: &[u8], sep: u8) -> i64 {
    let n: i64 = len(*s);
    let mut c: i64 = 1;
    let mut i: i64 = 0;
    while i < n {
        if (*s)[i] == sep { c = c + 1; 0 } else { 0 };
        i = i + 1;
    }
    c
}

// The `k`-th field (0-indexed) of `s` split on byte `sep`. Out-of-range `k` yields "".
pub fn split_nth(s: &[u8], sep: u8, k: i64) -> [u8] {
    let n: i64 = len(*s);
    let mut field: i64 = 0;
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    // advance `start` to the beginning of field `k`
    while i < n && field < k {
        if (*s)[i] == sep { field = field + 1; start = i + 1; 0 } else { 0 };
        i = i + 1;
    }
    if field < k {
        copy_range(s, 0, 0)
    } else {
        // scan to the end of field `k` (next sep or end of string)
        let mut end: i64 = start;
        let mut stop: bool = false;
        while end < n && stop == false {
            if (*s)[end] == sep { stop = true; 0 } else { end = end + 1; 0 };
        }
        copy_range(s, start, end)
    }
}

// ---- padding ----------------------------------------------------------------------

// Left-pad `s` with `fill` to at least `width` bytes (no-op if already long enough).
pub fn pad_start(s: &[u8], width: i64, fill: u8) -> [u8] {
    let n: i64 = len(*s);
    let mut out: Vec<u8> = vec_new();
    let mut p: i64 = n;
    while p < width { push(&mut out, fill); p = p + 1; }
    let mut i: i64 = 0;
    while i < n { push(&mut out, (*s)[i]); i = i + 1; }
    vec_to_array(out)
}

// Right-pad `s` with `fill` to at least `width` bytes.
pub fn pad_end(s: &[u8], width: i64, fill: u8) -> [u8] {
    let n: i64 = len(*s);
    let mut out: Vec<u8> = vec_new();
    let mut i: i64 = 0;
    while i < n { push(&mut out, (*s)[i]); i = i + 1; }
    let mut p: i64 = n;
    while p < width { push(&mut out, fill); p = p + 1; }
    vec_to_array(out)
}
