// std::security::x25519 — constant-time X25519 (RFC 7748), the ECDH primitive.
//
// X25519 multiplies a SECRET scalar (a private key) by a u-coordinate (a public
// key) on Curve25519, the operation at the heart of modern key exchange (TLS 1.3,
// Signal, WireGuard). The result is the SECRET shared point. The headline is the
// Montgomery ladder: a naive ladder BRANCHES on the bits of the secret scalar
// (`if bit { swap } `), which leaks the private key through timing — the classic
// reason a textbook ECDH is broken in practice. In Sentinel that does not compile:
// a secret reaching an `if`/`while` condition is rejected by the constant-time
// check. So the ladder's conditional swap is the branch-free, mask-based
// `sel25519`, and a successful build is itself a proof that the whole scalar
// multiplication is constant-time in the secret scalar — every loop runs a fixed
// number of iterations and no secret bit ever steers control flow or a memory
// access.
//
// Field arithmetic (the constant-time idioms):
//   * GF(2^255-19) elements are 16 limbs of radix 2^16 held in `secret i64`. This
//     representation keeps the whole field multiply within `i64`: the schoolbook
//     accumulator (a sum of ~16 limb products, then the 2^256 ≡ 38 fold) peaks
//     around 2^43, far below 2^63 — so it needs no 128-bit arithmetic, just a plain
//     schoolbook product reduced with the 38 fold. (This is the TweetNaCl
//     representation.)
//   * Carry propagation needs an ARITHMETIC right shift on signed limbs, but
//     Sentinel's `>>` is logical (zero-fill, ADR 0048). `arith_shr` reconstructs it
//     branch-free: shift logically, then OR the sign bits back into the top — so no
//     new operator is needed and the shift stays constant-time (public amount).
//   * Field elements are mutated IN PLACE through `&mut [secret i64]` borrows and
//     never aliased (an in-place `op` and a distinct output are kept separate so the
//     borrow checker is satisfied), the SHA-256 / AES no-move-through-loop idiom.
//
// Scope: this is raw X25519 (RFC 7748 §5) — one scalar multiplication. ECDH is two
// calls (your_private · base → your_public; your_private · their_public → shared).

// Arithmetic right shift of a 64-bit value by a PUBLIC amount, built from logical
// shifts only: `(x >> n)` zero-fills the top n bits, then OR in the sign bit
// broadcast across those top n bits. Branch-free and constant-time.
fn arith_shr(x: secret i64, n: i64) -> secret i64 {
    let sign: secret i64 = 0 - ((x >> 63) & 1);     // all-ones iff x < 0
    (x >> n) | (sign << (64 - n))
}

// A fresh zeroed 16-limb field element.
fn fe_zero() -> [secret i64] {
    let mut v: Vec<secret i64> = vec_new();
    let mut i: i64 = 0;
    while i < 16 { push(&mut v, 0); i = i + 1; }
    vec_to_array(v)
}

// The curve constant a24 = 121665, as a field element (limb 0 = 0xDB41, limb 1 = 1).
fn fe_121665() -> [secret i64] {
    let mut v: Vec<secret i64> = vec_new();
    push(&mut v, 56129);
    push(&mut v, 1);
    let mut i: i64 = 0;
    while i < 14 { push(&mut v, 0); i = i + 1; }
    vec_to_array(v)
}

fn fe_copy(o: &mut [secret i64], a: &[secret i64]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 { (*o)[i] = (*a)[i]; i = i + 1; }
    0
}

// Carry-propagate a 16-limb field element in place (radix 2^16; the top limb's
// carry folds back into limb 0 scaled by 38, since 2^256 ≡ 38 (mod 2^255-19)).
fn car25519(o: &mut [secret i64]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 {
        let c: secret i64 = arith_shr((*o)[i], 16);
        (*o)[i] = (*o)[i] - (c << 16);
        if i < 15 {
            (*o)[i + 1] = (*o)[i + 1] + c;
            0
        } else {
            (*o)[0] = (*o)[0] + 38 * c;
            0
        };
        i = i + 1;
    }
    0
}

// o = a + b  (distinct output).
fn fadd(o: &mut [secret i64], a: &[secret i64], b: &[secret i64]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 { (*o)[i] = (*a)[i] + (*b)[i]; i = i + 1; }
    0
}

// o = a - b  (distinct output).
fn fsub(o: &mut [secret i64], a: &[secret i64], b: &[secret i64]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 { (*o)[i] = (*a)[i] - (*b)[i]; i = i + 1; }
    0
}

// o += a  (in-place add; avoids aliasing where the output is also an input).
fn fadd_assign(o: &mut [secret i64], a: &[secret i64]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 { (*o)[i] = (*o)[i] + (*a)[i]; i = i + 1; }
    0
}

// o -= a  (in-place subtract).
fn fsub_assign(o: &mut [secret i64], a: &[secret i64]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 { (*o)[i] = (*o)[i] - (*a)[i]; i = i + 1; }
    0
}

// o = a * b in GF(2^255-19). Schoolbook product into a 31-limb temp, fold 2^256 ≡
// 38 back down, then two carry passes. Inputs are read fully before the output is
// written, so the output may be a fresh element distinct from a and b.
fn fmul(o: &mut [secret i64], a: &[secret i64], b: &[secret i64]) -> i64 {
    let mut tv: Vec<secret i64> = vec_new();
    let mut z: i64 = 0;
    while z < 31 { push(&mut tv, 0); z = z + 1; }
    let mut t: [secret i64] = vec_to_array(tv);
    let mut i: i64 = 0;
    while i < 16 {
        let mut j: i64 = 0;
        while j < 16 {
            t[i + j] = t[i + j] + (*a)[i] * (*b)[j];
            j = j + 1;
        }
        i = i + 1;
    }
    let mut f: i64 = 0;
    while f < 15 {
        t[f] = t[f] + 38 * t[f + 16];
        f = f + 1;
    }
    let mut w: i64 = 0;
    while w < 16 { (*o)[w] = t[w]; w = w + 1; }
    car25519(o);
    car25519(o);
    0
}

// o = a^2.
fn fsq(o: &mut [secret i64], a: &[secret i64]) -> i64 {
    fmul(o, a, a)
}

// Constant-time conditional swap of p and q when the SECRET bit b is 1. The mask
// 0 - b is all-ones for b == 1 and zero for b == 0; XORing the masked difference
// into both swaps them with no branch on b.
fn sel25519(p: &mut [secret i64], q: &mut [secret i64], b: secret i64) -> i64 {
    let c: secret i64 = 0 - b;
    let mut i: i64 = 0;
    while i < 16 {
        let t: secret i64 = c & ((*p)[i] ^ (*q)[i]);
        (*p)[i] = (*p)[i] ^ t;
        (*q)[i] = (*q)[i] ^ t;
        i = i + 1;
    }
    0
}

// The multiplicative inverse in GF(2^255-19): a^(2^255-21) = a^-1 (Fermat). A fixed
// chain of 254 squarings with a multiply by a at all but two steps — data
// independent, so constant-time.
fn finv(o: &mut [secret i64], a: &[secret i64]) -> i64 {
    let mut c: [secret i64] = fe_zero();
    fe_copy(&mut c, a);
    let mut i: i64 = 253;
    while i >= 0 {
        let mut t: [secret i64] = fe_zero();
        fsq(&mut t, &c);
        fe_copy(&mut c, &t);
        if i != 2 && i != 4 {
            let mut t2: [secret i64] = fe_zero();
            fmul(&mut t2, &c, a);
            fe_copy(&mut c, &t2);
            0
        } else { 0 };
        i = i - 1;
    }
    fe_copy(o, &c);
    0
}

// Decode 32 little-endian bytes into a field element (16 bits per limb); the top
// bit of the 255-bit value is masked off.
fn unpack25519(o: &mut [secret i64], n: &[secret u8]) -> i64 {
    let mut i: i64 = 0;
    while i < 16 {
        (*o)[i] = ((*n)[2 * i] as i64) + (((*n)[2 * i + 1] as i64) << 8);
        i = i + 1;
    }
    (*o)[15] = (*o)[15] & 32767;
    0
}

// Encode a field element to 32 little-endian SECRET bytes (as `secret u8`), with
// the constant-time final reduction mod p: subtract p, then conditionally keep the
// reduced value iff it did not borrow — both branches via the branch-free sel25519.
fn pack25519(n: &[secret i64]) -> [secret u8] {
    let mut ov: Vec<secret i64> = vec_new();
    let mut i: i64 = 0;
    while i < 16 { push(&mut ov, (*n)[i]); i = i + 1; }
    let mut o: [secret i64] = vec_to_array(ov);
    car25519(&mut o);
    car25519(&mut o);
    car25519(&mut o);
    let mut r: i64 = 0;
    while r < 2 {
        let mut m: [secret i64] = fe_zero();
        m[0] = o[0] - 65517;                         // 0xffed = p's low limb
        let mut i2: i64 = 1;
        while i2 < 15 {
            m[i2] = o[i2] - 65535 - (arith_shr(m[i2 - 1], 16) & 1);
            m[i2 - 1] = m[i2 - 1] & 65535;
            i2 = i2 + 1;
        }
        m[15] = o[15] - 32767 - (arith_shr(m[14], 16) & 1);
        let b: secret i64 = arith_shr(m[15], 16) & 1;  // borrow ⇒ o < p, keep o
        m[14] = m[14] & 65535;
        sel25519(&mut o, &mut m, 1 - b);
        r = r + 1;
    }
    let mut out: Vec<secret u8> = vec_new();
    let mut k: i64 = 0;
    while k < 16 {
        push(&mut out, (o[k] & 255) as u8);
        push(&mut out, ((o[k] >> 8) & 255) as u8);
        k = k + 1;
    }
    vec_to_array(out)
}

// X25519: multiply the SECRET scalar by the u-coordinate `u`, returning the 32-byte
// SECRET result (RFC 7748 §5). The scalar is clamped, then a Montgomery ladder runs
// 255 fixed iterations; each step conditionally swaps the working points on the
// secret scalar bit using the branch-free sel25519, so no secret bit ever reaches a
// branch. The final projective division x2 / z2 uses the constant-time inverse.
pub fn x25519(scalar: [secret u8], u: [secret u8]) -> [secret u8] {
    // Clamp the scalar into a 32-entry `secret i64` working copy (byte values):
    // clear the low 3 bits of byte 0, clear bit 255, set bit 254.
    let mut zz: Vec<secret i64> = vec_new();
    let mut ci: i64 = 0;
    while ci < 32 { push(&mut zz, scalar[ci] as i64); ci = ci + 1; }
    let mut z: [secret i64] = vec_to_array(zz);
    z[0] = z[0] & 248;
    z[31] = z[31] & 127;
    z[31] = z[31] | 64;

    // Decode the input point.
    let mut x: [secret i64] = fe_zero();
    unpack25519(&mut x, &u);

    // Ladder state: a=1, b=x, c=0, d=1 (e, f, tmp are scratch).
    let mut a: [secret i64] = fe_zero();
    let mut b: [secret i64] = fe_zero();
    let mut c: [secret i64] = fe_zero();
    let mut d: [secret i64] = fe_zero();
    let mut e: [secret i64] = fe_zero();
    let mut f: [secret i64] = fe_zero();
    let mut tmp: [secret i64] = fe_zero();
    fe_copy(&mut b, &x);
    a[0] = 1;
    d[0] = 1;

    let mut i: i64 = 254;
    while i >= 0 {
        // The i-th scalar bit (PUBLIC index into the secret scalar): byte i/8, bit
        // i mod 8. The shift amount is public, so this is constant-time.
        let byte_idx: i64 = i / 8;
        let bit_idx: i64 = i - byte_idx * 8;
        let bit: secret i64 = (z[byte_idx] >> bit_idx) & 1;

        sel25519(&mut a, &mut b, bit);
        sel25519(&mut c, &mut d, bit);
        // The Montgomery differential add-and-double (RFC 7748 / TweetNaCl), with
        // distinct outputs and in-place ops chosen so no element aliases another.
        fadd(&mut e, &a, &c);          // e = a + c
        fsub_assign(&mut a, &c);       // a = a - c
        fadd(&mut c, &b, &d);          // c = b + d
        fsub_assign(&mut b, &d);       // b = b - d
        fsq(&mut d, &e);               // d = e^2
        fsq(&mut f, &a);               // f = a^2
        fmul(&mut tmp, &c, &a);        // a = c * a
        fe_copy(&mut a, &tmp);
        fmul(&mut c, &b, &e);          // c = b * e
        fadd(&mut e, &a, &c);          // e = a + c
        fsub_assign(&mut a, &c);       // a = a - c
        fsq(&mut b, &a);               // b = a^2
        fsub(&mut c, &d, &f);          // c = d - f
        let k121665: [secret i64] = fe_121665();
        fmul(&mut a, &c, &k121665);    // a = c * 121665
        fadd_assign(&mut a, &d);       // a = a + d
        fmul(&mut tmp, &c, &a);        // c = c * a
        fe_copy(&mut c, &tmp);
        fmul(&mut a, &d, &f);          // a = d * f
        fmul(&mut d, &b, &x);          // d = b * x
        fsq(&mut b, &e);               // b = e^2
        sel25519(&mut a, &mut b, bit);
        sel25519(&mut c, &mut d, bit);

        i = i - 1;
    }

    // result = a * c^-1, then serialize.
    let mut cinv: [secret i64] = fe_zero();
    finv(&mut cinv, &c);
    fmul(&mut tmp, &a, &cinv);
    pack25519(&tmp)
}
