                cg_drop_range(c, 0);
                if (*c).cgmain {
                    let td: i64 = cg_dst(c);
                    cgo_str(c, "trunc i64 ");
                    cgo_operand(c, rk, rv);
                    cgo_str(c, " to i32\n");
                    cgo_str(c, "  ret i32 %v");
                    cgo_int(c, td);
                    cg_putc(c, '\n');
                    0
                } else if (*c).cg_eff {
                    let kp: i64 = cg_dst(c);
                    cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
                    cgo_operand(c, rk, rv);
                    cgo_str(c, ")\n");
                    (*c).cg_used_kontpure = true;
                    cgo_str(c, "  ret ptr %v");
                    cgo_int(c, kp);
                    cg_putc(c, '\n');
                    0
                } else {
                    cgo_str(c, "  ret ");
                    cgo_ty(c, it);
                    cg_putc(c, ' ');
                    cgo_operand(c, rk, rv);
                    cg_putc(c, '\n');
                    0
                };
                let dead: i64 = cg_fresh_block(c);
                cgo_str(c, "bb");
                cgo_int(c, dead);
                cgo_str(c, ":\n");
                (*c).cglk = 1;
                (*c).cglv = 0;
                0
            } else {
                0
            };
            it
        },
        // ADR 0049: integer cast `expr as T`. Type the operand, then the result is
        // the target scalar (`cnm`), preserving the operand's secrecy (a width
        // conversion is data-independent / constant-time — NOT a sink). MIR: an
        // opaque carrying the operand (like a widen). CG: trunc / sext / zext by
        // width (u8 source → zext; same width → no-op).
        Expr::Cast(ci, cnm) => {
            // The cast's result type depends on the operand's secrecy (known only
            // after the operand is dumped), so build the node into a temp buffer
            // and `widen_splice` it (the let-boundary widen — e.g.
            // `let s: secret i32 = (x as i32)` — must PRECEDE the node).
            let mut tmp: Vec<u8> = vec_new();
            append_str(&mut tmp, "(cast ");
            let it: i64 = dump_texpr(&mut tmp, ci, 0 - 1, src, c, gb);
            let iv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            let cguk: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cguv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            let base: i64 = scalar_code(&cnm);
            let rt: i64 = if is_secret(c, it) {
                mk_secret(c, base)
            } else {
                base
            };
            close_ty(&mut tmp, rt, c);
            // MIR: a width conversion carries the operand (opaque), result `rt` —
            // NOT a sink (casting a secret is constant-time).
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque1(c, mc, iv, rt);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // CG: trunc / sext / zext by width (u8 source → zext); same width is a
            // no-op (propagate the operand).
            if cg_on(c) {
                let srcs: i64 = strip_secret(c, it);
                let sw: i64 = scalar_bits(srcs);
                let dw: i64 = scalar_bits(base);
                if sw == dw {
                    (*c).cglk = cguk;
                    (*c).cglv = cguv;
                    0
                } else {
                    let op: [u8] = if dw < sw {
                        "trunc"
                    } else if srcs == 3 {
                        "zext"
                    } else {
                        "sext"
                    };
                    let cd: i64 = cg_conv(c, op, srcs, cguk, cguv, base);
                    0
                };
                0
            } else {
                0
            };
            let cw: bool = if mir_on(c) {
                widen_kind(c, exp, rt) != 0
            } else if cg_on(c) {
                widen_kind(c, exp, rt) != 0
            } else {
                false
            };
            mir_widen(c, cw, exp);
            cg_widen(c, cw, exp);
            widen_splice(out, tmp, exp, rt, c)
        },
        // (4i) char literal `'c'` → `(char N :u8)` (the decoded byte value, ADR 0033 D2:
        // `u8`). Widens like the other scalar leaves (a `secret u8` / `?u8` context).
        Expr::Char(cv) => {
            let w: bool = widen_pre(out, exp, 3, c);
            append_str(out, "(char ");
            append_int(out, cv);
            close_ty(out, 3, c);
            // (7c) MIR: a char literal is a public constant -> Opaque (no operands), u8.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque0(c, mc, 3);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (8c-3) codegen: a char literal is a u8 operand (no instruction).
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = cv;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, 3, c)
        },
        // (4i) string literal `"…"` → `(str b0 b1 … :[u8])` (the decoded bytes, ADR 0033
        // D2: a string IS a `[u8]`). ⚠ `sb` is an owned `[u8]` only INDEXED in the byte
        // loop → `sink_name` it (by value) after, else it leaks (the parser's
        // `dump_str_body` lesson).
        Expr::Str(sb) => {
            let saty: i64 = mk_array(c, 3);
            let w: bool = widen_pre(out, exp, saty, c);
            append_str(out, "(str");
            let slen: i64 = len(sb);
            let mut sbi: i64 = 0;
            while sbi < slen {
                push(out, ' ');
                append_int(out, u8_to_i64(sb[sbi]));
                sbi = sbi + 1;
            }
            // (8c-3) codegen: a string literal IS a u8 array literal of constant bytes
            // — push each byte as a literal operand (i8), then reuse cg_emit_arraylit.
            // Must read `sb` BEFORE `sink_name` consumes it.
            if cg_on(c) {
                let s_snap: i64 = len((*c).cgak);
                let mut sci: i64 = 0;
                while sci < slen {
                    let sbv: i64 = u8_to_i64(sb[sci]);
                    push(&mut (*c).cgak, 1);
                    push(&mut (*c).cgav, sbv);
                    push(&mut (*c).cgat, 3);
                    sci = sci + 1;
                }
                cg_emit_arraylit(c, 3, s_snap);
                0
            } else {
                0
            };
            sink_name(gb, sb);
            close_ty(out, saty, c);
            // (7c) MIR: a string literal is a public constant -> Opaque (no operands), [u8].
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque0(c, mc, saty);
                (*c).lastval = d;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, saty, c)
        },
        // (4i) `scope concurrent { block }` → `(scope <block :T> :T)`: the scope's value
        // IS the block's tail, so thread the expectation `exp` through (a `?T`-typed
        // scope widens its tail). Discharges the Async effect (effect-check is D1, out of
        // scope), so the type is just the body type.
        Expr::Scope(sbody) => {
            append_str(out, "(scope ");
            // (concurrency) cg: enter a scope ctx (so `spawn`s inside register with it),
            // lower the body, exit the scope (joins/awaits unawaited tasks). The body's
            // value (operand in cglk/cglv) is the scope's value.
            let sv_scope: i64 = (*c).cg_scope;
            let cg_sc: i64 = if cg_on(c) {
                let sc: i64 = cg_dst(c);
                cgo_str(c, "call ptr @sentinel_scope_enter()\n");
                (*c).cg_used_scopeenter = true;
                (*c).cg_scope = sc;
                sc
            } else {
                0 - 1
            };
            let sct: i64 = dump_texpr(out, sbody, exp, src, c, gb);
            if cg_on(c) {
                (*c).cg_scope = sv_scope;
                cgo_str(c, "  call void @sentinel_scope_exit(ptr %v");
                cgo_int(c, cg_sc);
                cgo_str(c, ")\n");
                (*c).cg_used_scopeexit = true;
                0
            } else {
                0
            };
            close_ty(out, sct, c);
            sct
        },
        // (4i) `spawn <call>` → `(spawn <inner :U> :Task<U>)`: spawn wraps the spawned
        // expression's type U in a `Task`.
        Expr::Spawn(scall) => {
            append_str(out, "(spawn ");
            if cg_on(c) {
                // (concurrency) mode 4: the spawn cg (the `out` type dump is throwaway).
                // The spawn target is a direct fn Call — collect its args (cg operands)
                // then pack + `task_spawn`. NOT a normal call (we don't invoke it here).
                match scall {
                    Expr::Call(scn, sca) => {
                        let sfid: i64 = fn_lookup(c, src, &scn);
                        sink_name(gb, scn);
                        let sret: i64 = fn_ret(c, sfid);
                        let cg_col: bool = (*c).cg_collecting;
                        let snap: i64 = len((*c).cgak);
                        (*c).cg_collecting = true;
                        let svc: bool = (*c).consuming;
                        (*c).consuming = true;
                        dump_targs(out, sca, src, c, gb);
                        (*c).consuming = svc;
                        (*c).cg_collecting = cg_col;
                        cg_emit_spawn(c, sfid, snap, src);
                        mk_task(c, sret)
                    },
                    _ => {
                        // unreachable (type-check restricts spawn to a Call); dispose.
                        let mut scratch: Vec<i64> = vec_new();
                        cg_walk_ex(c, scall, false, &mut scratch, gb);
                        mk_task(c, 0)
                    },
                }
            } else {
                // modes 0-3: the type dump + MIR (`spawn e` → Opaque([e]) typed Task<U>).
                let spt: i64 = dump_texpr(out, scall, 0 - 1, src, c, gb);
                let spv: i64 = if mir_on(c) {
                    (*c).lastval
                } else {
                    0 - 1
                };
                let tkt: i64 = mk_task(c, spt);
                close_ty(out, tkt, c);
                if mir_on(c) {
                    let mc: i64 = (*c).mir_cur;
                    let d: i64 = mir_emit_opaque1(c, mc, spv, tkt);
                    (*c).lastval = d;
                    0
                } else {
                    0
                };
                tkt
            }
        },
        // (4i) `<target>.await` → `(await <target :Task<U>> :U)`: await joins the task +
        // yields its result type U (the Task's element).
        Expr::Await(aw) => {
            append_str(out, "(await ");
            let awt: i64 = dump_texpr(out, aw, 0 - 1, src, c, gb);
            let awv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            let awr: i64 = task_elem_of(c, awt);
            close_ty(out, awr, c);
            // (concurrency) cg: join the task + read its i64 result.
            if cg_on(c) {
                let tk: i64 = (*c).cglk;
                let tv: i64 = (*c).cglv;
                let r: i64 = cg_dst(c);
                cgo_str(c, "call i64 @sentinel_task_await(ptr ");
                cgo_operand(c, tk, tv);
                cgo_str(c, ")\n");
                (*c).cg_used_taskawait = true;
                // ADR 0066 M1.1: decode the i64 result slot to the Task's result type
                // (inverse of the wrapper encode). i64 (0) is a no-op = byte-identical to C4.4.
                // One `cg_dst` for the non-i64 cases (selfhost `let` is not block-scoped).
                let dr: i64 = strip_secret(c, awr);
                if dr == 0 {
                    cg_reg(c, r)
                } else {
                    let dd: i64 = cg_dst(c);
                    if dr == 1 {
                        cgo_str(c, "trunc i64 %v");
                        cgo_int(c, r);
                        cgo_str(c, " to i32\n")
                    } else if dr == 2 {
                        cgo_str(c, "trunc i64 %v");
                        cgo_int(c, r);
                        cgo_str(c, " to i1\n")
                    } else if dr == 3 {
                        cgo_str(c, "trunc i64 %v");
                        cgo_int(c, r);
                        cgo_str(c, " to i8\n")
                    } else {
                        cgo_str(c, "inttoptr i64 %v");
                        cgo_int(c, r);
                        cgo_str(c, " to ptr\n")
                    };
                    cg_reg(c, dd)
                };
                0
            } else {
                0
            };
            // (7c) MIR: `t.await` -> Opaque([t]) typed U (the task's element).
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque1(c, mc, awv, awr);
                (*c).lastval = d;
                0
            } else {
                0
            };
            awr
        },
        // A defensive catch-all keeps the match exhaustive (no Expr variants remain).
        _ => {
            append_str(out, "(UNHANDLED");
            close_ty(out, 0, c);
            0
        },
    }
}

// (4e) A match-arm pattern's payload bindings: each binds a fresh VarId (in
// source order) into the arm's scope with its variant's payload type, and emits
// `(bind #vid name <type>)`. `pbase` is the variant's payload-slice base into
// `varpay`; `payidx` advances per bind. The name is emitted from `nb` AFTER
// `bind_name` copies it there (it consumes the AST `[u8]`).
fn dump_tbinds(out: &mut Vec<u8>, b: Binds, pbase: i64, payidx: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            let bvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            let pty: i64 = (*c).varpay[pbase + payidx];
            let nst: i64 = len((*c).nb);
            bind_name(c, nm, bvid, pty);
            // (8e-2) cg: bind the payload field — GEP the boxed payload struct's field
            // `payidx`, load it into a fresh hoisted slot, store, key the slot by VarId
            // (so the arm body's Var reads it). A `_` binding still gets a slot. NOT
            // drop-recorded (it aliases the box, freed by the scrutinee's enum drop).
            if cg_on(c) {
                let bfp: i64 = cg_dst(c);
                cgo_str(c, "getelementptr ");
                cg_emit_pstruct(c, (*c).cg_m_pj);
                cgo_str(c, ", ptr %v");
                cgo_int(c, (*c).cg_m_payload);
                cgo_str(c, ", i32 0, i32 ");
                cgo_int(c, payidx);
                cg_putc(c, '\n');
                let bld: i64 = cg_dst(c);
                cgo_str(c, "load ");
                cgo_ty(c, pty);
                cgo_str(c, ", ptr %v");
                cgo_int(c, bfp);
                cg_putc(c, '\n');
                let bsl: i64 = cg_alloca(c, pty);
                cgo_str(c, "  store ");
                cgo_ty(c, pty);
                cgo_str(c, " %v");
                cgo_int(c, bld);
                cgo_str(c, ", ptr %v");
                cgo_int(c, bsl);
                cg_putc(c, '\n');
                cg_slot_set(c, bvid, bsl);
                0
            } else {
                0
            };
            let nen: i64 = len((*c).nb);
            append_str(out, " (bind #");
            append_int(out, bvid);
            push(out, ' ');
            let mut bi: i64 = nst;
            while bi < nen {
                push(out, (*c).nb[bi]);
                bi = bi + 1;
            }
            push(out, ' ');
            render_type(out, pty, c);
            push(out, ')');
            dump_tbinds(out, rest, pbase, payidx + 1, c, gb)
        },
    }
}

// (4e) A match-arm pattern: `_` → `(pat _)`; `Enum::Variant(binds)` → `(pat vidx
// Variant (bind …)…)` — the variant_index replaces resolve's enum name; the binds
// take the variant's payload types.
fn dump_tpat(out: &mut Vec<u8>, p: Pattern, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match p {
        Pattern::PatWild => {
            append_str(out, "(pat _)");
            // (8e-2) cg: a wildcard arm has no tag check — signal the epilogue (-1).
            // (No emitting fixture uses one; the final-else body is a deferred case.)
            if cg_on(c) {
                (*c).cg_m_armnext = 0 - 1;
                0
            } else {
                0
            };
            0
        },
        Pattern::PatVariant(en, vn, bs) => {
            let eid: i64 = enum_lookup(c, &en);
            sink_name(gb, en);
            let vidx: i64 = variant_index(c, eid, &vn);
            let j: i64 = variant_flat(c, eid, vidx);
            let pbase: i64 = (*c).varps[j];
            // (8e-2) cg: the arm's tag check — `icmp eq tag, vidx`; branch to the arm
            // block (open it) or the next check. `cg_m_pj` carries `j` to the bind.
            if cg_on(c) {
                (*c).cg_m_pj = j;
                let pcmp: i64 = cg_dst(c);
                cgo_str(c, "icmp eq i32 %v");
                cgo_int(c, (*c).cg_m_tag);
                cgo_str(c, ", ");
                cgo_int(c, vidx);
                cg_putc(c, '\n');
                let parm: i64 = cg_fresh_block(c);
                let pnext: i64 = cg_fresh_block(c);
                cgo_str(c, "  br i1 %v");
                cgo_int(c, pcmp);
                cgo_str(c, ", label %bb");
                cgo_int(c, parm);
                cgo_str(c, ", label %bb");
                cgo_int(c, pnext);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, parm);
                cgo_str(c, ":\n");
                (*c).cg_m_armnext = pnext;
                0
            } else {
                0
            };
            append_str(out, "(pat ");
            append_int(out, vidx);
            push(out, ' ');
            append_str(out, vn);
            dump_tbinds(out, bs, pbase, 0, c, gb);
            push(out, ')');
            0
        },
    }
}

// (4e) match arms: snapshot the scope, dump the pattern (binding its payloads),
// type the body (threading the match's expectation `exp`), then TRUNCATE the scope
// back (the payloads are arm-local; VarIds stay monotonic). The match's type is the
// FIRST arm's body type (every arm shares it on clean fixtures).
fn dump_tarms(out: &mut Vec<u8>, a: Arms, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Arms::ArmEnd => 0 - 1,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            let mark: i64 = len((*c).scs);
            // (8e-2) cg: reset the arm's next-block before the pattern sets it; capture it
            // into a LOCAL after, so a nested match in the body can't clobber it.
            if cg_on(c) {
                (*c).cg_m_armnext = 0 - 1;
                0
            } else {
                0
            };
            dump_tpat(out, ap, c, gb);
            let cg_arm_next: i64 = if cg_on(c) {
                (*c).cg_m_armnext
            } else {
                0 - 1
            };
            push(out, ' ');
            let bt: i64 = dump_texpr(out, abody, exp, src, c, gb);
            // (8e-2) cg: store the arm body's value to the result slot, branch to merge,
            // open the next-check block (a variant arm only — `cg_arm_next >= 0`).
            let cg_bk: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cg_bv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            mir_collect(c);
            truncate_scope(c, mark);
            if cg_on(c) {
                if cg_arm_next >= 0 {
                    cgo_str(c, "  store ");
                    cgo_ty(c, exp);
                    cg_putc(c, ' ');
                    cgo_operand(c, cg_bk, cg_bv);
                    cgo_str(c, ", ptr %v");
                    cgo_int(c, (*c).cg_m_result);
                    cg_putc(c, '\n');
                    cgo_str(c, "  br label %bb");
                    cgo_int(c, (*c).cg_m_merge);
                    cg_putc(c, '\n');
                    cgo_str(c, "bb");
                    cgo_int(c, cg_arm_next);
                    cgo_str(c, ":\n");
                    0
                } else {
                    // (8g) the `_` wildcard arm (cg_arm_next < 0) IS the final else: store
                    // the body + `br merge`, but open NO next-check block, and signal the
                    // epilogue to skip `unreachable` (matches the oracle's `lower_match`,
                    // which emits the wildcard body as the last block).
                    cgo_str(c, "  store ");
                    cgo_ty(c, exp);
                    cg_putc(c, ' ');
                    cgo_operand(c, cg_bk, cg_bv);
                    cgo_str(c, ", ptr %v");
                    cgo_int(c, (*c).cg_m_result);
                    cg_putc(c, '\n');
                    cgo_str(c, "  br label %bb");
                    cgo_int(c, (*c).cg_m_merge);
                    cg_putc(c, '\n');
                    (*c).cg_m_wild = true;
                    0
                };
                0
            } else {
                0
            };
            push(out, ')');
            dump_tarms(out, arest, exp, src, c, gb);
            bt
        },
    }
}

// (4g) A handler arm's params: each binds a fresh VarId (source order) → `#vid`. ⚠
// bound with `i64` (every corpus op param is `i64`; the continuation `k` is only ever
// used as a resume-kont callee, never a typed var). A non-`i64` op param would need
// the op's param-type table (a follow-up).
fn dump_thparams(out: &mut Vec<u8>, b: Binds, c: &mut TyCtx, first: bool) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            if first {
                0
            } else {
                push(out, ' ');
                0
            };
            let pvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, nm, pvid, 0);
            push(out, '#');
            append_int(out, pvid);
            dump_thparams(out, rest, c, false)
        },
    }
}

// (4g) handler arms → `(arm #eid op_idx Eff op (#pvids) <body>)` — params bind VarIds
// scoped to the arm (truncated after); the body is typed (sees the params + `k`).
// (Bar B / effects c36b) store a handler-arm / pure-return value operand into the
// handle's result cell. Top-level: a plain `store i64`. Nested: the cell is Kont*, so
// wrap the i64 via `sentinel_kont_pure` first (the merged result is the kont the
// enclosing handle dispatches on). Mirrors the oracle's `store_handle_result`.
fn cg_store_hresult(c: &mut TyCtx, is_nested: bool, vk: i64, vv: i64, rslot: i64) -> i64 {
    if is_nested {
        let w: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
        cgo_operand(c, vk, vv);
        cgo_str(c, ")\n");
        (*c).cg_used_kontpure = true;
        cgo_str(c, "  store ptr %v");
        cgo_int(c, w);
        cgo_str(c, ", ptr %v");
        cgo_int(c, rslot);
        cg_putc(c, '\n');
        0
    } else {
        cgo_str(c, "  store i64 ");
        cgo_operand(c, vk, vv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, rslot);
        cg_putc(c, '\n');
        0
    }
}

fn dump_tharms(out: &mut Vec<u8>, a: HArms, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, is_nested: bool) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hparams, hbody, hrest) => {
            let heid: i64 = effect_lookup(c, src, &hef);
            let hoidx: i64 = op_index_lookup(c, src, heid, &hop);
            // (Bar B / effects) cg: this arm's op_id check (the if-else chain) — branch to
            // the arm block or the next check. `cg_next_b` is the block the next arm's
            // check (or the pure-check tail) continues in.
            let cg_next_b: i64 = if cg_on(c) {
                let oid: i64 = cg_encode_op_id(heid, hoidx);
                let hopid: i64 = (*c).cg_h_opid;
                let cmp: i64 = cg_dst(c);
                cgo_str(c, "icmp eq i32 %v");
                cgo_int(c, hopid);
                cgo_str(c, ", ");
                cgo_int(c, oid);
                cg_putc(c, '\n');
                let ab: i64 = cg_fresh_block(c);
                let nb: i64 = cg_fresh_block(c);
                cgo_str(c, "  br i1 %v");
                cgo_int(c, cmp);
                cgo_str(c, ", label %bb");
                cgo_int(c, ab);
                cgo_str(c, ", label %bb");
                cgo_int(c, nb);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, ab);
                cgo_str(c, ":\n");
                nb
            } else {
                0
            };
            append_str(out, " (arm #");
            append_int(out, heid);
            push(out, ' ');
            append_int(out, hoidx);
            push(out, ' ');
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            append_str(out, " (");
            let mark: i64 = len((*c).scs);
            let cg_pv0: i64 = (*c).nextvid;
            dump_thparams(out, hparams, c, true);
            let cg_pvn: i64 = (*c).nextvid;
            append_str(out, ") ");
            // (cg) bind the arm's op-param (kont.arg @8) + continuation (a slot holding ck).
            if cg_on(c) {
                let ck: i64 = (*c).cg_h_ck;
                cg_bind_harm_params(c, cg_pv0, cg_pvn, ck);
                0
            } else {
                0
            };
            dump_texpr(out, hbody, 0 - 1, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            // (cg) store the arm value to the result cell + branch to merge; open the next
            // check block (the next arm / the pure-check tail continues there).
            if cg_on(c) {
                let bk: i64 = (*c).cglk;
                let bv: i64 = (*c).cglv;
                let rslot: i64 = (*c).cg_h_rslot;
                let merge_b: i64 = (*c).cg_h_merge;
                // (c36b) nested: wrap the arm's i64 → kont_pure → ptr (the merge is Kont*).
                cg_store_hresult(c, is_nested, bk, bv, rslot);
                cgo_str(c, "  br label %bb");
                cgo_int(c, merge_b);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_next_b);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            dump_tharms(out, hrest, src, c, gb, is_nested)
        },
    }
}

// (4g) the optional `return v => body` arm → `(return #vid <body>)`: `v` binds a
// VarId typed as the handle BODY's type `bty` (it names the body's value), scoped to
// the arm.
fn dump_tret(out: &mut Vec<u8>, r: Ret, bty: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody, rnt, rt0) => {
            let _t1: i64 = rnt;
            let _t2: i64 = rt0;
            if cg_on(c) {
                // (c36a) mode 4: the return arm's cg is emitted INLINE at each pure-drain
                // site (the dispatch pure block + each k(v) pure path), re-parsed from the
                // body tokens via the `cg_ret_*` state set in the Handle arm. Here just
                // dispose the parsed body + name (the `out` type-dump is throwaway in cg).
                sink_name(gb, rnm);
                let mut scratch: Vec<i64> = vec_new();
                cg_walk_ex(c, rbody, false, &mut scratch, gb);
                0
            } else {
                // modes 0-3: the type S-expr `(return #vid <body>)` — `v` binds a VarId
                // typed as the handle body's type `bty`, scoped to the arm.
                let mark: i64 = len((*c).scs);
                let rvid: i64 = (*c).nextvid;
                (*c).nextvid = (*c).nextvid + 1;
                bind_name(c, rnm, rvid, bty);
                append_str(out, " (return #");
                append_int(out, rvid);
                push(out, ' ');
                dump_texpr(out, rbody, 0 - 1, src, c, gb);
                truncate_scope(c, mark);
                push(out, ')');
                0
            }
        },
    }
}

fn dump_tstmts(out: &mut Vec<u8>, st: Stmts, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(s, rest) => {
            push(out, ' ');
            dump_tstmt(out, s, src, c, gb);
            dump_tstmts(out, rest, src, c, gb)
        },
    }
}

fn dump_tstmt(out: &mut Vec<u8>, s: Stmt, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            // DURING-WALK binding: take the let's expected type from its annotation
            // FIRST (so a `?T` let widens a `T` value / types a `null`), resolve the
            // VALUE against it into a temp buffer (it may bind nested vars), THEN take
            // the let's VarId. The let's type is the annotation if present, else the
            // value's inferred type. Format: `(let #vid [mut] <type> <value>)`.
            let mut vbuf: Vec<u8> = vec_new();
            let letexp: i64 = tyopt_exp(c, lty, gb);
            // (6/N) a `let`'s RHS is CONSUMING (a bare-Var RHS moves the binding).
            let lsvc: bool = (*c).consuming;
            (*c).consuming = true;
            let valty: i64 = dump_texpr(&mut vbuf, lval, letexp, src, c, gb);
            (*c).consuming = lsvc;
            let lvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            let letty: i64 = if letexp == 0 - 1 {
                valty
            } else {
                letexp
            };
            bind_name(c, lnm, lvid, letty);
            // (7/N) MIR: the let's value is its current SSA value (the RHS's `lastval`).
            if mir_on(c) {
                let lv: i64 = (*c).lastval;
                mir_vd_set(c, lvid, lv);
                0
            } else {
                0
            };
            // (8/N) codegen: the RHS instructions are already in `cgout`; bind by an
            // alloca slot + store the RHS operand. Reads of this var load from the slot.
            if cg_on(c) {
                let rk: i64 = (*c).cglk;
                let rv: i64 = (*c).cglv;
                let cgslot: i64 = cg_alloca(c, letty);
                cg_store(c, letty, rk, rv, cgslot);
                cg_slot_set(c, lvid, cgslot);
                cg_drop_record(c, lvid, letty, cgslot);
                0
            } else {
                0
            };
            append_str(out, "(let #");
            append_int(out, lvid);
            push(out, ' ');
            if lmf {
                append_str(out, "mut ")
            } else {
                0
            };
            render_type(out, letty, c);
            push(out, ' ');
            append_str(out, vec_to_array(vbuf));
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            // (6/N) the assign TARGET is a place (non-consuming); the VALUE is consuming.
            let asvc: bool = (*c).consuming;
            (*c).consuming = false;
            // (7c) MIR: the target is a PLACE, not a value — suppress its emits during
            // the (dump-only) target walk. A plain-Var target sets `mir_lastvid`; a
            // field/`*`-deref/index place sets it -1 (the wrapper arms).
            let as_sup: bool = (*c).mir_suppress;
            if mir_on(c) {
                (*c).mir_suppress = true;
                0
            } else {
                0
            };
            // (8/N) codegen: suppress the target's load (it's a place, not a value); the
            // Var arm records `cg_lastvid` so the store can find the slot.
            let cg_sup: bool = (*c).cg_suppress;
            if cg_on(c) {
                (*c).cg_suppress = true;
                0
            } else {
                0
            };
            let ttgt: i64 = dump_texpr(out, atgt, 0 - 1, src, c, gb);
            let tvid: i64 = if mir_on(c) {
                (*c).mir_suppress = as_sup;
                (*c).mir_lastvid
            } else {
                0 - 1
            };
            let cgtvid: i64 = if cg_on(c) {
                (*c).cg_suppress = cg_sup;
                (*c).cg_lastvid
            } else {
                0 - 1
            };
            // (8d) for a `*r =` deref target the place is r's pointer (left in the operand
            // by the Unary arm, cg_lastvid = -1); capture it BEFORE the value walk clobbers.
            let cgtpv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            (*c).consuming = true;
            push(out, ' ');
            dump_texpr(out, aval, 0 - 1, src, c, gb);
            // (7c) MIR: a plain-Var target rebinds var_defs to the RHS; a field/`*`-deref
            // store (no precise IR) funnels the value through Opaque (a store sink, typed
            // as the target).
            if mir_on(c) {
                let av: i64 = (*c).lastval;
                if tvid >= 0 {
                    mir_vd_set(c, tvid, av);
                    0
                } else {
                    let mc: i64 = (*c).mir_cur;
                    let _d: i64 = mir_emit_opaque1(c, mc, av, ttgt);
                    0
                };
                0
            } else {
                0
            };
            // (8/N) codegen: store the RHS operand into the target's place — a Var's alloca
            // slot (cgtvid >= 0), or (8d) THROUGH a `*r` deref pointer (cgtvid = -1, the
            // pointer reg in cgtpv; cg_store renders it as `ptr %v<cgtpv>`).
            if cg_on(c) {
                let asak: i64 = (*c).cglk;
                let asav: i64 = (*c).cglv;
                if cgtvid >= 0 {
                    let asslot: i64 = cg_slot_get(c, cgtvid);
                    cg_store(c, ttgt, asak, asav, asslot);
                    0
                } else {
                    cg_store(c, ttgt, asak, asav, cgtpv);
                    0
                };
                0
            } else {
                0
            };
            (*c).consuming = asvc;
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            // (6/N) the cond is a read + the while body's value is discarded — both
            // non-consuming (call args inside still set their own consuming).
            let wsvc: bool = (*c).consuming;
            (*c).consuming = false;
            // (8b) cg: the loop CFG. Enter the cond block (the back-edge target).
            let mut cg_wc: i64 = 0 - 1;
            let mut cg_wb: i64 = 0 - 1;
            let mut cg_wa: i64 = 0 - 1;
            if cg_on(c) {
                cg_wc = cg_fresh_block(c);
                cg_wb = cg_fresh_block(c);
                cg_wa = cg_fresh_block(c);
                cgo_str(c, "  br label %bb");
                cgo_int(c, cg_wc);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_wc);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            dump_texpr(out, wcond, 0 - 1, src, c, gb);
            // (8b) cg: branch cond → body/after, open the body, register loop targets.
            if cg_on(c) {
                let cwk: i64 = (*c).cglk;
                let cwv: i64 = (*c).cglv;
                cgo_str(c, "  br i1 ");
                cgo_operand(c, cwk, cwv);
                cgo_str(c, ", label %bb");
                cgo_int(c, cg_wb);
                cgo_str(c, ", label %bb");
                cgo_int(c, cg_wa);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_wb);
                cgo_str(c, ":\n");
                push(&mut (*c).cg_loop_cond, cg_wc);
                push(&mut (*c).cg_loop_after, cg_wa);
                // (8d-drops-3) the body frame's drop floor = cgdv length NOW, before the
                // body Block arm pushes its frame; break/continue drain cgdv[floor..].
                push(&mut (*c).cg_loop_floor, len((*c).cgdv));
                0
            } else {
                0
            };
            push(out, ' ');
            dump_texpr(out, wbody, 0 - 1, src, c, gb);
            // (8b) cg: pop loop targets, back-edge to cond, open the after block.
            if cg_on(c) {
                let _pc: i64 = pop(&mut (*c).cg_loop_cond);
                let _pa: i64 = pop(&mut (*c).cg_loop_after);
                let _pf: i64 = pop(&mut (*c).cg_loop_floor);
                cgo_str(c, "  br label %bb");
                cgo_int(c, cg_wc);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_wa);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            (*c).consuming = wsvc;
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            // (8b) cg: branch to the innermost loop's after block; park on a dead block.
            if cg_on(c) {
                let bn: i64 = len((*c).cg_loop_after);
                let bafter: i64 = (*c).cg_loop_after[bn - 1];
                // (8d-drops-3) drain the body frame(s) before branching out of the loop.
                let bfloor: i64 = (*c).cg_loop_floor[bn - 1];
                cg_drop_range(c, bfloor);
                cgo_str(c, "  br label %bb");
                cgo_int(c, bafter);
                cg_putc(c, '\n');
                let bdead: i64 = cg_fresh_block(c);
                cgo_str(c, "bb");
                cgo_int(c, bdead);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            // (8b) cg: branch to the innermost loop's cond block; park on a dead block.
            if cg_on(c) {
                let kn: i64 = len((*c).cg_loop_cond);
                let kcond: i64 = (*c).cg_loop_cond[kn - 1];
                // (8d-drops-3) drain the body frame(s) before branching to the cond.
                let kfloor: i64 = (*c).cg_loop_floor[kn - 1];
                cg_drop_range(c, kfloor);
                cgo_str(c, "  br label %bb");
                cgo_int(c, kcond);
                cg_putc(c, '\n');
                let kdead: i64 = cg_fresh_block(c);
                cgo_str(c, "bb");
                cgo_int(c, kdead);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            // (6/N) an expr-statement's value is discarded → non-consuming (inner call
            // args still set their own consuming).
            let esvc: bool = (*c).consuming;
            (*c).consuming = false;
            dump_texpr(out, sx, 0 - 1, src, c, gb);
            (*c).consuming = esvc;
            push(out, ')');
            0
        },
    }
}

// The let's annotation type as an EXPECTATION (consuming the `TyOpt`): the interned
// annotation handle if present, else -1 (no expectation → the value's type is
// inferred). Taken before the value is walked, so a `?T` annotation widens the value.
fn tyopt_exp(c: &mut TyCtx, ty: TyOpt, gb: &mut Vec<u8>) -> i64 {
    match ty {
        TyOpt::NoTy => 0 - 1,
        TyOpt::SomeTy(t) => type_of_typeexpr(c, t, gb),
    }
}

