module types;

// --- (6/N) borrow-check move analysis (ADR 0043 A1) -------------------------

// True iff a value of type `h` is MOVED on a consuming use (non-Copy). Copy =
// scalars + Ref (kind 2) + Task (kind 12); Secret (3) / Nullable (4) follow their
// inner; Array (1) / Struct (6) / Enum (7) / Class (8) / TypeParam (9) /
// GenericInstance (10) / Vec (11) = Move.
fn is_move_type(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 2 {
            false
        } else if k == 12 {
            false
        } else if k == 3 {
            is_move_type(c, (*c).ta[idx])
        } else if k == 4 {
            is_move_type(c, (*c).ta[idx])
        } else {
            true
        }
    }
}

// Record a moved source: a `Var #vid` used in a CONSUMING position (`c.consuming`)
// whose type is non-Copy, inside a top-level fn body (`curfn >= 0`; methods aren't
// in `program.fns`, so their moves aren't dumped). Pushes `(curfn, vid)` into the
// `mvf`/`mvv` side-table (dedup happens at dump time via ascending-VarId membership).
fn record_move(c: &mut TyCtx, vid: i64) -> i64 {
    if (*c).curfn < 0 {
        0
    } else if vid < 0 {
        0
    } else {
        let vty: i64 = (*c).env[vid];
        if is_move_type(c, vty) {
            let cf: i64 = (*c).curfn;
            push(&mut (*c).mvf, cf);
            push(&mut (*c).mvv, vid);
            0
        } else {
            0
        }
    }
}

// (ADR 0046) Record a PARTIAL move: a Move-typed `base.field` consumed by value (the
// FieldAccess arm has already checked `consuming`, a direct-`Var` base, and a Move field
// type). Pushes `(curfn, base, field)` into the `mff`/`mfv`/`mfi` side-table — the whole
// `base` is NOT recorded (its other fields stay droppable). Codegen elides this field
// from `base`'s recursive drop; the mode-1 dump emits `#base.field`. The borrow-error
// half (`check_field_use_alive` etc.) is OUT OF SCOPE — the differential only compares
// fixtures the oracle accepts (ADR 0043 D5/D7), so the Sentinel side records + dumps but
// never rejects. Mirrors `check_and_record_field_move`'s record half.
fn record_field_move(c: &mut TyCtx, base: i64, field: i64) -> i64 {
    if (*c).curfn < 0 {
        0
    } else if base < 0 {
        0
    } else {
        let cf: i64 = (*c).curfn;
        push(&mut (*c).mff, cf);
        push(&mut (*c).mfv, base);
        push(&mut (*c).mfi, field);
        0
    }
}

fn dump_texpr(out: &mut Vec<u8>, ex: Expr, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    // (ADR 0046) reset the direct-Var tracker on entry; only the `Var` arm re-sets it. So
    // right after dumping a sub-expression, `mvbv >= 0` iff that sub-expression was a
    // directly-named binding read — the signal the FieldAccess arm needs for a partial move.
    (*c).mvbv = 0 - 1;
    match ex {
        Expr::Int(nv) => {
            let w: bool = widen_pre(out, exp, 0, c);
            append_str(out, "(int ");
            append_int(out, nv);
            close_ty(out, 0, c);
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 0, 0, nv, 0, 0);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (8/N) codegen: an int literal is an operand (no instruction).
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = nv;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, 0, c)
        },
        Expr::Bool(bv) => {
            let w: bool = widen_pre(out, exp, 2, c);
            if bv {
                append_str(out, "(bool true")
            } else {
                append_str(out, "(bool false")
            };
            close_ty(out, 2, c);
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let bi: i64 = if bv {
                    1
                } else {
                    0
                };
                let d: i64 = mir_emit(c, mc, 1, 0, bi, 0, 2);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (8/N) codegen: a bool literal is an i1 operand 0/1 (no instruction).
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = if bv {
                    1
                } else {
                    0
                };
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, 2, c)
        },
        // (4c-3) `null` carries no syntactic type; its type IS the expectation `exp`
        // (a `?T`), threaded from the let annotation / field / cmp-operand / branch.
        Expr::Null => {
            append_str(out, "(null");
            close_ty(out, exp, c);
            // (7c) MIR: `null` is a public constant -> Opaque (no operands), type `exp`.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque0(c, mc, exp);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (Bar B) codegen: `null` is a `{ i1 0, <zero> }` constant operand (kind 3),
            // keyed by `exp`'s inner type (a `?T` from the let/field/cmp/branch context).
            if cg_on(c) {
                (*c).cglk = 3;
                (*c).cglv = nullable_inner_of(c, exp);
                0
            } else {
                0
            };
            exp
        },
        Expr::Var(nm) => {
            let vid: i64 = sc_lookup(c, &nm);
            sink_name(gb, nm);
            // (ADR 0046) record this directly-named binding so an enclosing FieldAccess can
            // detect a `base.field` partial move (the dump_texpr top reset cleared it, so a
            // non-`Var` target leaves -1).
            (*c).mvbv = vid;
            // (6/N) a Var in a consuming position moves it (if non-Copy).
            if (*c).consuming {
                record_move(c, vid);
                0
            } else {
                0
            };
            let ty: i64 = env_get(c, vid);
            let w: bool = widen_pre(out, exp, ty, c);
            append_str(out, "(var #");
            append_int(out, vid);
            close_ty(out, ty, c);
            // (7/N) MIR: a Var USE resolves to its current SSA value; record its VarId so
            // an enclosing assign can rebind it (7b). An UNBOUND VarId is a match-arm /
            // handler-arm payload binding the IR doesn't model — the Rust `lookup_var`
            // emits a fresh Opaque there (7c).
            if mir_on(c) {
                let mv: i64 = mir_vd_get(c, vid);
                let dv: i64 = if mv < 0 {
                    let mc: i64 = (*c).mir_cur;
                    mir_emit_opaque0(c, mc, ty)
                } else {
                    mv
                };
                (*c).lastval = dv;
                (*c).mir_lastvid = vid;
                0
            } else {
                0
            };
            // (8/N) codegen: record the VarId (for an enclosing assign); a normal read
            // loads from the var's alloca slot. An assign TARGET walk (cg_suppress) skips
            // the load — the assign emits the store itself.
            if cg_on(c) {
                // (Bar B / classes) `self` IS the `%arg0` pointer (no alloca). As a PLACE
                // (suppressed — an `&self` / `self.f` lvalue / method receiver) it yields
                // the `%arg0` operand (kind 4) + cg_lastvid=-1 (address-in-operand); as a
                // VALUE it loads the whole `%Class.N` aggregate from `%arg0`. A normal var
                // records its vid + (unless suppressed) loads from its alloca slot.
                if (*c).cg_self_var == vid {
                    if (*c).cg_suppress {
                        (*c).cglk = 4;
                        (*c).cglv = 0;
                        0
                    } else {
                        cg_load_self(c, ty);
                        0
                    };
                    (*c).cg_lastvid = 0 - 1;
                    0
                } else {
                    (*c).cg_lastvid = vid;
                    if (*c).cg_suppress {
                        0
                    } else {
                        let cgslot: i64 = cg_slot_get(c, vid);
                        cg_load(c, ty, cgslot);
                        0
                    };
                    0
                };
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, ty, c)
        },
        Expr::Unary(uop, inner) => {
            append_str(out, "(unary ");
            let usym: [u8] = if uop == 1 {
                "-"
            } else if uop == 2 {
                "!"
            } else if uop == 3 {
                "*"
            } else if uop == 4 {
                "&"
            } else {
                "&mut"
            };
            append_str(out, usym);
            push(out, ' ');
            // (6/N) a `&`/`&mut` borrow + `*` deref operand is NON-consuming (and `-`/`!`
            // operands are Copy scalars → moot); never a move.
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            // (8d) codegen lvalue handling: `&`/`&mut` want the inner's ADDRESS — suppress
            // its Var load (the slot IS the pointer); `*` wants the inner's VALUE (the
            // pointer, loaded). `un_place` = whether THIS unary is itself an assign-target
            // place (an `*r = …` set cg_suppress before walking us).
            let un_place: bool = (*c).cg_suppress;
            if cg_on(c) {
                if uop == 4 {
                    (*c).cg_suppress = true;
                    0
                } else if uop == 5 {
                    (*c).cg_suppress = true;
                    0
                } else {
                    (*c).cg_suppress = false;
                    0
                };
                0
            } else {
                0
            };
            let it: i64 = dump_texpr(out, inner, 0 - 1, src, c, gb);
            let iv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            // (8/N) codegen: capture the inner operand (kind+value) before emitting.
            let cguk: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cguv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            // (8d) the inner Var's id (recorded under suppress) — for `&v`'s slot.
            let un_vid: i64 = if cg_on(c) {
                (*c).cg_lastvid
            } else {
                0 - 1
            };
            if cg_on(c) {
                (*c).cg_suppress = un_place;
                0
            } else {
                0
            };
            (*c).consuming = svc;
            // `!` -> bool; `&`/`&mut` -> a ref type; `*` -> strip a ref; `-` -> operand.
            let rt: i64 = if uop == 2 {
                2
            } else if uop == 4 {
                mk_ref(c, 0, it)
            } else if uop == 5 {
                mk_ref(c, 1, it)
            } else if uop == 3 {
                strip_ref(c, it)
            } else {
                it
            };
            close_ty(out, rt, c);
            // (7/N) MIR: `*p` (uop 3) -> a Load (op 5, no index; a secret pointer is the
            // D5 leak); every other unary (- ! & &mut) -> a unary inst (op 2). One emit
            // (a per-branch `let` would collide in the flat namespace).
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let uo: i64 = if uop == 3 {
                    5
                } else {
                    2
                };
                let us: i64 = if uop == 3 {
                    0
                } else {
                    uop
                };
                let ub: i64 = if uop == 3 {
                    0 - 1
                } else {
                    0
                };
                let d: i64 = mir_emit(c, mc, uo, us, iv, ub, rt);
                (*c).lastval = d;
                (*c).mir_lastvid = 0 - 1;
                0
            } else {
                0
            };
            // (8/N) codegen: `-x`→`sub <ty> 0, x`; `!b`→`xor i1 b, 1`; (8d) `*r`→`load <rt>,
            // ptr <r-val>` (or, as an assign-target place, leave r's pointer + signal -1);
            // `&v`/`&mut v`→v's alloca slot (the pointer; no instruction).
            if cg_on(c) {
                if uop == 1 {
                    cg_neg(c, rt, cguk, cguv);
                    0
                } else if uop == 2 {
                    cg_not(c, cguk, cguv);
                    0
                } else if uop == 3 {
                    if un_place {
                        (*c).cg_lastvid = 0 - 1;
                        0
                    } else {
                        let und: i64 = cg_dst(c);
                        cgo_str(c, "load ");
                        cgo_ty(c, rt);
                        cgo_str(c, ", ptr ");
                        cgo_operand(c, cguk, cguv);
                        cg_putc(c, '\n');
                        cg_reg(c, und);
                        0
                    };
                    0
                } else {
                    if un_vid >= 0 {
                        let uncgsl: i64 = cg_slot_get(c, un_vid);
                        cg_reg(c, uncgsl);
                        0
                    } else {
                        // `&*r` reborrow: the inner deref-place already left r's pointer
                        // in the operand (un_vid = -1) — that IS the address; keep it.
                        0
                    };
                    0
                };
                0
            } else {
                0
            };
            rt
        },
        Expr::Binary(bop, l, r) => {
            // The result type is known only AFTER the operands synthesize, but a
            // `(widen-null …)` wrapper must PRECEDE the node — so build the binop into
            // a temp buffer, then splice with the optional wrapper (`maybe_double`'s
            // `a * 2 : i64` widens to `?i64` in a `?i64`-returning branch).
            let mut tmp: Vec<u8> = vec_new();
            push(&mut tmp, '(');
            let pfx: [u8] = if bop <= 7 || bop == 16 || bop == 17 {
                "binop"
            } else if bop <= 13 {
                "cmp"
            } else {
                "logic"
            };
            append_str(&mut tmp, pfx);
            push(&mut tmp, ' ');
            let bsym: [u8] = if bop == 1 {
                "+"
            } else if bop == 2 {
                "-"
            } else if bop == 3 {
                "*"
            } else if bop == 4 {
                "/"
            } else if bop == 5 {
                "&"
            } else if bop == 6 {
                "|"
            } else if bop == 7 {
                "^"
            } else if bop == 8 {
                "=="
            } else if bop == 9 {
                "!="
            } else if bop == 10 {
                "<"
            } else if bop == 11 {
                "<="
            } else if bop == 12 {
                ">"
            } else if bop == 13 {
                ">="
            } else if bop == 14 {
                "&&"
            } else if bop == 16 {
                "<<"
            } else if bop == 17 {
                ">>"
            } else {
                "||"
            };
            append_str(&mut tmp, bsym);
            push(&mut tmp, ' ');
            // (ADR 0051) Build each operand into its OWN buffer so a public operand can
            // be wrapped in `(widen-secret …)` when it meets a secret one (the widen
            // decision needs BOTH operand types, known only after both dumps). The
            // operands' MIR/CG already emit into the streams during their `dump_texpr`.
            let mut lbuf: Vec<u8> = vec_new();
            let lt: i64 = dump_texpr(&mut lbuf, l, 0 - 1, src, c, gb);
            let mut blv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            // (8/N) codegen: capture the left operand (overwritten by the right walk).
            let cglk0: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cglv0: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            // (7b) MIR: `&&`/`||` (bop 14/15) is a short-circuit BRANCH on the left — the
            // right operand evaluates only on the non-short edge. Fork now (before the
            // right walk, which then emits into `rhs_blk`). And: true->rhs, false->short;
            // Or: true->short, false->rhs.
            let mut rhs_blk: i64 = 0 - 1;
            let mut short_blk: i64 = 0 - 1;
            if mir_on(c) {
                // ADR 0048: only `&&`/`||` (14/15) short-circuit; shifts (16/17)
                // are ordinary binops and must NOT fork here.
                if bop == 14 || bop == 15 {
                    rhs_blk = mir_new_block(c);
                    short_blk = mir_new_block(c);
                    let pred: i64 = (*c).mir_cur;
                    if bop == 14 {
                        mir_term_branch(c, pred, blv, rhs_blk, short_blk);
                        0
                    } else {
                        mir_term_branch(c, pred, blv, short_blk, rhs_blk);
                        0
                    };
                    (*c).mir_cur = rhs_blk;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            // (8b) cg: && / || short-circuit — branch on the left BEFORE the right walk
            // so the right operand emits into the rhs block. Allocate rhs/short/merge.
            let mut cg_lrhs: i64 = 0 - 1;
            let mut cg_lshort: i64 = 0 - 1;
            let mut cg_lmerge: i64 = 0 - 1;
            let mut cg_lslot: i64 = 0 - 1;
            if cg_on(c) {
                // ADR 0048: only `&&`/`||` (14/15) short-circuit; shifts are binops.
                if bop == 14 || bop == 15 {
                    cg_lrhs = cg_fresh_block(c);
                    cg_lshort = cg_fresh_block(c);
                    cg_lmerge = cg_fresh_block(c);
                    cgo_str(c, "  br i1 ");
                    cgo_operand(c, cglk0, cglv0);
                    if bop == 14 {
                        cgo_str(c, ", label %bb");
                        cgo_int(c, cg_lrhs);
                        cgo_str(c, ", label %bb");
                        cgo_int(c, cg_lshort);
                        0
                    } else {
                        cgo_str(c, ", label %bb");
                        cgo_int(c, cg_lshort);
                        cgo_str(c, ", label %bb");
                        cgo_int(c, cg_lrhs);
                        0
                    };
                    cg_putc(c, '\n');
                    cgo_str(c, "bb");
                    cgo_int(c, cg_lrhs);
                    cgo_str(c, ":\n");
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            // `==`/`!=` (bop 8/9): the right operand inherits the left's type, so
            // `x == null` types the `null` as `x`'s `?T` (ADR 0014 D7).
            let rexp: i64 = if bop == 8 {
                lt
            } else if bop == 9 {
                lt
            } else {
                0 - 1
            };
            let mut rbuf: Vec<u8> = vec_new();
            let rt: i64 = dump_texpr(&mut rbuf, r, rexp, src, c, gb);
            let mut brv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            // (8/N) codegen: capture the right operand.
            let cgrk: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cgrv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            // (ADR 0051) public->secret OPERAND widen: a SYMMETRIC op (`+ - * & | ^`,
            // bop 1,2,3,5,6,7) or a comparison (bop 8..13) with the SAME stripped inner
            // type but exactly ONE secret operand WIDENS the public operand to secret
            // (result secret). EXCLUDES `/` (4) and the shifts (16,17) — their secret
            // divisor / shift-amount sinks must STILL reject — and `&&`/`||` (14,15).
            let lstrip: i64 = strip_secret(c, lt);
            let rstrip: i64 = strip_secret(c, rt);
            let lsec: bool = is_secret(c, lt);
            let rsec: bool = is_secret(c, rt);
            let wsym: bool = (bop >= 1 && bop <= 3) || bop == 5 || bop == 6 || bop == 7 || (bop >= 8 && bop <= 13);
            let dowiden: bool = wsym && lstrip == rstrip && lsec != rsec;
            let starget: i64 = mk_secret(c, lstrip);
            let widen_l: bool = dowiden && !lsec;
            let widen_r: bool = dowiden && !rsec;
            // arithmetic (<=7) preserves the operand type — so a secret operand makes
            // the result secret automatically (`lt` is already `secret T`); with the
            // widen, a `secret op public` arith is secret too (`starget`). cmp -> bool,
            // but secret-preserving: a secret operand → `secret bool` (ADR 0019 D5b).
            let resty: i64 = if bop <= 7 || bop == 16 || bop == 17 {
                if dowiden {
                    starget
                } else {
                    lt
                }
            } else if lsec {
                mk_secret(c, 2)
            } else if dowiden {
                mk_secret(c, 2)
            } else {
                2
            };
            // (7/N) MIR: the widened PUBLIC operand becomes an `Opaque` carrying its
            // value (the let-widen machinery, `mir_widen`) — mirrors the oracle lowering
            // `WidenToSecret` to `Opaque([inner])`. Re-capture the operand's SSA value so
            // the binop/cmp consumes the widened one.
            if mir_on(c) {
                if widen_r {
                    mir_widen(c, true, starget);
                    brv = (*c).lastval;
                    0
                } else if widen_l {
                    (*c).lastval = blv;
                    mir_widen(c, true, starget);
                    blv = (*c).lastval;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            // Splice the operands into `tmp`, wrapping the public one in `(widen-secret
            // … :secret T)` when widened (CG: a secret widen is value-level identity, so
            // the captured operand kinds are unchanged — `cg_widen`/oracle emit nothing).
            let lexp: i64 = if widen_l {
                starget
            } else {
                0 - 1
            };
            widen_splice(&mut tmp, lbuf, lexp, lt, c);
            push(&mut tmp, ' ');
            let rexp2: i64 = if widen_r {
                starget
            } else {
                0 - 1
            };
            widen_splice(&mut tmp, rbuf, rexp2, rt, c);
            close_ty(&mut tmp, resty, c);
            // (7/N) MIR: binop (bop<=7) / cmp (8..13) -> an inst; logic (&&/||) -> the
            // short-circuit merge (the (7b) fork above branched on the left).
            if mir_on(c) {
                if bop <= 13 || bop == 16 || bop == 17 {
                    let mc: i64 = (*c).mir_cur;
                    let mop: i64 = if bop <= 7 || bop == 16 || bop == 17 {
                        3
                    } else {
                        4
                    };
                    let d: i64 = mir_emit(c, mc, mop, bop, blv, brv, resty);
                    (*c).lastval = d;
                    0
                } else {
                    // logic short-circuit merge: the rhs value (brv) flows from the rhs
                    // exit; the short block yields a constant (false for &&, true for ||);
                    // both jump to a merge whose single param is the result.
                    let rhs_exit: i64 = (*c).mir_cur;
                    let sb: i64 = if bop == 15 {
                        1
                    } else {
                        0
                    };
                    let sval: i64 = mir_emit(c, short_blk, 1, 0, sb, 0, resty);
                    let merge: i64 = mir_new_block(c);
                    let result: i64 = mir_add_param(c, merge, resty);
                    let mut ra: Vec<i64> = vec_new();
                    let mut sa: Vec<i64> = vec_new();
