module types;

// --- (6/N) borrow-check move analysis (ADR 0043 A1) -------------------------

// True iff a value of type `h` is MOVED on a consuming use (non-Copy). Copy =
// scalars + Ref (kind 2) + Task (kind 12) + Channel (kind 13); Secret (3) /
// Nullable (4) follow their inner; Array (1) / Struct (6) / Enum (7) / Class (8) /
// TypeParam (9) / GenericInstance (10) / Vec (11) = Move.
fn is_move_type(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 2 {
            false
        } else if k == 12 {
            false
        } else if k == 13 {
            // (ADR 0066 M1.2) a Channel handle is Copy (pointer-like, shared
            // producer↔consumer by copying — it is the values that move on
            // `send`, not the handle). Mirrors the Rust is_copy_type.
            false
        } else if k == 14 {
            // (ADR 0066 M2.1) a Process handle is Copy (pointer-like, runtime-owned).
            false
        } else if k == 15 {
            // (ADR 0066 M2.4a / ADR 0069) a SealedChannel handle is Copy, same as Process.
            false
        } else if k == 3 {
            is_move_type(c, (*c).ta[idx])
        } else if k == 4 {
            is_move_type(c, (*c).ta[idx])
        } else {
            true
        }
    }
}

// Record a moved source: a `Var #vid` used in a CONSUMING position (`c.consuming`)
// whose type is non-Copy, inside a top-level fn body (`curfn >= 0`; methods aren't
// in `program.fns`, so their moves aren't dumped). Pushes `(curfn, vid)` into the
// `mvf`/`mvv` side-table (dedup happens at dump time via ascending-VarId membership).
fn record_move(c: &mut TyCtx, vid: i64) -> i64 {
    if (*c).curfn < 0 {
        0
    } else if vid < 0 {
        0
    } else {
        let vty: i64 = (*c).env[vid];
        if is_move_type(c, vty) {
            let cf: i64 = (*c).curfn;
            push(&mut (*c).mvf, cf);
            push(&mut (*c).mvv, vid);
            0
        } else {
            0
        }
    }
}

// (ADR 0046) Record a PARTIAL move: a Move-typed `base.field` consumed by value (the
// FieldAccess arm has already checked `consuming`, a direct-`Var` base, and a Move field
// type). Pushes `(curfn, base, field)` into the `mff`/`mfv`/`mfi` side-table — the whole
// `base` is NOT recorded (its other fields stay droppable). Codegen elides this field
// from `base`'s recursive drop; the mode-1 dump emits `#base.field`. The borrow-error
// half (`check_field_use_alive` etc.) is OUT OF SCOPE — the differential only compares
// fixtures the oracle accepts (ADR 0043 D5/D7), so the Sentinel side records + dumps but
// never rejects. Mirrors `check_and_record_field_move`'s record half.
fn record_field_move(c: &mut TyCtx, base: i64, field: i64) -> i64 {
    if (*c).curfn < 0 {
        0
    } else if base < 0 {
        0
    } else {
        let cf: i64 = (*c).curfn;
        push(&mut (*c).mff, cf);
        push(&mut (*c).mfv, base);
        push(&mut (*c).mfi, field);
        0
    }
}

fn dump_texpr(out: &mut Vec<u8>, ex: Expr, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    // (ADR 0046) reset the direct-Var tracker on entry; only the `Var` arm re-sets it. So
    // right after dumping a sub-expression, `mvbv >= 0` iff that sub-expression was a
    // directly-named binding read — the signal the FieldAccess arm needs for a partial move.
    (*c).mvbv = 0 - 1;
    match ex {
        Expr::Int(nv) => {
            let w: bool = widen_pre(out, exp, 0, c);
            append_str(out, "(int ");
            append_int(out, nv);
            close_ty(out, 0, c);
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 0, 0, nv, 0, 0);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (8/N) codegen: an int literal is an operand (no instruction).
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = nv;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, 0, c)
        },
        Expr::Bool(bv) => {
            let w: bool = widen_pre(out, exp, 2, c);
            if bv {
                append_str(out, "(bool true")
            } else {
                append_str(out, "(bool false")
            };
            close_ty(out, 2, c);
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let bi: i64 = if bv {
                    1
                } else {
                    0
                };
                let d: i64 = mir_emit(c, mc, 1, 0, bi, 0, 2);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (8/N) codegen: a bool literal is an i1 operand 0/1 (no instruction).
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = if bv {
                    1
                } else {
                    0
                };
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, 2, c)
        },
        // (4c-3) `null` carries no syntactic type; its type IS the expectation `exp`
        // (a `?T`), threaded from the let annotation / field / cmp-operand / branch.
        Expr::Null => {
            append_str(out, "(null");
            close_ty(out, exp, c);
            // (7c) MIR: `null` is a public constant -> Opaque (no operands), type `exp`.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque0(c, mc, exp);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (Bar B) codegen: `null` is a `{ i1 0, <zero> }` constant operand (kind 3),
            // keyed by `exp`'s inner type (a `?T` from the let/field/cmp/branch context).
            if cg_on(c) {
                (*c).cglk = 3;
                (*c).cglv = nullable_inner_of(c, exp);
                0
            } else {
                0
            };
            exp
        },
        Expr::Var(nm) => {
            let vid: i64 = sc_lookup(c, &nm);
            sink_name(gb, nm);
            // (ADR 0046) record this directly-named binding so an enclosing FieldAccess can
            // detect a `base.field` partial move (the dump_texpr top reset cleared it, so a
            // non-`Var` target leaves -1).
            (*c).mvbv = vid;
            // (6/N) a Var in a consuming position moves it (if non-Copy).
            if (*c).consuming {
                record_move(c, vid);
                0
            } else {
                0
            };
            let ty: i64 = env_get(c, vid);
            let w: bool = widen_pre(out, exp, ty, c);
            append_str(out, "(var #");
            append_int(out, vid);
            close_ty(out, ty, c);
            // (7/N) MIR: a Var USE resolves to its current SSA value; record its VarId so
            // an enclosing assign can rebind it (7b). An UNBOUND VarId is a match-arm /
            // handler-arm payload binding the IR doesn't model — the Rust `lookup_var`
            // emits a fresh Opaque there (7c).
            if mir_on(c) {
                let mv: i64 = mir_vd_get(c, vid);
                let dv: i64 = if mv < 0 {
                    let mc: i64 = (*c).mir_cur;
                    mir_emit_opaque0(c, mc, ty)
                } else {
                    mv
                };
                (*c).lastval = dv;
                (*c).mir_lastvid = vid;
                0
            } else {
                0
            };
            // (8/N) codegen: record the VarId (for an enclosing assign); a normal read
            // loads from the var's alloca slot. An assign TARGET walk (cg_suppress) skips
            // the load — the assign emits the store itself.
            if cg_on(c) {
                // (Bar B / classes) `self` IS the `%arg0` pointer (no alloca). As a PLACE
                // (suppressed — an `&self` / `self.f` lvalue / method receiver) it yields
                // the `%arg0` operand (kind 4) + cg_lastvid=-1 (address-in-operand); as a
                // VALUE it loads the whole `%Class.N` aggregate from `%arg0`. A normal var
                // records its vid + (unless suppressed) loads from its alloca slot.
                if (*c).cg_self_var == vid {
                    if (*c).cg_suppress {
                        (*c).cglk = 4;
                        (*c).cglv = 0;
                        0
                    } else {
                        cg_load_self(c, ty);
                        0
                    };
                    (*c).cg_lastvid = 0 - 1;
                    0
                } else {
                    (*c).cg_lastvid = vid;
                    if (*c).cg_suppress {
                        0
                    } else {
                        let cgslot: i64 = cg_slot_get(c, vid);
                        cg_load(c, ty, cgslot);
                        0
                    };
                    0
                };
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, ty, c)
        },
        Expr::Unary(uop, inner) => dump_te_unary(out, uop, inner, exp, src, c, gb),
        Expr::Binary(bop, l, r) => dump_te_binary(out, bop, l, r, exp, src, c, gb),
        Expr::If(cnd, thn, els) => dump_te_if(out, cnd, thn, els, exp, src, c, gb),
        Expr::Block(stmts, tail) => {
            append_str(out, "(block");
            // (8d-drops) a block opens a scope frame; its un-moved heap locals are
            // freed at its exit (after the tail value, before it's used by the parent).
            let cgmark: i64 = if cg_on(c) {
                len((*c).cgdv)
            } else {
                0
            };
            dump_tstmts(out, stmts, src, c, gb);
            push(out, ' ');
            // The block's value is its tail — thread the expectation through to it.
            let tt: i64 = dump_texpr(out, tail, exp, src, c, gb);
            close_ty(out, tt, c);
            if cg_on(c) {
                cg_drop_frame(c, cgmark);
                0
            } else {
                0
            };
            tt
        },
        Expr::Call(cn, ca) => dump_te_call(out, cn, ca, exp, src, c, gb),
        Expr::SynthZero => {
            let w: bool = widen_pre(out, exp, 0, c);
            append_str(out, "(int 0");
            close_ty(out, 0, c);
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 0, 0, 0, 0, 0);
                (*c).lastval = d;
                0
            } else {
                0
            };
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = 0;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            cg_widen(c, w, exp);
            widen_post(out, w, exp, 0, c)
        },
        // (4c-1) struct literal — positional field VALUES in declaration order
        // (the corpus writes fields in decl order, so source order = decl order;
        // a reorder is a follow-up if a fixture needs it). The node's type is the
        // struct. `(struct-lit #sid Name <v0> <v1>… :Name)`.
        Expr::StructLit(snm, fields) => {
            let sid: i64 = struct_lookup(c, &snm);
            // (4h) a GENERIC struct-lit takes its type (and its type-args) from the
            // expected type `exp` (a GenericInstance of this struct — threaded from a
            // `let` annotation / fn return). The arg Vec is built ONCE here, so
            // `dump_sfields` stays a single Fields-consumer (no parallel-consumer leak).
            let sl_gd: i64 = gi_decl_of(c, exp);
            let sl_isg: bool = if sl_gd >= 0 {
                sl_gd == sid
            } else {
                false
            };
            let sty: i64 = if sl_isg {
                exp
            } else {
                mk_struct(c, sid)
            };
            let mut gargs: Vec<i64> = vec_new();
            if sl_isg {
                let sl_gas: i64 = gi_argstart(c, exp);
                let sl_gae: i64 = gi_argend(c, exp);
                let mut sl_j: i64 = sl_gas;
                while sl_j < sl_gae {
                    let sl_a: i64 = (*c).gia[sl_j];
                    push(&mut gargs, sl_a);
                    sl_j = sl_j + 1;
                }
                0
            } else {
                0
            };
            append_str(out, "(struct-lit #");
            append_int(out, sid);
            push(out, ' ');
            append_str(out, snm);
            // (6/N) struct-lit field values are CONSUMING (moved into the struct).
            let sl_svc: bool = (*c).consuming;
            (*c).consuming = true;
            // (7c) MIR: collect the field values, then Opaque over them.
            let sl_col: bool = (*c).mir_collecting;
            if mir_on(c) {
                (*c).mir_collecting = true;
                0
            } else {
                0
            };
            let sl_snap: i64 = if mir_on(c) {
                mir_margs_len(c)
            } else {
                0
            };
            // (8c-1) codegen: collect field operands during the walk, then emit the
            // `insertvalue` chain (mirrors the call arm; snapshot the arg-stack top).
            let sl_cgcol: bool = (*c).cg_collecting;
            if cg_on(c) {
                (*c).cg_collecting = true;
                0
            } else {
                0
            };
            let sl_cgsnap: i64 = if cg_on(c) {
                len((*c).cgak)
            } else {
                0
            };
            dump_sfields(out, fields, sid, sl_isg, &gargs, src, c, gb);
            (*c).consuming = sl_svc;
            close_ty(out, sty, c);
            if mir_on(c) {
                (*c).mir_collecting = sl_col;
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_va(c, mc, 7, 0, sl_snap, sty);
                (*c).lastval = d;
                0
            } else {
                0
            };
            if cg_on(c) {
                (*c).cg_collecting = sl_cgcol;
                cg_emit_structlit(c, sty, sl_cgsnap);
                0
            } else {
                0
            };
            sty
        },
        // (4c-1) field access — `(field <target :Struct> name <field_index> :fty)`.
        // The target's type is a struct; types computes the field's declaration
        // index (for codegen's GEP) + the field type.
        Expr::Field(ft, fdn) => dump_te_field(out, ft, fdn, exp, src, c, gb),
        // (4c-2) array literal — `(array <e0> <e1>… :[T])`. The element type is
        // inferred from the first element, or — for an EMPTY literal — from the
        // expected type `exp` (ADR 0068; else i64); the node's type is `[T]`.
        Expr::Array(elems) => {
            append_str(out, "(array");
            // (6/N) array elements are CONSUMING (moved into the array).
            let ar_svc: bool = (*c).consuming;
            (*c).consuming = true;
            // (7c) MIR: collect the element values, then Opaque over them.
            let ar_col: bool = (*c).mir_collecting;
            if mir_on(c) {
                (*c).mir_collecting = true;
                0
            } else {
                0
            };
            let ar_snap: i64 = if mir_on(c) {
                mir_margs_len(c)
            } else {
                0
            };
            // (8c-2) codegen: collect element operands during the walk, then emit
            // alloc + GEP-stores + insertvalue {len,ptr} after (the struct-lit shape).
            let ar_cgcol: bool = (*c).cg_collecting;
            if cg_on(c) {
                (*c).cg_collecting = true;
                0
            } else {
                0
            };
            let ar_cgsnap: i64 = if cg_on(c) {
                len((*c).cgak)
            } else {
                0
            };
            let ety_raw: i64 = dump_array_elems(out, elems, src, c, gb);
            // (ADR 0068) an EMPTY literal `[]` can't infer its element from the
            // elements — take it from the expected/annotation array type (`exp`),
            // exactly as the Rust oracle uses the node's stored `elem_ty`. Non-empty
            // literals keep the first-element type. `array_elem_of(exp)` is i64 when
            // `exp` is absent (-1) / not an array, preserving the old default.
            let ety: i64 = if ety_raw == 0 - 1 {
                array_elem_of(c, exp)
            } else {
                ety_raw
            };
            (*c).consuming = ar_svc;
            let aty: i64 = mk_array(c, ety);
            close_ty(out, aty, c);
            if mir_on(c) {
                (*c).mir_collecting = ar_col;
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_va(c, mc, 7, 0, ar_snap, aty);
                (*c).lastval = d;
                0
            } else {
                0
            };
            if cg_on(c) {
                (*c).cg_collecting = ar_cgcol;
                cg_emit_arraylit(c, ety, ar_cgsnap);
                0
            } else {
                0
            };
            aty
        },
        // (4c-2) postfix index — `(index <target :[T]> <index :i64> :T)`. The
        // element type is the array's inner.
        Expr::Index(it, ii) => {
            append_str(out, "(index ");
            // (6/N) `a[i]` reads `a` + `i` (both non-consuming) — neither is moved.
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            // (ADR 0050) when this `Index` is an assign TARGET the enclosing assign set
            // cg_suppress; but the array + index SUB-exprs are still VALUES (the aggregate
            // is loaded, the index is a value) — only the `Index` node itself is the place.
            // Clear cg_suppress for the sub-walks, restore it for the place/read branch.
            let ix_place: bool = (*c).cg_suppress;
            if cg_on(c) {
                (*c).cg_suppress = false;
                0
            } else {
                0
            };
            let tty: i64 = dump_texpr(out, it, 0 - 1, src, c, gb);
            let ibase: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            // (8c-2) codegen: capture the array-aggregate operand (the bounds-check
            // + GEP + load emit after the index operand is known).
            let cg_itk: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cg_itv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            push(out, ' ');
            dump_texpr(out, ii, 0 - 1, src, c, gb);
            let iidx: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            let cg_iik: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cg_iiv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            if cg_on(c) {
                (*c).cg_suppress = ix_place;
                0
            } else {
                0
            };
            (*c).consuming = svc;
            let ety: i64 = array_elem_of(c, tty);
            close_ty(out, ety, c);
            // (7c) MIR: `a[i]` is a Load (base + index — a secret index is the D5 leak).
            // Under an assign target walk mir_suppress is set, so `mir_emit` returns -1
            // (no Load emitted) and mir_lastvid stays -1 — the assign funnels the RHS
            // through Opaque, exactly like a field/`*`-deref store.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 5, 0, ibase, iidx, ety);
                (*c).lastval = d;
                (*c).mir_lastvid = 0 - 1;
                0
            } else {
                0
            };
            // (ADR 0050) codegen: a PLACE (assign target, cg_suppress) leaves the
            // bounds-checked element GEP pointer in the operand (cg_lastvid=-1, so the
            // assign stores THROUGH it); a VALUE (read) loads through it.
            if cg_on(c) {
                if ix_place {
                    let iep: i64 = cg_emit_index_addr(c, ety, tty, cg_itk, cg_itv, cg_iik, cg_iiv);
                    cg_reg(c, iep);
                    (*c).cg_lastvid = 0 - 1;
                    0
                } else {
                    cg_emit_index(c, ety, tty, cg_itk, cg_itv, cg_iik, cg_iiv);
                    0
                };
                0
            } else {
                0
            };
            ety
        },
        // (4e) `Name::Variant(args)` / paren-less `Name::Variant`. If `Name` is an
        // enum → `(enum-construct #eid vidx Enum Variant <typed-args> :Enum)` (mirror
        // resolve's split). A non-enum `::` (a named-impl qcall) lands at 4f — emit a
        // non-leaking placeholder (args consumed) so the match stays exhaustive.
        Expr::Qcall(qi, qm, qa) => {
            // (7c) MIR: an enum-construct / qcall-impl funnels its args through Opaque.
            let q_col: bool = (*c).mir_collecting;
            if mir_on(c) {
                (*c).mir_collecting = true;
                0
            } else {
                0
            };
            let q_snap: i64 = if mir_on(c) {
                mir_margs_len(c)
            } else {
                0
            };
            let qeid: i64 = enum_lookup(c, &qi);
            // (Bar B / classes) cg: a named-impl qualified call needs the impl name `qi`
            // for its symbol, but the S-expr dump consumes it — copy it now (only the
            // impl-qcall case uses it; the enum-construct case frees the empty copy).
            let cg_qi: Vec<u8> = if cg_on(c) {
                if qeid < 0 {
                    cg_copy_name(&qi)
                } else {
                    vec_new()
                }
            } else {
                vec_new()
            };
            let qrt: i64 = if qeid >= 0 {
                let _qix: [u8] = vec_to_array(cg_qi);
                let vidx: i64 = variant_index(c, qeid, &qm);
                let ety: i64 = mk_enum(c, qeid);
                append_str(out, "(enum-construct #");
                append_int(out, qeid);
                push(out, ' ');
                append_int(out, vidx);
                push(out, ' ');
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                // (8e-1) cg: collect the construct args, then emit { i32 tag, ptr payload }.
                let cg_ec_col: bool = (*c).cg_collecting;
                let cg_ec_snap: i64 = if cg_on(c) {
                    len((*c).cgak)
                } else {
                    0
                };
                if cg_on(c) {
                    (*c).cg_collecting = true;
                    0
                } else {
                    0
                };
                dump_cargs(out, qa, src, c, gb);
                if cg_on(c) {
                    (*c).cg_collecting = cg_ec_col;
                    cg_emit_enum_construct(c, qeid, vidx, cg_ec_snap);
                    0
                } else {
                    0
                };
                close_ty(out, ety, c);
                ety
            } else {
                // (4f) a named-impl qualified call `ImplName::method(args)` →
                // `(qcall-impl #iid <method_index> ImplName method <args> :ret)` (the
                // method index + return type come from the impl's trait).
                let iid: i64 = impl_lookup(c, &qi);
                let qtid: i64 = impl_trait_of(c, iid);
                let qmidx: i64 = trait_method_index(c, qtid, &qm);
                let qmret: i64 = trait_method_ret(c, qtid, &qm);
