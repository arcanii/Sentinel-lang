module types;

// --- raw output primitives (push directly onto (*c).cgout via the builtin) ----

// push the bytes of `s` (consumed by value → drops at exit).
fn cgo_str(c: &mut TyCtx, s: [u8]) -> i64 {
    let n: i64 = len(s);
    let mut i: i64 = 0;
    while i < n {
        cg_putc(c, s[i]);
        i = i + 1;
    }
    0
}

// push the bytes of `src[st..en]`.
fn cgo_slice(c: &mut TyCtx, src: &[u8], st: i64, en: i64) -> i64 {
    let mut i: i64 = st;
    while i < en {
        cg_putc(c, (*src)[i]);
        i = i + 1;
    }
    0
}

// push `n` in decimal.
fn cgo_int(c: &mut TyCtx, n: i64) -> i64 {
    if n < 0 {
        cg_putc(c, i64_to_u8(45));
        cgo_int_pos(c, 0 - n)
    } else {
        cgo_int_pos(c, n)
    }
}

fn cgo_int_pos(c: &mut TyCtx, n: i64) -> i64 {
    if n >= 10 {
        cgo_int_pos(c, n / 10);
        0
    } else {
        0
    };
    let d: i64 = n - (n / 10) * 10;
    cg_putc(c, i64_to_u8(48 + d));
    0
}

// the .ll scalar type for a handle (8a): 0 i64 / 1 i32 / 2 bool→i1 / 3 u8→i8.
// True iff `h` is an array type `[T]` (interner kind 1).
fn cg_is_array(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 1
    }
}

// True iff `h` is a reference type `&T`/`&mut T` (interner kind 2).
fn cg_is_ref(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 2
    }
}

// True iff `h` is a `Vec<T>` (interner kind 11).
fn cg_is_vec(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 11
    }
}

// (concurrency) a `Task<T>` (interner kind 12) — codegen holds it as an opaque `*Task`.
fn cg_is_task(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 12
    }
}

// (ADR 0066 M1.2) is `h` a `Channel<T>` (interner kind 13)? Lowers to `ptr`.
fn cg_is_channel(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 13
    }
}

// (ADR 0066 M2.1) is `h` a `Process` (interner kind 14)? Lowers to `ptr`.
fn cg_is_process(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 14
    }
}

// (ADR 0066 M2.4a / ADR 0069) is `h` a `SealedChannel` (interner kind 15)?
// Lowers to `ptr`, same as `Process`.
fn cg_is_sealed_channel(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 15
    }
}

// (ADR 0070) is `h` a `Fn<T,R>` (interner kind 16)? Lowers to a bare `ptr`
// (a non-capturing function value is a plain function pointer).
fn cg_is_fn(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 16
    }
}

// (ADR 0071 M1.4a) is `h` a `Shared<T>` (interner kind 17)? Lowers to an opaque
// `ptr` (*SentinelShared).
fn cg_is_shared(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 17
    }
}

// (ADR 0071 M1.4b) is `h` a `Mutex<T>` (interner kind 18)? Lowers to an opaque
// `ptr` (*SentinelMutex).
fn cg_is_mutex(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 18
    }
}

// (ADR 0071 M1.4b) is `h` a `Guard<T>` (interner kind 19)? Lowers to a single
// opaque `ptr` (the runtime guard handle). `?Guard` is `{ i1, ptr }`.
fn cg_is_guard(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 19
    }
}

// (Bar B) true iff `h` is a nullable `?T` (interner kind 4).
fn cg_is_nullable(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 4
    }
}

// (register D39) Does a `?T` payload HEAP-INDIRECT — i.e. render as `ptr` and zero as
// `ptr null`? Exactly when `T` is a user struct (interner kind 6) or a generic-struct
// INSTANCE (kind 10). That is the Rust side's `NullableInner::Struct(_) |
// NullableInner::GenericInstance(_)`. ADR 0015 D11 introduced the indirection to break
// a recursive struct's layout cycle, ADR 0016 D6b extended `NullableInner` to
// instances, and ADR 0045 A22 prescribes it for `cgo_ty`/`ll_type_to` here — scg
// spelled only the struct half, in all three of ITS places at once, so `?Node<i64>`
// rendered `{ i1, %Node_i64 }`: a self-referential aggregate, `llvm-as` "Cannot
// allocate unsized type".
//
// ⚠ THE RUST SIDE ASKS THIS QUESTION IN EIGHT PLACES AND TWO OF THEM ANSWER IT WRONG —
// so do NOT read this comment as "the Rust back ends are the reference, go copy them".
// Measured (`grep -n 'NullableInner::Struct'`):
//   SPELL THE PAIR (6) — `llvm_dump.rs` 2372 `NullLit`, 2388 the `WidenToNullable`
//     REFUSAL, 4210 `llvm_ty`; `sentinel-codegen/src/lib.rs` 2205 `needs_drop`,
//     2381 `llvm_basic_type`, 5159 the drop emitter.
//   STRUCT-ONLY, i.e. still carrying the defect this helper fixes (2) —
//     `sentinel-codegen/src/lib.rs` 8571 `NullLit` and 8722 `WidenToNullable`, both in
//     inkwell's `lower_expr`. 8722 fails LLVM verification on a `?GI` widen; 8571 is
//     harmless only because its payload is all-zero and LLVM folds a mistyped all-zero
//     element list to a `zeroinitializer` of the target type. Both are filed.
//
// ⚠ THE NARROWNESS IS LOAD-BEARING, NOT CAUTION, and the site that proves it is
// `cgo_operand`. `?&T` / `?Channel<T>` / `?Guard<T>` also lower to a pointer, and in
// `cgo_ty`/`ll_type_to` they reach `ptr` through the `else` anyway — so widening the
// predicate would move no byte THERE. It is the `null` CONSTANT that differs: the
// oracle's `_` arm is `format!("{} 0", lty(inner))`, so those three spell `ptr 0`, not
// `ptr null`. A predicate restated as "the payload lowers to a pointer" emits
// `ptr null` for them and breaks a pair that is byte-identical today. (`ptr 0` is
// invalid IR on BOTH sides — a separate joint defect, and the oracle's to fix first.)
fn cg_nullable_payload_indirect(c: &mut TyCtx, nin: i64) -> bool {
    struct_of_handle(c, nin) >= 0 || gi_decl_of(c, nin) >= 0
}

// (Bar B) append a struct's name (from the struct-name blob `snb`) to `out`.
fn cg_struct_name_to(out: &mut Vec<u8>, c: &mut TyCtx, sid: i64) -> i64 {
    let bs: i64 = (*c).sts[sid];
    let be: i64 = (*c).ste[sid];
    let mut bi: i64 = bs;
    while bi < be {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    0
}

// (ADR 0016 A1) append an ENUM's name (`snb[ets[eid]..ete[eid]]`) to `out` — the enum
// twin of `cg_struct_name_to`. The name blob is shared; only the span table differs.
fn cg_enum_name_to(out: &mut Vec<u8>, c: &mut TyCtx, eid: i64) -> i64 {
    let bs: i64 = (*c).ets[eid];
    let be: i64 = (*c).ete[eid];
    let mut bi: i64 = bs;
    while bi < be {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    0
}

// (ADR 0016 A1) append a CLASS's name (`snb[clns[cid]..clne[cid]]`) to `out` — the
// out-buffer twin of `cg_emit_snb_clsname`, which writes to the cg buffer instead.
fn cg_class_name_to(out: &mut Vec<u8>, c: &mut TyCtx, cid: i64) -> i64 {
    let bs: i64 = (*c).clns[cid];
    let be: i64 = (*c).clne[cid];
    let mut bi: i64 = bs;
    while bi < be {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    0
}

// (ADR 0070) append a user fn's name (from the fn-name blob `ufnb`) to `out` —
// the `Fn` value's `@<name>` operand text. `fid` is a user FnId (>= 42).
fn cg_fn_name_to(out: &mut Vec<u8>, c: &mut TyCtx, fid: i64) -> i64 {
    let bs: i64 = (*c).ufns[fid - 42];
    let be: i64 = (*c).ufne[fid - 42];
    let mut bi: i64 = bs;
    while bi < be {
        push(out, (*c).ufnb[bi]);
        bi = bi + 1;
    }
    0
}

// (Bar B) the STRUCTURAL mangle tag for handle `h`, to an arbitrary buffer — `i64`,
// `arr_<elem>`, `Box_i64`, `Pair_i64_i64`, etc. Order-independent (no interner ids),
// mirroring the oracle's `mangle_type`/`mangle_instance`. Used for generic-instance
// LLVM type names (`%<mangled>`) + (Bar B mono) monomorphic fn symbols.
fn cg_mangle_to(out: &mut Vec<u8>, c: &mut TyCtx, h: i64) -> i64 {
    if h == 0 {
        append_str(out, "i64")
    } else if h == 1 {
        append_str(out, "i32")
    } else if h == 2 {
        append_str(out, "bool")
    } else if h == 3 {
        append_str(out, "u8")
    } else if h == 4 {
        // (ADR 0058) f64 as a generic type ARGUMENT. This arm is REACHABLE and
        // was found by review, after a first attempt documented it as
        // "unreachable" — it is not, and the repro is small:
        //     struct Pair<A, B> { a: A }
        //     fn main() -> i64 { let p: Pair<i64, f64> = Pair { a: 42 }; p.a }
        // `B` is phantom, so no f64 VALUE and no f64 field type ever exist, and
        // the MANGLED NAME is the only place f64 is mentioned. Without this arm
        // the `else` below computes `idx = 4 - tbase() = -96` and scg ABORTS with
        // an out-of-bounds index on a program the oracle accepts.
        //
        // ⚠ The TEXT changed at ADR 0016 A1, from `ty_F64` to `f64`. The old text
        // was copied from the oracle's defensive `other => format!("ty_{other:?}")`
        // catch-all — faithfully, and it did match byte-for-byte — but it matched
        // the WRONG side: inkwell, the shipping back end, always spelled it `f64`,
        // so oracle and scg agreed with each other and both disagreed with the
        // compiler that actually emits objects. A1 makes all three say `f64`.
        append_str(out, "f64")
    } else if h == 5 {
        // (ADR 0057) The same story one code over: `Pair<i64, ptr>` with a phantom
        // `B`. Same A1 text change, for the same reason (`ty_Ptr` -> `ptr`).
        append_str(out, "ptr")
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        // Bind payloads first (the nested-`&mut`-ctx quirk — see `cg_has_typeparam`).
        let ta_v: i64 = (*c).ta[idx];
        let tb_v: i64 = (*c).tb[idx];
        if k == 1 {
            append_str(out, "arr_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 2 {
            if ta_v == 1 {
                append_str(out, "refmut_")
            } else {
                append_str(out, "ref_")
            };
            cg_mangle_to(out, c, tb_v)
        } else if k == 3 {
            append_str(out, "sec_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 4 {
            append_str(out, "opt_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 11 {
            append_str(out, "vec_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 6 {
            cg_struct_name_to(out, c, ta_v)
        } else if k == 9 {
            append_str(out, "T");
            append_int(out, ta_v)
        } else if k == 10 {
            cg_struct_name_to(out, c, ta_v);
            let gas: i64 = gi_argstart(c, h);
            let gae: i64 = gi_argend(c, h);
            let mut gj: i64 = gas;
            while gj < gae {
                push(out, '_');
                let ga: i64 = (*c).gia[gj];
                cg_mangle_to(out, c, ga);
                gj = gj + 1;
            }
            0
        } else if k == 7 {
            // (ADR 0016 A1) Enum and Class render by their declared NAME, matching
            // the oracle and inkwell. Neither needs a concurrency feature to reach
            // this function — `Pair<i64, SomeEnum>` is enough — which is why the
            // old comment below was wrong about what was reachable.
            cg_enum_name_to(out, c, ta_v)
        } else if k == 8 {
            cg_class_name_to(out, c, ta_v)
        } else if k == 12 {
            append_str(out, "task_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 13 {
            append_str(out, "chan_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 14 {
            append_str(out, "process")
        } else if k == 15 {
            append_str(out, "sealedchannel")
        } else if k == 16 {
            append_str(out, "fn_");
            cg_mangle_to(out, c, ta_v);
            push(out, '_');
            cg_mangle_to(out, c, tb_v)
        } else if k == 17 {
            append_str(out, "shared_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 18 {
            append_str(out, "mutex_");
            cg_mangle_to(out, c, ta_v)
        } else if k == 19 {
            append_str(out, "guard_");
            cg_mangle_to(out, c, ta_v)
        } else {
            // (ADR 0016 A1) THE FALLBACK IS NOW LOUD, AND MUST STAY LOUD.
            //
            // What used to be here was `append_str(out, "ty")` — the single token
            // every unenumerated kind collapsed onto. That is a TEN-WAY COLLISION
            // (kinds 7, 8, 12..19), and it is not a byte diff: a program with both
            // `Pair<i64, Shared<i64>>` and `Pair<i64, Mutex<i64>>` made scg emit
            // `%Pair_i64_ty = type { i64 }` TWICE, which `llvm-as` rejects with
            // "redefinition of type". Its own comment claimed the arm was
            // unreachable "because nothing instantiates a generic at a container
            // kind through a PHANTOM parameter" — false twice over: a plain
            // `idg(ch)` on a Channel value reaches it through the MONO-KEY path with
            // no phantom parameter anywhere, and Enum/Class reach it at kinds that
            // are not containers at all.
            //
            // Every kind the interner can actually produce has an arm above — the
            // producible set is {1,2,3,4,6..19}, since `tk` has exactly two writers
            // (`intern_type` and `mk_generic`) and 5 is a SCALAR CODE (`ptr`, handled
            // in the `h < tbase()` prefix), not an interner kind. So this is dead
            // today. It stays as an ALARM rather than a silent guess:
            // a new interner kind that forgets its arm gets a name no oracle tag can
            // equal, so the codegen differential fails on the first program that
            // reaches it. `ty` had the opposite property — it was plausible enough
            // to pass unnoticed while producing invalid IR. Do NOT replace this with
            // a "reasonable-looking" default. (The Rust side gets this for free: its
            // `mangle_type` match is exhaustive, so a new variant is a compile
            // error.)
            //
            // ⚠ The alarm covers an unknown KIND, not an unknown HANDLE, and the
            // difference is worth knowing before relying on it: a handle that is
            // neither a scalar code 0..5 nor `>= tbase()` — notably the -1 REJECT
            // handle some type queries return — computes a negative `idx` in the
            // prefix above and ABORTS the whole stage instead of reaching here.
            // PRE-EXISTING (A1 changed the arms, not the dispatch shape), and an
            // abort is at least loud, but it is a crash rather than a diagnostic.
            append_str(out, "UNKNOWN_KIND_");
            append_int(out, k)
        }
    }
}

// (Bar B) true iff handle `h` mentions a TypeParam (kind 9) transitively. Abstract
// generic instances (TypeParam-bearing — interned for generic-fn sigs) are skipped in
// Pass 0 (no runtime layout). Mirrors the oracle's `type_has_typeparam`.
fn cg_has_typeparam(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        // Bind the payloads to locals FIRST (a recursive `cg_has_typeparam(c,
        // (*c).ta[idx])` re-reads `c` while passing it `&mut` — the nested-`&mut`-ctx
        // quirk yields a wrong value; the established idiom binds, like `render_type`).
        let ta_v: i64 = (*c).ta[idx];
        let tb_v: i64 = (*c).tb[idx];
        if k == 9 {
            true
        } else if k == 1 {
            cg_has_typeparam(c, ta_v)
        } else if k == 3 {
            cg_has_typeparam(c, ta_v)
        } else if k == 4 {
            cg_has_typeparam(c, ta_v)
        } else if k == 11 {
            cg_has_typeparam(c, ta_v)
        } else if k == 2 {
            cg_has_typeparam(c, tb_v)
        } else if k == 10 {
            let gas: i64 = gi_argstart(c, h);
            let gae: i64 = gi_argend(c, h);
            let mut gj: i64 = gas;
            let mut any: bool = false;
            while gj < gae {
                let ga: i64 = (*c).gia[gj];
                if cg_has_typeparam(c, ga) {
                    any = true;
                    0
                } else {
                    0
                };
                gj = gj + 1;
            }
            any
        } else {
            false
        }
    }
}

fn cgo_ty(c: &mut TyCtx, h: i64) -> i64 {
    // (Bar B) strip a top-level `secret T` to its inner FIRST — secret lowers
    // identically to its inner (ADR 0019 D5/D12); mirrors the oracle's `Emit::lty` /
    // inkwell's llvm_basic_type entry strip. A stripped primitive (`secret bool` →
    // `i1`) must route to the scalar arms, so strip BEFORE the dispatch.
    let hs: i64 = strip_secret(c, h);
    if hs == 0 {
        cgo_str(c, "i64")
    } else if hs == 1 {
        cgo_str(c, "i32")
    } else if hs == 2 {
        cgo_str(c, "i1")
    } else if hs == 3 {
        cgo_str(c, "i8")
    } else {
        // (8c-1) a user struct is the Pass-0 named aggregate `%Struct.N` (N =
        // StructId). (8c-2) `[T]` is the abi-v1 `{ i64, ptr }` (one inline literal
        // for every element type). Other compounds (refs/Vec/enum/generic) are
        // later slices → the i64 fallback (their fixtures Err in the oracle and
        // are skipped, so the fallback bytes are never compared).
        let sid: i64 = struct_of_handle(c, hs);
        if sid >= 0 {
            cgo_str(c, "%Struct.");
            cgo_int(c, sid)
        } else if cg_is_array(c, hs) {
            cgo_str(c, "{ i64, ptr }")
        } else if cg_is_ref(c, hs) {
            cgo_str(c, "ptr")
        } else if cg_is_vec(c, hs) {
            cgo_str(c, "{ i64, i64, ptr }")
        } else if enum_of_handle(c, hs) >= 0 {
            cgo_str(c, "{ i32, ptr }")
        } else if cg_is_nullable(c, hs) {
            // (Bar B) `?T` = `{ i1 valid, <payload> }` — inner-dependent: `?Struct` and
            // (register D39) `?GenericInstance` heap-indirect (`{ i1, ptr }`), while
            // `?primitive` stays inline (`{ i1, T }`). See
            // `cg_nullable_payload_indirect` for why that pair is the WHOLE set.
            cgo_str(c, "{ i1, ");
            let nin: i64 = nullable_inner_of(c, hs);
            if cg_nullable_payload_indirect(c, nin) {
                cgo_str(c, "ptr")
            } else {
                cgo_ty(c, nin)
            };
            cgo_str(c, " }")
        } else if gi_decl_of(c, hs) >= 0 {
            // (Bar B) a generic-struct instance `%<mangled>` (structural name, declared
            // in Pass 0). Render to a temp then emit (cgo_str routes to the cg buffer).
            cgo_str(c, "%");
            let mut gmb: Vec<u8> = vec_new();
            cg_mangle_to(&mut gmb, c, hs);
            cgo_str(c, vec_to_array(gmb))
        } else if class_of_handle(c, hs) >= 0 {
            // (Bar B / classes) a class is the Pass-0 named aggregate `%Class.N` — held
            // by VALUE as this aggregate (an init param / `let` / `Var(self)` load).
            let cgcid: i64 = class_of_handle(c, hs);
            cgo_str(c, "%Class.");
            cgo_int(c, cgcid)
        } else if cg_is_task(c, hs) {
            // (concurrency) a `Task<T>` is an opaque `*Task` pointer.
            cgo_str(c, "ptr")
        } else if cg_is_channel(c, hs) {
            // (ADR 0066 M1.2) a `Channel<T>` is an opaque `*SentinelChannel`.
            cgo_str(c, "ptr")
        } else if cg_is_process(c, hs) {
            // (ADR 0066 M2.1) a `Process` is an opaque `*SentinelProcess`.
            cgo_str(c, "ptr")
        } else if cg_is_sealed_channel(c, hs) {
            // (ADR 0066 M2.4a / ADR 0069) a `SealedChannel` is the same opaque
            // ptr as `Process` (the bridge builtins are identity passthroughs).
            cgo_str(c, "ptr")
        } else if cg_is_fn(c, hs) {
            // (ADR 0070) a `Fn<T,R>` value is a bare function pointer.
            cgo_str(c, "ptr")
        } else if cg_is_shared(c, hs) {
            // (ADR 0071 M1.4a) a `Shared<T>` is an opaque `*SentinelShared`.
            cgo_str(c, "ptr")
        } else if cg_is_mutex(c, hs) {
            // (ADR 0071 M1.4b) a `Mutex<T>` is an opaque `*SentinelMutex`.
            cgo_str(c, "ptr")
        } else if cg_is_guard(c, hs) {
            // (ADR 0071 M1.4b) a `Guard<T>` lowers to a single opaque ptr.
            cgo_str(c, "ptr")
        } else {
            cgo_str(c, "i64")
        }
    }
}

// (8c-1) the LLVM type for handle `h`, written to an ARBITRARY buffer `out` (Pass 0
// writes struct decls into `result`, not the cg buffer, so it can't route through
// `cgo_ty`/`cg_putc`). Mirrors `cgo_ty`'s mapping exactly.
fn ll_type_to(out: &mut Vec<u8>, c: &mut TyCtx, h: i64) -> i64 {
    // (Bar B) strip a top-level `secret T` first (mirrors `cgo_ty`); a Pass-0 struct
    // field of `secret` type lands here.
    let hs: i64 = strip_secret(c, h);
    if hs == 0 {
        append_str(out, "i64")
    } else if hs == 1 {
        append_str(out, "i32")
    } else if hs == 2 {
        append_str(out, "i1")
    } else if hs == 3 {
        append_str(out, "i8")
    } else {
        let sid: i64 = struct_of_handle(c, hs);
        if sid >= 0 {
            append_str(out, "%Struct.");
            append_int(out, sid)
        } else if cg_is_array(c, hs) {
            append_str(out, "{ i64, ptr }")
        } else if cg_is_ref(c, hs) {
            append_str(out, "ptr")
        } else if cg_is_vec(c, hs) {
            append_str(out, "{ i64, i64, ptr }")
        } else if enum_of_handle(c, hs) >= 0 {
            append_str(out, "{ i32, ptr }")
        } else if cg_is_nullable(c, hs) {
            // (Bar B) `?T` = `{ i1, <payload> }` (mirrors `cgo_ty`); a Pass-0 struct
            // field of nullable type lands here (`struct Node { next: ?Node }`), and
            // (register D39) so does a generic-instance one (`struct Node<T> { next:
            // ?Node<T> }`) — the same `cg_nullable_payload_indirect` set.
            append_str(out, "{ i1, ");
            let nin: i64 = nullable_inner_of(c, hs);
            if cg_nullable_payload_indirect(c, nin) {
                append_str(out, "ptr")
            } else {
                ll_type_to(out, c, nin)
            };
            append_str(out, " }")
        } else if gi_decl_of(c, hs) >= 0 {
            // (Bar B) a generic-struct instance `%<mangled>` (mirrors `cgo_ty`).
            push(out, '%');
            cg_mangle_to(out, c, hs)
        } else if class_of_handle(c, hs) >= 0 {
            // (Bar B / classes) a class is the Pass-0 named aggregate `%Class.N`.
            let llcid: i64 = class_of_handle(c, hs);
            append_str(out, "%Class.");
            append_int(out, llcid)
        } else if cg_is_task(c, hs) {
            // (concurrency) a `Task<T>` is an opaque `*Task` pointer.
            append_str(out, "ptr")
        } else if cg_is_channel(c, hs) {
            // (ADR 0066 M1.2) a `Channel<T>` is an opaque `*SentinelChannel`.
            append_str(out, "ptr")
        } else if cg_is_shared(c, hs) {
            // (ADR 0071 M1.4a) a `Shared<T>` is an opaque `*SentinelShared`.
            append_str(out, "ptr")
        } else if cg_is_mutex(c, hs) {
            // (ADR 0071 M1.4b) a `Mutex<T>` is an opaque `*SentinelMutex`.
            append_str(out, "ptr")
        } else if cg_is_guard(c, hs) {
            // (ADR 0071 M1.4b) a `Guard<T>` lowers to a single opaque ptr.
            append_str(out, "ptr")
        } else {
            append_str(out, "i64")
        }
    }
}

// (8c-1) Pass 0: emit `%Struct.N = type { <field-ll-types> }` for every struct in
// StructId order (= the oracle's `program.structs` order); an empty struct → `type
// {}`. Field types come from the flat field table (`fldo`/`fldty`), filtered by
// owner StructId, in declaration order. Generic decls have no runtime layout (only
// their concrete instances do), so Pass 0 skips them — mirroring the oracle's
// `type_params.is_empty()` skip.
//
// (register D26) Is this struct DECLARATION generic? Read straight off the decl's
// type-param count.
//
// ⚠ TWO PARAGRAPHS THAT STOOD HERE ARE DELETED, not amended, because both were false
// and one of them licensed the bug: "no oracle-emitting fixture declares [a generic
// struct]" (`examples/lang/generic_calls_generic.sentinel` declares three) and
// "detected by a TypeParam-bearing field … a phantom `<T>` isn't in the corpus; it
// would need a real type-param count". That last clause correctly predicted this fix
// and was then used as a reason not to make it.
//
// ⚠ THIS USED TO SCAN THE FIELDS for a type param, and that is unsound in one
// direction: a PHANTOM parameter leaves no trace in the field table, so
// `struct Shelf<S> { label: i64 }` answered `false` and Pass 0 emitted
// `%Struct.N = type { i64 }` — a runtime layout for a declaration that has none. Both
// Rust back ends skip generic decls in Pass 0 on the decl's own type-param count, and
// now so does this. (The field scan was never WRONG when it answered true — a field
// mentioning a type param does imply a generic decl — it was just incomplete, which is
// the harder kind of wrong to notice.)
fn cg_struct_is_generic(c: &mut TyCtx, sid: i64) -> bool {
    if sid < 0 {
        false
    } else if sid >= len((*c).sttp) {
        false
    } else {
        (*c).sttp[sid] > 0
    }
}

// (Bar B / generics-b) record a monomorphic fn instance `(fid, concrete args)` unless
// already recorded (dedup on fid + arg content). First-encounter order matches the
// oracle's worklist seed (the corpus has no transitive generic-from-generic calls).
fn cg_mono_record(c: &mut TyCtx, fid: i64, subst: &Vec<i64>) -> i64 {
    let na: i64 = len(*subst);
    let ni: i64 = len((*c).cgmono_fid);
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < ni {
        if (*c).cgmono_fid[i] == fid {
            let as0: i64 = (*c).cgmono_as[i];
            let ae0: i64 = (*c).cgmono_ae[i];
            if ae0 - as0 == na {
                let mut j: i64 = 0;
                let mut same: bool = true;
                while j < na {
                    if (*c).cgmono_pool[as0 + j] != (*subst)[j] {
                        same = false;
                        0
                    } else {
                        0
                    };
                    j = j + 1;
                }
                if same {
                    found = true;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    if found {
        0
    } else {
        let ps: i64 = len((*c).cgmono_pool);
        let mut kk: i64 = 0;
        while kk < na {
            push(&mut (*c).cgmono_pool, (*subst)[kk]);
            kk = kk + 1;
        }
        let pe: i64 = len((*c).cgmono_pool);
        push(&mut (*c).cgmono_fid, fid);
        push(&mut (*c).cgmono_as, ps);
        push(&mut (*c).cgmono_ae, pe);
        0
    };
    0
}

// (Bar B) emit the monomorphic-symbol suffix `__<mangle(arg0)>__<mangle(arg1)>…`.
// `args` must be a LOCAL copy (not `&(*c).cg_*`) — it aliases nothing while `c` is `&mut`.
fn cg_emit_mono_suffix(c: &mut TyCtx, args: &Vec<i64>) -> i64 {
    let n: i64 = len(*args);
    let mut i: i64 = 0;
    while i < n {
        cgo_str(c, "__");
        let a: i64 = (*args)[i];
        let mut mb: Vec<u8> = vec_new();
        cg_mangle_to(&mut mb, c, a);
        cgo_str(c, vec_to_array(mb));
        i = i + 1;
    }
    0
}

// (Bar B) copy `(*c).cg_mono_args` / `(*c).cg_targs` into a fresh local Vec (so it can
// be passed to a `&mut c` helper without aliasing). `which` 0 = cg_mono_args, 1 = cg_targs.
fn cg_copy_targs(c: &mut TyCtx, which: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new();
    let n: i64 = if which == 0 {
        len((*c).cg_mono_args)
    } else {
        len((*c).cg_targs)
    };
    let mut i: i64 = 0;
    while i < n {
        let a: i64 = if which == 0 {
            (*c).cg_mono_args[i]
        } else {
            (*c).cg_targs[i]
        };
        push(&mut v, a);
        i = i + 1;
    }
    v
}

fn cg_pass0(out: &mut Vec<u8>, c: &mut TyCtx) -> i64 {
    let ns: i64 = len((*c).sts);
    let mut sid: i64 = 0;
    let mut any: bool = false;
    while sid < ns {
        if cg_struct_is_generic(c, sid) {
            0
        } else {
            append_str(out, "%Struct.");
            append_int(out, sid);
            append_str(out, " = type {");
            let nf: i64 = len((*c).fldo);
            let mut i: i64 = 0;
            let mut first: bool = true;
            while i < nf {
                if (*c).fldo[i] == sid {
                    if first {
                        push(out, ' ');
                        first = false;
                        0
                    } else {
                        append_str(out, ", ")
                    };
                    let fh: i64 = (*c).fldty[i];
                    ll_type_to(out, c, fh);
                    0
                } else {
                    0
                };
                i = i + 1;
            }
            if first {
                0
            } else {
                push(out, ' ')
            };
            append_str(out, "}\n");
            any = true;
            0
        };
        sid = sid + 1;
    }
    // (Bar B) concrete generic-struct instance decls: `%<mangled> = type { <subst
    // fields> }` for each kind-10 interner entry whose args have no TypeParam. The
    // emission order (interner order) must match the oracle's `generic_instances` order.
    //
    // (register D25) ⚠ THE INTERNER GROWS DURING THIS LOOP, and the bound must be
    // re-read every iteration. `subst_type` on a field whose declared type is itself a
    // generic instance calls `mk_generic`, which INTERNS a new entry at the end of `tk`.
    // `struct Wrap<T> { b: Box<T> }` laid out at `bool` therefore CREATES `Box<bool>`
    // here — an instance nothing in the source spells and the type checker never
    // interned. With the bound snapshotted, that entry was never visited: scg emitted
    // `%Wrap_bool = type { %Box_bool }` referencing a type it never declared
    // (`llvm-as`: "use of undefined type named 'Box_bool'").
    //
    // Re-reading `len` also gets the ORDER right for free, and it is the oracle's:
    // the new instance is appended, so it emits AFTER every entry that already existed
    // — `Wrap_bool, Shelf_Wrap_bool, Box_i64, Box_bool`, byte-for-byte.
    //
    // The bound is the twin of the oracle's `MAX_INSTANCE_CLOSURE` and counts only the
    // instances THIS closure creates, never the program's own type count.
    //
    // ⚠ Do NOT justify it with `struct S<T> { c: S<S<T>> }` — an earlier version of this
    // comment did, and it is measurably wrong: that declaration alone is never
    // instantiated, so the oracle and both scg builds emit an identical 111 bytes and
    // the bound never fires. The shape that actually needs it is the NULLABLE self-
    // reference, `struct A<T> { x: ?A<A<T>>, n: i64 }`: without the declared-type filter
    // below, the closure substitutes it into a STRICTLY LARGER argument every round
    // (`A<i64>`, `A<A<i64>>`, `A<A<A<i64>>>`, …) and structural dedup never fires, so it
    // runs to `gcap` and emits the 8.4 MB the next paragraph records. (It does not spin
    // for ever — `gcap` in the `while` guard is what stops it — but the SET it is walking
    // is unbounded, which is the property that matters.)
    //
    // ⚠ That is a property of the CLOSURE, not of the renderer, and an earlier version
    // of this sentence got the causality backwards — it blamed scg "rendering that field
    // BY VALUE where the oracle renders `{ i1, ptr }`". The closure body below calls no
    // renderer at all (its only non-trivial calls are `cg_has_typeparam` / `gi_decl_of` /
    // `gi_argstart` / `gi_argend` / `subst_type`), and the ORACLE needed the identical
    // filter while already rendering `{ i1, ptr }`. The pointer rendering is what makes
    // SKIPPING the field CORRECT — the layout behind an indirection is never needed —
    // not what makes chasing it diverge. Register D39 has since given scg the same
    // `{ i1, ptr }`, so the by-value premise is now false as well as beside the point.
    // (register D25) CLOSURE PHASE. Walk the concrete generic instances and intern the
    // ones their BY-VALUE fields require, to a fixpoint. `struct Wrap<T> { b: Box<T> }`
    // laid out at `bool` needs `Box<bool>` NAMED, and nothing in the source spells it —
    // the type checker never interned it, so the emission loop below never saw it and
    // scg emitted `%Wrap_bool = type { %Box_bool }` referencing a type it never declared.
    //
    // ⚠ FILTER ON THE **DECLARED** FIELD TYPE, AND ONLY CHASE A BARE INSTANCE. A field
    // behind a `?`/array/ref renders as a POINTER, so its layout is never needed — and
    // chasing it does not terminate. `struct A<T> { x: ?A<A<T>>, n: i64 }` is the case:
    // the oracle emits ONE decl for it, and a first version of this fix (a bare re-read
    // of the loop bound below, with no filter) chased `?A<A<T>>` forever and emitted
    // 8.4 MB of declarations where the pre-change compiler emitted 428 bytes. That is
    // the identical mistake the ORACLE made when D15 first added ITS closure, fixed
    // there the same way — filter on the declared type, because filtering AFTER
    // substitution still emits a spurious `%A_A_A_i64`.
    let mut gcl: i64 = 0;
    let gcap: i64 = len((*c).tk) + 4096;
    while gcl < len((*c).tk) && len((*c).tk) < gcap {
        if (*c).tk[gcl] == 10 {
            let clh: i64 = tbase() + gcl;
            if cg_has_typeparam(c, clh) {
                0
            } else {
                let clsid: i64 = gi_decl_of(c, clh);
                let mut clargs: Vec<i64> = vec_new();
                let clas: i64 = gi_argstart(c, clh);
                let clae: i64 = gi_argend(c, clh);
                let mut clj: i64 = clas;
                while clj < clae {
                    push(&mut clargs, (*c).gia[clj]);
                    clj = clj + 1;
                }
                let clnf: i64 = len((*c).fldo);
                let mut clfi: i64 = 0;
                while clfi < clnf {
                    if (*c).fldo[clfi] == clsid {
                        let cldh: i64 = (*c).fldty[clfi];
                        // BARE generic instance (kind 10) or type param (kind 9) only.
                        let clbare: bool = if cldh < tbase() {
                            false
                        } else {
                            (*c).tk[cldh - tbase()] == 10 || (*c).tk[cldh - tbase()] == 9
                        };
                        if clbare {
                            subst_type(c, cldh, &clargs);
                            0
                        } else {
                            0
                        };
                        0
                    } else {
                        0
                    };
                    clfi = clfi + 1;
                }
                0
            };
            0
        } else {
            0
        };
        gcl = gcl + 1;
    }
    // EMISSION. The bound is snapshotted DELIBERATELY: the closure above has already
    // interned everything that needs a declaration, and `subst_type` on a pointer-shaped
    // field below may still intern an instance whose layout is NOT required. Emitting
    // those is what produced the 8.4 MB module.
    let nt: i64 = len((*c).tk);
    let mut ti: i64 = 0;
    while ti < nt {
        if (*c).tk[ti] == 10 {
            let gh: i64 = tbase() + ti;
            if cg_has_typeparam(c, gh) {
                0
            } else {
                push(out, '%');
                cg_mangle_to(out, c, gh);
                append_str(out, " = type {");
                let gsid: i64 = gi_decl_of(c, gh);
                let mut gargs: Vec<i64> = vec_new();
                let gas: i64 = gi_argstart(c, gh);
                let gae: i64 = gi_argend(c, gh);
                let mut gj: i64 = gas;
                while gj < gae {
                    push(&mut gargs, (*c).gia[gj]);
                    gj = gj + 1;
                }
                let gnf: i64 = len((*c).fldo);
                let mut gfi: i64 = 0;
                let mut gfirst: bool = true;
                while gfi < gnf {
                    if (*c).fldo[gfi] == gsid {
                        if gfirst {
                            push(out, ' ');
                            gfirst = false;
                            0
                        } else {
                            append_str(out, ", ")
                        };
                        let gfh: i64 = (*c).fldty[gfi];
                        let gch: i64 = subst_type(c, gfh, &gargs);
                        ll_type_to(out, c, gch);
                        0
                    } else {
                        0
                    };
                    gfi = gfi + 1;
                }
                if gfirst {
                    0
                } else {
                    push(out, ' ')
                };
                append_str(out, "}\n");
                any = true;
                0
            };
            0
        } else {
            0
        };
        ti = ti + 1;
    }
    // (Bar B / classes) class type decls `%Class.N = type { <field types> }` (N =
    // ClassId, source order), mirroring `%Struct.N`. Fields from the class-field table
    // (`clfo`/`clft`), filtered by owner ClassId, in declaration order (explicit fields
    // then delegate fields — the field-index order resolve assigns).
    let ncl: i64 = len((*c).clns);
    let mut clid: i64 = 0;
    while clid < ncl {
        append_str(out, "%Class.");
        append_int(out, clid);
        append_str(out, " = type {");
        let ncf: i64 = len((*c).clfo);
        let mut cfi: i64 = 0;
        let mut cffirst: bool = true;
        while cfi < ncf {
            if (*c).clfo[cfi] == clid {
                if cffirst {
                    push(out, ' ');
                    cffirst = false;
                    0
                } else {
                    append_str(out, ", ")
                };
                let cfh: i64 = (*c).clft[cfi];
                ll_type_to(out, c, cfh);
                0
            } else {
                0
            };
            cfi = cfi + 1;
        }
        if cffirst {
            0
        } else {
            push(out, ' ')
        };
        append_str(out, "}\n");
        any = true;
        clid = clid + 1;
    }
    if any {
        push(out, '\n')
    } else {
        0
    };
    0
}

// (ADR 0057) declare every `extern "C"` foreign import. The user-fn table's tail
// (`nufn..`) IS the extern list, in the oracle's registration order, so this mirrors
// `llvm_dump.rs`'s `for fn_id in &program.externs` loop directly: one
// `declare <ret> @<name>(<param-tys>)` each, under the BARE C symbol — a C symbol is
// global, never module-qualified — then ONE blank line if any were emitted.
//
// This is the half that makes an extern call legal rather than merely present: with
// the calls emitted but the declares missing, the module uses values it never
// defines and `llvm-as` refuses it outright ("use of undefined value '@getgid'").
// Emitted straight into `result` (not `cgout`) at the oracle's position — after the
// runtime-symbol declares, before the first `define`.
fn cg_extern_declares(out: &mut Vec<u8>, c: &mut TyCtx, src: &[u8]) -> i64 {
    let n: i64 = len((*c).ufs);
    let mut i: i64 = (*c).nufn;
    let mut any: bool = false;
    while i < n {
        append_str(out, "declare ");
        let rh: i64 = (*c).ufret[i];
        ll_type_to(out, c, rh);
        append_str(out, " @");
        let ns: i64 = (*c).ufs[i];
        let ne: i64 = (*c).ufe[i];
        append_slice(out, src, ns, ne);
        push(out, '(');
        let ps: i64 = (*c).ufps[i];
        let pe: i64 = (*c).ufpe[i];
        let mut p: i64 = ps;
        while p < pe {
            if p == ps {
                0
            } else {
                append_str(out, ", ")
            };
            let ph: i64 = (*c).ufpp[p];
            ll_type_to(out, c, ph);
            p = p + 1;
        }
        append_str(out, ")\n");
        any = true;
        i = i + 1;
    }
    if any {
        push(out, '\n')
    } else {
        0
    };
    0
}

// an operand: a register `%vN` (kind 0), an integer literal (kind 1), (8d-Vec) the
// empty-`Vec` constant (kind 2 — `vec_new()`'s value, the same for every elem),
// (Bar B) a `null` constant (kind 3 — `{ i1 0, <zero> }`, `val` = the inner type),
// `%arg0` the self pointer (kind 4), or (ADR 0070) a `Fn` value — a bare
// function-pointer constant `@<name>` (kind 5, `val` = FnId).
fn cgo_operand(c: &mut TyCtx, kind: i64, val: i64) -> i64 {
    if kind == 0 {
        cgo_str(c, "%v");
        cgo_int(c, val)
    } else if kind == 4 {
        // (Bar B / classes) the `self` pointer — the first param of a method (`%arg0`).
        cgo_str(c, "%arg0")
    } else if kind == 1 {
        cgo_int(c, val)
    } else if kind == 2 {
        cgo_str(c, "{ i64 0, i64 0, ptr null }")
    } else if kind == 5 {
        // (ADR 0070) a Fn value: `val` = FnId; the name is cached in `ufnb` at
        // Pass 1 (`cg_fn_name_to`), so no `src` is needed here.
        cgo_str(c, "@");
        let mut fnb: Vec<u8> = vec_new();
        cg_fn_name_to(&mut fnb, c, val);
        cgo_str(c, vec_to_array(fnb))
    } else {
        // kind 3: `null` = `{ i1 0, <zero payload> }`. `?Struct` and (register D39)
        // `?GenericInstance` zero a pointer; `?primitive` zeroes its inline scalar.
        cgo_str(c, "{ i1 0, ");
        if cg_nullable_payload_indirect(c, val) {
            cgo_str(c, "ptr null")
        } else {
            cgo_ty(c, val);
            cgo_str(c, " 0")
        };
        cgo_str(c, " }")
    }
}

// `  %vD = ` (the dest prefix); returns D + advances the counter.
fn cg_dst(c: &mut TyCtx) -> i64 {
    let d: i64 = cg_fresh(c);
    cgo_str(c, "  %v");
    cgo_int(c, d);
    cgo_str(c, " = ");
    d
}

// set the threaded operand to register D.
fn cg_reg(c: &mut TyCtx, d: i64) -> i64 {
    (*c).cglk = 0;
    (*c).cglv = d;
    0
}

// --- per-instruction emitters (each sets `cglast` to its dest, where it has one) --

// `  %vD = <op> <ty> <l>, <r>` (binop).
// (ADR 0048) The bit width of an integer type handle as codegen lowers it (a
// `secret T` erases to `T`): i64=64, i32=32, u8=8, bool=1; -1 for a non-integer.
// Used to coerce a shift AMOUNT to the shifted value's width, which LLVM
// requires — mirrors the oracle's `Emit::int_bits`.
fn cg_int_bits(c: &mut TyCtx, h: i64) -> i64 {
    let hs: i64 = strip_secret(c, h);
    if hs == 0 {
        64
    } else if hs == 1 {
        32
    } else if hs == 2 {
        1
    } else if hs == 3 {
        8
    } else {
        0 - 1
    }
}

// (ADR 0048) `  %vD = <trunc|zext> <fromty> <op> to <toty>` — the shift-amount
// width coercion. LLVM requires a shift's amount to share the value's integer
// type; trunc when the amount is wider, zext when narrower (a shift count is
// non-negative). Returns the coerced operand's register.
fn cg_shift_amt_cast(c: &mut TyCtx, wider: bool, from_ty: i64, to_ty: i64, rk: i64, rv: i64) -> i64 {
    let d: i64 = cg_dst(c);
    if wider {
        cgo_str(c, "trunc ")
    } else {
        cgo_str(c, "zext ")
    };
    cgo_ty(c, from_ty);
    cg_putc(c, ' ');
    cgo_operand(c, rk, rv);
    cgo_str(c, " to ");
    cgo_ty(c, to_ty);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

fn cg_bin(c: &mut TyCtx, op: [u8], ty: i64, lk: i64, lv: i64, rk: i64, rv: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, op);
    cg_putc(c, ' ');
    cgo_ty(c, ty);
    cg_putc(c, ' ');
    cgo_operand(c, lk, lv);
    cgo_str(c, ", ");
    cgo_operand(c, rk, rv);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = icmp <pred> <ty> <l>, <r>`.
fn cg_cmp(c: &mut TyCtx, pred: [u8], ty: i64, lk: i64, lv: i64, rk: i64, rv: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "icmp ");
    cgo_str(c, pred);
    cg_putc(c, ' ');
    cgo_ty(c, ty);
    cg_putc(c, ' ');
    cgo_operand(c, lk, lv);
    cgo_str(c, ", ");
    cgo_operand(c, rk, rv);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// (Bar B) `x == null` / `x != null` (ADR 0014 D7): extract the i1 valid bit (field 0)
// of each `?T` operand, then `icmp <pred> i1` those — the discriminators, not the
// payloads. `lty`/`rty` are the operands' nullable types (`{ i1, T }`).
fn cg_cmp_null(c: &mut TyCtx, pred: [u8], lty: i64, rty: i64, lk: i64, lv: i64, rk: i64, rv: i64) -> i64 {
    let a: i64 = cg_extract(c, lty, lk, lv, 0);
    let b: i64 = cg_extract(c, rty, rk, rv, 0);
    let d: i64 = cg_dst(c);
    cgo_str(c, "icmp ");
    cgo_str(c, pred);
    cgo_str(c, " i1 %v");
    cgo_int(c, a);
    cgo_str(c, ", %v");
    cgo_int(c, b);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = sub <ty> 0, <op>` (integer negate).
fn cg_neg(c: &mut TyCtx, ty: i64, k: i64, v: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "sub ");
    cgo_ty(c, ty);
    cgo_str(c, " 0, ");
    cgo_operand(c, k, v);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = xor i1 <op>, 1` (logical not).
fn cg_not(c: &mut TyCtx, k: i64, v: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "xor i1 ");
    cgo_operand(c, k, v);
    cgo_str(c, ", 1");
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = <op> <fromty> <operand> to <toty>` (zext / trunc).
fn cg_conv(c: &mut TyCtx, op: [u8], fromty: i64, k: i64, v: i64, toty: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, op);
    cg_putc(c, ' ');
    cgo_ty(c, fromty);
    cg_putc(c, ' ');
    cgo_operand(c, k, v);
    cgo_str(c, " to ");
    cgo_ty(c, toty);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// (ADR 0071 M1.4c / register D17) ENCODE a container element into the runtime's i64
// slot. Every `sentinel_shared_*` / `sentinel_mutex_*` C-ABI entry carries the element
// as an i64, so a narrower or differently-shaped element has to be converted on the way
// in — and the twin `cg_container_decode` converts it back on the way out.
//
// Returns the register holding the encoded value, or -1 when the element already IS an
// i64 and no instruction is needed. The -1 is what keeps the `i64` case byte-identical:
// the caller emits the original operand rather than a fresh register, so no numbering
// moves for any program that existed before this.
//
// ⚠ STRIP THE SECRET FIRST, and this is the detail a naive mirror of the CHANNEL arms
// gets wrong. `cgat` holds a TYPE HANDLE, not a scalar code, so a `secret u8` element is
// a handle `>= tbase()` — it matches none of the scalar arms and would fall to whatever
// the final `else` does. ⚠ The channel arms USED to be the counter-example here — this
// sentence said they "can afford" the fall-through because their element map rejects
// secrets outright. Register D29 closed that: they now strip too, and the claim below
// is retained only as the historical reason the containers were written this way.
// (Their element map rejects
// secrets outright) but the containers cannot: `Shared<secret u8>` is constructible, and
// the oracle encodes it as its STRIPPED inner (`zext i8 … to i64`), because a secret
// lowers identically to its inner — the taint lives in the type system, not the IR.
// Getting this wrong on a `secret` element is a constant-time-relevant miscompile, not
// a byte difference.
//
// ⚠ THE `f64` (scalar code 4) AND `ptr` (code 5) ELEMENTS DELIBERATELY GET NO ARM, and
// this is the opposite of what a faithful mirror of the oracle looks like — the oracle
// spells them out as `bitcast` and `ptrtoint`/`inttoptr`. Two measured reasons:
//
//   1. `cgo_ty` HAS NO ARM FOR CODE 4 OR CODE 5. Both fall through its trailing `i64`
//      fallback, so `cg_conv(c, "ptrtoint", 5, …)` renders `ptrtoint i64 %v to i64` —
//      which `llvm-as` REJECTS ("invalid cast opcode for cast from 'i64' to 'i64'"),
//      and `bitcast i64 %v to i64`, which it accepts as an inert no-op that only shifts
//      register numbers. A first cut of this helper DID spell them out; a probe on
//      `fn take(s: Shared<ptr>) -> ptr { shared_get(s) }` showed scg emitting clean
//      `ret i64 %v2` BEFORE and non-assembling IR AFTER. Writing the arms made scg
//      strictly worse.
//   2. `ptr` is not differentially reachable: every route Errs before lowering
//      ("llvm: type not yet ported (8a scalars only): Ptr", and a construct needs
//      `ptr_of`, which Errs too). ⚠ `f64` IS REACHABLE AND DOES DIVERGE — the review
//      refuted the first version of this comment, which claimed both were Err'd.
//      The guard is not "the oracle Errs on every `as f64`"; it is that the oracle
//      Errs wherever an f64 TYPE must be RENDERED (`lty`). A container element is
//      never rendered — it rides an i64 slot — so `shared_new(x as f64)` slips past
//      and LOWERS: the oracle emits `bitcast double %v1 to i64` and scg emits
//      nothing. Measured, and PRE-EXISTING (byte-identical old vs new). Writing the
//      arm would not fix it either: the oracle's own f64 output is INVALID IR
//      (`bitcast double 3 to i64` — llvm-as: "integer constant must have integer
//      type"), which is also why the `llvm_rejects` gate stays silent here. It is on
//      the register, and it needs f64 lowering in both back ends, not an arm here.
//
// So they join the final `else`: emit nothing, pass the raw i64 through. Reason 1 is
// the load-bearing half — spelling the arms out makes scg strictly worse without
// buying parity. Do NOT read this as "f64/ptr containers assemble": they do not in
// general (`shared_new(ptr_of(&buf))` emits `call ptr @sentinel_shared_new(i64 %v10)`
// with `%v10 : ptr`, rejected, before and after). When `cgo_ty` (and its `ll_type_to`
// twin) grow real `double`/`ptr` arms, these two elements come back here, and not
// before.
fn cg_container_encode(c: &mut TyCtx, ety: i64, k: i64, v: i64) -> i64 {
    let e: i64 = strip_secret(c, ety);
    if e == 0 {
        0 - 1
    } else if e == 1 || e == 2 || e == 3 {
        cg_conv(c, "zext", e, k, v, 0)
    } else {
        // f64, ptr, and every non-word-scalar. ⚠ DO NOT write "the oracle Errs on all
        // of them, so the differential never compares such a program" here — that is the
        // refuted claim the header block above spends a paragraph on, and it was in THIS
        // comment until a review constructed `shared_new(x as f64)`, which the oracle
        // lowers. It Errs on the NON-word-scalars ("element not ported (word-scalar)")
        // and on `ptr` ("type not yet ported"), but NOT on every f64 route. Emitting the
        // operand unconverted keeps this arm from inventing an encoding for a shape
        // nothing has defined; for f64 it is also a live divergence, registered as D30.
        0 - 1
    }
}

// (ADR 0071 M1.4c / register D17) The twin of `cg_container_encode`: DECODE the i64 the
// runtime handed back into the element type. `raw` is the register holding the i64.
// Returns the register holding the decoded value — `raw` itself for an i64 element, so
// the i64 case emits nothing and stays byte-identical. Same `strip_secret`-first rule
// and same deliberate absence of an `f64`/`ptr` arm as the encode above; read its
// comment before adding one here.
fn cg_container_decode(c: &mut TyCtx, ety: i64, raw: i64) -> i64 {
    let e: i64 = strip_secret(c, ety);
    if e == 0 {
        raw
    } else if e == 1 || e == 2 || e == 3 {
        cg_conv(c, "trunc", 0, 0, raw, e)
    } else {
        raw
    }
}

// `  %vD = load <ty>, ptr %v<slot>`.
fn cg_load(c: &mut TyCtx, ty: i64, slot: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "load ");
    cgo_ty(c, ty);
    cgo_str(c, ", ptr %v");
    cgo_int(c, slot);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// (Bar B / classes) `Var(self)` as a VALUE — load the whole `%Class.N` aggregate from
// the self pointer `%arg0` (which a class MethodCall later GEPs into via the lvalue).
fn cg_load_self(c: &mut TyCtx, ty: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "load ");
    cgo_ty(c, ty);
    cgo_str(c, ", ptr %arg0\n");
    cg_reg(c, d);
    d
}

// `  store <ty> <op>, ptr %v<slot>` (no dest).
fn cg_store(c: &mut TyCtx, ty: i64, k: i64, v: i64, slot: i64) -> i64 {
    cgo_str(c, "  store ");
    cgo_ty(c, ty);
    cg_putc(c, ' ');
    cgo_operand(c, k, v);
    cgo_str(c, ", ptr %v");
    cgo_int(c, slot);
    cg_putc(c, '\n');
    0
}

// `  %vS = alloca <ty>`; returns the slot S.
// Reserve an alloca slot — RECORD (slot, type) for hoisting to the entry block at
// teardown (no inline text); the slot `%vN` is referenced by stores/loads in cgbody.
fn cg_alloca(c: &mut TyCtx, ty: i64) -> i64 {
    let slot: i64 = cg_fresh(c);
    push(&mut (*c).cgalloca_sl, slot);
    push(&mut (*c).cgalloca_ty, ty);
    slot
}

// (Bar B / effects) hoist an `alloca ptr` (a kont slot) — `-2` marks a raw pointer in
// the alloca-type pool (the hoist loop renders it as `ptr`, not via `cgo_ty`). Must be
// distinct from `-1`: `-1` is the pre-existing, widely-used "no expectation" `exp`
// value (e.g. `Stmt::SExpr`'s discarded expression-statements), which reaches this same
// pool via a plain `cg_alloca(c, exp)` call (e.g. a `match` used as a statement) and
// must fall through to `cgo_ty`'s own `i64` fallback for unmatched handles, not collide
// with this sentinel.
fn cg_alloca_ptr(c: &mut TyCtx) -> i64 {
    let slot: i64 = cg_fresh(c);
    push(&mut (*c).cgalloca_sl, slot);
    push(&mut (*c).cgalloca_ty, 0 - 2);
    slot
}

// (8d-drops) record a scope-drop entry: (VarId, type, alloca slot). Called for each
// param + `let` so the owning block frees it (if un-moved) at exit.
fn cg_drop_record(c: &mut TyCtx, vid: i64, ty: i64, slot: i64) -> i64 {
    push(&mut (*c).cgdv, vid);
    push(&mut (*c).cgdt, ty);
    push(&mut (*c).cgds, slot);
    0
}

// (8d-drops) is `vid` a moved source of fn `fnidx`? Scans the borrow analysis's
// `mvf`/`mvv` side-table (the same set `snc borrow` dumps) — a moved binding is owned
// + dropped by its consumer (incl. a tail-returned value, recorded as a consuming
// move), so it is skipped at scope exit. Mirrors `DropPlan::moved_sources_for`.
fn cg_is_moved(c: &mut TyCtx, fnidx: i64, vid: i64) -> bool {
    let n: i64 = len((*c).mvf);
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        if (*c).mvf[i] == fnidx {
            if (*c).mvv[i] == vid {
                found = true;
                0
            } else {
                0
            }
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// (ADR 0046) is field `fidx` of binding `vid` (in fn `fnidx`) a PARTIAL move — a
// Move-typed field consumed by value, owned + freed by the consumer? Scans the
// `mff`/`mfv`/`mfi` side-table. A partially-moved field is ELIDED from `vid`'s recursive
// struct drop (else a double-free). Mirrors codegen's `moved_fields.contains(&(idx))`.
fn cg_is_field_moved(c: &mut TyCtx, fnidx: i64, vid: i64, fidx: i64) -> bool {
    let n: i64 = len((*c).mff);
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        if (*c).mff[i] == fnidx {
            if (*c).mfv[i] == vid {
                if (*c).mfi[i] == fidx {
                    found = true;
                    0
                } else {
                    0
                }
            } else {
                0
            }
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// (8d-drops-2) does a value of type `ty` own heap that scope-exit must `sentinel_free`?
// An array / `Vec` always does; a struct does iff some field does (recursive — a struct
// of only scalars drops nothing). Bar-B shapes don't emit → false. Mirrors `needs_drop`.
fn cg_needs_drop(c: &mut TyCtx, ty: i64) -> bool {
    if cg_is_array(c, ty) {
        true
    } else if cg_is_vec(c, ty) {
        true
    } else if cg_is_shared(c, ty) {
        // (ADR 0071 M1.4a slice 3) a Shared<T> handle drops via
        // sentinel_shared_release (rc--) — the first Copy-yet-needs-drop type.
        true
    } else if cg_is_mutex(c, ty) {
        // (ADR 0071 M1.4b slice 3a) a Mutex<T> handle drops via
        // sentinel_mutex_release (rc--), mirroring Shared.
        true
    } else if cg_is_guard(c, ty) {
        // (ADR 0071 M1.4b slice 3b) a Guard<T> drops via sentinel_mutex_unlock (the
        // scope-exit unlock). Only ?Guard is spellable; the bare-Guard case is for
        // completeness.
        true
    } else if cg_is_nullable(c, ty) {
        // (ADR 0071 M1.4b slice 3b) a ?Guard unlocks on its valid arm at scope exit.
        // Gate on the inner type == Guard so ?i64 / ?Struct / ... stay drop-free here.
        cg_is_guard(c, nullable_inner_of(c, ty))
    } else {
        let nsid: i64 = struct_of_handle(c, ty);
        if nsid >= 0 {
            let nf: i64 = len((*c).fldo);
            let mut i: i64 = 0;
            let mut any: bool = false;
            while i < nf {
                if (*c).fldo[i] == nsid {
                    let ft: i64 = (*c).fldty[i];
                    if cg_needs_drop(c, ft) {
                        any = true;
                        0
                    } else {
                        0
                    }
                } else {
                    0
                };
                i = i + 1;
            }
            any
        } else {
            // (8e-1) an enum needs a drop iff some variant carries a payload (a
            // pure-unit enum boxes nothing). No recursion (box-free-only).
            let neid: i64 = enum_of_handle(c, ty);
            if neid >= 0 {
                let nv: i64 = len((*c).varo);
                let mut vi: i64 = 0;
                let mut vany: bool = false;
                while vi < nv {
                    if (*c).varo[vi] == neid {
                        if (*c).varpe[vi] > (*c).varps[vi] {
                            vany = true;
                            0
                        } else {
                            0
                        }
                    } else {
                        0
                    };
                    vi = vi + 1;
                }
                vany
            } else {
                // (Bar B) a generic-struct instance needs drop iff some SUBSTITUTED
                // field does (`Holder<[i64]>`'s `value: T` → `[i64]`).
                let ngd: i64 = gi_decl_of(c, ty);
                if ngd >= 0 {
                    let mut gargs: Vec<i64> = vec_new();
                    let gas: i64 = gi_argstart(c, ty);
                    let gae: i64 = gi_argend(c, ty);
                    let mut gj: i64 = gas;
                    while gj < gae {
                        push(&mut gargs, (*c).gia[gj]);
                        gj = gj + 1;
                    }
                    let gnf: i64 = len((*c).fldo);
                    let mut gi2: i64 = 0;
                    let mut gany: bool = false;
                    while gi2 < gnf {
                        if (*c).fldo[gi2] == ngd {
                            let gfh2: i64 = (*c).fldty[gi2];
                            let gch: i64 = subst_type(c, gfh2, &gargs);
                            if cg_needs_drop(c, gch) {
                                gany = true;
                                0
                            } else {
                                0
                            }
                        } else {
                            0
                        };
                        gi2 = gi2 + 1;
                    }
                    gany
                } else {
                    false
                }
            }
        }
    }
}

// (8d-drops) `sentinel_free` a value of type `ty` living AT `slot` (a `%vN` — an alloca
// slot, or a struct-field GEP register when recursing): an array `[T]` (`{ i64, ptr }`)
// frees its data pointer (field 1); a `Vec<T>` (`{ i64, i64, ptr }`) frees field 2
// (`sentinel_free(null)` is a safe no-op); a struct (8d-drops-2) GEPs into each
// drop-needing field (declaration order) and recurses. Primitives / refs → nothing.
// Mirrors the oracle's `emit_drop_for_binding` / `emit_drop_struct_fields`.
//
// (ADR 0046) `vid` = the VarId of the binding being dropped, for the partial-move skip:
// a Move-typed field consumed by value is owned + freed by the consumer, so it is ELIDED
// here (a double-free otherwise). `vid = -1` for every NESTED / recursive field drop
// (deep paths deferred — D5), mirroring the oracle's `&BTreeSet::new()` for nested fields.
fn cg_emit_drop(c: &mut TyCtx, ty: i64, slot: i64, vid: i64) -> i64 {
    if cg_is_array(c, ty) {
        let adv: i64 = cg_dst(c);
        cgo_str(c, "load { i64, ptr }, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        let add: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, ptr } %v");
        cgo_int(c, adv);
        cgo_str(c, ", 1\n");
        cgo_str(c, "  call void @sentinel_free(ptr %v");
        cgo_int(c, add);
        cgo_str(c, ")\n");
        (*c).cg_used_free = true;
        0
    } else if cg_is_vec(c, ty) {
        let vdv: i64 = cg_dst(c);
        cgo_str(c, "load { i64, i64, ptr }, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        let vdd: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, i64, ptr } %v");
        cgo_int(c, vdv);
        cgo_str(c, ", 2\n");
        cgo_str(c, "  call void @sentinel_free(ptr %v");
        cgo_int(c, vdd);
        cgo_str(c, ")\n");
        (*c).cg_used_free = true;
        0
    } else if cg_is_shared(c, ty) {
        // (ADR 0071 M1.4a slice 3) the refcount `--` at scope exit — load the handle
        // ptr and sentinel_shared_release it (frees the cell at zero, the last owner).
        let sdv: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        cgo_str(c, "  call void @sentinel_shared_release(ptr %v");
        cgo_int(c, sdv);
        cgo_str(c, ")\n");
        (*c).cg_used_sharedrelease = true;
        0
    } else if cg_is_mutex(c, ty) {
        // (ADR 0071 M1.4b slice 3a) the Mutex refcount `--` at scope exit — mirrors
        // the Shared arm with sentinel_mutex_release.
        let mdv: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        cgo_str(c, "  call void @sentinel_mutex_release(ptr %v");
        cgo_int(c, mdv);
        cgo_str(c, ")\n");
        (*c).cg_used_mutexrelease = true;
        0
    } else if cg_is_guard(c, ty) {
        // (ADR 0071 M1.4b slice 3b) a bare Guard unlocks unconditionally — mirrors the
        // Mutex-release arm with sentinel_mutex_unlock. Unreachable in practice (Guard
        // is unspellable; lock() yields ?Guard) but kept for parity.
        let gdv: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        cgo_str(c, "  call void @sentinel_mutex_unlock(ptr %v");
        cgo_int(c, gdv);
        cgo_str(c, ")\n");
        (*c).cg_used_mutexunlock = true;
        0
    } else if cg_is_nullable(c, ty) && cg_is_guard(c, nullable_inner_of(c, ty)) {
        // (ADR 0071 M1.4b slice 3b) a ?Guard unlocks on its VALID arm at scope exit:
        // load { i1, ptr }, extract the valid bit + the handle, branch on valid, and on
        // the present arm sentinel_mutex_unlock the handle (the mutex cell `m`). Mirrors
        // the enum box-free arm's null-guarded shape. Gated on inner == Guard so a plain
        // ?i64 / ?u8 / ?Struct falls through to the struct/enum no-op fallback below
        // (cg_emit_drop is called on every recorded binding, not only needs_drop ones).
        let ogv: i64 = cg_dst(c);
        cgo_str(c, "load { i1, ptr }, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        let ogb: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i1, ptr } %v");
        cgo_int(c, ogv);
        cgo_str(c, ", 0\n");
        let ogh: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i1, ptr } %v");
        cgo_int(c, ogv);
        cgo_str(c, ", 1\n");
        let ogu: i64 = cg_fresh_block(c);
        let oga: i64 = cg_fresh_block(c);
        cgo_str(c, "  br i1 %v");
        cgo_int(c, ogb);
        cgo_str(c, ", label %bb");
        cgo_int(c, ogu);
        cgo_str(c, ", label %bb");
        cgo_int(c, oga);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, ogu);
        cgo_str(c, ":\n");
        cgo_str(c, "  call void @sentinel_mutex_unlock(ptr %v");
        cgo_int(c, ogh);
        cgo_str(c, ")\n");
        (*c).cg_used_mutexunlock = true;
        cgo_str(c, "  br label %bb");
        cgo_int(c, oga);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, oga);
        cgo_str(c, ":\n");
        0
    } else {
        // (8d-drops-2) a struct: GEP each drop-needing field (declaration order) and
        // recurse. `fidx` counts EVERY field (the GEP index is the field's position),
        // emitting only for the heap-backed ones.
        let ssid: i64 = struct_of_handle(c, ty);
        if ssid >= 0 {
            let snf: i64 = len((*c).fldo);
            let mut si: i64 = 0;
            let mut fidx: i64 = 0;
            while si < snf {
                if (*c).fldo[si] == ssid {
                    let sft: i64 = (*c).fldty[si];
                    // (ADR 0046) skip a field consumed by value (partial move) — the
                    // consumer owns + freed it; dropping it here double-frees. Only at the
                    // top level of a partially-moved binding (`vid >= 0`).
                    let sskip: bool = if vid >= 0 {
                        cg_is_field_moved(c, (*c).curfn, vid, fidx)
                    } else {
                        false
                    };
                    if cg_needs_drop(c, sft) {
                        if sskip {
                            0
                        } else {
                            let sfp: i64 = cg_dst(c);
                            cgo_str(c, "getelementptr %Struct.");
                            cgo_int(c, ssid);
                            cgo_str(c, ", ptr %v");
                            cgo_int(c, slot);
                            cgo_str(c, ", i32 0, i32 ");
                            cgo_int(c, fidx);
                            cg_putc(c, '\n');
                            cg_emit_drop(c, sft, sfp, 0 - 1);
                            0
                        }
                    } else {
                        0
                    };
                    fidx = fidx + 1;
                    0
                } else {
                    0
                };
                si = si + 1;
            }
            0
        } else {
            // (8e-1) an enum: load `{ i32, ptr }`, null-check the payload, free it (the
            // box). Box-free-only — recursive payload-field drop is deferred (the D.1b
            // limit, matching production).
            let edid: i64 = enum_of_handle(c, ty);
            if edid >= 0 {
                let edv: i64 = cg_dst(c);
                cgo_str(c, "load { i32, ptr }, ptr %v");
                cgo_int(c, slot);
                cg_putc(c, '\n');
                let edpl: i64 = cg_dst(c);
                cgo_str(c, "extractvalue { i32, ptr } %v");
                cgo_int(c, edv);
                cgo_str(c, ", 1\n");
                let ednn: i64 = cg_dst(c);
                cgo_str(c, "icmp eq ptr %v");
                cgo_int(c, edpl);
                cgo_str(c, ", null\n");
                let edfb: i64 = cg_fresh_block(c);
                let edab: i64 = cg_fresh_block(c);
                cgo_str(c, "  br i1 %v");
                cgo_int(c, ednn);
                cgo_str(c, ", label %bb");
                cgo_int(c, edab);
                cgo_str(c, ", label %bb");
                cgo_int(c, edfb);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, edfb);
                cgo_str(c, ":\n");
                cgo_str(c, "  call void @sentinel_free(ptr %v");
                cgo_int(c, edpl);
                cgo_str(c, ")\n");
                (*c).cg_used_free = true;
                cgo_str(c, "  br label %bb");
                cgo_int(c, edab);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, edab);
                cgo_str(c, ":\n");
                0
            } else {
                // (Bar B) a generic-struct instance: GEP each drop-needing SUBSTITUTED
                // field of the `%<mangled>` aggregate + recurse (`Holder<[i64]>` → free
                // the `[i64]` field). Mirrors the plain-struct arm with the instance
                // type-args applied + the structural `%<mangled>` GEP base.
                let gdid: i64 = gi_decl_of(c, ty);
                if gdid >= 0 {
                    let mut dgargs: Vec<i64> = vec_new();
                    let dgas: i64 = gi_argstart(c, ty);
                    let dgae: i64 = gi_argend(c, ty);
                    let mut dgj: i64 = dgas;
                    while dgj < dgae {
                        push(&mut dgargs, (*c).gia[dgj]);
                        dgj = dgj + 1;
                    }
                    let dgnf: i64 = len((*c).fldo);
                    let mut dgi: i64 = 0;
                    let mut dgfidx: i64 = 0;
                    while dgi < dgnf {
                        if (*c).fldo[dgi] == gdid {
                            let dgfh: i64 = (*c).fldty[dgi];
                            let dgch: i64 = subst_type(c, dgfh, &dgargs);
                            // (ADR 0046) same partial-move skip as the plain-struct arm —
                            // the oracle drops `Struct | GenericInstance` through the same
                            // `emit_drop_struct_fields(…, moved_fields)`.
                            let dgskip: bool = if vid >= 0 {
                                cg_is_field_moved(c, (*c).curfn, vid, dgfidx)
                            } else {
                                false
                            };
                            if cg_needs_drop(c, dgch) {
                                if dgskip {
                                    0
                                } else {
                                    let dgfp: i64 = cg_dst(c);
                                    cgo_str(c, "getelementptr %");
                                    let mut dgmb: Vec<u8> = vec_new();
                                    cg_mangle_to(&mut dgmb, c, ty);
                                    cgo_str(c, vec_to_array(dgmb));
                                    cgo_str(c, ", ptr %v");
                                    cgo_int(c, slot);
                                    cgo_str(c, ", i32 0, i32 ");
                                    cgo_int(c, dgfidx);
                                    cg_putc(c, '\n');
                                    cg_emit_drop(c, dgch, dgfp, 0 - 1);
                                    0
                                }
                            } else {
                                0
                            };
                            dgfidx = dgfidx + 1;
                            0
                        } else {
                            0
                        };
                        dgi = dgi + 1;
                    }
                    0
                } else {
                    0
                }
            }
        }
    }
}

// (8d-drops) free the top scope frame [mark..]: the un-moved heap-backed bindings in
// REVERSE declaration order, then truncate the pools back to `mark`. Called at each
// block's exit (body-block + nested blocks via the Block arm; the param frame in
// `type_fn`). Frames nest LIFO via the recursive walk, so `mark` is a local — no stack.
fn cg_drop_frame(c: &mut TyCtx, mark: i64) -> i64 {
    let mut i: i64 = len((*c).cgdv) - 1;
    while i >= mark {
        let vid: i64 = (*c).cgdv[i];
        let ty: i64 = (*c).cgdt[i];
        let slot: i64 = (*c).cgds[i];
        if cg_is_moved(c, (*c).curfn, vid) {
            0
        } else {
            cg_emit_drop(c, ty, slot, vid)
        };
        i = i - 1;
    }
    while len((*c).cgdv) > mark {
        let _a: i64 = pop(&mut (*c).cgdv);
        let _b: i64 = pop(&mut (*c).cgdt);
        let _s: i64 = pop(&mut (*c).cgds);
        0
    }
    0
}

// (8d-drops-3) drain (free) the un-moved heap-backed bindings of cgdv[floor..] in
// REVERSE order — the per-iteration drops on a `break`/`continue` early-exit path. Does
// NOT truncate: the (now-dead) remainder of each block still truncates via its Block-arm
// `cg_drop_frame`, so each runtime path frees once. Reversing the flat cgdv[floor..]
// == the oracle's top-down per-frame reverse (concatenated frames reverse identically).
fn cg_drop_range(c: &mut TyCtx, floor: i64) -> i64 {
    let mut i: i64 = len((*c).cgdv) - 1;
    while i >= floor {
        let vid: i64 = (*c).cgdv[i];
        let ty: i64 = (*c).cgdt[i];
        let slot: i64 = (*c).cgds[i];
        if cg_is_moved(c, (*c).curfn, vid) {
            0
        } else {
            cg_emit_drop(c, ty, slot, vid)
        };
        i = i - 1;
    }
    0
}

// collect one call arg (its operand + type) onto the arg stacks (gated).
// (ADR 0071 M1.4a slice 3) rc++ a Shared arg passed by value into a USER-fn
// owning param when its source is a named Var ((*c).mvbv >= 0, set by the just-
// dumped `Expr::Var`). Emits `sentinel_shared_clone` and RE-THREADS the operand
// (`cg_reg`) to the clone register BEFORE `cg_collect` pushes it — the selfhost
// env is append-only, so we can't overwrite a collected slot. Called after
// `mir_collect` (so the MIR operand stays the original) and before `cg_collect`.
// Mirrors the oracle's `clone_if_shared_var` in the user-fn call-arg loop (the
// same `%vC = call ptr @sentinel_shared_clone(ptr <op>)`, byte-identical).
fn cg_clone_shared_arg(c: &mut TyCtx, at: i64) -> i64 {
    if cg_on(c) && (*c).cg_ufarg && (*c).mvbv >= 0 && cg_is_shared(c, at) {
        let ok: i64 = (*c).cglk;
        let ov: i64 = (*c).cglv;
        let clv: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_shared_clone(ptr ");
        cgo_operand(c, ok, ov);
        cgo_str(c, ")\n");
        (*c).cg_used_sharedclone = true;
        cg_reg(c, clv);
        0
    } else if cg_on(c) && (*c).cg_ufarg && (*c).mvbv >= 0 && cg_is_mutex(c, at) {
        // (ADR 0071 M1.4b slice 3a) the Mutex analog — rc++ a named Mutex arg into a
        // user-fn owning param via sentinel_mutex_clone (mirrors the Shared branch).
        let mok: i64 = (*c).cglk;
        let mov: i64 = (*c).cglv;
        let mclv: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_mutex_clone(ptr ");
        cgo_operand(c, mok, mov);
        cgo_str(c, ")\n");
        (*c).cg_used_mutexclone = true;
        cg_reg(c, mclv);
        0
    } else {
        0
    }
}

fn cg_collect(c: &mut TyCtx, at: i64) -> i64 {
    if cg_on(c) {
        if (*c).cg_collecting {
            push(&mut (*c).cgak, (*c).cglk);
            push(&mut (*c).cgav, (*c).cglv);
            push(&mut (*c).cgat, at);
            0
        } else {
            0
        };
        0
    } else {
        0
    }
}

// (8e-1) emit a variant's payload struct type literal `{ t0, t1, … }` (the flat
// variant index `j` = `variant_flat(eid, vidx)`; payloads are `varpay[varps[j]..]`).
// Only called for a non-empty payload (a unit variant uses a null payload, no struct).
fn cg_emit_pstruct(c: &mut TyCtx, j: i64) -> i64 {
    let ps: i64 = (*c).varps[j];
    let pe: i64 = (*c).varpe[j];
    cgo_str(c, "{ ");
    let mut k: i64 = ps;
    let mut first: bool = true;
    while k < pe {
        if first {
            first = false;
            0
        } else {
            cgo_str(c, ", ");
            0
        };
        cgo_ty(c, (*c).varpay[k]);
        k = k + 1;
    }
    cgo_str(c, " }")
}

// (8e-1) emit an enum construction `{ i32 tag, ptr payload }` from the args collected
// at `cgak[snap..]`. A unit variant (no args) gets a null payload; else build the
// payload struct (insertvalue chain), heap-box it (GEP-sizeof + alloc + store), and
// point the enum at it. Sets the result operand; pops the consumed args. Mirrors the
// oracle's `lower_enum_construct`.
fn cg_emit_enum_construct(c: &mut TyCtx, eid: i64, vidx: i64, snap: i64) -> i64 {
    let nargs: i64 = len((*c).cgak) - snap;
    let mut boxreg: i64 = 0 - 1;
    if nargs > 0 {
        let j: i64 = variant_flat(c, eid, vidx);
        let mut aggreg: i64 = 0 - 1;
        let mut i: i64 = 0;
        while i < nargs {
            let fk: i64 = (*c).cgak[snap + i];
            let fv: i64 = (*c).cgav[snap + i];
            let ft: i64 = (*c).cgat[snap + i];
            let d: i64 = cg_dst(c);
            cgo_str(c, "insertvalue ");
            cg_emit_pstruct(c, j);
            cg_putc(c, ' ');
            if aggreg < 0 {
                cgo_str(c, "undef")
            } else {
                cgo_str(c, "%v");
                cgo_int(c, aggreg)
            };
            cgo_str(c, ", ");
            cgo_ty(c, ft);
            cg_putc(c, ' ');
            cgo_operand(c, fk, fv);
            cgo_str(c, ", ");
            cgo_int(c, i);
            cg_putc(c, '\n');
            aggreg = d;
            i = i + 1;
        }
        let szr: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cg_emit_pstruct(c, j);
        cgo_str(c, ", ptr null, i64 1\n");
        let szir: i64 = cg_dst(c);
        cgo_str(c, "ptrtoint ptr %v");
        cgo_int(c, szr);
        cgo_str(c, " to i64\n");
        let br: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
        cgo_int(c, szir);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        cgo_str(c, "  store ");
        cg_emit_pstruct(c, j);
        cgo_str(c, " %v");
        cgo_int(c, aggreg);
        cgo_str(c, ", ptr %v");
        cgo_int(c, br);
        cg_putc(c, '\n');
        boxreg = br;
        0
    } else {
        0
    };
    let e0: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i32, ptr } undef, i32 ");
    cgo_int(c, vidx);
    cgo_str(c, ", 0\n");
    let e1: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i32, ptr } %v");
    cgo_int(c, e0);
    cgo_str(c, ", ptr ");
    if boxreg < 0 {
        cgo_str(c, "null")
    } else {
        cgo_str(c, "%v");
        cgo_int(c, boxreg)
    };
    cgo_str(c, ", 1\n");
    cg_reg(c, e1);
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    0
}

