module types;

// --- the typed dump (1-phase consuming map: Expr -> typed S-expr) ------------
//
// Each `dump_t*` for an expression RETURNS the node's inferred type handle and
// appends ` :<type>` before its closing paren (`close_ty`), so a parent can use a
// child's type. (Resolve's `dump_r*` returned nothing — types threads the type
// up.)

// Close a typed expression node: ` :<type>)`.
fn close_ty(out: &mut Vec<u8>, ty: i64, c: &mut TyCtx) -> i64 {
    append_str(out, " :");
    render_type(out, ty, c);
    push(out, ')');
    0
}

// (6/N) dump an arg list in a CONSUMING context (constructor / method / perform /
// enum-construct args — moved into the callee). Sets `consuming` true around the args.
fn dump_cargs(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let svc: bool = (*c).consuming;
    (*c).consuming = true;
    // (ADR 0071 M1.4a slice 3) construct/aggregate args are NOT user-fn owning
    // params — don't rc++ a Shared element here (matches the oracle, which clones
    // only at let-init / user-fn call-arg / spawn).
    let svu: bool = (*c).cg_ufarg;
    (*c).cg_ufarg = false;
    dump_targs(out, a, 0 - 1, 0, src, c, gb);
    (*c).cg_ufarg = svu;
    (*c).consuming = svc;
    0
}

// `pfid` = the callee's user FnId when its declared param types should be pushed down
// onto the arguments as expectations (ADR 0014 D3's `?T` pushdown and ADR 0051 A5's
// `secret` one), or -1 for every other caller — an array literal, a construct, a builtin,
// a spawn target. `pidx` is the current argument's position.
//
// The expectation is what makes `takes(5)` against `takes(p: ?i64)` emit
// `(widen-null (int 5 :i64) :?i64)` instead of the bare literal. Passing -1 here is what
// it did before, for every callee.
fn dump_targs(out: &mut Vec<u8>, a: Args, pfid: i64, pidx: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(x, rest) => {
            push(out, ' ');
            // (6/N) args INHERIT the caller's consuming context (the call arm sets it —
            // user-fn/construct args consume, builtin args do not).
            let aexp: i64 = fn_param_ty(c, pfid, pidx);
            let cg_argty: i64 = dump_texpr(out, x, aexp, src, c, gb);
            mir_collect(c);
            // (ADR 0071 M1.4a slice 3) rc++ a named-`Shared` arg into a user-fn
            // owning param (gated by `cg_ufarg`), re-threading to the clone before
            // it is collected. A no-op for every non-Shared / non-user-fn arg.
            cg_clone_shared_arg(c, cg_argty);
            cg_collect(c, cg_argty);
            dump_targs(out, rest, pfid, pidx + 1, src, c, gb)
        },
    }
}

// (4c-2) array-literal elements: dump every element; RETURN the first element's
// type (the inferred array element type). Empty → i64 default (a context-typed
// follow-up). The first is dumped here; the rest reuse `dump_targs`.
// Returns the element type inferred from the FIRST element, or the sentinel -1
// for an EMPTY literal (`[]`) — the caller then takes the element type from the
// expected/annotation type (`array_elem_of(exp)`) instead of defaulting to i64.
fn dump_array_elems(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    // NB (ADR 0071 M1.4a slice 3): array elements can't be `Shared` (`[Shared]` is a
    // type error), so `cg_ufarg` need not be reset here — no clone can fire.
    match a {
        Args::End => 0 - 1,
        Args::Cell(x, rest) => {
            push(out, ' ');
            // (6/N) the array arm sets consuming=true before this; elements inherit it.
            let t0: i64 = dump_texpr(out, x, 0 - 1, src, c, gb);
            mir_collect(c);
            // (8c-2) codegen: collect the FIRST element's operand (the rest collect
            // via `dump_targs`); the array arm emits the alloc+stores over them.
            cg_collect(c, t0);
            dump_targs(out, rest, 0 - 1, 0, src, c, gb);
            t0
        },
    }
}

// --- (4h) generic-fn inference (unify_one + substitution) -------------------

// Substitute the type-params in `h` using the resolved type-arg list `args`
// (indexed by type-param index). Recurses through compound shells; leaves
// concrete types (scalars, structs, enums, classes) unchanged. (Generic-instance
// substitution — kind 10 — lands with (4h-2)'s `mk_generic`.)
fn subst_type(c: &mut TyCtx, h: i64, args: &Vec<i64>) -> i64 {
    if h < tbase() {
        h
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 9 {
            let pi: i64 = (*c).ta[idx];
            (*args)[pi]
        } else if k == 1 {
            let inn: i64 = (*c).ta[idx];
            let si: i64 = subst_type(c, inn, args);
            mk_array(c, si)
        } else if k == 4 {
            let inn4: i64 = (*c).ta[idx];
            let s4: i64 = subst_type(c, inn4, args);
            mk_nullable(c, s4)
        } else if k == 3 {
            let inn3: i64 = (*c).ta[idx];
            let s3: i64 = subst_type(c, inn3, args);
            mk_secret(c, s3)
        } else if k == 2 {
            let m2: i64 = (*c).ta[idx];
            let inn2: i64 = (*c).tb[idx];
            let s2: i64 = subst_type(c, inn2, args);
            mk_ref(c, m2, s2)
        } else if k == 10 {
            // A generic instance whose own args may be type-params (e.g. make_pair's
            // return `Pair<<T#0>, <T#1>>` substituted to `Pair<i64, i64>`): substitute
            // each arg, then re-intern. The arg slice [grs..gre] is stable under the
            // recursive `mk_generic` appends (gia is append-only).
            let gdecl: i64 = (*c).ta[idx];
            let grec: i64 = (*c).tb[idx];
            let grs: i64 = (*c).girs[grec];
            let gre: i64 = (*c).gire[grec];
            let mut gnewargs: Vec<i64> = vec_new();
            let mut ggi: i64 = grs;
            while ggi < gre {
                let goa: i64 = (*c).gia[ggi];
                let gsa: i64 = subst_type(c, goa, args);
                push(&mut gnewargs, gsa);
                ggi = ggi + 1;
            }
            mk_generic(c, gdecl, &gnewargs)
        } else {
            h
        }
    }
}

// Record a type-param binding (param index `pidx` → arg type `at`) into the
// parallel (`bi`, `bt`) accumulator lists; FIRST binding wins (clean fixtures are
// consistent, so a re-encounter of the same param need not re-check).
fn subst_bind(bi: &mut Vec<i64>, bt: &mut Vec<i64>, pidx: i64, at: i64) -> i64 {
    let n: i64 = len(*bi);
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        if (*bi)[i] == pidx {
            found = true;
            0
        } else {
            0
        };
        i = i + 1;
    }
    if found {
        0
    } else {
        push(bi, pidx);
        push(bt, at);
        0
    }
}

// The bound type for param index `pidx` (-1 if unbound — defensive).
fn subst_get(bi: &mut Vec<i64>, bt: &mut Vec<i64>, pidx: i64) -> i64 {
    let n: i64 = len(*bi);
    let mut i: i64 = 0;
    let mut r: i64 = 0 - 1;
    while i < n {
        if r == 0 - 1 {
            if (*bi)[i] == pidx {
                r = (*bt)[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    r
}

// Unify a (possibly type-param-bearing) declared param type `pt` against a
// concrete arg type `at`, recording type-param bindings. Structural: matches the
// array/nullable/secret shells and recurses; a bare type-param binds. (Ref +
// generic-instance unify land with (4h-2).)
fn unify_one(c: &mut TyCtx, pt: i64, at: i64, bi: &mut Vec<i64>, bt: &mut Vec<i64>) -> i64 {
    if pt < tbase() {
        0
    } else {
        let idx: i64 = pt - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 9 {
            let pidx: i64 = (*c).ta[idx];
            subst_bind(bi, bt, pidx, at)
        } else if k == 1 {
            let pin: i64 = (*c).ta[idx];
            let ain: i64 = array_elem_of(c, at);
            unify_one(c, pin, ain, bi, bt)
        } else if k == 4 {
            let pin4: i64 = (*c).ta[idx];
            let ain4: i64 = nullable_inner_of(c, at);
            unify_one(c, pin4, ain4, bi, bt)
        } else if k == 3 {
            let pin3: i64 = (*c).ta[idx];
            let ain3: i64 = strip_secret(c, at);
            unify_one(c, pin3, ain3, bi, bt)
        } else if k == 2 {
            // (register D37) A REFERENCE param (`fn takes<T>(x: &T)`) unifies against a
            // reference ARGUMENT. Without this arm `T` was never bound at all, and the
            // unbound -1 then reached `cg_mangle_to` — which is where scg used to die
            // with `idx=-101` (register D58 turned that into a loud marker name).
            //
            // ⚠ MIRROR THE ORACLE'S PREDICATE, NOT JUST ITS EFFECT, and this is the whole
            // difficulty of the arm. `crates/sentinel-types`'s `(Type::Ref(p),
            // Type::Ref(a))` fires ONLY on (Ref, Ref) — a non-ref argument falls through
            // to its trailing `Err(Mismatch)` — and it returns Mismatch when the two
            // MUTABILITIES differ. Binding unconditionally would look like it works and
            // would make scg bind `T` for four shapes the oracle REJECTS: `&mut T` given
            // `&a`, `&T` given `&mut a`, `&T` given a non-ref, and the `Vec<T>` analogue.
            // The codegen differential only runs oracle-ACCEPTED programs, so it could
            // never see that over-acceptance — which is exactly why the predicate has to
            // be copied rather than the outcome.
            //
            // Binding nothing on a mismatch is the right failure: `T` stays unbound and
            // renders `UNBOUND_TYPEARG`, which is loud and is a program the oracle
            // refuses anyway.
            //
            // ⚠ The neighbouring array / nullable / secret arms do NOT have this
            // property — `array_elem_of` and `nullable_inner_of` answer i64 for a
            // non-matching argument, so they bind where the oracle would not. That is
            // pre-existing and unmeasured; do not "make this arm consistent" with them.
            if cg_is_ref(c, at) {
                let aridx: i64 = at - tbase();
                if (*c).ta[idx] == (*c).ta[aridx] {
                    unify_one(c, (*c).tb[idx], (*c).tb[aridx], bi, bt)
                } else {
                    0
                }
            } else {
                0
            }
        } else if k == 11 {
            // (register D37, same family) A `Vec<T>` param binds T only from a `Vec`
            // ARGUMENT. Constructed: the oracle rejects both cross-shape directions —
            // `Vec<T>` given `[i64]` is "expected Vec<<T#0>>, found [i64]", and `[T]`
            // given `Vec<i64>` is its mirror — so firing only on a same-kind argument is
            // the oracle's own predicate, not caution.
            //
            // ⚠ DO NOT ROUTE THIS THROUGH `array_elem_of`. That helper deliberately
            // answers the element for kind 1 AND kind 11, so `len`/`v[i]` work uniformly
            // over arrays and vecs — which is right for indexing and WRONG for
            // unification, where the two shapes are distinct types the oracle refuses to
            // mix. The neighbouring `k == 1` arm does route through it and therefore
            // over-binds `[T]` from a `Vec<i64>` argument; that is pre-existing, is
            // unobservable (the oracle rejects the program, so the differential never
            // compares it), and is recorded rather than "made consistent" with this arm.
            if cg_is_vec(c, at) {
                unify_one(c, (*c).ta[idx], (*c).ta[at - tbase()], bi, bt)
            } else {
                0
            }
        } else if k == 10 {
            // A generic-instance param (e.g. `p: Pair<A, B>`) unifies pairwise against
            // a same-decl arg instance (`Pair<i64, i64>`), binding each type-param.
            let ptd: i64 = (*c).ta[idx];
            let atd: i64 = gi_decl_of(c, at);
            if atd == ptd {
                let prec: i64 = (*c).tb[idx];
                let prs: i64 = (*c).girs[prec];
                let pre: i64 = (*c).gire[prec];
                let ats: i64 = gi_argstart(c, at);
                let ucount: i64 = pre - prs;
                let mut ugi: i64 = 0;
                while ugi < ucount {
                    let upa: i64 = (*c).gia[prs + ugi];
                    let uaa: i64 = (*c).gia[ats + ugi];
                    unify_one(c, upa, uaa, bi, bt);
                    ugi = ugi + 1;
                }
                0
            } else {
                0
            }
        } else {
            0
        }
    }
}

// Dump every call arg into `out`, pushing each arg's synthesized type onto `atys`
// (so a generic call can unify the fn's params against them).
// (register D45) Substitute `h` under the bindings built SO FAR, answering -1 if any
// type-param slot it mentions is still unbound. This is scg's mirror of the oracle's
// `try_substitute`, and the mirror has to be exact in one place that is easy to get
// wrong — see the kind-10 arm.
fn subst_fully(c: &mut TyCtx, h: i64, bi: &mut Vec<i64>, bt: &mut Vec<i64>) -> i64 {
    if h < tbase() {
        h
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 9 {
            // A type param: its binding, or -1 if not bound yet.
            subst_get(bi, bt, (*c).ta[idx])
        } else if k == 4 {
            let inner: i64 = subst_fully(c, (*c).ta[idx], bi, bt);
            if inner < 0 {
                0 - 1
            } else {
                mk_nullable(c, inner)
            }
        } else if k == 1 {
            let el: i64 = subst_fully(c, (*c).ta[idx], bi, bt);
            if el < 0 {
                0 - 1
            } else {
                mk_array(c, el)
            }
        } else if k == 3 {
            let sinner: i64 = subst_fully(c, (*c).ta[idx], bi, bt);
            if sinner < 0 {
                0 - 1
            } else {
                mk_secret(c, sinner)
            }
        } else if k == 10 {
            // ⚠ RETURN THE HANDLE UNCHANGED. Do NOT rebuild it with `mk_generic` the way
            // `subst_type` does. The oracle's `try_substitute` CHECKS that every argument
            // of a generic instance substitutes and then returns the instance handle it
            // was given — its own comment says "Doesn't re-intern — that's the mutable-
            // substitute path". Rebuilding here types a `null` at `?Bx<i64>` where the
            // oracle types it `?Bx<<T#0>>`, which the LLVM differential CANNOT SEE
            // (both render `ptr null`) while the types and MIR differentials fail. A fix
            // validated on the .ll alone would look correct and break two other stages.
            let gas: i64 = gi_argstart(c, h);
            let gae: i64 = gi_argend(c, h);
            let mut gj: i64 = gas;
            let mut ok: bool = true;
            while gj < gae {
                let ga: i64 = (*c).gia[gj];
                if subst_fully(c, ga, bi, bt) < 0 {
                    ok = false;
                    0
                } else {
                    0
                };
                gj = gj + 1;
            }
            if ok {
                h
            } else {
                0 - 1
            }
        } else {
            // Every other kind is either already concrete or one this walk deliberately
            // does not reshape. Answering `h` is safe because the ONLY consumer is
            // `arg_expected`, which then applies its own fail-closed pushdown list.
            h
        }
    }
}

// (register D45) The expected type to push down into argument `pi` of a generic call,
// or -1 for "no expectation" (the walk's behaviour before this existed).
//
// ⚠ THIS IS AN EXPLICIT FAIL-CLOSED LIST, mirroring the oracle's `check_call`, which
// pushes a param type down ONLY when the substituted form `is_nullable()` or
// `is_secret_widen_target()`. Everything else synthesises without a pushdown so the
// more specific arg-mismatch diagnostic surfaces there. Widening the list here would
// make scg widen arguments the oracle does not, which is a byte divergence on programs
// that are identical today; narrowing it re-opens D45. Do not restate it as "the
// substituted type looks concrete enough".
fn arg_expected(c: &mut TyCtx, pty: i64, bi: &mut Vec<i64>, bt: &mut Vec<i64>) -> i64 {
    if pty < 0 {
        0 - 1
    } else {
        let sub: i64 = subst_fully(c, pty, bi, bt);
        if sub < 0 {
            0 - 1
        } else if cg_is_nullable(c, sub) {
            sub
        } else if is_secret_ty(c, sub) {
            sub
        } else {
            0 - 1
        }
    }
}

// (register D45) Carries the callee's PARAM SPAN and the in-progress type-param
// bindings, so each argument can be dumped with the expectation its parameter implies
// and unified IMMEDIATELY — left to right, exactly as the oracle's `check_call` walks.
// Before this, every argument was dumped with no expectation and unification ran only
// after the whole walk, so a `null` argument (whose type IS its expectation) was typed
// from a default and, when it came first, that default then bound the type parameter.
fn dump_args_capture_all(out: &mut Vec<u8>, a: Args, ps: i64, pi: i64, np: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, atys: &mut Vec<i64>, bi: &mut Vec<i64>, bt: &mut Vec<i64>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(x, rest) => {
            push(out, ' ');
            // (6/N) generic-call args inherit the caller's consuming context (set true
            // by the user-fn call arm).
            // (register D31) snapshot the node counter so the clone gate below can tell
            // a BARE `Var` argument from a compound one whose tail merely happens to be
            // a Var. See the gate.
            // (register D45) The parameter this argument fills, and the expectation it
            // implies under the bindings built by the arguments to its LEFT.
            let pty: i64 = if pi < np {
                (*c).ufpp[ps + pi]
            } else {
                0 - 1
            };
            let aexp: i64 = arg_expected(c, pty, bi, bt);
            let n0: i64 = (*c).ndump;
            let t0: i64 = dump_texpr(out, x, aexp, src, c, gb);
            mir_collect(c);
            // (ADR 0071 M1.4a slice 3 / register D31) rc++ a named container arg into
            // the callee's owning param, as `dump_targs` does. ⚠ THIS WAS MISSING and the
            // comment below claimed it was here: a `Shared<T>` or `Mutex<T>` passed by
            // value to a GENERIC fn got no clone while the callee still emitted its
            // release, so the refcount went one release too far — the cell was freed
            // while the caller still held it and the caller's next use read freed memory.
            // The oracle always emitted the clone; only this path diverged, which is why
            // a NON-generic callee was byte-identical.
            //
            // ⚠ THE `ndump` TEST IS LOAD-BEARING — DO NOT REDUCE THIS TO A BARE
            // `cg_clone_shared_arg` CALL. That helper gates on `mvbv >= 0`, which is NOT
            // "the argument is a named Var": `mvbv` is reset per node and set by the Var
            // arm, so ANY compound argument whose tail is a Var (`{ s }`, `if c { s }
            // else { t }`, `p.h`) leaks it upward and the helper fires. The oracle
            // decides structurally (`clone_if_shared_var` returns early unless the whole
            // argument is a `Var` node), so the leaky gate would emit a clone the oracle
            // does not. A first cut of this fix did exactly that and the review caught it:
            // three shapes that were byte-identical before became DIVERGENT. A delta of
            // exactly 1 node means the argument was a LEAF, and `mvbv >= 0` means that
            // leaf was a Var — together, the oracle's test.
            //
            // `dump_targs` still carries the leaky gate and still over-clones on those
            // three shapes (pre-existing, registered). It is NOT fixed here because the
            // ORACLE is the wrong side there and the fix is oracle-first.
            if (*c).ndump == n0 + 1 {
                cg_clone_shared_arg(c, t0)
            } else {
                0
            };
            // (Bar B / generics-b) codegen: collect the arg operand so cg_emit_call can
            // pass it to the monomorphic callee (mirrors dump_targs / dump_args_capture_first).
            cg_collect(c, t0);
            push(atys, t0);
            // (register D45) Unify HERE, not after the walk, so argument i+1's expectation
            // can see what argument i bound. `subst_bind` is first-binding-wins, matching
            // the oracle's `unify_one` into a shared subst.
            if pty < 0 {
                0
            } else {
                unify_one(c, pty, t0, bi, bt)
            };
            dump_args_capture_all(out, rest, ps, pi + 1, np, src, c, gb, atys, bi, bt)
        },
    }
}

// (4h) a call to a generic USER fn: infer the type-args by unifying the fn's
// declared param types against the args' synthesized types, emit `(targs t0 t1 …)`
// (space-separated) BEFORE the args, and return the SUBSTITUTED declared return
// type. Args are dumped to a temp buffer first — the targs precede them in the
// output but are inferred from them.
// (registers D4 / D43 / D45) Takes `exp` — the caller's expected type — because the
// oracle SEEDS the type-parameter substitution from the expected RETURN type before it
// looks at a single argument (`unify_one(signature.return_type, exp, …)` in
// `check_call`). Without that seed `let s: secret i64 = idg(7)` monomorphises at `i64`
// and wraps the RESULT, where the oracle monomorphises at `secret i64` and widens the
// ARGUMENT; and `fn mk<T>() -> ?T` has no argument to infer from at all, so T stayed
// unbound and the mangled name came out `UNBOUND_TYPEARG`.
fn dump_generic_call(out: &mut Vec<u8>, fid: i64, ca: Args, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut abuf: Vec<u8> = vec_new();
    let mut atys: Vec<i64> = vec_new();
    let ntp: i64 = (*c).uftp[fid - 42];
    let ps: i64 = (*c).ufps[fid - 42];
    let pe: i64 = (*c).ufpe[fid - 42];
    let np: i64 = pe - ps;
    // (register D45) The bindings are built DURING the argument walk now, not after it,
    // so argument i's expectation can use what arguments 0..i-1 bound. The walk owns the
    // unification; there is deliberately no second pass here.
    let mut bi: Vec<i64> = vec_new();
    let mut bt: Vec<i64> = vec_new();
    // (registers D4 / D43 / D45 Step 2) SEED FROM THE EXPECTED RETURN TYPE, before any
    // argument is walked. `subst_bind` is first-binding-wins and the oracle seeds first
    // too, so this ordering is part of the mirror, not an accident.
    //
    // ⚠ GATED ON `ntp > 0` AND AN EXPECTATION — NOTHING ELSE. The oracle's own comment
    // says it seeds only when "the signature's return type is exactly a TypeParam", and
    // its CODE does no such check: it unifies unconditionally under those two guards.
    // Mirror the code. `fn mk<T>() -> ?T` is the discriminator — its return type is a
    // NULLABLE, not a bare type param, and it must still seed T through the `?` shell.
    //
    // Best-effort, exactly as the oracle's `let _ = unify_one(…)` is: a mismatch here is
    // silent, because a real one resurfaces downstream.
    if ntp > 0 {
        if exp < 0 {
            0
        } else {
            unify_one(c, (*c).ufret[fid - 42], exp, &mut bi, &mut bt)
        }
    } else {
        0
    };
    dump_args_capture_all(&mut abuf, ca, ps, 0, np, src, c, gb, &mut atys, &mut bi, &mut bt);
    // Build the resolved subst list in type-param INDEX order (0..ntp).
    let mut subst: Vec<i64> = vec_new();
    let mut ti: i64 = 0;
    while ti < ntp {
        let bd: i64 = subst_get(&mut bi, &mut bt, ti);
        push(&mut subst, bd);
        ti = ti + 1;
    }
    // (Bar B / generics-b) codegen: record this monomorphic instance (for later mono
    // emission) + stash the inferred type-args so the following `cg_emit_call` mangles
    // the callee (`id__i64`).
    //
    // (register D24) Recording happens on the SEED walk and on the DISCOVERY pass, and
    // is skipped only on the EMISSION pass — where every instance is already recorded
    // and re-recording would be a no-op at best. This used to skip on `cg_mono_on`
    // alone, i.e. on every mono re-walk, which is why the worklist had NO transitive
    // closure: a generic reached only through another generic's body was called and
    // never defined (`llvm-as`: "use of undefined value '@wrap__i64'").
    if cg_on(c) {
        let cg_discovering: bool = (*c).cg_mute;
        if (*c).cg_mono_on && cg_discovering == false {
            0
        } else {
            cg_mono_record(c, fid, &subst);
            0
        };
        clear_i64(&mut (*c).cg_targs);
        let mut csi: i64 = 0;
        let csn: i64 = len(subst);
        while csi < csn {
            let cst: i64 = subst[csi];
            push(&mut (*c).cg_targs, cst);
            csi = csi + 1;
        }
        0
    } else {
        0
    };
    append_str(out, " (targs");
    let mut tj: i64 = 0;
    while tj < ntp {
        push(out, ' ');
        let th: i64 = subst[tj];
        render_type(out, th, c);
        tj = tj + 1;
    }
    push(out, ')');
    let argbytes: [u8] = vec_to_array(abuf);
    append_str(out, argbytes);
    let rh: i64 = (*c).ufret[fid - 42];
    subst_type(c, rh, &subst)
}

// The element type of an array type handle (kind 1), or i64 default.
fn array_elem_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        // (4i) the element of a `[T]` (kind 1) OR a `Vec<T>` (kind 11) — so `len`
        // and `v[i]` index work uniformly over arrays and vecs.
        if (*c).tk[idx] == 1 {
            (*c).ta[idx]
        } else if (*c).tk[idx] == 11 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// (4i) the element type of a `Vec<T>` handle (kind 11), or i64 default.
fn vec_elem_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 11 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// (4i) the result type of a `Task<T>` handle (kind 12), or i64 default — the type
// `t.await` yields.
fn task_elem_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 12 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// The inner type of a nullable handle (kind 4), or i64 default.
fn nullable_inner_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 4 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// Generic builtins that emit `(targs T)`: unwrap_or (#1), is_some (#2), len (#3),
// (4i) the D.3 Vec ops vec_new (#7), push (#8), pop (#9), vec_to_array (#10).
fn is_generic_builtin(fid: i64) -> bool {
    fid == 1 || fid == 2 || fid == 3 || fid == 7 || fid == 8 || fid == 9 || fid == 10
}

// (ADR 0071 M1.4c) The `Shared`/`Mutex` builtins whose type is ELEMENT-dependent —
// shared_new(38) / shared_get(39) / mutex_new(40) / lock(41). Not
// `is_generic_builtin`s: those infer a `(targs T)` annotation from the first arg,
// while these carry no targs and instead read the element off a concrete handle
// (see `dump_container_call`).
fn is_container_builtin(fid: i64) -> bool {
    fid == 38 || fid == 39 || fid == 40 || fid == 41
}

// The inferred type-arg T for a generic builtin. `firstty` = the first arg's type
// (-1 if none); `exp` = the call's expected type (for vec_new, which has no args).
fn targ_of_builtin(c: &mut TyCtx, fid: i64, firstty: i64, exp: i64) -> i64 {
    if fid == 3 {
        array_elem_of(c, firstty)            // len: [T]/Vec<T> element
    } else if fid == 1 {
        nullable_inner_of(c, firstty)        // unwrap_or: ?T inner
    } else if fid == 2 {
        nullable_inner_of(c, firstty)        // is_some: ?T inner
    } else if fid == 7 {
        vec_elem_of(c, exp)                  // vec_new: T from the expected Vec<T>
    } else if fid == 8 {
        let sr8: i64 = strip_ref(c, firstty);   // push: &mut Vec<T> → T
        vec_elem_of(c, sr8)
    } else if fid == 9 {
        let sr9: i64 = strip_ref(c, firstty);   // pop: &mut Vec<T> → T
        vec_elem_of(c, sr9)
    } else if fid == 10 {
        vec_elem_of(c, firstty)              // vec_to_array: Vec<T> → T
    } else {
        0
    }
}

// Dump a generic-builtin call's `(targs T)` + args. Args go to a temp buffer
// first (T is inferred from the first arg — or from `exp` for vec_new — but
// `(targs T)` precedes the args in the output). Returns the call's result type.
fn dump_gcall(out: &mut Vec<u8>, fid: i64, ca: Args, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut abuf: Vec<u8> = vec_new();
    // (ADR 0034 D8) `push` (fid 8) consumes its element (the arg after the first).
    let firstty: i64 = dump_args_capture_first(&mut abuf, ca, fid == 8, src, c, gb);
    let targ: i64 = targ_of_builtin(c, fid, firstty, exp);
    append_str(out, " (targs ");
    render_type(out, targ, c);
    push(out, ')');
    append_str(out, vec_to_array(abuf));
    // result type: unwrap_or → T; is_some → bool; vec_new → Vec<T>; pop → T;
    // vec_to_array → [T]; len/push → i64 (the catch-all).
    if fid == 1 {
        targ
    } else if fid == 2 {
        2
    } else if fid == 7 {
        mk_vec(c, targ)
    } else if fid == 9 {
        targ
    } else if fid == 10 {
        mk_array(c, targ)
    } else {
        0
    }
}

// (ADR 0070) `apply(f: Fn<T,R>, x: T) -> R`: f's type is DYNAMIC — decoded
// from its own interned `Fn<T,R>` handle (kind 16, a=param_ty, b=ret_ty) —
// so the call's overall type can't come from the generic `fn_ret`/
// `builtin_ret` table (which only takes an FnId, not the concrete arg's
// type). Mirrors `check_call`'s `APPLY_FN_ID` special-case,
// `crates/sentinel-types/src/lib.rs:7442-7481`. Unlike `dump_gcall`'s
// generic builtins, `apply` renders NO `(targs …)` annotation (its
// `type_args` is always empty on the Rust side — codegen derives both LLVM
// types straight from the typed AST) — so args are dumped straight into
// `out`, no temp buffer needed. `f` not being a `Fn<T,R>` value falls back
// to `i64` (this project's usual "reject-path isn't rigorously handled"
// stance — the oracle rejects that case too, so the differential never
// compares scg's behavior for it).
fn dump_apply_call(out: &mut Vec<u8>, ca: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match ca {
        Args::End => 0,
        Args::Cell(f, rest) => {
            // (ADR 0070) codegen: snapshot the collected-arg stack BEFORE dumping
            // either arg, so both operands can be read back after collection to
            // emit the indirect call (mirrors `dump_te_call`'s own `cg_snap`).
            let cg_snap: i64 = if cg_on(c) {
                len((*c).cgak)
            } else {
                0
            };
            push(out, ' ');
            let ft: i64 = dump_texpr(out, f, 0 - 1, src, c, gb);
            mir_collect(c);
            cg_collect(c, ft);
            let param_ty: i64 = if ft < tbase() {
                0
            } else if (*c).tk[ft - tbase()] == 16 {
                (*c).ta[ft - tbase()]
            } else {
                0
            };
            let ret_ty: i64 = if ft < tbase() {
                0
            } else if (*c).tk[ft - tbase()] == 16 {
                (*c).tb[ft - tbase()]
            } else {
                0
            };
            match rest {
                Args::Cell(x, rest2) => {
                    push(out, ' ');
                    let xt: i64 = dump_texpr(out, x, param_ty, src, c, gb);
                    mir_collect(c);
                    cg_collect(c, xt);
                    dump_targs(out, rest2, 0 - 1, 0, src, c, gb);
                    0
                },
                Args::End => 0,
            };
            // (ADR 0070) codegen: emit the indirect call — scg's first `call`
            // through a computed function-pointer VALUE rather than a named
            // `@symbol`. `cg_emit_call`'s own subsequent (unconditional) call for
            // this FnId matches none of its dispatch arms and falls to a no-op,
            // but still runs its mandatory arg-stack cleanup — harmless, since it
            // never touches `cglk`/`cglv`, so this call's result register survives.
            if cg_on(c) {
                let fk: i64 = (*c).cgak[cg_snap];
                let fv: i64 = (*c).cgav[cg_snap];
                let xk: i64 = (*c).cgak[cg_snap + 1];
                let xv: i64 = (*c).cgav[cg_snap + 1];
                let d: i64 = cg_dst(c);
                cgo_str(c, "call ");
                cgo_ty(c, ret_ty);
                cg_putc(c, ' ');
                cgo_operand(c, fk, fv);
                cg_putc(c, '(');
                cgo_ty(c, param_ty);
                cg_putc(c, ' ');
                cgo_operand(c, xk, xv);
                cgo_str(c, ")\n");
                cg_reg(c, d);
                0
            } else {
                0
            };
            ret_ty
        },
    }
}

// Dump all call args into `out`, returning the FIRST arg's type (-1 if none).
// (ADR 0034 D8) `consume_rest` forces a CONSUMING walk of the args AFTER the first —
// `push`'s by-value element (its 2nd arg) is moved INTO the Vec, which then owns and
// frees it, so a Move-typed element Var must be recorded as moved (else codegen also
// frees it at scope exit: a use-after-free). The FIRST arg stays under the ambient
// context (`push`'s `&mut v` is a borrow, not a move). Other callers pass `false`.
fn dump_args_capture_first(out: &mut Vec<u8>, a: Args, consume_rest: bool, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0 - 1,
        Args::Cell(x, rest) => {
            push(out, ' ');
            let t0: i64 = dump_texpr(out, x, 0 - 1, src, c, gb);
            mir_collect(c);
            // (8c-2) codegen: collect the FIRST arg's operand (the rest collect via
            // `dump_targs`) so a generic builtin like `len` can read it back.
            cg_collect(c, t0);
            let svc: bool = (*c).consuming;
            if consume_rest { (*c).consuming = true; 0 } else { 0 };
            dump_targs(out, rest, 0 - 1, 0, src, c, gb);
            (*c).consuming = svc;
            t0
        },
    }
}

// (ADR 0071 M1.4c) The `Shared`/`Mutex` builtins' types are DYNAMIC — the element
// comes from the CONCRETE argument's own interned handle, not from the fixed
// per-FnId `builtin_ret` table (which knows only an FnId, so it could only ever
// answer the i64 default). Mirrors `dump_apply_call`'s shape and the Rust
// `check_call` special-cases:
//   38 shared_new(v: T)      -> Shared<T>          (element = the value arg's type)
//   39 shared_get(s: Shared<T>) -> T               (element read off the handle)
//   40 mutex_new(v: T)       -> Mutex<T>
//   41 lock(m: Mutex<T>)     -> ?Guard<T>
// This is what makes a SECRET element expressible end-to-end in scg: the interner
// is structural, so `Shared<secret i64>` needs no new representation — only this
// threading. An empty arg list / a non-container argument falls back to
// `builtin_ret` (the oracle rejects those cases, so the differential never compares
// scg's behavior for them — this project's usual reject-path stance).
// The CONSTRUCTORS (38 shared_new / 40 mutex_new) read the element off the VALUE
// argument and record NO `type_args` on the Rust side (codegen encodes by LLVM
// value kind), so they dump args straight — the `dump_apply_call` shape. The
// READERS (39 shared_get / 41 lock) take the element off the CONTAINER handle and
// DO record `type_args` whenever it is non-`i64` — so they must render a
// `(targs <elem>)` annotation before the args, which means buffering the args
// first (the `dump_gcall` shape) since the element is only known after the arg is
// typed. The `i64` case emits no targs, keeping every pre-M1.4c fixture
// byte-identical.
fn dump_container_call(out: &mut Vec<u8>, fid: i64, ca: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    if fid == 38 {
        let vt: i64 = dump_args_capture_first(out, ca, false, src, c, gb);
        if vt == 0 - 1 {
            builtin_ret(c, fid)
        } else {
            mk_shared(c, vt)
        }
    } else if fid == 40 {
        let vt2: i64 = dump_args_capture_first(out, ca, false, src, c, gb);
        if vt2 == 0 - 1 {
            builtin_ret(c, fid)
        } else {
            mk_mutex(c, vt2)
        }
    } else {
        let mut abuf: Vec<u8> = vec_new();
        let ht: i64 = dump_args_capture_first(&mut abuf, ca, false, src, c, gb);
        let elem: i64 = if ht == 0 - 1 {
            0 - 1
        } else {
            container_elem(c, ht)
        };
        if elem == 0 - 1 {
            append_str(out, vec_to_array(abuf));
            builtin_ret(c, fid)
        } else {
            if elem == 0 {
                0
            } else {
                append_str(out, " (targs ");
                render_type(out, elem, c);
                push(out, ')');
                0
            };
            append_str(out, vec_to_array(abuf));
            if fid == 39 {
                elem
            } else {
                mk_nullable(c, mk_guard(c, elem))
            }
        }
    }
}

// (ADR 0066 M1.2b-cont / M1.2c) recv(ch) -> ?<elem>: the container READER shape
// (like shared_get) — buffer the channel arg, read its element off the handle
// (`container_elem`, now channel-aware), emit `(targs <elem>)` for a NON-i64
// element so the typed dump matches the oracle's `type_args` (recorded by
// `check_call` for a non-i64 recv), and return `?<elem>`. The i64 case emits no
// targs, keeping every pre-M1.2b fixture byte-identical. An `<elem>` that is
// itself a `Channel<…>` (channel-of-channels, M1.2c) rides through unchanged —
// `render_type` recurses and the interner is structural.
// (ADR 0066 M2.3b / register D34) The CROSS-PROCESS channel element fence.
//
// ⚠ THIS IS AN EXPLICIT LIST AND MUST STAY ONE. Two rules, both learned the hard way
// in this repo:
//
//   1. DO NOT write it as an OPEN range. A closed `h >= 0 && h <= 5` happens to be
//      safe today — `tbase()` is 100, so codes 6..99 are free and a later scalar could
//      not slip in — but `h < tbase()` WOULD absorb every one of them silently. (An
//      earlier draft of this comment named `h <= 5` as the hazard; that was the wrong
//      counterexample. The rule stands, the reasoning is the open bound.) Keep the
//      list explicit anyway: a security fence that widens when someone else edits a
//      different file is exactly the bug the M1.2c post-mortem is about.
//   2. DO NOT reuse the in-process CHANNEL element predicate. The two sets are
//      DELIBERATELY different and the oracle carries a warning saying so: an
//      in-process `Channel<T>` may carry another channel HANDLE (M1.2c's nested
//      `Channel<Channel<E>>`), but a process PIPE may not — a handle is a
//      process-local address and means nothing on the other side. They happened to
//      coincide before M1.2c, and a comment claiming they "match" is what let the
//      cross-process fence widen once already.
//
// Mirrors `is_process_channel_elem` (`crates/sentinel-types/src/lib.rs`) one code at a
// time: i64(0), i32(1), bool(2), u8(3), f64(4), ptr(5). An interned handle (>= tbase())
// is NOT in the list.
//
// ⚠ IN `scg` THIS IS A FALLBACK FILTER, NOT A REJECTION, and an earlier version of this
// comment claimed the opposite in the exact place a reader checks the safety posture.
// Being out of the list does not produce a diagnostic: the element silently becomes
// `i64` and the ORACLE reports the resulting mismatch.
// `tests/ui/c66_process_channel_handle_fence.sentinel` pins the ORACLE's fence, not this
// function — a ui fixture the oracle rejects is skipped by every differential, so it
// never reaches `scg` at all. This predicate is therefore UNPINNED in scg by
// construction (snc-only, like `GuardNotLetBound`): keep it identical to the oracle by
// inspection, because no test will tell you if it drifts.
//
// It has two call sites, and they are not symmetric: `dump_process_recv` uses it to pick
// the element, and the `process_send` codegen arm uses it to GATE the encode — see the
// note there for why stripping `secret` at that boundary was a fail-open regression.
fn is_process_channel_elem_h(h: i64) -> bool {
    h == 0 || h == 1 || h == 2 || h == 3 || h == 4 || h == 5
}

// (ADR 0066 M2.3b / register D34) `process_recv(p) -> ?T`.
//
// Unlike `recv`, the element canNOT come from the argument: a `Process` is anonymous
// and carries no element at all. So T comes from the EXPECTED type, mirroring the
// oracle's `expected_return` read — the same shape `channel_new` (fid 21) uses. A
// non-nullable or out-of-fence expectation falls back to `i64`, and the outer context
// then surfaces the mismatch, exactly as the oracle documents.
//
// `(targs T)` is emitted ONLY for a non-i64 element, which is what keeps every
// pre-existing i64 program byte-identical (the oracle carries `type_args` on the same
// condition).
fn dump_process_recv(out: &mut Vec<u8>, ca: Args, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut abuf: Vec<u8> = vec_new();
    dump_targs(&mut abuf, ca, 0 - 1, 0, src, c, gb);
    let inner: i64 = if cg_is_nullable(c, exp) {
        nullable_inner_of(c, exp)
    } else {
        0
    };
    let elem: i64 = if is_process_channel_elem_h(inner) {
        inner
    } else {
        0
    };
    if elem == 0 {
        0
    } else {
        append_str(out, " (targs ");
        render_type(out, elem, c);
        push(out, ')');
        0
    };
    append_str(out, vec_to_array(abuf));
    mk_nullable(c, elem)
}

fn dump_channel_recv(out: &mut Vec<u8>, ca: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut abuf: Vec<u8> = vec_new();
    let ht: i64 = dump_args_capture_first(&mut abuf, ca, false, src, c, gb);
    let elem: i64 = if ht == 0 - 1 {
        0 - 1
    } else {
        container_elem(c, ht)
    };
    if elem == 0 - 1 {
        append_str(out, vec_to_array(abuf));
        builtin_ret(c, 23)
    } else {
        if elem == 0 {
            0
        } else {
            append_str(out, " (targs ");
            render_type(out, elem, c);
            push(out, ')');
            0
        };
        append_str(out, vec_to_array(abuf));
        mk_nullable(c, elem)
    }
}

// (4c-1) struct-literal fields: emit each field's VALUE positionally (the names
// are dropped — the typed StructLit is nameless/positional). Source order. (4h) for
// a GENERIC struct-lit (`gen`), the field's declared type is SUBSTITUTED with the
// instance's type-args `gargs` before it expects the value (so `Box { value: 42 }`
// types `42` against `i64`, and `Pair { first: a }` against `<T#0>`).
fn dump_sfields(out: &mut Vec<u8>, f: Fields, sid: i64, gen: bool, gargs: &Vec<i64>, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fval, rest) => {
            // Each field VALUE is coerced to the field's DECLARED type — a `?T` field
            // widens a `T` value / types a bare `null`. Look up the type by name
            // BEFORE `fnm` is sunk.
            let ftype0: i64 = field_type(c, sid, &fnm);
            let ftype: i64 = if gen {
                subst_type(c, ftype0, gargs)
            } else {
                ftype0
            };
            sink_name(gb, fnm);
            push(out, ' ');
            let sf_vty: i64 = dump_texpr(out, fval, ftype, src, c, gb);
            mir_collect(c);
            // (8c-1) codegen: collect this field's operand + type onto the shared
            // arg stacks (gated by `cg_collecting`); the struct-lit arm emits the
            // `insertvalue` chain over them after the walk (the call-arg pattern).
            cg_collect(c, sf_vty);
            dump_sfields(out, rest, sid, gen, gargs, src, c, gb)
        },
    }
}

// --- (4c-3 / 4d) implicit widening — nullable `?T` (ADR 0014 D3) + secret
//     `secret T` (ADR 0019 D5) -----------------------------------------------

// The widen KIND for a value of natural type `nt` meeting expectation `exp`:
//   0 = none, 1 = `widen-null` (`?nt` expected), 2 = `widen-secret` (`secret nt`
//   expected). `exp` of -1 / a scalar / any non-coercing compound → 0. Both `?T`
//   (kind 4) and `secret T` (kind 3) store the inner `T` in payload A (`ta`).
fn widen_kind(c: &mut TyCtx, exp: i64, nt: i64) -> i64 {
    if exp < tbase() {
        0
    } else {
        let k: i64 = (*c).tk[exp - tbase()];
        if k == 4 {
            if (*c).ta[exp - tbase()] == nt {
                1
            } else {
                0
            }
        } else if k == 3 {
            if (*c).ta[exp - tbase()] == nt {
                2
            } else {
                0
            }
        } else {
            0
        }
    }
}

// True iff `h` is a secret type `secret T` (interner kind 3).
fn is_secret(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 3
    }
}

// Strip one `secret` layer: `secret T` → `T`; any other type unchanged. Used by
// `declassify` (D6) and the secret-preserving cmp/logic result type (D5b).
fn strip_secret(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        h
    } else if (*c).tk[h - tbase()] == 3 {
        (*c).ta[h - tbase()]
    } else {
        h
    }
}

// Emit the widen prefix iff a value of natural type `nt` widens to `exp` — `?T` →
// `(widen-null `, `secret T` → `(widen-secret `; return whether it did (so the
// caller closes the wrapper after the node via `widen_post` — `close_ty` renders
// `:?T` / `:secret T` from `exp` itself, so the suffix needs no kind).
fn widen_pre(out: &mut Vec<u8>, exp: i64, nt: i64, c: &mut TyCtx) -> bool {
    let wk: i64 = widen_kind(c, exp, nt);
    if wk == 1 {
        append_str(out, "(widen-null ");
        0
    } else if wk == 2 {
        append_str(out, "(widen-secret ");
        0
    } else {
        0
    };
    wk != 0
}

// Close a widened node: append ` :?T)` iff `w`; return the node's resulting type
// (`exp` when widened, else the natural `nt`).
fn widen_post(out: &mut Vec<u8>, w: bool, exp: i64, nt: i64, c: &mut TyCtx) -> i64 {
    if w {
        close_ty(out, exp, c);
        exp
    } else {
        nt
    }
}

// Splice a composite already emitted into `tmp` (natural type `nt`) into `out`,
// wrapping it in `(widen-null … :?T)` iff a `?nt` is expected. Consumes `tmp`. Used
// where the node's type is known only AFTER its children synthesize — the wrapper
// must precede the node, so the node is built in a temp first.
fn widen_splice(out: &mut Vec<u8>, tmp: Vec<u8>, exp: i64, nt: i64, c: &mut TyCtx) -> i64 {
    let w: bool = widen_pre(out, exp, nt, c);
    append_str(out, vec_to_array(tmp));
    widen_post(out, w, exp, nt, c)
}

