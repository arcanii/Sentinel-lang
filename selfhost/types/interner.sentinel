// A `TypeE` (surface type AST) -> a type handle (interning compounds). Consumes
// the `TypeE` (disposing any owned name `[u8]` into `gb`). At m-1 only scalars are
// validated; a non-scalar `TIdent` (a struct/enum/class name) defaults to i64
// (the decl tables land at 4c).
fn type_of_typeexpr(c: &mut TyCtx, t: TypeE, gb: &mut Vec<u8>) -> i64 {
    match t {
        TypeE::TIdent(nm) => {
            // (4h) an in-scope type-param shadows everything else → `<T#idx>`.
            let tpidx: i64 = tp_lookup(c, &nm);
            // (4i) `String` is a built-in alias for `Vec<u8>` (ADR 0034 — the oracle
            // desugars it, rendering `Vec<u8>`); a type-param named `String` shadows it.
            let is_string: bool = if tpidx >= 0 {
                false
            } else {
                name_eq_lit(&nm, "String")
            };
            let sc: i64 = if tpidx >= 0 {
                0 - 1
            } else if is_string {
                0 - 1
            } else {
                scalar_code(&nm)
            };
            let sid: i64 = if tpidx >= 0 {
                0 - 1
            } else if sc >= 0 {
                0 - 1
            } else {
                struct_lookup(c, &nm)
            };
            let eid: i64 = if tpidx >= 0 {
                0 - 1
            } else if sc >= 0 {
                0 - 1
            } else if sid >= 0 {
                0 - 1
            } else {
                enum_lookup(c, &nm)
            };
            let cid: i64 = if tpidx >= 0 {
                0 - 1
            } else if sc >= 0 {
                0 - 1
            } else if sid >= 0 {
                0 - 1
            } else if eid >= 0 {
                0 - 1
            } else {
                class_lookup(c, &nm)
            };
            sink_name(gb, nm);
            if tpidx >= 0 {
                // (Bar B / generics-b) during a mono re-walk, a type-param resolves to
                // the instance's CONCRETE arg (`T` → `i64`) so the body lowers concretely;
                // otherwise it's the abstract `<T#idx>` (the type dump + the seed walk).
                if (*c).cg_mono_on {
                    (*c).cg_mono_args[tpidx]
                } else {
                    mk_tparam(c, tpidx)
                }
            } else if is_string {
                mk_vec(c, 3)
            } else if sc >= 0 {
                sc
            } else if sid >= 0 {
                mk_struct(c, sid)
            } else if eid >= 0 {
                mk_enum(c, eid)
            } else if cid >= 0 {
                mk_class(c, cid)
            } else {
                0
            }
        },
        TypeE::TNullable(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_nullable(c, ih)
        },
        TypeE::TArray(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_array(c, ih)
        },
        TypeE::TRef(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_ref(c, 0, ih)
        },
        TypeE::TRefMut(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_ref(c, 1, ih)
        },
        TypeE::TSecret(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_secret(c, ih)
        },
        TypeE::TGeneric(gn, ga) => {
            // (4i) `Vec<T>` → the kind-11 Vec type (D.3 collections). (4h) else
            // `Name<args>` for a user struct → a GenericInstance (resolving each arg,
            // which may itself be a type-param). Any other generic (no such type)
            // keeps the placeholder (dispose + i64) — it only occurs in rejected fixtures.
            let is_vec: bool = name_eq_lit(&gn, "Vec");
            // (ADR 0066 M1.2b) `Channel<T>` in type position → the kind-13
            // Channel type (mirrors the Rust resolve_type_expr "Channel" arm),
            // so a fn can take a channel endpoint as a parameter. At the M1.2b
            // minimum the element is `i64` (handle 0) — the singleton
            // `Channel<i64>` the channel builtins are typed against.
            let is_channel: bool = name_eq_lit(&gn, "Channel");
            // (ADR 0070) `Fn<T,R>` in type position → the kind-16 Fn type (mirrors the
            // Rust resolve_type_expr "Fn" arm's accept path; the oracle's own 2-arg
            // arity check and word-scalar eligibility rejection are out of scope — a
            // fixture the oracle rejects never reaches here, per the corpus's own
            // skip-on-oracle-error rule, so `mk_fn` need not itself validate).
            let is_fn: bool = name_eq_lit(&gn, "Fn");
            let gsid: i64 = if is_vec {
                0 - 1
            } else if is_channel {
                0 - 1
            } else if is_fn {
                0 - 1
            } else {
                struct_lookup(c, &gn)
            };
            sink_name(gb, gn);
            if is_vec {
                let mut vav: Vec<i64> = vec_new();
                collect_tyargs(c, ga, gb, &mut vav);
                let velem: i64 = if len(vav) > 0 {
                    vav[0]
                } else {
                    0
                };
                mk_vec(c, velem)
            } else if is_channel {
                // resolve (and free) the type args like `Vec`; the element
                // type is `i64` at the M1.2b minimum, so the handle is 0.
                let mut cav: Vec<i64> = vec_new();
                collect_tyargs(c, ga, gb, &mut cav);
                mk_channel(c, 0)
            } else if is_fn {
                let mut fav: Vec<i64> = vec_new();
                collect_tyargs(c, ga, gb, &mut fav);
                let fparam: i64 = if len(fav) > 0 {
                    fav[0]
                } else {
                    0
                };
                let fret: i64 = if len(fav) > 1 {
                    fav[1]
                } else {
                    0
                };
                mk_fn(c, fparam, fret)
            } else if gsid >= 0 {
                let mut gav: Vec<i64> = vec_new();
                collect_tyargs(c, ga, gb, &mut gav);
                mk_generic(c, gsid, &gav)
            } else {
                dispose_tyargs(c, ga, gb);
                0
            }
        },
    }
}

// (4h) Resolve a `TyArgs` cons-list into a flat `Vec<i64>` of type handles (each arg
// may be a type-param, scalar, struct, or nested generic).
fn collect_tyargs(c: &mut TyCtx, a: TyArgs, gb: &mut Vec<u8>, av: &mut Vec<i64>) -> i64 {
    match a {
        TyArgs::TAEnd => 0,
        TyArgs::TACell(t, rest) => {
            let h: i64 = type_of_typeexpr(c, t, gb);
            push(av, h);
            collect_tyargs(c, rest, gb, av)
        },
    }
}

// Consume a `TyArgs` cons-list (disposing its `TypeE`s) — the non-struct-generic
// placeholder (e.g. `Vec<T>` annotations, still typed as i64).
fn dispose_tyargs(c: &mut TyCtx, a: TyArgs, gb: &mut Vec<u8>) -> i64 {
    match a {
        TyArgs::TAEnd => 0,
        TyArgs::TACell(t, rest) => {
            type_of_typeexpr(c, t, gb);
            dispose_tyargs(c, rest, gb)
        },
    }
}

// --- the builtin / user-fn return-type tables -------------------------------

// The 14 runtime builtins -> FnId (0..=13), or -1.
fn builtin_id(q: &[u8]) -> i64 {
    if name_eq_lit(q, "print") {
        0
    } else if name_eq_lit(q, "unwrap_or") {
        1
    } else if name_eq_lit(q, "is_some") {
        2
    } else if name_eq_lit(q, "len") {
        3
    } else if name_eq_lit(q, "str_eq") {
        4
    } else if name_eq_lit(q, "u8_to_i64") {
        5
    } else if name_eq_lit(q, "i64_to_u8") {
        6
    } else if name_eq_lit(q, "vec_new") {
        7
    } else if name_eq_lit(q, "push") {
        8
    } else if name_eq_lit(q, "pop") {
        9
    } else if name_eq_lit(q, "vec_to_array") {
        10
    } else if name_eq_lit(q, "read_file") {
        11
    } else if name_eq_lit(q, "write_file") {
        12
    } else if name_eq_lit(q, "print_bytes") {
        13
    } else if name_eq_lit(q, "channel_new") {
        21
    } else if name_eq_lit(q, "send") {
        22
    } else if name_eq_lit(q, "recv") {
        23
    } else if name_eq_lit(q, "channel_close") {
        24
    } else if name_eq_lit(q, "process_spawn") {
        25
    } else if name_eq_lit(q, "process_wait") {
        26
    } else if name_eq_lit(q, "process_write") {
        27
    } else if name_eq_lit(q, "process_read") {
        28
    } else if name_eq_lit(q, "process_send") {
        29
    } else if name_eq_lit(q, "process_recv") {
        30
    } else if name_eq_lit(q, "sealed_channel") {
        // ADR 0066 M2.4a / ADR 0069: the SealedChannel bridge builtins
        // (identity-ptr passthroughs, see cg_emit_call for why).
        31
    } else if name_eq_lit(q, "sealed_process") {
        32
    } else if name_eq_lit(q, "stdin_recv") {
        // ADR 0066 M2.4b: the self-stdin/stdout framed builtins (child-side
        // twins of process_recv/send — no Process handle argument).
        33
    } else if name_eq_lit(q, "stdout_send") {
        34
    } else if name_eq_lit(q, "arg_count") {
        // ADR 0066 M2.4 follow-on: own command-line argument reflection.
        35
    } else if name_eq_lit(q, "arg") {
        36
    } else if name_eq_lit(q, "apply") {
        // ADR 0070: the indirect-call builtin for non-capturing function
        // values (`dump_te_call`'s `fid == 37` arm dispatches to
        // `dump_apply_call`, which decodes the concrete `Fn<T,R>` from the
        // first arg's type — codegen for this builtin stays out of scope,
        // see `dump_apply_call`'s doc comment).
        37
    } else if name_eq_lit(q, "shared_new") {
        // ADR 0071 M1.4a: the Shared<T> refcounted-handle builtins (reserved
        // slots — slice 2a; Type::Shared + check_call land in 2b/3).
        38
    } else if name_eq_lit(q, "shared_get") {
        39
    } else {
        0 - 1
    }
}

// A builtin FnId -> its return-type handle (the scalar-returning ones; the
// generic/array ones land at 4c/4h, defaulting to i64 for m-1).
fn builtin_ret(c: &mut TyCtx, fid: i64) -> i64 {
    if fid == 2 {
        2
    } else if fid == 3 {
        0
    } else if fid == 4 {
        2
    } else if fid == 5 {
        0
    } else if fid == 6 {
        3
    } else if fid == 11 {
        mk_array(c, 3)
    } else if fid == 21 {
        mk_channel(c, 0)
    } else if fid == 23 {
        mk_nullable(c, 0)
    } else if fid == 25 {
        // (ADR 0066 M2.1) process_spawn(...) -> Process.
        mk_process(c)
    } else if fid == 28 {
        // (ADR 0066 M2.2) process_read(p) -> [u8].
        mk_array(c, 3)
    } else if fid == 30 {
        // (ADR 0066 M2.3) process_recv(p) -> ?i64 (process_send (29) -> i64 via
        // the default 0=i64 below, like send/channel_close).
        mk_nullable(c, 0)
    } else if fid == 31 {
        // (ADR 0066 M2.4a / ADR 0069) sealed_channel(Process) -> SealedChannel.
        mk_sealed_channel(c)
    } else if fid == 32 {
        // (ADR 0066 M2.4a / ADR 0069) sealed_process(SealedChannel) -> Process
        // (the reverse bridge).
        mk_process(c)
    } else if fid == 33 {
        // (ADR 0066 M2.4b) stdin_recv() -> ?i64 (stdout_send (34) -> i64 via
        // the default 0=i64 below, like recv/process_recv).
        mk_nullable(c, 0)
    } else if fid == 36 {
        // (ADR 0066 M2.4 follow-on) arg(i) -> [u8] (arg_count (35) -> i64 via
        // the default 0=i64 below, like read_file/process_read).
        mk_array(c, 3)
    } else {
        0
    }
}

// Resolve a call name to a FnId: a builtin (0..=39), else a user fn (40 + idx),
// else -1.
fn fn_lookup(c: &mut TyCtx, src: &[u8], q: &[u8]) -> i64 {
    let b: i64 = builtin_id(q);
    if b >= 0 {
        b
    } else {
        let n: i64 = len((*c).ufs);
        let mut i: i64 = 0;
        let mut found: i64 = 0 - 1;
        while i < n {
            if found == 0 - 1 {
                if name_eq_src(src, (*c).ufs[i], (*c).ufe[i], q) {
                    found = 40 + i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        found
    }
}

// The return-type handle for a resolved FnId.
fn fn_ret(c: &mut TyCtx, fid: i64) -> i64 {
    if fid < 40 {
        builtin_ret(c, fid)
    } else {
        (*c).ufret[fid - 40]
    }
}

// (ADR 0070) is user FnId `fid` (fid >= 40) eligible as a `Fn<T,R>` value —
// non-generic, effect-free, exactly one word-scalar param, word-scalar
// return (mirrors the Rust eligibility gate, `crates/sentinel-types/src/
// lib.rs:7910-7929`, using the fields scg already tracks per user fn).
// Returns the interned `Type::Fn` handle if eligible, else -1.
//
// `ufeff` tracks "does this fn need the Kont* ABI" (effecting beyond a bare
// `Async` row), which is a slightly coarser signal than Rust's "effect row
// is fully empty" — an accepted approximation: it only affects the reject
// path (an Async-only fn might be treated as eligible here when Rust would
// reject it), which the self-host differential doesn't verify anyway (the
// oracle rejecting a fixture means the comparison is skipped before scg is
// even run — the same "error parity is out of scope" limitation as the
// rest of this project, ADR 0044 D7).
//
// Only scg's 4 existing scalar handles (i64/i32/bool/u8, all `< tbase()`)
// are considered — scg's type system has no `f64`/`ptr` handle yet (a
// separate, pre-existing gap), so a `Fn<f64,f64>`-style value can't be
// formed here regardless.
fn fn_ref_sig(c: &mut TyCtx, fid: i64) -> i64 {
    let idx: i64 = fid - 40;
    if (*c).uftp[idx] > 0 {
        0 - 1
    } else if (*c).ufeff[idx] > 0 {
        0 - 1
    } else if (*c).ufpe[idx] - (*c).ufps[idx] != 1 {
        0 - 1
    } else {
        let param_ty: i64 = (*c).ufpp[(*c).ufps[idx]];
        let ret_ty: i64 = (*c).ufret[idx];
        if param_ty >= tbase() {
            0 - 1
        } else if ret_ty >= tbase() {
            0 - 1
        } else {
            mk_fn(c, param_ty, ret_ty)
        }
    }
}

// --- scope + env ------------------------------------------------------------

// Resolve a variable name to its VarId — newest-first over `[base, top)`; -1 if
// absent.
fn sc_lookup(c: &mut TyCtx, q: &[u8]) -> i64 {
    let top: i64 = len((*c).scs);
    let mut i: i64 = top - 1;
    let mut found: i64 = 0 - 1;
    while i >= (*c).base {
        if found == 0 - 1 {
            if blob_eq(c, (*c).scs[i], (*c).sce[i], q) {
                found = (*c).scv[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// Read a VarId's type from the append-only env (vid == push order).
fn env_get(c: &mut TyCtx, vid: i64) -> i64 {
    (*c).env[vid]
}

// Bind a name given as a `src` slice (a param): copy its bytes into the blob,
// record the scope entry (slice + VarId) AND push its type into the env. Called
// in VarId order, so the push lands at index `vid`.
fn bind_src(c: &mut TyCtx, src: &[u8], ns: i64, ne: i64, vid: i64, ty: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let mut i: i64 = ns;
    while i < ne {
        push(&mut (*c).nb, (*src)[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + (ne - ns));
    push(&mut (*c).scv, vid);
    push(&mut (*c).env, ty);
    0
}

// Bind a name given as an owned `[u8]` (a `let`): push its bytes into the blob
// (which also DISPOSES the `[u8]`), record the scope entry + env type.
fn bind_name(c: &mut TyCtx, name: [u8], vid: i64, ty: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(&mut (*c).nb, name[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + n);
    push(&mut (*c).scv, vid);
    push(&mut (*c).env, ty);
    0
}

