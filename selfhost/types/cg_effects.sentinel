        // `scg` from FAIL-CLOSED to FAIL-OPEN. Pre-D34 a `secret u8`/`i32`/`bool`
        // element emitted IR `llvm-as` rejects; the strip made all four secret scalars
        // emit clean, assembling IR instead. The oracle rejects every one of them, so
        // no such program is user-reachable or differentially compared — but turning a
        // security boundary from loud to silent is how this repo has been bitten twice,
        // and the gate costs nothing: all 9 corpus `process_send` programs, the pin,
        // the i64 control and the merged-compiler fixed point are byte-identical with
        // it in place.
        let pse_ety: i64 = (*c).cgat[snap + 1];
        let pse_enc: i64 = if is_process_channel_elem_h(pse_ety) {
            cg_container_encode(c, pse_ety, pse_vk, pse_vv)
        } else {
            0 - 1
        };
