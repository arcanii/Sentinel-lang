        cgo_str(c, "insertvalue { i1, ");
        cgo_ty(c, cr_elem);
        cgo_str(c, " } undef, i1 %v");
        cgo_int(c, cr_valid);
        cgo_str(c, ", 0\n");
        let cr_o1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ");
        cgo_ty(c, cr_elem);
        cgo_str(c, " } %v");
        cgo_int(c, cr_o0);
        cgo_str(c, ", ");
        cgo_ty(c, cr_elem);
        cgo_str(c, " %v");
        cgo_int(c, cr_value);
