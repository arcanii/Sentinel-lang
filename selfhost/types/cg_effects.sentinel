module types;

// --- (Bar B / effects) handler-runtime codegen helpers ----------------------

// A unique op id per `(EffectId, op_index)` — `(eid<<16)|(op&0xFFFF)`, which for an
// op_index < 65536 (always) is `eid*65536 + op` (no `<<`/`|` needed; same decimal value).
fn cg_encode_op_id(eid: i64, opidx: i64) -> i64 {
    eid * 65536 + opidx
}

// `%vD = call ptr @sentinel_perform_op(i32 op_id, i64 arg|0)` (the collected single arg
// at `snap`, or `0`); pops the collected args. Sets the result operand to the kont ptr.
fn cg_emit_perform(c: &mut TyCtx, eid: i64, opidx: i64, snap: i64) -> i64 {
    let opid: i64 = cg_encode_op_id(eid, opidx);
    let d: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_perform_op(i32 ");
    cgo_int(c, opid);
    cgo_str(c, ", i64 ");
    let n: i64 = len((*c).cgak);
    if n > snap {
        let ak: i64 = (*c).cgak[snap];
        let av: i64 = (*c).cgav[snap];
        cgo_operand(c, ak, av);
        0
    } else {
        cg_putc(c, '0');
        0
    };
    cgo_str(c, ")\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    (*c).cg_used_perform = true;
    cg_reg(c, d);
    // (c35b) a `perform` produces a kont — if it is the fn-body tail, the effecting fn
    // returns it directly (no `kont_pure` wrap).
    (*c).cg_tailk = true;
    0
}

// (Bar B / effects c35d) `%vD = load i64, ptr %v<cg_ph>` — inside an embedded-shape
// RESUMER the unique `perform` was reified by the parent; its result arrives as the
// resumed value at the placeholder slot. Pops any collected args like
// `cg_emit_perform` (the args were the PARENT's to lower — zero-arg over the c35d
// corpus). Does NOT set `cg_tailk` (the load is a plain i64 inside the pure context).
fn cg_emit_phload(c: &mut TyCtx, snap: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "load i64, ptr %v");
    cgo_int(c, (*c).cg_ph);
    cg_putc(c, '\n');
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, d);
    0
}

// (Bar B / effects) bind a handler arm's params from the VarId range `[pv0, pvn)` (in
// the SAME order the oracle's `bind_handler_arm_params` allocates): the op-param (when
// there are >=2 params — `kont.arg` via i8-GEP @8 into an i64 slot), then the
// continuation (the last, a slot holding the kont ptr `ck`). C3.5(a): one op-param max.
fn cg_bind_harm_params(c: &mut TyCtx, pv0: i64, pvn: i64, ck: i64) -> i64 {
    let n: i64 = pvn - pv0;
    if n >= 2 {
        let ap: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %v");
        cgo_int(c, ck);
        cgo_str(c, ", i64 8\n");
        let av: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, ap);
        cg_putc(c, '\n');
        let oslot: i64 = cg_alloca(c, 0);
        cgo_str(c, "  store i64 %v");
        cgo_int(c, av);
        cgo_str(c, ", ptr %v");
        cgo_int(c, oslot);
        cg_putc(c, '\n');
        cg_slot_set(c, pv0, oslot);
        0
    } else {
        0
    };
    let kslot: i64 = cg_alloca_ptr(c);
    cgo_str(c, "  store ptr %v");
    cgo_int(c, ck);
    cgo_str(c, ", ptr %v");
    cgo_int(c, kslot);
    cg_putc(c, '\n');
    cg_slot_set(c, pvn - 1, kslot);
    // (ADR 0074 D1) the slot is now the arm's ownership record for the kont; `dump_tharms`
    // pops it after the arm body, releasing what it still holds.
    push(&mut (*c).cg_arm_ks, kslot);
    0
}

// (ADR 0074 D2) release the kont each handler arm at index >= `floor` of `cg_arm_ks` still
// owns, innermost first: load the arm's slot and, if it is not the null a `k(v)` leaves
// there, `sentinel_kont_free` it — the test is in the emitted code, so the code never
// depends on the runtime's own null check (ADR 0074 D4). Emitted on every exit that leaves
// an arm without resuming its `k`: the fall-through (the top arm only), `return` (floor 0:
// every arm) and `break` / `continue` (the loop's arm floor). Mirrors the oracle's
// `emit_arm_kont_releases`, block for block.
fn cg_release_arm_konts(c: &mut TyCtx, floor: i64) -> i64 {
    let mut i: i64 = len((*c).cg_arm_ks) - 1;
    while i >= floor {
        let slot: i64 = (*c).cg_arm_ks[i];
        let r: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        let owned: i64 = cg_dst(c);
        cgo_str(c, "icmp ne ptr %v");
        cgo_int(c, r);
        cgo_str(c, ", null\n");
        let free_b: i64 = cg_fresh_block(c);
        let done_b: i64 = cg_fresh_block(c);
        cgo_str(c, "  br i1 %v");
        cgo_int(c, owned);
        cgo_str(c, ", label %bb");
        cgo_int(c, free_b);
        cgo_str(c, ", label %bb");
        cgo_int(c, done_b);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, free_b);
        cgo_str(c, ":\n");
        cgo_str(c, "  call void @sentinel_kont_free(ptr %v");
        cgo_int(c, r);
        cgo_str(c, ")\n");
        cgo_str(c, "  br label %bb");
        cgo_int(c, done_b);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, done_b);
        cgo_str(c, ":\n");
        (*c).cg_used_kontfree = true;
        i = i - 1;
    }
    0
}

// (ADR 0075 D6) the NAME bound to `vid`, copied out of the name blob. Needed because the
// classification walks a syntax tree, where a resume is a call to the arm's kont NAME.
fn cg_vid_name(c: &mut TyCtx, vid: i64) -> [u8] {
    let n: i64 = len((*c).scs);
    let mut i: i64 = n - 1;
    let mut st: i64 = 0 - 1;
    let mut en: i64 = 0 - 1;
    while i >= 0 {
        if st < 0 {
            if (*c).scv[i] == vid {
                st = (*c).scs[i];
                en = (*c).sce[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    let mut v: Vec<u8> = vec_new();
    let mut j: i64 = st;
    while j < en {
        push(&mut v, (*c).nb[j]);
        j = j + 1;
    }
    vec_to_array(v)
}

// (ADR 0075 D6) the env type recorded for `vid` if `vid` is in scope, or -1. The scope
// stack is scanned only to ask whether `vid` is in scope; the TYPE is `env[vid]`, since
// `env` is indexed by VarId (see `env_get`). A scope position is not a VarId: the scope
// stack is truncated after every handler, match and return arm and `env` never is, and
// `env` opens with one phantom slot per effect-op parameter, so `env[<scope position>]`
// can be some other binding's type.
fn cg_vid_ty(c: &mut TyCtx, vid: i64) -> i64 {
    let n: i64 = len((*c).scv);
    let mut i: i64 = n - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found == 0 - 1 {
            if (*c).scv[i] == vid { found = env_get(c, vid); 0 } else { 0 };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// (ADR 0072 D3, as ADR 0075 D6 applies it) does a value of this type cross the `i64[N]`
// continuation seam? `i64` and `secret i64` only -- `strip_secret` renders both as type
// code 0. Mirrors `sentinel-codegen`'s `fits_kont_slot`.
fn cg_ar_fits(c: &mut TyCtx, ty: i64) -> bool {
    strip_secret(c, ty) == 0
}

// (ADR 0075 D6) every capture collected for THIS arm must cross the seam. `arcaps` is a
// stack shared with any enclosing arm, so this reads only the slice from `base` up.
fn cg_ar_caps_fit(c: &mut TyCtx, base: i64) -> bool {
    let n: i64 = len((*c).arcaps);
    let mut i: i64 = base;
    let mut ok: bool = true;
    while i < n {
        let ty: i64 = cg_vid_ty(c, (*c).arcaps[i]);
        if ty < 0 { ok = false; 0 } else { if cg_ar_fits(c, ty) { 0 } else { ok = false; 0 } };
        i = i + 1;
    }
    ok
}

// (ADR 0075 D6) classify THIS arm and, when its remainder is observable, judge whether it
// can be reified. Sets `cg_h_rcls` (0 = branch away, 1 = reify, 2 = class (A) abort) and,
// for 1, appends the remainder's captures to `arcaps` above `cg_h_cbase`. Each question
// consumes its own disposable re-parse of the arm body, as `eff_classify` does for an
// effecting fn's tail. The resumer's SEQUENCE NUMBER is NOT taken here: the text oracle
// advances its counter when it emits the resumer, which for a `handle` nested inside an
// arm is a different order from classification.
//
// Mirrors `sentinel-codegen`'s `arm_resume_class` + `arm_remainder_verdict`, which inkwell
// and the text oracle share; the walkers below are this back end's half of that pair.
fn cg_ar_classify(c: &mut TyCtx, btok: i64, kvid: i64, src: &[u8]) -> i64 {
    let kname: [u8] = cg_vid_name(c, kvid);
    let mut c1: i64 = btok;
    let b1: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut c1);
    let n: i64 = cg_ar_count(b1, &kname);
    if n == 0 {
        (*c).cg_h_rcls = 0;
        let _k: [u8] = kname;
        0
    } else {
        let mut c2: i64 = btok;
        let b2: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut c2);
        let is_tail: bool = if n == 1 { cg_ar_tail(b2, &kname) } else { let _b2: Expr = b2; false };
        let mut c3: i64 = btok;
        let b3: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut c3);
        let is_div: bool = cg_ar_returns(b3);
        if is_tail {
            (*c).cg_h_rcls = 0;
            0
        } else {
            if is_div {
                (*c).cg_h_rcls = 0;
                0
            } else {
                // Observable: the verdict decides (R) from (A).
                let mut c4: i64 = btok;
                let b4: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut c4);
                let unc: i64 = if n == 1 { cg_ar_uncond(b4, &kname) } else { let _b4: Expr = b4; 2 };
                let mut c5: i64 = btok;
                let b5: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut c5);
                let pre: i64 = if n == 1 { cg_ar_pre(b5, &kname) } else { let _b5: Expr = b5; 2 };
                // APPEND this arm's captures; `cg_h_cbase` was set to the stack top
                // by the caller before this ran, and the caller truncates back to it.
                let cbase: i64 = (*c).cg_h_cbase;
                let mut c6: i64 = btok;
                let b6: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut c6);
                let _cn: i64 = cg_ar_caps(c, b6, &kname);
                let fits: bool = cg_ar_caps_fit(c, cbase);
                if n == 1 {
                    if unc == 1 {
                        if pre == 1 {
                            if fits {
                                (*c).cg_h_rcls = 1;
                                0
                            } else { (*c).cg_h_rcls = 2; 0 }
                        } else { (*c).cg_h_rcls = 2; 0 }
                    } else { (*c).cg_h_rcls = 2; 0 }
                } else {
                    (*c).cg_h_rcls = 2;
                    0
                }
            }
        }
    }
}

// (ADR 0075 D6) allocate and fill the `i64[N]` captured-state struct a continuation frame
// carries, and answer the operand to hand `sentinel_kont_push`: the alloc register, or -1
// for `null` when nothing is captured (the shape the other frames already emit).
// Ownership passes to the push, which frees it after the resumer runs. Mirrors the text
// oracle's `build_captured_state` instruction for instruction, because the registers this
// burns are in the PARENT's define and the two are compared byte for byte.
fn cg_ar_build_caps(c: &mut TyCtx, base: i64, n: i64) -> i64 {
    if n == 0 {
        0 - 1
    } else {
        let a: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 ");
        cgo_int(c, n * 8);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        let mut i: i64 = 0;
        while i < n {
            let gp: i64 = cg_dst(c);
            cgo_str(c, "getelementptr i8, ptr %v");
            cgo_int(c, a);
            cgo_str(c, ", i64 ");
            cgo_int(c, i * 8);
            cg_putc(c, '\n');
            let slot: i64 = cg_slot_get(c, (*c).arcaps[base + i]);
            let ld: i64 = cg_dst(c);
            cgo_str(c, "load i64, ptr %v");
            cgo_int(c, slot);
            cg_putc(c, '\n');
            cgo_str(c, "  store i64 %v");
            cgo_int(c, ld);
            cgo_str(c, ", ptr %v");
            cgo_int(c, gp);
            cg_putc(c, '\n');
            i = i + 1;
        }
        a
    }
}

// (ADR 0075 D6 / A1) write the enclosing SOURCE definition's emitted symbol: for an init /
// method / impl method, by calling `cg_emit_method_sym`, the emitter that define's own
// header uses; for a fn, by restating `cg_emit_fn`'s header rule -- `cgo_slice` of the name,
// plus the mono suffix for an instance. Every frame of an effecting fn's shape uses the fn's
// symbol, as the oracle's `parent_sym` does. The corpus differential, not construction, is
// what holds this to the oracle's `__armrem_<parent_sym>_<seq>` byte for byte.
//
// It used to write the fn's SOURCE name span, always. That is not unique — a generic
// fn's instances all share it, so two instances defined the same `@__armrem_g_0` — and a
// method is not a fn at all: its bubble named whichever free fn had last set the span.
fn cg_emit_psym(c: &mut TyCtx, src: &[u8]) -> i64 {
    if (*c).cg_pkind == 1 {
        cg_emit_method_sym(c, src, (*c).cg_pinit, (*c).cg_fn_s, (*c).cg_fn_e)
    } else {
        cgo_slice(c, src, (*c).cg_fn_s, (*c).cg_fn_e);
        if (*c).cg_mono_on {
            let margs: Vec<i64> = cg_copy_targs(c, 0);
            cg_emit_mono_suffix(c, &margs);
            0
        } else {
            0
        }
    }
}

// (ADR 0075 D6) class (R) at the bubble: reify the rest of THIS arm onto the bubbled kont,
// so the inner dispatch replays it when the chain drains (ADR 0020 D3's re-wrap). Emits the
// captured state and the push, takes the resumer's sequence number, and records a WORKLIST
// entry; the resumer's own `define` is emitted after the enclosing one is assembled, by
// `cg_ar_drain`.
fn cg_ar_reify(c: &mut TyCtx, kr: i64, src: &[u8]) -> i64 {
    let base: i64 = (*c).cg_h_cbase;
    let n: i64 = len((*c).arcaps) - base;
    let cap: i64 = cg_ar_build_caps(c, base, n);
    let seq: i64 = (*c).cg_armseq;
    (*c).cg_armseq = (*c).cg_armseq + 1;
    cgo_str(c, "  call void @sentinel_kont_push(ptr %v");
    cgo_int(c, kr);
    cgo_str(c, ", ptr @__armrem_");
    cg_emit_psym(c, src);
    cg_putc(c, '_');
    cgo_int(c, seq);
    cgo_str(c, ", ptr ");
    if cap < 0 {
        cgo_str(c, "null")
    } else {
        cgo_str(c, "%v");
        cgo_int(c, cap)
    };
    cgo_str(c, ")\n");
    (*c).cg_used_kontpush = true;
    // The worklist entry COPIES this arm's capture slice: the arm's own stack frame is
    // truncated when the arm finishes, long before the drain runs.
    push(&mut (*c).arwb, (*c).cg_h_btok);
    push(&mut (*c).arwq, seq);
    push(&mut (*c).arwk, (*c).cg_h_kont);
    // The continuation's NAME, copied out while it is still in scope. The drain runs
    // after the arm's `truncate_scope`, so a VarId is useless there.
    let kn: [u8] = cg_vid_name(c, (*c).cg_h_kont);
    push(&mut (*c).arwks, len((*c).arwkn));
    let knn: i64 = len(kn);
    let mut ki: i64 = 0;
    while ki < knn {
        push(&mut (*c).arwkn, kn[ki]);
        ki = ki + 1;
    }
    push(&mut (*c).arwke, len((*c).arwkn));
    push(&mut (*c).arwcs, len((*c).arwc));
    push(&mut (*c).arwcn, n);
    let mut j: i64 = 0;
    while j < n {
        push(&mut (*c).arwc, (*c).arcaps[base + j]);
        j = j + 1;
    }
    0
}

// (ADR 0075 D6) is `q` the continuation name currently armed as the resumer's
// placeholder? `[s,e)` indexes `arwkn`, the worklist's own name blob.
fn cg_arm_ph_is(c: &mut TyCtx, q: &[u8]) -> bool {
    let s: i64 = (*c).cg_arm_phs;
    let e: i64 = (*c).cg_arm_phe;
    if (*c).cg_arm_ph < 0 {
        false
    } else if e - s != len(*q) {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < e - s {
            if (*c).arwkn[s + i] != (*q)[i] { ok = false; 0 } else { 0 };
            i = i + 1;
        }
        ok
    }
}

// (ADR 0075 D6 / A1) drain the arm-remainder worklist: one `define` per class (R) bubble
// in the enclosing source definition, emitted after its LAST define. Called after every
// definition that can hold a `handle` -- a fn (`type_fn`, for each mono instance too, all of
// an effecting fn's frames together) and a class init / class method / impl method --
// because a method is its own define and its resumers belong after IT, in the same buffer
// (`cgcls`), not after some later fn. The text oracle buffers each resumer and emits it
// after the definition's last define as well, so the two agree on ORDER without either
// side sorting.
//
// The remainder's names are resolved against the scope stack as it stands at drain time.
// A name the arm bound itself has been truncated away by then, and a later entry can find
// an earlier entry's local under a captured name, so such a remainder fails here or at
// `llc` (register D101).
//
// Each resumer is the two-define shape `cg_embed_emit` already uses for an embedded
// perform: `cg_reset`, bind `%arg0` to a fresh slot, load each capture off `%arg1`, lower
// the remainder with the placeholder armed, wrap in `sentinel_kont_pure`, then assemble the
// header. The lowering re-parses the arm body from the token stream, as the classification
// did -- `Expr` is consumed by its walk, so every question about an arm gets its own copy.
//
// Three things this has to get right that the first version did not, each of which it got
// wrong on a program the corpus never contained:
//
//   - `pcurfn` is the PARENT's `curfn`, set for the duration of the lowering. `record_move`
//     does nothing while `curfn < 0`, and `type_fn` has already reset it to -1 by the time
//     it drains, so none of a fn's remainder's own moves were recorded, and the resumer's
//     scope-exit drops disagreed with the oracle's and inkwell's for any value such a
//     remainder moves. The remainder IS part of the parent's body, so its moves belong in
//     the parent's set, which is what the oracle and inkwell look up. (The init and method
//     paths drain before they restore `curfn`, so there it already holds the method's key;
//     passing it keeps the paths alike.)
//   - A METHOD's resumer is written to `cgcls` (`cg_to_cls`; `cg_reset` clears it, so it is
//     set again afterwards), and the body goes out through `cg_putc` rather than
//     `cg_flush_allocas_body`, whose body copy is hard-wired to `cgout`.
//   - Under `cg_mute` (the mono DISCOVERY pass) nothing is emitted and nothing is taken
//     back. The blank-line pop below used to run regardless, so a muted drain deleted a
//     real byte from whichever define was last written to `cgout`, and its replacement was
//     muted.
//
// The resumer runs OUTSIDE the arm: no `k`, no enclosing `handle`, which is exactly why the
// shared Rust verdict refuses a remainder that resumes again or leaves the arm.
// `cg_ar_classify` does not yet refuse one that leaves the arm, that suspends, or whose
// `k(v)` or value is not an `i64` / `secret i64` (register D106).
fn cg_ar_drain(c: &mut TyCtx, src: &[u8], pcurfn: i64, gb: &mut Vec<u8>) -> i64 {
    let n: i64 = len((*c).arwb);
    let to_cls: bool = (*c).cg_pkind == 1;
    let muted: bool = (*c).cg_mute;
    // The enclosing define was written with the blank line that separates it from the next
    // one already appended. These resumers belong BEFORE that separator: the oracle closes
    // the parent with `}\n`, flushes `extra_defines` immediately after, and the blank between
    // defines comes later. So take the separator back -- from the buffer the parent went to --
    // and re-emit it once the last resumer is out.
    if n > 0 && !muted {
        if to_cls {
            let mc: i64 = len((*c).cgcls);
            if mc > 0 {
                if (*c).cgcls[mc - 1] == '\n' {
                    let _sepc: u8 = pop(&mut (*c).cgcls);
                    0
                } else {
                    0
                }
            } else {
                0
            }
        } else {
            let mo: i64 = len((*c).cgout);
            if mo > 0 {
                if (*c).cgout[mo - 1] == '\n' {
                    let _sepo: u8 = pop(&mut (*c).cgout);
                    0
                } else {
                    0
                }
            } else {
                0
            }
        }
    } else {
        0
    };
    let svcf: i64 = (*c).curfn;
    let mut i: i64 = 0;
    while i < n && !muted {
        let btok: i64 = (*c).arwb[i];
        let seq: i64 = (*c).arwq[i];
        let _kvid: i64 = (*c).arwk[i];
        let kns: i64 = (*c).arwks[i];
        let kne: i64 = (*c).arwke[i];
        let cs: i64 = (*c).arwcs[i];
        let cn: i64 = (*c).arwcn[i];
        cg_reset(c);
        (*c).curfn = pcurfn;
        let ph: i64 = cg_alloca(c, 0);
        cgo_str(c, "  store i64 %arg0, ptr %v");
        cgo_int(c, ph);
        cg_putc(c, '\n');
        let mut j: i64 = 0;
        while j < cn {
            let gp: i64 = cg_dst(c);
            cgo_str(c, "getelementptr i8, ptr %arg1, i64 ");
            cgo_int(c, j * 8);
            cg_putc(c, '\n');
            let ld: i64 = cg_dst(c);
            cgo_str(c, "load i64, ptr %v");
            cgo_int(c, gp);
            cg_putc(c, '\n');
            let slot: i64 = cg_alloca(c, 0);
            cgo_str(c, "  store i64 %v");
            cgo_int(c, ld);
            cgo_str(c, ", ptr %v");
            cgo_int(c, slot);
            cg_putc(c, '\n');
            cg_slot_set(c, (*c).arwc[cs + j], slot);
            j = j + 1;
        }
        (*c).cg_arm_ph = ph;
        (*c).cg_arm_phs = kns;
        (*c).cg_arm_phe = kne;
        let mut cur: i64 = btok;
        let rb: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut cur);
        let mut rbuf: Vec<u8> = vec_new();
        let _rrt: i64 = dump_texpr(&mut rbuf, rb, 0 - 1, src, c, gb);
        let _rbx: [u8] = vec_to_array(rbuf);
        (*c).cg_arm_ph = 0 - 1;
        (*c).cg_arm_phs = 0 - 1;
        (*c).cg_arm_phe = 0 - 1;
        let rk: i64 = (*c).cglk;
        let rv: i64 = (*c).cglv;
        let kp: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
        cgo_operand(c, rk, rv);
        cgo_str(c, ")\n");
        (*c).cg_used_kontpure = true;
        (*c).cg_to_body = false;
        (*c).cg_to_cls = to_cls;
        cgo_str(c, "define ptr @__armrem_");
        cg_emit_psym(c, src);
        cg_putc(c, '_');
        cgo_int(c, seq);
        cgo_str(c, "(i64 %arg0, ptr %arg1) {\nentry:\n");
        // The allocas, then the buffered body -- both through `cg_putc`, so a method's
        // resumer lands in `cgcls` beside its method rather than split across two buffers.
        let na: i64 = len((*c).cgalloca_sl);
        let mut ai: i64 = 0;
        while ai < na {
            let asl: i64 = (*c).cgalloca_sl[ai];
            let aty: i64 = (*c).cgalloca_ty[ai];
            cgo_str(c, "  %v");
            cgo_int(c, asl);
            cgo_str(c, " = alloca ");
            cgo_alloca_ty(c, aty);
            cg_putc(c, '\n');
            ai = ai + 1;
        }
        let nb: i64 = len((*c).cgbody);
        let mut bi: i64 = 0;
        while bi < nb {
            let byte: u8 = (*c).cgbody[bi];
            cg_putc(c, byte);
            bi = bi + 1;
        }
        cgo_str(c, "  ret ptr %v");
        cgo_int(c, kp);
        cgo_str(c, "\n}\n\n");
        i = i + 1;
    }
    (*c).curfn = svcf;
    if n > 0 && !muted {
        (*c).cg_to_body = false;
        (*c).cg_to_cls = to_cls;
        cg_putc(c, '\n');
        0
    } else {
        0
    };
    (*c).cg_to_cls = false;
    // The worklist is per SOURCE definition: the next one starts its sequence at 0, as the
    // oracle's `armrem_seq` does (carried across an effecting fn's frames, which this
    // drains together).
    clear_i64(&mut (*c).arwb);
    clear_i64(&mut (*c).arwq);
    clear_i64(&mut (*c).arwk);
    clear_i64(&mut (*c).arwks);
    clear_i64(&mut (*c).arwke);
    clear_u8(&mut (*c).arwkn);
    clear_i64(&mut (*c).arwcs);
    clear_i64(&mut (*c).arwcn);
    clear_i64(&mut (*c).arwc);
    (*c).cg_armseq = 0;
    0
}

// ===== (ADR 0075 D6 / register D87) where an arm's `k(v)` sits =====
//
// A bubbling `k(v)` branches back to the dispatch loop, so the rest of the arm does not
// run. ADR 0020 D3 says `k(v)` IS `handle (kont.resume v) with H`, so the arm's remainder
// belongs inside that inner dispatch; abandoning it is right only when there is nothing to
// abandon (the arm's value IS the resume's) or when the arm returns first.
//
// These walk a DISPOSABLE classification copy of the arm body, re-parsed from the token
// index the parser stashes (`cg_h_btok`) — move semantics bar inspecting the copy that is
// lowered, exactly as `cg_apply_return_arm` re-parses the return arm. Mirrors
// `sentinel-codegen`'s `arm_resume_class`, which inkwell and the text oracle SHARE.
//
// ⚠ The one thing that cannot be mirrored directly is how a resume is IDENTIFIED. Those two
// key on the arm's kont `VarId`; here the tree is still syntax, so a resume is a call to
// the arm's kont NAME — and a `handle` written inside this arm whose own kont has the SAME
// name shadows ours, so the walk stops at that arm. Without it,
// `handle … with { Io.read(k) => { handle … with { Io.read(k) => k(1) }; k(2) } }` counts
// the inner arm's resume as this arm's. (An inner arm with a DIFFERENT name may still hold
// a `k(v)` of ours — register D81's shape — and that one counts.)

// (ADR 0075 D6) how many times this arm resumes ITS OWN kont, named `kn`.
fn cg_ar_count(e: Expr, kn: &[u8]) -> i64 {
    match e {
        Expr::Call(cn, ca) => {
            let hit: i64 = if name_eq_lit(kn, cn) { 1 } else { 0 };
            hit + cg_ar_count_args(ca, kn)
        },
        Expr::Unary(uo, ui) => {
            let _u: i64 = uo;
            cg_ar_count(ui, kn)
        },
        Expr::Binary(bo, bl, br) => {
            let _b: i64 = bo;
            cg_ar_count(bl, kn) + cg_ar_count(br, kn)
        },
        Expr::Method(mt, mn, ma) => {
            let _m: [u8] = mn;
            cg_ar_count(mt, kn) + cg_ar_count_args(ma, kn)
        },
        Expr::Field(ft, fnm) => {
            let _f: [u8] = fnm;
            cg_ar_count(ft, kn)
        },
        Expr::Index(it, ix) => cg_ar_count(it, kn) + cg_ar_count(ix, kn),
        Expr::Qcall(qm, qn, qa) => {
            let _q1: [u8] = qm;
            let _q2: [u8] = qn;
            cg_ar_count_args(qa, kn)
        },
        Expr::ClassInit(cin, cia) => {
            let _c: [u8] = cin;
            cg_ar_count_args(cia, kn)
        },
        Expr::Array(aa) => cg_ar_count_args(aa, kn),
        Expr::If(ic, it2, ie) => {
            cg_ar_count(ic, kn) + cg_ar_count(it2, kn) + cg_ar_count(ie, kn)
        },
        Expr::Block(bs, bt) => cg_ar_count_stmts(bs, kn) + cg_ar_count(bt, kn),
        Expr::Match(ms, mr) => cg_ar_count(ms, kn) + cg_ar_count_arms(mr, kn),
        Expr::StructLit(sn, sf) => {
            let _s: [u8] = sn;
            cg_ar_count_fields(sf, kn)
        },
        Expr::Declassify(di) => cg_ar_count(di, kn),
        Expr::Return(ri) => cg_ar_count(ri, kn),
        Expr::Cast(ce, ct) => {
            let _c: [u8] = ct;
            cg_ar_count(ce, kn)
        },
        Expr::Perform(pe, po, pa) => {
            let _p1: [u8] = pe;
            let _p2: [u8] = po;
            cg_ar_count_args(pa, kn)
        },
        Expr::Scope(si) => cg_ar_count(si, kn),
        Expr::Spawn(spi) => cg_ar_count(spi, kn),
        Expr::Await(awi) => cg_ar_count(awi, kn),
        Expr::Handle(hb, ha, hr) => {
            let _r: Ret = hr;
            cg_ar_count(hb, kn) + cg_ar_count_harms(ha, kn)
        },
        Expr::Int(iv) => {
            let _i: i64 = iv;
            0
        },
        Expr::Float(fv) => {
            let _f: [u8] = fv;
            0
        },
        Expr::Bool(bv) => {
            let _b: bool = bv;
            0
        },
        Expr::Null => 0,
        Expr::Char(cv) => {
            let _c: i64 = cv;
            0
        },
        Expr::Str(sv) => {
            let _s: [u8] = sv;
            0
        },
        Expr::Var(vv) => {
            let _v: [u8] = vv;
            0
        },
        Expr::SynthZero => 0,
    }
}

fn cg_ar_count_args(a: Args, kn: &[u8]) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(ae, ar) => cg_ar_count(ae, kn) + cg_ar_count_args(ar, kn),
    }
}

fn cg_ar_count_fields(f: Fields, kn: &[u8]) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fe, fr) => {
            let _f: [u8] = fnm;
            cg_ar_count(fe, kn) + cg_ar_count_fields(fr, kn)
        },
    }
}

fn cg_ar_count_arms(m: Arms, kn: &[u8]) -> i64 {
    match m {
        Arms::ArmEnd => 0,
        Arms::ArmCell(mp, me, mr) => {
            let _p: Pattern = mp;
            cg_ar_count(me, kn) + cg_ar_count_arms(mr, kn)
        },
    }
}

fn cg_ar_count_stmts(st: Stmts, kn: &[u8]) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(s1, sr) => {
            let one: i64 = match s1 {
                Stmt::SLet(lm, ln, lt, le) => {
                    let _m: bool = lm;
                    let _n: [u8] = ln;
                    let _t: TyOpt = lt;
                    cg_ar_count(le, kn)
                },
                Stmt::SAssign(at, av) => cg_ar_count(at, kn) + cg_ar_count(av, kn),
                Stmt::SWhile(wc, wb) => cg_ar_count(wc, kn) + cg_ar_count(wb, kn),
                Stmt::SBreak => 0,
                Stmt::SContinue => 0,
                Stmt::SExpr(se) => cg_ar_count(se, kn),
            };
            one + cg_ar_count_stmts(sr, kn)
        },
    }
}

// (ADR 0075 D6) the arms of a `handle` written INSIDE this arm. One whose own kont is
// spelled `kn` shadows ours, so nothing in it is this arm's resume.
fn cg_ar_count_harms(h: HArms, kn: &[u8]) -> i64 {
    match h {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hp, hb, hbt, hr) => {
            let _e: [u8] = hef;
            let _o: [u8] = hop;
            let _t: i64 = hbt;
            let shadowed: bool = name_eq_lit(kn, cg_binds_last(hp));
            let inner: i64 = if shadowed {
                let _b: Expr = hb;
                0
            } else {
                cg_ar_count(hb, kn)
            };
            inner + cg_ar_count_harms(hr, kn)
        },
    }
}

// (ADR 0075 D6) collect, into `(*c).arcaps`, the VarIds the arm's REMAINDER reads from the
// frame around it — the `i64[N]` capture struct's layout, in first-read order. Pre-order
// and deduped, mirroring `sentinel-codegen`'s `walk_collect_var_refs` over the substituted
// remainder; the resume CALL is skipped whole, name and arguments, because the remainder
// the oracle builds has the placeholder there instead and filters it out.
//
// A name the remainder binds ITSELF is not yet in scope when this runs (the arm body has
// not been lowered), so `sc_lookup` answers -1 and it is a local rather than a capture —
// which is exactly what the oracle's `ty_of` answering `None` means there.
fn cg_ar_caps(c: &mut TyCtx, e: Expr, kn: &[u8]) -> i64 {
    match e {
        Expr::Var(vv) => {
            let vid: i64 = sc_lookup(c, &vv);
            let _v: [u8] = vv;
            if vid >= 0 {
                if cg_arcaps_has(c, vid) { 0 } else { push(&mut (*c).arcaps, vid); 0 }
            } else {
                0
            }
        },
        Expr::Call(cn, ca) => {
            let hit: bool = name_eq_lit(kn, cn);
            if hit {
                let _a: Args = ca;
                0
            } else {
                cg_ar_caps_args(c, ca, kn)
            }
        },
        Expr::Unary(uo, ui) => { let _u: i64 = uo; cg_ar_caps(c, ui, kn) },
        Expr::Cast(ce, ct) => { let _t: [u8] = ct; cg_ar_caps(c, ce, kn) },
        Expr::Declassify(di) => cg_ar_caps(c, di, kn),
        Expr::Return(ri) => cg_ar_caps(c, ri, kn),
        Expr::Field(ft, fnm) => { let _f: [u8] = fnm; cg_ar_caps(c, ft, kn) },
        Expr::Binary(bo, bl, br) => {
            let _b: i64 = bo;
            cg_ar_caps(c, bl, kn) + cg_ar_caps(c, br, kn)
        },
        Expr::Index(it, ix) => cg_ar_caps(c, it, kn) + cg_ar_caps(c, ix, kn),
        Expr::Method(mt, mn, ma) => {
            let _m: [u8] = mn;
            cg_ar_caps(c, mt, kn) + cg_ar_caps_args(c, ma, kn)
        },
        Expr::Qcall(qm, qn, qa) => {
            let _q1: [u8] = qm;
            let _q2: [u8] = qn;
            cg_ar_caps_args(c, qa, kn)
        },
        Expr::ClassInit(cin, cia) => { let _c: [u8] = cin; cg_ar_caps_args(c, cia, kn) },
        Expr::Array(aa) => cg_ar_caps_args(c, aa, kn),
        // (ADR 0075 D6 / register D95) the capture ORDER is the `i64[N]` frame's layout,
        // and the oracle collects it from the TYPED tree, whose struct-literal fields are
        // in declaration order. Order this copy the same way or the two frames disagree.
        Expr::StructLit(sn, sf) => {
            let scsid: i64 = struct_lookup(c, &sn);
            let scord: Fields = sort_fields(c, scsid, sf);
            cg_ar_caps_fields(c, scord, kn)
        },
        Expr::Block(bs, bt) => cg_ar_caps_stmts(c, bs, kn) + cg_ar_caps(c, bt, kn),
        Expr::If(ic, it2, ie) => {
            cg_ar_caps(c, ic, kn) + cg_ar_caps(c, it2, kn) + cg_ar_caps(c, ie, kn)
        },
        Expr::Match(ms, mr) => cg_ar_caps(c, ms, kn) + cg_ar_caps_arms(c, mr, kn),
        Expr::Scope(si) => cg_ar_caps(c, si, kn),
        Expr::Spawn(spi) => cg_ar_caps(c, spi, kn),
        Expr::Await(awi) => cg_ar_caps(c, awi, kn),
        Expr::Perform(pe, po, pa) => {
            let _p1: [u8] = pe;
            let _p2: [u8] = po;
            cg_ar_caps_args(c, pa, kn)
        },
        Expr::Handle(hb, ha, hr) => {
            let _r: Ret = hr;
            cg_ar_caps(c, hb, kn) + cg_ar_caps_harms(c, ha, kn)
        },
        _ => { let _o: Expr = e; 0 },
    }
}

fn cg_arcaps_has(c: &mut TyCtx, vid: i64) -> bool {
    let n: i64 = len((*c).arcaps);
    let base: i64 = (*c).cg_h_cbase;
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        if i >= base {
            if (*c).arcaps[i] == vid { found = true; 0 } else { 0 };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

fn cg_ar_caps_args(c: &mut TyCtx, a: Args, kn: &[u8]) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(ae, ar) => cg_ar_caps(c, ae, kn) + cg_ar_caps_args(c, ar, kn),
    }
}

fn cg_ar_caps_fields(c: &mut TyCtx, f: Fields, kn: &[u8]) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fe, fr) => {
            let _f: [u8] = fnm;
            cg_ar_caps(c, fe, kn) + cg_ar_caps_fields(c, fr, kn)
        },
    }
}

fn cg_ar_caps_arms(c: &mut TyCtx, m: Arms, kn: &[u8]) -> i64 {
    match m {
        Arms::ArmEnd => 0,
        Arms::ArmCell(mp, me, mr) => {
            let _p: Pattern = mp;
            cg_ar_caps(c, me, kn) + cg_ar_caps_arms(c, mr, kn)
        },
    }
}

fn cg_ar_caps_harms(c: &mut TyCtx, h: HArms, kn: &[u8]) -> i64 {
    match h {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hp, hb, hbt, hr) => {
            let _e: [u8] = hef;
            let _o: [u8] = hop;
            let _t: i64 = hbt;
            let _p: Binds = hp;
            cg_ar_caps(c, hb, kn) + cg_ar_caps_harms(c, hr, kn)
        },
    }
}

fn cg_ar_caps_stmts(c: &mut TyCtx, st: Stmts, kn: &[u8]) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(s1, sr) => {
            let one: i64 = match s1 {
                Stmt::SLet(lm, ln, lt, le) => {
                    let _m: bool = lm;
                    let _n: [u8] = ln;
                    let _t: TyOpt = lt;
                    cg_ar_caps(c, le, kn)
                },
                Stmt::SAssign(at, av) => cg_ar_caps(c, at, kn) + cg_ar_caps(c, av, kn),
                Stmt::SWhile(wc, wb) => cg_ar_caps(c, wc, kn) + cg_ar_caps(c, wb, kn),
                Stmt::SBreak => 0,
                Stmt::SContinue => 0,
                Stmt::SExpr(se) => cg_ar_caps(c, se, kn),
            };
            one + cg_ar_caps_stmts(c, sr, kn)
        },
    }
}

// (ADR 0075 D6) what the arm evaluates BEFORE its `k(v)`. The remainder is replayed from
// the top of the arm, so everything ahead of the resume runs a second time; (R) requires
// that everything ahead of it be a literal or a name, which cannot be observed twice.
//
// Deliberately narrower than "pure": the faithful rule asks an operator-level purity
// question (division traps, `&mut` and a deref are impure, the rest are not), and
// mirroring THAT here means mirroring an operator TABLE into a second implementation,
// where one wrong constant is a silent classification divergence no corpus program can
// catch. A rule with no operator in it cannot drift. Mirrors `sentinel-codegen`'s
// `resume_prefix`, which inkwell and the text oracle share.
//
//   0 = no resume here, and this subtree IS a literal or a name (it may precede one)
//   1 = the resume is here, and everything before it was 0
//   2 = a resume is here with something else evaluated first
//   3 = no resume here, and this subtree is NOT a literal or a name
fn cg_ar_pre(e: Expr, kn: &[u8]) -> i64 {
    match e {
        Expr::Call(cn, ca) => {
            let hit: bool = name_eq_lit(kn, cn);
            if hit {
                let _a: Args = ca;
                1
            } else {
                cg_ar_pre_args(ca, kn, 0)
            }
        },
        Expr::Int(iv) => { let _i: i64 = iv; 0 },
        Expr::Float(fv) => { let _f: [u8] = fv; 0 },
        Expr::Bool(bv) => { let _b: bool = bv; 0 },
        Expr::Null => 0,
        Expr::Char(cv) => { let _c: i64 = cv; 0 },
        Expr::Str(sv) => { let _s: [u8] = sv; 0 },
        Expr::Var(vv) => { let _v: [u8] = vv; 0 },
        Expr::SynthZero => 0,
        Expr::Unary(uo, ui) => {
            let _u: i64 = uo;
            cg_ar_pre_wrap(cg_ar_pre(ui, kn))
        },
        Expr::Cast(ce, ct) => {
            let _t: [u8] = ct;
            cg_ar_pre_wrap(cg_ar_pre(ce, kn))
        },
        Expr::Declassify(di) => cg_ar_pre_wrap(cg_ar_pre(di, kn)),
        Expr::Return(ri) => cg_ar_pre_wrap(cg_ar_pre(ri, kn)),
        Expr::Field(ft, fnm) => {
            let _f: [u8] = fnm;
            cg_ar_pre_wrap(cg_ar_pre(ft, kn))
        },
        Expr::Binary(bo, bl, br) => {
            let _b: i64 = bo;
            cg_ar_pre_wrap(cg_ar_pre_two(bl, br, kn))
        },
        Expr::Index(it, ix) => cg_ar_pre_wrap(cg_ar_pre_two(it, ix, kn)),
        Expr::Qcall(qm, qn, qa) => {
            let _q1: [u8] = qm;
            let _q2: [u8] = qn;
            cg_ar_pre_args(qa, kn, 0)
        },
        Expr::ClassInit(cin, cia) => {
            let _c: [u8] = cin;
            cg_ar_pre_args(cia, kn, 0)
        },
        Expr::Array(aa) => cg_ar_pre_args(aa, kn, 0),
        // (ADR 0075 D6 / register D95) a resume INSIDE a struct literal is out of reach,
        // like one inside a branch. It could be reasoned about — a literal does evaluate
        // its fields in a straight line — but only in DECLARATION order, which this walk
        // reads off raw tokens in SOURCE order, with no struct id here to reorder by.
        // Refusing it keeps all three back ends on one answer without that thread, and
        // the refusal is the safe direction: class (A) aborts where a wrong guess would
        // answer wrongly. A literal with NO resume in it already answered 3 here (the
        // old field walk bottomed out at `FieldEnd => 3`), so nothing else moves.
        Expr::StructLit(sn, sf) => {
            let _s: [u8] = sn;
            if cg_ar_count_fields(sf, kn) > 0 { 2 } else { 3 }
        },
        Expr::Method(mt, mn, ma) => {
            let _m: [u8] = mn;
            let t: i64 = cg_ar_pre(mt, kn);
            if t == 1 {
                let _a2: Args = ma;
                1
            } else {
                if t == 2 {
                    let _a3: Args = ma;
                    2
                } else {
                    let seen: i64 = if t == 3 { 1 } else { 0 };
                    cg_ar_pre_args(ma, kn, seen)
                }
            }
        },
        Expr::Block(bs, bt) => cg_ar_pre_block(bs, bt, kn),
        // A branch, a loop, a nested handle or a concurrency form does not put its parts
        // in one straight line. `cg_ar_uncond` already refuses a resume inside one; this
        // agrees rather than reasoning about it a second way.
        _ => {
            if cg_ar_count(e, kn) > 0 { 2 } else { 3 }
        },
    }
}

// A wrapper node is never itself a literal or a name.
fn cg_ar_pre_wrap(w: i64) -> i64 {
    if w == 0 { 3 } else { w }
}

fn cg_ar_pre_two(a: Expr, b: Expr, kn: &[u8]) -> i64 {
    let x: i64 = cg_ar_pre(a, kn);
    if x == 1 {
        let _b: Expr = b;
        1
    } else {
        if x == 2 {
            let _b2: Expr = b;
            2
        } else {
            let y: i64 = cg_ar_pre(b, kn);
            if y == 1 {
                if x == 3 { 2 } else { 1 }
            } else {
                if y == 2 { 2 } else { 3 }
            }
        }
    }
}

// `seen` is 1 once something not-a-literal-or-name has been evaluated in this sequence.
fn cg_ar_pre_args(a: Args, kn: &[u8], seen: i64) -> i64 {
    match a {
        Args::End => 3,
        Args::Cell(ae, ar) => {
            let w: i64 = cg_ar_pre(ae, kn);
            if w == 1 {
                let _r: Args = ar;
                if seen == 1 { 2 } else { 1 }
            } else {
                if w == 2 {
                    let _r2: Args = ar;
                    2
                } else {
                    let ns: i64 = if w == 3 { 1 } else { seen };
                    cg_ar_pre_args(ar, kn, ns)
                }
            }
        },
    }
}

// A block evaluates each statement's value in order, then its tail.
fn cg_ar_pre_block(bs: Stmts, bt: Expr, kn: &[u8]) -> i64 {
    let st: i64 = cg_ar_pre_stmts(bs, kn, 0);
    if st == 1 {
        let _t: Expr = bt;
        1
    } else {
        if st == 2 {
            let _t2: Expr = bt;
            2
        } else {
            let tl: i64 = cg_ar_pre(bt, kn);
            if tl == 1 {
                if st == 4 { 2 } else { 1 }
            } else {
                if tl == 2 { 2 } else { 3 }
            }
        }
    }
}

// 0 = every statement so far was a literal/name value; 4 = something opaque ran; the
// 1 / 2 answers settle the block immediately.
fn cg_ar_pre_stmts(st: Stmts, kn: &[u8], seen: i64) -> i64 {
    match st {
        Stmts::SEnd => seen,
        Stmts::SCell(s1, sr) => {
            let one: i64 = match s1 {
                Stmt::SLet(lm, ln, lt, le) => {
                    let _m: bool = lm;
                    let _n: [u8] = ln;
                    let _t: TyOpt = lt;
                    cg_ar_pre(le, kn)
                },
                // The write itself is observable, so a resume after it is blocked.
                Stmt::SAssign(at, av) => {
                    let t: i64 = cg_ar_pre(at, kn);
                    if t == 1 {
                        let _v: Expr = av;
                        1
                    } else {
                        if t == 2 {
                            let _v2: Expr = av;
                            2
                        } else {
                            let v: i64 = cg_ar_pre(av, kn);
                            if v == 1 { 2 } else { if v == 2 { 2 } else { 3 } }
                        }
                    }
                },
                Stmt::SWhile(wc, wb) => {
                    let c: i64 = cg_ar_count(wc, kn);
                    let b: i64 = cg_ar_count(wb, kn);
                    if c + b > 0 { 2 } else { 3 }
                },
                Stmt::SBreak => 3,
                Stmt::SContinue => 3,
                Stmt::SExpr(se) => cg_ar_pre_wrap(cg_ar_pre(se, kn)),
            };
            if one == 1 {
                let _r: Stmts = sr;
                if seen == 4 { 2 } else { 1 }
            } else {
                if one == 2 {
                    let _r2: Stmts = sr;
                    2
                } else {
                    let ns: i64 = if one == 3 { 4 } else { seen };
                    cg_ar_pre_stmts(sr, kn, ns)
                }
            }
        },
    }
}

// (ADR 0075 D6) is the arm's `k(v)` reached UNCONDITIONALLY, on every path through the
// arm? Hoisted out of an `if` or `match` arm, the right of `&&` or `||`, a loop, a nested
// `handle` or a concurrency form, it runs on paths the replay would not take, so the
// replay is not the same computation and the arm is class (A).
//
// Tri-state, mirroring `sentinel-codegen`'s `susp_unconditional` (an `Option<bool>`):
//   0 = no resume under here at all        (Rust `None`)
//   1 = reached unconditionally            (Rust `Some(true)`)
//   2 = held conditionally                 (Rust `Some(false)`)
// The first non-zero answer in evaluation order wins, exactly as `find_map` does there.
fn cg_ar_uncond(e: Expr, kn: &[u8]) -> i64 {
    match e {
        Expr::Call(cn, ca) => {
            // The suspension point itself is reached right here; any OTHER call's
            // arguments are walked in order.
            let hit: bool = name_eq_lit(kn, cn);
            if hit {
                let _a: Args = ca;
                1
            } else {
                cg_ar_unc_args(ca, kn)
            }
        },
        Expr::Unary(uo, ui) => {
            let _u: i64 = uo;
            cg_ar_uncond(ui, kn)
        },
        Expr::Cast(ce, ct) => {
            let _t: [u8] = ct;
            cg_ar_uncond(ce, kn)
        },
        Expr::Declassify(di) => cg_ar_uncond(di, kn),
        Expr::Return(ri) => cg_ar_uncond(ri, kn),
        Expr::Binary(bo, bl, br) => {
            // `&&` / `||` do not evaluate their right operand on every path.
            if bo == 14 {
                cg_ar_unc_logic(bl, br, kn)
            } else {
                if bo == 15 {
                    cg_ar_unc_logic(bl, br, kn)
                } else {
                    let l: i64 = cg_ar_uncond(bl, kn);
                    let r: i64 = cg_ar_uncond(br, kn);
                    if l != 0 { l } else { r }
                }
            }
        },
        Expr::Method(mt, mn, ma) => {
            let _m: [u8] = mn;
            let t: i64 = cg_ar_uncond(mt, kn);
            let a: i64 = cg_ar_unc_args(ma, kn);
            if t != 0 { t } else { a }
        },
        Expr::Field(ft, fnm) => {
            let _f: [u8] = fnm;
            cg_ar_uncond(ft, kn)
        },
        Expr::Index(it, ix) => {
            let t: i64 = cg_ar_uncond(it, kn);
            let x: i64 = cg_ar_uncond(ix, kn);
            if t != 0 { t } else { x }
        },
        Expr::Qcall(qm, qn, qa) => {
            let _q1: [u8] = qm;
            let _q2: [u8] = qn;
            cg_ar_unc_args(qa, kn)
        },
        Expr::ClassInit(cin, cia) => {
            let _c: [u8] = cin;
            cg_ar_unc_args(cia, kn)
        },
        Expr::Array(aa) => cg_ar_unc_args(aa, kn),
        Expr::StructLit(sn, sf) => {
            let _s: [u8] = sn;
            cg_ar_unc_fields(sf, kn)
        },
        Expr::Block(bs, bt) => {
            let st: i64 = cg_ar_unc_stmts(bs, kn);
            let tl: i64 = cg_ar_uncond(bt, kn);
            if st != 0 { st } else { tl }
        },
        Expr::Scope(si) => {
            // A scope's body is walked for a resume but never reached unconditionally
            // from outside it, which is the Rust arm's `(block_susp > 0).then_some(false)`.
            if cg_ar_count(si, kn) > 0 { 2 } else { 0 }
        },
        Expr::If(ic, it2, ie) => {
            let c: i64 = cg_ar_uncond(ic, kn);
            let t: i64 = cg_ar_count(it2, kn);
            let f: i64 = cg_ar_count(ie, kn);
            if c != 0 {
                c
            } else {
                if t > 0 { 2 } else { if f > 0 { 2 } else { 0 } }
            }
        },
        Expr::Match(ms, mr) => {
            let sc: i64 = cg_ar_uncond(ms, kn);
            let ar: i64 = cg_ar_count_arms(mr, kn);
            if sc != 0 { sc } else { if ar > 0 { 2 } else { 0 } }
        },
        Expr::Handle(hb, ha, hr) => {
            let _r: Ret = hr;
            let b: i64 = cg_ar_count(hb, kn);
            let a: i64 = cg_ar_count_harms(ha, kn);
            if b + a > 0 { 2 } else { 0 }
        },
        Expr::Perform(pe, po, pa) => {
            let _p1: [u8] = pe;
            let _p2: [u8] = po;
            if cg_ar_count_args(pa, kn) > 0 { 2 } else { 0 }
        },
        Expr::Spawn(spi) => {
            if cg_ar_count(spi, kn) > 0 { 2 } else { 0 }
        },
        Expr::Await(awi) => {
            if cg_ar_count(awi, kn) > 0 { 2 } else { 0 }
        },
        _ => {
            let _o: Expr = e;
            0
        },
    }
}

// `&&` / `||`: the left runs always, the right only sometimes.
fn cg_ar_unc_logic(bl: Expr, br: Expr, kn: &[u8]) -> i64 {
    let l: i64 = cg_ar_uncond(bl, kn);
    let r: i64 = cg_ar_count(br, kn);
    if l != 0 { l } else { if r > 0 { 2 } else { 0 } }
}

fn cg_ar_unc_args(a: Args, kn: &[u8]) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(ae, ar) => {
            let first: i64 = cg_ar_uncond(ae, kn);
            let rest: i64 = cg_ar_unc_args(ar, kn);
            if first != 0 { first } else { rest }
        },
    }
}

fn cg_ar_unc_fields(f: Fields, kn: &[u8]) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fe, fr) => {
            let _f: [u8] = fnm;
            let first: i64 = cg_ar_uncond(fe, kn);
            let rest: i64 = cg_ar_unc_fields(fr, kn);
            if first != 0 { first } else { rest }
        },
    }
}

fn cg_ar_unc_stmts(st: Stmts, kn: &[u8]) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(s1, sr) => {
            let one: i64 = match s1 {
                Stmt::SLet(lm, ln, lt, le) => {
                    let _m: bool = lm;
                    let _n: [u8] = ln;
                    let _t: TyOpt = lt;
                    cg_ar_uncond(le, kn)
                },
                Stmt::SAssign(at, av) => {
                    let t: i64 = cg_ar_uncond(at, kn);
                    let v: i64 = cg_ar_uncond(av, kn);
                    if t != 0 { t } else { v }
                },
                // A loop's body may run any number of times, its condition more than once.
                Stmt::SWhile(wc, wb) => {
                    let c: i64 = cg_ar_count(wc, kn);
                    let b: i64 = cg_ar_count(wb, kn);
                    if c + b > 0 { 2 } else { 0 }
                },
                Stmt::SBreak => 0,
                Stmt::SContinue => 0,
                Stmt::SExpr(se) => cg_ar_uncond(se, kn),
            };
            let rest: i64 = cg_ar_unc_stmts(sr, kn);
            if one != 0 { one } else { rest }
        },
    }
}

// (ADR 0075 D6) is this arm's VALUE a `k(v)`'s value? Walks TAIL positions only — a
// block's tail, an `if` branch's tail, a `match` arm's tail — so it answers "does the arm
// evaluate TO the resume", not "does it contain one". A `return`'s operand is NOT a tail
// position: the arm's value is not the `return`'s, which is why that case is Diverging.
// Mirrors `sentinel-codegen`'s `resume_in_tail_position`.
fn cg_ar_tail(e: Expr, kn: &[u8]) -> bool {
    match e {
        Expr::Call(cn, ca) => {
            let _a: Args = ca;
            name_eq_lit(kn, cn)
        },
        Expr::Block(bs, bt) => {
            let _s: Stmts = bs;
            cg_ar_tail(bt, kn)
        },
        Expr::Scope(si) => cg_ar_tail(si, kn),
        Expr::If(ic, it2, ie) => {
            let _c: Expr = ic;
            // Both branches are walked; `||` would short-circuit and leave one unconsumed.
            let a: bool = cg_ar_tail(it2, kn);
            let b: bool = cg_ar_tail(ie, kn);
            a || b
        },
        Expr::Match(ms, mr) => {
            let _s: Expr = ms;
            cg_ar_tail_arms(mr, kn)
        },
        _ => {
            let _o: Expr = e;
            false
        },
    }
}

fn cg_ar_tail_arms(m: Arms, kn: &[u8]) -> bool {
    match m {
        Arms::ArmEnd => false,
        Arms::ArmCell(mp, me, mr) => {
            let _p: Pattern = mp;
            let this: bool = cg_ar_tail(me, kn);
            let rest: bool = cg_ar_tail_arms(mr, kn);
            this || rest
        },
    }
}

// (ADR 0075 D6) does EVERY path through the arm `return`? Then the entry that re-enters it
// returns first, and the abandoned remainder is unreachable under ADR 0020 D3 as well.
// Structural and conservative, mirroring `sentinel-codegen`'s `expr_always_returns` (which
// is ADR 0065's divergence): only `return`, and a block / `if` / `match` all of whose paths
// do. A `while` may not run, and `break` / `continue` stay inside the function.
fn cg_ar_returns(e: Expr) -> bool {
    match e {
        Expr::Return(ri) => {
            let _i: Expr = ri;
            true
        },
        Expr::Block(bs, bt) => {
            let st: bool = cg_ar_ret_stmts(bs);
            let tl: bool = cg_ar_returns(bt);
            st || tl
        },
        Expr::Scope(si) => cg_ar_returns(si),
        Expr::If(ic, it2, ie) => {
            let _c: Expr = ic;
            let a: bool = cg_ar_returns(it2);
            let b: bool = cg_ar_returns(ie);
            a && b
        },
        Expr::Match(ms, mr) => {
            let _s: Expr = ms;
            cg_ar_ret_arms(mr) == 1
        },
        _ => {
            let _o: Expr = e;
            false
        },
    }
}

fn cg_ar_ret_stmts(st: Stmts) -> bool {
    match st {
        Stmts::SEnd => false,
        Stmts::SCell(s1, sr) => {
            let one: bool = match s1 {
                Stmt::SLet(lm, ln, lt, le) => {
                    let _m: bool = lm;
                    let _n: [u8] = ln;
                    let _t: TyOpt = lt;
                    cg_ar_returns(le)
                },
                Stmt::SAssign(at, av) => {
                    let _t: Expr = at;
                    cg_ar_returns(av)
                },
                Stmt::SWhile(wc, wb) => {
                    let _c: Expr = wc;
                    let _b: Expr = wb;
                    false
                },
                Stmt::SBreak => false,
                Stmt::SContinue => false,
                Stmt::SExpr(se) => cg_ar_returns(se),
            };
            let rest: bool = cg_ar_ret_stmts(sr);
            one || rest
        },
    }
}

// 2 = the list ended (vacuous), 1 = non-empty and every arm returns, 0 = some arm does not.
// An EMPTY `match` is not "all return" — `cg_ar_returns` asks for 1, so 2 answers false.
fn cg_ar_ret_arms(m: Arms) -> i64 {
    match m {
        Arms::ArmEnd => 2,
        Arms::ArmCell(mp, me, mr) => {
            let _p: Pattern = mp;
            let this: bool = cg_ar_returns(me);
            let rest: i64 = cg_ar_ret_arms(mr);
            if this {
                if rest == 0 { 0 } else { 1 }
            } else {
                0
            }
        },
    }
}

// (ADR 0075 D6) the LAST name in `b` — a handler arm's continuation binding — or `""` for
// an empty list (which a handler arm never has: the kont is always the last param). Taken
// by value because `match` needs an enum, not a reference to one.
fn cg_binds_last(b: Binds) -> [u8] {
    match b {
        Binds::BindEnd => "",
        Binds::BindCell(bn, br) => {
            let rest: [u8] = cg_binds_last(br);
            if len(rest) == 0 {
                let _r: [u8] = rest;
                bn
            } else {
                let _n: [u8] = bn;
                rest
            }
        },
    }
}

// (Bar B / effects) `k(arg)` part 1: load the kont pointer from `kid`'s slot, then CLEAR the
// slot (ADR 0074 D1) — emitted AFTER the arg is collected, as the oracle's
// `lower_resume_kont` does: an argument that leaves the arm (`k(return 5)`) must leave the
// slot owned so that exit releases the kont, and a `k(v)` nested in the argument clears the
// slot first, so this one's one-shot check (D3) sees it. The resume that follows consumes
// and frees the kont, so the arm no longer owns it. Returns the loaded-kont register.
fn cg_emit_resume_load(c: &mut TyCtx, kid: i64) -> i64 {
    let kslot: i64 = cg_slot_get(c, kid);
    let kreg: i64 = cg_dst(c);
    cgo_str(c, "load ptr, ptr %v");
    cgo_int(c, kslot);
    cg_putc(c, '\n');
    cgo_str(c, "  store ptr null, ptr %v");
    cgo_int(c, kslot);
    cg_putc(c, '\n');
    kreg
}

// (Bar B / effects c36a / ADR 0020 D4) apply the enclosing handle's `return v => body`
// arm to a pure i64 value operand (kind `vk`, val `vv`), setting the result operand in
// cglk/cglv. With no return arm (`cg_ret_on` false) this is the identity (the value
// passes through). The arm body is RE-PARSED from `cg_ret_tok0` — move semantics bar
// reusing the parsed Expr, and the body lowers INLINE at each pure-drain site (the
// dispatch pure block + each k(v) pure path) per Phase B's deep-handler re-wrap
// (`k := \v. handle (resume v) with H`). `v` binds a fresh i64 slot holding the value;
// its name is re-sliced from `cg_ret_ntok`. Mirrors the oracle's `apply_return_arm`.
fn cg_apply_return_arm(c: &mut TyCtx, vk: i64, vv: i64, src: &[u8], gb: &mut Vec<u8>) -> i64 {
    if (*c).cg_ret_on {
        let ntok: i64 = (*c).cg_ret_ntok;
        let ns: i64 = (*c).cgts[ntok];
        let ne: i64 = (*c).cgte[ntok];
        let vid: i64 = (*c).nextvid;
        (*c).nextvid = (*c).nextvid + 1;
        bind_name(c, slice_of(src, ns, ne), vid, 0);
        let slot: i64 = cg_alloca(c, 0);
        cg_slot_set(c, vid, slot);
        cgo_str(c, "  store i64 ");
        cgo_operand(c, vk, vv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        // Re-parse the body from its tokens, lower it (cg → cgbody; type-dump → throwaway).
        let tok0: i64 = (*c).cg_ret_tok0;
        let mut cur: i64 = tok0;
        let rbody: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut cur);
        let mut tb: Vec<u8> = vec_new();
        let _rr: i64 = dump_texpr(&mut tb, rbody, 0 - 1, src, c, gb);
        let _tbx: [u8] = vec_to_array(tb);
        // The result operand is now in cglk/cglv (set by the body lowering).
        0
    } else {
        (*c).cglk = vk;
        (*c).cglv = vv;
        0
    }
}

// (Bar B / concurrency / ADR 0024) record a spawn-target FnId (deduped). One
// `__spawn_wrapper_<id>` is synthesized per unique target at codegen end; the emission
// loop scans for FnId order (matching the oracle's `sort_by_key` + `dedup`).
fn cg_record_spawn(c: &mut TyCtx, fid: i64) -> i64 {
    let n: i64 = len((*c).cg_spawn_t);
    let mut i: i64 = 0;
    let mut dup: bool = false;
    while i < n {
        if (*c).cg_spawn_t[i] == fid {
            dup = true;
            0
        } else {
            0
        };
        i = i + 1;
    }
    if dup {
        0
    } else {
        push(&mut (*c).cg_spawn_t, fid);
        0
    }
}

// (Bar B / concurrency) emit a `spawn fn(args)`'s cg: pack the collected args (operands
// in cgak/cgav from `snap`) into a heap buffer (one i64 slot each, ≥8 bytes), call
// `sentinel_task_spawn(@__spawn_wrapper_<fid>, args, size)`, and (inside a scope)
// register the Task with `cg_scope`. Result operand = the Task ptr. Records `fid` for
// wrapper synthesis. Mirrors the oracle's Spawn lowering: ADR 0066 M1.2b made BOTH snc
// emitters (inkwell + `snc llvm`) collect-then-store too — evaluate every arg, THEN
// alloc the packed-args buffer, THEN store — so a non-immediate spawn arg (e.g. a
// copy-var `Channel` endpoint, whose eval emits a `load` before the alloc) is
// byte-identical across all three emitters, for any number of args.
fn cg_emit_spawn(c: &mut TyCtx, fid: i64, snap: i64, src: &[u8]) -> i64 {
    let _s: &[u8] = src;
    let n: i64 = len((*c).cgak) - snap;
    let size: i64 = if n > 0 {
        n * 8
    } else {
        8
    };
    let st: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_alloc(i64 ");
    cgo_int(c, size);
    cgo_str(c, ")\n");
    (*c).cg_used_alloc = true;
    let mut i: i64 = 0;
    while i < n {
        let ak: i64 = (*c).cgak[snap + i];
        let av: i64 = (*c).cgav[snap + i];
        let at: i64 = (*c).cgat[snap + i];
        let off: i64 = i * 8;
        let gp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %v");
        cgo_int(c, st);
        cgo_str(c, ", i64 ");
        cgo_int(c, off);
        cg_putc(c, '\n');
        // ADR 0066 M1.1: store the arg with its real type (was i64).
        cgo_str(c, "  store ");
        cgo_ty(c, at);
        cg_putc(c, ' ');
        cgo_operand(c, ak, av);
        cgo_str(c, ", ptr %v");
        cgo_int(c, gp);
        cg_putc(c, '\n');
        i = i + 1;
    }
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    let task: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_task_spawn(ptr @__spawn_wrapper_");
    cgo_int(c, fid);
    cgo_str(c, ", ptr %v");
    cgo_int(c, st);
    cgo_str(c, ", i64 ");
    cgo_int(c, size);
    cgo_str(c, ")\n");
    (*c).cg_used_taskspawn = true;
    if (*c).cg_scope >= 0 {
        cgo_str(c, "  call void @sentinel_scope_register(ptr %v");
        cgo_int(c, (*c).cg_scope);
        cgo_str(c, ", ptr %v");
        cgo_int(c, task);
        cgo_str(c, ")\n");
        (*c).cg_used_scoperegister = true;
        0
    } else {
        0
    };
    cg_record_spawn(c, fid);
    cg_reg(c, task);
    0
}

// (Bar B / concurrency) emit `void @__spawn_wrapper_<fid>(ptr %arg0, ptr %arg1)` (%arg0 =
// the Task, %arg1 = the packed args): unpack `np` i64 args (8-byte slots), call the
// target, store the result into task@0, set task->done (i32 @ 8), ret void. Emits DIRECTLY
// to cgout (a standalone define, no alloca hoisting). Mirrors the oracle's
// `dump_spawn_wrapper`.
fn cg_emit_spawn_wrapper(c: &mut TyCtx, fid: i64, src: &[u8]) -> i64 {
    cg_reset(c);
    // Route to cgcls (the class/impl-method buffer, folded into `result` AFTER cgout) so
    // the wrappers land LAST — after the fns + class/impl methods (the oracle's order).
    (*c).cg_to_body = false;
    (*c).cg_to_cls = true;
    let ns: i64 = (*c).ufs[fid - 42];
    let ne: i64 = (*c).ufe[fid - 42];
    let np: i64 = (*c).ufpe[fid - 42] - (*c).ufps[fid - 42];
    cgo_str(c, "define void @__spawn_wrapper_");
    cgo_int(c, fid);
    cgo_str(c, "(ptr %arg0, ptr %arg1) {\nentry:\n");
    // ADR 0066 M1.1: load each arg with its real param type + encode the result into
    // the Task's i64 slot (mirrors the oracle's dump_spawn_wrapper). i64 args/result are
    // byte-identical to C4.4.
    let ps: i64 = (*c).ufps[fid - 42];
    let reth: i64 = strip_secret(c, (*c).ufret[fid - 42]);
    let mut loads: Vec<i64> = vec_new();
    let mut ptys: Vec<i64> = vec_new();
    let mut i: i64 = 0;
    while i < np {
        let pty: i64 = (*c).ufpp[ps + i];
        let off: i64 = i * 8;
        let gp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %arg1, i64 ");
        cgo_int(c, off);
        cg_putc(c, '\n');
        let ld: i64 = cg_dst(c);
        cgo_str(c, "load ");
        cgo_ty(c, pty);
        cgo_str(c, ", ptr %v");
        cgo_int(c, gp);
        cg_putc(c, '\n');
        push(&mut loads, ld);
        push(&mut ptys, pty);
        i = i + 1;
    }
    let cr: i64 = cg_dst(c);
    cgo_str(c, "call ");
    cgo_ty(c, reth);
    cgo_str(c, " @");
    cgo_slice(c, src, ns, ne);
    cg_putc(c, '(');
    let mut j: i64 = 0;
    while j < np {
        if j > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        cgo_ty(c, ptys[j]);
        cg_putc(c, ' ');
        cgo_str(c, "%v");
        cgo_int(c, loads[j]);
        j = j + 1;
    }
    cgo_str(c, ")\n");
    let enc: i64 = if reth == 0 {
        cr
    } else {
        let ee: i64 = cg_dst(c);
        if reth == 1 {
            cgo_str(c, "zext i32 %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        } else if reth == 2 {
            cgo_str(c, "zext i1 %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        } else if reth == 3 {
            cgo_str(c, "zext i8 %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        } else {
            // (ADR 0058) Handle 4 (f64) reaches this `else` and would be encoded
            // as a POINTER. Unreachable, on the same verified guard as the
            // channel send/recv pair below (see the long note at `fid == 22`):
            // the oracle Errs before lowering any program that could produce an
            // f64 here -- `spawn` of an f64-returning fn needs `llvm_ty(F64)`
            // and is refused with "type not yet ported". The residual is the
            // SHAPE: these chains ask "is it 0/1/2/3?" and DEFAULT to pointer,
            // rather than asking positively whether the handle is a container
            // (`>= tbase()`). Anyone porting f64 codegen inverts that test.
            cgo_str(c, "ptrtoint ptr %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        };
        ee
    };
    cgo_str(c, "  store i64 %v");
    cgo_int(c, enc);
    cgo_str(c, ", ptr %arg0\n");
    let dg: i64 = cg_dst(c);
    cgo_str(c, "getelementptr i8, ptr %arg0, i64 8\n");
    cgo_str(c, "  store i32 1, ptr %v");
    cgo_int(c, dg);
    cg_putc(c, '\n');
    cgo_str(c, "  ret void\n}\n\n");
    let _lx: i64 = len(loads);
    let _ly: i64 = len(ptys);
    0
}

// (Bar B / effects) `k(arg)` part 2 (after the arg is collected at `snap`): `kont_resume`
// then branch on the result's op_id: a PURE_RETURN drains via `consume_pure` (the value);
// else a resumer bubbled → store the new kont to the enclosing handle's slot + re-enter
// its loop. The builder ends on the pure block; the result operand is the unwrapped i64
// (c36a: transformed by the enclosing `return` arm, if any).
fn cg_emit_resume_tail(c: &mut TyCtx, kreg: i64, snap: i64, src: &[u8], gb: &mut Vec<u8>) -> i64 {
    let argk: i64 = (*c).cgak[snap];
    let argv: i64 = (*c).cgav[snap];
    let kr: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_kont_resume(ptr %v");
    cgo_int(c, kreg);
    cgo_str(c, ", i64 ");
    cgo_operand(c, argk, argv);
    cgo_str(c, ")\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    let kropid: i64 = cg_dst(c);
    cgo_str(c, "load i32, ptr %v");
    cgo_int(c, kr);
    cg_putc(c, '\n');
    let isp: i64 = cg_dst(c);
    cgo_str(c, "icmp eq i32 %v");
    cgo_int(c, kropid);
    cgo_str(c, ", 4294967295\n");
    let pure_b: i64 = cg_fresh_block(c);
    let bubble_b: i64 = cg_fresh_block(c);
    cgo_str(c, "  br i1 %v");
    cgo_int(c, isp);
    cgo_str(c, ", label %bb");
    cgo_int(c, pure_b);
    cgo_str(c, ", label %bb");
    cgo_int(c, bubble_b);
    cg_putc(c, '\n');
    // Bubble: hand the new kont to the enclosing handle's loop.
    let hcks: i64 = (*c).cg_h_cks;
    let hloop: i64 = (*c).cg_h_loop;
    cgo_str(c, "bb");
    cgo_int(c, bubble_b);
    cgo_str(c, ":\n");
    // (ADR 0075 D6) class (A): the rest of this arm cannot be replayed as a continuation
    // frame, so abort here rather than drop it — the answer would be wrong, not merely
    // unsupported. `unreachable` ends the block, so there is no drain and no hand-off;
    // the pure block below is still emitted, because the pure path is still the value of
    // `k(v)`. Mirrors the text oracle's `abort_bubble`.
    //
    // Written as a two-armed `if` rather than an early `return` because no `return`
    // appears anywhere in the `selfhost` sources — introducing the first one here would
    // put a `scg` lowering path under test for the first time in the same slice that
    // changes what it lowers. Both arms end in `0`, so the `if` is an ordinary
    // expression, and the pure-block suffix below is shared: class (A) differs from the
    // default in the bubble block ONLY, which is also true of the oracle.
    if (*c).cg_h_rcls == 2 {
        cgo_str(c, "  call void @sentinel_kont_panic_remainder()\n");
        cgo_str(c, "  unreachable\n");
        (*c).cg_used_kontpanicrem = true;
        0
    } else {
        // (ADR 0075 D6) class (R): reify the rest of the arm onto the bubbled kont FIRST,
        // then drain and hand off. The oracle emits the push before its own drain, and
        // the captured state is loaded out of slots this branch has not dropped yet.
        if (*c).cg_h_rcls == 1 {
            cg_ar_reify(c, kr, src)
        } else {
            0
        };
        // (ADR 0075 D1 / register D87) this branch leaves the arm's ENTRY, so it drains the
        // arm's scopes first — the drop records at or above the arm floor, in reverse,
        // covering a nested block and the body of a `while` written inside the arm. Without
        // it the arm's heap bindings are abandoned on every bubble, in the TAIL idiom as much
        // as in a non-tail one.
        // Unlike `break`/`continue` this branch COMES BACK: it re-enters the dispatch loop,
        // which re-enters the arm, so the pure block's drops below are reachable from here.
        // What is exclusive is the two paths through one ENTRY — it either bubbles and drains
        // here, or completes and drops at its block's end — so an entry frees exactly what it
        // allocated, which holds only because ADR 0075 D3 refuses an arm binding that takes
        // over an allocation made outside the arm. `cg_drop_range` does NOT truncate, so the
        // pure block still emits its own. Mirrors the oracle's `emit_loop_exit_drops`.
        cg_drop_range(c, (*c).cg_h_floor);
        cgo_str(c, "  store ptr %v");
        cgo_int(c, kr);
        cgo_str(c, ", ptr %v");
        cgo_int(c, hcks);
        cg_putc(c, '\n');
        cgo_str(c, "  br label %bb");
        cgo_int(c, hloop);
        cg_putc(c, '\n');
        0
    };
    // Pure: unwrap to the resumed i64.
    cgo_str(c, "bb");
    cgo_int(c, pure_b);
    cgo_str(c, ":\n");
    let pv: i64 = cg_dst(c);
    cgo_str(c, "call i64 @sentinel_kont_consume_pure(ptr %v");
    cgo_int(c, kr);
    cgo_str(c, ")\n");
    (*c).cg_used_resume = true;
    (*c).cg_used_consume = true;
    // (c36a) k(v)'s pure result is run through the enclosing `return` arm (identity if
    // none) — Phase B's `k := \v. handle (resume v) with H`. Sets cglk/cglv to the result.
    cg_apply_return_arm(c, 0, pv, src, gb);
    0
}

// emit a call (or the u8<->i64 width builtins): consume the arg slice [snap..],
// truncate it, set the result operand. fid 5 = u8_to_i64 (zext), 6 = i64_to_u8
// (trunc), >=14 = a user fn. Other builtins are not yet ported (no emit).
fn cg_emit_call(c: &mut TyCtx, src: &[u8], fid: i64, snap: i64, rty: i64) -> i64 {
    if fid == 5 {
        let ak: i64 = (*c).cgak[snap];
        let av: i64 = (*c).cgav[snap];
        cg_conv(c, "zext", 3, ak, av, 0);
        0
    } else if fid == 6 {
        let bk: i64 = (*c).cgak[snap];
        let bv: i64 = (*c).cgav[snap];
        cg_conv(c, "trunc", 0, bk, bv, 3);
        0
    } else if fid == 3 {
        // (8c-2/8d) len = extractvalue <agg> <coll>, 0 — `<agg>` is the arg's actual
        // type (`{i64,ptr}` for `[T]`, `{i64,i64,ptr}` for `Vec<T>`; len is field 0).
        let lk: i64 = (*c).cgak[snap];
        let lv: i64 = (*c).cgav[snap];
        let lt: i64 = (*c).cgat[snap];
        let ld: i64 = cg_dst(c);
        cgo_str(c, "extractvalue ");
        cgo_ty(c, lt);
        cg_putc(c, ' ');
        cgo_operand(c, lk, lv);
        cgo_str(c, ", 0\n");
        cg_reg(c, ld);
        0
    } else if fid == 2 {
        // (Bar B) is_some(x: ?T) -> bool = extractvalue { i1, T } <x>, 0 (the valid bit).
        let nul_xk: i64 = (*c).cgak[snap];
        let nul_xv: i64 = (*c).cgav[snap];
        let nul_xt: i64 = (*c).cgat[snap];
        cg_extract(c, nul_xt, nul_xk, nul_xv, 0);
        0
    } else if fid == 1 {
        // (Bar B) unwrap_or(x: ?T, default: T) -> T: extract the valid bit + payload,
        // then `select` between the payload (valid) and the default (null). `rty` = T.
        let uor_xk: i64 = (*c).cgak[snap];
        let uor_xv: i64 = (*c).cgav[snap];
        let uor_xt: i64 = (*c).cgat[snap];
        let uor_dk: i64 = (*c).cgak[snap + 1];
        let uor_dv: i64 = (*c).cgav[snap + 1];
        let uor_vld: i64 = cg_extract(c, uor_xt, uor_xk, uor_xv, 0);
        let uor_pay: i64 = cg_extract(c, uor_xt, uor_xk, uor_xv, 1);
        let uor_sel: i64 = cg_dst(c);
        cgo_str(c, "select i1 %v");
        cgo_int(c, uor_vld);
        cgo_str(c, ", ");
        cgo_ty(c, rty);
        cgo_str(c, " %v");
        cgo_int(c, uor_pay);
        cgo_str(c, ", ");
        cgo_ty(c, rty);
        cg_putc(c, ' ');
        cgo_operand(c, uor_dk, uor_dv);
        cg_putc(c, '\n');
        cg_reg(c, uor_sel);
        0
    } else if fid == 4 {
        // (8d) str_eq(a, b): decompose each [u8], call sentinel_str_eq -> i1.
        let s_ak: i64 = (*c).cgak[snap];
        let s_av: i64 = (*c).cgav[snap];
        let s_bk: i64 = (*c).cgak[snap + 1];
        let s_bv: i64 = (*c).cgav[snap + 1];
        let al: i64 = cg_lenptr(c, s_ak, s_av);
        let bl: i64 = cg_lenptr(c, s_bk, s_bv);
        let d2: i64 = cg_dst(c);
        cgo_str(c, "call i1 @sentinel_str_eq(ptr %v");
        cgo_int(c, al + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, al);
        cgo_str(c, ", ptr %v");
        cgo_int(c, bl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, bl);
        cgo_str(c, ")\n");
        (*c).cg_used_streq = true;
        cg_reg(c, d2);
        0
    } else if fid == 0 {
        // (Bar B) print(x): call sentinel_print(i64 x) -> i64.
        let pr_k: i64 = (*c).cgak[snap];
        let pr_v: i64 = (*c).cgav[snap];
        let pr_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_print(i64 ");
        cgo_operand(c, pr_k, pr_v);
        cgo_str(c, ")\n");
        (*c).cg_used_print = true;
        cg_reg(c, pr_d);
        0
    } else if fid == 13 {
        // (8d) print_bytes(d): decompose [u8], call sentinel_print_bytes -> i64.
        let p_dk: i64 = (*c).cgak[snap];
        let p_dv: i64 = (*c).cgav[snap];
        let pdl: i64 = cg_lenptr(c, p_dk, p_dv);
        let d3: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_print_bytes(ptr %v");
        cgo_int(c, pdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pdl);
        cgo_str(c, ")\n");
        (*c).cg_used_prbytes = true;
        cg_reg(c, d3);
        0
    } else if fid == 21 {
        // (ADR 0066 M1.2) channel_new() -> a Channel<i64> (ptr).
        let cn_d: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_channel_new()\n");
        (*c).cg_used_channelnew = true;
        cg_reg(c, cn_d);
        0
    } else if fid == 22 {
        // (ADR 0066 M1.2 / M1.2b-cont / M1.2c) send(ch, v) -> i64 status. ENCODE the
        // value into the channel's i64 slot by its element type (the M1.1 encode):
        // i64 no-op / i32,bool,u8 `zext` / a channel HANDLE (channel-of-channels)
        // `ptrtoint`. The encode is emitted HERE, before the send's own dst, so
        // register numbering matches the oracle. The `else` is the ptr/channel case.
        //
        // (ADR 0058 UPDATE, CORRECTED by the register-D17 review — this comment has
        // now named the wrong guard TWICE, so read the measurement, not the story.
        // It first said `f64` "has no scg handle so it cannot occur" (false: f64 is
        // scalar code 4). It then said every way to make an f64 value — a literal,
        // an `as f64` cast — is Err'd by the oracle before lowering. THAT IS ALSO
        // FALSE. The oracle Errs wherever an f64 TYPE must be RENDERED (`lty`), and
        // an element riding the i64 slot is never rendered: `shared_new(x as f64)`
        // lowers, the oracle emitting `bitcast double %v1 to i64`. The container
        // twin of this arm was measured diverging on exactly that shape. Assume the
        // same is reachable here until someone constructs the channel version and
        // shows otherwise. What IS verified: no corpus program has an f64 element,
        // the divergence is pre-existing, and the oracle's own f64 output is invalid
        // IR ("integer constant must have integer type"), which is why `llvm_rejects`
        // stays silent. If f64 values are ever ported, this arm and the `recv` twin
        // need a `bitcast` — NOT the pointer `ptrtoint`/`inttoptr` fallback, which on
        // a `double` is invalid IR rather than merely different bytes — AND `cgo_ty`
        // needs a real code-4 arm first, or the `bitcast` renders `i64` on both sides
        // and converts nothing.)
        //
        // (register D29 — CLOSED) This block used to warn that the arm never called
        // `strip_secret`, so a `secret` element fell to the pointer catch-all and emitted
        // `ptrtoint i64 -> i64`. It does now; see the note on `cs_vt` below for why
        // stripping is right HERE and wrong for the process pipe.
        let cs_chk: i64 = (*c).cgak[snap];
        let cs_chv: i64 = (*c).cgav[snap];
        let cs_vk: i64 = (*c).cgak[snap + 1];
        let cs_vv: i64 = (*c).cgav[snap + 1];
        // (register D29) STRIP THE SECRET FIRST. `cgat` holds a type HANDLE, not a scalar
        // code, so a `secret i64` element is a handle >= tbase(): it matched none of the
        // width arms below and fell into the pointer catch-all, emitting
        // `ptrtoint i64 %v to i64` — which `llvm-as` rejects with "invalid cast opcode
        // for cast from 'i64' to 'i64'". A secret lowers identically to its inner
        // (ADR 0019 D5/D12 erasure), so the width is the inner's width.
        //
        // BOTH ARMS were broken, not one: `Channel<secret i64>` emitted a bogus
        // `ptrtoint` on send AND a bogus `inttoptr` on recv. `llvm-as` reports only the
        // first and stops, so "one error" undercounts it — never read an error count as a
        // site count. The reach is the four SECRETABLE SCALARS (i64/i32/u8/bool):
        // `secret f64` is a type error, and `secret ptr` still lands in the catch-all
        // unchanged, because `cgo_ty` renders f64 and ptr as `i64` anyway (D17/D33).
        //
        // ⚠ THIS IS THE OPPOSITE CALL FROM THE PROCESS PIPE, and the difference is not
        // style. `process_send`'s encode is GATED on the element fence and deliberately
        // does NOT strip, because a `secret` may not cross a process boundary at all
        // (ADR 0066 D8, pinned by `c66_process_channel_secret_fence`) — stripping there
        // turned a fail-closed boundary fail-open, which is register D34's lesson. An
        // IN-PROCESS channel has no such fence: the oracle rejects `Channel<secret T>`
        // with ChannelElementNotSupported, the same "not supported yet" it gives
        // `Channel<u128>`, and M1.4c-2 is the item that will support it. So here
        // stripping is the correct lowering and gating would be wrong.
        //
        // The pointer catch-all below STAYS, and must: `Channel<Channel<i64>>` is a real
        // corpus shape (`examples/lang/addressed_reply.sentinel`) whose element genuinely
        // is a handle, and it is byte-identical today only because of that arm.
        let cs_vt: i64 = strip_secret(c, (*c).cgat[snap + 1]);
        let cs_enc: i64 = if cs_vt == 0 {
            0 - 1
        } else if cs_vt == 1 || cs_vt == 2 || cs_vt == 3 {
            cg_conv(c, "zext", cs_vt, cs_vk, cs_vv, 0)
        } else {
            cg_conv(c, "ptrtoint", cs_vt, cs_vk, cs_vv, 0)
        };
        let cs_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_channel_send(ptr ");
        cgo_operand(c, cs_chk, cs_chv);
        cgo_str(c, ", i64 ");
        if cs_enc == 0 - 1 {
            cgo_operand(c, cs_vk, cs_vv)
        } else {
            cgo_str(c, "%v");
            cgo_int(c, cs_enc)
        };
        cgo_str(c, ")\n");
        (*c).cg_used_channelsend = true;
        cg_reg(c, cs_d);
        0
    } else if fid == 23 {
        // (ADR 0066 M1.2 / M1.2b-cont / M1.2c) recv(ch) -> ?<elem>: read the i64
        // frame from a stack out-slot (always i64 — the runtime frame width is
        // fixed), DECODE it into the element (i64 no-op / i32,bool,u8 `trunc` / a
        // channel handle `inttoptr`), then build `{ i1 valid, <ety> value }`
        // (valid = status == 0). The element comes off recv's `?<elem>` return
        // type; `<ety>` (= `cgo_ty(elem)`) is `ptr` for a channel-of-channels
        // element, giving `{ i1, ptr }` = `?Channel`.
        // (register D29) the decode twin of the send strip above — same reason, same
        // deliberate difference from the process pipe. `cgo_ty` already strips a secret
        // at its entry, so the AGGREGATE text was right even before this; it was only the
        // width DISPATCH that fell through to the pointer arm.
        //
        // ⚠⚠ READ THIS BEFORE "FIXING" THE LINE BELOW. ADR 0066 D8 contains the sentence
        // "the channel element type **carries `secret`** end-to-end — `recv` must *not*
        // strip the qualifier", and calls dropping it "the security regression to catch".
        // That invariant is about the TYPE, and it is intact: what is stripped here is
        // `cr_elem`, a LOCAL used only to choose the width conversion and the `cgo_ty`
        // text. `rty` is untouched, and the caller has already emitted the typed dump
        // (`close_ty`) and the MIR node from the UNSTRIPPED type before `cg_emit_call`
        // runs — so the recorded type still reads `:?secret i64` and `secret_leak` still
        // checks every downstream use. That is established by the CALLER'S ORDERING
        // (`borrow_arms.sentinel`: `close_ty` then `mir_emit_va` then `cg_emit_call`,
        // all handed the unstripped `rt`), not by anything this arm does — and the
        // types dump for a `Channel<secret i64>` recv does read `(targs secret i64)`.
        //
        // Worth knowing before reasoning about scg and secrets at all: `scg` does not
        // implement `secret_leak` — zero hits for it under `selfhost/` — so it emits
        // clean IR for `if <secret bool>` too. It is a codegen mirror, not the taint
        // oracle, and there is no scg-side secret boundary for this arm to open.
        //
        // The distinction is the one D8 itself draws: a secret may not cross a PROCESS
        // boundary (that fence is `process_send`'s — register D34 is what happens when
        // you strip there), but in-process D8 calls allowing it "a *feature*: it enables
        // parallel constant-time crypto over secret data". Stripping a WIDTH is not
        // stripping a QUALIFIER.
        let cr_elem: i64 = strip_secret(c, nullable_inner_of(c, rty));
        let cr_chk: i64 = (*c).cgak[snap];
        let cr_chv: i64 = (*c).cgav[snap];
        let cr_slot: i64 = cg_alloca(c, 0);
        let cr_status: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_channel_recv(ptr ");
        cgo_operand(c, cr_chk, cr_chv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, cr_slot);
        cgo_str(c, ")\n");
        (*c).cg_used_channelrecv = true;
        let cr_valid: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, cr_status);
        cgo_str(c, ", 0\n");
        let cr_raw: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, cr_slot);
        cg_putc(c, '\n');
