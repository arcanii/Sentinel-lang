        let prd_pv: i64 = (*c).cgav[snap];
        let prdslot: i64 = cg_alloca(c, 0);
        let prddata: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_process_read(ptr ");
        cgo_operand(c, prd_pk, prd_pv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, prdslot);
        cgo_str(c, ")\n");
