        // (Bar B / effects c35b) a call to an effecting fn yields a Kont* (`ptr`), not
        // its declared return type — and a tail effecting-call makes the caller's tail
        // kont-producing (so an enclosing effecting fn returns it as-is).
        let efc: bool = (*c).ufeff[fid - 29] != 0;
        let d: i64 = cg_dst(c);
        cgo_str(c, "call ");
        if efc {
            cgo_str(c, "ptr")
        } else {
            cgo_ty(c, rty)
        };
        cgo_str(c, " @");
        let us: i64 = (*c).ufs[fid - 29];
        let ue: i64 = (*c).ufe[fid - 29];
        cgo_slice(c, src, us, ue);
        // (Bar B / generics-b) a generic callee resolves to its monomorphic symbol
        // `name__<arg0>__…`; `cg_targs` was set by the preceding `dump_generic_call`.
        if (*c).uftp[fid - 29] > 0 {
            let ctargs: Vec<i64> = cg_copy_targs(c, 1);
            cg_emit_mono_suffix(c, &ctargs);
            0
        } else {
            0
        };
        cg_putc(c, '(');
        let n: i64 = len((*c).cgak);
        let mut i: i64 = snap;
        let mut first: bool = true;
        while i < n {
            if first {
                first = false;
                0
            } else {
                cgo_str(c, ", ");
                0
            };
            let aty: i64 = (*c).cgat[i];
            let aok: i64 = (*c).cgak[i];
            let aov: i64 = (*c).cgav[i];
            cgo_ty(c, aty);
            cg_putc(c, ' ');
            cgo_operand(c, aok, aov);
            i = i + 1;
        }
        cg_putc(c, ')');
        cg_putc(c, '\n');
        cg_reg(c, d);
        (*c).cg_tailk = efc;
        0
    } else {
        0
    };
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    0
}

// `define <ret> @<name>(<ptys> %argN) {\nentry:\n` + each param's alloca + store.
// Called after the params are parsed (slots reserved + types in `cgpty` by the
// emit_tparams hook) and `rty` known, before the body walk.
// Teardown: ASSEMBLE the fn into cgout — the `define` header, the entry block (the
// HOISTED allocas first), the buffered body (cgbody), then the return + `}`. Called
// after the body walk; flips cg_putc to target cgout. The body's value (`cglast`) is
// the fn's return (captured first — the header/ret emission advances cgnext for main's
// trunc temp, which must continue after the body's numbering).

// (8c-1) `  %vD = extractvalue <ty> <op>, <idx>` (a struct field read); sets the
// threaded operand to the dest register.
fn cg_extract(c: &mut TyCtx, tyh: i64, opk: i64, opv: i64, idx: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tyh);
    cg_putc(c, ' ');
    cgo_operand(c, opk, opv);
    cgo_str(c, ", ");
    cgo_int(c, idx);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// (8c-1) emit a struct literal's `insertvalue` chain over the field operands
// collected on the arg stacks since `snap` (building from `undef`); sets the
// threaded operand to the final aggregate register; pops the stacks back to `snap`.
// (`(*c).cgat[i]` is bound to a local before `cgo_ty` — passing it inline while `c`
// is `&mut` re-borrows `c`, the A2 quirk.)
fn cg_emit_structlit(c: &mut TyCtx, styh: i64, snap: i64) -> i64 {
    let n: i64 = len((*c).cgak);
    let mut prev: i64 = 0 - 1;
    let mut idx: i64 = 0;
    let mut i: i64 = snap;
    while i < n {
        let d: i64 = cg_dst(c);
        cgo_str(c, "insertvalue ");
        cgo_ty(c, styh);
        cg_putc(c, ' ');
        if prev < 0 {
            cgo_str(c, "undef")
        } else {
            cgo_str(c, "%v");
            cgo_int(c, prev)
        };
        cgo_str(c, ", ");
        let aty: i64 = (*c).cgat[i];
        cgo_ty(c, aty);
        cg_putc(c, ' ');
        let aok: i64 = (*c).cgak[i];
        let aov: i64 = (*c).cgav[i];
        cgo_operand(c, aok, aov);
        cgo_str(c, ", ");
        cgo_int(c, idx);
        cg_putc(c, '\n');
        prev = d;
        idx = idx + 1;
        i = i + 1;
    }
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, prev)
}

// (8d) decompose a `[u8]`/`{ i64, ptr }` operand into its (len, ptr) for a runtime
// builtin: emit `%vL = extractvalue { i64, ptr } <op>, 0` then `%v(L+1) =
// extractvalue …, 1`; return L (the len reg; the ptr reg is L+1, the very next).
fn cg_lenptr(c: &mut TyCtx, opk: i64, opv: i64) -> i64 {
    let l: i64 = cg_dst(c);
    cgo_str(c, "extractvalue { i64, ptr } ");
    cgo_operand(c, opk, opv);
    cgo_str(c, ", 0\n");
    let _p: i64 = cg_dst(c);
    cgo_str(c, "extractvalue { i64, ptr } ");
    cgo_operand(c, opk, opv);
    cgo_str(c, ", 1\n");
    l
}

// (8c-2) emit an array literal: heap alloc (`n * sizeof(elem)` via the GEP-sizeof
// idiom + `sentinel_alloc`) + per-element GEP-store over the operands collected
// since `snap` + the abi-v1 `{ i64 len, ptr data }`. Sets the threaded operand to
// the aggregate register; pops the arg stacks back to `snap`.
fn cg_emit_arraylit(c: &mut TyCtx, ety: i64, snap: i64) -> i64 {
    let top: i64 = len((*c).cgak);
    let n: i64 = top - snap;
    let sz: i64 = cg_dst(c);
    cgo_str(c, "getelementptr ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr null, i64 ");
    cgo_int(c, n);
    cg_putc(c, '\n');
    let szi: i64 = cg_dst(c);
    cgo_str(c, "ptrtoint ptr %v");
    cgo_int(c, sz);
    cgo_str(c, " to i64\n");
    let data: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
    cgo_int(c, szi);
    cgo_str(c, ")\n");
    (*c).cg_used_alloc = true;
    let mut i: i64 = snap;
    let mut ix: i64 = 0;
    while i < top {
        let ep: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, ety);
        cgo_str(c, ", ptr %v");
        cgo_int(c, data);
        cgo_str(c, ", i64 ");
        cgo_int(c, ix);
        cg_putc(c, '\n');
        cgo_str(c, "  store ");
        cgo_ty(c, ety);
        cg_putc(c, ' ');
        let ek: i64 = (*c).cgak[i];
        let ev: i64 = (*c).cgav[i];
        cgo_operand(c, ek, ev);
        cgo_str(c, ", ptr %v");
        cgo_int(c, ep);
        cg_putc(c, '\n');
        i = i + 1;
        ix = ix + 1;
    }
    let a0: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i64, ptr } undef, i64 ");
    cgo_int(c, n);
    cgo_str(c, ", 0\n");
    let a1: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i64, ptr } %v");
    cgo_int(c, a0);
    cgo_str(c, ", ptr %v");
    cgo_int(c, data);
    cgo_str(c, ", 1\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, a1)
}

// (8c-2) emit `a[i]`: extract len(0)/data(1), bounds-check (0 <= i < len, else
// `sentinel_panic_oob` + `unreachable`), then GEP+load. Sets the operand to the
// loaded value. Blocks: oob first (dead-ends), ok second (continues).
fn cg_emit_index(c: &mut TyCtx, ety: i64, tty: i64, tk: i64, tv: i64, ik: i64, iv: i64) -> i64 {
    // `a[i]` read: the bounds-checked element GEP, then a load. The GEP is
    // factored (`cg_emit_index_addr`) so index-assignment `a[i] = v;` (ADR 0050)
    // reuses the identical address computation and stores instead.
    let ep: i64 = cg_emit_index_addr(c, ety, tty, tk, tv, ik, iv);
    let v: i64 = cg_dst(c);
    cgo_str(c, "load ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr %v");
    cgo_int(c, ep);
    cg_putc(c, '\n');
    cg_reg(c, v)
}

// The bounds-checked element GEP shared by `a[i]` (read) and `a[i] = v;` (ADR
// 0050 index-assign): extract len(0)/data(1 for `[T]`, 2 for `Vec<T>`), check
// `0 <= i < len` (else `sentinel_panic_oob` + unreachable), then GEP in the
// in-bounds block. Returns the element-pointer register `ep` — the caller loads
// through it (read) or stores through it (write).
fn cg_emit_index_addr(c: &mut TyCtx, ety: i64, tty: i64, tk: i64, tv: i64, ik: i64, iv: i64) -> i64 {
    // `<agg>` is the target's actual type (`{i64,ptr}` for `[T]` with data at field 1,
    // `{i64,i64,ptr}` for `Vec<T>` with data at field 2; len is field 0 for both).
    let ln: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tty);
    cg_putc(c, ' ');
    cgo_operand(c, tk, tv);
    cgo_str(c, ", 0\n");
    let dat: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tty);
    cg_putc(c, ' ');
    cgo_operand(c, tk, tv);
    cgo_str(c, ", ");
    if cg_is_vec(c, tty) {
        cgo_int(c, 2)
    } else {
        cgo_int(c, 1)
    };
    cg_putc(c, '\n');
    let ge: i64 = cg_dst(c);
    cgo_str(c, "icmp sge i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", 0\n");
    let lt: i64 = cg_dst(c);
    cgo_str(c, "icmp slt i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", %v");
    cgo_int(c, ln);
    cg_putc(c, '\n');
    let inb: i64 = cg_dst(c);
    cgo_str(c, "and i1 %v");
    cgo_int(c, ge);
    cgo_str(c, ", %v");
    cgo_int(c, lt);
    cg_putc(c, '\n');
    let oob: i64 = cg_fresh_block(c);
    let ok: i64 = cg_fresh_block(c);
    cgo_str(c, "  br i1 %v");
    cgo_int(c, inb);
    cgo_str(c, ", label %bb");
    cgo_int(c, ok);
    cgo_str(c, ", label %bb");
    cgo_int(c, oob);
    cg_putc(c, '\n');
    cgo_str(c, "bb");
    cgo_int(c, oob);
    cgo_str(c, ":\n");
    cgo_str(c, "  call void @sentinel_panic_oob(i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", i64 %v");
    cgo_int(c, ln);
    cgo_str(c, ")\n");
    (*c).cg_used_panic = true;
    cgo_str(c, "  unreachable\n");
    cgo_str(c, "bb");
    cgo_int(c, ok);
    cgo_str(c, ":\n");
    let ep: i64 = cg_dst(c);
    cgo_str(c, "getelementptr ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr %v");
    cgo_int(c, dat);
    cgo_str(c, ", i64 ");
    cgo_operand(c, ik, iv);
    cg_putc(c, '\n');
    ep
}

fn cg_emit_fn(c: &mut TyCtx, src: &[u8], name_s: i64, name_e: i64, rty: i64) -> i64 {
    let bk: i64 = (*c).cglk;
    let bv: i64 = (*c).cglv;
    (*c).cg_to_body = false;
    cgo_str(c, "define ");
    if (*c).cgmain {
        cgo_str(c, "i32")
    } else if (*c).cg_eff {
        // (Bar B / effects c35b) effecting fn — the Kont* ABI returns `ptr`.
        cgo_str(c, "ptr")
    } else {
        cgo_ty(c, rty)
    };
    cgo_str(c, " @");
    cgo_slice(c, src, name_s, name_e);
    // (Bar B / generics-b) a monomorphic instance's symbol is `name__<arg0>__…`.
    if (*c).cg_mono_on {
        let margs: Vec<i64> = cg_copy_targs(c, 0);
        cg_emit_mono_suffix(c, &margs);
        0
    } else {
        0
    };
    cg_putc(c, '(');
    let np: i64 = len((*c).cgpty);
    let mut i: i64 = 0;
    while i < np {
        if i > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        let pty: i64 = (*c).cgpty[i];
        cgo_ty(c, pty);
        cgo_str(c, " %arg");
        cgo_int(c, i);
        i = i + 1;
    }
    cgo_str(c, ") {\nentry:\n");
    // the HOISTED allocas (params + lets + if-results), in reservation order.
    let na: i64 = len((*c).cgalloca_sl);
    let mut ai: i64 = 0;
    while ai < na {
        let asl: i64 = (*c).cgalloca_sl[ai];
        let aty: i64 = (*c).cgalloca_ty[ai];
        cgo_str(c, "  %v");
        cgo_int(c, asl);
        cgo_str(c, " = alloca ");
        if aty < 0 {
            cgo_str(c, "ptr")
        } else {
            cgo_ty(c, aty)
        };
        cg_putc(c, '\n');
        ai = ai + 1;
    }
    // the buffered body (cgbody) — folded into cgout via the builtin push.
    let nb: i64 = len((*c).cgbody);
    let mut bi: i64 = 0;
    while bi < nb {
        let byte: u8 = (*c).cgbody[bi];
        push(&mut (*c).cgout, byte);
        bi = bi + 1;
    }
    // the return (main truncates its i64 body to i32 — the C ABI).
    if (*c).cgmain {
        let d: i64 = cg_dst(c);
        cgo_str(c, "trunc i64 ");
        cgo_operand(c, bk, bv);
        cgo_str(c, " to i32\n");
        cgo_str(c, "  ret i32 %v");
        cgo_int(c, d);
        cg_putc(c, '\n');
        0
    } else if (*c).cg_eff {
        // (Bar B / effects c35b) the Kont* ABI: a kont-producing tail (direct perform /
        // call-to-effecting) returns as-is; a pure tail is wrapped as a PURE_RETURN kont
        // (`sentinel_kont_pure`) so the caller's `handle` sees a uniform Kont*.
        if (*c).cg_tailk {
            cgo_str(c, "  ret ptr ");
            cgo_operand(c, bk, bv);
            cg_putc(c, '\n');
            0
        } else {
            let kp: i64 = cg_dst(c);
            cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
            cgo_operand(c, bk, bv);
            cgo_str(c, ")\n");
            (*c).cg_used_kontpure = true;
            cgo_str(c, "  ret ptr %v");
            cgo_int(c, kp);
            cg_putc(c, '\n');
            0
        }
    } else {
        cgo_str(c, "  ret ");
        cgo_ty(c, rty);
        cg_putc(c, ' ');
        cgo_operand(c, bk, bv);
        cg_putc(c, '\n');
        0
    };
    cgo_str(c, "}\n\n");
    0
}

// (Bar B / effects c35c) emit the hoisted entry-block allocas (cgalloca_sl/_ty, in
// reservation order) then fold the buffered body (cgbody) — the shared tail of a
// `define` assembly. Assumes `cg_to_body` is already false (output routes to cgout).
fn cg_flush_allocas_body(c: &mut TyCtx) -> i64 {
    let na: i64 = len((*c).cgalloca_sl);
    let mut ai: i64 = 0;
    while ai < na {
        let asl: i64 = (*c).cgalloca_sl[ai];
        let aty: i64 = (*c).cgalloca_ty[ai];
        cgo_str(c, "  %v");
        cgo_int(c, asl);
        cgo_str(c, " = alloca ");
        if aty < 0 {
            cgo_str(c, "ptr")
        } else {
            cgo_ty(c, aty)
        };
        cg_putc(c, '\n');
        ai = ai + 1;
    }
    let nb: i64 = len((*c).cgbody);
    let mut bi: i64 = 0;
    while bi < nb {
        let byte: u8 = (*c).cgbody[bi];
        push(&mut (*c).cgout, byte);
        bi = bi + 1;
    }
    0
}

// (Bar B / effects c35c) emit an EFFECTING fn (Kont* ABI). A let-bound-perform body
// (`{ let v: i64 = perform …; <pure tail> }`) reifies a captured frame → a RESUMER fn +
// a parent (`cg_letshape_emit`, two defines); any OTHER effecting body (a pure / direct-
// perform / call-to-effecting tail, no statements — c32/c33/c35b) walks + assembles
// straight-line (`cg_eff_normal`). Mirrors the oracle's `dump_fn_named` routing through
// `detect_let_shape`. Consumes `body`. `[pv0,pvn)` = the fn's param VarId range (the
// let-shape capture set). The let-shape is matched structurally (single `let` with a
// `perform` RHS) — every effecting fn the oracle EMITS with a performing statement is a
// let-shape (its `validate_effecting_fn_body` defers the rest), so scg need not re-check
// the i64 / pure-tail conditions (the differential only runs scg when the oracle emits).
fn cg_emit_fn_eff(out: &mut Vec<u8>, c: &mut TyCtx, body: Expr, rty: i64, src: &[u8], name_s: i64, name_e: i64, cgpmark: i64, pv0: i64, pvn: i64, gb: &mut Vec<u8>, embed: Args, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, body_tok0: i64) -> i64 {
    // (The Sentinel match grammar has no bind-the-whole-value pattern — only
    // `Enum::Variant(..)` + `_`. So the non-let-shape branches re-wrap the moved-out
    // parts and fall through to `cg_eff_normal`; `Stmts`/`Stmt` are fully enumerated.)
    match body {
        Expr::Block(stmts, tail) => {
            match stmts {
                Stmts::SEnd => {
                    // No statements — the c35b shape (pure / perform / call-to-effecting
                    // tail), or the c35d EMBEDDED-perform shape (`embed` carries the
                    // unique perform, extracted from the classification copy).
                    match embed {
                        Args::Cell(pf, erest) => {
                            let _er: Args = erest;
                            cg_embed_emit(out, c, pf, tail, rty, src, name_s, name_e, pv0, pvn, gb)
                        },
                        Args::End => {
                            let b0: Expr = Expr::Block(Stmts::SEnd, tail);
                            cg_eff_normal(out, c, b0, rty, src, name_s, name_e, cgpmark, gb)
                        },
                    }
                },
                Stmts::SCell(st, rest) => {
                    match rest {
                        Stmts::SEnd => {
                            // Exactly one statement. A single `let` in an EMITTED effecting fn
                            // is the c35c let-bound-perform shape (the oracle's
                            // `validate_effecting_fn_body` defers every other performing-let
                            // body, so it never reaches scg) → walk its RHS as the perform.
                            match st {
                                Stmt::SLet(lmf, lnm, lty, lval) => {
                                    cg_letshape_emit(out, c, lnm, lty, lval, tail, rty, src, name_s, name_e, pv0, pvn, gb)
                                },
                                Stmt::SAssign(at, av) => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SAssign(at, av), Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SWhile(wc, wb) => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SWhile(wc, wb), Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SBreak => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SBreak, Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SContinue => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SContinue, Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SExpr(ex) => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SExpr(ex), Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                            }
                        },
                        Stmts::SCell(s2, r2) => {
                            // 2+ statements — the c35e CHAINED-effecting-lets shape (every
                            // EMITTED 2+-stmt effecting fn is chained lets: the oracle's
                            // `validate_effecting_fn_body` defers all other 2+-stmt
                            // performing bodies, and no 2+-pure-stmt effecting fn is in the
                            // emitted corpus). Re-wrap the moved-out chain + thread it to
                            // `cg_chained_emit`, which lowers each let's RHS into its own
                            // resumer (N+1 defines) + re-parses copies for the capture sets.
                            let b2: Expr = Expr::Block(Stmts::SCell(st, Stmts::SCell(s2, r2)), tail);
                            cg_chained_emit(out, c, b2, rty, src, name_s, name_e, pv0, pvn, gb, k, s, e, body_tok0)
                        },
                    }
                },
            }
        },
        _ => {
            // A fn body is always a `Block` (parse_block); this arm is unreachable.
            0
        },
    }
}

// (Bar B / effects c35c) a non-let-shape effecting body (c32/c33/c35b): the straight-line
// walk + the standard single-define assembly (the c35b path — `cg_emit_fn` wraps a pure
// tail via `kont_pure`, or returns the kont tail directly).
fn cg_eff_normal(out: &mut Vec<u8>, c: &mut TyCtx, body: Expr, rty: i64, src: &[u8], name_s: i64, name_e: i64, cgpmark: i64, gb: &mut Vec<u8>) -> i64 {
    dump_texpr(out, body, rty, src, c, gb);
    cg_drop_frame(c, cgpmark);
    cg_emit_fn(c, src, name_s, name_e, rty);
    0
}

// (Bar B / effects c35c / ADR 0020 D7) emit a let-bound-perform effecting fn as TWO
// defines (mirror the oracle's `dump_let_shape_fn` / inkwell `compile_effecting_fn_with_
// let`). The PARENT's params are ALREADY set up (emit_tparams ran — cgbody has the param
// stores, cg slots set, the register counter at #params); here it fills the captured-
// state struct (i64[N], one field per param — the capture set; `null` if none), lowers
// the RHS perform to a Kont*, `sentinel_kont_push`es a frame (the resumer + captured
// ptr), returns the Kont*. The RESUMER (`@__resume_<name>(i64 %arg0, ptr %arg1)`) binds
// the let var to the resumed value `%arg0` + each captured param to its struct field
// (loaded from `%arg1`), lowers the pure tail, wraps it via `sentinel_kont_pure`. Both
// loads/stores/GEPs are i64 (the SentinelKont `arg` slot). The capture set is the param
// list in declaration order = the oracle's first-reference order for the c35c corpus
// (≤1 param per let-shape fn, always used in the tail); multi-param first-ref ordering
// is a c35d+ refinement.
fn cg_letshape_emit(out: &mut Vec<u8>, c: &mut TyCtx, lnm: [u8], lty: TyOpt, lval: Expr, tail: Expr, rty: i64, src: &[u8], name_s: i64, name_e: i64, pv0: i64, pvn: i64, gb: &mut Vec<u8>) -> i64 {
    let nparams: i64 = pvn - pv0;
    let cap_null: bool = nparams == 0;
    // ===== PARENT define: captured struct, RHS → kont, push, ret ptr =====
    let mut alloc_reg: i64 = 0 - 1;
    if nparams > 0 {
        alloc_reg = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 ");
        cgo_int(c, nparams * 8);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        let mut pi: i64 = pv0;
        while pi < pvn {
            let off: i64 = (pi - pv0) * 8;
            let gp: i64 = cg_dst(c);
            cgo_str(c, "getelementptr i8, ptr %v");
            cgo_int(c, alloc_reg);
            cgo_str(c, ", i64 ");
            cgo_int(c, off);
            cg_putc(c, '\n');
            let pslot: i64 = cg_slot_get(c, pi);
            let ld: i64 = cg_dst(c);
            cgo_str(c, "load i64, ptr %v");
            cgo_int(c, pslot);
            cg_putc(c, '\n');
            cgo_str(c, "  store i64 %v");
            cgo_int(c, ld);
            cgo_str(c, ", ptr %v");
            cgo_int(c, gp);
            cg_putc(c, '\n');
            pi = pi + 1;
        }
        0
    } else {
        0
    };
    // Lower the RHS (a `perform`) → a Kont* (operand in cglk/cglv, cg_tailk set); walk it
    // (the type-dump goes to a throwaway buffer; the cg lands in cgbody).
    let mut pbuf: Vec<u8> = vec_new();
    let _prt: i64 = dump_texpr(&mut pbuf, lval, 0 - 1, src, c, gb);
    let _pbx: [u8] = vec_to_array(pbuf);
    let kk: i64 = (*c).cglk;
    let kv: i64 = (*c).cglv;
    // Push the captured frame referencing the resumer + the captured ptr.
    cgo_str(c, "  call void @sentinel_kont_push(ptr ");
    cgo_operand(c, kk, kv);
    cgo_str(c, ", ptr @__resume_");
    cgo_slice(c, src, name_s, name_e);
    cgo_str(c, ", ptr ");
    if cap_null {
        cgo_str(c, "null")
    } else {
        cgo_str(c, "%v");
        cgo_int(c, alloc_reg)
    };
    cgo_str(c, ")\n");
    (*c).cg_used_kontpush = true;
    // Assemble the PARENT: `define ptr @<name>(<params>) { entry: <allocas> <body> ret ptr <kont> }`.
    (*c).cg_to_body = false;
    cgo_str(c, "define ptr @");
    cgo_slice(c, src, name_s, name_e);
    cg_putc(c, '(');
    let np: i64 = len((*c).cgpty);
    let mut hi: i64 = 0;
    while hi < np {
        if hi > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        let pty: i64 = (*c).cgpty[hi];
        cgo_ty(c, pty);
        cgo_str(c, " %arg");
        cgo_int(c, hi);
        hi = hi + 1;
    }
    cgo_str(c, ") {\nentry:\n");
    cg_flush_allocas_body(c);
    cgo_str(c, "  ret ptr ");
    cgo_operand(c, kk, kv);
    cgo_str(c, "\n}\n\n");
    // ===== RESUMER define: bind v + captures, lower tail, kont_pure wrap, ret ptr =====
    cg_reset(c);
    // Bind the let var to the resumed value (`%arg0`); `letty` = i64 (the corpus).
    let letty: i64 = tyopt_exp(c, lty, gb);
    let v_vid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    bind_name(c, lnm, v_vid, letty);
    let v_slot: i64 = cg_alloca(c, letty);
    cg_slot_set(c, v_vid, v_slot);
    cgo_str(c, "  store i64 %arg0, ptr %v");
    cgo_int(c, v_slot);
    cg_putc(c, '\n');
    // Bind each captured param to a fresh slot, loaded from the captured ptr (`%arg1`).
    // Its TYPE binding persists in the env from emit_tparams (cg_reset clears only the cg
    // slots), so the tail's `Var` resolves + loads as i64.
    let mut pj: i64 = pv0;
    while pj < pvn {
        let off2: i64 = (pj - pv0) * 8;
        let gp2: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %arg1, i64 ");
        cgo_int(c, off2);
        cg_putc(c, '\n');
        let ld2: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, gp2);
        cg_putc(c, '\n');
        let cs: i64 = cg_alloca(c, 0);
        cgo_str(c, "  store i64 %v");
        cgo_int(c, ld2);
        cgo_str(c, ", ptr %v");
        cgo_int(c, cs);
        cg_putc(c, '\n');
        cg_slot_set(c, pj, cs);
        pj = pj + 1;
    }
    // Lower the pure tail → operand; wrap it as a PURE_RETURN kont.
    let mut tbuf: Vec<u8> = vec_new();
    let _trt: i64 = dump_texpr(&mut tbuf, tail, 0 - 1, src, c, gb);
    let _tbx: [u8] = vec_to_array(tbuf);
    let tk: i64 = (*c).cglk;
    let tv: i64 = (*c).cglv;
    let kp: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
    cgo_operand(c, tk, tv);
    cgo_str(c, ")\n");
    (*c).cg_used_kontpure = true;
    // Assemble the RESUMER.
    (*c).cg_to_body = false;
    cgo_str(c, "define ptr @__resume_");
    cgo_slice(c, src, name_s, name_e);
    cgo_str(c, "(i64 %arg0, ptr %arg1) {\nentry:\n");
    cg_flush_allocas_body(c);
    cgo_str(c, "  ret ptr %v");
    cgo_int(c, kp);
    cgo_str(c, "\n}\n\n");
    0
}

