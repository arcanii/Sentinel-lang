        // slot, so a narrower element is `zext`ed on the way in. Emitted BEFORE the
        // call's own dst so register numbering matches the oracle, exactly as fid 22
        // and the container constructors do.
        //
        // The element is the VALUE ARG's own type (`cgat[snap + 1]`), which is what the
        // oracle reads (`args[1].ty`) — NOT the Process, which carries no element.
        let pse_pk: i64 = (*c).cgak[snap];
        let pse_pv: i64 = (*c).cgav[snap];
        let pse_vk: i64 = (*c).cgak[snap + 1];
        let pse_vv: i64 = (*c).cgav[snap + 1];
