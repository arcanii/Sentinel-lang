        //
        // slice 3b: the `?Guard` payload (field 1) is the mutex cell handle `m`, NOT
        // the loaded out-slot — the guard's scope-exit drop unlocks via that handle
        // (`sentinel_mutex_unlock`). The out-slot is still passed to the runtime (ABI),
        // but no longer LOADED here.
        let lk_mk: i64 = (*c).cgak[snap];
        let lk_mv: i64 = (*c).cgav[snap];
