module types;

// --- (Bar B / effects) handler-runtime codegen helpers ----------------------

// A unique op id per `(EffectId, op_index)` — `(eid<<16)|(op&0xFFFF)`, which for an
// op_index < 65536 (always) is `eid*65536 + op` (no `<<`/`|` needed; same decimal value).
fn cg_encode_op_id(eid: i64, opidx: i64) -> i64 {
    eid * 65536 + opidx
}

// `%vD = call ptr @sentinel_perform_op(i32 op_id, i64 arg|0)` (the collected single arg
// at `snap`, or `0`); pops the collected args. Sets the result operand to the kont ptr.
fn cg_emit_perform(c: &mut TyCtx, eid: i64, opidx: i64, snap: i64) -> i64 {
    let opid: i64 = cg_encode_op_id(eid, opidx);
    let d: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_perform_op(i32 ");
    cgo_int(c, opid);
    cgo_str(c, ", i64 ");
    let n: i64 = len((*c).cgak);
    if n > snap {
        let ak: i64 = (*c).cgak[snap];
        let av: i64 = (*c).cgav[snap];
        cgo_operand(c, ak, av);
        0
    } else {
        cg_putc(c, '0');
        0
    };
    cgo_str(c, ")\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    (*c).cg_used_perform = true;
    cg_reg(c, d);
    // (c35b) a `perform` produces a kont — if it is the fn-body tail, the effecting fn
    // returns it directly (no `kont_pure` wrap).
    (*c).cg_tailk = true;
    0
}

// (Bar B / effects c35d) `%vD = load i64, ptr %v<cg_ph>` — inside an embedded-shape
// RESUMER the unique `perform` was reified by the parent; its result arrives as the
// resumed value at the placeholder slot. Pops any collected args like
// `cg_emit_perform` (the args were the PARENT's to lower — zero-arg over the c35d
// corpus). Does NOT set `cg_tailk` (the load is a plain i64 inside the pure context).
fn cg_emit_phload(c: &mut TyCtx, snap: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "load i64, ptr %v");
    cgo_int(c, (*c).cg_ph);
    cg_putc(c, '\n');
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, d);
    0
}

// (Bar B / effects) bind a handler arm's params from the VarId range `[pv0, pvn)` (in
// the SAME order the oracle's `bind_handler_arm_params` allocates): the op-param (when
// there are >=2 params — `kont.arg` via i8-GEP @8 into an i64 slot), then the
// continuation (the last, a slot holding the kont ptr `ck`). C3.5(a): one op-param max.
fn cg_bind_harm_params(c: &mut TyCtx, pv0: i64, pvn: i64, ck: i64) -> i64 {
    let n: i64 = pvn - pv0;
    if n >= 2 {
        let ap: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %v");
        cgo_int(c, ck);
        cgo_str(c, ", i64 8\n");
        let av: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, ap);
        cg_putc(c, '\n');
        let oslot: i64 = cg_alloca(c, 0);
        cgo_str(c, "  store i64 %v");
        cgo_int(c, av);
        cgo_str(c, ", ptr %v");
        cgo_int(c, oslot);
        cg_putc(c, '\n');
        cg_slot_set(c, pv0, oslot);
        0
    } else {
        0
    };
    let kslot: i64 = cg_alloca_ptr(c);
    cgo_str(c, "  store ptr %v");
    cgo_int(c, ck);
    cgo_str(c, ", ptr %v");
    cgo_int(c, kslot);
    cg_putc(c, '\n');
    cg_slot_set(c, pvn - 1, kslot);
    0
}

// (Bar B / effects) `k(arg)` part 1: load the kont pointer from `kid`'s slot — emitted
// BEFORE the arg is lowered (the oracle's `lower_resume_kont` loads the kont first, then
// the arg). Returns the loaded-kont register.
fn cg_emit_resume_load(c: &mut TyCtx, kid: i64) -> i64 {
    let kslot: i64 = cg_slot_get(c, kid);
    let kreg: i64 = cg_dst(c);
    cgo_str(c, "load ptr, ptr %v");
    cgo_int(c, kslot);
    cg_putc(c, '\n');
    kreg
}

// (Bar B / effects c36a / ADR 0020 D4) apply the enclosing handle's `return v => body`
// arm to a pure i64 value operand (kind `vk`, val `vv`), setting the result operand in
// cglk/cglv. With no return arm (`cg_ret_on` false) this is the identity (the value
// passes through). The arm body is RE-PARSED from `cg_ret_tok0` — move semantics bar
// reusing the parsed Expr, and the body lowers INLINE at each pure-drain site (the
// dispatch pure block + each k(v) pure path) per Phase B's deep-handler re-wrap
// (`k := \v. handle (resume v) with H`). `v` binds a fresh i64 slot holding the value;
// its name is re-sliced from `cg_ret_ntok`. Mirrors the oracle's `apply_return_arm`.
fn cg_apply_return_arm(c: &mut TyCtx, vk: i64, vv: i64, src: &[u8], gb: &mut Vec<u8>) -> i64 {
    if (*c).cg_ret_on {
        let ntok: i64 = (*c).cg_ret_ntok;
        let ns: i64 = (*c).cgts[ntok];
        let ne: i64 = (*c).cgte[ntok];
        let vid: i64 = (*c).nextvid;
        (*c).nextvid = (*c).nextvid + 1;
        bind_name(c, slice_of(src, ns, ne), vid, 0);
        let slot: i64 = cg_alloca(c, 0);
        cg_slot_set(c, vid, slot);
        cgo_str(c, "  store i64 ");
        cgo_operand(c, vk, vv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        // Re-parse the body from its tokens, lower it (cg → cgbody; type-dump → throwaway).
        let tok0: i64 = (*c).cg_ret_tok0;
        let mut cur: i64 = tok0;
        let rbody: Expr = parse_expr(&(*c).cgtk, &(*c).cgts, &(*c).cgte, src, &mut cur);
        let mut tb: Vec<u8> = vec_new();
        let _rr: i64 = dump_texpr(&mut tb, rbody, 0 - 1, src, c, gb);
        let _tbx: [u8] = vec_to_array(tb);
        // The result operand is now in cglk/cglv (set by the body lowering).
        0
    } else {
        (*c).cglk = vk;
        (*c).cglv = vv;
        0
    }
}

// (Bar B / concurrency / ADR 0024) record a spawn-target FnId (deduped). One
// `__spawn_wrapper_<id>` is synthesized per unique target at codegen end; the emission
// loop scans for FnId order (matching the oracle's `sort_by_key` + `dedup`).
fn cg_record_spawn(c: &mut TyCtx, fid: i64) -> i64 {
    let n: i64 = len((*c).cg_spawn_t);
    let mut i: i64 = 0;
    let mut dup: bool = false;
    while i < n {
        if (*c).cg_spawn_t[i] == fid {
            dup = true;
            0
        } else {
            0
        };
        i = i + 1;
    }
    if dup {
        0
    } else {
        push(&mut (*c).cg_spawn_t, fid);
        0
    }
}

// (Bar B / concurrency) emit a `spawn fn(args)`'s cg: pack the collected args (operands
// in cgak/cgav from `snap`) into a heap buffer (one i64 slot each, ≥8 bytes), call
// `sentinel_task_spawn(@__spawn_wrapper_<fid>, args, size)`, and (inside a scope)
// register the Task with `cg_scope`. Result operand = the Task ptr. Records `fid` for
// wrapper synthesis. Mirrors the oracle's Spawn lowering: ADR 0066 M1.2b made BOTH snc
// emitters (inkwell + `snc llvm`) collect-then-store too — evaluate every arg, THEN
// alloc the packed-args buffer, THEN store — so a non-immediate spawn arg (e.g. a
// copy-var `Channel` endpoint, whose eval emits a `load` before the alloc) is
// byte-identical across all three emitters, for any number of args.
fn cg_emit_spawn(c: &mut TyCtx, fid: i64, snap: i64, src: &[u8]) -> i64 {
    let _s: &[u8] = src;
    let n: i64 = len((*c).cgak) - snap;
    let size: i64 = if n > 0 {
        n * 8
    } else {
        8
    };
    let st: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_alloc(i64 ");
    cgo_int(c, size);
    cgo_str(c, ")\n");
    (*c).cg_used_alloc = true;
    let mut i: i64 = 0;
    while i < n {
        let ak: i64 = (*c).cgak[snap + i];
        let av: i64 = (*c).cgav[snap + i];
        let at: i64 = (*c).cgat[snap + i];
        let off: i64 = i * 8;
        let gp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %v");
        cgo_int(c, st);
        cgo_str(c, ", i64 ");
        cgo_int(c, off);
        cg_putc(c, '\n');
        // ADR 0066 M1.1: store the arg with its real type (was i64).
        cgo_str(c, "  store ");
        cgo_ty(c, at);
        cg_putc(c, ' ');
        cgo_operand(c, ak, av);
        cgo_str(c, ", ptr %v");
        cgo_int(c, gp);
        cg_putc(c, '\n');
        i = i + 1;
    }
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    let task: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_task_spawn(ptr @__spawn_wrapper_");
    cgo_int(c, fid);
    cgo_str(c, ", ptr %v");
    cgo_int(c, st);
    cgo_str(c, ", i64 ");
    cgo_int(c, size);
    cgo_str(c, ")\n");
    (*c).cg_used_taskspawn = true;
    if (*c).cg_scope >= 0 {
        cgo_str(c, "  call void @sentinel_scope_register(ptr %v");
        cgo_int(c, (*c).cg_scope);
        cgo_str(c, ", ptr %v");
        cgo_int(c, task);
        cgo_str(c, ")\n");
        (*c).cg_used_scoperegister = true;
        0
    } else {
        0
    };
    cg_record_spawn(c, fid);
    cg_reg(c, task);
    0
}

// (Bar B / concurrency) emit `void @__spawn_wrapper_<fid>(ptr %arg0, ptr %arg1)` (%arg0 =
// the Task, %arg1 = the packed args): unpack `np` i64 args (8-byte slots), call the
// target, store the result into task@0, set task->done (i32 @ 8), ret void. Emits DIRECTLY
// to cgout (a standalone define, no alloca hoisting). Mirrors the oracle's
// `dump_spawn_wrapper`.
fn cg_emit_spawn_wrapper(c: &mut TyCtx, fid: i64, src: &[u8]) -> i64 {
    cg_reset(c);
    // Route to cgcls (the class/impl-method buffer, folded into `result` AFTER cgout) so
    // the wrappers land LAST — after the fns + class/impl methods (the oracle's order).
    (*c).cg_to_body = false;
    (*c).cg_to_cls = true;
    let ns: i64 = (*c).ufs[fid - 42];
    let ne: i64 = (*c).ufe[fid - 42];
    let np: i64 = (*c).ufpe[fid - 42] - (*c).ufps[fid - 42];
    cgo_str(c, "define void @__spawn_wrapper_");
    cgo_int(c, fid);
    cgo_str(c, "(ptr %arg0, ptr %arg1) {\nentry:\n");
    // ADR 0066 M1.1: load each arg with its real param type + encode the result into
    // the Task's i64 slot (mirrors the oracle's dump_spawn_wrapper). i64 args/result are
    // byte-identical to C4.4.
    let ps: i64 = (*c).ufps[fid - 42];
    let reth: i64 = strip_secret(c, (*c).ufret[fid - 42]);
    let mut loads: Vec<i64> = vec_new();
    let mut ptys: Vec<i64> = vec_new();
    let mut i: i64 = 0;
    while i < np {
        let pty: i64 = (*c).ufpp[ps + i];
        let off: i64 = i * 8;
        let gp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %arg1, i64 ");
        cgo_int(c, off);
        cg_putc(c, '\n');
        let ld: i64 = cg_dst(c);
        cgo_str(c, "load ");
        cgo_ty(c, pty);
        cgo_str(c, ", ptr %v");
        cgo_int(c, gp);
        cg_putc(c, '\n');
        push(&mut loads, ld);
        push(&mut ptys, pty);
        i = i + 1;
    }
    let cr: i64 = cg_dst(c);
    cgo_str(c, "call ");
    cgo_ty(c, reth);
    cgo_str(c, " @");
    cgo_slice(c, src, ns, ne);
    cg_putc(c, '(');
    let mut j: i64 = 0;
    while j < np {
        if j > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        cgo_ty(c, ptys[j]);
        cg_putc(c, ' ');
        cgo_str(c, "%v");
        cgo_int(c, loads[j]);
        j = j + 1;
    }
    cgo_str(c, ")\n");
    let enc: i64 = if reth == 0 {
        cr
    } else {
        let ee: i64 = cg_dst(c);
        if reth == 1 {
            cgo_str(c, "zext i32 %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        } else if reth == 2 {
            cgo_str(c, "zext i1 %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        } else if reth == 3 {
            cgo_str(c, "zext i8 %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        } else {
            // (ADR 0058) Handle 4 (f64) reaches this `else` and would be encoded
            // as a POINTER. Unreachable, on the same verified guard as the
            // channel send/recv pair below (see the long note at `fid == 22`):
            // the oracle Errs before lowering any program that could produce an
            // f64 here -- `spawn` of an f64-returning fn needs `llvm_ty(F64)`
            // and is refused with "type not yet ported". The residual is the
            // SHAPE: these chains ask "is it 0/1/2/3?" and DEFAULT to pointer,
            // rather than asking positively whether the handle is a container
            // (`>= tbase()`). Anyone porting f64 codegen inverts that test.
            cgo_str(c, "ptrtoint ptr %v");
            cgo_int(c, cr);
            cgo_str(c, " to i64\n")
        };
        ee
    };
    cgo_str(c, "  store i64 %v");
    cgo_int(c, enc);
    cgo_str(c, ", ptr %arg0\n");
    let dg: i64 = cg_dst(c);
    cgo_str(c, "getelementptr i8, ptr %arg0, i64 8\n");
    cgo_str(c, "  store i32 1, ptr %v");
    cgo_int(c, dg);
    cg_putc(c, '\n');
    cgo_str(c, "  ret void\n}\n\n");
    let _lx: i64 = len(loads);
    let _ly: i64 = len(ptys);
    0
}

// (Bar B / effects) `k(arg)` part 2 (after the arg is collected at `snap`): `kont_resume`
// then branch on the result's op_id: a PURE_RETURN drains via `consume_pure` (the value);
// else a resumer bubbled → store the new kont to the enclosing handle's slot + re-enter
// its loop. The builder ends on the pure block; the result operand is the unwrapped i64
// (c36a: transformed by the enclosing `return` arm, if any).
fn cg_emit_resume_tail(c: &mut TyCtx, kreg: i64, snap: i64, src: &[u8], gb: &mut Vec<u8>) -> i64 {
    let argk: i64 = (*c).cgak[snap];
    let argv: i64 = (*c).cgav[snap];
    let kr: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_kont_resume(ptr %v");
    cgo_int(c, kreg);
    cgo_str(c, ", i64 ");
    cgo_operand(c, argk, argv);
    cgo_str(c, ")\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    let kropid: i64 = cg_dst(c);
    cgo_str(c, "load i32, ptr %v");
    cgo_int(c, kr);
    cg_putc(c, '\n');
    let isp: i64 = cg_dst(c);
    cgo_str(c, "icmp eq i32 %v");
    cgo_int(c, kropid);
    cgo_str(c, ", 4294967295\n");
    let pure_b: i64 = cg_fresh_block(c);
    let bubble_b: i64 = cg_fresh_block(c);
    cgo_str(c, "  br i1 %v");
    cgo_int(c, isp);
    cgo_str(c, ", label %bb");
    cgo_int(c, pure_b);
    cgo_str(c, ", label %bb");
    cgo_int(c, bubble_b);
    cg_putc(c, '\n');
    // Bubble: hand the new kont to the enclosing handle's loop.
    let hcks: i64 = (*c).cg_h_cks;
    let hloop: i64 = (*c).cg_h_loop;
    cgo_str(c, "bb");
    cgo_int(c, bubble_b);
    cgo_str(c, ":\n");
    cgo_str(c, "  store ptr %v");
    cgo_int(c, kr);
    cgo_str(c, ", ptr %v");
    cgo_int(c, hcks);
    cg_putc(c, '\n');
    cgo_str(c, "  br label %bb");
    cgo_int(c, hloop);
    cg_putc(c, '\n');
    // Pure: unwrap to the resumed i64.
    cgo_str(c, "bb");
    cgo_int(c, pure_b);
    cgo_str(c, ":\n");
    let pv: i64 = cg_dst(c);
    cgo_str(c, "call i64 @sentinel_kont_consume_pure(ptr %v");
    cgo_int(c, kr);
    cgo_str(c, ")\n");
    (*c).cg_used_resume = true;
    (*c).cg_used_consume = true;
    // (c36a) k(v)'s pure result is run through the enclosing `return` arm (identity if
    // none) — Phase B's `k := \v. handle (resume v) with H`. Sets cglk/cglv to the result.
    cg_apply_return_arm(c, 0, pv, src, gb);
    0
}

// emit a call (or the u8<->i64 width builtins): consume the arg slice [snap..],
// truncate it, set the result operand. fid 5 = u8_to_i64 (zext), 6 = i64_to_u8
// (trunc), >=14 = a user fn. Other builtins are not yet ported (no emit).
fn cg_emit_call(c: &mut TyCtx, src: &[u8], fid: i64, snap: i64, rty: i64) -> i64 {
    if fid == 5 {
        let ak: i64 = (*c).cgak[snap];
        let av: i64 = (*c).cgav[snap];
        cg_conv(c, "zext", 3, ak, av, 0);
        0
    } else if fid == 6 {
        let bk: i64 = (*c).cgak[snap];
        let bv: i64 = (*c).cgav[snap];
        cg_conv(c, "trunc", 0, bk, bv, 3);
        0
    } else if fid == 3 {
        // (8c-2/8d) len = extractvalue <agg> <coll>, 0 — `<agg>` is the arg's actual
        // type (`{i64,ptr}` for `[T]`, `{i64,i64,ptr}` for `Vec<T>`; len is field 0).
        let lk: i64 = (*c).cgak[snap];
        let lv: i64 = (*c).cgav[snap];
        let lt: i64 = (*c).cgat[snap];
        let ld: i64 = cg_dst(c);
        cgo_str(c, "extractvalue ");
        cgo_ty(c, lt);
        cg_putc(c, ' ');
        cgo_operand(c, lk, lv);
        cgo_str(c, ", 0\n");
        cg_reg(c, ld);
        0
    } else if fid == 2 {
        // (Bar B) is_some(x: ?T) -> bool = extractvalue { i1, T } <x>, 0 (the valid bit).
        let nul_xk: i64 = (*c).cgak[snap];
        let nul_xv: i64 = (*c).cgav[snap];
        let nul_xt: i64 = (*c).cgat[snap];
        cg_extract(c, nul_xt, nul_xk, nul_xv, 0);
        0
    } else if fid == 1 {
        // (Bar B) unwrap_or(x: ?T, default: T) -> T: extract the valid bit + payload,
        // then `select` between the payload (valid) and the default (null). `rty` = T.
        let uor_xk: i64 = (*c).cgak[snap];
        let uor_xv: i64 = (*c).cgav[snap];
        let uor_xt: i64 = (*c).cgat[snap];
        let uor_dk: i64 = (*c).cgak[snap + 1];
        let uor_dv: i64 = (*c).cgav[snap + 1];
        let uor_vld: i64 = cg_extract(c, uor_xt, uor_xk, uor_xv, 0);
        let uor_pay: i64 = cg_extract(c, uor_xt, uor_xk, uor_xv, 1);
        let uor_sel: i64 = cg_dst(c);
        cgo_str(c, "select i1 %v");
        cgo_int(c, uor_vld);
        cgo_str(c, ", ");
        cgo_ty(c, rty);
        cgo_str(c, " %v");
        cgo_int(c, uor_pay);
        cgo_str(c, ", ");
        cgo_ty(c, rty);
        cg_putc(c, ' ');
        cgo_operand(c, uor_dk, uor_dv);
        cg_putc(c, '\n');
        cg_reg(c, uor_sel);
        0
    } else if fid == 4 {
        // (8d) str_eq(a, b): decompose each [u8], call sentinel_str_eq -> i1.
        let s_ak: i64 = (*c).cgak[snap];
        let s_av: i64 = (*c).cgav[snap];
        let s_bk: i64 = (*c).cgak[snap + 1];
        let s_bv: i64 = (*c).cgav[snap + 1];
        let al: i64 = cg_lenptr(c, s_ak, s_av);
        let bl: i64 = cg_lenptr(c, s_bk, s_bv);
        let d2: i64 = cg_dst(c);
        cgo_str(c, "call i1 @sentinel_str_eq(ptr %v");
        cgo_int(c, al + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, al);
        cgo_str(c, ", ptr %v");
        cgo_int(c, bl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, bl);
        cgo_str(c, ")\n");
        (*c).cg_used_streq = true;
        cg_reg(c, d2);
        0
    } else if fid == 0 {
        // (Bar B) print(x): call sentinel_print(i64 x) -> i64.
        let pr_k: i64 = (*c).cgak[snap];
        let pr_v: i64 = (*c).cgav[snap];
        let pr_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_print(i64 ");
        cgo_operand(c, pr_k, pr_v);
        cgo_str(c, ")\n");
        (*c).cg_used_print = true;
        cg_reg(c, pr_d);
        0
    } else if fid == 13 {
        // (8d) print_bytes(d): decompose [u8], call sentinel_print_bytes -> i64.
        let p_dk: i64 = (*c).cgak[snap];
        let p_dv: i64 = (*c).cgav[snap];
        let pdl: i64 = cg_lenptr(c, p_dk, p_dv);
        let d3: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_print_bytes(ptr %v");
        cgo_int(c, pdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pdl);
        cgo_str(c, ")\n");
        (*c).cg_used_prbytes = true;
        cg_reg(c, d3);
        0
    } else if fid == 21 {
        // (ADR 0066 M1.2) channel_new() -> a Channel<i64> (ptr).
        let cn_d: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_channel_new()\n");
        (*c).cg_used_channelnew = true;
        cg_reg(c, cn_d);
        0
    } else if fid == 22 {
        // (ADR 0066 M1.2 / M1.2b-cont / M1.2c) send(ch, v) -> i64 status. ENCODE the
        // value into the channel's i64 slot by its element type (the M1.1 encode):
        // i64 no-op / i32,bool,u8 `zext` / a channel HANDLE (channel-of-channels)
        // `ptrtoint`. The encode is emitted HERE, before the send's own dst, so
        // register numbering matches the oracle. The `else` is the ptr/channel case.
        //
        // (ADR 0058 UPDATE, CORRECTED by the register-D17 review — this comment has
        // now named the wrong guard TWICE, so read the measurement, not the story.
        // It first said `f64` "has no scg handle so it cannot occur" (false: f64 is
        // scalar code 4). It then said every way to make an f64 value — a literal,
        // an `as f64` cast — is Err'd by the oracle before lowering. THAT IS ALSO
        // FALSE. The oracle Errs wherever an f64 TYPE must be RENDERED (`lty`), and
        // an element riding the i64 slot is never rendered: `shared_new(x as f64)`
        // lowers, the oracle emitting `bitcast double %v1 to i64`. The container
        // twin of this arm was measured diverging on exactly that shape. Assume the
        // same is reachable here until someone constructs the channel version and
        // shows otherwise. What IS verified: no corpus program has an f64 element,
        // the divergence is pre-existing, and the oracle's own f64 output is invalid
        // IR ("integer constant must have integer type"), which is why `llvm_rejects`
        // stays silent. If f64 values are ever ported, this arm and the `recv` twin
        // need a `bitcast` — NOT the pointer `ptrtoint`/`inttoptr` fallback, which on
        // a `double` is invalid IR rather than merely different bytes — AND `cgo_ty`
        // needs a real code-4 arm first, or the `bitcast` renders `i64` on both sides
        // and converts nothing.)
        //
        // ⚠ SECOND GAP IN THIS ARM, register-filed: it never calls `strip_secret`, so
        // a `secret` element (an interned HANDLE, not a scalar code) matches no arm
        // and falls to `ptrtoint`. `Channel<secret i64>` — which the ORACLE rejects
        // and scg accepts — emits `ptrtoint i64 -> i64`, which `llvm-as` rejects.
        // The container helpers strip first; this arm does not. Do not copy it.
        let cs_chk: i64 = (*c).cgak[snap];
        let cs_chv: i64 = (*c).cgav[snap];
        let cs_vk: i64 = (*c).cgak[snap + 1];
        let cs_vv: i64 = (*c).cgav[snap + 1];
        let cs_vt: i64 = (*c).cgat[snap + 1];
        let cs_enc: i64 = if cs_vt == 0 {
            0 - 1
        } else if cs_vt == 1 || cs_vt == 2 || cs_vt == 3 {
            cg_conv(c, "zext", cs_vt, cs_vk, cs_vv, 0)
        } else {
            cg_conv(c, "ptrtoint", cs_vt, cs_vk, cs_vv, 0)
        };
        let cs_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_channel_send(ptr ");
        cgo_operand(c, cs_chk, cs_chv);
        cgo_str(c, ", i64 ");
        if cs_enc == 0 - 1 {
            cgo_operand(c, cs_vk, cs_vv)
        } else {
            cgo_str(c, "%v");
            cgo_int(c, cs_enc)
        };
        cgo_str(c, ")\n");
        (*c).cg_used_channelsend = true;
        cg_reg(c, cs_d);
        0
    } else if fid == 23 {
        // (ADR 0066 M1.2 / M1.2b-cont / M1.2c) recv(ch) -> ?<elem>: read the i64
        // frame from a stack out-slot (always i64 — the runtime frame width is
        // fixed), DECODE it into the element (i64 no-op / i32,bool,u8 `trunc` / a
        // channel handle `inttoptr`), then build `{ i1 valid, <ety> value }`
        // (valid = status == 0). The element comes off recv's `?<elem>` return
        // type; `<ety>` (= `cgo_ty(elem)`) is `ptr` for a channel-of-channels
        // element, giving `{ i1, ptr }` = `?Channel`.
        let cr_elem: i64 = nullable_inner_of(c, rty);
        let cr_chk: i64 = (*c).cgak[snap];
        let cr_chv: i64 = (*c).cgav[snap];
        let cr_slot: i64 = cg_alloca(c, 0);
        let cr_status: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_channel_recv(ptr ");
        cgo_operand(c, cr_chk, cr_chv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, cr_slot);
        cgo_str(c, ")\n");
        (*c).cg_used_channelrecv = true;
        let cr_valid: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, cr_status);
        cgo_str(c, ", 0\n");
        let cr_raw: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, cr_slot);
        cg_putc(c, '\n');
        let cr_value: i64 = if cr_elem == 0 {
            cr_raw
        } else if cr_elem == 1 || cr_elem == 2 || cr_elem == 3 {
            cg_conv(c, "trunc", 0, 0, cr_raw, cr_elem)
        } else {
            // (ADR 0058) The decode twin of the `fid == 22` encode: handle 4
            // lands here too and would be decoded as a pointer. Same guard,
            // same residual -- see the note there.
            cg_conv(c, "inttoptr", 0, 0, cr_raw, cr_elem)
        };
        let cr_o0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ");
        cgo_ty(c, cr_elem);
        cgo_str(c, " } undef, i1 %v");
        cgo_int(c, cr_valid);
        cgo_str(c, ", 0\n");
        let cr_o1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ");
        cgo_ty(c, cr_elem);
        cgo_str(c, " } %v");
        cgo_int(c, cr_o0);
        cgo_str(c, ", ");
        cgo_ty(c, cr_elem);
        cgo_str(c, " %v");
        cgo_int(c, cr_value);
        cgo_str(c, ", 1\n");
        cg_reg(c, cr_o1);
        0
    } else if fid == 24 {
        // (ADR 0066 M1.2) channel_close(ch) -> i64 status.
        let cc_chk: i64 = (*c).cgak[snap];
        let cc_chv: i64 = (*c).cgav[snap];
        let cc_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_channel_close(ptr ");
        cgo_operand(c, cc_chk, cc_chv);
        cgo_str(c, ")\n");
        (*c).cg_used_channelclose = true;
        cg_reg(c, cc_d);
        0
    } else if fid == 25 {
        // (ADR 0066 M2.1) process_spawn(path: [u8], args: [[u8]]) -> Process (ptr).
        // Decompose path + args into (len, ptr) pairs (args ptr = argv element
        // buffer, args len = argc), then call sentinel_process_spawn.
        let ps_pk: i64 = (*c).cgak[snap];
        let ps_pv: i64 = (*c).cgav[snap];
        let ps_ak: i64 = (*c).cgak[snap + 1];
        let ps_av: i64 = (*c).cgav[snap + 1];
        let pspl: i64 = cg_lenptr(c, ps_pk, ps_pv);
        let psal: i64 = cg_lenptr(c, ps_ak, ps_av);
        let ps_d: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_process_spawn(ptr %v");
        cgo_int(c, pspl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pspl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, psal + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, psal);
        cgo_str(c, ")\n");
        (*c).cg_used_procspawn = true;
        cg_reg(c, ps_d);
        0
    } else if fid == 26 {
        // (ADR 0066 M2.1) process_wait(p) -> i64 exit code.
        let pw_pk: i64 = (*c).cgak[snap];
        let pw_pv: i64 = (*c).cgav[snap];
        let pw_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_process_wait(ptr ");
        cgo_operand(c, pw_pk, pw_pv);
        cgo_str(c, ")\n");
        (*c).cg_used_procwait = true;
        cg_reg(c, pw_d);
        0
    } else if fid == 27 {
        // (ADR 0066 M2.2) process_write(p, data: [u8]) -> i64. Decompose data
        // into (len, ptr) and call sentinel_process_write(p, ptr, len).
        let pwr_pk: i64 = (*c).cgak[snap];
        let pwr_pv: i64 = (*c).cgav[snap];
        let pwr_dk: i64 = (*c).cgak[snap + 1];
        let pwr_dv: i64 = (*c).cgav[snap + 1];
        let pwrdl: i64 = cg_lenptr(c, pwr_dk, pwr_dv);
        let pwr_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_process_write(ptr ");
        cgo_operand(c, pwr_pk, pwr_pv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pwrdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pwrdl);
        cgo_str(c, ")\n");
        (*c).cg_used_procwrite = true;
        cg_reg(c, pwr_d);
        0
    } else if fid == 28 {
        // (ADR 0066 M2.2) process_read(p) -> [u8]: call with an out-len alloca,
        // then reassemble {len, data} (the read_file shape).
        let prd_pk: i64 = (*c).cgak[snap];
        let prd_pv: i64 = (*c).cgav[snap];
        let prdslot: i64 = cg_alloca(c, 0);
        let prddata: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_process_read(ptr ");
        cgo_operand(c, prd_pk, prd_pv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, prdslot);
        cgo_str(c, ")\n");
        (*c).cg_used_procread = true;
        let prdlen: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, prdslot);
        cg_putc(c, '\n');
        let prda0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } undef, i64 %v");
        cgo_int(c, prdlen);
        cgo_str(c, ", 0\n");
        let prda1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } %v");
        cgo_int(c, prda0);
        cgo_str(c, ", ptr %v");
        cgo_int(c, prddata);
        cgo_str(c, ", 1\n");
        cg_reg(c, prda1);
        0
    } else if fid == 29 {
        // (ADR 0066 M2.3 / M2.3b, register D34) process_send(p, v: T) -> i64. Frame T
        // to the child's stdin as one i64; the cross-process twin of channel_send.
        // The element ENCODE is the same one the containers use — the frame is an i64
        // slot, so a narrower element is `zext`ed on the way in. Emitted BEFORE the
        // call's own dst so register numbering matches the oracle, exactly as fid 22
        // and the container constructors do.
        //
        // The element is the VALUE ARG's own type (`cgat[snap + 1]`), which is what the
        // oracle reads (`args[1].ty`) — NOT the Process, which carries no element.
        let pse_pk: i64 = (*c).cgak[snap];
        let pse_pv: i64 = (*c).cgav[snap];
        let pse_vk: i64 = (*c).cgak[snap + 1];
        let pse_vv: i64 = (*c).cgav[snap + 1];
        // ⚠ GATE THE ENCODE ON THE FENCE. `cg_container_encode` strips the `secret`
        // qualifier FIRST, which is right for a CONTAINER (a secret rides the i64 slot
        // and the taint stays in the type system) and WRONG here, because a secret may
        // not cross a process pipe at all — that is ADR 0066 D8, pinned by
        // `tests/ui/c66_process_channel_secret_fence.sentinel`.
        //
        // Measured: without this gate, D34 widened the failure mode of that fence in
        // `scg` from FAIL-CLOSED to FAIL-OPEN. Pre-D34 a `secret u8`/`i32`/`bool`
        // element emitted IR `llvm-as` rejects; the strip made all four secret scalars
        // emit clean, assembling IR instead. The oracle rejects every one of them, so
        // no such program is user-reachable or differentially compared — but turning a
        // security boundary from loud to silent is how this repo has been bitten twice,
        // and the gate costs nothing: all 9 corpus `process_send` programs, the pin,
        // the i64 control and the merged-compiler fixed point are byte-identical with
        // it in place.
        let pse_ety: i64 = (*c).cgat[snap + 1];
        let pse_enc: i64 = if is_process_channel_elem_h(pse_ety) {
            cg_container_encode(c, pse_ety, pse_vk, pse_vv)
        } else {
            0 - 1
        };
        let pse_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_process_send(ptr ");
        cgo_operand(c, pse_pk, pse_pv);
        cgo_str(c, ", i64 ");
        if pse_enc == 0 - 1 {
            cgo_operand(c, pse_vk, pse_vv)
        } else {
            cgo_str(c, "%v");
            cgo_int(c, pse_enc)
        };
        cgo_str(c, ")\n");
        (*c).cg_used_procsend = true;
        cg_reg(c, pse_d);
        0
    } else if fid == 30 {
        // (ADR 0066 M2.3 / M2.3b, register D34) process_recv(p) -> ?T: read one i64
        // frame to a stack slot, DECODE it into T, and build `{ i1 valid, T value }`
        // from the status (valid = 0). The cross-process twin of recv, and it borrows
        // that arm's shape exactly: the out-slot is `alloca i64` and the load is
        // `load i64` for EVERY element — the runtime frame is always an i64 — and only
        // the decoded value and the AGGREGATE are element-typed. The valid bit is
        // never converted.
        let prc_elem: i64 = nullable_inner_of(c, rty);
        let prc_pk: i64 = (*c).cgak[snap];
        let prc_pv: i64 = (*c).cgav[snap];
        let prc_slot: i64 = cg_alloca(c, 0);
        let prc_status: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_process_recv(ptr ");
        cgo_operand(c, prc_pk, prc_pv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, prc_slot);
        cgo_str(c, ")\n");
        (*c).cg_used_procrecv = true;
        let prc_valid: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, prc_status);
        cgo_str(c, ", 0\n");
        let prc_raw: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, prc_slot);
        cg_putc(c, '\n');
        let prc_value: i64 = cg_container_decode(c, prc_elem, prc_raw);
        let prc_o0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ");
        cgo_ty(c, prc_elem);
        cgo_str(c, " } undef, i1 %v");
        cgo_int(c, prc_valid);
        cgo_str(c, ", 0\n");
        let prc_o1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ");
        cgo_ty(c, prc_elem);
        cgo_str(c, " } %v");
        cgo_int(c, prc_o0);
        cgo_str(c, ", ");
        cgo_ty(c, prc_elem);
        cgo_str(c, " %v");
        cgo_int(c, prc_value);
        cgo_str(c, ", 1\n");
        cg_reg(c, prc_o1);
        0
    } else if fid == 31 {
        // (ADR 0066 M2.4a / ADR 0069) sealed_channel(p) -> SealedChannel: an
        // identity-ptr passthrough — both Process and SealedChannel lower to
        // the same opaque ptr, so re-typing is a pure value-level no-op (no
        // new instruction; mirrors the oracle's `return self.lower_expr(&args[0])`).
        // Re-thread the argument's own (kind, value) operand directly.
        (*c).cglk = (*c).cgak[snap];
        (*c).cglv = (*c).cgav[snap];
        0
    } else if fid == 32 {
        // (ADR 0066 M2.4a / ADR 0069) sealed_process(sc) -> Process: the
        // reverse bridge, same identity-ptr passthrough as fid 31.
        (*c).cglk = (*c).cgak[snap];
        (*c).cglv = (*c).cgav[snap];
        0
    } else if fid == 33 {
        // (ADR 0066 M2.4b) stdin_recv() -> ?i64: read one i64 frame from this
        // process's own stdin to a stack slot; build { i1 valid, i64 value }
        // from the status (valid = status == 0). The child-side twin of
        // recv/process_recv (no Process handle — this process's own stdin).
        let sir_slot: i64 = cg_alloca(c, 0);
        let sir_status: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_stdin_recv(ptr %v");
        cgo_int(c, sir_slot);
        cgo_str(c, ")\n");
        (*c).cg_used_stdinrecv = true;
        let sir_valid: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, sir_status);
        cgo_str(c, ", 0\n");
        let sir_value: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, sir_slot);
        cg_putc(c, '\n');
        let sir_o0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, i64 } undef, i1 %v");
        cgo_int(c, sir_valid);
        cgo_str(c, ", 0\n");
        let sir_o1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, i64 } %v");
        cgo_int(c, sir_o0);
        cgo_str(c, ", i64 %v");
        cgo_int(c, sir_value);
        cgo_str(c, ", 1\n");
        cg_reg(c, sir_o1);
        0
    } else if fid == 34 {
        // (ADR 0066 M2.4b) stdout_send(v: i64) -> i64. The child-side twin of
        // send/process_send (no Process handle — this process's own stdout).
        let sos_vk: i64 = (*c).cgak[snap];
        let sos_vv: i64 = (*c).cgav[snap];
        let sos_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_stdout_send(i64 ");
        cgo_operand(c, sos_vk, sos_vv);
        cgo_str(c, ")\n");
        (*c).cg_used_stdoutsend = true;
        cg_reg(c, sos_d);
        0
    } else if fid == 35 {
        // (ADR 0066 M2.4 follow-on) arg_count() -> i64: own argv length.
        let acnt_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_arg_count()\n");
        (*c).cg_used_argcount = true;
        cg_reg(c, acnt_d);
        0
    } else if fid == 36 {
        // (ADR 0066 M2.4 follow-on) arg(i: i64) -> [u8]: own argv[i], the
        // read_file/process_read result shape (a len out-slot + a data ptr).
        let arg_ik: i64 = (*c).cgak[snap];
        let arg_iv: i64 = (*c).cgav[snap];
        let arg_slot: i64 = cg_alloca(c, 0);
        let arg_data: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_arg(i64 ");
        cgo_operand(c, arg_ik, arg_iv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, arg_slot);
        cgo_str(c, ")\n");
        (*c).cg_used_arg = true;
        let arg_len: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, arg_slot);
        cg_putc(c, '\n');
        let arg_a0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } undef, i64 %v");
        cgo_int(c, arg_len);
        cgo_str(c, ", 0\n");
        let arg_a1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } %v");
        cgo_int(c, arg_a0);
        cgo_str(c, ", ptr %v");
        cgo_int(c, arg_data);
        cgo_str(c, ", 1\n");
        cg_reg(c, arg_a1);
        0
    } else if fid == 38 {
        // (ADR 0071 M1.4a / M1.4c, register D17) shared_new(v) -> Shared<T> (ptr):
        // allocate the refcounted cell (rc=1), ENCODING the value into the runtime's
        // i64 slot by its element type. The encode is emitted BEFORE the call's own
        // dst so register numbering matches the oracle, exactly as the `send` arm
        // does. An `i64` element encodes to -1 (no instruction), which is what keeps
        // every pre-existing program byte-identical.
        let sn_vk: i64 = (*c).cgak[snap];
        let sn_vv: i64 = (*c).cgav[snap];
        let sn_enc: i64 = cg_container_encode(c, (*c).cgat[snap], sn_vk, sn_vv);
        let sn_d: i64 = cg_dst(c);
        // (ADR 0071 M1.4c D6.2) a `secret T` payload goes to the mlocked,
        // zeroed-at-last-drop cell. `rt` is `Shared<elem>`; the element rides in
        // payload A. The VALUE encode is unchanged — a secret lowers identically to
        // its inner (erasure), so only the CONSTRUCTOR differs.
        let sn_sec: bool = is_secret_ty(c, container_elem(c, rty));
        if sn_sec {
            cgo_str(c, "call ptr @sentinel_shared_new_secret(i64 ");
            (*c).cg_used_sharednewsecret = true;
            0
        } else {
            cgo_str(c, "call ptr @sentinel_shared_new(i64 ");
            (*c).cg_used_sharednew = true;
            0
        };
        if sn_enc == 0 - 1 {
            cgo_operand(c, sn_vk, sn_vv)
        } else {
            cgo_str(c, "%v");
            cgo_int(c, sn_enc)
        };
        cgo_str(c, ")\n");
        cg_reg(c, sn_d);
        0
    } else if fid == 39 {
        // (ADR 0071 M1.4a / M1.4c, register D17) shared_get(s: Shared<T>) -> T: read
        // the cell's i64 slot, then DECODE it into the element. Returned DIRECTLY —
        // a `Shared` is always valid, so there is no `?T` wrapper to compose with,
        // unlike `recv`. The element is this call's RESULT type `rty` (the oracle
        // reads it from `type_args[0]`, which is the same thing); an `i64` element
        // decodes to the raw register itself, emitting nothing.
        let sg_sk: i64 = (*c).cgak[snap];
        let sg_sv: i64 = (*c).cgav[snap];
        let sg_raw: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_shared_get(ptr ");
        cgo_operand(c, sg_sk, sg_sv);
        cgo_str(c, ")\n");
        (*c).cg_used_sharedget = true;
        let sg_d: i64 = cg_container_decode(c, rty, sg_raw);
        cg_reg(c, sg_d);
        0
    } else if fid == 40 {
        // (ADR 0071 M1.4b / M1.4c, register D17) mutex_new(v) -> Mutex<T> (ptr):
        // allocate the refcounted, lock-protected cell (rc=1, unlocked), ENCODING the
        // value into the runtime's i64 slot exactly as `shared_new` does. `lock` (41)
        // needs no decode at all — its `?Guard` payload is the cell HANDLE (a ptr) for
        // every element, not the protected value.
        let mn_vk: i64 = (*c).cgak[snap];
        let mn_vv: i64 = (*c).cgav[snap];
        // (register D17) same element ENCODE as `shared_new` above.
        let mn_enc: i64 = cg_container_encode(c, (*c).cgat[snap], mn_vk, mn_vv);
        let mn_d: i64 = cg_dst(c);
        // (ADR 0071 M1.4c D6.2) mirrors shared_new: a `secret T` protected value
        // goes to the mlocked, zeroed-at-last-drop cell.
        let mn_sec: bool = is_secret_ty(c, container_elem(c, rty));
        if mn_sec {
            cgo_str(c, "call ptr @sentinel_mutex_new_secret(i64 ");
            (*c).cg_used_mutexnewsecret = true;
            0
        } else {
            cgo_str(c, "call ptr @sentinel_mutex_new(i64 ");
            (*c).cg_used_mutexnew = true;
            0
        };
        if mn_enc == 0 - 1 {
            cgo_operand(c, mn_vk, mn_vv)
        } else {
            cgo_str(c, "%v");
            cgo_int(c, mn_enc)
        };
        cgo_str(c, ")\n");
        cg_reg(c, mn_d);
        0
    } else if fid == 41 {
        // (ADR 0071 M1.4b) lock(m: Mutex<i64>) -> ?Guard: acquire (LockTimeout
        // tier), write the guard slot ptr to a stack out-slot, build `{ i1 valid,
        // ptr guard }` from the i64 status (valid = status == 0). The recv `?T`
        // shape with a ptr payload (a Guard lowers to a single ptr).
        //
        // slice 3b: the `?Guard` payload (field 1) is the mutex cell handle `m`, NOT
        // the loaded out-slot — the guard's scope-exit drop unlocks via that handle
        // (`sentinel_mutex_unlock`). The out-slot is still passed to the runtime (ABI),
        // but no longer LOADED here.
        let lk_mk: i64 = (*c).cgak[snap];
        let lk_mv: i64 = (*c).cgav[snap];
        let lk_slot: i64 = cg_alloca_ptr(c);
        let lk_status: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_mutex_lock(ptr ");
        cgo_operand(c, lk_mk, lk_mv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, lk_slot);
        cgo_str(c, ")\n");
        (*c).cg_used_mutexlock = true;
        let lk_valid: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, lk_status);
        cgo_str(c, ", 0\n");
        let lk_o0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ptr } undef, i1 %v");
        cgo_int(c, lk_valid);
        cgo_str(c, ", 0\n");
        let lk_o1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, ptr } %v");
        cgo_int(c, lk_o0);
        cgo_str(c, ", ptr ");
        cgo_operand(c, lk_mk, lk_mv);
        cgo_str(c, ", 1\n");
        cg_reg(c, lk_o1);
        0
    } else if fid == 12 {
        // (8d) write_file(path, data) -> i64.
        let w_pk: i64 = (*c).cgak[snap];
        let w_pv: i64 = (*c).cgav[snap];
        let w_dk: i64 = (*c).cgak[snap + 1];
        let w_dv: i64 = (*c).cgav[snap + 1];
        let wpl: i64 = cg_lenptr(c, w_pk, w_pv);
        let wdl: i64 = cg_lenptr(c, w_dk, w_dv);
        let d4: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_write_file(ptr %v");
        cgo_int(c, wpl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, wpl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, wdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, wdl);
        cgo_str(c, ")\n");
        (*c).cg_used_wrfile = true;
        cg_reg(c, d4);
        0
    } else if fid == 11 {
        // (8d) read_file(path) -> [u8]: call, then reassemble {len, data}.
        let r_pk: i64 = (*c).cgak[snap];
        let r_pv: i64 = (*c).cgav[snap];
        let rpl: i64 = cg_lenptr(c, r_pk, r_pv);
        let rslot: i64 = cg_alloca(c, 0);
        let rdata: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_read_file(ptr %v");
        cgo_int(c, rpl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, rpl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, rslot);
        cgo_str(c, ")\n");
        (*c).cg_used_rdfile = true;
        let rrlen: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, rslot);
        cg_putc(c, '\n');
        let ra0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } undef, i64 %v");
        cgo_int(c, rrlen);
        cgo_str(c, ", 0\n");
        let ra1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } %v");
        cgo_int(c, ra0);
        cgo_str(c, ", ptr %v");
        cgo_int(c, rdata);
        cgo_str(c, ", 1\n");
        cg_reg(c, ra1);
        0
    } else if fid == 7 {
        // (8d-Vec) vec_new() = the empty-Vec constant operand (kind 2).
        (*c).cglk = 2;
        (*c).cglv = 0;
        0
    } else if fid == 8 {
        // (8d-Vec) push(&mut v, x): grow if len==cap (realloc), store x, bump len.
        // Returns i64 0. Field GEPs through the &mut Vec pointer (cgak[snap]).
        let pu_pk: i64 = (*c).cgak[snap];
        let pu_pv: i64 = (*c).cgav[snap];
        let pu_rt: i64 = (*c).cgat[snap];
        let pu_xk: i64 = (*c).cgak[snap + 1];
        let pu_xv: i64 = (*c).cgav[snap + 1];
        let pu_sr: i64 = strip_ref(c, pu_rt);
        let pu_e: i64 = vec_elem_of(c, pu_sr);
        let pu_lp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, pu_pk, pu_pv);
        cgo_str(c, ", i32 0, i32 0\n");
        let pu_dp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, pu_pk, pu_pv);
        cgo_str(c, ", i32 0, i32 2\n");
        let pu_cp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, pu_pk, pu_pv);
        cgo_str(c, ", i32 0, i32 1\n");
        let pu_lv: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, pu_lp);
        cg_putc(c, '\n');
        let pu_cv: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, pu_cp);
        cg_putc(c, '\n');
        let pu_ng: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, pu_lv);
        cgo_str(c, ", %v");
        cgo_int(c, pu_cv);
        cg_putc(c, '\n');
        let pu_gb: i64 = cg_fresh_block(c);
        let pu_cb: i64 = cg_fresh_block(c);
        cgo_str(c, "  br i1 %v");
        cgo_int(c, pu_ng);
        cgo_str(c, ", label %bb");
        cgo_int(c, pu_gb);
        cgo_str(c, ", label %bb");
        cgo_int(c, pu_cb);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, pu_gb);
        cgo_str(c, ":\n");
        let pu_od: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, pu_dp);
        cg_putc(c, '\n');
        let pu_cx: i64 = cg_dst(c);
        cgo_str(c, "mul i64 %v");
        cgo_int(c, pu_cv);
        cgo_str(c, ", 2\n");
        let pu_cz: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, pu_cv);
        cgo_str(c, ", 0\n");
        let pu_nc: i64 = cg_dst(c);
        cgo_str(c, "select i1 %v");
        cgo_int(c, pu_cz);
        cgo_str(c, ", i64 1, i64 %v");
        cgo_int(c, pu_cx);
        cg_putc(c, '\n');
        let pu_sz: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, pu_e);
        cgo_str(c, ", ptr null, i64 1\n");
        let pu_szi: i64 = cg_dst(c);
        cgo_str(c, "ptrtoint ptr %v");
        cgo_int(c, pu_sz);
        cgo_str(c, " to i64\n");
        let pu_ns: i64 = cg_dst(c);
        cgo_str(c, "mul i64 %v");
        cgo_int(c, pu_nc);
        cgo_str(c, ", %v");
        cgo_int(c, pu_szi);
        cg_putc(c, '\n');
        let pu_nd: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_realloc(ptr %v");
        cgo_int(c, pu_od);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pu_ns);
        cgo_str(c, ")\n");
        (*c).cg_used_realloc = true;
        cgo_str(c, "  store i64 %v");
        cgo_int(c, pu_nc);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_cp);
        cg_putc(c, '\n');
        cgo_str(c, "  store ptr %v");
        cgo_int(c, pu_nd);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_dp);
        cg_putc(c, '\n');
        cgo_str(c, "  br label %bb");
        cgo_int(c, pu_cb);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, pu_cb);
        cgo_str(c, ":\n");
        let pu_dd: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, pu_dp);
        cg_putc(c, '\n');
        let pu_sl: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, pu_e);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_dd);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pu_lv);
        cg_putc(c, '\n');
        cgo_str(c, "  store ");
        cgo_ty(c, pu_e);
        cg_putc(c, ' ');
        cgo_operand(c, pu_xk, pu_xv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_sl);
        cg_putc(c, '\n');
        let pu_nl: i64 = cg_dst(c);
        cgo_str(c, "add i64 %v");
        cgo_int(c, pu_lv);
        cgo_str(c, ", 1\n");
        cgo_str(c, "  store i64 %v");
        cgo_int(c, pu_nl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_lp);
        cg_putc(c, '\n');
        (*c).cglk = 1;
        (*c).cglv = 0;
        0
    } else if fid == 9 {
        // (8d-Vec) pop(&mut v) -> T: empty-check (OOB trap), decrement len, return
        // data[len-1].
        let po_pk: i64 = (*c).cgak[snap];
        let po_pv: i64 = (*c).cgav[snap];
        let po_rt: i64 = (*c).cgat[snap];
        let po_sr: i64 = strip_ref(c, po_rt);
        let po_e: i64 = vec_elem_of(c, po_sr);
        let po_lp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, po_pk, po_pv);
        cgo_str(c, ", i32 0, i32 0\n");
        let po_dp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, po_pk, po_pv);
        cgo_str(c, ", i32 0, i32 2\n");
        let po_lv: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, po_lp);
        cg_putc(c, '\n');
        let po_nl: i64 = cg_dst(c);
        cgo_str(c, "sub i64 %v");
        cgo_int(c, po_lv);
        cgo_str(c, ", 1\n");
        let po_ne: i64 = cg_dst(c);
        cgo_str(c, "icmp sge i64 %v");
        cgo_int(c, po_nl);
        cgo_str(c, ", 0\n");
        let po_ok: i64 = cg_fresh_block(c);
        let po_em: i64 = cg_fresh_block(c);
        cgo_str(c, "  br i1 %v");
        cgo_int(c, po_ne);
        cgo_str(c, ", label %bb");
        cgo_int(c, po_ok);
        cgo_str(c, ", label %bb");
        cgo_int(c, po_em);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, po_em);
        cgo_str(c, ":\n");
        cgo_str(c, "  call void @sentinel_panic_oob(i64 %v");
        cgo_int(c, po_nl);
        cgo_str(c, ", i64 %v");
        cgo_int(c, po_lv);
        cgo_str(c, ")\n");
        (*c).cg_used_panic = true;
        cgo_str(c, "  unreachable\n");
        cgo_str(c, "bb");
        cgo_int(c, po_ok);
        cgo_str(c, ":\n");
        let po_dd: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, po_dp);
        cg_putc(c, '\n');
        let po_ep: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, po_e);
        cgo_str(c, ", ptr %v");
        cgo_int(c, po_dd);
        cgo_str(c, ", i64 %v");
        cgo_int(c, po_nl);
        cg_putc(c, '\n');
        let po_ev: i64 = cg_dst(c);
        cgo_str(c, "load ");
        cgo_ty(c, po_e);
        cgo_str(c, ", ptr %v");
        cgo_int(c, po_ep);
        cg_putc(c, '\n');
        cgo_str(c, "  store i64 %v");
        cgo_int(c, po_nl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, po_lp);
        cg_putc(c, '\n');
        cg_reg(c, po_ev);
        0
    } else if fid == 10 {
        // (8d-Vec-2) vec_to_array(v: Vec<T>) -> [T]: copy the live `len` elements
        // into a fresh heap buffer, build an owned [T] { i64 len, ptr data }. The
        // Vec is passed by VALUE ({i64,i64,ptr}), so `data` is field 2. Non-consuming
        // — the array is an independent copy, so both drop their buffers at scope exit.
        let vt_vk: i64 = (*c).cgak[snap];
        let vt_vv: i64 = (*c).cgav[snap];
        let vt_rt: i64 = (*c).cgat[snap];
        let vt_e: i64 = vec_elem_of(c, vt_rt);
        let vt_len: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, i64, ptr } ");
        cgo_operand(c, vt_vk, vt_vv);
        cgo_str(c, ", 0\n");
        let vt_src: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, i64, ptr } ");
        cgo_operand(c, vt_vk, vt_vv);
        cgo_str(c, ", 2\n");
        let vt_sz: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, vt_e);
        cgo_str(c, ", ptr null, i64 %v");
        cgo_int(c, vt_len);
        cg_putc(c, '\n');
        let vt_szi: i64 = cg_dst(c);
        cgo_str(c, "ptrtoint ptr %v");
        cgo_int(c, vt_sz);
        cgo_str(c, " to i64\n");
        let vt_dest: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
        cgo_int(c, vt_szi);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        cgo_str(c, "  call void @llvm.memcpy.p0.p0.i64(ptr %v");
        cgo_int(c, vt_dest);
        cgo_str(c, ", ptr %v");
        cgo_int(c, vt_src);
        cgo_str(c, ", i64 %v");
        cgo_int(c, vt_szi);
        cgo_str(c, ", i1 false)\n");
        (*c).cg_used_memcpy = true;
        let vt_a0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } undef, i64 %v");
        cgo_int(c, vt_len);
        cgo_str(c, ", 0\n");
        let vt_a1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } %v");
        cgo_int(c, vt_a0);
        cgo_str(c, ", ptr %v");
        cgo_int(c, vt_dest);
        cgo_str(c, ", 1\n");
        cg_reg(c, vt_a1);
        0
    } else if fid >= 42 {
        // (Bar B / effects c35b) a call to an effecting fn yields a Kont* (`ptr`), not
        // its declared return type — and a tail effecting-call makes the caller's tail
        // kont-producing (so an enclosing effecting fn returns it as-is).
        let efc: bool = (*c).ufeff[fid - 42] != 0;
        let d: i64 = cg_dst(c);
        cgo_str(c, "call ");
        if efc {
            cgo_str(c, "ptr")
        } else {
            cgo_ty(c, rty)
        };
        cgo_str(c, " @");
        let us: i64 = (*c).ufs[fid - 42];
        let ue: i64 = (*c).ufe[fid - 42];
        cgo_slice(c, src, us, ue);
        // (Bar B / generics-b) a generic callee resolves to its monomorphic symbol
        // `name__<arg0>__…`; `cg_targs` was set by the preceding `dump_generic_call`.
        if (*c).uftp[fid - 42] > 0 {
            let ctargs: Vec<i64> = cg_copy_targs(c, 1);
            cg_emit_mono_suffix(c, &ctargs);
            0
        } else {
            0
        };
        cg_putc(c, '(');
        let n: i64 = len((*c).cgak);
        let mut i: i64 = snap;
        let mut first: bool = true;
        while i < n {
            if first {
                first = false;
                0
            } else {
                cgo_str(c, ", ");
                0
            };
            let aty: i64 = (*c).cgat[i];
            let aok: i64 = (*c).cgak[i];
            let aov: i64 = (*c).cgav[i];
            cgo_ty(c, aty);
            cg_putc(c, ' ');
            cgo_operand(c, aok, aov);
            i = i + 1;
        }
        cg_putc(c, ')');
        cg_putc(c, '\n');
        cg_reg(c, d);
        (*c).cg_tailk = efc;
        0
    } else {
        0
    };
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    0
}

// `define <ret> @<name>(<ptys> %argN) {\nentry:\n` + each param's alloca + store.
// Called after the params are parsed (slots reserved + types in `cgpty` by the
// emit_tparams hook) and `rty` known, before the body walk.
// Teardown: ASSEMBLE the fn into cgout — the `define` header, the entry block (the
// HOISTED allocas first), the buffered body (cgbody), then the return + `}`. Called
// after the body walk; flips cg_putc to target cgout. The body's value (`cglast`) is
// the fn's return (captured first — the header/ret emission advances cgnext for main's
// trunc temp, which must continue after the body's numbering).

// (8c-1) `  %vD = extractvalue <ty> <op>, <idx>` (a struct field read); sets the
// threaded operand to the dest register.
fn cg_extract(c: &mut TyCtx, tyh: i64, opk: i64, opv: i64, idx: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tyh);
    cg_putc(c, ' ');
    cgo_operand(c, opk, opv);
    cgo_str(c, ", ");
    cgo_int(c, idx);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// (8c-1) emit a struct literal's `insertvalue` chain over the field operands
// collected on the arg stacks since `snap` (building from `undef`); sets the
// threaded operand to the final aggregate register; pops the stacks back to `snap`.
// (`(*c).cgat[i]` is bound to a local before `cgo_ty` — passing it inline while `c`
// is `&mut` re-borrows `c`, the A2 quirk.)
fn cg_emit_structlit(c: &mut TyCtx, styh: i64, snap: i64) -> i64 {
    let n: i64 = len((*c).cgak);
    let mut prev: i64 = 0 - 1;
    let mut idx: i64 = 0;
    let mut i: i64 = snap;
    while i < n {
        let d: i64 = cg_dst(c);
        cgo_str(c, "insertvalue ");
        cgo_ty(c, styh);
        cg_putc(c, ' ');
        if prev < 0 {
            cgo_str(c, "undef")
        } else {
            cgo_str(c, "%v");
            cgo_int(c, prev)
        };
        cgo_str(c, ", ");
        let aty: i64 = (*c).cgat[i];
        cgo_ty(c, aty);
        cg_putc(c, ' ');
        let aok: i64 = (*c).cgak[i];
        let aov: i64 = (*c).cgav[i];
        cgo_operand(c, aok, aov);
        cgo_str(c, ", ");
        cgo_int(c, idx);
        cg_putc(c, '\n');
        prev = d;
        idx = idx + 1;
        i = i + 1;
    }
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, prev)
}

// (8d) decompose a `[u8]`/`{ i64, ptr }` operand into its (len, ptr) for a runtime
// builtin: emit `%vL = extractvalue { i64, ptr } <op>, 0` then `%v(L+1) =
// extractvalue …, 1`; return L (the len reg; the ptr reg is L+1, the very next).
fn cg_lenptr(c: &mut TyCtx, opk: i64, opv: i64) -> i64 {
    let l: i64 = cg_dst(c);
    cgo_str(c, "extractvalue { i64, ptr } ");
    cgo_operand(c, opk, opv);
    cgo_str(c, ", 0\n");
    let _p: i64 = cg_dst(c);
    cgo_str(c, "extractvalue { i64, ptr } ");
    cgo_operand(c, opk, opv);
    cgo_str(c, ", 1\n");
    l
}

// (8c-2) emit an array literal: heap alloc (`n * sizeof(elem)` via the GEP-sizeof
// idiom + `sentinel_alloc`) + per-element GEP-store over the operands collected
// since `snap` + the abi-v1 `{ i64 len, ptr data }`. Sets the threaded operand to
// the aggregate register; pops the arg stacks back to `snap`.
fn cg_emit_arraylit(c: &mut TyCtx, ety: i64, snap: i64) -> i64 {
    let top: i64 = len((*c).cgak);
    let n: i64 = top - snap;
    let sz: i64 = cg_dst(c);
    cgo_str(c, "getelementptr ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr null, i64 ");
    cgo_int(c, n);
    cg_putc(c, '\n');
    let szi: i64 = cg_dst(c);
    cgo_str(c, "ptrtoint ptr %v");
    cgo_int(c, sz);
    cgo_str(c, " to i64\n");
    let data: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
    cgo_int(c, szi);
    cgo_str(c, ")\n");
    (*c).cg_used_alloc = true;
    let mut i: i64 = snap;
    let mut ix: i64 = 0;
    while i < top {
        let ep: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, ety);
        cgo_str(c, ", ptr %v");
        cgo_int(c, data);
        cgo_str(c, ", i64 ");
        cgo_int(c, ix);
        cg_putc(c, '\n');
        cgo_str(c, "  store ");
        cgo_ty(c, ety);
        cg_putc(c, ' ');
        let ek: i64 = (*c).cgak[i];
        let ev: i64 = (*c).cgav[i];
        cgo_operand(c, ek, ev);
        cgo_str(c, ", ptr %v");
        cgo_int(c, ep);
        cg_putc(c, '\n');
        i = i + 1;
        ix = ix + 1;
    }
    let a0: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i64, ptr } undef, i64 ");
    cgo_int(c, n);
    cgo_str(c, ", 0\n");
    let a1: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i64, ptr } %v");
    cgo_int(c, a0);
    cgo_str(c, ", ptr %v");
    cgo_int(c, data);
    cgo_str(c, ", 1\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, a1)
}

// (8c-2) emit `a[i]`: extract len(0)/data(1), bounds-check (0 <= i < len, else
// `sentinel_panic_oob` + `unreachable`), then GEP+load. Sets the operand to the
// loaded value. Blocks: oob first (dead-ends), ok second (continues).
fn cg_emit_index(c: &mut TyCtx, ety: i64, tty: i64, tk: i64, tv: i64, ik: i64, iv: i64) -> i64 {
    // `a[i]` read: the bounds-checked element GEP, then a load. The GEP is
    // factored (`cg_emit_index_addr`) so index-assignment `a[i] = v;` (ADR 0050)
    // reuses the identical address computation and stores instead.
    let ep: i64 = cg_emit_index_addr(c, ety, tty, tk, tv, ik, iv);
    let v: i64 = cg_dst(c);
    cgo_str(c, "load ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr %v");
    cgo_int(c, ep);
    cg_putc(c, '\n');
    cg_reg(c, v)
}

// The bounds-checked element GEP shared by `a[i]` (read) and `a[i] = v;` (ADR
// 0050 index-assign): extract len(0)/data(1 for `[T]`, 2 for `Vec<T>`), check
// `0 <= i < len` (else `sentinel_panic_oob` + unreachable), then GEP in the
// in-bounds block. Returns the element-pointer register `ep` — the caller loads
// through it (read) or stores through it (write).
fn cg_emit_index_addr(c: &mut TyCtx, ety: i64, tty: i64, tk: i64, tv: i64, ik: i64, iv: i64) -> i64 {
    // `<agg>` is the target's actual type (`{i64,ptr}` for `[T]` with data at field 1,
    // `{i64,i64,ptr}` for `Vec<T>` with data at field 2; len is field 0 for both).
    let ln: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tty);
    cg_putc(c, ' ');
    cgo_operand(c, tk, tv);
    cgo_str(c, ", 0\n");
    let dat: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tty);
    cg_putc(c, ' ');
    cgo_operand(c, tk, tv);
    cgo_str(c, ", ");
    if cg_is_vec(c, tty) {
        cgo_int(c, 2)
    } else {
        cgo_int(c, 1)
    };
    cg_putc(c, '\n');
    let ge: i64 = cg_dst(c);
    cgo_str(c, "icmp sge i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", 0\n");
    let lt: i64 = cg_dst(c);
    cgo_str(c, "icmp slt i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", %v");
    cgo_int(c, ln);
    cg_putc(c, '\n');
    let inb: i64 = cg_dst(c);
    cgo_str(c, "and i1 %v");
    cgo_int(c, ge);
    cgo_str(c, ", %v");
    cgo_int(c, lt);
    cg_putc(c, '\n');
    let oob: i64 = cg_fresh_block(c);
    let ok: i64 = cg_fresh_block(c);
    cgo_str(c, "  br i1 %v");
    cgo_int(c, inb);
    cgo_str(c, ", label %bb");
    cgo_int(c, ok);
    cgo_str(c, ", label %bb");
    cgo_int(c, oob);
    cg_putc(c, '\n');
    cgo_str(c, "bb");
    cgo_int(c, oob);
    cgo_str(c, ":\n");
    cgo_str(c, "  call void @sentinel_panic_oob(i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", i64 %v");
    cgo_int(c, ln);
    cgo_str(c, ")\n");
    (*c).cg_used_panic = true;
    cgo_str(c, "  unreachable\n");
    cgo_str(c, "bb");
    cgo_int(c, ok);
    cgo_str(c, ":\n");
    let ep: i64 = cg_dst(c);
    cgo_str(c, "getelementptr ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr %v");
    cgo_int(c, dat);
    cgo_str(c, ", i64 ");
    cgo_operand(c, ik, iv);
    cg_putc(c, '\n');
    ep
}

fn cg_emit_fn(c: &mut TyCtx, src: &[u8], name_s: i64, name_e: i64, rty: i64) -> i64 {
    let bk: i64 = (*c).cglk;
    let bv: i64 = (*c).cglv;
    (*c).cg_to_body = false;
    cgo_str(c, "define ");
    if (*c).cgmain {
        cgo_str(c, "i32")
    } else if (*c).cg_eff {
        // (Bar B / effects c35b) effecting fn — the Kont* ABI returns `ptr`.
        cgo_str(c, "ptr")
    } else {
        cgo_ty(c, rty)
    };
    cgo_str(c, " @");
    cgo_slice(c, src, name_s, name_e);
    // (Bar B / generics-b) a monomorphic instance's symbol is `name__<arg0>__…`.
    if (*c).cg_mono_on {
        let margs: Vec<i64> = cg_copy_targs(c, 0);
        cg_emit_mono_suffix(c, &margs);
        0
    } else {
        0
    };
    cg_putc(c, '(');
    let np: i64 = len((*c).cgpty);
    let mut i: i64 = 0;
    while i < np {
        if i > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        let pty: i64 = (*c).cgpty[i];
        cgo_ty(c, pty);
        cgo_str(c, " %arg");
        cgo_int(c, i);
        i = i + 1;
    }
    cgo_str(c, ") {\nentry:\n");
    // the HOISTED allocas (params + lets + if-results), in reservation order.
    let na: i64 = len((*c).cgalloca_sl);
    let mut ai: i64 = 0;
    while ai < na {
        let asl: i64 = (*c).cgalloca_sl[ai];
        let aty: i64 = (*c).cgalloca_ty[ai];
        cgo_str(c, "  %v");
        cgo_int(c, asl);
        cgo_str(c, " = alloca ");
        if aty == 0 - 2 {
            cgo_str(c, "ptr")
        } else {
            cgo_ty(c, aty)
        };
        cg_putc(c, '\n');
        ai = ai + 1;
    }
    // the buffered body (cgbody) — folded into cgout via the builtin push.
    let nb: i64 = len((*c).cgbody);
    let mut bi: i64 = 0;
    while bi < nb {
        let byte: u8 = (*c).cgbody[bi];
        push(&mut (*c).cgout, byte);
        bi = bi + 1;
    }
    // the return (main truncates its i64 body to i32 — the C ABI).
    if (*c).cgmain {
        let d: i64 = cg_dst(c);
        cgo_str(c, "trunc i64 ");
        cgo_operand(c, bk, bv);
        cgo_str(c, " to i32\n");
        cgo_str(c, "  ret i32 %v");
        cgo_int(c, d);
        cg_putc(c, '\n');
        0
    } else if (*c).cg_eff {
        // (Bar B / effects c35b) the Kont* ABI: a kont-producing tail (direct perform /
        // call-to-effecting) returns as-is; a pure tail is wrapped as a PURE_RETURN kont
        // (`sentinel_kont_pure`) so the caller's `handle` sees a uniform Kont*.
        if (*c).cg_tailk {
            cgo_str(c, "  ret ptr ");
            cgo_operand(c, bk, bv);
            cg_putc(c, '\n');
            0
        } else {
            let kp: i64 = cg_dst(c);
            cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
            cgo_operand(c, bk, bv);
            cgo_str(c, ")\n");
            (*c).cg_used_kontpure = true;
            cgo_str(c, "  ret ptr %v");
            cgo_int(c, kp);
            cg_putc(c, '\n');
            0
        }
    } else {
        cgo_str(c, "  ret ");
        cgo_ty(c, rty);
        cg_putc(c, ' ');
        cgo_operand(c, bk, bv);
        cg_putc(c, '\n');
        0
    };
    cgo_str(c, "}\n\n");
    0
}

// (Bar B / effects c35c) emit the hoisted entry-block allocas (cgalloca_sl/_ty, in
// reservation order) then fold the buffered body (cgbody) — the shared tail of a
// `define` assembly. Assumes `cg_to_body` is already false (output routes to cgout).
fn cg_flush_allocas_body(c: &mut TyCtx) -> i64 {
    let na: i64 = len((*c).cgalloca_sl);
    let mut ai: i64 = 0;
    while ai < na {
        let asl: i64 = (*c).cgalloca_sl[ai];
        let aty: i64 = (*c).cgalloca_ty[ai];
        cgo_str(c, "  %v");
        cgo_int(c, asl);
        cgo_str(c, " = alloca ");
        if aty == 0 - 2 {
            cgo_str(c, "ptr")
        } else {
            cgo_ty(c, aty)
        };
        cg_putc(c, '\n');
        ai = ai + 1;
    }
    let nb: i64 = len((*c).cgbody);
    let mut bi: i64 = 0;
    while bi < nb {
        let byte: u8 = (*c).cgbody[bi];
        push(&mut (*c).cgout, byte);
        bi = bi + 1;
    }
    0
}

// (Bar B / effects c35c) emit an EFFECTING fn (Kont* ABI). A let-bound-perform body
// (`{ let v: i64 = perform …; <pure tail> }`) reifies a captured frame → a RESUMER fn +
// a parent (`cg_letshape_emit`, two defines); any OTHER effecting body (a pure / direct-
// perform / call-to-effecting tail, no statements — c32/c33/c35b) walks + assembles
// straight-line (`cg_eff_normal`). Mirrors the oracle's `dump_fn_named` routing through
// `detect_let_shape`. Consumes `body`. `[pv0,pvn)` = the fn's param VarId range (the
// let-shape capture set). The let-shape is matched structurally (single `let` with a
// `perform` RHS).
//
// ⚠ THAT STRUCTURAL MATCH IS NOT ENOUGH, and the comment that used to sit here said it
// was — "every effecting fn the oracle EMITS with a performing statement is a let-shape,
// so scg need not re-check the i64 / pure-tail conditions". Both halves of that are
// wrong. `validate_effecting_fn_body` only defers a statement that PERFORMS, and
// `stmt_performs` does not count a CALL to an effecting fn — so
// `fn caller() -> i64 ! { Io } { let s: <ann> = do_work(); … }` reaches the oracle's
// emitter. And `detect_let_shape` keys on the LET'S TYPE
// (`if ty != Type::I64 { return None; }`), so annotating that binding `secret i64` or
// `?i64` makes the ORACLE drop the let-shape and lower straight-line while scg still
// emits the `kont_push` + `__resume_caller` split — a byte divergence on a program the
// oracle accepts (exit 0), i.e. NOT excused by the differential.
// Both sides are wrong there, which is why this is a comment and not a one-line guard:
// the oracle's straight-line output does not assemble either (`store i64 %v0` where
// `%v0 = call ptr @do_work()`), so it silently treats the callee's `Kont*` as an `i64`.
// Fixing it means deciding what that shape should lower to, on BOTH sides — tracked as
// its own item. Nothing in the corpus reaches it today.
fn cg_emit_fn_eff(out: &mut Vec<u8>, c: &mut TyCtx, body: Expr, rty: i64, src: &[u8], name_s: i64, name_e: i64, cgpmark: i64, pv0: i64, pvn: i64, gb: &mut Vec<u8>, embed: Args, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, body_tok0: i64) -> i64 {
    // (The Sentinel match grammar has no bind-the-whole-value pattern — only
    // `Enum::Variant(..)` + `_`. So the non-let-shape branches re-wrap the moved-out
    // parts and fall through to `cg_eff_normal`; `Stmts`/`Stmt` are fully enumerated.)
    match body {
        Expr::Block(stmts, tail) => {
            match stmts {
                Stmts::SEnd => {
                    // No statements — the c35b shape (pure / perform / call-to-effecting
                    // tail), or the c35d EMBEDDED-perform shape (`embed` carries the
                    // unique perform, extracted from the classification copy).
                    match embed {
                        Args::Cell(pf, erest) => {
                            let _er: Args = erest;
                            cg_embed_emit(out, c, pf, tail, rty, src, name_s, name_e, pv0, pvn, gb)
                        },
                        Args::End => {
                            let b0: Expr = Expr::Block(Stmts::SEnd, tail);
                            cg_eff_normal(out, c, b0, rty, src, name_s, name_e, cgpmark, gb)
                        },
                    }
                },
                Stmts::SCell(st, rest) => {
                    match rest {
                        Stmts::SEnd => {
                            // Exactly one statement. A single `let` in an EMITTED effecting fn
                            // is TREATED AS the c35c let-bound-perform shape → walk its RHS as
                            // the perform. See the ⚠ on `cg_emit_fn_eff` above for where that
                            // assumption breaks: a call-to-effecting RHS under a non-`i64`
                            // annotation reaches the oracle, which then does NOT take the
                            // let-shape. `lty` is the type to guard on if this is ever fixed.
                            match st {
                                Stmt::SLet(lmf, lnm, lty, lval) => {
                                    cg_letshape_emit(out, c, lnm, lty, lval, tail, rty, src, name_s, name_e, pv0, pvn, gb)
                                },
                                Stmt::SAssign(at, av) => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SAssign(at, av), Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SWhile(wc, wb) => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SWhile(wc, wb), Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SBreak => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SBreak, Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SContinue => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SContinue, Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                                Stmt::SExpr(ex) => {
                                    let b1: Expr = Expr::Block(Stmts::SCell(Stmt::SExpr(ex), Stmts::SEnd), tail);
                                    cg_eff_normal(out, c, b1, rty, src, name_s, name_e, cgpmark, gb)
                                },
                            }
                        },
                        Stmts::SCell(s2, r2) => {
                            // 2+ statements — the c35e CHAINED-effecting-lets shape (every
                            // EMITTED 2+-stmt effecting fn is chained lets: the oracle's
                            // `validate_effecting_fn_body` defers all other 2+-stmt
                            // performing bodies, and no 2+-pure-stmt effecting fn is in the
                            // emitted corpus). Re-wrap the moved-out chain + thread it to
                            // `cg_chained_emit`, which lowers each let's RHS into its own
                            // resumer (N+1 defines) + re-parses copies for the capture sets.
                            let b2: Expr = Expr::Block(Stmts::SCell(st, Stmts::SCell(s2, r2)), tail);
                            cg_chained_emit(out, c, b2, rty, src, name_s, name_e, pv0, pvn, gb, k, s, e, body_tok0)
                        },
                    }
                },
            }
        },
        _ => {
            // A fn body is always a `Block` (parse_block); this arm is unreachable.
            0
        },
    }
}

// (Bar B / effects c35c) a non-let-shape effecting body (c32/c33/c35b): the straight-line
// walk + the standard single-define assembly (the c35b path — `cg_emit_fn` wraps a pure
// tail via `kont_pure`, or returns the kont tail directly).
fn cg_eff_normal(out: &mut Vec<u8>, c: &mut TyCtx, body: Expr, rty: i64, src: &[u8], name_s: i64, name_e: i64, cgpmark: i64, gb: &mut Vec<u8>) -> i64 {
    dump_texpr(out, body, rty, src, c, gb);
    cg_drop_frame(c, cgpmark);
    cg_emit_fn(c, src, name_s, name_e, rty);
    0
}

// (Bar B / effects c35c / ADR 0020 D7) emit a let-bound-perform effecting fn as TWO
// defines (mirror the oracle's `dump_let_shape_fn` / inkwell `compile_effecting_fn_with_
// let`). The PARENT's params are ALREADY set up (emit_tparams ran — cgbody has the param
// stores, cg slots set, the register counter at #params); here it fills the captured-
// state struct (i64[N], one field per param — the capture set; `null` if none), lowers
// the RHS perform to a Kont*, `sentinel_kont_push`es a frame (the resumer + captured
// ptr), returns the Kont*. The RESUMER (`@__resume_<name>(i64 %arg0, ptr %arg1)`) binds
// the let var to the resumed value `%arg0` + each captured param to its struct field
// (loaded from `%arg1`), lowers the pure tail, wraps it via `sentinel_kont_pure`. Both
// loads/stores/GEPs are i64 (the SentinelKont `arg` slot). The capture set is the param
// list in declaration order = the oracle's first-reference order for the c35c corpus
// (≤1 param per let-shape fn, always used in the tail); multi-param first-ref ordering
// is a c35d+ refinement.
fn cg_letshape_emit(out: &mut Vec<u8>, c: &mut TyCtx, lnm: [u8], lty: TyOpt, lval: Expr, tail: Expr, rty: i64, src: &[u8], name_s: i64, name_e: i64, pv0: i64, pvn: i64, gb: &mut Vec<u8>) -> i64 {
    let nparams: i64 = pvn - pv0;
    let cap_null: bool = nparams == 0;
    // ===== PARENT define: captured struct, RHS → kont, push, ret ptr =====
    let mut alloc_reg: i64 = 0 - 1;
    if nparams > 0 {
        alloc_reg = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 ");
        cgo_int(c, nparams * 8);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        let mut pi: i64 = pv0;
        while pi < pvn {
            let off: i64 = (pi - pv0) * 8;
            let gp: i64 = cg_dst(c);
            cgo_str(c, "getelementptr i8, ptr %v");
            cgo_int(c, alloc_reg);
            cgo_str(c, ", i64 ");
            cgo_int(c, off);
            cg_putc(c, '\n');
            let pslot: i64 = cg_slot_get(c, pi);
            let ld: i64 = cg_dst(c);
            cgo_str(c, "load i64, ptr %v");
            cgo_int(c, pslot);
            cg_putc(c, '\n');
            cgo_str(c, "  store i64 %v");
            cgo_int(c, ld);
            cgo_str(c, ", ptr %v");
            cgo_int(c, gp);
            cg_putc(c, '\n');
            pi = pi + 1;
        }
        0
    } else {
        0
    };
    // Lower the RHS (a `perform`) → a Kont* (operand in cglk/cglv, cg_tailk set); walk it
    // (the type-dump goes to a throwaway buffer; the cg lands in cgbody).
    let mut pbuf: Vec<u8> = vec_new();
    let _prt: i64 = dump_texpr(&mut pbuf, lval, 0 - 1, src, c, gb);
    let _pbx: [u8] = vec_to_array(pbuf);
    let kk: i64 = (*c).cglk;
    let kv: i64 = (*c).cglv;
    // Push the captured frame referencing the resumer + the captured ptr.
    cgo_str(c, "  call void @sentinel_kont_push(ptr ");
    cgo_operand(c, kk, kv);
    cgo_str(c, ", ptr @__resume_");
    cgo_slice(c, src, name_s, name_e);
    cgo_str(c, ", ptr ");
    if cap_null {
        cgo_str(c, "null")
    } else {
        cgo_str(c, "%v");
        cgo_int(c, alloc_reg)
    };
    cgo_str(c, ")\n");
    (*c).cg_used_kontpush = true;
    // Assemble the PARENT: `define ptr @<name>(<params>) { entry: <allocas> <body> ret ptr <kont> }`.
    (*c).cg_to_body = false;
    cgo_str(c, "define ptr @");
    cgo_slice(c, src, name_s, name_e);
    cg_putc(c, '(');
    let np: i64 = len((*c).cgpty);
    let mut hi: i64 = 0;
    while hi < np {
        if hi > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        let pty: i64 = (*c).cgpty[hi];
        cgo_ty(c, pty);
        cgo_str(c, " %arg");
        cgo_int(c, hi);
        hi = hi + 1;
    }
    cgo_str(c, ") {\nentry:\n");
    cg_flush_allocas_body(c);
    cgo_str(c, "  ret ptr ");
    cgo_operand(c, kk, kv);
    cgo_str(c, "\n}\n\n");
    // ===== RESUMER define: bind v + captures, lower tail, kont_pure wrap, ret ptr =====
    cg_reset(c);
    // Bind the let var to the resumed value (`%arg0`); `letty` = i64 (the corpus).
    let letty: i64 = tyopt_exp(c, lty, gb);
    let v_vid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    bind_name(c, lnm, v_vid, letty);
    let v_slot: i64 = cg_alloca(c, letty);
    cg_slot_set(c, v_vid, v_slot);
    cgo_str(c, "  store i64 %arg0, ptr %v");
    cgo_int(c, v_slot);
    cg_putc(c, '\n');
    // Bind each captured param to a fresh slot, loaded from the captured ptr (`%arg1`).
    // Its TYPE binding persists in the env from emit_tparams (cg_reset clears only the cg
    // slots), so the tail's `Var` resolves + loads as i64.
    let mut pj: i64 = pv0;
    while pj < pvn {
        let off2: i64 = (pj - pv0) * 8;
        let gp2: i64 = cg_dst(c);
        cgo_str(c, "getelementptr i8, ptr %arg1, i64 ");
        cgo_int(c, off2);
        cg_putc(c, '\n');
        let ld2: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, gp2);
        cg_putc(c, '\n');
        let cs: i64 = cg_alloca(c, 0);
        cgo_str(c, "  store i64 %v");
        cgo_int(c, ld2);
        cgo_str(c, ", ptr %v");
        cgo_int(c, cs);
        cg_putc(c, '\n');
        cg_slot_set(c, pj, cs);
        pj = pj + 1;
    }
    // Lower the pure tail → operand; wrap it as a PURE_RETURN kont.
    let mut tbuf: Vec<u8> = vec_new();
    let _trt: i64 = dump_texpr(&mut tbuf, tail, 0 - 1, src, c, gb);
    let _tbx: [u8] = vec_to_array(tbuf);
    let tk: i64 = (*c).cglk;
    let tv: i64 = (*c).cglv;
    let kp: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_kont_pure(i64 ");
    cgo_operand(c, tk, tv);
    cgo_str(c, ")\n");
    (*c).cg_used_kontpure = true;
    // Assemble the RESUMER.
    (*c).cg_to_body = false;
    cgo_str(c, "define ptr @__resume_");
    cgo_slice(c, src, name_s, name_e);
    cgo_str(c, "(i64 %arg0, ptr %arg1) {\nentry:\n");
    cg_flush_allocas_body(c);
    cgo_str(c, "  ret ptr %v");
    cgo_int(c, kp);
    cgo_str(c, "\n}\n\n");
    0
}

