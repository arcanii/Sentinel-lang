        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, sir_slot);
        cg_putc(c, '\n');
        let sir_o0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, i64 } undef, i1 %v");
        cgo_int(c, sir_valid);
        cgo_str(c, ", 0\n");
        let sir_o1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i1, i64 } %v");
        cgo_int(c, sir_o0);
        cgo_str(c, ", i64 %v");
        cgo_int(c, sir_value);
        cgo_str(c, ", 1\n");
        cg_reg(c, sir_o1);
