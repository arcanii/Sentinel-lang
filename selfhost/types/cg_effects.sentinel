        cgo_int(c, pspl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pspl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, psal + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, psal);
        cgo_str(c, ")\n");
        (*c).cg_used_procspawn = true;
        cg_reg(c, ps_d);
        0
