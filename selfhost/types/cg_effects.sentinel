        cgo_operand(c, pw_pk, pw_pv);
        cgo_str(c, ")\n");
        (*c).cg_used_procwait = true;
        cg_reg(c, pw_d);
        0
    } else if fid == 27 {
        // (ADR 0066 M2.2) process_write(p, data: [u8]) -> i64. Decompose data
        // into (len, ptr) and call sentinel_process_write(p, ptr, len).
        let pwr_pk: i64 = (*c).cgak[snap];
        let pwr_pv: i64 = (*c).cgav[snap];
        let pwr_dk: i64 = (*c).cgak[snap + 1];
        let pwr_dv: i64 = (*c).cgav[snap + 1];
        let pwrdl: i64 = cg_lenptr(c, pwr_dk, pwr_dv);
        let pwr_d: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_process_write(ptr ");
        cgo_operand(c, pwr_pk, pwr_pv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pwrdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pwrdl);
        cgo_str(c, ")\n");
        (*c).cg_used_procwrite = true;
        cg_reg(c, pwr_d);
        0
