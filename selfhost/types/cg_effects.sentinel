        let ps_pk: i64 = (*c).cgak[snap];
        let ps_pv: i64 = (*c).cgav[snap];
        let ps_ak: i64 = (*c).cgak[snap + 1];
        let ps_av: i64 = (*c).cgav[snap + 1];
        let pspl: i64 = cg_lenptr(c, ps_pk, ps_pv);
        let psal: i64 = cg_lenptr(c, ps_ak, ps_av);
        let ps_d: i64 = cg_dst(c);
