            cgo_operand(c, pse_vk, pse_vv)
        } else {
            cgo_str(c, "%v");
            cgo_int(c, pse_enc)
        };
        cgo_str(c, ")\n");
        (*c).cg_used_procsend = true;
        cg_reg(c, pse_d);
        0
    } else if fid == 30 {
        // (ADR 0066 M2.3 / M2.3b, register D34) process_recv(p) -> ?T: read one i64
        // frame to a stack slot, DECODE it into T, and build `{ i1 valid, T value }`
        // from the status (valid = 0). The cross-process twin of recv, and it borrows
        // that arm's shape exactly: the out-slot is `alloca i64` and the load is
        // `load i64` for EVERY element — the runtime frame is always an i64 — and only
        // the decoded value and the AGGREGATE are element-typed. The valid bit is
        // never converted.
        let prc_elem: i64 = nullable_inner_of(c, rty);
        let prc_pk: i64 = (*c).cgak[snap];
        let prc_pv: i64 = (*c).cgav[snap];
        let prc_slot: i64 = cg_alloca(c, 0);
        let prc_status: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_process_recv(ptr ");
        cgo_operand(c, prc_pk, prc_pv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, prc_slot);
        cgo_str(c, ")\n");
