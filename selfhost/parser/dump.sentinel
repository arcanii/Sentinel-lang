module parser;

// Consuming recursive dump of an argument cons-list: each arg prefixed by ` `.
fn dump_args(out: &mut Vec<u8>, a: Args) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(h, t) => {
            push(out, ' ');
            dump_expr(out, h);
            dump_args(out, t);
            0
        },
    }
}

// Consuming dump of an optional `let` type annotation: the type, or `_` if none.
fn dump_tyopt(out: &mut Vec<u8>, ty: TyOpt) -> i64 {
    match ty {
        TyOpt::NoTy => {
            push(out, '_');
            0
        },
        TyOpt::SomeTy(t) => {
            dump_type(out, t);
            0
        },
    }
}

// Consuming dump of a type expression, matching `snc ast`'s dump_type.
pub fn dump_type(out: &mut Vec<u8>, ty: TypeE) -> i64 {
    match ty {
        TypeE::TIdent(nm) => {
            append_str(out, nm);
            0
        },
        TypeE::TNullable(inner) => {
            append_str(out, "(opt ");
            dump_type(out, inner);
            push(out, ')');
            0
        },
        TypeE::TArray(inner) => {
            append_str(out, "(arr ");
            dump_type(out, inner);
            push(out, ')');
            0
        },
        TypeE::TRef(inner) => {
            append_str(out, "(ref ");
            dump_type(out, inner);
            push(out, ')');
            0
        },
        TypeE::TRefMut(inner) => {
            append_str(out, "(refmut ");
            dump_type(out, inner);
            push(out, ')');
            0
        },
        TypeE::TSecret(inner) => {
            append_str(out, "(secret ");
            dump_type(out, inner);
            push(out, ')');
            0
        },
        TypeE::TGeneric(gn, ga) => {
            append_str(out, "(generic ");
            append_str(out, gn);
            dump_targs(out, ga);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of a generic type-argument list: each arg prefixed by ` `.
fn dump_targs(out: &mut Vec<u8>, a: TyArgs) -> i64 {
    match a {
        TyArgs::TAEnd => 0,
        TyArgs::TACell(h, t) => {
            push(out, ' ');
            dump_type(out, h);
            dump_targs(out, t);
            0
        },
    }
}

// One parameter: `(param [mut] <name> <type>)`.
fn dump_param_body(out: &mut Vec<u8>, pm: bool, pn: [u8], pt: TypeE) -> i64 {
    append_str(out, "(param ");
    if pm {
        append_str(out, "mut ");
        0
    } else {
        0
    };
    append_str(out, pn);
    push(out, ' ');
    dump_type(out, pt);
    push(out, ')');
    0
}

// The parameter list inside `( )`: params are space-SEPARATED (the first has no
// leading space — it sits right after the list's open paren), so the first param
// dumps here and the rest go through `dump_params_rest`.
fn dump_params(out: &mut Vec<u8>, ps: Params) -> i64 {
    match ps {
        Params::PEnd => 0,
        Params::PCell(pm, pn, pt, rest) => {
            dump_param_body(out, pm, pn, pt);
            dump_params_rest(out, rest);
            0
        },
    }
}

fn dump_params_rest(out: &mut Vec<u8>, ps: Params) -> i64 {
    match ps {
        Params::PEnd => 0,
        Params::PCell(pm, pn, pt, rest) => {
            push(out, ' ');
            dump_param_body(out, pm, pn, pt);
            dump_params_rest(out, rest);
            0
        },
    }
}

// Consuming dump of a statement cons-list: each statement prefixed by ` `.
fn dump_stmts(out: &mut Vec<u8>, st: Stmts) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(one, rest) => {
            push(out, ' ');
            dump_stmt(out, one);
            dump_stmts(out, rest);
            0
        },
    }
}

fn dump_stmt(out: &mut Vec<u8>, s: Stmt) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            append_str(out, "(let ");
            if lmf {
                append_str(out, "mut ");
                0
            } else {
                0
            };
            append_str(out, lnm);
            push(out, ' ');
            dump_tyopt(out, lty);
            push(out, ' ');
            dump_expr(out, lval);
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            dump_expr(out, atgt);
            push(out, ' ');
            dump_expr(out, aval);
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            dump_expr(out, wcond);
            push(out, ' ');
            dump_expr(out, wbody);
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            dump_expr(out, sx);
            push(out, ')');
            0
        },
    }
}

// Consuming recursive dump matching `snc ast`.
fn dump_expr(out: &mut Vec<u8>, ex: Expr) -> i64 {
    match ex {
        Expr::Int(nv) => {
            append_str(out, "(int ");
            append_int(out, nv);
            push(out, ')');
            0
        },
        Expr::Bool(bv) => {
            let blit: [u8] = if bv {
                "(bool true)"
            } else {
                "(bool false)"
            };
            append_str(out, blit);
            0
        },
        Expr::Null => {
            append_str(out, "(null)");
            0
        },
        Expr::Char(cv) => {
            append_str(out, "(char ");
            append_int(out, cv);
            push(out, ')');
            0
        },
        Expr::Str(sb) => {
            append_str(out, "(str");
            dump_str_body(out, sb);
            push(out, ')');
            0
        },
        Expr::Var(nm) => {
            append_str(out, "(var ");
            append_str(out, nm);
            push(out, ')');
            0
        },
        Expr::Unary(uop, inner) => {
            append_str(out, "(unary ");
            let usym: [u8] = if uop == 1 {
                "-"
            } else if uop == 2 {
                "!"
            } else if uop == 3 {
                "*"
            } else if uop == 4 {
                "&"
            } else {
                "&mut"
            };
            append_str(out, usym);
            push(out, ' ');
            dump_expr(out, inner);
            push(out, ')');
            0
        },
        Expr::Binary(bop, l, r) => {
            push(out, '(');
            let pfx: [u8] = if bop <= 7 || bop == 16 || bop == 17 {
                "binop"
            } else if bop <= 13 {
                "cmp"
            } else {
                "logic"
            };
            append_str(out, pfx);
            push(out, ' ');
            let bsym: [u8] = if bop == 1 {
                "+"
            } else if bop == 2 {
                "-"
            } else if bop == 3 {
                "*"
            } else if bop == 4 {
                "/"
            } else if bop == 5 {
                "&"
            } else if bop == 6 {
                "|"
            } else if bop == 7 {
                "^"
            } else if bop == 8 {
                "=="
            } else if bop == 9 {
                "!="
            } else if bop == 10 {
                "<"
            } else if bop == 11 {
                "<="
            } else if bop == 12 {
                ">"
            } else if bop == 13 {
                ">="
            } else if bop == 14 {
                "&&"
            } else if bop == 16 {
                "<<"
            } else if bop == 17 {
                ">>"
            } else {
                "||"
            };
            append_str(out, bsym);
            push(out, ' ');
            dump_expr(out, l);
            push(out, ' ');
            dump_expr(out, r);
            push(out, ')');
            0
        },
        Expr::Call(cn, ca) => {
            append_str(out, "(call ");
            append_str(out, cn);
            dump_args(out, ca);
            push(out, ')');
            0
        },
        Expr::Method(mt, mn, ma) => {
            append_str(out, "(method ");
            dump_expr(out, mt);
            push(out, ' ');
            append_str(out, mn);
            dump_args(out, ma);
            push(out, ')');
            0
        },
        Expr::Field(ft, fdn) => {
            append_str(out, "(field ");
            dump_expr(out, ft);
            push(out, ' ');
            append_str(out, fdn);
            push(out, ')');
            0
        },
        Expr::Index(it, ii) => {
            append_str(out, "(index ");
            dump_expr(out, it);
            push(out, ' ');
            dump_expr(out, ii);
            push(out, ')');
            0
        },
        Expr::Qcall(qi, qm, qa) => {
            append_str(out, "(qcall ");
            append_str(out, qi);
            push(out, ' ');
            append_str(out, qm);
            dump_args(out, qa);
            push(out, ')');
            0
        },
        Expr::ClassInit(ci, cia) => {
            append_str(out, "(class-init ");
            append_str(out, ci);
            dump_args(out, cia);
            push(out, ')');
            0
        },
        Expr::Array(ae) => {
            append_str(out, "(array");
            dump_args(out, ae);
            push(out, ')');
            0
        },
        Expr::If(ic, it2, ie2) => {
            append_str(out, "(if ");
            dump_expr(out, ic);
            push(out, ' ');
            dump_expr(out, it2);
            push(out, ' ');
            dump_expr(out, ie2);
            push(out, ')');
            0
        },
        Expr::Block(bstmts, btail) => {
            append_str(out, "(block");
            dump_stmts(out, bstmts);
            push(out, ' ');
            dump_expr(out, btail);
            push(out, ')');
            0
        },
        Expr::SynthZero => {
            append_str(out, "(int 0)");
            0
        },
        Expr::Match(mscr, marms) => {
            append_str(out, "(match ");
            dump_expr(out, mscr);
            dump_arms(out, marms);
            push(out, ')');
            0
        },
        Expr::StructLit(sn, sf) => {
            append_str(out, "(struct-lit ");
            append_str(out, sn);
            dump_fields(out, sf);
            push(out, ')');
            0
        },
        Expr::Declassify(di) => {
            append_str(out, "(declassify ");
            dump_expr(out, di);
            push(out, ')');
            0
        },
        Expr::Return(ri) => {
            append_str(out, "(return ");
            dump_expr(out, ri);
            push(out, ')');
            0
        },
        Expr::Cast(ci, cnm) => {
            append_str(out, "(cast ");
            dump_expr(out, ci);
            push(out, ' ');
            append_str(out, cnm);
            push(out, ')');
            0
        },
        Expr::Perform(pe, po, pa) => {
            append_str(out, "(perform ");
            append_str(out, pe);
            push(out, ' ');
            append_str(out, po);
            dump_args(out, pa);
            push(out, ')');
            0
        },
        Expr::Scope(sb) => {
            append_str(out, "(scope ");
            dump_expr(out, sb);
            push(out, ')');
            0
        },
        Expr::Spawn(sc) => {
            append_str(out, "(spawn ");
            dump_expr(out, sc);
            push(out, ')');
            0
        },
        Expr::Await(aw) => {
            append_str(out, "(await ");
            dump_expr(out, aw);
            push(out, ')');
            0
        },
        Expr::Handle(hb, ha, hr) => {
            append_str(out, "(handle ");
            dump_expr(out, hb);
            dump_harms(out, ha);
            dump_ret(out, hr);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of the handler-arm list: each ` (arm <effect> <op> <body>)`.
fn dump_harms(out: &mut Vec<u8>, a: HArms) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hparams, hbody, hrest) => {
            append_str(out, " (arm ");
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            // The `snc ast` form omits handler-arm params — dispose them (into a
            // throwaway buffer reclaimed by vec_to_array) without emitting.
            let mut tw: Vec<u8> = vec_new();
            dump_binds(&mut tw, hparams);
            let _t: [u8] = vec_to_array(tw);
            push(out, ' ');
            dump_expr(out, hbody);
            push(out, ')');
            dump_harms(out, hrest);
            0
        },
    }
}

// Consuming dump of the optional return arm: ` (return <name> <body>)`.
fn dump_ret(out: &mut Vec<u8>, r: Ret) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody, rnt, rt0) => {
            let _a: i64 = rnt;
            let _b: i64 = rt0;
            append_str(out, " (return ");
            append_str(out, rnm);
            push(out, ' ');
            dump_expr(out, rbody);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of a struct-literal field list: each ` (field <name> <value>)`.
fn dump_fields(out: &mut Vec<u8>, f: Fields) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fv, fr) => {
            append_str(out, " (field ");
            append_str(out, fnm);
            push(out, ' ');
            dump_expr(out, fv);
            push(out, ')');
            dump_fields(out, fr);
            0
        },
    }
}

// Consuming dump of a match-arm cons-list: each arm `(arm <pattern> <body>)`.
fn dump_arms(out: &mut Vec<u8>, a: Arms) -> i64 {
    match a {
        Arms::ArmEnd => 0,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            dump_pat(out, ap);
            push(out, ' ');
            dump_expr(out, abody);
            push(out, ')');
            dump_arms(out, arest);
            0
        },
    }
}

fn dump_pat(out: &mut Vec<u8>, p: Pattern) -> i64 {
    match p {
        Pattern::PatWild => {
            append_str(out, "(pat _)");
            0
        },
        Pattern::PatVariant(pen, pvn, pbs) => {
            append_str(out, "(pat ");
            append_str(out, pen);
            push(out, ' ');
            append_str(out, pvn);
            dump_binds(out, pbs);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of a binding cons-list: each binding prefixed by ` `.
fn dump_binds(out: &mut Vec<u8>, b: Binds) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(bh, bt) => {
            push(out, ' ');
            append_str(out, bh);
            dump_binds(out, bt);
            0
        },
    }
}

// (2d-1) `use a :: b :: ... ;` → `(use a b ...)`. Dumped inline (a path is just
// idents — no AST node needed). The leading `use` is at the cursor; the trailing
// `;` is consumed too.
fn dump_use_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    append_str(out, "(use ");
    append_slice(out, src, (*s)[*cur], (*e)[*cur]);
    *cur = *cur + 1;
    while (*k)[*cur] == 30 {
        *cur = *cur + 1;
        push(out, ' ');
        append_slice(out, src, (*s)[*cur], (*e)[*cur]);
        *cur = *cur + 1;
    }
    *cur = *cur + 1;
    push(out, ')');
    0
}

// ADR 0067: `module a :: b ;` → `(module a b)` (a path is just idents, like
// `use`); the leading `module` is at the cursor, the trailing `;` is consumed.
fn dump_module_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    append_str(out, "(module ");
    append_slice(out, src, (*s)[*cur], (*e)[*cur]);
    *cur = *cur + 1;
    while (*k)[*cur] == 30 {
        *cur = *cur + 1;
        push(out, ' ');
        append_slice(out, src, (*s)[*cur], (*e)[*cur]);
        *cur = *cur + 1;
    }
    *cur = *cur + 1;
    push(out, ')');
    0
}

// ADR 0067: `part name ;` → `(part name)` (one ident; the `;` is consumed).
fn dump_part_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    append_str(out, "(part ");
    append_slice(out, src, (*s)[*cur], (*e)[*cur]);
    *cur = *cur + 1;
    *cur = *cur + 1;
    push(out, ')');
    0
}

// A `fn` definition (the leading `fn` is at the cursor) → `(fn name (<param>…)
// <ret> <block>)`. Factored out of the old main loop so main can dispatch on the
// leading decl token. fn header: `fn` NAME `<type-params>?` `(` params `)` `->`
// TYPE `! { effect-row }?` { body } — type-params + effect row parsed-and-skipped.
fn dump_fn_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let name_s: i64 = (*s)[*cur];
    let name_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    if (*k)[*cur] == 15 {
        skip_type_params(k, cur)
    } else {
        0
    };
    *cur = *cur + 1;
    let params: Params = parse_params(k, s, e, src, cur);
    *cur = *cur + 1;
    let rty: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let body: Expr = parse_block(k, s, e, src, cur);
    append_str(out, "(fn ");
    append_slice(out, src, name_s, name_e);
    append_str(out, " (");
    dump_params(out, params);
    append_str(out, ") ");
    dump_type(out, rty);
    append_str(out, " ");
    dump_expr(out, body);
    push(out, ')');
    0
}

// (2d-2) `struct Name <T>? { f: T, … }` → `(struct Name (field f <type>) …)`.
// Generic type-params parsed-and-skipped; fields are parsed+dumped inline (a
// field is just `name : type` — no AST node needed). The leading `struct` is at
// the cursor.
fn dump_struct_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    if (*k)[*cur] == 15 {
        skip_type_params(k, cur)
    } else {
        0
    };
    *cur = *cur + 1;
    append_str(out, "(struct ");
    append_slice(out, src, nm_s, nm_e);
    dump_struct_fields(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// Parse + dump struct fields up to and consuming the closing `}` (tag 7): each
// `name : type` → ` (field name <type>)`; commas skipped, trailing comma fine.
fn dump_struct_fields(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_struct_fields(out, k, s, e, src, cur)
    } else {
        let fnm_s: i64 = (*s)[*cur];
        let fnm_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let fty: TypeE = parse_type(k, s, e, src, cur);
        append_str(out, " (field ");
        append_slice(out, src, fnm_s, fnm_e);
        push(out, ' ');
        dump_type(out, fty);
        push(out, ')');
        dump_struct_fields(out, k, s, e, src, cur)
    }
}

// (2d-3) `enum Name { V1, V2(T), … }` → `(enum Name (variant V1) (variant V2
// <type>) …)`. Enums are non-generic (no type-params to skip); a variant is a
// name + an optional positional payload-type list. The leading `enum` is at the
// cursor.
fn dump_enum_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    append_str(out, "(enum ");
    append_slice(out, src, nm_s, nm_e);
    dump_variants(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// Parse + dump enum variants up to and consuming the closing `}` (tag 7): each
// `Name` or `Name(T, …)` → ` (variant Name <ptype>…)`; commas skipped.
fn dump_variants(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_variants(out, k, s, e, src, cur)
    } else {
        let vn_s: i64 = (*s)[*cur];
        let vn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        append_str(out, " (variant ");
        append_slice(out, src, vn_s, vn_e);
        if (*k)[*cur] == 4 {
            *cur = *cur + 1;
            dump_payloads(out, k, s, e, src, cur);
            0
        } else {
            0
        };
        push(out, ')');
        dump_variants(out, k, s, e, src, cur)
    }
}

// Parse + dump a variant's positional payload types up to and consuming the
// closing `)` (tag 5): each ` <type>`.
fn dump_payloads(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_payloads(out, k, s, e, src, cur)
    } else {
        let pty: TypeE = parse_type(k, s, e, src, cur);
        push(out, ' ');
        dump_type(out, pty);
        dump_payloads(out, k, s, e, src, cur)
    }
}

// (2d-4) `effect Name { op(p: T) -> R; … }` → `(effect Name (op op (<params>)
// <ret>) …)`. An op's params dump like fn params; a MISSING return type dumps `_`
// (reusing `TyOpt` / `dump_tyopt`, the `let`-annotation convention). The leading
// `effect` is at the cursor.
fn dump_effect_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    append_str(out, "(effect ");
    append_slice(out, src, nm_s, nm_e);
    dump_ops(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// Parse + dump effect ops up to and consuming the closing `}` (tag 7): each
// `name(params) [-> ret] ;?` → ` (op name (<params>) <ret-or-_>)`; the `;`
// terminators are skipped.
fn dump_ops(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        dump_ops(out, k, s, e, src, cur)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let oparams: Params = parse_params(k, s, e, src, cur);
        let oret: TyOpt = if (*k)[*cur] == 8 {
            *cur = *cur + 1;
            TyOpt::SomeTy(parse_type(k, s, e, src, cur))
        } else {
            TyOpt::NoTy
        };
        append_str(out, " (op ");
        append_slice(out, src, on_s, on_e);
        append_str(out, " (");
        dump_params(out, oparams);
        append_str(out, ") ");
        dump_tyopt(out, oret);
        push(out, ')');
        dump_ops(out, k, s, e, src, cur)
    }
}

// (2d-5) Parse a method header `fn name ( self:&[mut]Self [, params] ) -> ret
// [! { eff }]` (cur at `fn`) and emit ` (method name <shared|exclusive>
// (<params>) <ret>` — NO closing paren (the caller adds `)` for a trait sig, or
// ` <block>)` for an impl/class method). The self receiver is consumed by
// parse_self_kind; parse_params then consumes the rest of the list (it skips a
// leading `,` and ends on `)`, so it handles both `(self: &Self)` and
// `(self: &Self, x: T)`). The effect row is parsed-and-skipped. Shared by trait
// (2d-5) / impl (2d-6) / class (2d-7) methods.
fn dump_method_head(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    let excl: bool = parse_self_kind(k, cur);
    let mparams: Params = parse_params(k, s, e, src, cur);
    *cur = *cur + 1;
    let mret: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(out, " (method ");
    append_slice(out, src, mn_s, mn_e);
    push(out, ' ');
    append_str(out, skw);
    append_str(out, " (");
    dump_params(out, mparams);
    append_str(out, ") ");
    dump_type(out, mret);
    0
}

// (2d-5) `trait Name { fn m(self: &Self, …) -> R; … }` → `(trait Name (method m
// <self> (<params>) <ret>) …)`. Trait method sigs have NO body (`;`-terminated).
// The leading `trait` is at the cursor.
fn dump_trait_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    append_str(out, "(trait ");
    append_slice(out, src, nm_s, nm_e);
    dump_trait_methods(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// Parse + dump trait method sigs up to and consuming the closing `}` (tag 7):
// each `fn … ;` → ` (method …)`. The `;` after each sig is consumed here.
fn dump_trait_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else {
        dump_method_head(out, k, s, e, src, cur);
        *cur = *cur + 1;
        push(out, ')');
        dump_trait_methods(out, k, s, e, src, cur)
    }
}

// (2d-6) `impl Name? as Trait for Type { fn m(self: &Self, …) -> R { … } … }` →
// `(impl <name-or-_> Trait Type (method m <self> (<params>) <ret> <block>) …)`.
// The optional impl name is present iff the token after `impl` is NOT `as` (60);
// a default impl dumps `_` in the name slot. The name is resolved to a `[u8]`
// value FIRST (a slice or the literal `"_"`) so the emit is a single
// `append_str` — a two-borrowing-arm `if` would trip the A2 borrow quirk. Impl
// methods carry a body (vs trait sigs). The leading `impl` is at the cursor.
fn dump_impl_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let has_name: bool = (*k)[*cur] != 60;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    if has_name {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    let ty_s: i64 = (*s)[*cur];
    let ty_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    let imname: [u8] = if has_name {
        slice_of(src, nm_s, nm_e)
    } else {
        "_"
    };
    append_str(out, "(impl ");
    append_str(out, imname);
    push(out, ' ');
    append_slice(out, src, tr_s, tr_e);
    push(out, ' ');
    append_slice(out, src, ty_s, ty_e);
    dump_impl_methods(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// Parse + dump impl methods up to and consuming the closing `}` (tag 7): each
// `[pub] fn … { body }` → ` (method … <ret> <block>)`. An optional per-method
// `pub` (tag 59) is parsed-and-skipped; the body is parsed via parse_block.
fn dump_impl_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 59 {
        *cur = *cur + 1;
        dump_impl_methods(out, k, s, e, src, cur)
    } else {
        dump_method_head(out, k, s, e, src, cur);
        let mbody: Expr = parse_block(k, s, e, src, cur);
        push(out, ' ');
        dump_expr(out, mbody);
        push(out, ')');
        dump_impl_methods(out, k, s, e, src, cur)
    }
}

// (2d-7) `class Name { let f: T; init(p: T){…} fn m(self…){…} delegate g: T to
// Tr; }` → `(class Name (field f <type>)… (init (<params>) <block>)? (method
// …)… (delegate g <type> Tr)…)`. 🔑 The class AST BUCKETS items (fields / init /
// methods / delegates), so the dump emits them GROUPED in that fixed order —
// NOT source order (unlike every other decl, which dumps inline as it scans).
// So we scan the body ONCE, routing each item's dump into a per-kind `Vec<u8>`
// buffer, then concatenate the four buffers in order. The leading `class` is at
// the cursor.
fn dump_class_decl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    let mut fbuf: Vec<u8> = vec_new();
    let mut ibuf: Vec<u8> = vec_new();
    let mut mbuf: Vec<u8> = vec_new();
    let mut dbuf: Vec<u8> = vec_new();
    dump_class_items(&mut fbuf, &mut ibuf, &mut mbuf, &mut dbuf, k, s, e, src, cur);
    append_str(out, "(class ");
    append_slice(out, src, nm_s, nm_e);
    append_str(out, vec_to_array(fbuf));
    append_str(out, vec_to_array(ibuf));
    append_str(out, vec_to_array(mbuf));
    append_str(out, vec_to_array(dbuf));
    push(out, ')');
    0
}

// Scan class items up to and consuming the closing `}` (tag 7), routing each
// into its per-kind buffer: `let`→fields, `init`→init, `fn`→methods,
// `delegate`→delegates (`init`/`delegate` lex as plain idents — slice-compared).
// An optional per-item `pub` (tag 59) is skipped.
fn dump_class_items(fbuf: &mut Vec<u8>, ibuf: &mut Vec<u8>, mbuf: &mut Vec<u8>, dbuf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 45 {
        dump_class_field(fbuf, k, s, e, src, cur);
        dump_class_items(fbuf, ibuf, mbuf, dbuf, k, s, e, src, cur)
    } else if t == 3 {
        dump_method_head(mbuf, k, s, e, src, cur);
        let cmbody: Expr = parse_block(k, s, e, src, cur);
        push(mbuf, ' ');
        dump_expr(mbuf, cmbody);
        push(mbuf, ')');
        dump_class_items(fbuf, ibuf, mbuf, dbuf, k, s, e, src, cur)
    } else if is_kw_init(src, (*s)[*cur], (*e)[*cur]) {
        dump_class_init(ibuf, k, s, e, src, cur);
        dump_class_items(fbuf, ibuf, mbuf, dbuf, k, s, e, src, cur)
    } else {
        dump_class_delegate(dbuf, k, s, e, src, cur);
        dump_class_items(fbuf, ibuf, mbuf, dbuf, k, s, e, src, cur)
    }
}

// A class field `let name : type ;` → ` (field name <type>)`.
fn dump_class_field(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    let fty: TypeE = parse_type(k, s, e, src, cur);
    *cur = *cur + 1;
    append_str(buf, " (field ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    dump_type(buf, fty);
    push(buf, ')');
    0
}

// A class `init ( params ) { body }` → ` (init (<params>) <block>)` (no self,
// no return type).
fn dump_class_init(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    *cur = *cur + 1;
    let iparams: Params = parse_params(k, s, e, src, cur);
    let ibody: Expr = parse_block(k, s, e, src, cur);
    append_str(buf, " (init (");
    dump_params(buf, iparams);
    append_str(buf, ") ");
    dump_expr(buf, ibody);
    push(buf, ')');
    0
}

// A class `delegate field : type to Trait ;` → ` (delegate field <type> Trait)`
// (`to` is a positional ident).
fn dump_class_delegate(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    let dty: TypeE = parse_type(k, s, e, src, cur);
    *cur = *cur + 1;
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;
    append_str(buf, " (delegate ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    dump_type(buf, dty);
    push(buf, ' ');
    append_slice(buf, src, tr_s, tr_e);
    push(buf, ')');
    0
}

// Dispatch one top-level decl on its leading token (2d). A SINGLE helper that
// re-passes the ref params to the per-kind dumpers, so main has ONE borrow site:
// sibling `if`-tail `&mut` borrows of a *local* (`&mut out` / `&mut cur` in
// main) conflict under the lexical borrow checker (ADR 0038 A2), but re-passing
// a `&mut` *param* across if-tails is fine (cf. parse_postfix_rest). An optional
// `pub` prefix is parsed-and-skipped (the dump omits visibility). Leading tags:
// use=58, struct=52, enum=53, effect=57, trait=54, impl=55, class=56; else fn.
// (ADR 0057) Skip an `extern "C" [link(…)] { … }` block whole: scan to its `{`
// (kind 6) and balance to the matching `}` (kind 7), emitting nothing. Deliberately
// WITHOUT a bodyless-`;` early exit — the braces here are the block's own and the
// `;`s inside terminate its declarations. Mirrors `skip_extern_block` in
// selfhost/merge/engine.sentinel.
fn skip_extern_block(k: &Vec<i64>, cur: &mut i64) -> i64 {
    let n: i64 = len((*k));
    while *cur < n && (*k)[*cur] != 6 {
        *cur = *cur + 1;
    }
    let mut depth: i64 = 0;
    let mut done: bool = false;
    while *cur < n && !done {
        let t: i64 = (*k)[*cur];
        if t == 6 {
            depth = depth + 1;
            0
        } else if t == 7 {
            depth = depth - 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;
        if depth == 0 {
            done = true;
            0
        } else {
            0
        };
    }
    0
}

fn dump_item(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    let lead: i64 = (*k)[*cur];
    if lead == 2 && is_extern_kw(src, (*s)[*cur], (*e)[*cur]) {
        // (ADR 0057) an `extern "C" { … }` block. The ORACLE's `snc ast` dump OMITS
        // externs entirely, so this skips the block as a UNIT and emits nothing.
        //
        // It MUST precede the `fn` fallthrough below. Without this arm `extern` fell
        // through to `dump_fn_decl`, which read the ABI string as the fn NAME and the
        // block as a parameter list, emitting the malformed
        // `(fn "C" ((param fn () (param x i64)) i64 (block (int 0)))` — unbalanced
        // parens, and the real declarations lost. Exactly the shape of the merge's
        // `emit_item` bug (it had no extern arm either, and DELETED the following
        // declaration); this one was invisible for the same reason — until
        // `tests/pass/c57_extern_call.sentinel` no fixture used `extern` at all.
        skip_extern_block(k, cur)
    } else if lead == 2 && is_export_kw(src, (*s)[*cur], (*e)[*cur]) {
        // (ADR 0059) `export "C" fn ...` -- a C-ABI export. The ORACLE's `snc
        // ast` dump renders an exported fn EXACTLY like an ordinary one (the
        // export flag is not part of the dump), so the whole fix is to skip the
        // two-token `export "C"` prefix and fall into `dump_fn_decl` with the
        // cursor on `fn`.
        //
        // NOT `skip_extern_block`'s treatment: an extern block declares FOREIGN
        // symbols the oracle omits entirely, so skipping it is right; an export
        // declares an ordinary Sentinel fn the oracle DOES dump, so skipping it
        // would emit nothing and lose the item. Like the extern arm, this MUST
        // precede the `fn` fallthrough -- without it `export` fell through to
        // `dump_fn_decl`, which read the ABI string as the fn NAME and
        // mis-sliced the parameter list, emitting
        // `(fn "C" ((param ct_choose cond) (param : ,) ...)`. The extern arm's
        // own comment predicted this shape; the gap survived that pass because
        // no fixture used `export`, and because the completeness sweep looked
        // at `extern` only. The real-program stage differential found it.
        //
        // SCOPE, deliberately: the `extern` fix touched all THREE item
        // dispatchers (this one, the merge's `emit_item`, and its
        // `build_rename`); this one touches only this dispatcher, and that is
        // not an oversight. The merge side cannot be mirrored on its own,
        // because the ORACLE's own merge-to-source
        // (crates/sentinel-driver/src/source_dump.rs, `emit_fn`) has NO
        // `is_export_c` branch and silently re-emits an exported fn as a plain
        // `fn` -- verified: `snc build --lib` succeeds on an export program and
        // then FAILS on that same program's `snc merge` output with "produced no
        // `export "C"` functions". So teaching `emit_item` to re-emit the prefix
        // would make scg's merged TEXT differ from the oracle's and BREAK merge
        // parity. The oracle half has to land first, and it carries a real
        // design question (`merge_modules` deliberately keeps an exported fn OUT
        // of the rename map so it keeps its bare C symbol --
        // crates/sentinel-resolve/src/lib.rs `if f.is_export_c { continue; }` --
        // while scg's `build_rename` has no such arm and would qualify it).
        // Tracked as one item in HANDOVER's open menu. Unreachable today: no
        // program in the corpus, the fixtures, or `selfhost/` merges an export.
        *cur = *cur + 2;
        dump_fn_decl(out, k, s, e, src, cur)
    } else if lead == 58 {
        dump_use_decl(out, k, s, e, src, cur)
    } else if lead == 64 {
        dump_module_decl(out, k, s, e, src, cur)
    } else if lead == 65 {
        dump_part_decl(out, k, s, e, src, cur)
    } else if lead == 52 {
        dump_struct_decl(out, k, s, e, src, cur)
    } else if lead == 53 {
        dump_enum_decl(out, k, s, e, src, cur)
    } else if lead == 57 {
        dump_effect_decl(out, k, s, e, src, cur)
    } else if lead == 54 {
        dump_trait_decl(out, k, s, e, src, cur)
    } else if lead == 55 {
        dump_impl_decl(out, k, s, e, src, cur)
    } else if lead == 56 {
        dump_class_decl(out, k, s, e, src, cur)
    } else {
        dump_fn_decl(out, k, s, e, src, cur)
    }
}

// Review F11 / P2.5 (the snc parser-hardening mirror): a recursive-descent
// parser stack-overflows on pathologically deep nesting — a denial of service
// on adversarial input (the snc fuzzer found ~256 nested `(` aborting). The
// self-hosted compiler has no `Result`/error channel and the depth limit cannot
// be threaded through the recursive walk without churning ~30 functions, so this
// is a cheap pre-pass instead: scan the token stream for the maximum BRACKET
// nesting (`(` 4 / `{` 6 / `[` 27 push, `)` 5 / `}` 7 / `]` 28 pop), and if it
// exceeds a safe bound, CLEAR the stream so the walk sees an empty program and
// cannot overflow. Inert for every valid program (the whole self-hosting compiler
// nests <~30, the bound is 256), so the stage differentials and BOTH bootstrap
// fixed points are unaffected. Covers the demonstrated paren/brace/bracket DoS;
// operator-ambiguous deep nesting (a flat scan can't tell prefix `-`/`*`/`&` or
// generic `<` from their infix forms) is a residual whose failure stays a
// controlled abort, not memory unsafety. Called after `tokenize` by every stage
// entry (this `main` + `types::run`).
pub fn guard_nesting(k: &mut Vec<i64>, st: &mut Vec<i64>, en: &mut Vec<i64>) -> i64 {
    let n: i64 = len(*k);
    let mut i: i64 = 0;
    let mut depth: i64 = 0;
    let mut maxd: i64 = 0;
    while i < n {
        let t: i64 = (*k)[i];
        if t == 4 {
            depth = depth + 1;
            0
        } else if t == 6 {
            depth = depth + 1;
            0
        } else if t == 27 {
            depth = depth + 1;
            0
        } else if t == 5 {
            depth = depth - 1;
            0
        } else if t == 7 {
            depth = depth - 1;
            0
        } else if t == 28 {
            depth = depth - 1;
            0
        } else {
            0
        };
        if depth > maxd {
            maxd = depth;
            0
        } else {
            0
        };
        i = i + 1;
    }
    if maxd > 256 {
        while len(*k) > 0 {
            let _a: i64 = pop(k);
            0
        }
        while len(*st) > 0 {
            let _b: i64 = pop(st);
            0
        }
        while len(*en) > 0 {
            let _c: i64 = pop(en);
            0
        }
        0
    } else {
        0
    }
}

fn main() -> i64 {
    let path: [u8] = "input.sentinel";
    let src: [u8] = read_file(path);
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    // Review F11 / P2.5: reject pathologically deep bracket nesting before the
    // recursive walk can stack-overflow (clears the stream if too deep).
    guard_nesting(&mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);
    let mut out: Vec<u8> = vec_new();
    let mut cur: i64 = 0;
    let mut firstitem: bool = true;
    while cur < ntok {
        let sep: i64 = len(out);
        if firstitem {
            0
        } else {
            push(&mut out, '\n');
            0
        };
        let aftersep: i64 = len(out);
        dump_item(&mut out, &kinds, &starts, &ends, &src, &mut cur);
        // (ADR 0057) An item may emit NOTHING — an `extern "C"` block, which the
        // oracle's `snc ast` omits. It must not consume the separator pushed above,
        // or the dump gains a stray blank line (and `firstitem` must stay set, so the
        // first REAL item is still treated as first). Rewind to `sep` and leave the
        // flag alone. Written as a general "did this item emit?" test rather than an
        // extern special-case, so any future silent item behaves.
        if len(out) == aftersep {
            while len(out) > sep {
                let _d: u8 = pop(&mut out);
                0
            }
            0
        } else {
            firstitem = false;
            0
        };
    }
    push(&mut out, '\n');
    let arr: [u8] = vec_to_array(out);
    print_bytes(arr);
    0
}
