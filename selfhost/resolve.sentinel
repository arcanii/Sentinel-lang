// Phase D self-host port (3/N) / ADR 0040: the resolve-stage-in-Sentinel.
// Reads `input.sentinel`, reuses the parser (a D.6 module — `use parser::…`) to
// build the AST, then NAME-RESOLVES it (every identifier → an integer ID) and
// prints the SAME canonical resolved dump as the Rust `snc resolve` oracle
// (ADR 0040 D2): the `snc ast` S-expr extended with the resolved IDs, e.g.
//   (fn #14 add ((param #0 a i64) (param #1 b i64)) i64 (block (binop + (var #0) (var #1))))
//   (fn #15 main () i64 (block (call #14 (int 1) (int 2))))
//   (effect #0 Async)
//
// MILESTONE-1 scope (ADR 0040 A2/D8): paramful fns + free calls + arithmetic +
// var refs + blocks. `let` bindings are MILESTONE-2 — they grow the scope DURING
// the body walk (vs m-1's per-fn scope built from the params then read
// immutably), so the m-1 dump_rstmt SLet arm is best-effort (no m-1 seed has a
// `let`). The remaining decl/expr forms (struct/enum/…/match/handle, and the
// `::`-path disambiguation into qcall-impl / class-init / enum-construct) need
// the decl symbol tables — slices (3b)–(3d); their arms here are compile-safe +
// leak-free placeholders until then.
//
// PROVEN SENTINEL IDIOMS (ADR 0040 A1 probes; reused):
//  * Symbol tables + the local scope are FLAT parallel `Vec<i64>` arrays keyed
//    by SRC SLICES (start,end into `src`) — NOT cons-lists (you can't `match` a
//    `&enum`; a `&`-ref enum match aliases the heap → double-free on reuse).
//    `len(*v)` works via explicit deref on `&Vec` / `&mut Vec`.
//  * varids are GLOBAL + sequential = push order, so a binding's varid is just
//    its index in the scope arrays (no separate id array needed).
//  * An owned `[u8]` (the parser's `Var`/`Call` NAME payloads) is freed ONLY by
//    routing its bytes into a `Vec` reclaimed via `vec_to_array` — so each
//    resolved-away name is `sink_name`'d into `garbage`, which `main` reclaims
//    last. The consuming `match` frees the enum boxes but NOT a `[u8]` payload.

use parser::Expr;
use parser::Args;
use parser::Stmts;
use parser::Stmt;
use parser::Arms;
use parser::Pattern;
use parser::Binds;
use parser::Fields;
use parser::HArms;
use parser::Ret;
use parser::TyOpt;
use parser::TypeE;
use parser::tokenize;
use parser::parse_type;
use parser::parse_block;
use parser::skip_type_params;
use parser::skip_effect_row;
use parser::dump_type;
use parser::append_str;
use parser::append_int;
use parser::append_slice;

// --- name comparison --------------------------------------------------------

// Compare `src[st..en]` to the owned query name `q` (a borrowed `&[u8]`).
fn name_eq_src(src: &[u8], st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*src)[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare the owned query name `q` (borrowed) to a string literal `lit`.
fn name_eq_lit(q: &[u8], lit: [u8]) -> bool {
    let qn: i64 = len(*q);
    let ln: i64 = len(lit);
    if qn != ln {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < ln {
            if (*q)[i] != lit[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// The 14 runtime builtins → their reserved FnIds (0..=13), or -1 if `q` is not a
// builtin. Same order as sentinel-resolve's pre-registration (ADR 0035 D2).
fn builtin_id(q: &[u8]) -> i64 {
    if name_eq_lit(q, "print") {
        0
    } else if name_eq_lit(q, "unwrap_or") {
        1
    } else if name_eq_lit(q, "is_some") {
        2
    } else if name_eq_lit(q, "len") {
        3
    } else if name_eq_lit(q, "str_eq") {
        4
    } else if name_eq_lit(q, "u8_to_i64") {
        5
    } else if name_eq_lit(q, "i64_to_u8") {
        6
    } else if name_eq_lit(q, "vec_new") {
        7
    } else if name_eq_lit(q, "push") {
        8
    } else if name_eq_lit(q, "pop") {
        9
    } else if name_eq_lit(q, "vec_to_array") {
        10
    } else if name_eq_lit(q, "read_file") {
        11
    } else if name_eq_lit(q, "write_file") {
        12
    } else if name_eq_lit(q, "print_bytes") {
        13
    } else {
        0 - 1
    }
}

// Resolve a call name to a FnId: a builtin (0..=13), else a user fn (14 + its
// index in the user-fn table), else -1.
fn fn_lookup(src: &[u8], ufs: &Vec<i64>, ufe: &Vec<i64>, q: &[u8]) -> i64 {
    let b: i64 = builtin_id(q);
    if b >= 0 {
        b
    } else {
        let n: i64 = len(*ufs);
        let mut i: i64 = 0;
        let mut found: i64 = 0 - 1;
        while i < n {
            if found == 0 - 1 {
                if name_eq_src(src, (*ufs)[i], (*ufe)[i], q) {
                    found = 14 + i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        found
    }
}

// Resolve a variable name to its VarId — newest-first (high→low) over this fn's
// scope range `[base, top)`; the varid is the binding's scope index. -1 if absent.
fn sc_lookup(src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, q: &[u8]) -> i64 {
    let top: i64 = len(*scs);
    let mut i: i64 = top - 1;
    let mut found: i64 = 0 - 1;
    while i >= base {
        if found == 0 - 1 {
            if name_eq_src(src, (*scs)[i], (*sce)[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// Route a discarded owned name's bytes into `garbage` so the `[u8]` is freed
// when `main` reclaims `garbage` (vec_to_array) — the leak-free disposal.
fn sink_name(garbage: &mut Vec<u8>, name: [u8]) -> i64 {
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(garbage, name[i]);
        i = i + 1;
    }
    0
}

// --- resolved dump (1-phase consuming map: Expr → resolved S-expr) -----------

fn dump_rargs(out: &mut Vec<u8>, a: Args, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(hd, tl) => {
            push(out, ' ');
            dump_rexpr(out, hd, src, scs, sce, base, ufs, ufe, gb);
            dump_rargs(out, tl, src, scs, sce, base, ufs, ufe, gb);
            0
        },
    }
}

// A binding payload that is dropped (handler/match bindings) — sink its bytes.
fn sink_binds(gb: &mut Vec<u8>, b: Binds) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            sink_name(gb, nm);
            sink_binds(gb, rest);
            0
        },
    }
}

fn sink_pat(gb: &mut Vec<u8>, p: Pattern) -> i64 {
    match p {
        Pattern::PatWild => 0,
        Pattern::PatVariant(en, vn, bs) => {
            sink_name(gb, en);
            sink_name(gb, vn);
            sink_binds(gb, bs);
            0
        },
    }
}

fn dump_rexpr(out: &mut Vec<u8>, ex: Expr, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match ex {
        Expr::Int(nv) => {
            append_str(out, "(int ");
            append_int(out, nv);
            push(out, ')');
            0
        },
        Expr::Bool(bv) => {
            let blit: [u8] = if bv {
                "(bool true)"
            } else {
                "(bool false)"
            };
            append_str(out, blit);
            0
        },
        Expr::Null => {
            append_str(out, "(null)");
            0
        },
        Expr::Char(cv) => {
            append_str(out, "(char ");
            append_int(out, cv);
            push(out, ')');
            0
        },
        Expr::Str(sb) => {
            append_str(out, "(str");
            let sn: i64 = len(sb);
            let mut si: i64 = 0;
            while si < sn {
                push(out, ' ');
                append_int(out, u8_to_i64(sb[si]));
                si = si + 1;
            }
            push(out, ')');
            sink_name(gb, sb);
            0
        },
        Expr::Var(nm) => {
            let vid: i64 = sc_lookup(src, scs, sce, base, &nm);
            sink_name(gb, nm);
            append_str(out, "(var #");
            append_int(out, vid);
            push(out, ')');
            0
        },
        Expr::Unary(uop, inner) => {
            append_str(out, "(unary ");
            let usym: [u8] = if uop == 1 {
                "-"
            } else if uop == 2 {
                "!"
            } else if uop == 3 {
                "*"
            } else if uop == 4 {
                "&"
            } else {
                "&mut"
            };
            append_str(out, usym);
            push(out, ' ');
            dump_rexpr(out, inner, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Binary(bop, l, r) => {
            push(out, '(');
            let pfx: [u8] = if bop <= 7 {
                "binop"
            } else if bop <= 13 {
                "cmp"
            } else {
                "logic"
            };
            append_str(out, pfx);
            push(out, ' ');
            let bsym: [u8] = if bop == 1 {
                "+"
            } else if bop == 2 {
                "-"
            } else if bop == 3 {
                "*"
            } else if bop == 4 {
                "/"
            } else if bop == 5 {
                "&"
            } else if bop == 6 {
                "|"
            } else if bop == 7 {
                "^"
            } else if bop == 8 {
                "=="
            } else if bop == 9 {
                "!="
            } else if bop == 10 {
                "<"
            } else if bop == 11 {
                "<="
            } else if bop == 12 {
                ">"
            } else if bop == 13 {
                ">="
            } else if bop == 14 {
                "&&"
            } else {
                "||"
            };
            append_str(out, bsym);
            push(out, ' ');
            dump_rexpr(out, l, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, r, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Call(cn, ca) => {
            let fid: i64 = fn_lookup(src, ufs, ufe, &cn);
            sink_name(gb, cn);
            append_str(out, "(call #");
            append_int(out, fid);
            dump_rargs(out, ca, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Method(mt, mn, ma) => {
            append_str(out, "(method ");
            dump_rexpr(out, mt, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            append_str(out, mn);
            dump_rargs(out, ma, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Field(ft, fdn) => {
            append_str(out, "(field ");
            dump_rexpr(out, ft, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            append_str(out, fdn);
            push(out, ')');
            0
        },
        Expr::Index(it, ii) => {
            append_str(out, "(index ");
            dump_rexpr(out, it, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, ii, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Qcall(qi, qm, qa) => {
            append_str(out, "(qcall ");
            append_str(out, qi);
            push(out, ' ');
            append_str(out, qm);
            dump_rargs(out, qa, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::ClassInit(ci, cia) => {
            append_str(out, "(class-init ");
            append_str(out, ci);
            dump_rargs(out, cia, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Array(ae) => {
            append_str(out, "(array");
            dump_rargs(out, ae, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::If(ic, it2, ie2) => {
            append_str(out, "(if ");
            dump_rexpr(out, ic, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, it2, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, ie2, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Block(bstmts, btail) => {
            append_str(out, "(block");
            dump_rstmts(out, bstmts, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, btail, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::SynthZero => {
            append_str(out, "(int 0)");
            0
        },
        Expr::Match(mscr, marms) => {
            append_str(out, "(match ");
            dump_rexpr(out, mscr, src, scs, sce, base, ufs, ufe, gb);
            dump_rarms(out, marms, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::StructLit(sn, sf) => {
            append_str(out, "(struct-lit ");
            append_str(out, sn);
            dump_rfields(out, sf, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Declassify(di) => {
            append_str(out, "(declassify ");
            dump_rexpr(out, di, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Perform(pe, po, pa) => {
            append_str(out, "(perform ");
            append_str(out, pe);
            push(out, ' ');
            append_str(out, po);
            dump_rargs(out, pa, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Scope(sb) => {
            append_str(out, "(scope ");
            dump_rexpr(out, sb, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Spawn(sc) => {
            append_str(out, "(spawn ");
            dump_rexpr(out, sc, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Await(aw) => {
            append_str(out, "(await ");
            dump_rexpr(out, aw, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Expr::Handle(hb, ha, hr) => {
            append_str(out, "(handle ");
            dump_rexpr(out, hb, src, scs, sce, base, ufs, ufe, gb);
            dump_rharms(out, ha, src, scs, sce, base, ufs, ufe, gb);
            dump_rret(out, hr, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
    }
}

fn dump_rstmts(out: &mut Vec<u8>, st: Stmts, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(one, rest) => {
            push(out, ' ');
            dump_rstmt(out, one, src, scs, sce, base, ufs, ufe, gb);
            dump_rstmts(out, rest, src, scs, sce, base, ufs, ufe, gb);
            0
        },
    }
}

fn dump_rstmt(out: &mut Vec<u8>, s: Stmt, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            // MILESTONE-2: a `let` binds (grows the scope). m-1 has no `let`
            // seed; emit a placeholder (varid -1) + sink the name + the optional
            // type, resolve the value. Wired for real in m-2.
            append_str(out, "(let #-1 ");
            sink_name(gb, lnm);
            dump_rtyopt(out, lty);
            push(out, ' ');
            dump_rexpr(out, lval, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            dump_rexpr(out, atgt, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, aval, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            dump_rexpr(out, wcond, src, scs, sce, base, ufs, ufe, gb);
            push(out, ' ');
            dump_rexpr(out, wbody, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            dump_rexpr(out, sx, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of an optional `let` type annotation: the type, or `_`.
fn dump_rtyopt(out: &mut Vec<u8>, ty: TyOpt) -> i64 {
    match ty {
        TyOpt::NoTy => {
            push(out, '_');
            0
        },
        TyOpt::SomeTy(t) => {
            dump_type(out, t);
            0
        },
    }
}

// match arms (3c — placeholder): resolve the body, sink the pattern bindings.
fn dump_rarms(out: &mut Vec<u8>, a: Arms, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match a {
        Arms::ArmEnd => 0,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            sink_pat(gb, ap);
            dump_rexpr(out, abody, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            dump_rarms(out, arest, src, scs, sce, base, ufs, ufe, gb);
            0
        },
    }
}

fn dump_rfields(out: &mut Vec<u8>, f: Fields, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fv, fr) => {
            append_str(out, " (field ");
            append_str(out, fnm);
            push(out, ' ');
            dump_rexpr(out, fv, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            dump_rfields(out, fr, src, scs, sce, base, ufs, ufe, gb);
            0
        },
    }
}

fn dump_rharms(out: &mut Vec<u8>, a: HArms, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hbody, hrest) => {
            append_str(out, " (arm ");
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            push(out, ' ');
            dump_rexpr(out, hbody, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            dump_rharms(out, hrest, src, scs, sce, base, ufs, ufe, gb);
            0
        },
    }
}

fn dump_rret(out: &mut Vec<u8>, r: Ret, src: &[u8], scs: &Vec<i64>, sce: &Vec<i64>, base: i64, ufs: &Vec<i64>, ufe: &Vec<i64>, gb: &mut Vec<u8>) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody) => {
            append_str(out, " (return ");
            sink_name(gb, rnm);
            dump_rexpr(out, rbody, src, scs, sce, base, ufs, ufe, gb);
            push(out, ')');
            0
        },
    }
}

// --- fn header: parse + emit the param list, building the scope -------------
// `[mut] name : type` comma-separated up to `)` (already past the `(`). Each
// param → ` (param #vid [mut] name <type>)` (no leading space before the first)
// + its src-slice name pushed to the scope (varid = scope index). The names live
// in `src`, so nothing is consumed/sunk here.
fn emit_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, scs: &mut Vec<i64>, sce: &mut Vec<i64>, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_params(out, k, s, e, src, cur, scs, sce, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pty: TypeE = parse_type(k, s, e, src, cur);
        let vid: i64 = len(*scs);
        push(scs, ns);
        push(sce, ne);
        append_str(out, "(param #");
        append_int(out, vid);
        push(out, ' ');
        if pm {
            append_str(out, "mut ");
            0
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        dump_type(out, pty);
        push(out, ')');
        emit_params(out, k, s, e, src, cur, scs, sce, false)
    }
}

fn main() -> i64 {
    let path: [u8] = "input.sentinel";
    let src: [u8] = read_file(path);
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);

    // Pass 1: user-fn table (src slices; user fn k → id 14+k) + the user-effect
    // count (the built-in `Async` effect's id). m-1 is top-level fns only, so a
    // `fn`(3) token's successor is always a top-level fn name; `effect`(57)
    // counts user effects.
    let mut ufs: Vec<i64> = vec_new();
    let mut ufe: Vec<i64> = vec_new();
    let mut ecount: i64 = 0;
    let mut p1: i64 = 0;
    while p1 < ntok {
        if kinds[p1] == 3 {
            push(&mut ufs, starts[p1 + 1]);
            push(&mut ufe, ends[p1 + 1]);
            0
        } else {
            0
        };
        if kinds[p1] == 57 {
            ecount = ecount + 1;
            0
        } else {
            0
        };
        p1 = p1 + 1;
    }

    // The scope arrays (grow across fns; per-fn lookups respect a `base` floor)
    // + the name garbage sink.
    let mut scs: Vec<i64> = vec_new();
    let mut sce: Vec<i64> = vec_new();
    let mut garbage: Vec<u8> = vec_new();
    let mut out: Vec<u8> = vec_new();

    // Pass 2: resolve + dump each fn in source order.
    let mut cur: i64 = 0;
    let mut fnidx: i64 = 0;
    let mut firstfn: bool = true;
    while cur < ntok {
        if firstfn {
            0
        } else {
            push(&mut out, '\n');
            0
        };
        firstfn = false;
        if kinds[cur] == 59 {
            cur = cur + 1;
            0
        } else {
            0
        };
        // `fn` NAME `<…>?` `(` params `)` `->` RET `! {…}?` { body }
        cur = cur + 1;
        let name_s: i64 = starts[cur];
        let name_e: i64 = ends[cur];
        cur = cur + 1;
        if kinds[cur] == 15 {
            skip_type_params(&kinds, &mut cur)
        } else {
            0
        };
        cur = cur + 1;
        let base: i64 = len(scs);
        append_str(&mut out, "(fn #");
        append_int(&mut out, 14 + fnidx);
        push(&mut out, ' ');
        append_slice(&mut out, &src, name_s, name_e);
        append_str(&mut out, " (");
        emit_params(&mut out, &kinds, &starts, &ends, &src, &mut cur, &mut scs, &mut sce, true);
        append_str(&mut out, ") ");
        cur = cur + 1;
        let rty: TypeE = parse_type(&kinds, &starts, &ends, &src, &mut cur);
        if kinds[cur] == 24 {
            skip_effect_row(&kinds, &mut cur)
        } else {
            0
        };
        let body: Expr = parse_block(&kinds, &starts, &ends, &src, &mut cur);
        dump_type(&mut out, rty);
        push(&mut out, ' ');
        dump_rexpr(&mut out, body, &src, &scs, &sce, base, &ufs, &ufe, &mut garbage);
        push(&mut out, ')');
        fnidx = fnidx + 1;
    }

    // The built-in `Async` effect (id = the user-effect count) dumps LAST.
    push(&mut out, '\n');
    append_str(&mut out, "(effect #");
    append_int(&mut out, ecount);
    append_str(&mut out, " Async)");
    push(&mut out, '\n');

    let arr: [u8] = vec_to_array(out);
    print_bytes(arr);
    // Reclaim the name garbage (frees the resolved-away [u8] names) as a final act.
    let _g: [u8] = vec_to_array(garbage);
    0
}
