// Phase D self-host port (3/N) / ADR 0040: the resolve-stage-in-Sentinel.
// Reads `input.sentinel`, reuses the parser (a D.6 module — `use parser::…`) to
// build the AST, then NAME-RESOLVES it (every identifier → an integer ID) and
// prints the SAME canonical resolved dump as the Rust `snc resolve` oracle
// (ADR 0040 D2): the `snc ast` S-expr extended with the resolved IDs, e.g.
//   (struct #0 Point (field x i64) (field y i64))
//   (fn #14 main () i64 (block (let #0 _ (struct-lit #0 Point (field x (int 1)) (field y (int 2)))) (int 0)))
//   (effect #0 Async)
//
// SLICE STATUS (ADR 0040 D8):
//  * (3a) m-1+m-2: paramful fns + every expression form + `let`. DONE.
//  * (3b-1): top-level decl dispatch + the struct table + struct-lit `#id`.
//  * (3b-2): the enum table + `(enum #id Name (variant …))` heads + the
//    `Enum::Variant` / `Enum::init` → `(enum-construct #E …)` split (the enum
//    table is checked FIRST in both the `Qcall` and `ClassInit` arms).
//  * (3b-3): the effect table + `(effect #id Name (op name (params) ret)…)` heads
//    + `perform` → `(perform #E op_index Eff op args)`.
//  * (3b-4): the trait + impl tables + `(trait #id …)` heads (sigs, no bodies) +
//    `(impl #id name #trait_id Trait struct#tid Type (method #selfvid …))` heads
//    (method BODIES with a synthetic `self` VarId) + the `Qcall` else-branch →
//    `(qcall-impl #I method_index ImplName method args)` (method_index = scan the
//    impl's trait's methods). ⚠ VARIDS ARE GROUP-ORDERED: the Rust resolver
//    resolves ALL fn bodies before ANY impl method body, so varid ≠ scope index —
//    the scope stores EXPLICIT varids (`scv`), the fn region counts from `voff`,
//    and the impl region (`implvid`) counts from `voff + total-fn-bindings`.
//  * (3b-5): the class table + `(class #id Name (field …) (init #selfvid (params)
//    <block>)? (method #selfvid …)…)` heads — BUCKETED (fields, then init, then
//    methods; mirror the parser) with init/method BODIES (the init's `self` is a
//    synthetic `-1` sentinel matched by name; methods reuse rimpl_method) — + the
//    `ClassInit` else-branch → `(class-init #C Name args)` + `resume-kont` (a
//    `Call` whose callee is an in-scope var → `(resume-kont #vid …)`, the scope
//    checked BEFORE the fn table). The class group is resolved BEFORE impls, so
//    `classvid` counts from `voff + total-fn-bindings` and `implvid` continues
//    after it. (3b) is COMPLETE — every decl kind + every `::` form.
//  * (3c) match/while: the SCOPED bodies. The scope is a NAME BLOB (`nb`) — body
//    bindings (let/match-payload) come from the AST as owned `[u8]`, pushed into
//    the blob — and bindings are DURING-WALK (a `let`'s value resolves + binds its
//    nested vars BEFORE the let var). `match` arm payloads bind sequential VarIds
//    then **truncate** (D5 length-truncation: pop the scope back to a pre-arm mark
//    — visibility restored, VarIds stay sequential). `while` works via during-walk
//    (no truncation needed — names are unique per fn). `handle` arms +
//    `return v` arm bind VarIds (truncated after) → `(arm #eid op_index Eff op
//    (#vids) body)` / `(return #vid body)` (the parser now STORES handler-arm
//    params as a `Binds`). (3c) closes the full grammar.
//  * (3e) GROUP-ORDER resolution + the corpus phase-go. The Rust resolver resolves
//    EVERY fn body, then class methods, then impl methods (lib.rs:2559) — so the
//    VarId regions chain. Pass 1 only COLLECTS items (token pos + kind); pass 2
//    resolves in THREE groups (fns → `classvid = fnvid`; classes → `implvid =
//    classvid`; impls), BUFFERING each item's dump tagged by its source index, then
//    emits in source order. This computes each region's base from the prior
//    region's FINAL counter — NO binding-count precompute (the old token-counting
//    MISSED match/handler/return fn-region bindings → a wrong class base). Matches
//    `snc resolve` over the whole clean-resolving corpus (the D9 phase-go).
//  * delegate-impl synthesis (A12): a `class C { delegate f: T to Tr; }` → a FIELD
//    `(field f T)` (a delegate-field bucket, after the explicit fields) + a
//    SYNTHESISED forwarding `(impl #id _ #trait_id Tr class#cid C (method #selfvid
//    m … (block (method (field (var #selfvid) f) m (var #pvid)…))))` per trait
//    method (re-walked from the trait's sigs) — ImplIds + VarIds AFTER all user
//    impls, emitted at the class's source index. **The corpus differential now
//    covers the ENTIRE clean-resolving corpus (132 fixtures) — ADR 0040 ACCEPTED.**
//
// PROVEN SENTINEL IDIOMS (ADR 0040 A1/A4 probes; reused):
//  * Symbol tables + the local scope are FLAT parallel `Vec<i64>` arrays keyed
//    by SRC SLICES (start,end into `src`) — NOT cons-lists (you can't `match` a
//    `&enum`; a `&`-ref enum match aliases the heap → double-free on reuse).
//  * THE TABLES ARE BUNDLED IN A `RCtx` STRUCT threaded as `&mut RCtx` (A4
//    probe). Field access through the ref is ALWAYS `(*c).field` (bare `c.field`
//    is rejected through a ref); a read-only helper STILL takes `&mut RCtx`
//    (there is NO `&mut`→`&` auto-reborrow). `push(&mut (*c).f, x)` / `len((*c).f)`
//    / `(*c).f[i]` all work; cross-field read+write in one statement is allowed.
//    NEVER move a `Vec` field out of the struct (`vec_to_array((*c).f)` then a
//    struct drop SIGTRAPs) — the name `garbage` sink therefore stays a STANDALONE
//    `&mut Vec<u8>` param `gb`, reclaimed by `main`'s `vec_to_array`.
//  * varids are GLOBAL + sequential = push order, so a binding's varid is just
//    its index in the scope arrays (no separate id array needed). `base` (the
//    current fn's scope floor) lives in `RCtx`, set once per fn.
//  * An owned `[u8]` (the parser's `Var`/`Call` NAME payloads) is freed ONLY by
//    routing its bytes into a `Vec` reclaimed via `vec_to_array` — so each
//    resolved-away name is `sink_name`'d into `gb`, which `main` reclaims last.
//  * Pass 1 is a BRACE-DEPTH scan (depth 0 = top level) so method `fn`s inside
//    trait/impl/class bodies are NOT mistaken for top-level fns.

use parser::Expr;
use parser::Args;
use parser::Stmts;
use parser::Stmt;
use parser::Arms;
use parser::Pattern;
use parser::Binds;
use parser::Fields;
use parser::HArms;
use parser::Ret;
use parser::TyOpt;
use parser::TypeE;
use parser::tokenize;
use parser::parse_type;
use parser::parse_block;
use parser::skip_type_params;
use parser::skip_effect_row;
use parser::dump_type;
use parser::append_str;
use parser::append_int;
use parser::append_slice;

// The resolve context: every symbol table + the local scope, as flat parallel
// `Vec<i64>` arrays keyed by `src` slices, plus the per-kind decl ID counters and
// the current fn's scope floor. Threaded as `&mut RCtx`. (The name `garbage` sink
// is a SEPARATE `gb` param — a `Vec` field cannot be moved out of a struct.)
struct RCtx {
    nb: Vec<u8>,     // scope NAME BLOB — every binding's name bytes (params copy
                     //   their src bytes in; body bindings [let/match/handler] push
                     //   their AST `[u8]` bytes in, which also DISPOSES them). The
                     //   blob is reclaimed (vec_to_array) by main. Body bindings
                     //   come from the AST as owned `[u8]`, not token src slices, so
                     //   the scope can't key on `src` indices like the decl tables.
    scs: Vec<i64>,   // scope: binding name-slice starts (offsets into `nb`)
    sce: Vec<i64>,   // scope: binding name-slice ends (offsets into `nb`)
    scv: Vec<i64>,   // scope: binding VarId (EXPLICIT — varid ≠ array index, since
                     //   method-body VarIds are assigned in GROUP order [fns then
                     //   impls] while the scope array is built in source order)
    base: i64,       // the current item's scope floor (an ARRAY index; sc_lookup
                     //   scans [base, top) to isolate this item's bindings)
    nextvid: i64,    // the ACTIVE VarId counter (loaded from fnvid/implvid per item)
    voff: i64,       // effect-op-param count = the fn-region VarId base
    fnvid: i64,      // saved fn-region VarId counter (starts voff)
    ufs: Vec<i64>,   // user-fn table: name-slice starts (FnId = 21 + index)
    ufe: Vec<i64>,   // user-fn table: name-slice ends
    sts: Vec<i64>,   // struct table: name-slice starts (StructId = index)
    ste: Vec<i64>,   // struct table: name-slice ends
    ens: Vec<i64>,   // enum table: name-slice starts (EnumId = index)
    ene: Vec<i64>,   // enum table: name-slice ends
    efs: Vec<i64>,   // effect table: name-slice starts (EffectId = index)
    efe: Vec<i64>,   // effect table: name-slice ends
    efoo: Vec<i64>,  // effect-op list: owner EffectId (one entry per op)
    efos: Vec<i64>,  // effect-op list: op name-slice starts
    efoe: Vec<i64>,  // effect-op list: op name-slice ends
    trs: Vec<i64>,   // trait table: name-slice starts (TraitId = index)
    tre: Vec<i64>,   // trait table: name-slice ends
    trpos: Vec<i64>, // trait table: the trait keyword's token index (for delegate
                     //   synthesis — re-walk the trait's method sigs by TraitId)
    trmo: Vec<i64>,  // trait-method list: owner TraitId (one entry per method)
    trms: Vec<i64>,  // trait-method list: method name-slice starts
    trme: Vec<i64>,  // trait-method list: method name-slice ends
    dgcid: Vec<i64>, // delegate records: owning ClassId (one entry per delegate)
    dgfs: Vec<i64>,  // delegate records: the delegate FIELD name-slice starts
    dgfe: Vec<i64>,  // delegate records: the delegate FIELD name-slice ends
    dgts: Vec<i64>,  // delegate records: the delegated-to TRAIT name-slice starts
    dgte: Vec<i64>,  // delegate records: the delegated-to TRAIT name-slice ends
    imns: Vec<i64>,  // impl table: impl name-slice starts (ImplId = index; a
    imne: Vec<i64>,  //   default/unnamed impl gets a 0,0 slot — never name-matched)
    imts: Vec<i64>,  // impl table: the impl's trait name-slice starts
    imte: Vec<i64>,  // impl table: the impl's trait name-slice ends
    cls: Vec<i64>,   // class table: name-slice starts (ClassId = index)
    cle: Vec<i64>,   // class table: name-slice ends
    classvid: i64,   // saved class-region VarId counter (= fnvid after ALL fns)
    implvid: i64,    // saved impl-region VarId counter (= classvid after ALL classes)
    fnct: i64,       // next user-fn index (pass-2 source-order counter)
    structct: i64,   // next struct index (pass-2 source-order counter)
    enumct: i64,     // next enum index (pass-2 source-order counter)
    effct: i64,      // next effect index (pass-2 source-order counter)
    traitct: i64,    // next trait index (pass-2 source-order counter)
    implct: i64,     // next impl index (pass-2 source-order counter)
    classct: i64,    // next class index (pass-2 source-order counter)
}

// --- name comparison --------------------------------------------------------

// Compare `src[st..en]` to the owned query name `q` (a borrowed `&[u8]`).
fn name_eq_src(src: &[u8], st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*src)[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare the owned query name `q` (borrowed) to a string literal `lit`.
fn name_eq_lit(q: &[u8], lit: [u8]) -> bool {
    let qn: i64 = len(*q);
    let ln: i64 = len(lit);
    if qn != ln {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < ln {
            if (*q)[i] != lit[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare two `src` slices `src[as_..ae]` and `src[bs..be]` for byte-equality.
fn slice_eq_src(src: &[u8], as_: i64, ae: i64, bs: i64, be: i64) -> bool {
    let la: i64 = ae - as_;
    let lb: i64 = be - bs;
    if la != lb {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < la {
            if (*src)[as_ + i] != (*src)[bs + i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// The 14 runtime builtins → their reserved FnIds (0..=13), or -1 if `q` is not a
// builtin. Same order as sentinel-resolve's pre-registration (ADR 0035 D2).
fn builtin_id(q: &[u8]) -> i64 {
    if name_eq_lit(q, "print") {
        0
    } else if name_eq_lit(q, "unwrap_or") {
        1
    } else if name_eq_lit(q, "is_some") {
        2
    } else if name_eq_lit(q, "len") {
        3
    } else if name_eq_lit(q, "str_eq") {
        4
    } else if name_eq_lit(q, "u8_to_i64") {
        5
    } else if name_eq_lit(q, "i64_to_u8") {
        6
    } else if name_eq_lit(q, "vec_new") {
        7
    } else if name_eq_lit(q, "push") {
        8
    } else if name_eq_lit(q, "pop") {
        9
    } else if name_eq_lit(q, "vec_to_array") {
        10
    } else if name_eq_lit(q, "read_file") {
        11
    } else if name_eq_lit(q, "write_file") {
        12
    } else if name_eq_lit(q, "print_bytes") {
        13
    } else {
        0 - 1
    }
}

// Resolve a call name to a FnId: a builtin (0..=13), else a user fn (21 + its
// index in the user-fn table), else -1.
fn fn_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let b: i64 = builtin_id(q);
    if b >= 0 {
        b
    } else {
        let n: i64 = len((*c).ufs);
        let mut i: i64 = 0;
        let mut found: i64 = 0 - 1;
        while i < n {
            if found == 0 - 1 {
                if name_eq_src(src, (*c).ufs[i], (*c).ufe[i], q) {
                    found = 21 + i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        found
    }
}

// Resolve a variable name to its VarId — newest-first (high→low) over this item's
// scope range `[base, top)` (array indices); returns the binding's STORED VarId
// (`scv`), or -1 if absent.
fn sc_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let top: i64 = len((*c).scs);
    let mut i: i64 = top - 1;
    let mut found: i64 = 0 - 1;
    while i >= (*c).base {
        if found == 0 - 1 {
            if blob_eq(c, (*c).scs[i], (*c).sce[i], q) {
                found = (*c).scv[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// Resolve a struct name to its StructId (its index in the struct table), or -1.
fn struct_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).sts);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).sts[i], (*c).ste[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a struct by a `src` SLICE (an impl's stored target type name) to its
// StructId, or -1 (used for the `impl … for Type` target tag).
fn struct_lookup_slice(c: &mut RCtx, src: &[u8], ts: i64, te: i64) -> i64 {
    let n: i64 = len((*c).sts);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if slice_eq_src(src, (*c).sts[i], (*c).ste[i], ts, te) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a class name to its ClassId (its index in the class table), or -1.
fn class_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).cls);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).cls[i], (*c).cle[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a class by a `src` SLICE (an impl's target type name) to its ClassId,
// or -1. The Rust resolver checks the class table BEFORE the struct table
// (lib.rs:2253), so `impl … for Type` prefers a class target.
fn class_lookup_slice(c: &mut RCtx, src: &[u8], ts: i64, te: i64) -> i64 {
    let n: i64 = len((*c).cls);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if slice_eq_src(src, (*c).cls[i], (*c).cle[i], ts, te) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Is the `src` slice the literal keyword `init`? (Class init constructors lex as a
// plain `init` ident; the dispatch slice-compares it.)
fn is_init_slice(src: &[u8], st: i64, en: i64) -> bool {
    if en - st != 4 {
        false
    } else {
        ((*src)[st] == 'i') && ((*src)[st + 1] == 'n') && ((*src)[st + 2] == 'i') && ((*src)[st + 3] == 't')
    }
}

// Resolve an enum name to its EnumId (its index in the enum table), or -1.
fn enum_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).ens);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).ens[i], (*c).ene[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve an effect name to its EffectId (its index in the effect table), or -1.
fn effect_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).efs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).efs[i], (*c).efe[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// op_index = the position of op `q` among effect `eid`'s ops (a linear scan of
// the flat op list, counting only entries owned by `eid`, in source order). -1 if
// absent. Mirrors lib.rs:4258 (the effect_decl.ops `.position(…)`).
fn op_index_lookup(c: &mut RCtx, src: &[u8], eid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).efoo);
    let mut i: i64 = 0;
    let mut pos: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).efoo[i] == eid {
                if name_eq_src(src, (*c).efos[i], (*c).efoe[i], q) {
                    found = pos;
                    0
                } else {
                    0
                };
                pos = pos + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a trait name to its TraitId (its index in the trait table), or -1.
fn trait_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).trs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).trs[i], (*c).tre[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a trait by a `src` SLICE (an impl's stored trait name) to its TraitId.
fn trait_lookup_slice(c: &mut RCtx, src: &[u8], ts: i64, te: i64) -> i64 {
    let n: i64 = len((*c).trs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if slice_eq_src(src, (*c).trs[i], (*c).tre[i], ts, te) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a (named) impl to its ImplId (its index in the impl table), or -1.
fn impl_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).imns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).imns[i], (*c).imne[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// method_index = the position of method `q` among trait `tid`'s methods (a linear
// scan of the flat trait-method list, counting only entries owned by `tid`, in
// source order). -1 if absent. Mirrors lib.rs:3863 (method_names `.position(…)`).
fn method_index_in_trait(c: &mut RCtx, src: &[u8], tid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).trmo);
    let mut i: i64 = 0;
    let mut pos: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).trmo[i] == tid {
                if name_eq_src(src, (*c).trms[i], (*c).trme[i], q) {
                    found = pos;
                    0
                } else {
                    0
                };
                pos = pos + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Consume a method's mandatory `self : & [mut] Self` receiver (cur at `self`) and
// return whether it is exclusive (`&mut Self`). Mirrors the parser's
// parse_self_kind: `self`(ident) `:`(31) `&`(23) `[mut(46)]` `Self`(ident).
fn rparse_self_kind(k: &Vec<i64>, cur: &mut i64) -> bool {
    *cur = *cur + 1;
    *cur = *cur + 1;
    *cur = *cur + 1;
    let excl: bool = (*k)[*cur] == 46;
    if excl {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;
    excl
}

// Route a discarded owned name's bytes into `gb` so the `[u8]` is freed when
// `main` reclaims `gb` (vec_to_array) — the leak-free disposal.
fn sink_name(gb: &mut Vec<u8>, name: [u8]) -> i64 {
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(gb, name[i]);
        i = i + 1;
    }
    0
}

// --- scope binding (the name blob) ------------------------------------------

// Bind a name given as a `src` slice (a param / a `self:` receiver token): copy
// its bytes into the blob, record the binding (blob slice + VarId).
fn bind_src(c: &mut RCtx, src: &[u8], ns: i64, ne: i64, vid: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let mut i: i64 = ns;
    while i < ne {
        push(&mut (*c).nb, (*src)[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + (ne - ns));
    push(&mut (*c).scv, vid);
    0
}

// Bind a name given as an owned `[u8]` (a `let` / match-payload / handler-param /
// `init` self): push its bytes into the blob (which also DISPOSES the `[u8]`),
// record the binding.
fn bind_name(c: &mut RCtx, name: [u8], vid: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(&mut (*c).nb, name[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + n);
    push(&mut (*c).scv, vid);
    0
}

// Compare a blob slice `nb[st..en]` to the query name `q`.
fn blob_eq(c: &mut RCtx, st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*c).nb[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// D5 scope snapshot/restore = length truncation: pop the scope arrays back to
// `mark` (an array length recorded before a scoped region — a match arm, `while`
// body, handler arm, or return arm). The VarId counter (`nextvid`) is NOT reset
// (VarIds stay globally sequential); only VISIBILITY is restored. The blob bytes
// stay (reclaimed by main); only the scope refs are popped.
fn truncate_scope(c: &mut RCtx, mark: i64) -> i64 {
    let mut t: i64 = len((*c).scs);
    while t > mark {
        pop(&mut (*c).scs);
        pop(&mut (*c).sce);
        pop(&mut (*c).scv);
        t = t - 1;
    }
    0
}

// --- resolved dump (1-phase consuming map: Expr → resolved S-expr) -----------

fn dump_rargs(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(hd, tl) => {
            push(out, ' ');
            dump_rexpr(out, hd, src, c, gb);
            dump_rargs(out, tl, src, c, gb);
            0
        },
    }
}

// (3c) A match-arm pattern's payload bindings: each binds a fresh VarId (in
// source order) into the arm's scope + dumps ` #vid`. The names' bytes are routed
// into the blob by bind_name (which also disposes the AST `[u8]`).
fn dump_rbinds(out: &mut Vec<u8>, b: Binds, c: &mut RCtx) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            let bvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, nm, bvid);
            append_str(out, " #");
            append_int(out, bvid);
            dump_rbinds(out, rest, c);
            0
        },
    }
}

// `_` → `(pat _)`; `Enum::Variant(b1,…)` → `(pat Enum Variant #vid…)` (the enum +
// variant names are emitted, which disposes them; the payloads bind VarIds).
fn dump_rpat(out: &mut Vec<u8>, p: Pattern, c: &mut RCtx) -> i64 {
    match p {
        Pattern::PatWild => {
            append_str(out, "(pat _)");
            0
        },
        Pattern::PatVariant(en, vn, bs) => {
            append_str(out, "(pat ");
            append_str(out, en);
            push(out, ' ');
            append_str(out, vn);
            dump_rbinds(out, bs, c);
            push(out, ')');
            0
        },
    }
}

fn dump_rexpr(out: &mut Vec<u8>, ex: Expr, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match ex {
        Expr::Int(nv) => {
            append_str(out, "(int ");
            append_int(out, nv);
            push(out, ')');
            0
        },
        Expr::Bool(bv) => {
            let blit: [u8] = if bv {
                "(bool true)"
            } else {
                "(bool false)"
            };
            append_str(out, blit);
            0
        },
        Expr::Null => {
            append_str(out, "(null)");
            0
        },
        Expr::Char(cv) => {
            append_str(out, "(char ");
            append_int(out, cv);
            push(out, ')');
            0
        },
        Expr::Str(sb) => {
            append_str(out, "(str");
            let sn: i64 = len(sb);
            let mut si: i64 = 0;
            while si < sn {
                push(out, ' ');
                append_int(out, u8_to_i64(sb[si]));
                si = si + 1;
            }
            push(out, ')');
            sink_name(gb, sb);
            0
        },
        Expr::Var(nm) => {
            let vid: i64 = sc_lookup(c, src, &nm);
            sink_name(gb, nm);
            append_str(out, "(var #");
            append_int(out, vid);
            push(out, ')');
            0
        },
        Expr::Unary(uop, inner) => {
            append_str(out, "(unary ");
            let usym: [u8] = if uop == 1 {
                "-"
            } else if uop == 2 {
                "!"
            } else if uop == 3 {
                "*"
            } else if uop == 4 {
                "&"
            } else {
                "&mut"
            };
            append_str(out, usym);
            push(out, ' ');
            dump_rexpr(out, inner, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Binary(bop, l, r) => {
            push(out, '(');
            let pfx: [u8] = if bop <= 7 || bop == 16 || bop == 17 {
                "binop"
            } else if bop <= 13 {
                "cmp"
            } else {
                "logic"
            };
            append_str(out, pfx);
            push(out, ' ');
            let bsym: [u8] = if bop == 1 {
                "+"
            } else if bop == 2 {
                "-"
            } else if bop == 3 {
                "*"
            } else if bop == 4 {
                "/"
            } else if bop == 5 {
                "&"
            } else if bop == 6 {
                "|"
            } else if bop == 7 {
                "^"
            } else if bop == 8 {
                "=="
            } else if bop == 9 {
                "!="
            } else if bop == 10 {
                "<"
            } else if bop == 11 {
                "<="
            } else if bop == 12 {
                ">"
            } else if bop == 13 {
                ">="
            } else if bop == 14 {
                "&&"
            } else if bop == 16 {
                "<<"
            } else if bop == 17 {
                ">>"
            } else {
                "||"
            };
            append_str(out, bsym);
            push(out, ' ');
            dump_rexpr(out, l, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, r, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Call(cn, ca) => {
            // A callee that resolves to an in-scope VarId is a continuation-resume
            // `k(arg)` (vars shadow fns — mirror lib.rs:3516); else a free-fn call.
            let kid: i64 = sc_lookup(c, src, &cn);
            if kid >= 0 {
                sink_name(gb, cn);
                append_str(out, "(resume-kont #");
                append_int(out, kid);
                dump_rargs(out, ca, src, c, gb);
                push(out, ')');
                0
            } else {
                let fid: i64 = fn_lookup(c, src, &cn);
                sink_name(gb, cn);
                append_str(out, "(call #");
                append_int(out, fid);
                dump_rargs(out, ca, src, c, gb);
                push(out, ')');
                0
            }
        },
        Expr::Method(mt, mn, ma) => {
            append_str(out, "(method ");
            dump_rexpr(out, mt, src, c, gb);
            push(out, ' ');
            append_str(out, mn);
            dump_rargs(out, ma, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Field(ft, fdn) => {
            append_str(out, "(field ");
            dump_rexpr(out, ft, src, c, gb);
            push(out, ' ');
            append_str(out, fdn);
            push(out, ')');
            0
        },
        Expr::Index(it, ii) => {
            append_str(out, "(index ");
            dump_rexpr(out, it, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, ii, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Qcall(qi, qm, qa) => {
            // `Name::method(args)` / paren-less `Name::Variant`. Resolve splits on
            // the leading name: an enum (checked FIRST, mirror lib.rs:3830) →
            // `(enum-construct #E Enum Variant args)`; else the `(qcall …)`
            // placeholder until (3b-4) makes it `(qcall-impl …)`.
            let qeid: i64 = enum_lookup(c, src, &qi);
            if qeid >= 0 {
                append_str(out, "(enum-construct #");
                append_int(out, qeid);
                push(out, ' ');
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                dump_rargs(out, qa, src, c, gb);
                push(out, ')');
                0
            } else {
                // a named impl: `Impl::method(args)` → `(qcall-impl #I
                // method_index ImplName method args)` (mirror lib.rs:3852). The
                // impl's trait (its stored trait-name slice → TraitId) gives the
                // method's index in that trait's method list.
                let iidx: i64 = impl_lookup(c, src, &qi);
                let its: i64 = (*c).imts[iidx];
                let ite: i64 = (*c).imte[iidx];
                let qtid: i64 = trait_lookup_slice(c, src, its, ite);
                let qmidx: i64 = method_index_in_trait(c, src, qtid, &qm);
                append_str(out, "(qcall-impl #");
                append_int(out, iidx);
                push(out, ' ');
                append_int(out, qmidx);
                push(out, ' ');
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                dump_rargs(out, qa, src, c, gb);
                push(out, ')');
                0
            }
        },
        Expr::ClassInit(ci, cia) => {
            // `Name::init(args)`. An enum named `Name` (checked FIRST, mirror
            // lib.rs:3768) → `(enum-construct #E Name init args)` (unreachable on
            // clean fixtures — the parser rejects an `init` enum variant — but
            // faithful); else the `(class-init …)` placeholder until (3b-5).
            let ceid: i64 = enum_lookup(c, src, &ci);
            if ceid >= 0 {
                append_str(out, "(enum-construct #");
                append_int(out, ceid);
                push(out, ' ');
                append_str(out, ci);
                append_str(out, " init");
                dump_rargs(out, cia, src, c, gb);
                push(out, ')');
                0
            } else {
                // `Name::init(args)` → `(class-init #C Name args)` (mirror
                // lib.rs:3790).
                let cidx: i64 = class_lookup(c, src, &ci);
                append_str(out, "(class-init #");
                append_int(out, cidx);
                push(out, ' ');
                append_str(out, ci);
                dump_rargs(out, cia, src, c, gb);
                push(out, ')');
                0
            }
        },
        Expr::Array(ae) => {
            append_str(out, "(array");
            dump_rargs(out, ae, src, c, gb);
            push(out, ')');
            0
        },
        Expr::If(ic, it2, ie2) => {
            append_str(out, "(if ");
            dump_rexpr(out, ic, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, it2, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, ie2, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Block(bstmts, btail) => {
            append_str(out, "(block");
            dump_rstmts(out, bstmts, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, btail, src, c, gb);
            push(out, ')');
            0
        },
        Expr::SynthZero => {
            append_str(out, "(int 0)");
            0
        },
        Expr::Match(mscr, marms) => {
            append_str(out, "(match ");
            dump_rexpr(out, mscr, src, c, gb);
            dump_rarms(out, marms, src, c, gb);
            push(out, ')');
            0
        },
        Expr::StructLit(sn, sf) => {
            let sid: i64 = struct_lookup(c, src, &sn);
            append_str(out, "(struct-lit #");
            append_int(out, sid);
            push(out, ' ');
            append_str(out, sn);
            dump_rfields(out, sf, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Declassify(di) => {
            append_str(out, "(declassify ");
            dump_rexpr(out, di, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Cast(ci, cnm) => {
            append_str(out, "(cast ");
            dump_rexpr(out, ci, src, c, gb);
            push(out, ' ');
            append_str(out, cnm);
            push(out, ')');
            0
        },
        Expr::Perform(pe, po, pa) => {
            // `perform Eff.op(args)` → `(perform #E op_index Eff op args)` (mirror
            // resolve_perform_expr, lib.rs:4250). op_index = the op's position in
            // the effect's op list.
            let peid: i64 = effect_lookup(c, src, &pe);
            let poidx: i64 = op_index_lookup(c, src, peid, &po);
            append_str(out, "(perform #");
            append_int(out, peid);
            push(out, ' ');
            append_int(out, poidx);
            push(out, ' ');
            append_str(out, pe);
            push(out, ' ');
            append_str(out, po);
            dump_rargs(out, pa, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Scope(sb) => {
            append_str(out, "(scope ");
            dump_rexpr(out, sb, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Spawn(sc) => {
            append_str(out, "(spawn ");
            dump_rexpr(out, sc, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Await(aw) => {
            append_str(out, "(await ");
            dump_rexpr(out, aw, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Handle(hb, ha, hr) => {
            append_str(out, "(handle ");
            dump_rexpr(out, hb, src, c, gb);
            dump_rharms(out, ha, src, c, gb);
            dump_rret(out, hr, src, c, gb);
            push(out, ')');
            0
        },
    }
}

fn dump_rstmts(out: &mut Vec<u8>, st: Stmts, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(one, rest) => {
            push(out, ' ');
            dump_rstmt(out, one, src, c, gb);
            dump_rstmts(out, rest, src, c, gb);
            0
        },
    }
}

fn dump_rstmt(out: &mut Vec<u8>, s: Stmt, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            // DURING-WALK binding (mirror the Rust source-order walk): resolve the
            // VALUE first — it may bind nested vars (a `match`/`if` in the value),
            // which take the lower VarIds — THEN bind the `let` var. So the value is
            // dumped into a temp buffer, the let's VarId is taken AFTER, and the
            // value is spliced in. Format: `(let #vid [mut] <ty-or-_> <value>)`.
            let mut vbuf: Vec<u8> = vec_new();
            dump_rexpr(&mut vbuf, lval, src, c, gb);
            let lvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, lnm, lvid);
            append_str(out, "(let #");
            append_int(out, lvid);
            push(out, ' ');
            if lmf {
                append_str(out, "mut ");
                0
            } else {
                0
            };
            dump_rtyopt(out, lty);
            push(out, ' ');
            append_str(out, vec_to_array(vbuf));
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            dump_rexpr(out, atgt, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, aval, src, c, gb);
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            dump_rexpr(out, wcond, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, wbody, src, c, gb);
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            dump_rexpr(out, sx, src, c, gb);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of an optional `let` type annotation: the type, or `_`.
fn dump_rtyopt(out: &mut Vec<u8>, ty: TyOpt) -> i64 {
    match ty {
        TyOpt::NoTy => {
            push(out, '_');
            0
        },
        TyOpt::SomeTy(t) => {
            dump_type(out, t);
            0
        },
    }
}

// match arms (3c — placeholder): resolve the body, sink the pattern bindings.
// (3c) Each match arm: snapshot the scope, dump the pattern (binding its payload
// VarIds), resolve the body (which sees the payloads), then TRUNCATE the scope
// back (the payloads are scoped to this arm only; VarIds stay sequential).
fn dump_rarms(out: &mut Vec<u8>, a: Arms, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Arms::ArmEnd => 0,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            let mark: i64 = len((*c).scs);
            dump_rpat(out, ap, c);
            push(out, ' ');
            dump_rexpr(out, abody, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            dump_rarms(out, arest, src, c, gb);
            0
        },
    }
}

fn dump_rfields(out: &mut Vec<u8>, f: Fields, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fv, fr) => {
            append_str(out, " (field ");
            append_str(out, fnm);
            push(out, ' ');
            dump_rexpr(out, fv, src, c, gb);
            push(out, ')');
            dump_rfields(out, fr, src, c, gb);
            0
        },
    }
}

// (3c) A handler arm's params: each binds a fresh VarId (in source order) into the
// arm's scope + dumps `#vid` (space-separated, first no leading space — they sit
// inside the `(…)`). The names' bytes route into the blob (bind_name disposes the
// AST `[u8]`).
fn dump_rhparams(out: &mut Vec<u8>, b: Binds, c: &mut RCtx, first: bool) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            if first {
                0
            } else {
                push(out, ' ');
                0
            };
            let pvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, nm, pvid);
            push(out, '#');
            append_int(out, pvid);
            dump_rhparams(out, rest, c, false);
            0
        },
    }
}

// (3c) Each handler arm → `(arm #eid op_index Eff op (#paramvids) body)` (mirror
// resolve_dump.rs:342): the effect/op resolve to their IDs; the params bind VarIds
// scoped to the arm (truncated after).
fn dump_rharms(out: &mut Vec<u8>, a: HArms, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hparams, hbody, hrest) => {
            let heid: i64 = effect_lookup(c, src, &hef);
            let hoidx: i64 = op_index_lookup(c, src, heid, &hop);
            append_str(out, " (arm #");
            append_int(out, heid);
            push(out, ' ');
            append_int(out, hoidx);
            push(out, ' ');
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            append_str(out, " (");
            let mark: i64 = len((*c).scs);
            dump_rhparams(out, hparams, c, true);
            append_str(out, ") ");
            dump_rexpr(out, hbody, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            dump_rharms(out, hrest, src, c, gb);
            0
        },
    }
}

// (3c) The optional `return v => body` arm → `(return #vid body)`: `v` binds a
// VarId scoped to the return arm (truncated after).
fn dump_rret(out: &mut Vec<u8>, r: Ret, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody, rnt, rt0) => {
            let _a: i64 = rnt;
            let _b: i64 = rt0;
            let mark: i64 = len((*c).scs);
            let rvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, rnm, rvid);
            append_str(out, " (return #");
            append_int(out, rvid);
            push(out, ' ');
            dump_rexpr(out, rbody, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            0
        },
    }
}

// --- struct decl head (3b-1): `(struct #id Name (field name <type>)…)` --------
// Pure syntax (field types need no resolution); mirrors the parser's
// dump_struct_fields but prefixed with the resolved StructId.
fn dump_rstruct_fields(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_rstruct_fields(out, k, s, e, src, cur)
    } else {
        let fnm_s: i64 = (*s)[*cur];
        let fnm_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let fty: TypeE = parse_type(k, s, e, src, cur);
        append_str(out, " (field ");
        append_slice(out, src, fnm_s, fnm_e);
        push(out, ' ');
        dump_type(out, fty);
        push(out, ')');
        dump_rstruct_fields(out, k, s, e, src, cur)
    }
}

fn resolve_struct(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, sid: i64) -> i64 {
    *cur = *cur + 1;             // skip `struct`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    if (*k)[*cur] == 15 {
        skip_type_params(k, cur)
    } else {
        0
    };
    *cur = *cur + 1;            // skip `{`
    append_str(out, "(struct #");
    append_int(out, sid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_rstruct_fields(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- enum decl head (3b-2): `(enum #id Name (variant V <payloads>)…)` ---------
// Pure syntax (payload types need no resolution); mirrors the parser's
// dump_enum_decl / dump_variants / dump_payloads, prefixed with the EnumId.
fn dump_renum_payloads(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_renum_payloads(out, k, s, e, src, cur)
    } else {
        let pty: TypeE = parse_type(k, s, e, src, cur);
        push(out, ' ');
        dump_type(out, pty);
        dump_renum_payloads(out, k, s, e, src, cur)
    }
}

fn dump_renum_variants(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_renum_variants(out, k, s, e, src, cur)
    } else {
        let vn_s: i64 = (*s)[*cur];
        let vn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        append_str(out, " (variant ");
        append_slice(out, src, vn_s, vn_e);
        if (*k)[*cur] == 4 {
            *cur = *cur + 1;
            dump_renum_payloads(out, k, s, e, src, cur);
            0
        } else {
            0
        };
        push(out, ')');
        dump_renum_variants(out, k, s, e, src, cur)
    }
}

fn resolve_enum(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64) -> i64 {
    *cur = *cur + 1;            // skip `enum`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;           // skip `{` (enums are non-generic)
    append_str(out, "(enum #");
    append_int(out, eid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_renum_variants(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- effect decl head (3b-3): `(effect #id Name (op name (params) ret)…)` ------
// Pure syntax — effect op params dump WITHOUT VarIds (`(param [mut] name <type>)`,
// like trait params; resolve_dump.rs:500). The op params DO consume global
// VarIds in the Rust resolver (lib.rs:2000) → reproduced as phantom scope slots
// (see scan_ops_of). Mirrors the parser's dump_effect_decl / dump_ops; an op's
// missing return type dumps `_`.
fn emit_op_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_op_params(out, k, s, e, src, cur, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pty: TypeE = parse_type(k, s, e, src, cur);
        append_str(out, "(param ");
        if pm {
            append_str(out, "mut ");
            0
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        dump_type(out, pty);
        push(out, ')');
        emit_op_params(out, k, s, e, src, cur, false)
    }
}

fn dump_reffect_ops(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        dump_reffect_ops(out, k, s, e, src, cur)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;           // skip `(`
        append_str(out, " (op ");
        append_slice(out, src, on_s, on_e);
        append_str(out, " (");
        emit_op_params(out, k, s, e, src, cur, true);
        append_str(out, ") ");
        if (*k)[*cur] == 8 {
            *cur = *cur + 1;
            let rt: TypeE = parse_type(k, s, e, src, cur);
            dump_type(out, rt);
            0
        } else {
            push(out, '_');
            0
        };
        push(out, ')');
        dump_reffect_ops(out, k, s, e, src, cur)
    }
}

fn resolve_effect(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64) -> i64 {
    *cur = *cur + 1;            // skip `effect`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;           // skip `{`
    append_str(out, "(effect #");
    append_int(out, eid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_reffect_ops(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- trait decl head (3b-4): `(trait #id Name (method name <kind> (params) ret)…)`
// Pure syntax — trait method sigs have NO bodies and their params dump WITHOUT
// VarIds (`(param name type)`, reusing emit_op_params). `self` is shown only via
// the shared/exclusive kind word, not as a param. Mirrors the parser's
// dump_trait_decl / dump_method_head.
fn rtrait_method_head(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;           // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;           // skip `(`
    let excl: bool = rparse_self_kind(k, cur);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(out, " (method ");
    append_slice(out, src, mn_s, mn_e);
    push(out, ' ');
    append_str(out, skw);
    append_str(out, " (");
    emit_op_params(out, k, s, e, src, cur, true);
    append_str(out, ") ");
    *cur = *cur + 1;           // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    dump_type(out, mret);
    0
}

fn dump_rtrait_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else {
        rtrait_method_head(out, k, s, e, src, cur);
        *cur = *cur + 1;       // skip `;`
        push(out, ')');
        dump_rtrait_methods(out, k, s, e, src, cur)
    }
}

fn resolve_trait(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, tid: i64) -> i64 {
    *cur = *cur + 1;           // skip `trait`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;           // skip `{`
    append_str(out, "(trait #");
    append_int(out, tid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_rtrait_methods(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- impl decl head (3b-4): `(impl #id name #trait_id TraitName struct#tid Type
// (method #selfvid name <kind> (params) ret <block>)…)`. Impl methods HAVE bodies
// → a synthetic `self` VarId (bound first, from the impl-region counter) + the
// params + body lets, all resolved against this method's scope. Mirrors the
// parser's dump_impl_decl + lib.rs's impl-method body resolution.
fn rimpl_method(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    (*c).base = len((*c).scs);   // this method's scope floor
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;             // skip `(`
    let self_s: i64 = (*s)[*cur];   // the `self` receiver token
    let self_e: i64 = (*e)[*cur];
    let excl: bool = rparse_self_kind(k, cur);
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    bind_src(c, src, self_s, self_e, selfvid);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(out, " (method #");
    append_int(out, selfvid);
    push(out, ' ');
    append_slice(out, src, mn_s, mn_e);
    push(out, ' ');
    append_str(out, skw);
    append_str(out, " (");
    emit_params(out, k, s, e, src, cur, c, true);
    append_str(out, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let mbody: Expr = parse_block(k, s, e, src, cur);
    dump_type(out, mret);
    push(out, ' ');
    dump_rexpr(out, mbody, src, c, gb);
    push(out, ')');
    0
}

fn resolve_impl_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 59 {
        *cur = *cur + 1;         // skip a per-method `pub`
        resolve_impl_methods(out, k, s, e, src, cur, c, gb)
    } else {
        rimpl_method(out, k, s, e, src, cur, c, gb);
        resolve_impl_methods(out, k, s, e, src, cur, c, gb)
    }
}

fn resolve_impl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>, impl_id: i64) -> i64 {
    *cur = *cur + 1;             // skip `impl`
    let has_name: bool = (*k)[*cur] != 60;   // a name is present iff next is not `as`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    if has_name {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;             // skip `as`
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // consume trait name
    *cur = *cur + 1;             // skip `for`
    let ty_s: i64 = (*s)[*cur];
    let ty_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // consume type name
    *cur = *cur + 1;             // skip `{`
    let tid: i64 = trait_lookup_slice(c, src, tr_s, tr_e);
    // The target type: a class (checked FIRST, lib.rs:2253) → `class#cid`, else a
    // struct → `struct#sid`. Resolve the tag to one `[u8]` first (a two-borrowing-
    // arm `if` on `out` would trip the A2 borrow quirk).
    let cid: i64 = class_lookup_slice(c, src, ty_s, ty_e);
    let tgtkw: [u8] = if cid >= 0 {
        "class#"
    } else {
        "struct#"
    };
    let tgtid: i64 = if cid >= 0 {
        cid
    } else {
        struct_lookup_slice(c, src, ty_s, ty_e)
    };
    append_str(out, "(impl #");
    append_int(out, impl_id);
    push(out, ' ');
    if has_name {
        append_slice(out, src, nm_s, nm_e);
        0
    } else {
        push(out, '_');
        0
    };
    push(out, ' ');
    push(out, '#');
    append_int(out, tid);
    push(out, ' ');
    append_slice(out, src, tr_s, tr_e);
    push(out, ' ');
    append_str(out, tgtkw);
    append_int(out, tgtid);
    push(out, ' ');
    append_slice(out, src, ty_s, ty_e);
    resolve_impl_methods(out, k, s, e, src, cur, c, gb);
    push(out, ')');
    0
}

// --- class decl head (3b-5): `(class #id Name (field …) (init #selfvid (params)
// <block>)? (method #selfvid …)…)`. The class AST BUCKETS items, so the dump emits
// them GROUPED (fields, then init, then methods) — scan once into per-kind
// buffers, then concatenate (mirrors the parser's dump_class_decl). Init + method
// BODIES bind a synthetic/receiver `self` (the init's is sentinel `-1`; a method's
// reuses rimpl_method's `self`-token binding). Delegates are SKIPPED (the resolve
// dump omits them — they synthesise impls separately; ADR 0040 D7 / a (3e)
// follow-up). VarIds flow init-first (the corpus always writes init before
// methods).
fn rclass_field(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    *cur = *cur + 1;             // skip `let`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;             // skip `:`
    let fty: TypeE = parse_type(k, s, e, src, cur);
    *cur = *cur + 1;             // skip `;`
    append_str(buf, " (field ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    dump_type(buf, fty);
    push(buf, ')');
    0
}

fn rclass_init(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    (*c).base = len((*c).scs);   // this init's scope floor
    *cur = *cur + 1;             // skip `init`
    *cur = *cur + 1;             // skip `(`
    // The init's `self` is SYNTHETIC (no receiver token) → bind the literal name.
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    bind_name(c, "self", selfvid);
    append_str(buf, " (init #");
    append_int(buf, selfvid);
    append_str(buf, " (");
    emit_params(buf, k, s, e, src, cur, c, true);
    append_str(buf, ") ");
    let ibody: Expr = parse_block(k, s, e, src, cur);
    dump_rexpr(buf, ibody, src, c, gb);
    push(buf, ')');
    0
}

// A `delegate field : type to Trait ;` becomes (1) a class FIELD `(field field
// type)` (emitted into the delegate-field bucket, AFTER the explicit fields) and
// (2) a recorded delegate (owning ClassId + the field + trait name slices) that
// drives the synthesised forwarding `impl` (ADR 0040 A12). Mirrors the Rust
// resolver's delegate→field + delegate-impl synthesis.
fn rclass_delegate(dfbuf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, cid: i64) -> i64 {
    *cur = *cur + 1;             // skip `delegate`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // past field name
    *cur = *cur + 1;             // skip `:`
    let dty: TypeE = parse_type(k, s, e, src, cur);
    *cur = *cur + 1;             // skip `to`
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // past trait name
    *cur = *cur + 1;             // skip `;`
    append_str(dfbuf, " (field ");
    append_slice(dfbuf, src, fn_s, fn_e);
    push(dfbuf, ' ');
    dump_type(dfbuf, dty);
    push(dfbuf, ')');
    push(&mut (*c).dgcid, cid);
    push(&mut (*c).dgfs, fn_s);
    push(&mut (*c).dgfe, fn_e);
    push(&mut (*c).dgts, tr_s);
    push(&mut (*c).dgte, tr_e);
    0
}

fn dump_rclass_items(fbuf: &mut Vec<u8>, dfbuf: &mut Vec<u8>, ibuf: &mut Vec<u8>, mbuf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;         // skip a per-item `pub`
        0
    } else {
        0
    };
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 45 {
        rclass_field(fbuf, k, s, e, src, cur);
        dump_rclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else if t == 3 {
        rimpl_method(mbuf, k, s, e, src, cur, c, gb);
        dump_rclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else if is_init_slice(src, (*s)[*cur], (*e)[*cur]) {
        rclass_init(ibuf, k, s, e, src, cur, c, gb);
        dump_rclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else {
        rclass_delegate(dfbuf, k, s, e, src, cur, c, cid);
        dump_rclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    }
}

fn resolve_class(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    *cur = *cur + 1;             // skip `class`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;             // skip `{`
    let mut fbuf: Vec<u8> = vec_new();
    let mut dfbuf: Vec<u8> = vec_new();
    let mut ibuf: Vec<u8> = vec_new();
    let mut mbuf: Vec<u8> = vec_new();
    dump_rclass_items(&mut fbuf, &mut dfbuf, &mut ibuf, &mut mbuf, k, s, e, src, cur, c, gb, cid);
    append_str(out, "(class #");
    append_int(out, cid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    append_str(out, vec_to_array(fbuf));
    append_str(out, vec_to_array(dfbuf));
    append_str(out, vec_to_array(ibuf));
    append_str(out, vec_to_array(mbuf));
    push(out, ')');
    0
}

// --- delegate-impl synthesis (ADR 0040 A12) ---------------------------------
// A `class C { delegate f: T to Tr; }` makes the Rust resolver SYNTHESISE a
// forwarding `impl _ as Tr for C` whose every method (taken from Tr's sig) is
// `fn m(self, p…) { self.f.m(p…) }`. The synthesised impls get ImplIds + VarIds
// AFTER all user impls. Here: re-walk the trait's method sigs and emit each as a
// forwarding `(method #selfvid m <kind> (params) ret (block (method (field
// (var #selfvid) f) m (var #pvid)…)))`.
fn synth_method(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, field_s: i64, field_e: i64) -> i64 {
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // method name
    *cur = *cur + 1;             // skip `(`
    let excl: bool = rparse_self_kind(k, cur);
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(buf, " (method #");
    append_int(buf, selfvid);
    push(buf, ' ');
    append_slice(buf, src, mn_s, mn_e);
    push(buf, ' ');
    append_str(buf, skw);
    append_str(buf, " (");
    let pv0: i64 = (*c).nextvid;
    emit_params(buf, k, s, e, src, cur, c, true);
    let pvn: i64 = (*c).nextvid;
    append_str(buf, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    dump_type(buf, mret);
    // the forwarding body: `(block (method (field (var #selfvid) f) m (var #p)…))`
    append_str(buf, " (block (method (field (var #");
    append_int(buf, selfvid);
    append_str(buf, ") ");
    append_slice(buf, src, field_s, field_e);
    append_str(buf, ") ");
    append_slice(buf, src, mn_s, mn_e);
    let mut pv: i64 = pv0;
    while pv < pvn {
        append_str(buf, " (var #");
        append_int(buf, pv);
        push(buf, ')');
        pv = pv + 1;
    }
    append_str(buf, ")))");
    0
}

fn synth_trait_methods(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, field_s: i64, field_e: i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        0
    } else {
        synth_method(buf, k, s, e, src, cur, c, field_s, field_e);
        *cur = *cur + 1;         // skip `;`
        synth_trait_methods(buf, k, s, e, src, cur, c, field_s, field_e)
    }
}

fn synth_delegate_impl(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], c: &mut RCtx, class_id: i64, field_s: i64, field_e: i64, trait_s: i64, trait_e: i64, impl_id: i64) -> i64 {
    let trait_id: i64 = trait_lookup_slice(c, src, trait_s, trait_e);
    let cn_s: i64 = (*c).cls[class_id];
    let cn_e: i64 = (*c).cle[class_id];
    append_str(buf, "(impl #");
    append_int(buf, impl_id);
    append_str(buf, " _ #");
    append_int(buf, trait_id);
    push(buf, ' ');
    append_slice(buf, src, trait_s, trait_e);
    append_str(buf, " class#");
    append_int(buf, class_id);
    push(buf, ' ');
    append_slice(buf, src, cn_s, cn_e);
    // re-walk the trait body's method sigs (`trait Name { … }` — body `{` at +2).
    let tpos: i64 = (*c).trpos[trait_id];
    let mut tcur: i64 = tpos + 3;
    synth_trait_methods(buf, k, s, e, src, &mut tcur, c, field_s, field_e);
    push(buf, ')');
    0
}

// --- fn header: parse + emit the param list, building the scope -------------
// `[mut] name : type` comma-separated up to `)` (already past the `(`). Each
// param → ` (param #vid [mut] name <type>)` (no leading space before the first)
// + its src-slice name pushed to the scope (varid = scope index). The names live
// in `src`, so nothing is consumed/sunk here.
fn emit_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_params(out, k, s, e, src, cur, c, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pty: TypeE = parse_type(k, s, e, src, cur);
        let vid: i64 = (*c).nextvid;
        (*c).nextvid = (*c).nextvid + 1;
        bind_src(c, src, ns, ne, vid);
        append_str(out, "(param #");
        append_int(out, vid);
        push(out, ' ');
        if pm {
            append_str(out, "mut ");
            0
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        dump_type(out, pty);
        push(out, ')');
        emit_params(out, k, s, e, src, cur, c, false)
    }
}

// PASS-1 effect-op scan (cur_start at the effect body `{`): for each op `name(
// params) [-> ret];`, record `(eid, op-name-slice)` in the flat op list, AND count
// its params into `voff`. The Rust resolver assigns effect op params global VarIds
// during effect-table construction — BEFORE any fn body (lib.rs:2000) — so the
// fn-region VarId counter starts at `voff` (the total effect-op-param count). An op
// name = an ident at paren-depth 0 followed by `(`; a `:` (tag 31) at
// paren-depth ≥1 = one op param.
fn scan_ops_of(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, eid: i64, cur_start: i64, c: &mut RCtx) -> i64 {
    let mut i: i64 = cur_start + 1;
    let mut bdepth: i64 = 1;
    let mut pdepth: i64 = 0;
    while bdepth > 0 {
        let t: i64 = (*k)[i];
        if t == 6 {
            bdepth = bdepth + 1;
            0
        } else if t == 7 {
            bdepth = bdepth - 1;
            0
        } else if t == 4 {
            pdepth = pdepth + 1;
            0
        } else if t == 5 {
            pdepth = pdepth - 1;
            0
        } else if t == 31 {
            // a param annotation `:` → one effect op param → bump the fn-region
            // VarId base `voff` (these consume the FIRST global VarIds; lib.rs:2000)
            (*c).voff = (*c).voff + 1;
            0
        } else if pdepth == 0 {
            // an op name = an ident (tag 2) immediately followed by `(`
            if t == 2 {
                if (*k)[i + 1] == 4 {
                    push(&mut (*c).efoo, eid);
                    push(&mut (*c).efos, (*s)[i]);
                    push(&mut (*c).efoe, (*e)[i]);
                    0
                } else {
                    0
                };
                0
            } else {
                0
            }
        } else {
            0
        };
        i = i + 1;
    }
    0
}

// PASS-1 trait-method scan (cur_start at the trait body `{`): record `(tid,
// method-name-slice)` for each method sig in the flat trait-method list (used for
// `qcall-impl`'s method_index). A trait method sig is `fn name(self…) -> R;` —
// each `fn` (tag 3) in the body → its name is the next token. (Method sigs have no
// bodies, and the `!{eff}` row contains no `fn`, so every `fn` here is a method.)
fn scan_trait_methods(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, tid: i64, cur_start: i64, c: &mut RCtx) -> i64 {
    let mut i: i64 = cur_start + 1;
    let mut bdepth: i64 = 1;
    while bdepth > 0 {
        let t: i64 = (*k)[i];
        if t == 6 {
            bdepth = bdepth + 1;
            0
        } else if t == 7 {
            bdepth = bdepth - 1;
            0
        } else if t == 3 {
            push(&mut (*c).trmo, tid);
            push(&mut (*c).trms, (*s)[i + 1]);
            push(&mut (*c).trme, (*e)[i + 1]);
            0
        } else {
            0
        };
        i = i + 1;
    }
    0
}

// Resolve + dump one top-level `fn` (cur at the `fn` token) as
// `(fn #id name (<params>) <ret> <block>)`, FnId = 21 + fnidx. Builds this fn's
// scope from the params + pre-scanned `let`s, then resolves the body against it.
fn resolve_fn(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>, fnidx: i64) -> i64 {
    *cur = *cur + 1;            // skip `fn`
    let name_s: i64 = (*s)[*cur];
    let name_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    if (*k)[*cur] == 15 {
        skip_type_params(k, cur)
    } else {
        0
    };
    *cur = *cur + 1;           // skip `(`
    (*c).base = len((*c).scs);
    append_str(out, "(fn #");
    append_int(out, 21 + fnidx);
    push(out, ' ');
    append_slice(out, src, name_s, name_e);
    append_str(out, " (");
    emit_params(out, k, s, e, src, cur, c, true);
    append_str(out, ") ");
    *cur = *cur + 1;           // skip `->`
    let rty: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let body: Expr = parse_block(k, s, e, src, cur);
    dump_type(out, rty);
    push(out, ' ');
    dump_rexpr(out, body, src, c, gb);
    push(out, ')');
    0
}

// Dispatch one top-level decl on its leading token (after an optional `pub`),
// mirroring the parser's `dump_item`. A SINGLE helper re-passing the `&mut`
// PARAMS — main has only local `&mut`s (out / cur / ctx), whose sibling-if-tail
// borrows would conflict (ADR 0038 A2). (3b-1) handles struct + fn; the other
// decl kinds land in (3b-2)..(3b-5).
fn resolve_item(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    let lead: i64 = (*k)[*cur];
    if lead == 52 {
        let sid: i64 = (*c).structct;
        resolve_struct(out, k, s, e, src, cur, sid);
        (*c).structct = (*c).structct + 1;
        0
    } else if lead == 53 {
        let eid: i64 = (*c).enumct;
        resolve_enum(out, k, s, e, src, cur, eid);
        (*c).enumct = (*c).enumct + 1;
        0
    } else if lead == 57 {
        let efid: i64 = (*c).effct;
        resolve_effect(out, k, s, e, src, cur, efid);
        (*c).effct = (*c).effct + 1;
        0
    } else if lead == 54 {
        let tid: i64 = (*c).traitct;
        resolve_trait(out, k, s, e, src, cur, tid);
        (*c).traitct = (*c).traitct + 1;
        0
    } else if lead == 55 {
        // impl: method VarIds come from the impl-region counter (load → save).
        let iid: i64 = (*c).implct;
        (*c).nextvid = (*c).implvid;
        resolve_impl(out, k, s, e, src, cur, c, gb, iid);
        (*c).implvid = (*c).nextvid;
        (*c).implct = (*c).implct + 1;
        0
    } else if lead == 56 {
        // class: init/method VarIds come from the class-region counter.
        let cid: i64 = (*c).classct;
        (*c).nextvid = (*c).classvid;
        resolve_class(out, k, s, e, src, cur, c, gb, cid);
        (*c).classvid = (*c).nextvid;
        (*c).classct = (*c).classct + 1;
        0
    } else {
        // fn: VarIds come from the fn-region counter (load → resolve → save).
        let fid: i64 = (*c).fnct;
        (*c).nextvid = (*c).fnvid;
        resolve_fn(out, k, s, e, src, cur, c, gb, fid);
        (*c).fnvid = (*c).nextvid;
        (*c).fnct = (*c).fnct + 1;
        0
    }
}

fn main() -> i64 {
    let path: [u8] = "input.sentinel";
    let src: [u8] = read_file(path);
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);

    let mut ctx: RCtx = RCtx {
        nb: vec_new(),
        scs: vec_new(),
        sce: vec_new(),
        scv: vec_new(),
        base: 0,
        nextvid: 0,
        voff: 0,
        fnvid: 0,
        ufs: vec_new(),
        ufe: vec_new(),
        sts: vec_new(),
        ste: vec_new(),
        ens: vec_new(),
        ene: vec_new(),
        efs: vec_new(),
        efe: vec_new(),
        efoo: vec_new(),
        efos: vec_new(),
        efoe: vec_new(),
        trs: vec_new(),
        tre: vec_new(),
        trpos: vec_new(),
        trmo: vec_new(),
        trms: vec_new(),
        trme: vec_new(),
        dgcid: vec_new(),
        dgfs: vec_new(),
        dgfe: vec_new(),
        dgts: vec_new(),
        dgte: vec_new(),
        imns: vec_new(),
        imne: vec_new(),
        imts: vec_new(),
        imte: vec_new(),
        cls: vec_new(),
        cle: vec_new(),
        classvid: 0,
        implvid: 0,
        fnct: 0,
        structct: 0,
        enumct: 0,
        effct: 0,
        traitct: 0,
        implct: 0,
        classct: 0,
    };

    // Pass 1: top-level decl scan (BRACE-DEPTH aware so method `fn`s inside
    // trait/impl/class bodies are NOT counted as top-level fns). Builds the
    // user-fn table (FnId 14+), the struct table (StructId 0+), and the
    // user-effect count (the `Async` effect's id). At depth 0 the only tokens
    // are decl headers, so a keyword there is always a top-level decl lead.
    // `citem` = the current top-level item kind (set on a depth-0 decl lead), used
    // to attribute body `let`s to fns vs impl/class methods. `fnparams`/`fnlets`
    // accumulate the total fn-region binding count (a `:` at depth 0 is a fn param;
    // a `let` at depth ≥1 under a fn item is a fn let) → the impl-region VarId base.
    let mut depth: i64 = 0;
    let mut ecount: i64 = 0;
    let mut itempos: Vec<i64> = vec_new();
    let mut itemkind: Vec<i64> = vec_new();
    let mut p1: i64 = 0;
    while p1 < ntok {
        let t1: i64 = kinds[p1];
        if t1 == 6 {
            depth = depth + 1;
            0
        } else if t1 == 7 {
            depth = depth - 1;
            0
        } else if depth == 0 {
            if t1 == 3 {
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                push(&mut ctx.ufs, starts[p1 + 1]);
                push(&mut ctx.ufe, ends[p1 + 1]);
                0
            } else if t1 == 52 {
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                push(&mut ctx.sts, starts[p1 + 1]);
                push(&mut ctx.ste, ends[p1 + 1]);
                0
            } else if t1 == 53 {
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                push(&mut ctx.ens, starts[p1 + 1]);
                push(&mut ctx.ene, ends[p1 + 1]);
                0
            } else if t1 == 54 {
                // Register the trait name (TraitId = source order) + scan its
                // method sigs into the flat trait-method list. Body `{` is at p1+2.
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                let tid1: i64 = len(ctx.trs);
                push(&mut ctx.trs, starts[p1 + 1]);
                push(&mut ctx.tre, ends[p1 + 1]);
                push(&mut ctx.trpos, p1);
                scan_trait_methods(&kinds, &starts, &ends, tid1, p1 + 2, &mut ctx);
                0
            } else if t1 == 55 {
                // Register the impl: its name (or a 0,0 never-matched slot for a
                // default `impl as …`) + the impl's trait name slice. The header is
                // `impl [Name as]? Trait for Type {` — Name present iff p1+1 ≠ `as`.
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                if kinds[p1 + 1] != 60 {
                    push(&mut ctx.imns, starts[p1 + 1]);
                    push(&mut ctx.imne, ends[p1 + 1]);
                    push(&mut ctx.imts, starts[p1 + 3]);
                    push(&mut ctx.imte, ends[p1 + 3]);
                    0
                } else {
                    push(&mut ctx.imns, 0);
                    push(&mut ctx.imne, 0);
                    push(&mut ctx.imts, starts[p1 + 2]);
                    push(&mut ctx.imte, ends[p1 + 2]);
                    0
                };
                0
            } else if t1 == 56 {
                // Register the class name (ClassId = source order). Body `{`
                // is at p1+2 (group-order resolution computes the VarId base).
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                push(&mut ctx.cls, starts[p1 + 1]);
                push(&mut ctx.cle, ends[p1 + 1]);
                0
            } else if t1 == 57 {
                // Register the effect name (EffectId = ecount, source order) + scan
                // its ops (records the op list AND counts the op params into voff —
                // see scan_ops_of). The body `{` is at p1+2 (effects non-generic).
                push(&mut itempos, p1);
                push(&mut itemkind, t1);
                push(&mut ctx.efs, starts[p1 + 1]);
                push(&mut ctx.efe, ends[p1 + 1]);
                scan_ops_of(&kinds, &starts, &ends, ecount, p1 + 2, &mut ctx);
                ecount = ecount + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        p1 = p1 + 1;
    }

    // Pass 2 — GROUP-ORDER resolution. The Rust resolver resolves EVERY fn body,
    // then class methods, then impl methods (lib.rs:2559); the dump is source
    // order. So resolve in three groups (their VarId regions chain — each region's
    // base is the prior region's FINAL counter, so no binding count is precomputed)
    // but BUFFER each item's dump tagged with its source index, then emit in source
    // order. `itembuf` holds all dumps; `rsrc`/`rbs`/`rbe` record each resolved
    // item's (source index, blob start, blob end). The fn region starts at `voff`
    // (after the effect op params).
    ctx.fnvid = ctx.voff;
    let mut garbage: Vec<u8> = vec_new();
    let mut itembuf: Vec<u8> = vec_new();
    let mut rsrc: Vec<i64> = vec_new();
    let mut rbs: Vec<i64> = vec_new();
    let mut rbe: Vec<i64> = vec_new();
    let nitems: i64 = len(itemkind);

    // Group A: structs/enums/effects/traits + FNS (everything except class/impl),
    // in source order. Fns advance `fnvid`; the no-VarId decls don't touch it.
    let mut ia: i64 = 0;
    while ia < nitems {
        let ka: i64 = itemkind[ia];
        if ka == 56 {
            0
        } else if ka == 55 {
            0
        } else {
            let mut cura: i64 = itempos[ia];
            let bsa: i64 = len(itembuf);
            resolve_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut cura, &mut ctx, &mut garbage);
            push(&mut rsrc, ia);
            push(&mut rbs, bsa);
            push(&mut rbe, len(itembuf));
            0
        };
        ia = ia + 1;
    }
    // The class region begins where the fn region ended.
    ctx.classvid = ctx.fnvid;

    // Group B: classes, in source order. Advance `classvid`.
    let mut ib: i64 = 0;
    while ib < nitems {
        if itemkind[ib] == 56 {
            let mut curb: i64 = itempos[ib];
            let bsb: i64 = len(itembuf);
            resolve_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut curb, &mut ctx, &mut garbage);
            push(&mut rsrc, ib);
            push(&mut rbs, bsb);
            push(&mut rbe, len(itembuf));
            0
        } else {
            0
        };
        ib = ib + 1;
    }
    // The impl region begins where the class region ended.
    ctx.implvid = ctx.classvid;

    // Group C: impls, in source order. Advance `implvid`.
    let mut ic: i64 = 0;
    while ic < nitems {
        if itemkind[ic] == 55 {
            let mut curc: i64 = itempos[ic];
            let bsc: i64 = len(itembuf);
            resolve_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut curc, &mut ctx, &mut garbage);
            push(&mut rsrc, ic);
            push(&mut rbs, bsc);
            push(&mut rbe, len(itembuf));
            0
        } else {
            0
        };
        ic = ic + 1;
    }

    // Group D: SYNTHESISE delegate impls (ADR 0040 A12) — ImplIds + VarIds continue
    // AFTER all user impls (still the impl region). Each synth impl is recorded at
    // its owning class's source index, so it emits right after the class.
    let nuser: i64 = len(ctx.imns);
    let ndel: i64 = len(ctx.dgcid);
    let mut idd: i64 = 0;
    while idd < ndel {
        let dcid: i64 = ctx.dgcid[idd];
        let dfs: i64 = ctx.dgfs[idd];
        let dfe: i64 = ctx.dgfe[idd];
        let dts: i64 = ctx.dgts[idd];
        let dte: i64 = ctx.dgte[idd];
        // The owning class's source index = the (dcid)-th class item.
        let mut csrc: i64 = 0 - 1;
        let mut seen: i64 = 0;
        let mut q: i64 = 0;
        while q < nitems {
            if csrc == 0 - 1 {
                if itemkind[q] == 56 {
                    if seen == dcid {
                        csrc = q;
                        0
                    } else {
                        0
                    };
                    seen = seen + 1;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            q = q + 1;
        }
        let bsd: i64 = len(itembuf);
        synth_delegate_impl(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, dcid, dfs, dfe, dts, dte, nuser + idd);
        push(&mut rsrc, csrc);
        push(&mut rbs, bsd);
        push(&mut rbe, len(itembuf));
        idd = idd + 1;
    }

    // EMIT in source order: for each source index, splice ALL its records (a class
    // with a delegate has its class record + a synthesised-impl record at the same
    // index — class first, since it was recorded earlier).
    let mut out: Vec<u8> = vec_new();
    let nrec: i64 = len(rsrc);
    let mut si: i64 = 0;
    let mut firstitem: bool = true;
    while si < nitems {
        let mut j: i64 = 0;
        while j < nrec {
            if rsrc[j] == si {
                if firstitem {
                    0
                } else {
                    push(&mut out, '\n');
                    0
                };
                firstitem = false;
                let mut bi: i64 = rbs[j];
                let bend: i64 = rbe[j];
                while bi < bend {
                    push(&mut out, itembuf[bi]);
                    bi = bi + 1;
                }
                0
            } else {
                0
            };
            j = j + 1;
        }
        si = si + 1;
    }

    // The built-in `Async` effect (id = the user-effect count) dumps LAST.
    push(&mut out, '\n');
    append_str(&mut out, "(effect #");
    append_int(&mut out, ecount);
    append_str(&mut out, " Async)");
    push(&mut out, '\n');

    let arr: [u8] = vec_to_array(out);
    print_bytes(arr);
    // Reclaim the buffers (free the resolved-away [u8] names) as a final act.
    let _it: [u8] = vec_to_array(itembuf);
    let _g: [u8] = vec_to_array(garbage);
    0
}
