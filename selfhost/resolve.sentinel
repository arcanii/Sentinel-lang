// Phase D self-host port (3/N) / ADR 0040: the resolve-stage-in-Sentinel.
// Reads `input.sentinel`, reuses the parser (a D.6 module — `use parser::…`) to
// build the AST, then NAME-RESOLVES it (every identifier → an integer ID) and
// prints the SAME canonical resolved dump as the Rust `snc resolve` oracle
// (ADR 0040 D2): the `snc ast` S-expr extended with the resolved IDs, e.g.
//   (struct #0 Point (field x i64) (field y i64))
//   (fn #14 main () i64 (block (let #0 _ (struct-lit #0 Point (field x (int 1)) (field y (int 2)))) (int 0)))
//   (effect #0 Async)
//
// SLICE STATUS (ADR 0040 D8):
//  * (3a) m-1+m-2: paramful fns + every expression form + `let`. DONE.
//  * (3b-1): top-level decl dispatch + the struct table + struct-lit `#id`.
//  * (3b-2): the enum table + `(enum #id Name (variant …))` heads + the
//    `Enum::Variant` / `Enum::init` → `(enum-construct #E …)` split (the enum
//    table is checked FIRST in both the `Qcall` and `ClassInit` arms).
//  * (3b-3): the effect table + `(effect #id Name (op name (params) ret)…)` heads
//    + `perform` → `(perform #E op_index Eff op args)`. ⚠ effect op params consume
//    GLOBAL VarIds in the Rust resolver (before any fn body) → reproduced as
//    PHANTOM scope slots (scan_ops_of) so every fn's VarIds are offset correctly.
//    The remaining decl/`::`-path forms (class/trait/impl + the qcall-impl /
//    class-init split) keep their compile-safe, leak-free pass-through arms until
//    slices (3b-4)–(3b-5).
//
// PROVEN SENTINEL IDIOMS (ADR 0040 A1/A4 probes; reused):
//  * Symbol tables + the local scope are FLAT parallel `Vec<i64>` arrays keyed
//    by SRC SLICES (start,end into `src`) — NOT cons-lists (you can't `match` a
//    `&enum`; a `&`-ref enum match aliases the heap → double-free on reuse).
//  * THE TABLES ARE BUNDLED IN A `RCtx` STRUCT threaded as `&mut RCtx` (A4
//    probe). Field access through the ref is ALWAYS `(*c).field` (bare `c.field`
//    is rejected through a ref); a read-only helper STILL takes `&mut RCtx`
//    (there is NO `&mut`→`&` auto-reborrow). `push(&mut (*c).f, x)` / `len((*c).f)`
//    / `(*c).f[i]` all work; cross-field read+write in one statement is allowed.
//    NEVER move a `Vec` field out of the struct (`vec_to_array((*c).f)` then a
//    struct drop SIGTRAPs) — the name `garbage` sink therefore stays a STANDALONE
//    `&mut Vec<u8>` param `gb`, reclaimed by `main`'s `vec_to_array`.
//  * varids are GLOBAL + sequential = push order, so a binding's varid is just
//    its index in the scope arrays (no separate id array needed). `base` (the
//    current fn's scope floor) lives in `RCtx`, set once per fn.
//  * An owned `[u8]` (the parser's `Var`/`Call` NAME payloads) is freed ONLY by
//    routing its bytes into a `Vec` reclaimed via `vec_to_array` — so each
//    resolved-away name is `sink_name`'d into `gb`, which `main` reclaims last.
//  * Pass 1 is a BRACE-DEPTH scan (depth 0 = top level) so method `fn`s inside
//    trait/impl/class bodies are NOT mistaken for top-level fns.

use parser::Expr;
use parser::Args;
use parser::Stmts;
use parser::Stmt;
use parser::Arms;
use parser::Pattern;
use parser::Binds;
use parser::Fields;
use parser::HArms;
use parser::Ret;
use parser::TyOpt;
use parser::TypeE;
use parser::tokenize;
use parser::parse_type;
use parser::parse_block;
use parser::skip_type_params;
use parser::skip_effect_row;
use parser::dump_type;
use parser::append_str;
use parser::append_int;
use parser::append_slice;

// The resolve context: every symbol table + the local scope, as flat parallel
// `Vec<i64>` arrays keyed by `src` slices, plus the per-kind decl ID counters and
// the current fn's scope floor. Threaded as `&mut RCtx`. (The name `garbage` sink
// is a SEPARATE `gb` param — a `Vec` field cannot be moved out of a struct.)
struct RCtx {
    scs: Vec<i64>,   // scope: binding name-slice starts (varid = index)
    sce: Vec<i64>,   // scope: binding name-slice ends
    base: i64,       // the current fn's scope floor (sc_lookup stops here)
    ufs: Vec<i64>,   // user-fn table: name-slice starts (FnId = 14 + index)
    ufe: Vec<i64>,   // user-fn table: name-slice ends
    sts: Vec<i64>,   // struct table: name-slice starts (StructId = index)
    ste: Vec<i64>,   // struct table: name-slice ends
    ens: Vec<i64>,   // enum table: name-slice starts (EnumId = index)
    ene: Vec<i64>,   // enum table: name-slice ends
    efs: Vec<i64>,   // effect table: name-slice starts (EffectId = index)
    efe: Vec<i64>,   // effect table: name-slice ends
    efoo: Vec<i64>,  // effect-op list: owner EffectId (one entry per op)
    efos: Vec<i64>,  // effect-op list: op name-slice starts
    efoe: Vec<i64>,  // effect-op list: op name-slice ends
    fnct: i64,       // next user-fn index (pass-2 source-order counter)
    structct: i64,   // next struct index (pass-2 source-order counter)
    enumct: i64,     // next enum index (pass-2 source-order counter)
    effct: i64,      // next effect index (pass-2 source-order counter)
}

// --- name comparison --------------------------------------------------------

// Compare `src[st..en]` to the owned query name `q` (a borrowed `&[u8]`).
fn name_eq_src(src: &[u8], st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*src)[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare the owned query name `q` (borrowed) to a string literal `lit`.
fn name_eq_lit(q: &[u8], lit: [u8]) -> bool {
    let qn: i64 = len(*q);
    let ln: i64 = len(lit);
    if qn != ln {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < ln {
            if (*q)[i] != lit[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// The 14 runtime builtins → their reserved FnIds (0..=13), or -1 if `q` is not a
// builtin. Same order as sentinel-resolve's pre-registration (ADR 0035 D2).
fn builtin_id(q: &[u8]) -> i64 {
    if name_eq_lit(q, "print") {
        0
    } else if name_eq_lit(q, "unwrap_or") {
        1
    } else if name_eq_lit(q, "is_some") {
        2
    } else if name_eq_lit(q, "len") {
        3
    } else if name_eq_lit(q, "str_eq") {
        4
    } else if name_eq_lit(q, "u8_to_i64") {
        5
    } else if name_eq_lit(q, "i64_to_u8") {
        6
    } else if name_eq_lit(q, "vec_new") {
        7
    } else if name_eq_lit(q, "push") {
        8
    } else if name_eq_lit(q, "pop") {
        9
    } else if name_eq_lit(q, "vec_to_array") {
        10
    } else if name_eq_lit(q, "read_file") {
        11
    } else if name_eq_lit(q, "write_file") {
        12
    } else if name_eq_lit(q, "print_bytes") {
        13
    } else {
        0 - 1
    }
}

// Resolve a call name to a FnId: a builtin (0..=13), else a user fn (14 + its
// index in the user-fn table), else -1.
fn fn_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let b: i64 = builtin_id(q);
    if b >= 0 {
        b
    } else {
        let n: i64 = len((*c).ufs);
        let mut i: i64 = 0;
        let mut found: i64 = 0 - 1;
        while i < n {
            if found == 0 - 1 {
                if name_eq_src(src, (*c).ufs[i], (*c).ufe[i], q) {
                    found = 14 + i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        found
    }
}

// Resolve a variable name to its VarId — newest-first (high→low) over this fn's
// scope range `[base, top)`; the varid is the binding's scope index. -1 if absent.
fn sc_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let top: i64 = len((*c).scs);
    let mut i: i64 = top - 1;
    let mut found: i64 = 0 - 1;
    while i >= (*c).base {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).scs[i], (*c).sce[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// Resolve a struct name to its StructId (its index in the struct table), or -1.
fn struct_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).sts);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).sts[i], (*c).ste[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve an enum name to its EnumId (its index in the enum table), or -1.
fn enum_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).ens);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).ens[i], (*c).ene[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve an effect name to its EffectId (its index in the effect table), or -1.
fn effect_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).efs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).efs[i], (*c).efe[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// op_index = the position of op `q` among effect `eid`'s ops (a linear scan of
// the flat op list, counting only entries owned by `eid`, in source order). -1 if
// absent. Mirrors lib.rs:4258 (the effect_decl.ops `.position(…)`).
fn op_index_lookup(c: &mut RCtx, src: &[u8], eid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).efoo);
    let mut i: i64 = 0;
    let mut pos: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).efoo[i] == eid {
                if name_eq_src(src, (*c).efos[i], (*c).efoe[i], q) {
                    found = pos;
                    0
                } else {
                    0
                };
                pos = pos + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Route a discarded owned name's bytes into `gb` so the `[u8]` is freed when
// `main` reclaims `gb` (vec_to_array) — the leak-free disposal.
fn sink_name(gb: &mut Vec<u8>, name: [u8]) -> i64 {
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(gb, name[i]);
        i = i + 1;
    }
    0
}

// --- resolved dump (1-phase consuming map: Expr → resolved S-expr) -----------

fn dump_rargs(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(hd, tl) => {
            push(out, ' ');
            dump_rexpr(out, hd, src, c, gb);
            dump_rargs(out, tl, src, c, gb);
            0
        },
    }
}

// A binding payload that is dropped (handler/match bindings) — sink its bytes.
fn sink_binds(gb: &mut Vec<u8>, b: Binds) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            sink_name(gb, nm);
            sink_binds(gb, rest);
            0
        },
    }
}

fn sink_pat(gb: &mut Vec<u8>, p: Pattern) -> i64 {
    match p {
        Pattern::PatWild => 0,
        Pattern::PatVariant(en, vn, bs) => {
            sink_name(gb, en);
            sink_name(gb, vn);
            sink_binds(gb, bs);
            0
        },
    }
}

fn dump_rexpr(out: &mut Vec<u8>, ex: Expr, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match ex {
        Expr::Int(nv) => {
            append_str(out, "(int ");
            append_int(out, nv);
            push(out, ')');
            0
        },
        Expr::Bool(bv) => {
            let blit: [u8] = if bv {
                "(bool true)"
            } else {
                "(bool false)"
            };
            append_str(out, blit);
            0
        },
        Expr::Null => {
            append_str(out, "(null)");
            0
        },
        Expr::Char(cv) => {
            append_str(out, "(char ");
            append_int(out, cv);
            push(out, ')');
            0
        },
        Expr::Str(sb) => {
            append_str(out, "(str");
            let sn: i64 = len(sb);
            let mut si: i64 = 0;
            while si < sn {
                push(out, ' ');
                append_int(out, u8_to_i64(sb[si]));
                si = si + 1;
            }
            push(out, ')');
            sink_name(gb, sb);
            0
        },
        Expr::Var(nm) => {
            let vid: i64 = sc_lookup(c, src, &nm);
            sink_name(gb, nm);
            append_str(out, "(var #");
            append_int(out, vid);
            push(out, ')');
            0
        },
        Expr::Unary(uop, inner) => {
            append_str(out, "(unary ");
            let usym: [u8] = if uop == 1 {
                "-"
            } else if uop == 2 {
                "!"
            } else if uop == 3 {
                "*"
            } else if uop == 4 {
                "&"
            } else {
                "&mut"
            };
            append_str(out, usym);
            push(out, ' ');
            dump_rexpr(out, inner, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Binary(bop, l, r) => {
            push(out, '(');
            let pfx: [u8] = if bop <= 7 {
                "binop"
            } else if bop <= 13 {
                "cmp"
            } else {
                "logic"
            };
            append_str(out, pfx);
            push(out, ' ');
            let bsym: [u8] = if bop == 1 {
                "+"
            } else if bop == 2 {
                "-"
            } else if bop == 3 {
                "*"
            } else if bop == 4 {
                "/"
            } else if bop == 5 {
                "&"
            } else if bop == 6 {
                "|"
            } else if bop == 7 {
                "^"
            } else if bop == 8 {
                "=="
            } else if bop == 9 {
                "!="
            } else if bop == 10 {
                "<"
            } else if bop == 11 {
                "<="
            } else if bop == 12 {
                ">"
            } else if bop == 13 {
                ">="
            } else if bop == 14 {
                "&&"
            } else {
                "||"
            };
            append_str(out, bsym);
            push(out, ' ');
            dump_rexpr(out, l, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, r, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Call(cn, ca) => {
            let fid: i64 = fn_lookup(c, src, &cn);
            sink_name(gb, cn);
            append_str(out, "(call #");
            append_int(out, fid);
            dump_rargs(out, ca, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Method(mt, mn, ma) => {
            append_str(out, "(method ");
            dump_rexpr(out, mt, src, c, gb);
            push(out, ' ');
            append_str(out, mn);
            dump_rargs(out, ma, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Field(ft, fdn) => {
            append_str(out, "(field ");
            dump_rexpr(out, ft, src, c, gb);
            push(out, ' ');
            append_str(out, fdn);
            push(out, ')');
            0
        },
        Expr::Index(it, ii) => {
            append_str(out, "(index ");
            dump_rexpr(out, it, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, ii, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Qcall(qi, qm, qa) => {
            // `Name::method(args)` / paren-less `Name::Variant`. Resolve splits on
            // the leading name: an enum (checked FIRST, mirror lib.rs:3830) →
            // `(enum-construct #E Enum Variant args)`; else the `(qcall …)`
            // placeholder until (3b-4) makes it `(qcall-impl …)`.
            let qeid: i64 = enum_lookup(c, src, &qi);
            if qeid >= 0 {
                append_str(out, "(enum-construct #");
                append_int(out, qeid);
                push(out, ' ');
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                dump_rargs(out, qa, src, c, gb);
                push(out, ')');
                0
            } else {
                append_str(out, "(qcall ");
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                dump_rargs(out, qa, src, c, gb);
                push(out, ')');
                0
            }
        },
        Expr::ClassInit(ci, cia) => {
            // `Name::init(args)`. An enum named `Name` (checked FIRST, mirror
            // lib.rs:3768) → `(enum-construct #E Name init args)` (unreachable on
            // clean fixtures — the parser rejects an `init` enum variant — but
            // faithful); else the `(class-init …)` placeholder until (3b-5).
            let ceid: i64 = enum_lookup(c, src, &ci);
            if ceid >= 0 {
                append_str(out, "(enum-construct #");
                append_int(out, ceid);
                push(out, ' ');
                append_str(out, ci);
                append_str(out, " init");
                dump_rargs(out, cia, src, c, gb);
                push(out, ')');
                0
            } else {
                append_str(out, "(class-init ");
                append_str(out, ci);
                dump_rargs(out, cia, src, c, gb);
                push(out, ')');
                0
            }
        },
        Expr::Array(ae) => {
            append_str(out, "(array");
            dump_rargs(out, ae, src, c, gb);
            push(out, ')');
            0
        },
        Expr::If(ic, it2, ie2) => {
            append_str(out, "(if ");
            dump_rexpr(out, ic, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, it2, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, ie2, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Block(bstmts, btail) => {
            append_str(out, "(block");
            dump_rstmts(out, bstmts, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, btail, src, c, gb);
            push(out, ')');
            0
        },
        Expr::SynthZero => {
            append_str(out, "(int 0)");
            0
        },
        Expr::Match(mscr, marms) => {
            append_str(out, "(match ");
            dump_rexpr(out, mscr, src, c, gb);
            dump_rarms(out, marms, src, c, gb);
            push(out, ')');
            0
        },
        Expr::StructLit(sn, sf) => {
            let sid: i64 = struct_lookup(c, src, &sn);
            append_str(out, "(struct-lit #");
            append_int(out, sid);
            push(out, ' ');
            append_str(out, sn);
            dump_rfields(out, sf, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Declassify(di) => {
            append_str(out, "(declassify ");
            dump_rexpr(out, di, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Perform(pe, po, pa) => {
            // `perform Eff.op(args)` → `(perform #E op_index Eff op args)` (mirror
            // resolve_perform_expr, lib.rs:4250). op_index = the op's position in
            // the effect's op list.
            let peid: i64 = effect_lookup(c, src, &pe);
            let poidx: i64 = op_index_lookup(c, src, peid, &po);
            append_str(out, "(perform #");
            append_int(out, peid);
            push(out, ' ');
            append_int(out, poidx);
            push(out, ' ');
            append_str(out, pe);
            push(out, ' ');
            append_str(out, po);
            dump_rargs(out, pa, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Scope(sb) => {
            append_str(out, "(scope ");
            dump_rexpr(out, sb, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Spawn(sc) => {
            append_str(out, "(spawn ");
            dump_rexpr(out, sc, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Await(aw) => {
            append_str(out, "(await ");
            dump_rexpr(out, aw, src, c, gb);
            push(out, ')');
            0
        },
        Expr::Handle(hb, ha, hr) => {
            append_str(out, "(handle ");
            dump_rexpr(out, hb, src, c, gb);
            dump_rharms(out, ha, src, c, gb);
            dump_rret(out, hr, src, c, gb);
            push(out, ')');
            0
        },
    }
}

fn dump_rstmts(out: &mut Vec<u8>, st: Stmts, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(one, rest) => {
            push(out, ' ');
            dump_rstmt(out, one, src, c, gb);
            dump_rstmts(out, rest, src, c, gb);
            0
        },
    }
}

fn dump_rstmt(out: &mut Vec<u8>, s: Stmt, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            // The let's binding is already in the (pre-scanned) scope; its varid
            // is the unique name's scope index. The value resolves in the same
            // scope (a self-/forward-reference is a resolve error → never a clean
            // seed). Format: `(let #vid [mut] <ty-or-_> <value>)`.
            let lvid: i64 = sc_lookup(c, src, &lnm);
            sink_name(gb, lnm);
            append_str(out, "(let #");
            append_int(out, lvid);
            push(out, ' ');
            if lmf {
                append_str(out, "mut ");
                0
            } else {
                0
            };
            dump_rtyopt(out, lty);
            push(out, ' ');
            dump_rexpr(out, lval, src, c, gb);
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            dump_rexpr(out, atgt, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, aval, src, c, gb);
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            dump_rexpr(out, wcond, src, c, gb);
            push(out, ' ');
            dump_rexpr(out, wbody, src, c, gb);
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            dump_rexpr(out, sx, src, c, gb);
            push(out, ')');
            0
        },
    }
}

// Consuming dump of an optional `let` type annotation: the type, or `_`.
fn dump_rtyopt(out: &mut Vec<u8>, ty: TyOpt) -> i64 {
    match ty {
        TyOpt::NoTy => {
            push(out, '_');
            0
        },
        TyOpt::SomeTy(t) => {
            dump_type(out, t);
            0
        },
    }
}

// match arms (3c — placeholder): resolve the body, sink the pattern bindings.
fn dump_rarms(out: &mut Vec<u8>, a: Arms, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Arms::ArmEnd => 0,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            sink_pat(gb, ap);
            dump_rexpr(out, abody, src, c, gb);
            push(out, ')');
            dump_rarms(out, arest, src, c, gb);
            0
        },
    }
}

fn dump_rfields(out: &mut Vec<u8>, f: Fields, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fv, fr) => {
            append_str(out, " (field ");
            append_str(out, fnm);
            push(out, ' ');
            dump_rexpr(out, fv, src, c, gb);
            push(out, ')');
            dump_rfields(out, fr, src, c, gb);
            0
        },
    }
}

fn dump_rharms(out: &mut Vec<u8>, a: HArms, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hbody, hrest) => {
            append_str(out, " (arm ");
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            push(out, ' ');
            dump_rexpr(out, hbody, src, c, gb);
            push(out, ')');
            dump_rharms(out, hrest, src, c, gb);
            0
        },
    }
}

fn dump_rret(out: &mut Vec<u8>, r: Ret, src: &[u8], c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody) => {
            append_str(out, " (return ");
            sink_name(gb, rnm);
            dump_rexpr(out, rbody, src, c, gb);
            push(out, ')');
            0
        },
    }
}

// --- struct decl head (3b-1): `(struct #id Name (field name <type>)…)` --------
// Pure syntax (field types need no resolution); mirrors the parser's
// dump_struct_fields but prefixed with the resolved StructId.
fn dump_rstruct_fields(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_rstruct_fields(out, k, s, e, src, cur)
    } else {
        let fnm_s: i64 = (*s)[*cur];
        let fnm_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let fty: TypeE = parse_type(k, s, e, src, cur);
        append_str(out, " (field ");
        append_slice(out, src, fnm_s, fnm_e);
        push(out, ' ');
        dump_type(out, fty);
        push(out, ')');
        dump_rstruct_fields(out, k, s, e, src, cur)
    }
}

fn resolve_struct(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, sid: i64) -> i64 {
    *cur = *cur + 1;             // skip `struct`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    if (*k)[*cur] == 15 {
        skip_type_params(k, cur)
    } else {
        0
    };
    *cur = *cur + 1;            // skip `{`
    append_str(out, "(struct #");
    append_int(out, sid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_rstruct_fields(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- enum decl head (3b-2): `(enum #id Name (variant V <payloads>)…)` ---------
// Pure syntax (payload types need no resolution); mirrors the parser's
// dump_enum_decl / dump_variants / dump_payloads, prefixed with the EnumId.
fn dump_renum_payloads(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_renum_payloads(out, k, s, e, src, cur)
    } else {
        let pty: TypeE = parse_type(k, s, e, src, cur);
        push(out, ' ');
        dump_type(out, pty);
        dump_renum_payloads(out, k, s, e, src, cur)
    }
}

fn dump_renum_variants(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        dump_renum_variants(out, k, s, e, src, cur)
    } else {
        let vn_s: i64 = (*s)[*cur];
        let vn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        append_str(out, " (variant ");
        append_slice(out, src, vn_s, vn_e);
        if (*k)[*cur] == 4 {
            *cur = *cur + 1;
            dump_renum_payloads(out, k, s, e, src, cur);
            0
        } else {
            0
        };
        push(out, ')');
        dump_renum_variants(out, k, s, e, src, cur)
    }
}

fn resolve_enum(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64) -> i64 {
    *cur = *cur + 1;            // skip `enum`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;           // skip `{` (enums are non-generic)
    append_str(out, "(enum #");
    append_int(out, eid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_renum_variants(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- effect decl head (3b-3): `(effect #id Name (op name (params) ret)…)` ------
// Pure syntax — effect op params dump WITHOUT VarIds (`(param [mut] name <type>)`,
// like trait params; resolve_dump.rs:500). The op params DO consume global
// VarIds in the Rust resolver (lib.rs:2000) → reproduced as phantom scope slots
// (see scan_ops_of). Mirrors the parser's dump_effect_decl / dump_ops; an op's
// missing return type dumps `_`.
fn emit_op_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_op_params(out, k, s, e, src, cur, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pty: TypeE = parse_type(k, s, e, src, cur);
        append_str(out, "(param ");
        if pm {
            append_str(out, "mut ");
            0
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        dump_type(out, pty);
        push(out, ')');
        emit_op_params(out, k, s, e, src, cur, false)
    }
}

fn dump_reffect_ops(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        dump_reffect_ops(out, k, s, e, src, cur)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;           // skip `(`
        append_str(out, " (op ");
        append_slice(out, src, on_s, on_e);
        append_str(out, " (");
        emit_op_params(out, k, s, e, src, cur, true);
        append_str(out, ") ");
        if (*k)[*cur] == 8 {
            *cur = *cur + 1;
            let rt: TypeE = parse_type(k, s, e, src, cur);
            dump_type(out, rt);
            0
        } else {
            push(out, '_');
            0
        };
        push(out, ')');
        dump_reffect_ops(out, k, s, e, src, cur)
    }
}

fn resolve_effect(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64) -> i64 {
    *cur = *cur + 1;            // skip `effect`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    *cur = *cur + 1;           // skip `{`
    append_str(out, "(effect #");
    append_int(out, eid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    dump_reffect_ops(out, k, s, e, src, cur);
    push(out, ')');
    0
}

// --- fn header: parse + emit the param list, building the scope -------------
// `[mut] name : type` comma-separated up to `)` (already past the `(`). Each
// param → ` (param #vid [mut] name <type>)` (no leading space before the first)
// + its src-slice name pushed to the scope (varid = scope index). The names live
// in `src`, so nothing is consumed/sunk here.
fn emit_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_params(out, k, s, e, src, cur, c, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pty: TypeE = parse_type(k, s, e, src, cur);
        let vid: i64 = len((*c).scs);
        push(&mut (*c).scs, ns);
        push(&mut (*c).sce, ne);
        append_str(out, "(param #");
        append_int(out, vid);
        push(out, ' ');
        if pm {
            append_str(out, "mut ");
            0
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        dump_type(out, pty);
        push(out, ')');
        emit_params(out, k, s, e, src, cur, c, false)
    }
}

// MILESTONE-2: pre-scan a fn body's tokens (cur_start at the body `{`) for its
// `let` bindings, pushing each name's src slice to the scope IN SOURCE ORDER
// (after the params) — so the body can then be resolved with the scope IMMUTABLE
// (a `let` binds during the walk, but pre-scanning makes the whole binding set
// present up front). Brace-balanced to the matching `}`; the flat per-fn
// namespace means nested-block `let`s share the fn scope. `let`s resolve their
// own varid by name lookup (redeclaration is rejected by resolve, so unique).
fn scan_lets(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, cur_start: i64, c: &mut RCtx) -> i64 {
    let mut i: i64 = cur_start + 1;
    let mut depth: i64 = 1;
    while depth > 0 {
        let t: i64 = (*k)[i];
        if t == 6 {
            depth = depth + 1;
            0
        } else if t == 7 {
            depth = depth - 1;
            0
        } else if t == 45 {
            let mut ni: i64 = i + 1;
            if (*k)[ni] == 46 {
                ni = ni + 1;
                0
            } else {
                0
            };
            push(&mut (*c).scs, (*s)[ni]);
            push(&mut (*c).sce, (*e)[ni]);
            0
        } else {
            0
        };
        i = i + 1;
    }
    0
}

// PASS-1 effect-op scan (cur_start at the effect body `{`): for each op `name(
// params) [-> ret];`, record `(eid, op-name-slice)` in the flat op list, AND push
// one PHANTOM scope slot per op param. The Rust resolver assigns effect op params
// global VarIds during effect-table construction — BEFORE any fn body (lib.rs:2000)
// — so every fn's VarIds are offset by the total effect-op-param count. The
// phantoms (pushed before pass 2) sit below every fn's `base`, so they shift the
// scope indices (= VarIds) without ever being looked up. An op name = an ident at
// paren-depth 0 followed by `(`; a `:` (tag 31) at paren-depth ≥1 = one op param.
fn scan_ops_of(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, eid: i64, cur_start: i64, c: &mut RCtx) -> i64 {
    let mut i: i64 = cur_start + 1;
    let mut bdepth: i64 = 1;
    let mut pdepth: i64 = 0;
    while bdepth > 0 {
        let t: i64 = (*k)[i];
        if t == 6 {
            bdepth = bdepth + 1;
            0
        } else if t == 7 {
            bdepth = bdepth - 1;
            0
        } else if t == 4 {
            pdepth = pdepth + 1;
            0
        } else if t == 5 {
            pdepth = pdepth - 1;
            0
        } else if t == 31 {
            // a param annotation `:` → one effect op param → a phantom VarId slot
            push(&mut (*c).scs, 0);
            push(&mut (*c).sce, 0);
            0
        } else if pdepth == 0 {
            // an op name = an ident (tag 2) immediately followed by `(`
            if t == 2 {
                if (*k)[i + 1] == 4 {
                    push(&mut (*c).efoo, eid);
                    push(&mut (*c).efos, (*s)[i]);
                    push(&mut (*c).efoe, (*e)[i]);
                    0
                } else {
                    0
                };
                0
            } else {
                0
            }
        } else {
            0
        };
        i = i + 1;
    }
    0
}

// Resolve + dump one top-level `fn` (cur at the `fn` token) as
// `(fn #id name (<params>) <ret> <block>)`, FnId = 14 + fnidx. Builds this fn's
// scope from the params + pre-scanned `let`s, then resolves the body against it.
fn resolve_fn(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>, fnidx: i64) -> i64 {
    *cur = *cur + 1;            // skip `fn`
    let name_s: i64 = (*s)[*cur];
    let name_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    if (*k)[*cur] == 15 {
        skip_type_params(k, cur)
    } else {
        0
    };
    *cur = *cur + 1;           // skip `(`
    (*c).base = len((*c).scs);
    append_str(out, "(fn #");
    append_int(out, 14 + fnidx);
    push(out, ' ');
    append_slice(out, src, name_s, name_e);
    append_str(out, " (");
    emit_params(out, k, s, e, src, cur, c, true);
    append_str(out, ") ");
    *cur = *cur + 1;           // skip `->`
    let rty: TypeE = parse_type(k, s, e, src, cur);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    // m-2: pre-scan the body's `let` bindings into the scope (after the params)
    // so the body resolves against the complete, immutable scope.
    scan_lets(k, s, e, *cur, c);
    let body: Expr = parse_block(k, s, e, src, cur);
    dump_type(out, rty);
    push(out, ' ');
    dump_rexpr(out, body, src, c, gb);
    push(out, ')');
    0
}

// Dispatch one top-level decl on its leading token (after an optional `pub`),
// mirroring the parser's `dump_item`. A SINGLE helper re-passing the `&mut`
// PARAMS — main has only local `&mut`s (out / cur / ctx), whose sibling-if-tail
// borrows would conflict (ADR 0038 A2). (3b-1) handles struct + fn; the other
// decl kinds land in (3b-2)..(3b-5).
fn resolve_item(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut RCtx, gb: &mut Vec<u8>) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    let lead: i64 = (*k)[*cur];
    if lead == 52 {
        let sid: i64 = (*c).structct;
        resolve_struct(out, k, s, e, src, cur, sid);
        (*c).structct = (*c).structct + 1;
        0
    } else if lead == 53 {
        let eid: i64 = (*c).enumct;
        resolve_enum(out, k, s, e, src, cur, eid);
        (*c).enumct = (*c).enumct + 1;
        0
    } else if lead == 57 {
        let efid: i64 = (*c).effct;
        resolve_effect(out, k, s, e, src, cur, efid);
        (*c).effct = (*c).effct + 1;
        0
    } else {
        let fid: i64 = (*c).fnct;
        resolve_fn(out, k, s, e, src, cur, c, gb, fid);
        (*c).fnct = (*c).fnct + 1;
        0
    }
}

fn main() -> i64 {
    let path: [u8] = "input.sentinel";
    let src: [u8] = read_file(path);
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);

    let mut ctx: RCtx = RCtx {
        scs: vec_new(),
        sce: vec_new(),
        base: 0,
        ufs: vec_new(),
        ufe: vec_new(),
        sts: vec_new(),
        ste: vec_new(),
        ens: vec_new(),
        ene: vec_new(),
        efs: vec_new(),
        efe: vec_new(),
        efoo: vec_new(),
        efos: vec_new(),
        efoe: vec_new(),
        fnct: 0,
        structct: 0,
        enumct: 0,
        effct: 0,
    };

    // Pass 1: top-level decl scan (BRACE-DEPTH aware so method `fn`s inside
    // trait/impl/class bodies are NOT counted as top-level fns). Builds the
    // user-fn table (FnId 14+), the struct table (StructId 0+), and the
    // user-effect count (the `Async` effect's id). At depth 0 the only tokens
    // are decl headers, so a keyword there is always a top-level decl lead.
    let mut depth: i64 = 0;
    let mut ecount: i64 = 0;
    let mut p1: i64 = 0;
    while p1 < ntok {
        let t1: i64 = kinds[p1];
        if t1 == 6 {
            depth = depth + 1;
            0
        } else if t1 == 7 {
            depth = depth - 1;
            0
        } else if depth == 0 {
            if t1 == 3 {
                push(&mut ctx.ufs, starts[p1 + 1]);
                push(&mut ctx.ufe, ends[p1 + 1]);
                0
            } else if t1 == 52 {
                push(&mut ctx.sts, starts[p1 + 1]);
                push(&mut ctx.ste, ends[p1 + 1]);
                0
            } else if t1 == 53 {
                push(&mut ctx.ens, starts[p1 + 1]);
                push(&mut ctx.ene, ends[p1 + 1]);
                0
            } else if t1 == 57 {
                // Register the effect name (EffectId = ecount, source order) +
                // scan its ops (records the op list AND pushes phantom scope slots
                // for the op params — see scan_ops_of). The body `{` is at p1+2
                // (`effect Name {` — effects are non-generic).
                push(&mut ctx.efs, starts[p1 + 1]);
                push(&mut ctx.efe, ends[p1 + 1]);
                scan_ops_of(&kinds, &starts, &ends, ecount, p1 + 2, &mut ctx);
                ecount = ecount + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        p1 = p1 + 1;
    }

    // The name garbage sink (a STANDALONE Vec — a struct field can't be moved
    // out for vec_to_array) + the output buffer.
    let mut garbage: Vec<u8> = vec_new();
    let mut out: Vec<u8> = vec_new();

    // Pass 2: resolve + dump each top-level item in source order.
    let mut cur: i64 = 0;
    let mut firstitem: bool = true;
    while cur < ntok {
        if firstitem {
            0
        } else {
            push(&mut out, '\n');
            0
        };
        firstitem = false;
        resolve_item(&mut out, &kinds, &starts, &ends, &src, &mut cur, &mut ctx, &mut garbage);
    }

    // The built-in `Async` effect (id = the user-effect count) dumps LAST.
    push(&mut out, '\n');
    append_str(&mut out, "(effect #");
    append_int(&mut out, ecount);
    append_str(&mut out, " Async)");
    push(&mut out, '\n');

    let arr: [u8] = vec_to_array(out);
    print_bytes(arr);
    // Reclaim the name garbage (frees the resolved-away [u8] names) as a final act.
    let _g: [u8] = vec_to_array(garbage);
    0
}
