// Phase D self-host port (3/N) / ADR 0040: the resolve-stage-in-Sentinel.
// Reads `input.sentinel`, reuses the parser (a D.6 module — `use parser::…`) to
// build the AST, then NAME-RESOLVES it (every identifier → an integer ID) and
// prints the SAME canonical resolved dump as the Rust `snc resolve` oracle
// (ADR 0040 D2): the `snc ast` S-expr extended with the resolved IDs, e.g.
//   (struct #0 Point (field x i64) (field y i64))
//   (fn #14 main () i64 (block (let #0 _ (struct-lit #0 Point (field x (int 1)) (field y (int 2)))) (int 0)))
//   (effect #0 Async)
//
// SLICE STATUS (ADR 0040 D8):
//  * (3a) m-1+m-2: paramful fns + every expression form + `let`. DONE.
//  * (3b-1): top-level decl dispatch + the struct table + struct-lit `#id`.
//  * (3b-2): the enum table + `(enum #id Name (variant …))` heads + the
//    `Enum::Variant` / `Enum::init` → `(enum-construct #E …)` split (the enum
//    table is checked FIRST in both the `Qcall` and `ClassInit` arms).
//  * (3b-3): the effect table + `(effect #id Name (op name (params) ret)…)` heads
//    + `perform` → `(perform #E op_index Eff op args)`.
//  * (3b-4): the trait + impl tables + `(trait #id …)` heads (sigs, no bodies) +
//    `(impl #id name #trait_id Trait struct#tid Type (method #selfvid …))` heads
//    (method BODIES with a synthetic `self` VarId) + the `Qcall` else-branch →
//    `(qcall-impl #I method_index ImplName method args)` (method_index = scan the
//    impl's trait's methods). ⚠ VARIDS ARE GROUP-ORDERED: the Rust resolver
//    resolves ALL fn bodies before ANY impl method body, so varid ≠ scope index —
//    the scope stores EXPLICIT varids (`scv`), the fn region counts from `voff`,
//    and the impl region (`implvid`) counts from `voff + total-fn-bindings`.
//  * (3b-5): the class table + `(class #id Name (field …) (init #selfvid (params)
//    <block>)? (method #selfvid …)…)` heads — BUCKETED (fields, then init, then
//    methods; mirror the parser) with init/method BODIES (the init's `self` is a
//    synthetic `-1` sentinel matched by name; methods reuse rimpl_method) — + the
//    `ClassInit` else-branch → `(class-init #C Name args)` + `resume-kont` (a
//    `Call` whose callee is an in-scope var → `(resume-kont #vid …)`, the scope
//    checked BEFORE the fn table). The class group is resolved BEFORE impls, so
//    `classvid` counts from `voff + total-fn-bindings` and `implvid` continues
//    after it. (3b) is COMPLETE — every decl kind + every `::` form.
//  * (3c) match/while: the SCOPED bodies. The scope is a NAME BLOB (`nb`) — body
//    bindings (let/match-payload) come from the AST as owned `[u8]`, pushed into
//    the blob — and bindings are DURING-WALK (a `let`'s value resolves + binds its
//    nested vars BEFORE the let var). `match` arm payloads bind sequential VarIds
//    then **truncate** (D5 length-truncation: pop the scope back to a pre-arm mark
//    — visibility restored, VarIds stay sequential). `while` works via during-walk
//    (no truncation needed — names are unique per fn). `handle` arms +
//    `return v` arm bind VarIds (truncated after) → `(arm #eid op_index Eff op
//    (#vids) body)` / `(return #vid body)` (the parser now STORES handler-arm
//    params as a `Binds`). (3c) closes the full grammar.
//  * (3e) GROUP-ORDER resolution + the corpus phase-go. The Rust resolver resolves
//    EVERY fn body, then class methods, then impl methods (lib.rs:2559) — so the
//    VarId regions chain. Pass 1 only COLLECTS items (token pos + kind); pass 2
//    resolves in THREE groups (fns → `classvid = fnvid`; classes → `implvid =
//    classvid`; impls), BUFFERING each item's dump tagged by its source index, then
//    emits in source order. This computes each region's base from the prior
//    region's FINAL counter — NO binding-count precompute (the old token-counting
//    MISSED match/handler/return fn-region bindings → a wrong class base). Matches
//    `snc resolve` over the whole clean-resolving corpus (the D9 phase-go).
//  * delegate-impl synthesis (A12): a `class C { delegate f: T to Tr; }` → a FIELD
//    `(field f T)` (a delegate-field bucket, after the explicit fields) + a
//    SYNTHESISED forwarding `(impl #id _ #trait_id Tr class#cid C (method #selfvid
//    m … (block (method (field (var #selfvid) f) m (var #pvid)…))))` per trait
//    method (re-walked from the trait's sigs) — ImplIds + VarIds AFTER all user
//    impls, emitted at the class's source index. **The corpus differential now
//    covers the ENTIRE clean-resolving corpus (132 fixtures) — ADR 0040 ACCEPTED.**
//
// PROVEN SENTINEL IDIOMS (ADR 0040 A1/A4 probes; reused):
//  * Symbol tables + the local scope are FLAT parallel `Vec<i64>` arrays keyed
//    by SRC SLICES (start,end into `src`) — NOT cons-lists (you can't `match` a
//    `&enum`; a `&`-ref enum match aliases the heap → double-free on reuse).
//  * THE TABLES ARE BUNDLED IN A `RCtx` STRUCT threaded as `&mut RCtx` (A4
//    probe). Field access through the ref is ALWAYS `(*c).field` (bare `c.field`
//    is rejected through a ref); a read-only helper STILL takes `&mut RCtx`
//    (there is NO `&mut`→`&` auto-reborrow). `push(&mut (*c).f, x)` / `len((*c).f)`
//    / `(*c).f[i]` all work; cross-field read+write in one statement is allowed.
//    NEVER move a `Vec` field out of the struct (`vec_to_array((*c).f)` then a
//    struct drop SIGTRAPs) — the name `garbage` sink therefore stays a STANDALONE
//    `&mut Vec<u8>` param `gb`, reclaimed by `main`'s `vec_to_array`.
//  * varids are GLOBAL + sequential = push order, so a binding's varid is just
//    its index in the scope arrays (no separate id array needed). `base` (the
//    current fn's scope floor) lives in `RCtx`, set once per fn.
//  * An owned `[u8]` (the parser's `Var`/`Call` NAME payloads) is freed ONLY by
//    routing its bytes into a `Vec` reclaimed via `vec_to_array` — so each
//    resolved-away name is `sink_name`'d into `gb`, which `main` reclaims last.
//  * Pass 1 is a BRACE-DEPTH scan (depth 0 = top level) so method `fn`s inside
//    trait/impl/class bodies are NOT mistaken for top-level fns.

module resolve;
part dump;
part decls;

use parser::Expr;
use parser::Args;
use parser::Stmts;
use parser::Stmt;
use parser::Arms;
use parser::Pattern;
use parser::Binds;
use parser::Fields;
use parser::HArms;
use parser::Ret;
use parser::TyOpt;
use parser::TypeE;
use parser::tokenize;
use parser::parse_type;
use parser::parse_block;
use parser::skip_type_params;
use parser::skip_effect_row;
use parser::dump_type;
use parser::append_str;
use parser::append_int;
use parser::append_slice;

// The resolve context: every symbol table + the local scope, as flat parallel
// `Vec<i64>` arrays keyed by `src` slices, plus the per-kind decl ID counters and
// the current fn's scope floor. Threaded as `&mut RCtx`. (The name `garbage` sink
// is a SEPARATE `gb` param — a `Vec` field cannot be moved out of a struct.)
struct RCtx {
    nb: Vec<u8>,     // scope NAME BLOB — every binding's name bytes (params copy
                     //   their src bytes in; body bindings [let/match/handler] push
                     //   their AST `[u8]` bytes in, which also DISPOSES them). The
                     //   blob is reclaimed (vec_to_array) by main. Body bindings
                     //   come from the AST as owned `[u8]`, not token src slices, so
                     //   the scope can't key on `src` indices like the decl tables.
    scs: Vec<i64>,   // scope: binding name-slice starts (offsets into `nb`)
    sce: Vec<i64>,   // scope: binding name-slice ends (offsets into `nb`)
    scv: Vec<i64>,   // scope: binding VarId (EXPLICIT — varid ≠ array index, since
                     //   method-body VarIds are assigned in GROUP order [fns then
                     //   impls] while the scope array is built in source order)
    base: i64,       // the current item's scope floor (an ARRAY index; sc_lookup
                     //   scans [base, top) to isolate this item's bindings)
    nextvid: i64,    // the ACTIVE VarId counter (loaded from fnvid/implvid per item)
    voff: i64,       // effect-op-param count = the fn-region VarId base
    fnvid: i64,      // saved fn-region VarId counter (starts voff)
    ufs: Vec<i64>,   // user-fn table: name-slice starts (FnId = 21 + index)
    ufe: Vec<i64>,   // user-fn table: name-slice ends
    sts: Vec<i64>,   // struct table: name-slice starts (StructId = index)
    ste: Vec<i64>,   // struct table: name-slice ends
    ens: Vec<i64>,   // enum table: name-slice starts (EnumId = index)
    ene: Vec<i64>,   // enum table: name-slice ends
    efs: Vec<i64>,   // effect table: name-slice starts (EffectId = index)
    efe: Vec<i64>,   // effect table: name-slice ends
    efoo: Vec<i64>,  // effect-op list: owner EffectId (one entry per op)
    efos: Vec<i64>,  // effect-op list: op name-slice starts
    efoe: Vec<i64>,  // effect-op list: op name-slice ends
    trs: Vec<i64>,   // trait table: name-slice starts (TraitId = index)
    tre: Vec<i64>,   // trait table: name-slice ends
    trpos: Vec<i64>, // trait table: the trait keyword's token index (for delegate
                     //   synthesis — re-walk the trait's method sigs by TraitId)
    trmo: Vec<i64>,  // trait-method list: owner TraitId (one entry per method)
    trms: Vec<i64>,  // trait-method list: method name-slice starts
    trme: Vec<i64>,  // trait-method list: method name-slice ends
    dgcid: Vec<i64>, // delegate records: owning ClassId (one entry per delegate)
    dgfs: Vec<i64>,  // delegate records: the delegate FIELD name-slice starts
    dgfe: Vec<i64>,  // delegate records: the delegate FIELD name-slice ends
    dgts: Vec<i64>,  // delegate records: the delegated-to TRAIT name-slice starts
    dgte: Vec<i64>,  // delegate records: the delegated-to TRAIT name-slice ends
    imns: Vec<i64>,  // impl table: impl name-slice starts (ImplId = index; a
    imne: Vec<i64>,  //   default/unnamed impl gets a 0,0 slot — never name-matched)
    imts: Vec<i64>,  // impl table: the impl's trait name-slice starts
    imte: Vec<i64>,  // impl table: the impl's trait name-slice ends
    cls: Vec<i64>,   // class table: name-slice starts (ClassId = index)
    cle: Vec<i64>,   // class table: name-slice ends
    classvid: i64,   // saved class-region VarId counter (= fnvid after ALL fns)
    implvid: i64,    // saved impl-region VarId counter (= classvid after ALL classes)
    fnct: i64,       // next user-fn index (pass-2 source-order counter)
    structct: i64,   // next struct index (pass-2 source-order counter)
    enumct: i64,     // next enum index (pass-2 source-order counter)
    effct: i64,      // next effect index (pass-2 source-order counter)
    traitct: i64,    // next trait index (pass-2 source-order counter)
    implct: i64,     // next impl index (pass-2 source-order counter)
    classct: i64,    // next class index (pass-2 source-order counter)
}

// --- name comparison --------------------------------------------------------

// Compare `src[st..en]` to the owned query name `q` (a borrowed `&[u8]`).
fn name_eq_src(src: &[u8], st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*src)[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare the owned query name `q` (borrowed) to a string literal `lit`.
fn name_eq_lit(q: &[u8], lit: [u8]) -> bool {
    let qn: i64 = len(*q);
    let ln: i64 = len(lit);
    if qn != ln {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < ln {
            if (*q)[i] != lit[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare two `src` slices `src[as_..ae]` and `src[bs..be]` for byte-equality.
fn slice_eq_src(src: &[u8], as_: i64, ae: i64, bs: i64, be: i64) -> bool {
    let la: i64 = ae - as_;
    let lb: i64 = be - bs;
    if la != lb {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < la {
            if (*src)[as_ + i] != (*src)[bs + i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// The 14 runtime builtins → their reserved FnIds (0..=13), or -1 if `q` is not a
// builtin. Same order as sentinel-resolve's pre-registration (ADR 0035 D2).
fn builtin_id(q: &[u8]) -> i64 {
    if name_eq_lit(q, "print") {
        0
    } else if name_eq_lit(q, "unwrap_or") {
        1
    } else if name_eq_lit(q, "is_some") {
        2
    } else if name_eq_lit(q, "len") {
        3
    } else if name_eq_lit(q, "str_eq") {
        4
    } else if name_eq_lit(q, "u8_to_i64") {
        5
    } else if name_eq_lit(q, "i64_to_u8") {
        6
    } else if name_eq_lit(q, "vec_new") {
        7
    } else if name_eq_lit(q, "push") {
        8
    } else if name_eq_lit(q, "pop") {
        9
    } else if name_eq_lit(q, "vec_to_array") {
        10
    } else if name_eq_lit(q, "read_file") {
        11
    } else if name_eq_lit(q, "write_file") {
        12
    } else if name_eq_lit(q, "print_bytes") {
        13
    } else if name_eq_lit(q, "channel_new") {
        21
    } else if name_eq_lit(q, "send") {
        22
    } else if name_eq_lit(q, "recv") {
        23
    } else if name_eq_lit(q, "channel_close") {
        24
    } else if name_eq_lit(q, "process_spawn") {
        25
    } else if name_eq_lit(q, "process_wait") {
        26
    } else if name_eq_lit(q, "process_write") {
        27
    } else if name_eq_lit(q, "process_read") {
        28
    } else if name_eq_lit(q, "process_send") {
        29
    } else if name_eq_lit(q, "process_recv") {
        30
    } else {
        0 - 1
    }
}

// Resolve a call name to a FnId: a builtin (0..=32), else a user fn (33 + its
// index in the user-fn table), else -1.
fn fn_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let b: i64 = builtin_id(q);
    if b >= 0 {
        b
    } else {
        let n: i64 = len((*c).ufs);
        let mut i: i64 = 0;
        let mut found: i64 = 0 - 1;
        while i < n {
            if found == 0 - 1 {
                if name_eq_src(src, (*c).ufs[i], (*c).ufe[i], q) {
                    found = 33 + i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        found
    }
}

// Resolve a variable name to its VarId — newest-first (high→low) over this item's
// scope range `[base, top)` (array indices); returns the binding's STORED VarId
// (`scv`), or -1 if absent.
fn sc_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let top: i64 = len((*c).scs);
    let mut i: i64 = top - 1;
    let mut found: i64 = 0 - 1;
    while i >= (*c).base {
        if found == 0 - 1 {
            if blob_eq(c, (*c).scs[i], (*c).sce[i], q) {
                found = (*c).scv[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// Resolve a struct name to its StructId (its index in the struct table), or -1.
fn struct_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).sts);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).sts[i], (*c).ste[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a struct by a `src` SLICE (an impl's stored target type name) to its
// StructId, or -1 (used for the `impl … for Type` target tag).
fn struct_lookup_slice(c: &mut RCtx, src: &[u8], ts: i64, te: i64) -> i64 {
    let n: i64 = len((*c).sts);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if slice_eq_src(src, (*c).sts[i], (*c).ste[i], ts, te) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a class name to its ClassId (its index in the class table), or -1.
fn class_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).cls);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).cls[i], (*c).cle[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a class by a `src` SLICE (an impl's target type name) to its ClassId,
// or -1. The Rust resolver checks the class table BEFORE the struct table
// (lib.rs:2253), so `impl … for Type` prefers a class target.
fn class_lookup_slice(c: &mut RCtx, src: &[u8], ts: i64, te: i64) -> i64 {
    let n: i64 = len((*c).cls);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if slice_eq_src(src, (*c).cls[i], (*c).cle[i], ts, te) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Is the `src` slice the literal keyword `init`? (Class init constructors lex as a
// plain `init` ident; the dispatch slice-compares it.)
fn is_init_slice(src: &[u8], st: i64, en: i64) -> bool {
    if en - st != 4 {
        false
    } else {
        ((*src)[st] == 'i') && ((*src)[st + 1] == 'n') && ((*src)[st + 2] == 'i') && ((*src)[st + 3] == 't')
    }
}

// Resolve an enum name to its EnumId (its index in the enum table), or -1.
fn enum_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).ens);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).ens[i], (*c).ene[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve an effect name to its EffectId (its index in the effect table), or -1.
fn effect_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).efs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).efs[i], (*c).efe[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// op_index = the position of op `q` among effect `eid`'s ops (a linear scan of
// the flat op list, counting only entries owned by `eid`, in source order). -1 if
// absent. Mirrors lib.rs:4258 (the effect_decl.ops `.position(…)`).
fn op_index_lookup(c: &mut RCtx, src: &[u8], eid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).efoo);
    let mut i: i64 = 0;
    let mut pos: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).efoo[i] == eid {
                if name_eq_src(src, (*c).efos[i], (*c).efoe[i], q) {
                    found = pos;
                    0
                } else {
                    0
                };
                pos = pos + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a trait name to its TraitId (its index in the trait table), or -1.
fn trait_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).trs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).trs[i], (*c).tre[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a trait by a `src` SLICE (an impl's stored trait name) to its TraitId.
fn trait_lookup_slice(c: &mut RCtx, src: &[u8], ts: i64, te: i64) -> i64 {
    let n: i64 = len((*c).trs);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if slice_eq_src(src, (*c).trs[i], (*c).tre[i], ts, te) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Resolve a (named) impl to its ImplId (its index in the impl table), or -1.
fn impl_lookup(c: &mut RCtx, src: &[u8], q: &[u8]) -> i64 {
    let n: i64 = len((*c).imns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if name_eq_src(src, (*c).imns[i], (*c).imne[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// method_index = the position of method `q` among trait `tid`'s methods (a linear
// scan of the flat trait-method list, counting only entries owned by `tid`, in
// source order). -1 if absent. Mirrors lib.rs:3863 (method_names `.position(…)`).
fn method_index_in_trait(c: &mut RCtx, src: &[u8], tid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).trmo);
    let mut i: i64 = 0;
    let mut pos: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).trmo[i] == tid {
                if name_eq_src(src, (*c).trms[i], (*c).trme[i], q) {
                    found = pos;
                    0
                } else {
                    0
                };
                pos = pos + 1;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Consume a method's mandatory `self : & [mut] Self` receiver (cur at `self`) and
// return whether it is exclusive (`&mut Self`). Mirrors the parser's
// parse_self_kind: `self`(ident) `:`(31) `&`(23) `[mut(46)]` `Self`(ident).
fn rparse_self_kind(k: &Vec<i64>, cur: &mut i64) -> bool {
    *cur = *cur + 1;
    *cur = *cur + 1;
    *cur = *cur + 1;
    let excl: bool = (*k)[*cur] == 46;
    if excl {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;
    excl
}

// Route a discarded owned name's bytes into `gb` so the `[u8]` is freed when
// `main` reclaims `gb` (vec_to_array) — the leak-free disposal.
fn sink_name(gb: &mut Vec<u8>, name: [u8]) -> i64 {
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(gb, name[i]);
        i = i + 1;
    }
    0
}

// --- scope binding (the name blob) ------------------------------------------

// Bind a name given as a `src` slice (a param / a `self:` receiver token): copy
// its bytes into the blob, record the binding (blob slice + VarId).
fn bind_src(c: &mut RCtx, src: &[u8], ns: i64, ne: i64, vid: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let mut i: i64 = ns;
    while i < ne {
        push(&mut (*c).nb, (*src)[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + (ne - ns));
    push(&mut (*c).scv, vid);
    0
}

// Bind a name given as an owned `[u8]` (a `let` / match-payload / handler-param /
// `init` self): push its bytes into the blob (which also DISPOSES the `[u8]`),
// record the binding.
fn bind_name(c: &mut RCtx, name: [u8], vid: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(&mut (*c).nb, name[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + n);
    push(&mut (*c).scv, vid);
    0
}

// Compare a blob slice `nb[st..en]` to the query name `q`.
fn blob_eq(c: &mut RCtx, st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*c).nb[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// D5 scope snapshot/restore = length truncation: pop the scope arrays back to
// `mark` (an array length recorded before a scoped region — a match arm, `while`
// body, handler arm, or return arm). The VarId counter (`nextvid`) is NOT reset
// (VarIds stay globally sequential); only VISIBILITY is restored. The blob bytes
// stay (reclaimed by main); only the scope refs are popped.
fn truncate_scope(c: &mut RCtx, mark: i64) -> i64 {
    let mut t: i64 = len((*c).scs);
    while t > mark {
        pop(&mut (*c).scs);
        pop(&mut (*c).sce);
        pop(&mut (*c).scv);
        t = t - 1;
    }
    0
}

