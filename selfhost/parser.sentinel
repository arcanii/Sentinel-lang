// Phase D self-host port (2a) / ADR 0039: the parser-in-Sentinel — minimal
// expression slice. Reads `input.sentinel`, tokenizes it, recursive-descent
// parses each `fn NAME() -> TYPE { <expr> }` into an `Expr` AST, and prints
// the SAME canonical S-expression dump as the Rust `snc ast` oracle
// (ADR 0039 D2), e.g. `(fn main () i64 (block (binop + (int 1) (binop * (int
// 2) (int 3)))))`.
//
// (2a) scope: paramless fns whose body is an integer arithmetic expression
// (`+ - * /` with precedence + parens). Vars, params, statements, calls, and
// the other expr/decl kinds grow in (2b)–(2d). Self-contained (its own
// minimal tokenizer); factoring the full lexer into a shared D.6 module is a
// follow-on.
//
// Sentinel idioms this leans on (ADR 0038 A2 / ADR 0039 A3): a recursive
// `Expr` enum returned BY VALUE + consuming-dumped (no `Vec<Expr>`); shared
// refs indexed via `(*r)[i]` (not `r[i]`) so helpers share the token arrays +
// `src`; a `&mut i64` cursor; left-assoc folds via RECURSION (a param
// accumulator — a loop accumulator would trip the moved-in-loop rule); a flat
// per-fn variable namespace (unique local names); comma-separated `match` arms.
//
// Token tags (internal): 1 Int, 2 Ident, 3 fn, 4 ( 5 ) 6 { 7 } 8 -> 9 + 10 -
// 11 * 12 /.

enum Expr {
    Int(i64),
    Bin(u8, Expr, Expr),
}

fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_ident_start(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn is_ident_cont(c: u8) -> bool {
    is_ident_start(c) || is_digit(c)
}

fn is_fn_kw(src: &[u8], start: i64, end: i64) -> bool {
    end - start == 2 && (*src)[start] == 'f' && (*src)[start + 1] == 'n'
}

// Append the decimal rendering of `x` (>= 0) to `out`.
fn append_int(out: &mut Vec<u8>, x: i64) -> i64 {
    if x == 0 {
        push(out, '0');
        0
    } else {
        let mut digits: Vec<u8> = vec_new();
        let mut v: i64 = x;
        while v > 0 {
            let d: i64 = v - (v / 10) * 10;
            push(&mut digits, i64_to_u8(48 + d));
            v = v / 10;
        }
        let dn: i64 = len(digits);
        let mut i: i64 = dn - 1;
        while i >= 0 {
            push(out, digits[i]);
            i = i - 1;
        }
        0
    }
}

// Append the literal bytes of `s` (moved in + consumed) to `out`.
fn append_str(out: &mut Vec<u8>, s: [u8]) -> i64 {
    let n: i64 = len(s);
    let mut i: i64 = 0;
    while i < n {
        push(out, s[i]);
        i = i + 1;
    }
    0
}

// Append `src[start..end]` (via deref-index) to `out`.
fn append_slice(out: &mut Vec<u8>, src: &[u8], start: i64, end: i64) -> i64 {
    let mut i: i64 = start;
    while i < end {
        push(out, (*src)[i]);
        i = i + 1;
    }
    0
}

// Parse the decimal integer in `src[start..end]`.
fn parse_int(src: &[u8], start: i64, end: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut i: i64 = start;
    while i < end {
        acc = acc * 10 + (u8_to_i64((*src)[i]) - 48);
        i = i + 1;
    }
    acc
}

fn tokenize(src: &[u8], n: i64, kinds: &mut Vec<i64>, starts: &mut Vec<i64>, ends: &mut Vec<i64>) -> i64 {
    let mut pos: i64 = 0;
    while pos < n {
        let b: u8 = (*src)[pos];
        let start: i64 = pos;
        pos = if is_space(b) {
            start + 1
        } else if is_digit(b) {
            let mut de: i64 = start;
            while de < n && is_digit((*src)[de]) {
                de = de + 1;
            }
            push(kinds, 1);
            push(starts, start);
            push(ends, de);
            de
        } else if is_ident_start(b) {
            let mut ie: i64 = start;
            while ie < n && is_ident_cont((*src)[ie]) {
                ie = ie + 1;
            }
            let tag: i64 = if is_fn_kw(src, start, ie) {
                3
            } else {
                2
            };
            push(kinds, tag);
            push(starts, start);
            push(ends, ie);
            ie
        } else {
            let two: bool = b == '-' && start + 1 < n && (*src)[start + 1] == '>';
            let tg: i64 = if b == '+' {
                9
            } else if b == '-' {
                if two { 8 } else { 10 }
            } else if b == '*' {
                11
            } else if b == '/' {
                12
            } else if b == '(' {
                4
            } else if b == ')' {
                5
            } else if b == '{' {
                6
            } else if b == '}' {
                7
            } else {
                0
            };
            let adv: i64 = if two { 2 } else { 1 };
            push(kinds, tg);
            push(starts, start);
            push(ends, start + adv);
            start + adv
        };
    }
    0
}

fn parse_primary(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> Expr {
    let tag: i64 = (*k)[*cur];
    if tag == 1 {
        let st: i64 = (*s)[*cur];
        let en: i64 = (*e)[*cur];
        *cur = *cur + 1;
        Expr::Int(parse_int(src, st, en))
    } else if tag == 4 {
        *cur = *cur + 1;
        let inner: Expr = parse_add(k, s, e, src, cur);
        *cur = *cur + 1;
        inner
    } else {
        *cur = *cur + 1;
        Expr::Int(0)
    }
}

fn parse_mul(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> Expr {
    let left: Expr = parse_primary(k, s, e, src, cur);
    parse_mul_rest(k, s, e, src, cur, left)
}

fn parse_mul_rest(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, acc: Expr) -> Expr {
    let tag: i64 = (*k)[*cur];
    if tag == 11 {
        *cur = *cur + 1;
        let right: Expr = parse_primary(k, s, e, src, cur);
        parse_mul_rest(k, s, e, src, cur, Expr::Bin('*', acc, right))
    } else if tag == 12 {
        *cur = *cur + 1;
        let rd: Expr = parse_primary(k, s, e, src, cur);
        parse_mul_rest(k, s, e, src, cur, Expr::Bin('/', acc, rd))
    } else {
        acc
    }
}

fn parse_add(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> Expr {
    let left: Expr = parse_mul(k, s, e, src, cur);
    parse_add_rest(k, s, e, src, cur, left)
}

fn parse_add_rest(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, acc: Expr) -> Expr {
    let tag: i64 = (*k)[*cur];
    if tag == 9 {
        *cur = *cur + 1;
        let right: Expr = parse_mul(k, s, e, src, cur);
        parse_add_rest(k, s, e, src, cur, Expr::Bin('+', acc, right))
    } else if tag == 10 {
        *cur = *cur + 1;
        let rs: Expr = parse_mul(k, s, e, src, cur);
        parse_add_rest(k, s, e, src, cur, Expr::Bin('-', acc, rs))
    } else {
        acc
    }
}

// Consuming recursive dump matching `snc ast`.
fn dump_expr(out: &mut Vec<u8>, ex: Expr) -> i64 {
    match ex {
        Expr::Int(nv) => {
            append_str(out, "(int ");
            append_int(out, nv);
            push(out, ')');
            0
        },
        Expr::Bin(op, l, r) => {
            append_str(out, "(binop ");
            push(out, op);
            push(out, ' ');
            dump_expr(out, l);
            push(out, ' ');
            dump_expr(out, r);
            push(out, ')');
            0
        },
    }
}

fn main() -> i64 {
    let path: [u8] = "input.sentinel";
    let src: [u8] = read_file(path);
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);
    let mut out: Vec<u8> = vec_new();
    let mut cur: i64 = 0;
    let mut firstfn: bool = true;
    while cur < ntok {
        if firstfn {
            0
        } else {
            push(&mut out, '\n');
            0
        };
        firstfn = false;
        // fn header: `fn` NAME `(` `)` `->` TYPE `{`
        cur = cur + 1;
        let name_s: i64 = starts[cur];
        let name_e: i64 = ends[cur];
        cur = cur + 1;
        cur = cur + 1;
        cur = cur + 1;
        cur = cur + 1;
        let ret_s: i64 = starts[cur];
        let ret_e: i64 = ends[cur];
        cur = cur + 1;
        cur = cur + 1;
        let body: Expr = parse_add(&kinds, &starts, &ends, &src, &mut cur);
        cur = cur + 1;
        append_str(&mut out, "(fn ");
        append_slice(&mut out, &src, name_s, name_e);
        append_str(&mut out, " () ");
        append_slice(&mut out, &src, ret_s, ret_e);
        append_str(&mut out, " (block ");
        dump_expr(&mut out, body);
        append_str(&mut out, "))");
    }
    push(&mut out, '\n');
    let arr: [u8] = vec_to_array(out);
    print_bytes(arr);
    0
}
