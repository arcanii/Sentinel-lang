// A `TypeE` (surface type AST) -> a type handle (interning compounds). Consumes
// the `TypeE` (disposing any owned name `[u8]` into `gb`). At m-1 only scalars are
// validated; a non-scalar `TIdent` (a struct/enum/class name) defaults to i64
// (the decl tables land at 4c).
fn type_of_typeexpr(c: &mut TyCtx, t: TypeE, gb: &mut Vec<u8>) -> i64 {
    match t {
        TypeE::TIdent(nm) => {
            // (4h) an in-scope type-param shadows everything else → `<T#idx>`.
            let tpidx: i64 = tp_lookup(c, &nm);
            // (4i) `String` is a built-in alias for `Vec<u8>` (ADR 0034 — the oracle
            // desugars it, rendering `Vec<u8>`); a type-param named `String` shadows it.
            let is_string: bool = if tpidx >= 0 {
                false
            } else {
                name_eq_lit(&nm, "String")
            };
            let sc: i64 = if tpidx >= 0 {
                0 - 1
            } else if is_string {
                0 - 1
            } else {
                scalar_code(&nm)
            };
            let sid: i64 = if tpidx >= 0 {
                0 - 1
            } else if sc >= 0 {
                0 - 1
            } else {
                struct_lookup(c, &nm)
            };
            let eid: i64 = if tpidx >= 0 {
                0 - 1
            } else if sc >= 0 {
                0 - 1
            } else if sid >= 0 {
                0 - 1
            } else {
                enum_lookup(c, &nm)
            };
            let cid: i64 = if tpidx >= 0 {
                0 - 1
            } else if sc >= 0 {
                0 - 1
            } else if sid >= 0 {
                0 - 1
            } else if eid >= 0 {
                0 - 1
            } else {
                class_lookup(c, &nm)
            };
            sink_name(gb, nm);
            if tpidx >= 0 {
                mk_tparam(c, tpidx)
            } else if is_string {
                mk_vec(c, 3)
            } else if sc >= 0 {
                sc
            } else if sid >= 0 {
                mk_struct(c, sid)
            } else if eid >= 0 {
                mk_enum(c, eid)
            } else if cid >= 0 {
                mk_class(c, cid)
            } else {
                0
            }
        },
        TypeE::TNullable(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_nullable(c, ih)
        },
        TypeE::TArray(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_array(c, ih)
        },
        TypeE::TRef(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_ref(c, 0, ih)
        },
        TypeE::TRefMut(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_ref(c, 1, ih)
        },
        TypeE::TSecret(inner) => {
            let ih: i64 = type_of_typeexpr(c, inner, gb);
            mk_secret(c, ih)
        },
        TypeE::TGeneric(gn, ga) => {
            // (4i) `Vec<T>` → the kind-11 Vec type (D.3 collections). (4h) else
            // `Name<args>` for a user struct → a GenericInstance (resolving each arg,
            // which may itself be a type-param). Any other generic (no such type)
            // keeps the placeholder (dispose + i64) — it only occurs in rejected fixtures.
            let is_vec: bool = name_eq_lit(&gn, "Vec");
            let gsid: i64 = if is_vec {
                0 - 1
            } else {
                struct_lookup(c, &gn)
            };
            sink_name(gb, gn);
            if is_vec {
                let mut vav: Vec<i64> = vec_new();
                collect_tyargs(c, ga, gb, &mut vav);
                let velem: i64 = if len(vav) > 0 {
                    vav[0]
                } else {
                    0
                };
                mk_vec(c, velem)
            } else if gsid >= 0 {
                let mut gav: Vec<i64> = vec_new();
                collect_tyargs(c, ga, gb, &mut gav);
                mk_generic(c, gsid, &gav)
            } else {
                dispose_tyargs(c, ga, gb);
                0
            }
        },
    }
}

// (4h) Resolve a `TyArgs` cons-list into a flat `Vec<i64>` of type handles (each arg
// may be a type-param, scalar, struct, or nested generic).
fn collect_tyargs(c: &mut TyCtx, a: TyArgs, gb: &mut Vec<u8>, av: &mut Vec<i64>) -> i64 {
    match a {
        TyArgs::TAEnd => 0,
        TyArgs::TACell(t, rest) => {
            let h: i64 = type_of_typeexpr(c, t, gb);
            push(av, h);
            collect_tyargs(c, rest, gb, av)
        },
    }
}

// Consume a `TyArgs` cons-list (disposing its `TypeE`s) — the non-struct-generic
// placeholder (e.g. `Vec<T>` annotations, still typed as i64).
fn dispose_tyargs(c: &mut TyCtx, a: TyArgs, gb: &mut Vec<u8>) -> i64 {
    match a {
        TyArgs::TAEnd => 0,
        TyArgs::TACell(t, rest) => {
            type_of_typeexpr(c, t, gb);
            dispose_tyargs(c, rest, gb)
        },
    }
}

// --- the builtin / user-fn return-type tables -------------------------------

// The 14 runtime builtins -> FnId (0..=13), or -1.
fn builtin_id(q: &[u8]) -> i64 {
    if name_eq_lit(q, "print") {
        0
    } else if name_eq_lit(q, "unwrap_or") {
        1
    } else if name_eq_lit(q, "is_some") {
        2
    } else if name_eq_lit(q, "len") {
        3
    } else if name_eq_lit(q, "str_eq") {
        4
    } else if name_eq_lit(q, "u8_to_i64") {
        5
    } else if name_eq_lit(q, "i64_to_u8") {
        6
    } else if name_eq_lit(q, "vec_new") {
        7
    } else if name_eq_lit(q, "push") {
        8
    } else if name_eq_lit(q, "pop") {
        9
    } else if name_eq_lit(q, "vec_to_array") {
        10
    } else if name_eq_lit(q, "read_file") {
        11
    } else if name_eq_lit(q, "write_file") {
        12
    } else if name_eq_lit(q, "print_bytes") {
        13
    } else {
        0 - 1
    }
}

// A builtin FnId -> its return-type handle (the scalar-returning ones; the
// generic/array ones land at 4c/4h, defaulting to i64 for m-1).
fn builtin_ret(c: &mut TyCtx, fid: i64) -> i64 {
    if fid == 2 {
        2
    } else if fid == 3 {
        0
    } else if fid == 4 {
        2
    } else if fid == 5 {
        0
    } else if fid == 6 {
        3
    } else if fid == 11 {
        mk_array(c, 3)
    } else {
        0
    }
}

// Resolve a call name to a FnId: a builtin (0..=13), else a user fn (14 + idx),
// else -1.
fn fn_lookup(c: &mut TyCtx, src: &[u8], q: &[u8]) -> i64 {
    let b: i64 = builtin_id(q);
    if b >= 0 {
        b
    } else {
        let n: i64 = len((*c).ufs);
        let mut i: i64 = 0;
        let mut found: i64 = 0 - 1;
        while i < n {
            if found == 0 - 1 {
                if name_eq_src(src, (*c).ufs[i], (*c).ufe[i], q) {
                    found = 14 + i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        found
    }
}

// The return-type handle for a resolved FnId.
fn fn_ret(c: &mut TyCtx, fid: i64) -> i64 {
    if fid < 14 {
        builtin_ret(c, fid)
    } else {
        (*c).ufret[fid - 14]
    }
}

// --- scope + env ------------------------------------------------------------

// Resolve a variable name to its VarId — newest-first over `[base, top)`; -1 if
// absent.
fn sc_lookup(c: &mut TyCtx, q: &[u8]) -> i64 {
    let top: i64 = len((*c).scs);
    let mut i: i64 = top - 1;
    let mut found: i64 = 0 - 1;
    while i >= (*c).base {
        if found == 0 - 1 {
            if blob_eq(c, (*c).scs[i], (*c).sce[i], q) {
                found = (*c).scv[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// Read a VarId's type from the append-only env (vid == push order).
fn env_get(c: &mut TyCtx, vid: i64) -> i64 {
    (*c).env[vid]
}

// Bind a name given as a `src` slice (a param): copy its bytes into the blob,
// record the scope entry (slice + VarId) AND push its type into the env. Called
// in VarId order, so the push lands at index `vid`.
fn bind_src(c: &mut TyCtx, src: &[u8], ns: i64, ne: i64, vid: i64, ty: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let mut i: i64 = ns;
    while i < ne {
        push(&mut (*c).nb, (*src)[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + (ne - ns));
    push(&mut (*c).scv, vid);
    push(&mut (*c).env, ty);
    0
}

// Bind a name given as an owned `[u8]` (a `let`): push its bytes into the blob
// (which also DISPOSES the `[u8]`), record the scope entry + env type.
fn bind_name(c: &mut TyCtx, name: [u8], vid: i64, ty: i64) -> i64 {
    let st: i64 = len((*c).nb);
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(&mut (*c).nb, name[i]);
        i = i + 1;
    }
    push(&mut (*c).scs, st);
    push(&mut (*c).sce, st + n);
    push(&mut (*c).scv, vid);
    push(&mut (*c).env, ty);
    0
}

// --- the typed dump (1-phase consuming map: Expr -> typed S-expr) ------------
//
// Each `dump_t*` for an expression RETURNS the node's inferred type handle and
// appends ` :<type>` before its closing paren (`close_ty`), so a parent can use a
// child's type. (Resolve's `dump_r*` returned nothing — types threads the type
// up.)

// Close a typed expression node: ` :<type>)`.
fn close_ty(out: &mut Vec<u8>, ty: i64, c: &mut TyCtx) -> i64 {
    append_str(out, " :");
    render_type(out, ty, c);
    push(out, ')');
    0
}

// (6/N) dump an arg list in a CONSUMING context (constructor / method / perform /
// enum-construct args — moved into the callee). Sets `consuming` true around the args.
fn dump_cargs(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let svc: bool = (*c).consuming;
    (*c).consuming = true;
    dump_targs(out, a, src, c, gb);
    (*c).consuming = svc;
    0
}

fn dump_targs(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(x, rest) => {
            push(out, ' ');
            // (6/N) args INHERIT the caller's consuming context (the call arm sets it —
            // user-fn/construct args consume, builtin args do not).
            dump_texpr(out, x, 0 - 1, src, c, gb);
            dump_targs(out, rest, src, c, gb)
        },
    }
}

// (4c-2) array-literal elements: dump every element; RETURN the first element's
// type (the inferred array element type). Empty → i64 default (a context-typed
// follow-up). The first is dumped here; the rest reuse `dump_targs`.
fn dump_array_elems(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(x, rest) => {
            push(out, ' ');
            // (6/N) the array arm sets consuming=true before this; elements inherit it.
            let t0: i64 = dump_texpr(out, x, 0 - 1, src, c, gb);
            dump_targs(out, rest, src, c, gb);
            t0
        },
    }
}

// --- (4h) generic-fn inference (unify_one + substitution) -------------------

// Substitute the type-params in `h` using the resolved type-arg list `args`
// (indexed by type-param index). Recurses through compound shells; leaves
// concrete types (scalars, structs, enums, classes) unchanged. (Generic-instance
// substitution — kind 10 — lands with (4h-2)'s `mk_generic`.)
fn subst_type(c: &mut TyCtx, h: i64, args: &Vec<i64>) -> i64 {
    if h < tbase() {
        h
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 9 {
            let pi: i64 = (*c).ta[idx];
            (*args)[pi]
        } else if k == 1 {
            let inn: i64 = (*c).ta[idx];
            let si: i64 = subst_type(c, inn, args);
            mk_array(c, si)
        } else if k == 4 {
            let inn4: i64 = (*c).ta[idx];
            let s4: i64 = subst_type(c, inn4, args);
            mk_nullable(c, s4)
        } else if k == 3 {
            let inn3: i64 = (*c).ta[idx];
            let s3: i64 = subst_type(c, inn3, args);
            mk_secret(c, s3)
        } else if k == 2 {
            let m2: i64 = (*c).ta[idx];
            let inn2: i64 = (*c).tb[idx];
            let s2: i64 = subst_type(c, inn2, args);
            mk_ref(c, m2, s2)
        } else if k == 10 {
            // A generic instance whose own args may be type-params (e.g. make_pair's
            // return `Pair<<T#0>, <T#1>>` substituted to `Pair<i64, i64>`): substitute
            // each arg, then re-intern. The arg slice [grs..gre] is stable under the
            // recursive `mk_generic` appends (gia is append-only).
            let gdecl: i64 = (*c).ta[idx];
            let grec: i64 = (*c).tb[idx];
            let grs: i64 = (*c).girs[grec];
            let gre: i64 = (*c).gire[grec];
            let mut gnewargs: Vec<i64> = vec_new();
            let mut ggi: i64 = grs;
            while ggi < gre {
                let goa: i64 = (*c).gia[ggi];
                let gsa: i64 = subst_type(c, goa, args);
                push(&mut gnewargs, gsa);
                ggi = ggi + 1;
            }
            mk_generic(c, gdecl, &gnewargs)
        } else {
            h
        }
    }
}

// Record a type-param binding (param index `pidx` → arg type `at`) into the
// parallel (`bi`, `bt`) accumulator lists; FIRST binding wins (clean fixtures are
// consistent, so a re-encounter of the same param need not re-check).
fn subst_bind(bi: &mut Vec<i64>, bt: &mut Vec<i64>, pidx: i64, at: i64) -> i64 {
    let n: i64 = len(*bi);
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        if (*bi)[i] == pidx {
            found = true;
            0
        } else {
            0
        };
        i = i + 1;
    }
    if found {
        0
    } else {
        push(bi, pidx);
        push(bt, at);
        0
    }
}

// The bound type for param index `pidx` (-1 if unbound — defensive).
fn subst_get(bi: &mut Vec<i64>, bt: &mut Vec<i64>, pidx: i64) -> i64 {
    let n: i64 = len(*bi);
    let mut i: i64 = 0;
    let mut r: i64 = 0 - 1;
    while i < n {
        if r == 0 - 1 {
            if (*bi)[i] == pidx {
                r = (*bt)[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    r
}

// Unify a (possibly type-param-bearing) declared param type `pt` against a
// concrete arg type `at`, recording type-param bindings. Structural: matches the
// array/nullable/secret shells and recurses; a bare type-param binds. (Ref +
// generic-instance unify land with (4h-2).)
fn unify_one(c: &mut TyCtx, pt: i64, at: i64, bi: &mut Vec<i64>, bt: &mut Vec<i64>) -> i64 {
    if pt < tbase() {
        0
    } else {
        let idx: i64 = pt - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 9 {
            let pidx: i64 = (*c).ta[idx];
            subst_bind(bi, bt, pidx, at)
        } else if k == 1 {
            let pin: i64 = (*c).ta[idx];
            let ain: i64 = array_elem_of(c, at);
            unify_one(c, pin, ain, bi, bt)
        } else if k == 4 {
            let pin4: i64 = (*c).ta[idx];
            let ain4: i64 = nullable_inner_of(c, at);
            unify_one(c, pin4, ain4, bi, bt)
        } else if k == 3 {
            let pin3: i64 = (*c).ta[idx];
            let ain3: i64 = strip_secret(c, at);
            unify_one(c, pin3, ain3, bi, bt)
        } else if k == 10 {
            // A generic-instance param (e.g. `p: Pair<A, B>`) unifies pairwise against
            // a same-decl arg instance (`Pair<i64, i64>`), binding each type-param.
            let ptd: i64 = (*c).ta[idx];
            let atd: i64 = gi_decl_of(c, at);
            if atd == ptd {
                let prec: i64 = (*c).tb[idx];
                let prs: i64 = (*c).girs[prec];
                let pre: i64 = (*c).gire[prec];
                let ats: i64 = gi_argstart(c, at);
                let ucount: i64 = pre - prs;
                let mut ugi: i64 = 0;
                while ugi < ucount {
                    let upa: i64 = (*c).gia[prs + ugi];
                    let uaa: i64 = (*c).gia[ats + ugi];
                    unify_one(c, upa, uaa, bi, bt);
                    ugi = ugi + 1;
                }
                0
            } else {
                0
            }
        } else {
            0
        }
    }
}

// Dump every call arg into `out`, pushing each arg's synthesized type onto `atys`
// (so a generic call can unify the fn's params against them).
fn dump_args_capture_all(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, atys: &mut Vec<i64>) -> i64 {
    match a {
        Args::End => 0,
        Args::Cell(x, rest) => {
            push(out, ' ');
            // (6/N) generic-call args inherit the caller's consuming context (set true
            // by the user-fn call arm).
            let t0: i64 = dump_texpr(out, x, 0 - 1, src, c, gb);
            push(atys, t0);
            dump_args_capture_all(out, rest, src, c, gb, atys)
        },
    }
}

// (4h) a call to a generic USER fn: infer the type-args by unifying the fn's
// declared param types against the args' synthesized types, emit `(targs t0 t1 …)`
// (space-separated) BEFORE the args, and return the SUBSTITUTED declared return
// type. Args are dumped to a temp buffer first — the targs precede them in the
// output but are inferred from them.
fn dump_generic_call(out: &mut Vec<u8>, fid: i64, ca: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut abuf: Vec<u8> = vec_new();
    let mut atys: Vec<i64> = vec_new();
    dump_args_capture_all(&mut abuf, ca, src, c, gb, &mut atys);
    let ntp: i64 = (*c).uftp[fid - 14];
    let ps: i64 = (*c).ufps[fid - 14];
    let pe: i64 = (*c).ufpe[fid - 14];
    let np: i64 = pe - ps;
    let na: i64 = len(atys);
    let lim: i64 = if np < na {
        np
    } else {
        na
    };
    let mut bi: Vec<i64> = vec_new();
    let mut bt: Vec<i64> = vec_new();
    let mut pi: i64 = 0;
    while pi < lim {
        let pty: i64 = (*c).ufpp[ps + pi];
        let aty: i64 = atys[pi];
        unify_one(c, pty, aty, &mut bi, &mut bt);
        pi = pi + 1;
    }
    // Build the resolved subst list in type-param INDEX order (0..ntp).
    let mut subst: Vec<i64> = vec_new();
    let mut ti: i64 = 0;
    while ti < ntp {
        let bd: i64 = subst_get(&mut bi, &mut bt, ti);
        push(&mut subst, bd);
        ti = ti + 1;
    }
    append_str(out, " (targs");
    let mut tj: i64 = 0;
    while tj < ntp {
        push(out, ' ');
        let th: i64 = subst[tj];
        render_type(out, th, c);
        tj = tj + 1;
    }
    push(out, ')');
    let argbytes: [u8] = vec_to_array(abuf);
    append_str(out, argbytes);
    let rh: i64 = (*c).ufret[fid - 14];
    subst_type(c, rh, &subst)
}

// The element type of an array type handle (kind 1), or i64 default.
fn array_elem_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        // (4i) the element of a `[T]` (kind 1) OR a `Vec<T>` (kind 11) — so `len`
        // and `v[i]` index work uniformly over arrays and vecs.
        if (*c).tk[idx] == 1 {
            (*c).ta[idx]
        } else if (*c).tk[idx] == 11 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// (4i) the element type of a `Vec<T>` handle (kind 11), or i64 default.
fn vec_elem_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 11 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// (4i) the result type of a `Task<T>` handle (kind 12), or i64 default — the type
// `t.await` yields.
fn task_elem_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 12 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// The inner type of a nullable handle (kind 4), or i64 default.
fn nullable_inner_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 4 {
            (*c).ta[idx]
        } else {
            0
        }
    }
}

// Generic builtins that emit `(targs T)`: unwrap_or (#1), is_some (#2), len (#3),
// (4i) the D.3 Vec ops vec_new (#7), push (#8), pop (#9), vec_to_array (#10).
fn is_generic_builtin(fid: i64) -> bool {
    fid == 1 || fid == 2 || fid == 3 || fid == 7 || fid == 8 || fid == 9 || fid == 10
}

// The inferred type-arg T for a generic builtin. `firstty` = the first arg's type
// (-1 if none); `exp` = the call's expected type (for vec_new, which has no args).
fn targ_of_builtin(c: &mut TyCtx, fid: i64, firstty: i64, exp: i64) -> i64 {
    if fid == 3 {
        array_elem_of(c, firstty)            // len: [T]/Vec<T> element
    } else if fid == 1 {
        nullable_inner_of(c, firstty)        // unwrap_or: ?T inner
    } else if fid == 2 {
        nullable_inner_of(c, firstty)        // is_some: ?T inner
    } else if fid == 7 {
        vec_elem_of(c, exp)                  // vec_new: T from the expected Vec<T>
    } else if fid == 8 {
        let sr8: i64 = strip_ref(c, firstty);   // push: &mut Vec<T> → T
        vec_elem_of(c, sr8)
    } else if fid == 9 {
        let sr9: i64 = strip_ref(c, firstty);   // pop: &mut Vec<T> → T
        vec_elem_of(c, sr9)
    } else if fid == 10 {
        vec_elem_of(c, firstty)              // vec_to_array: Vec<T> → T
    } else {
        0
    }
}

// Dump a generic-builtin call's `(targs T)` + args. Args go to a temp buffer
// first (T is inferred from the first arg — or from `exp` for vec_new — but
// `(targs T)` precedes the args in the output). Returns the call's result type.
fn dump_gcall(out: &mut Vec<u8>, fid: i64, ca: Args, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut abuf: Vec<u8> = vec_new();
    let firstty: i64 = dump_args_capture_first(&mut abuf, ca, src, c, gb);
    let targ: i64 = targ_of_builtin(c, fid, firstty, exp);
    append_str(out, " (targs ");
    render_type(out, targ, c);
    push(out, ')');
    append_str(out, vec_to_array(abuf));
    // result type: unwrap_or → T; is_some → bool; vec_new → Vec<T>; pop → T;
    // vec_to_array → [T]; len/push → i64 (the catch-all).
    if fid == 1 {
        targ
    } else if fid == 2 {
        2
    } else if fid == 7 {
        mk_vec(c, targ)
    } else if fid == 9 {
        targ
    } else if fid == 10 {
        mk_array(c, targ)
    } else {
        0
    }
}

// Dump all call args into `out`, returning the FIRST arg's type (-1 if none).
fn dump_args_capture_first(out: &mut Vec<u8>, a: Args, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Args::End => 0 - 1,
        Args::Cell(x, rest) => {
            push(out, ' ');
            let t0: i64 = dump_texpr(out, x, 0 - 1, src, c, gb);
            dump_targs(out, rest, src, c, gb);
            t0
        },
    }
}

// (4c-1) struct-literal fields: emit each field's VALUE positionally (the names
// are dropped — the typed StructLit is nameless/positional). Source order. (4h) for
// a GENERIC struct-lit (`gen`), the field's declared type is SUBSTITUTED with the
// instance's type-args `gargs` before it expects the value (so `Box { value: 42 }`
// types `42` against `i64`, and `Pair { first: a }` against `<T#0>`).
fn dump_sfields(out: &mut Vec<u8>, f: Fields, sid: i64, gen: bool, gargs: &Vec<i64>, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match f {
        Fields::FieldEnd => 0,
        Fields::FieldCell(fnm, fval, rest) => {
            // Each field VALUE is coerced to the field's DECLARED type — a `?T` field
            // widens a `T` value / types a bare `null`. Look up the type by name
            // BEFORE `fnm` is sunk.
            let ftype0: i64 = field_type(c, sid, &fnm);
            let ftype: i64 = if gen {
                subst_type(c, ftype0, gargs)
            } else {
                ftype0
            };
            sink_name(gb, fnm);
            push(out, ' ');
            dump_texpr(out, fval, ftype, src, c, gb);
            dump_sfields(out, rest, sid, gen, gargs, src, c, gb)
        },
    }
}

// --- (4c-3 / 4d) implicit widening — nullable `?T` (ADR 0014 D3) + secret
//     `secret T` (ADR 0019 D5) -----------------------------------------------

// The widen KIND for a value of natural type `nt` meeting expectation `exp`:
//   0 = none, 1 = `widen-null` (`?nt` expected), 2 = `widen-secret` (`secret nt`
//   expected). `exp` of -1 / a scalar / any non-coercing compound → 0. Both `?T`
//   (kind 4) and `secret T` (kind 3) store the inner `T` in payload A (`ta`).
fn widen_kind(c: &mut TyCtx, exp: i64, nt: i64) -> i64 {
    if exp < tbase() {
        0
    } else {
        let k: i64 = (*c).tk[exp - tbase()];
        if k == 4 {
            if (*c).ta[exp - tbase()] == nt {
                1
            } else {
                0
            }
        } else if k == 3 {
            if (*c).ta[exp - tbase()] == nt {
                2
            } else {
                0
            }
        } else {
            0
        }
    }
}

// True iff `h` is a secret type `secret T` (interner kind 3).
fn is_secret(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 3
    }
}

// Strip one `secret` layer: `secret T` → `T`; any other type unchanged. Used by
// `declassify` (D6) and the secret-preserving cmp/logic result type (D5b).
fn strip_secret(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        h
    } else if (*c).tk[h - tbase()] == 3 {
        (*c).ta[h - tbase()]
    } else {
        h
    }
}

// Emit the widen prefix iff a value of natural type `nt` widens to `exp` — `?T` →
// `(widen-null `, `secret T` → `(widen-secret `; return whether it did (so the
// caller closes the wrapper after the node via `widen_post` — `close_ty` renders
// `:?T` / `:secret T` from `exp` itself, so the suffix needs no kind).
fn widen_pre(out: &mut Vec<u8>, exp: i64, nt: i64, c: &mut TyCtx) -> bool {
    let wk: i64 = widen_kind(c, exp, nt);
    if wk == 1 {
        append_str(out, "(widen-null ");
        0
    } else if wk == 2 {
        append_str(out, "(widen-secret ");
        0
    } else {
        0
    };
    wk != 0
}

// Close a widened node: append ` :?T)` iff `w`; return the node's resulting type
// (`exp` when widened, else the natural `nt`).
fn widen_post(out: &mut Vec<u8>, w: bool, exp: i64, nt: i64, c: &mut TyCtx) -> i64 {
    if w {
        close_ty(out, exp, c);
        exp
    } else {
        nt
    }
}

// Splice a composite already emitted into `tmp` (natural type `nt`) into `out`,
// wrapping it in `(widen-null … :?T)` iff a `?nt` is expected. Consumes `tmp`. Used
// where the node's type is known only AFTER its children synthesize — the wrapper
// must precede the node, so the node is built in a temp first.
fn widen_splice(out: &mut Vec<u8>, tmp: Vec<u8>, exp: i64, nt: i64, c: &mut TyCtx) -> i64 {
    let w: bool = widen_pre(out, exp, nt, c);
    append_str(out, vec_to_array(tmp));
    widen_post(out, w, exp, nt, c)
}

// --- (6/N) borrow-check move analysis (ADR 0043 A1) -------------------------

// True iff a value of type `h` is MOVED on a consuming use (non-Copy). Copy =
// scalars + Ref (kind 2) + Task (kind 12); Secret (3) / Nullable (4) follow their
// inner; Array (1) / Struct (6) / Enum (7) / Class (8) / TypeParam (9) /
// GenericInstance (10) / Vec (11) = Move.
fn is_move_type(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        if k == 2 {
            false
        } else if k == 12 {
            false
        } else if k == 3 {
            is_move_type(c, (*c).ta[idx])
        } else if k == 4 {
            is_move_type(c, (*c).ta[idx])
        } else {
            true
        }
    }
}

// Record a moved source: a `Var #vid` used in a CONSUMING position (`c.consuming`)
// whose type is non-Copy, inside a top-level fn body (`curfn >= 0`; methods aren't
// in `program.fns`, so their moves aren't dumped). Pushes `(curfn, vid)` into the
// `mvf`/`mvv` side-table (dedup happens at dump time via ascending-VarId membership).
fn record_move(c: &mut TyCtx, vid: i64) -> i64 {
    if (*c).curfn < 0 {
        0
    } else if vid < 0 {
        0
    } else {
        let vty: i64 = (*c).env[vid];
        if is_move_type(c, vty) {
            let cf: i64 = (*c).curfn;
            push(&mut (*c).mvf, cf);
            push(&mut (*c).mvv, vid);
            0
        } else {
            0
        }
    }
}

fn dump_texpr(out: &mut Vec<u8>, ex: Expr, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match ex {
        Expr::Int(nv) => {
            let w: bool = widen_pre(out, exp, 0, c);
            append_str(out, "(int ");
            append_int(out, nv);
            close_ty(out, 0, c);
            if (*c).mode == 2 {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 0, 0, nv, 0, 0);
                (*c).lastval = d;
                0
            } else {
                0
            };
            widen_post(out, w, exp, 0, c)
        },
        Expr::Bool(bv) => {
            let w: bool = widen_pre(out, exp, 2, c);
            if bv {
                append_str(out, "(bool true")
            } else {
                append_str(out, "(bool false")
            };
            close_ty(out, 2, c);
            if (*c).mode == 2 {
                let mc: i64 = (*c).mir_cur;
                let bi: i64 = if bv {
                    1
                } else {
                    0
                };
                let d: i64 = mir_emit(c, mc, 1, 0, bi, 0, 2);
                (*c).lastval = d;
                0
            } else {
                0
            };
            widen_post(out, w, exp, 2, c)
        },
        // (4c-3) `null` carries no syntactic type; its type IS the expectation `exp`
        // (a `?T`), threaded from the let annotation / field / cmp-operand / branch.
        Expr::Null => {
            append_str(out, "(null");
            close_ty(out, exp, c);
            exp
        },
        Expr::Var(nm) => {
            let vid: i64 = sc_lookup(c, &nm);
            sink_name(gb, nm);
            // (6/N) a Var in a consuming position moves it (if non-Copy).
            if (*c).consuming {
                record_move(c, vid);
                0
            } else {
                0
            };
            let ty: i64 = env_get(c, vid);
            let w: bool = widen_pre(out, exp, ty, c);
            append_str(out, "(var #");
            append_int(out, vid);
            close_ty(out, ty, c);
            // (7/N) MIR: a Var USE resolves to its current SSA value (no new inst);
            // record its VarId so an enclosing assign can rebind it (7b).
            if (*c).mode == 2 {
                let d: i64 = mir_vd_get(c, vid);
                (*c).lastval = d;
                (*c).mir_lastvid = vid;
                0
            } else {
                0
            };
            widen_post(out, w, exp, ty, c)
        },
        Expr::Unary(uop, inner) => {
            append_str(out, "(unary ");
            let usym: [u8] = if uop == 1 {
                "-"
            } else if uop == 2 {
                "!"
            } else if uop == 3 {
                "*"
            } else if uop == 4 {
                "&"
            } else {
                "&mut"
            };
            append_str(out, usym);
            push(out, ' ');
            // (6/N) a `&`/`&mut` borrow + `*` deref operand is NON-consuming (and `-`/`!`
            // operands are Copy scalars → moot); never a move.
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            let it: i64 = dump_texpr(out, inner, 0 - 1, src, c, gb);
            let iv: i64 = if (*c).mode == 2 {
                (*c).lastval
            } else {
                0 - 1
            };
            (*c).consuming = svc;
            // `!` -> bool; `&`/`&mut` -> a ref type; `*` -> strip a ref; `-` -> operand.
            let rt: i64 = if uop == 2 {
                2
            } else if uop == 4 {
                mk_ref(c, 0, it)
            } else if uop == 5 {
                mk_ref(c, 1, it)
            } else if uop == 3 {
                strip_ref(c, it)
            } else {
                it
            };
            close_ty(out, rt, c);
            // (7/N) MIR: neg/not -> a unary inst (deref/ref are 7c — pass through).
            if (*c).mode == 2 {
                if uop <= 2 {
                    let mc: i64 = (*c).mir_cur;
                    let d: i64 = mir_emit(c, mc, 2, uop, iv, 0, rt);
                    (*c).lastval = d;
                    0
                } else {
                    (*c).lastval = iv;
                    0
                };
                0
            } else {
                0
            };
            rt
        },
        Expr::Binary(bop, l, r) => {
            // The result type is known only AFTER the operands synthesize, but a
            // `(widen-null …)` wrapper must PRECEDE the node — so build the binop into
            // a temp buffer, then splice with the optional wrapper (`maybe_double`'s
            // `a * 2 : i64` widens to `?i64` in a `?i64`-returning branch).
            let mut tmp: Vec<u8> = vec_new();
            push(&mut tmp, '(');
            let pfx: [u8] = if bop <= 7 {
                "binop"
            } else if bop <= 13 {
                "cmp"
            } else {
                "logic"
            };
            append_str(&mut tmp, pfx);
            push(&mut tmp, ' ');
            let bsym: [u8] = if bop == 1 {
                "+"
            } else if bop == 2 {
                "-"
            } else if bop == 3 {
                "*"
            } else if bop == 4 {
                "/"
            } else if bop == 5 {
                "&"
            } else if bop == 6 {
                "|"
            } else if bop == 7 {
                "^"
            } else if bop == 8 {
                "=="
            } else if bop == 9 {
                "!="
            } else if bop == 10 {
                "<"
            } else if bop == 11 {
                "<="
            } else if bop == 12 {
                ">"
            } else if bop == 13 {
                ">="
            } else if bop == 14 {
                "&&"
            } else {
                "||"
            };
            append_str(&mut tmp, bsym);
            push(&mut tmp, ' ');
            let lt: i64 = dump_texpr(&mut tmp, l, 0 - 1, src, c, gb);
            let blv: i64 = if (*c).mode == 2 {
                (*c).lastval
            } else {
                0 - 1
            };
            // (7b) MIR: `&&`/`||` (bop 14/15) is a short-circuit BRANCH on the left — the
            // right operand evaluates only on the non-short edge. Fork now (before the
            // right walk, which then emits into `rhs_blk`). And: true->rhs, false->short;
            // Or: true->short, false->rhs.
            let mut rhs_blk: i64 = 0 - 1;
            let mut short_blk: i64 = 0 - 1;
            if (*c).mode == 2 {
                if bop >= 14 {
                    rhs_blk = mir_new_block(c);
                    short_blk = mir_new_block(c);
                    let pred: i64 = (*c).mir_cur;
                    if bop == 14 {
                        mir_term_branch(c, pred, blv, rhs_blk, short_blk);
                        0
                    } else {
                        mir_term_branch(c, pred, blv, short_blk, rhs_blk);
                        0
                    };
                    (*c).mir_cur = rhs_blk;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            push(&mut tmp, ' ');
            // `==`/`!=` (bop 8/9): the right operand inherits the left's type, so
            // `x == null` types the `null` as `x`'s `?T` (ADR 0014 D7).
            let rexp: i64 = if bop == 8 {
                lt
            } else if bop == 9 {
                lt
            } else {
                0 - 1
            };
            let rt: i64 = dump_texpr(&mut tmp, r, rexp, src, c, gb);
            let brv: i64 = if (*c).mode == 2 {
                (*c).lastval
            } else {
                0 - 1
            };
            // arithmetic (<=7) preserves the operand type — so a secret operand makes
            // the result secret automatically (`lt` is already `secret T`). cmp/logic
            // -> bool, but secret-preserving: a secret operand → `secret bool` (ADR
            // 0019 D5b; mixed public+secret is rejected upstream, so the left
            // operand's secrecy is the pair's).
            let resty: i64 = if bop <= 7 {
                lt
            } else if is_secret(c, lt) {
                mk_secret(c, 2)
            } else {
                2
            };
            close_ty(&mut tmp, resty, c);
            // (7/N) MIR: binop (bop<=7) / cmp (8..13) -> an inst; logic (&&/||) -> the
            // short-circuit merge (the (7b) fork above branched on the left).
            if (*c).mode == 2 {
                if bop <= 13 {
                    let mc: i64 = (*c).mir_cur;
                    let mop: i64 = if bop <= 7 {
                        3
                    } else {
                        4
                    };
                    let d: i64 = mir_emit(c, mc, mop, bop, blv, brv, resty);
                    (*c).lastval = d;
                    0
                } else {
                    // logic short-circuit merge: the rhs value (brv) flows from the rhs
                    // exit; the short block yields a constant (false for &&, true for ||);
                    // both jump to a merge whose single param is the result.
                    let rhs_exit: i64 = (*c).mir_cur;
                    let sb: i64 = if bop == 15 {
                        1
                    } else {
                        0
                    };
                    let sval: i64 = mir_emit(c, short_blk, 1, 0, sb, 0, resty);
                    let merge: i64 = mir_new_block(c);
                    let result: i64 = mir_add_param(c, merge, resty);
                    let mut ra: Vec<i64> = vec_new();
                    let mut sa: Vec<i64> = vec_new();
                    push(&mut ra, brv);
                    push(&mut sa, sval);
                    mir_term_jump(c, rhs_exit, merge, &ra);
                    mir_term_jump(c, short_blk, merge, &sa);
                    (*c).mir_cur = merge;
                    (*c).lastval = result;
                    0
                };
                0
            } else {
                0
            };
            widen_splice(out, tmp, exp, resty, c)
        },
        Expr::If(cnd, thn, els) => {
            append_str(out, "(if ");
            // (6/N) the condition is a read (non-consuming); the branches INHERIT the
            // if's consuming context (a returned/moved if moves its branch-tail Vars —
            // the conservative union: a Var moved in EITHER branch is recorded).
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            dump_texpr(out, cnd, 0 - 1, src, c, gb);
            (*c).consuming = svc;
            // (7b) MIR: branch on the cond into fresh then/else blocks; snapshot var_defs.
            let cv: i64 = if (*c).mode == 2 {
                (*c).lastval
            } else {
                0 - 1
            };
            let mut tb: i64 = 0 - 1;
            let mut eb: i64 = 0 - 1;
            let mut snap: i64 = 0;
            if (*c).mode == 2 {
                tb = mir_new_block(c);
                eb = mir_new_block(c);
                let pred: i64 = (*c).mir_cur;
                snap = mir_vd_len(c);
                mir_term_branch(c, pred, cv, tb, eb);
                (*c).mir_cur = tb;
                0
            } else {
                0
            };
            push(out, ' ');
            // Both branches inherit the `if`'s expectation, so a `?T`-returning `if`
            // widens each branch's tail (and the `if`'s type is that branch type).
            let tt: i64 = dump_texpr(out, thn, exp, src, c, gb);
            // (7b) MIR: capture the then value/exit + the then-arm rebindings (saved to a
            // side list), then restore var_defs to the branch + switch to the else block.
            let then_val: i64 = if (*c).mode == 2 {
                (*c).lastval
            } else {
                0 - 1
            };
            let mut then_exit: i64 = 0 - 1;
            let mut tsv: Vec<i64> = vec_new();
            let mut tsval: Vec<i64> = vec_new();
            if (*c).mode == 2 {
                then_exit = (*c).mir_cur;
                let tlen: i64 = mir_vd_len(c);
                let mut ki: i64 = snap;
                while ki < tlen {
                    let kv: i64 = (*c).mvdv[ki];
                    let kl: i64 = (*c).mvdl[ki];
                    push(&mut tsv, kv);
                    push(&mut tsval, kl);
                    ki = ki + 1;
                }
                mir_vd_trunc(c, snap);
                (*c).mir_cur = eb;
                0
            } else {
                0
            };
            push(out, ' ');
            dump_texpr(out, els, exp, src, c, gb);
            // (7b) MIR: build the merge — result param first, then one param per variable
            // that diverged across the arms (VarId-sorted), reconciled via the arms' jumps.
            if (*c).mode == 2 {
                let else_val: i64 = (*c).lastval;
                let else_exit: i64 = (*c).mir_cur;
                let elen: i64 = mir_vd_len(c);
                let merge: i64 = mir_new_block(c);
                let result: i64 = mir_add_param(c, merge, tt);
                let mut then_args: Vec<i64> = vec_new();
                let mut else_args: Vec<i64> = vec_new();
                push(&mut then_args, then_val);
                push(&mut else_args, else_val);
                let nv: i64 = (*c).nextvid;
                let mut vid: i64 = 0;
                while vid < nv {
                    let bv: i64 = mir_vd_lp(c, snap, vid);
                    if bv >= 0 {
                        let ts: i64 = mir_side_lookup(&tsv, &tsval, vid);
                        let tvv: i64 = if ts < 0 {
                            bv
                        } else {
                            ts
                        };
                        let es: i64 = mir_vd_lr(c, snap, elen, vid);
                        let evv: i64 = if es < 0 {
                            bv
                        } else {
                            es
                        };
                        if tvv != evv {
                            let pty: i64 = (*c).mvty[tvv];
                            let p: i64 = mir_add_param(c, merge, pty);
                            push(&mut then_args, tvv);
                            push(&mut else_args, evv);
                            mir_vd_set(c, vid, p);
                            0
                        } else {
                            0
                        };
                        0
                    } else {
                        0
                    };
                    vid = vid + 1;
                }
                mir_term_jump(c, then_exit, merge, &then_args);
                mir_term_jump(c, else_exit, merge, &else_args);
                (*c).mir_cur = merge;
                (*c).lastval = result;
                0
            } else {
                0
            };
            close_ty(out, tt, c);
            tt
        },
        Expr::Block(stmts, tail) => {
            append_str(out, "(block");
            dump_tstmts(out, stmts, src, c, gb);
            push(out, ' ');
            // The block's value is its tail — thread the expectation through to it.
            let tt: i64 = dump_texpr(out, tail, exp, src, c, gb);
            close_ty(out, tt, c);
            tt
        },
        Expr::Call(cn, ca) => {
            // (4g) a callee resolving to an in-scope VAR is a continuation-resume
            // `k(arg)` (vars shadow fns) → `(resume-kont #vid <args> :T)`, T = the
            // resume value's type; else a free-fn call.
            let kid: i64 = sc_lookup(c, &cn);
            if kid >= 0 {
                sink_name(gb, cn);
                let kty: i64 = env_get(c, kid);
                append_str(out, "(resume-kont #");
                append_int(out, kid);
                // (6/N) resume-kont args are consuming (passed by value to the cont).
                let svk: bool = (*c).consuming;
                (*c).consuming = true;
                let rkt: i64 = dump_args_capture_first(out, ca, src, c, gb);
                (*c).consuming = svk;
                let krt: i64 = if rkt == 0 - 1 {
                    kty
                } else {
                    rkt
                };
                close_ty(out, krt, c);
                krt
            } else {
                let fid: i64 = fn_lookup(c, src, &cn);
                sink_name(gb, cn);
                append_str(out, "(call #");
                append_int(out, fid);
                // Generic builtins (e.g. `len: <T>([T]) -> i64`) emit `(targs T)`
                // before the args; T is inferred from the first arg, so the args are
                // dumped to a temp buffer first. The return type may depend on T.
                // (4h) a generic USER fn (FnId 14+ with type-params) infers + emits
                // `(targs …)` then substitutes its return type; a generic BUILTIN
                // (len/unwrap_or/is_some) uses the existing first-arg `dump_gcall`;
                // everything else dumps args straight with the declared return type.
                let isgenfn: bool = if fid >= 14 {
                    (*c).uftp[fid - 14] > 0
                } else {
                    false
                };
                // (6/N) USER-fn (FnId >= 14) args are CONSUMING (moved into the callee);
                // BUILTIN args (len/push/vec_to_array/print/…) are NON-consuming (the
                // builtins borrow / don't move). `argcons` gates the args' move-recording.
                let argcons: bool = fid >= 14;
                let svf: bool = (*c).consuming;
                (*c).consuming = argcons;
                let rt: i64 = if is_generic_builtin(fid) {
                    dump_gcall(out, fid, ca, exp, src, c, gb)
                } else if isgenfn {
                    dump_generic_call(out, fid, ca, src, c, gb)
                } else {
                    dump_targs(out, ca, src, c, gb);
                    fn_ret(c, fid)
                };
                (*c).consuming = svf;
                close_ty(out, rt, c);
                rt
            }
        },
        Expr::SynthZero => {
            let w: bool = widen_pre(out, exp, 0, c);
            append_str(out, "(int 0");
            close_ty(out, 0, c);
            if (*c).mode == 2 {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 0, 0, 0, 0, 0);
                (*c).lastval = d;
                0
            } else {
                0
            };
            widen_post(out, w, exp, 0, c)
        },
        // (4c-1) struct literal — positional field VALUES in declaration order
        // (the corpus writes fields in decl order, so source order = decl order;
        // a reorder is a follow-up if a fixture needs it). The node's type is the
        // struct. `(struct-lit #sid Name <v0> <v1>… :Name)`.
        Expr::StructLit(snm, fields) => {
            let sid: i64 = struct_lookup(c, &snm);
            // (4h) a GENERIC struct-lit takes its type (and its type-args) from the
            // expected type `exp` (a GenericInstance of this struct — threaded from a
            // `let` annotation / fn return). The arg Vec is built ONCE here, so
            // `dump_sfields` stays a single Fields-consumer (no parallel-consumer leak).
            let sl_gd: i64 = gi_decl_of(c, exp);
            let sl_isg: bool = if sl_gd >= 0 {
                sl_gd == sid
            } else {
                false
            };
            let sty: i64 = if sl_isg {
                exp
            } else {
                mk_struct(c, sid)
            };
            let mut gargs: Vec<i64> = vec_new();
            if sl_isg {
                let sl_gas: i64 = gi_argstart(c, exp);
                let sl_gae: i64 = gi_argend(c, exp);
                let mut sl_j: i64 = sl_gas;
                while sl_j < sl_gae {
                    let sl_a: i64 = (*c).gia[sl_j];
                    push(&mut gargs, sl_a);
                    sl_j = sl_j + 1;
                }
                0
            } else {
                0
            };
            append_str(out, "(struct-lit #");
            append_int(out, sid);
            push(out, ' ');
            append_str(out, snm);
            // (6/N) struct-lit field values are CONSUMING (moved into the struct).
            let sl_svc: bool = (*c).consuming;
            (*c).consuming = true;
            dump_sfields(out, fields, sid, sl_isg, &gargs, src, c, gb);
            (*c).consuming = sl_svc;
            close_ty(out, sty, c);
            sty
        },
        // (4c-1) field access — `(field <target :Struct> name <field_index> :fty)`.
        // The target's type is a struct; types computes the field's declaration
        // index (for codegen's GEP) + the field type.
        Expr::Field(ft, fdn) => {
            append_str(out, "(field ");
            // (6/N) a field-access receiver is a READ (non-consuming) — `p.x` does not
            // move `p`.
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            let tty: i64 = dump_texpr(out, ft, 0 - 1, src, c, gb);
            (*c).consuming = svc;
            push(out, ' ');
            // The target is a struct, a generic-instance struct, or a class (a
            // `&self`-receiver strips its ref). (4h) for a generic instance the
            // declared field type is SUBSTITUTED with the instance's type-args
            // (`b.value` where `b: Box<i64>` → `i64`; `p.first` where `p: Pair<A,B>`
            // → `<T#0>`).
            let bare: i64 = strip_ref(c, tty);
            let fd_gd: i64 = gi_decl_of(c, bare);
            let sid: i64 = if fd_gd >= 0 {
                fd_gd
            } else {
                struct_of_handle(c, bare)
            };
            let ccid: i64 = class_of_handle(c, bare);
            let fidx: i64 = if sid >= 0 {
                field_index(c, sid, &fdn)
            } else {
                class_field_index(c, ccid, &fdn)
            };
            let fty0: i64 = if sid >= 0 {
                field_type(c, sid, &fdn)
            } else {
                class_field_type(c, ccid, &fdn)
            };
            let fty: i64 = if fd_gd >= 0 {
                let mut fargs: Vec<i64> = vec_new();
                let fd_gas: i64 = gi_argstart(c, bare);
                let fd_gae: i64 = gi_argend(c, bare);
                let mut fd_j: i64 = fd_gas;
                while fd_j < fd_gae {
                    let fd_a: i64 = (*c).gia[fd_j];
                    push(&mut fargs, fd_a);
                    fd_j = fd_j + 1;
                }
                subst_type(c, fty0, &fargs)
            } else {
                fty0
            };
            append_str(out, fdn);
            push(out, ' ');
            append_int(out, fidx);
            close_ty(out, fty, c);
            fty
        },
        // (4c-2) array literal — `(array <e0> <e1>… :[T])`. The element type is
        // inferred from the first element (empty arrays need the expected type — a
        // follow-up); the node's type is `[T]`.
        Expr::Array(elems) => {
            append_str(out, "(array");
            // (6/N) array elements are CONSUMING (moved into the array).
            let ar_svc: bool = (*c).consuming;
            (*c).consuming = true;
            let ety: i64 = dump_array_elems(out, elems, src, c, gb);
            (*c).consuming = ar_svc;
            let aty: i64 = mk_array(c, ety);
            close_ty(out, aty, c);
            aty
        },
        // (4c-2) postfix index — `(index <target :[T]> <index :i64> :T)`. The
        // element type is the array's inner.
        Expr::Index(it, ii) => {
            append_str(out, "(index ");
            // (6/N) `a[i]` reads `a` + `i` (both non-consuming) — neither is moved.
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            let tty: i64 = dump_texpr(out, it, 0 - 1, src, c, gb);
            push(out, ' ');
            dump_texpr(out, ii, 0 - 1, src, c, gb);
            (*c).consuming = svc;
            let ety: i64 = array_elem_of(c, tty);
            close_ty(out, ety, c);
            ety
        },
        // (4e) `Name::Variant(args)` / paren-less `Name::Variant`. If `Name` is an
        // enum → `(enum-construct #eid vidx Enum Variant <typed-args> :Enum)` (mirror
        // resolve's split). A non-enum `::` (a named-impl qcall) lands at 4f — emit a
        // non-leaking placeholder (args consumed) so the match stays exhaustive.
        Expr::Qcall(qi, qm, qa) => {
            let qeid: i64 = enum_lookup(c, &qi);
            if qeid >= 0 {
                let vidx: i64 = variant_index(c, qeid, &qm);
                let ety: i64 = mk_enum(c, qeid);
                append_str(out, "(enum-construct #");
                append_int(out, qeid);
                push(out, ' ');
                append_int(out, vidx);
                push(out, ' ');
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                dump_cargs(out, qa, src, c, gb);
                close_ty(out, ety, c);
                ety
            } else {
                // (4f) a named-impl qualified call `ImplName::method(args)` →
                // `(qcall-impl #iid <method_index> ImplName method <args> :ret)` (the
                // method index + return type come from the impl's trait).
                let iid: i64 = impl_lookup(c, &qi);
                let qtid: i64 = impl_trait_of(c, iid);
                let qmidx: i64 = trait_method_index(c, qtid, &qm);
                let qmret: i64 = trait_method_ret(c, qtid, &qm);
                append_str(out, "(qcall-impl #");
                append_int(out, iid);
                push(out, ' ');
                append_int(out, qmidx);
                push(out, ' ');
                append_str(out, qi);
                push(out, ' ');
                append_str(out, qm);
                dump_cargs(out, qa, src, c, gb);
                close_ty(out, qmret, c);
                qmret
            }
        },
        // (4e) `match <scrut> { pat => body, … }` — the scrutinee's type gives the
        // EnumId (emitted as `#eid`); each arm binds its variant's payload types +
        // types its body. The match's type is the (shared) arm-body type.
        // `(match <scrut :Enum> #eid (arm (pat vidx V (bind #vid n ty)…) <body :T>)… :T)`.
        Expr::Match(mscr, marms) => {
            append_str(out, "(match ");
            // (6/N) a `match` scrutinee is NOT a move (the oracle does not record it —
            // it's read/inspected); the arms inherit the match's own consuming context
            // (restored `svc`), so an arm body's returned-tail Vars still move.
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            let scrty: i64 = dump_texpr(out, mscr, 0 - 1, src, c, gb);
            (*c).consuming = svc;
            let meid: i64 = enum_of_handle(c, scrty);
            append_str(out, " #");
            append_int(out, meid);
            let mty: i64 = dump_tarms(out, marms, exp, src, c, gb);
            close_ty(out, mty, c);
            mty
        },
        // (4f) `Name::init(args)` → `(class-init #cid Name <typed-args> :Class)`.
        Expr::ClassInit(cn, ca) => {
            let cid: i64 = class_lookup(c, &cn);
            let cty: i64 = mk_class(c, cid);
            append_str(out, "(class-init #");
            append_int(out, cid);
            push(out, ' ');
            append_str(out, cn);
            dump_cargs(out, ca, src, c, gb);
            close_ty(out, cty, c);
            cty
        },
        // (4f) `target.method(args)` — the receiver's class (the type-resolved split):
        // its OWN method → `(method #cid <idx> <target> name <args> :ret)`; else a
        // default-impl method → `(impl-method #iid <idx> <target> name <args> :ret)`.
        // The target is built in a temp first (the `#cid`/`#iid` precede it).
        Expr::Method(mt, mn, ma) => {
            let mut tbuf: Vec<u8> = vec_new();
            // (6/N) a method receiver is borrowed (`self: &Self`/`&mut Self`) →
            // non-consuming; the args are consuming (forced by `dump_targs`).
            let svc: bool = (*c).consuming;
            (*c).consuming = false;
            let tty: i64 = dump_texpr(&mut tbuf, mt, 0 - 1, src, c, gb);
            (*c).consuming = svc;
            let rcid: i64 = class_of_handle(c, strip_ref(c, tty));
            if class_has_method(c, rcid, &mn) {
                let midx: i64 = class_method_index(c, rcid, &mn);
                let mret: i64 = class_method_ret(c, rcid, &mn);
                append_str(out, "(method #");
                append_int(out, rcid);
                push(out, ' ');
                append_int(out, midx);
                push(out, ' ');
                append_str(out, vec_to_array(tbuf));
                push(out, ' ');
                append_str(out, mn);
                dump_cargs(out, ma, src, c, gb);
                close_ty(out, mret, c);
                mret
            } else {
                let idef: i64 = impl_for_class(c, rcid, &mn);
                let mtid: i64 = impl_trait_of(c, idef);
                let midx2: i64 = trait_method_index(c, mtid, &mn);
                let mret2: i64 = trait_method_ret(c, mtid, &mn);
                append_str(out, "(impl-method #");
                append_int(out, idef);
                push(out, ' ');
                append_int(out, midx2);
                push(out, ' ');
                append_str(out, vec_to_array(tbuf));
                push(out, ' ');
                append_str(out, mn);
                dump_cargs(out, ma, src, c, gb);
                close_ty(out, mret2, c);
                mret2
            }
        },
        // (4g) `perform Eff.op(args)` → `(perform #eid op_idx Eff op <args> :ret)` —
        // ret = the op's return type (the perform expression's value type).
        Expr::Perform(pe, po, pa) => {
            let peid: i64 = effect_lookup(c, src, &pe);
            let poidx: i64 = op_index_lookup(c, src, peid, &po);
            let pret: i64 = op_ret(c, peid, poidx);
            append_str(out, "(perform #");
            append_int(out, peid);
            push(out, ' ');
            append_int(out, poidx);
            push(out, ' ');
            append_str(out, pe);
            push(out, ' ');
            append_str(out, po);
            dump_cargs(out, pa, src, c, gb);
            close_ty(out, pret, c);
            pret
        },
        // (4g) `handle body with { Eff.op(ps) => arm, … return v => arm }` →
        // `(handle <body :T> (arm #eid idx Eff op (#pvids) <arm-body>)… (return #vid
        // <body>)? :T)` — the handle's type is the body's type. Handler-arm params +
        // the return var bind VarIds in the enclosing fn region (scoped per-arm).
        Expr::Handle(hb, ha, hr) => {
            append_str(out, "(handle ");
            let bty: i64 = dump_texpr(out, hb, 0 - 1, src, c, gb);
            dump_tharms(out, ha, src, c, gb);
            dump_tret(out, hr, bty, src, c, gb);
            close_ty(out, bty, c);
            bty
        },
        // (4d) `declassify(e)` strips one secret layer: `secret T → T` (ADR 0019 D6).
        // The inner is synthesized with no expectation; the node's type is its stripped
        // type. `(declassify <inner :secret T> :T)`.
        Expr::Declassify(di) => {
            append_str(out, "(declassify ");
            // (6/N) `declassify` consumes its (secret) operand.
            let svc: bool = (*c).consuming;
            (*c).consuming = true;
            let it: i64 = dump_texpr(out, di, 0 - 1, src, c, gb);
            (*c).consuming = svc;
            let rt: i64 = strip_secret(c, it);
            close_ty(out, rt, c);
            rt
        },
        // (4i) char literal `'c'` → `(char N :u8)` (the decoded byte value, ADR 0033 D2:
        // `u8`). Widens like the other scalar leaves (a `secret u8` / `?u8` context).
        Expr::Char(cv) => {
            let w: bool = widen_pre(out, exp, 3, c);
            append_str(out, "(char ");
            append_int(out, cv);
            close_ty(out, 3, c);
            widen_post(out, w, exp, 3, c)
        },
        // (4i) string literal `"…"` → `(str b0 b1 … :[u8])` (the decoded bytes, ADR 0033
        // D2: a string IS a `[u8]`). ⚠ `sb` is an owned `[u8]` only INDEXED in the byte
        // loop → `sink_name` it (by value) after, else it leaks (the parser's
        // `dump_str_body` lesson).
        Expr::Str(sb) => {
            let saty: i64 = mk_array(c, 3);
            let w: bool = widen_pre(out, exp, saty, c);
            append_str(out, "(str");
            let slen: i64 = len(sb);
            let mut sbi: i64 = 0;
            while sbi < slen {
                push(out, ' ');
                append_int(out, u8_to_i64(sb[sbi]));
                sbi = sbi + 1;
            }
            sink_name(gb, sb);
            close_ty(out, saty, c);
            widen_post(out, w, exp, saty, c)
        },
        // (4i) `scope concurrent { block }` → `(scope <block :T> :T)`: the scope's value
        // IS the block's tail, so thread the expectation `exp` through (a `?T`-typed
        // scope widens its tail). Discharges the Async effect (effect-check is D1, out of
        // scope), so the type is just the body type.
        Expr::Scope(sbody) => {
            append_str(out, "(scope ");
            let sct: i64 = dump_texpr(out, sbody, exp, src, c, gb);
            close_ty(out, sct, c);
            sct
        },
        // (4i) `spawn <call>` → `(spawn <inner :U> :Task<U>)`: spawn wraps the spawned
        // expression's type U in a `Task`.
        Expr::Spawn(scall) => {
            append_str(out, "(spawn ");
            let spt: i64 = dump_texpr(out, scall, 0 - 1, src, c, gb);
            let tkt: i64 = mk_task(c, spt);
            close_ty(out, tkt, c);
            tkt
        },
        // (4i) `<target>.await` → `(await <target :Task<U>> :U)`: await joins the task +
        // yields its result type U (the Task's element).
        Expr::Await(aw) => {
            append_str(out, "(await ");
            let awt: i64 = dump_texpr(out, aw, 0 - 1, src, c, gb);
            let awr: i64 = task_elem_of(c, awt);
            close_ty(out, awr, c);
            awr
        },
        // A defensive catch-all keeps the match exhaustive (no Expr variants remain).
        _ => {
            append_str(out, "(UNHANDLED");
            close_ty(out, 0, c);
            0
        },
    }
}

// (4e) A match-arm pattern's payload bindings: each binds a fresh VarId (in
// source order) into the arm's scope with its variant's payload type, and emits
// `(bind #vid name <type>)`. `pbase` is the variant's payload-slice base into
// `varpay`; `payidx` advances per bind. The name is emitted from `nb` AFTER
// `bind_name` copies it there (it consumes the AST `[u8]`).
fn dump_tbinds(out: &mut Vec<u8>, b: Binds, pbase: i64, payidx: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            let bvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            let pty: i64 = (*c).varpay[pbase + payidx];
            let nst: i64 = len((*c).nb);
            bind_name(c, nm, bvid, pty);
            let nen: i64 = len((*c).nb);
            append_str(out, " (bind #");
            append_int(out, bvid);
            push(out, ' ');
            let mut bi: i64 = nst;
            while bi < nen {
                push(out, (*c).nb[bi]);
                bi = bi + 1;
            }
            push(out, ' ');
            render_type(out, pty, c);
            push(out, ')');
            dump_tbinds(out, rest, pbase, payidx + 1, c, gb)
        },
    }
}

// (4e) A match-arm pattern: `_` → `(pat _)`; `Enum::Variant(binds)` → `(pat vidx
// Variant (bind …)…)` — the variant_index replaces resolve's enum name; the binds
// take the variant's payload types.
fn dump_tpat(out: &mut Vec<u8>, p: Pattern, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match p {
        Pattern::PatWild => {
            append_str(out, "(pat _)");
            0
        },
        Pattern::PatVariant(en, vn, bs) => {
            let eid: i64 = enum_lookup(c, &en);
            sink_name(gb, en);
            let vidx: i64 = variant_index(c, eid, &vn);
            let j: i64 = variant_flat(c, eid, vidx);
            let pbase: i64 = (*c).varps[j];
            append_str(out, "(pat ");
            append_int(out, vidx);
            push(out, ' ');
            append_str(out, vn);
            dump_tbinds(out, bs, pbase, 0, c, gb);
            push(out, ')');
            0
        },
    }
}

// (4e) match arms: snapshot the scope, dump the pattern (binding its payloads),
// type the body (threading the match's expectation `exp`), then TRUNCATE the scope
// back (the payloads are arm-local; VarIds stay monotonic). The match's type is the
// FIRST arm's body type (every arm shares it on clean fixtures).
fn dump_tarms(out: &mut Vec<u8>, a: Arms, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Arms::ArmEnd => 0 - 1,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            let mark: i64 = len((*c).scs);
            dump_tpat(out, ap, c, gb);
            push(out, ' ');
            let bt: i64 = dump_texpr(out, abody, exp, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            dump_tarms(out, arest, exp, src, c, gb);
            bt
        },
    }
}

// (4g) A handler arm's params: each binds a fresh VarId (source order) → `#vid`. ⚠
// bound with `i64` (every corpus op param is `i64`; the continuation `k` is only ever
// used as a resume-kont callee, never a typed var). A non-`i64` op param would need
// the op's param-type table (a follow-up).
fn dump_thparams(out: &mut Vec<u8>, b: Binds, c: &mut TyCtx, first: bool) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            if first {
                0
            } else {
                push(out, ' ');
                0
            };
            let pvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, nm, pvid, 0);
            push(out, '#');
            append_int(out, pvid);
            dump_thparams(out, rest, c, false)
        },
    }
}

// (4g) handler arms → `(arm #eid op_idx Eff op (#pvids) <body>)` — params bind VarIds
// scoped to the arm (truncated after); the body is typed (sees the params + `k`).
fn dump_tharms(out: &mut Vec<u8>, a: HArms, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hparams, hbody, hrest) => {
            let heid: i64 = effect_lookup(c, src, &hef);
            let hoidx: i64 = op_index_lookup(c, src, heid, &hop);
            append_str(out, " (arm #");
            append_int(out, heid);
            push(out, ' ');
            append_int(out, hoidx);
            push(out, ' ');
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            append_str(out, " (");
            let mark: i64 = len((*c).scs);
            dump_thparams(out, hparams, c, true);
            append_str(out, ") ");
            dump_texpr(out, hbody, 0 - 1, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            dump_tharms(out, hrest, src, c, gb)
        },
    }
}

// (4g) the optional `return v => body` arm → `(return #vid <body>)`: `v` binds a
// VarId typed as the handle BODY's type `bty` (it names the body's value), scoped to
// the arm.
fn dump_tret(out: &mut Vec<u8>, r: Ret, bty: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody) => {
            let mark: i64 = len((*c).scs);
            let rvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, rnm, rvid, bty);
            append_str(out, " (return #");
            append_int(out, rvid);
            push(out, ' ');
            dump_texpr(out, rbody, 0 - 1, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            0
        },
    }
}

fn dump_tstmts(out: &mut Vec<u8>, st: Stmts, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(s, rest) => {
            push(out, ' ');
            dump_tstmt(out, s, src, c, gb);
            dump_tstmts(out, rest, src, c, gb)
        },
    }
}

fn dump_tstmt(out: &mut Vec<u8>, s: Stmt, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            // DURING-WALK binding: take the let's expected type from its annotation
            // FIRST (so a `?T` let widens a `T` value / types a `null`), resolve the
            // VALUE against it into a temp buffer (it may bind nested vars), THEN take
            // the let's VarId. The let's type is the annotation if present, else the
            // value's inferred type. Format: `(let #vid [mut] <type> <value>)`.
            let mut vbuf: Vec<u8> = vec_new();
            let letexp: i64 = tyopt_exp(c, lty, gb);
            // (6/N) a `let`'s RHS is CONSUMING (a bare-Var RHS moves the binding).
            let lsvc: bool = (*c).consuming;
            (*c).consuming = true;
            let valty: i64 = dump_texpr(&mut vbuf, lval, letexp, src, c, gb);
            (*c).consuming = lsvc;
            let lvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            let letty: i64 = if letexp == 0 - 1 {
                valty
            } else {
                letexp
            };
            bind_name(c, lnm, lvid, letty);
            // (7/N) MIR: the let's value is its current SSA value (the RHS's `lastval`).
            if (*c).mode == 2 {
                let lv: i64 = (*c).lastval;
                mir_vd_set(c, lvid, lv);
                0
            } else {
                0
            };
            append_str(out, "(let #");
            append_int(out, lvid);
            push(out, ' ');
            if lmf {
                append_str(out, "mut ")
            } else {
                0
            };
            render_type(out, letty, c);
            push(out, ' ');
            append_str(out, vec_to_array(vbuf));
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            // (6/N) the assign TARGET is a place (non-consuming); the VALUE is consuming.
            let asvc: bool = (*c).consuming;
            (*c).consuming = false;
            dump_texpr(out, atgt, 0 - 1, src, c, gb);
            // (7b) MIR: for a plain-Var target (`mir_lastvid` set by the Var arm), the
            // assign rebinds its current SSA value to the RHS. (A field/`*`-deref store
            // is 7c — its receiver Var also sets `mir_lastvid`, so the Var-only rebind
            // is exercised by the control-flow corpus only at 7c+.)
            let tvid: i64 = if (*c).mode == 2 {
                (*c).mir_lastvid
            } else {
                0 - 1
            };
            (*c).consuming = true;
            push(out, ' ');
            dump_texpr(out, aval, 0 - 1, src, c, gb);
            if (*c).mode == 2 {
                if tvid >= 0 {
                    let av: i64 = (*c).lastval;
                    mir_vd_set(c, tvid, av);
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            (*c).consuming = asvc;
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            // (6/N) the cond is a read + the while body's value is discarded — both
            // non-consuming (call args inside still set their own consuming).
            let wsvc: bool = (*c).consuming;
            (*c).consuming = false;
            dump_texpr(out, wcond, 0 - 1, src, c, gb);
            push(out, ' ');
            dump_texpr(out, wbody, 0 - 1, src, c, gb);
            (*c).consuming = wsvc;
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            // (6/N) an expr-statement's value is discarded → non-consuming (inner call
            // args still set their own consuming).
            let esvc: bool = (*c).consuming;
            (*c).consuming = false;
            dump_texpr(out, sx, 0 - 1, src, c, gb);
            (*c).consuming = esvc;
            push(out, ')');
            0
        },
    }
}

// The let's annotation type as an EXPECTATION (consuming the `TyOpt`): the interned
// annotation handle if present, else -1 (no expectation → the value's type is
// inferred). Taken before the value is walked, so a `?T` annotation widens the value.
fn tyopt_exp(c: &mut TyCtx, ty: TyOpt, gb: &mut Vec<u8>) -> i64 {
    match ty {
        TyOpt::NoTy => 0 - 1,
        TyOpt::SomeTy(t) => type_of_typeexpr(c, t, gb),
    }
}

// --- fn header parse --------------------------------------------------------

// Parse + emit a fn's params from tokens (mirrors resolve's `emit_params`): each
// `(param #vid [mut] <name> <type>)`, binding the param's VarId + its type in the
// env. Ends on `)` (kind 5); skips `,` (kind 29). `first` suppresses the leading
// space.
fn emit_tparams(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_tparams(out, k, s, e, src, cur, c, gb, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pty: i64 = type_of_typeexpr(c, pte, gb);
        let vid: i64 = (*c).nextvid;
        (*c).nextvid = (*c).nextvid + 1;
        bind_src(c, src, ns, ne, vid, pty);
        // (7/N) MIR: the param is an SSA param of the entry block; bind var_defs.
        if (*c).mode == 2 {
            let mc: i64 = (*c).mir_cur;
            let pv: i64 = mir_add_param(c, mc, pty);
            mir_vd_set(c, vid, pv);
            0
        } else {
            0
        };
        append_str(out, "(param #");
        append_int(out, vid);
        push(out, ' ');
        if pm {
            append_str(out, "mut ")
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        render_type(out, pty, c);
        push(out, ')');
        emit_tparams(out, k, s, e, src, cur, c, gb, false)
    }
}

// Type-check one top-level `fn`, emitting `(fn #id name (params) <ret> <block>)`.
fn type_fn(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, fnidx: i64) -> i64 {
    *cur = *cur + 1;            // skip `fn`
    let name_s: i64 = (*s)[*cur];
    let name_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    // (4h) set up the type-param scope so the params/body/return type as `<T#i>`;
    // `tp_setup` resets first (so a non-generic fn gets an empty scope) + advances
    // past `>` (or no-ops, leaving the cursor at `(`).
    tp_setup(c, k, s, e, src, cur);
    *cur = *cur + 1;           // skip `(`
    (*c).base = len((*c).scs);
    // (7/N) MIR: start this fn's lowering — fresh pools + an entry block (b0).
    // Params are added as the entry's SSA params by `emit_tparams` (mode 2).
    if (*c).mode == 2 {
        mir_reset(c);
        let eb: i64 = mir_new_block(c);
        (*c).mir_cur = eb;
        0
    } else {
        0
    };
    append_str(out, "(fn #");
    append_int(out, 14 + fnidx);
    push(out, ' ');
    append_slice(out, src, name_s, name_e);
    append_str(out, " (");
    emit_tparams(out, k, s, e, src, cur, c, gb, true);
    append_str(out, ") ");
    *cur = *cur + 1;           // skip `->`
    let rte: TypeE = parse_type(k, s, e, src, cur);
    let rty: i64 = type_of_typeexpr(c, rte, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let body: Expr = parse_block(k, s, e, src, cur);
    render_type(out, rty, c);
    push(out, ' ');
    // (6/N) record this fn's moves: `curfn` = its idx (only top-level fn bodies — methods
    // aren't in `program.fns`), and the body's tail is CONSUMING (the returned value).
    (*c).curfn = fnidx;
    (*c).consuming = true;
    // The fn return type is the body's expectation — a `?T`-returning fn widens its
    // tail (`dump_texpr` on the body `Block` threads `rty` to the tail).
    dump_texpr(out, body, rty, src, c, gb);
    (*c).curfn = 0 - 1;
    // (7/N) MIR: the body's value (`lastval`) is the fn's return; terminate the
    // current block + dump this fn's MIR into `mirout`.
    if (*c).mode == 2 {
        let bv: i64 = (*c).lastval;
        let cb: i64 = (*c).mir_cur;
        mir_term_return(c, cb, bv);
        // Dump into a LOCAL buffer (distinct from `c`), then fold into the `mirout`
        // FIELD via a `push` loop (a builtin works on a Vec field of `*c`).
        let mut mb: Vec<u8> = vec_new();
        mir_dump_fn(&mut mb, c, src, name_s, name_e, rty);
        let mbn: i64 = len(mb);
        let mut mbi: i64 = 0;
        while mbi < mbn {
            push(&mut (*c).mirout, mb[mbi]);
            mbi = mbi + 1;
        }
        let _mbx: [u8] = vec_to_array(mb);
        0
    } else {
        0
    };
    push(out, ')');
    // (4h) clear the type-param scope so a following NON-generic decl (whose pass-2
    // typing doesn't call `tp_setup`) doesn't see this fn's type-params.
    tp_reset(c);
    0
}

// PASS-1.5 signature scan (was `scan_fn_ret`): position a cursor at the `fn` token
// `p1`, set up its type-param scope (`<…>`), and record its full SIGNATURE into the
// fn tables — `ufret` (return handle), `uftp` (type-param count, 0 = non-generic),
// and `ufps`/`ufpe` (the param-type slice into `ufpp`). All four push once per fn in
// source order, so they stay index-aligned. The type-param scope is reset after.
// Lets a forward-declared (and possibly generic) fn type + infer correctly at calls.
fn scan_fn_sig(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;     // at name
    cur = cur + 1;                 // skip name
    tp_setup(c, k, s, e, src, &mut cur);   // parse `<…>` type-params (advances past `>`)
    let ntp: i64 = len((*c).tpns);
    cur = cur + 1;                 // skip `(`
    let ps: i64 = len((*c).ufpp);
    scan_paramtypes(k, s, e, src, &mut cur, c, gb);
    let pe: i64 = len((*c).ufpp);
    cur = cur + 1;                 // skip `->`
    let rte: TypeE = parse_type(k, s, e, src, &mut cur);
    let rty: i64 = type_of_typeexpr(c, rte, gb);
    push(&mut (*c).ufret, rty);
    push(&mut (*c).uftp, ntp);
    push(&mut (*c).ufps, ps);
    push(&mut (*c).ufpe, pe);
    tp_reset(c);
    0
}

// Walk a param list (no emit, no var-bind) recording each param's type handle into
// `ufpp` (for generic-call unification) — mirrors `emit_tparams`'s token walk under
// the active type-param scope. Ends past `)`.
fn scan_paramtypes(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_paramtypes(k, s, e, src, cur, c, gb)
    } else {
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;           // skip name
        *cur = *cur + 1;           // skip `:`
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pty: i64 = type_of_typeexpr(c, pte, gb);
        push(&mut (*c).ufpp, pty);
        scan_paramtypes(k, s, e, src, cur, c, gb)
    }
}

// (4c-1) emit a struct decl head from the struct + field tables:
// `(struct #sid Name (field name <type>)…)`.
fn type_struct(out: &mut Vec<u8>, c: &mut TyCtx, sid: i64) -> i64 {
    append_str(out, "(struct #");
    append_int(out, sid);
    push(out, ' ');
    let ns: i64 = (*c).sts[sid];
    let ne: i64 = (*c).ste[sid];
    let mut bi: i64 = ns;
    while bi < ne {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    let nf: i64 = len((*c).fldo);
    let mut i: i64 = 0;
    while i < nf {
        if (*c).fldo[i] == sid {
            append_str(out, " (field ");
            let fs: i64 = (*c).flds[i];
            let fe: i64 = (*c).flde[i];
            let mut fi2: i64 = fs;
            while fi2 < fe {
                push(out, (*c).snb[fi2]);
                fi2 = fi2 + 1;
            }
            push(out, ' ');
            let fh: i64 = (*c).fldty[i];
            render_type(out, fh, c);
            push(out, ')');
            0
        } else {
            0
        };
        i = i + 1;
    }
    push(out, ')');
    0
}

// PASS-1.5 struct-field scan: record each field `(StructId, name, type-handle)`
// into the field table. Runs after ALL struct NAMES are registered (pass 1), so
// a field type referencing another struct resolves.
fn scan_struct_fields(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, sid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;     // at name
    cur = cur + 1;                 // skip name
    // (4h) set up the struct's type-param scope so field types reference `<T#i>`
    // (`struct Box<T> { value: T }` → field `value: <T#0>`); `tp_setup` advances
    // past `>` (or no-ops, leaving the cursor at `{`).
    tp_setup(c, k, s, e, src, &mut cur);
    cur = cur + 1;                 // skip `{`
    scan_fields_loop(k, s, e, src, &mut cur, sid, c, gb);
    tp_reset(c)
}

fn scan_fields_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, sid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_fields_loop(k, s, e, src, cur, sid, c, gb)
    } else {
        let fnm_s: i64 = (*s)[*cur];
        let fnm_e: i64 = (*e)[*cur];
        *cur = *cur + 1;           // skip name
        *cur = *cur + 1;           // skip `:`
        let fte: TypeE = parse_type(k, s, e, src, cur);
        let fth: i64 = type_of_typeexpr(c, fte, gb);
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = fnm_s;
        while bi < fnm_e {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        push(&mut (*c).fldo, sid);
        push(&mut (*c).flds, bst);
        push(&mut (*c).flde, bst + (fnm_e - fnm_s));
        push(&mut (*c).fldty, fth);
        scan_fields_loop(k, s, e, src, cur, sid, c, gb)
    }
}

// (4e) emit an enum decl head from the enum + variant tables (UNCHANGED from
// resolve — payload types need no inference, but rendered from the interned
// handles): `(enum #eid Name (variant V <payload-types>…)…)`.
fn type_enum(out: &mut Vec<u8>, c: &mut TyCtx, eid: i64) -> i64 {
    append_str(out, "(enum #");
    append_int(out, eid);
    push(out, ' ');
    let ns: i64 = (*c).ets[eid];
    let ne: i64 = (*c).ete[eid];
    let mut bi: i64 = ns;
    while bi < ne {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    let nv: i64 = len((*c).varo);
    let mut i: i64 = 0;
    while i < nv {
        if (*c).varo[i] == eid {
            append_str(out, " (variant ");
            let vs: i64 = (*c).varns[i];
            let ve: i64 = (*c).varne[i];
            let mut vi2: i64 = vs;
            while vi2 < ve {
                push(out, (*c).snb[vi2]);
                vi2 = vi2 + 1;
            }
            let ps: i64 = (*c).varps[i];
            let pe: i64 = (*c).varpe[i];
            let mut pj: i64 = ps;
            while pj < pe {
                push(out, ' ');
                let ph: i64 = (*c).varpay[pj];
                render_type(out, ph, c);
                pj = pj + 1;
            }
            push(out, ')');
            0
        } else {
            0
        };
        i = i + 1;
    }
    push(out, ')');
    0
}

// PASS-1.5 enum-variant scan: record each variant `(EnumId, name, payload-type
// slice)` into the variant table (payload types interned into `varpay`). Runs after
// ALL decl NAMES are registered (pass 1), so a payload type referencing any
// struct/enum resolves.
fn scan_enum_variants(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;     // at name
    cur = cur + 1;                 // skip name
    cur = cur + 1;                 // skip `{` (enums are non-generic)
    scan_evar_loop(k, s, e, src, &mut cur, eid, c, gb)
}

fn scan_evar_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_evar_loop(k, s, e, src, cur, eid, c, gb)
    } else {
        let vn_s: i64 = (*s)[*cur];
        let vn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;           // skip variant name
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = vn_s;
        while bi < vn_e {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        let pst: i64 = len((*c).varpay);
        if (*k)[*cur] == 4 {
            *cur = *cur + 1;       // skip `(`
            scan_payloads(k, s, e, src, cur, c, gb);
            0
        } else {
            0
        };
        let pen: i64 = len((*c).varpay);
        push(&mut (*c).varo, eid);
        push(&mut (*c).varns, bst);
        push(&mut (*c).varne, bst + (vn_e - vn_s));
        push(&mut (*c).varps, pst);
        push(&mut (*c).varpe, pen);
        scan_evar_loop(k, s, e, src, cur, eid, c, gb)
    }
}

// Parse + intern a variant's positional payload types into `varpay`. Ends past `)`.
fn scan_payloads(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_payloads(k, s, e, src, cur, c, gb)
    } else {
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pth: i64 = type_of_typeexpr(c, pte, gb);
        push(&mut (*c).varpay, pth);
        scan_payloads(k, s, e, src, cur, c, gb)
    }
}

// --- (4f) class decl scanning + emit ---------------------------------------

// `init` is lexed as a plain ident; detect it by its 4 bytes (mirror resolve).
fn is_init_slice(src: &[u8], st: i64, en: i64) -> bool {
    if en - st != 4 {
        false
    } else {
        ((*src)[st] == 'i') && ((*src)[st + 1] == 'n') && ((*src)[st + 2] == 'i') && ((*src)[st + 3] == 't')
    }
}

// Parse a `self: &Self` / `self: &mut Self` receiver from `(` (cursor at `self`);
// return whether it is `&mut` (exclusive). Advances past `Self`.
fn tparse_self_kind(k: &Vec<i64>, cur: &mut i64) -> bool {
    *cur = *cur + 1;             // skip `self`
    *cur = *cur + 1;             // skip `:`
    *cur = *cur + 1;             // skip `&`
    let excl: bool = (*k)[*cur] == 46;
    if excl {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;             // skip `Self`
    excl
}

// Skip a `( … )` list (no nested parens in Sentinel param/type syntax). Cursor at `(`.
fn skip_paren_list(k: &Vec<i64>, cur: &mut i64) -> i64 {
    *cur = *cur + 1;             // skip `(`
    while (*k)[*cur] != 5 {
        *cur = *cur + 1;
    }
    *cur = *cur + 1;             // skip `)`
    0
}

// Skip a `{ … }` brace-balanced block. Cursor at `{`.
fn skip_brace_block(k: &Vec<i64>, cur: &mut i64) -> i64 {
    *cur = *cur + 1;             // skip `{`
    let mut depth: i64 = 1;
    while depth > 0 {
        let t: i64 = (*k)[*cur];
        if t == 6 {
            depth = depth + 1;
            0
        } else if t == 7 {
            depth = depth - 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;
    }
    0
}

// Skip to past the next `;` (kind 44) — a delegate decl (synthesis is 4f-delegate).
fn skip_to_semi(k: &Vec<i64>, cur: &mut i64) -> i64 {
    while (*k)[*cur] != 44 {
        *cur = *cur + 1;
    }
    *cur = *cur + 1;
    0
}

// PASS-1.5 class-field scan: record `(ClassId, name, type)` into the class-field
// table. Cursor at `let`.
fn scan_cfield(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `let`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `;`
    let bst: i64 = len((*c).snb);
    let mut bi: i64 = fn_s;
    while bi < fn_e {
        push(&mut (*c).snb, (*src)[bi]);
        bi = bi + 1;
    }
    push(&mut (*c).clfo, cid);
    push(&mut (*c).clfs, bst);
    push(&mut (*c).clfe, bst + (fn_e - fn_s));
    push(&mut (*c).clft, fth);
    0
}

// PASS-1.5 class-method scan: record `(ClassId, name, return-type)` + SKIP the body.
// Cursor at `fn`.
fn scan_cmethod(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    skip_paren_list(k, cur);     // skip `( self… params )`
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let bst: i64 = len((*c).snb);
    let mut bi: i64 = mn_s;
    while bi < mn_e {
        push(&mut (*c).snb, (*src)[bi]);
        bi = bi + 1;
    }
    push(&mut (*c).clmo, cid);
    push(&mut (*c).clms, bst);
    push(&mut (*c).clme, bst + (mn_e - mn_s));
    push(&mut (*c).clmr, mrth);
    skip_brace_block(k, cur);    // skip the method body
    0
}

// PASS-1.5 delegate scan: `delegate name : T to Trait ;` records a delegate record
// driving the synthesised forwarding impl (group D). ⚠ (4i) the class FIELD + its
// index (`dgfx`) are NOT registered here — they are APPENDED after `scan_cmem_loop`
// (`register_delegate_fields`), so the delegate field comes AFTER all regular fields
// regardless of source order (the oracle buckets regular fields first, delegates
// last — c4_go_no_go declares `delegate` BEFORE a `let`). dgfx therefore lags dgcid
// until that post-pass (nothing reads it until pass 2's synthesis).
fn scan_cdelegate(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `delegate`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip field name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `to`
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip trait name
    *cur = *cur + 1;             // skip `;`
    push(&mut (*c).dgcid, cid);
    push(&mut (*c).dgfs, fn_s);
    push(&mut (*c).dgfe, fn_e);
    push(&mut (*c).dgft, fth);
    push(&mut (*c).dgts, tr_s);
    push(&mut (*c).dgte, tr_e);
    0
}

// (4i) Append the delegate fields for delegate records `[dg0, dg1)` (the ones added
// by THIS class's `scan_cmem_loop`) to the class-field table — AFTER all its regular
// `let` fields — and push each field's index into `dgfx` (which stayed aligned with
// `dgcid` across classes, since each class appends its delegate fields contiguously).
fn register_delegate_fields(c: &mut TyCtx, src: &[u8], cid: i64, dg0: i64, dg1: i64) -> i64 {
    let mut di: i64 = dg0;
    while di < dg1 {
        let dfs: i64 = (*c).dgfs[di];
        let dfe: i64 = (*c).dgfe[di];
        let dft: i64 = (*c).dgft[di];
        // the field index = the current count of fields already registered for `cid`.
        let nf: i64 = len((*c).clfo);
        let mut fi: i64 = 0;
        let mut fcount: i64 = 0;
        while fi < nf {
            if (*c).clfo[fi] == cid {
                fcount = fcount + 1;
                0
            } else {
                0
            };
            fi = fi + 1;
        }
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = dfs;
        while bi < dfe {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        push(&mut (*c).clfo, cid);
        push(&mut (*c).clfs, bst);
        push(&mut (*c).clfe, bst + (dfe - dfs));
        push(&mut (*c).clft, dft);
        push(&mut (*c).dgfx, fcount);
        di = di + 1;
    }
    0
}

fn scan_class_members(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `class`
    cur = cur + 1;               // skip name
    cur = cur + 1;               // skip `{`
    // (4i) scan regular fields/methods/init + record delegate metadata, THEN append the
    // delegate fields after all regular fields (the oracle's field order).
    let dg0: i64 = len((*c).dgcid);
    scan_cmem_loop(k, s, e, src, &mut cur, cid, c, gb);
    let dg1: i64 = len((*c).dgcid);
    register_delegate_fields(c, src, cid, dg0, dg1)
}

fn scan_cmem_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;         // skip a per-item `pub`
        0
    } else {
        0
    };
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 45 {
        scan_cfield(k, s, e, src, cur, cid, c, gb);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    } else if t == 3 {
        scan_cmethod(k, s, e, src, cur, cid, c, gb);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    } else if is_init_slice(src, (*s)[*cur], (*e)[*cur]) {
        *cur = *cur + 1;         // skip `init`
        skip_paren_list(k, cur);
        skip_brace_block(k, cur);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    } else {
        scan_cdelegate(k, s, e, src, cur, cid, c, gb);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    }
}

// (4f) emit a class field head: ` (field name <type>)`. Cursor at `let`.
fn tclass_field(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `let`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `;`
    append_str(buf, " (field ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    render_type(buf, fth, c);
    push(buf, ')');
    0
}

// (4f) emit + type a class init: ` (init #selfvid (params) <typed-body>)`. The init's
// `self` is SYNTHETIC (no receiver token) → bind the literal `self`, typed as the
// class. Cursor at `init`.
fn tclass_init(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    (*c).base = len((*c).scs);
    *cur = *cur + 1;             // skip `init`
    *cur = *cur + 1;             // skip `(`
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let clty: i64 = mk_class(c, cid);
    bind_name(c, "self", selfvid, clty);
    append_str(buf, " (init #");
    append_int(buf, selfvid);
    append_str(buf, " (");
    emit_tparams(buf, k, s, e, src, cur, c, gb, true);
    append_str(buf, ") ");
    let ibody: Expr = parse_block(k, s, e, src, cur);
    dump_texpr(buf, ibody, 0 - 1, src, c, gb);
    push(buf, ')');
    0
}

// (4f) emit + type a class/impl method: ` (method #selfvid name <kind> (params) ret
// <typed-body>)`. `self` is the receiver token, typed as the owning class. Cursor at
// `fn`. The body's expectation is the return type (so a `?T`/secret method widens).
fn tmethod(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    (*c).base = len((*c).scs);
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `(`
    let self_s: i64 = (*s)[*cur];
    let self_e: i64 = (*e)[*cur];
    let excl: bool = tparse_self_kind(k, cur);
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let clty: i64 = mk_class(c, cid);
    bind_src(c, src, self_s, self_e, selfvid, clty);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(buf, " (method #");
    append_int(buf, selfvid);
    push(buf, ' ');
    append_slice(buf, src, mn_s, mn_e);
    push(buf, ' ');
    append_str(buf, skw);
    append_str(buf, " (");
    emit_tparams(buf, k, s, e, src, cur, c, gb, true);
    append_str(buf, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let mbody: Expr = parse_block(k, s, e, src, cur);
    render_type(buf, mrth, c);
    push(buf, ' ');
    dump_texpr(buf, mbody, mrth, src, c, gb);
    push(buf, ')');
    0
}

// (4f-delegate) emit a delegate's class FIELD ` (field name <type>)` (into the
// delegate-field bucket — after explicit fields). Cursor at `delegate`.
fn tclass_delegate_field(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `delegate`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `to`
    *cur = *cur + 1;             // skip trait name
    *cur = *cur + 1;             // skip `;`
    append_str(buf, " (field ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    render_type(buf, fth, c);
    push(buf, ')');
    0
}

// (4f) walk a class body, BUCKETING items into fields / delegate-fields / init /
// methods buffers (mirror resolve / the parser — the dump emits explicit fields,
// then delegate fields, then init, then methods).
fn tclass_items(fbuf: &mut Vec<u8>, dfbuf: &mut Vec<u8>, ibuf: &mut Vec<u8>, mbuf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 45 {
        tclass_field(fbuf, k, s, e, src, cur, c, gb);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else if t == 3 {
        tmethod(mbuf, k, s, e, src, cur, c, gb, cid);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else if is_init_slice(src, (*s)[*cur], (*e)[*cur]) {
        tclass_init(ibuf, k, s, e, src, cur, c, gb, cid);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else {
        tclass_delegate_field(dfbuf, k, s, e, src, cur, c, gb);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    }
}

// (4f) emit a class decl head `(class #cid Name (field …) (init …)? (method …)…)`.
fn type_class(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    *cur = *cur + 1;             // skip `class`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `{`
    let mut fbuf: Vec<u8> = vec_new();
    let mut dfbuf: Vec<u8> = vec_new();
    let mut ibuf: Vec<u8> = vec_new();
    let mut mbuf: Vec<u8> = vec_new();
    tclass_items(&mut fbuf, &mut dfbuf, &mut ibuf, &mut mbuf, k, s, e, src, cur, c, gb, cid);
    append_str(out, "(class #");
    append_int(out, cid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    append_str(out, vec_to_array(fbuf));
    append_str(out, vec_to_array(dfbuf));
    append_str(out, vec_to_array(ibuf));
    append_str(out, vec_to_array(mbuf));
    push(out, ')');
    0
}

// --- (4f) trait + impl decl scanning + emit --------------------------------

// Compare a `src` slice [ss,se) to an `snb` slice [bs,be).
fn src_eq_snb(c: &mut TyCtx, bs: i64, be: i64, src: &[u8], ss: i64, se: i64) -> bool {
    if be - bs != se - ss {
        false
    } else {
        let n: i64 = be - bs;
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < n {
            if (*c).snb[bs + i] != (*src)[ss + i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Resolve a `src` slice to a TraitId / ClassId, or -1.
fn trait_lookup_slice(c: &mut TyCtx, src: &[u8], ss: i64, se: i64) -> i64 {
    let n: i64 = len((*c).trns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if src_eq_snb(c, (*c).trns[i], (*c).trne[i], src, ss, se) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

fn class_lookup_slice(c: &mut TyCtx, src: &[u8], ss: i64, se: i64) -> i64 {
    let n: i64 = len((*c).clns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if src_eq_snb(c, (*c).clns[i], (*c).clne[i], src, ss, se) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// PASS-1.5 trait-method scan: record `(TraitId, name, return-type)` into the
// trait-method table (sigs only — no bodies/VarIds).
fn scan_trait_methods(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, tid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `trait`
    cur = cur + 1;               // skip name
    cur = cur + 1;               // skip `{`
    scan_trm_loop(k, s, e, src, &mut cur, tid, c, gb)
}

fn scan_trm_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, tid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else {
        *cur = *cur + 1;         // skip `fn`
        let mn_s: i64 = (*s)[*cur];
        let mn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;         // skip name
        skip_paren_list(k, cur);
        *cur = *cur + 1;         // skip `->`
        let mret: TypeE = parse_type(k, s, e, src, cur);
        let mrth: i64 = type_of_typeexpr(c, mret, gb);
        if (*k)[*cur] == 24 {
            skip_effect_row(k, cur)
        } else {
            0
        };
        *cur = *cur + 1;         // skip `;`
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = mn_s;
        while bi < mn_e {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        push(&mut (*c).trmo, tid);
        push(&mut (*c).trms, bst);
        push(&mut (*c).trme, bst + (mn_e - mn_s));
        push(&mut (*c).trmr, mrth);
        scan_trm_loop(k, s, e, src, cur, tid, c, gb)
    }
}

// PASS-1.5 impl-header scan: resolve the impl's trait + target class, push into the
// impl table (aligned by ImplId with the pass-1 name registration). The header is
// `impl [Name as]? Trait for Type {`.
fn scan_impl_header(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, c: &mut TyCtx) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `impl`
    if (*k)[cur] != 60 {
        cur = cur + 1;           // skip the impl name (present unless next is `as`)
        0
    } else {
        0
    };
    cur = cur + 1;               // skip `as`
    let tr_s: i64 = (*s)[cur];
    let tr_e: i64 = (*e)[cur];
    cur = cur + 1;               // trait name
    cur = cur + 1;               // skip `for`
    let ty_s: i64 = (*s)[cur];
    let ty_e: i64 = (*e)[cur];
    let tid: i64 = trait_lookup_slice(c, src, tr_s, tr_e);
    let cid: i64 = class_lookup_slice(c, src, ty_s, ty_e);
    push(&mut (*c).imtid, tid);
    push(&mut (*c).imcid, cid);
    0
}

// (4f) trait-method sig params: ` (param [mut] name <type>)…` — NO VarIds (sigs).
fn emit_trait_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_trait_params(out, k, s, e, src, cur, c, gb, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;         // skip `:`
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pth: i64 = type_of_typeexpr(c, pte, gb);
        append_str(out, "(param ");
        if pm {
            append_str(out, "mut ")
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        render_type(out, pth, c);
        push(out, ')');
        emit_trait_params(out, k, s, e, src, cur, c, gb, false)
    }
}

// (4f) one trait method sig head: ` (method name <kind> (params) ret`. Cursor at `fn`.
fn ttrait_method_head(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `(`
    let excl: bool = tparse_self_kind(k, cur);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(out, " (method ");
    append_slice(out, src, mn_s, mn_e);
    push(out, ' ');
    append_str(out, skw);
    append_str(out, " (");
    emit_trait_params(out, k, s, e, src, cur, c, gb, true);
    append_str(out, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    render_type(out, mrth, c);
    0
}

fn ttrait_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else {
        ttrait_method_head(out, k, s, e, src, cur, c, gb);
        *cur = *cur + 1;         // skip `;`
        push(out, ')');
        ttrait_methods(out, k, s, e, src, cur, c, gb)
    }
}

// (4f) emit a trait decl head `(trait #tid Name (method name kind (params) ret)…)`.
fn type_trait(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, tid: i64) -> i64 {
    *cur = *cur + 1;             // skip `trait`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `{`
    append_str(out, "(trait #");
    append_int(out, tid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    ttrait_methods(out, k, s, e, src, cur, c, gb);
    push(out, ')');
    0
}

// (4f) impl methods: each reuses `tmethod` (self typed as the impl's class). The
// per-method `pub` is skipped.
fn timpl_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 59 {
        *cur = *cur + 1;         // skip a per-method `pub`
        timpl_methods(out, k, s, e, src, cur, c, gb, cid)
    } else {
        tmethod(out, k, s, e, src, cur, c, gb, cid);
        timpl_methods(out, k, s, e, src, cur, c, gb, cid)
    }
}

// (4f) emit an impl decl head `(impl #iid name #tid Trait class#cid Type (method …)…)`
// with TYPED method bodies. The trait + class were resolved in pass-1.5 (`imtid`/
// `imcid`). The header is `impl [Name as]? Trait for Type {`.
fn type_impl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, iid: i64) -> i64 {
    *cur = *cur + 1;             // skip `impl`
    let has_name: bool = (*k)[*cur] != 60;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    if has_name {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;             // skip `as`
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // trait name
    *cur = *cur + 1;             // skip `for`
    let ty_s: i64 = (*s)[*cur];
    let ty_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // type name
    *cur = *cur + 1;             // skip `{`
    let tid: i64 = (*c).imtid[iid];
    let cid: i64 = (*c).imcid[iid];
    append_str(out, "(impl #");
    append_int(out, iid);
    push(out, ' ');
    if has_name {
        append_slice(out, src, nm_s, nm_e);
        0
    } else {
        push(out, '_');
        0
    };
    push(out, ' ');
    push(out, '#');
    append_int(out, tid);
    push(out, ' ');
    append_slice(out, src, tr_s, tr_e);
    append_str(out, " class#");
    append_int(out, cid);
    push(out, ' ');
    append_slice(out, src, ty_s, ty_e);
    timpl_methods(out, k, s, e, src, cur, c, gb, cid);
    push(out, ')');
    0
}

// --- (4f-delegate) forwarding-impl synthesis (ADR 0040 A12) -----------------
// `class C { delegate f: T to Tr; }` synthesises `impl _ as Tr for C` whose every
// method (from Tr's sigs) is `fn m(self,p…) { self.f.m(p…) }` — a method-dispatch on
// the delegate field. The body is SYNTHESISED (no source), emitted directly.

// The forwarding receiver `(field (var #selfvid :Class) name fidx :FieldType)`.
fn synth_receiver(buf: &mut Vec<u8>, c: &mut TyCtx, clty: i64, selfvid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64, src: &[u8]) -> i64 {
    append_str(buf, "(field (var #");
    append_int(buf, selfvid);
    append_str(buf, " :");
    render_type(buf, clty, c);
    append_str(buf, ") ");
    append_slice(buf, src, fld_s, fld_e);
    push(buf, ' ');
    append_int(buf, fidx);
    append_str(buf, " :");
    render_type(buf, fty, c);
    push(buf, ')');
    0
}

// The forwarding args ` (var #pvid :ptype)…` (the synth method's params, by VarId).
fn synth_args(buf: &mut Vec<u8>, c: &mut TyCtx, pv0: i64, pvn: i64) -> i64 {
    let mut pv: i64 = pv0;
    while pv < pvn {
        let pty: i64 = env_get(c, pv);
        append_str(buf, " (var #");
        append_int(buf, pv);
        append_str(buf, " :");
        render_type(buf, pty, c);
        push(buf, ')');
        pv = pv + 1;
    }
    0
}

// The forwarding body: a method-dispatch of `m` on `self.field` (the SAME split as a
// real method call — the field's class's own method vs a default-impl method).
fn synth_forward(buf: &mut Vec<u8>, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64, selfvid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64, mn_s: i64, mn_e: i64, src: &[u8], pv0: i64, pvn: i64, mrth: i64) -> i64 {
    // build the method name as a `[u8]` for the dispatch lookups, then sink it.
    let mut mnbuf: Vec<u8> = vec_new();
    let mut mi: i64 = mn_s;
    while mi < mn_e {
        push(&mut mnbuf, (*src)[mi]);
        mi = mi + 1;
    }
    let mn_arr: [u8] = vec_to_array(mnbuf);
    let rcid: i64 = class_of_handle(c, strip_ref(c, fty));
    let own: bool = class_has_method(c, rcid, &mn_arr);
    let oidx: i64 = if own {
        class_method_index(c, rcid, &mn_arr)
    } else {
        0 - 1
    };
    let iid: i64 = if own {
        0 - 1
    } else {
        impl_for_class(c, rcid, &mn_arr)
    };
    let itid: i64 = impl_trait_of(c, iid);
    let iidx: i64 = if own {
        0 - 1
    } else {
        trait_method_index(c, itid, &mn_arr)
    };
    sink_name(gb, mn_arr);
    let clty: i64 = mk_class(c, cid);
    if own {
        append_str(buf, "(method #");
        append_int(buf, rcid);
        push(buf, ' ');
        append_int(buf, oidx);
        push(buf, ' ');
        synth_receiver(buf, c, clty, selfvid, fld_s, fld_e, fidx, fty, src);
        push(buf, ' ');
        append_slice(buf, src, mn_s, mn_e);
        synth_args(buf, c, pv0, pvn);
        append_str(buf, " :");
        render_type(buf, mrth, c);
        push(buf, ')');
        0
    } else {
        append_str(buf, "(impl-method #");
        append_int(buf, iid);
        push(buf, ' ');
        append_int(buf, iidx);
        push(buf, ' ');
        synth_receiver(buf, c, clty, selfvid, fld_s, fld_e, fidx, fty, src);
        push(buf, ' ');
        append_slice(buf, src, mn_s, mn_e);
        synth_args(buf, c, pv0, pvn);
        append_str(buf, " :");
        render_type(buf, mrth, c);
        push(buf, ')');
        0
    }
}

// One synthesised forwarding method (from a trait method SIG; cursor at `fn`): the
// `self` (synthetic, typed as the delegating class) + params get fresh VarIds; the
// body forwards to `self.field.m(params)`.
fn synth_one_method(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64) -> i64 {
    (*c).base = len((*c).scs);
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `(`
    let excl: bool = tparse_self_kind(k, cur);
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let clty: i64 = mk_class(c, cid);
    bind_name(c, "self", selfvid, clty);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(buf, " (method #");
    append_int(buf, selfvid);
    push(buf, ' ');
    append_slice(buf, src, mn_s, mn_e);
    push(buf, ' ');
    append_str(buf, skw);
    append_str(buf, " (");
    let pv0: i64 = (*c).nextvid;
    emit_tparams(buf, k, s, e, src, cur, c, gb, true);
    let pvn: i64 = (*c).nextvid;
    append_str(buf, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    render_type(buf, mrth, c);
    append_str(buf, " (block ");
    synth_forward(buf, c, gb, cid, selfvid, fld_s, fld_e, fidx, fty, mn_s, mn_e, src, pv0, pvn, mrth);
    append_str(buf, " :");
    render_type(buf, mrth, c);
    push(buf, ')');             // close block
    push(buf, ')');             // close method
    0
}

fn synth_methods(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        0
    } else {
        synth_one_method(buf, k, s, e, src, cur, c, gb, cid, fld_s, fld_e, fidx, fty);
        *cur = *cur + 1;         // skip `;`
        synth_methods(buf, k, s, e, src, cur, c, gb, cid, fld_s, fld_e, fidx, fty)
    }
}

// (4f-delegate) synthesise `(impl #iid _ #tid Trait class#cid Class (method …)…)` for
// the `didx`-th delegate — re-walk the trait's method sigs, forwarding each.
fn synth_delegate_impl(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, didx: i64, iid: i64) -> i64 {
    let cid: i64 = (*c).dgcid[didx];
    let trt_s: i64 = (*c).dgts[didx];
    let trt_e: i64 = (*c).dgte[didx];
    let fld_s: i64 = (*c).dgfs[didx];
    let fld_e: i64 = (*c).dgfe[didx];
    let fidx: i64 = (*c).dgfx[didx];
    let fty: i64 = (*c).dgft[didx];
    let tid: i64 = trait_lookup_slice(c, src, trt_s, trt_e);
    append_str(buf, "(impl #");
    append_int(buf, iid);
    append_str(buf, " _ #");
    append_int(buf, tid);
    push(buf, ' ');
    append_slice(buf, src, trt_s, trt_e);
    append_str(buf, " class#");
    append_int(buf, cid);
    push(buf, ' ');
    let cn_s: i64 = (*c).clns[cid];
    let cn_e: i64 = (*c).clne[cid];
    let mut ci: i64 = cn_s;
    while ci < cn_e {
        push(buf, (*c).snb[ci]);
        ci = ci + 1;
    }
    let tpos: i64 = (*c).trpos[tid];
    let mut tcur: i64 = tpos + 1;   // skip `trait`
    tcur = tcur + 1;                // skip name
    tcur = tcur + 1;                // skip `{`
    synth_methods(buf, k, s, e, src, &mut tcur, c, gb, cid, fld_s, fld_e, fidx, fty);
    push(buf, ')');
    0
}

// --- (4g) effect decl scanning + emit --------------------------------------

// PASS-1.5: scan an effect's op params (counting them into `voff` — they consume
// global VarIds before any fn body, ADR 0020 — + disposing their types). Cursor at `(`.
fn scan_op_params(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `(`
    scan_opp_loop(k, s, e, src, cur, c, gb)
}

fn scan_opp_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_opp_loop(k, s, e, src, cur, c, gb)
    } else {
        if (*k)[*cur] == 46 {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;         // skip name
        *cur = *cur + 1;         // skip `:`
        let pte: TypeE = parse_type(k, s, e, src, cur);
        type_of_typeexpr(c, pte, gb);
        (*c).voff = (*c).voff + 1;
        scan_opp_loop(k, s, e, src, cur, c, gb)
    }
}

// PASS-1.5 effect-op scan: record each op `(EffectId, name, return-type)` into the
// op table + count its params into `voff`.
fn scan_effect_ops(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `effect`
    cur = cur + 1;               // skip name
    cur = cur + 1;               // skip `{`
    scan_eop_loop(k, s, e, src, &mut cur, eid, c, gb)
}

fn scan_eop_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        scan_eop_loop(k, s, e, src, cur, eid, c, gb)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;         // skip op name
        scan_op_params(k, s, e, src, cur, c, gb);
        let rth: i64 = if (*k)[*cur] == 8 {
            *cur = *cur + 1;     // skip `->`
            let rt: TypeE = parse_type(k, s, e, src, cur);
            type_of_typeexpr(c, rt, gb)
        } else {
            0
        };
        push(&mut (*c).efoo, eid);
        push(&mut (*c).efos, on_s);
        push(&mut (*c).efoe, on_e);
        push(&mut (*c).efor, rth);
        scan_eop_loop(k, s, e, src, cur, eid, c, gb)
    }
}

// (4g) effect op heads: ` (op name (params) ret)…` (op params reuse the no-VarId
// trait-param emitter). Cursor at the first op (after the body `{`).
fn teffect_ops(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        teffect_ops(out, k, s, e, src, cur, c, gb)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;         // skip op name
        *cur = *cur + 1;         // skip `(`
        append_str(out, " (op ");
        append_slice(out, src, on_s, on_e);
        append_str(out, " (");
        emit_trait_params(out, k, s, e, src, cur, c, gb, true);
        append_str(out, ") ");
        if (*k)[*cur] == 8 {
            *cur = *cur + 1;     // skip `->`
            let rt: TypeE = parse_type(k, s, e, src, cur);
            let rth: i64 = type_of_typeexpr(c, rt, gb);
            render_type(out, rth, c);
            0
        } else {
            push(out, '_');
            0
        };
        push(out, ')');
        teffect_ops(out, k, s, e, src, cur, c, gb)
    }
}

// (4g) emit an effect decl head `(effect #eid Name (op name (params) ret)…)`.
fn type_effect(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, eid: i64) -> i64 {
    *cur = *cur + 1;             // skip `effect`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `{`
    append_str(out, "(effect #");
    append_int(out, eid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    teffect_ops(out, k, s, e, src, cur, c, gb);
    push(out, ')');
    0
}

// Dispatch one top-level item on its kind (a SINGLE helper re-passing the `&mut`
// PARAMS — main's local `&mut out`/`&mut ctx` would conflict across sibling-if
// tails, ADR 0038 A2). `idx` = the fn index (FnId-14) or the StructId.
fn type_item(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, kind: i64, pos: i64, idx: i64) -> i64 {
    if kind == 3 {
        let mut cur: i64 = pos;
        type_fn(out, k, s, e, src, &mut cur, c, gb, idx)
    } else if kind == 52 {
        type_struct(out, c, idx)
    } else if kind == 53 {
        type_enum(out, c, idx)
    } else if kind == 56 {
        let mut curc: i64 = pos;
        type_class(out, k, s, e, src, &mut curc, c, gb, idx)
    } else if kind == 54 {
        let mut curt: i64 = pos;
        type_trait(out, k, s, e, src, &mut curt, c, gb, idx)
    } else if kind == 55 {
        let mut curi: i64 = pos;
        type_impl(out, k, s, e, src, &mut curi, c, gb, idx)
    } else if kind == 57 {
        let mut cure: i64 = pos;
        type_effect(out, k, s, e, src, &mut cure, c, gb, idx)
    } else {
        0
    }
}

// (6/N) the shared build pipeline (ADR 0043 D3 reuse): parse → resolve → type-check
// the whole program, computing the typed dump + the moved-sources side-table. `mode`
// 0 → write the `snc types` dump to `result`; mode 1 → write the `snc borrow`
// moved-sources dump (reused by `selfhost/borrow.sentinel`). `src` is consumed.
pub fn run(src: [u8], mode: i64, result: &mut Vec<u8>) -> i64 {
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);

    let mut ctx: TyCtx = TyCtx {
        tk: vec_new(),
        ta: vec_new(),
        tb: vec_new(),
        env: vec_new(),
        nb: vec_new(),
        scs: vec_new(),
        sce: vec_new(),
        scv: vec_new(),
        base: 0,
        nextvid: 0,
        ufs: vec_new(),
        ufe: vec_new(),
        ufret: vec_new(),
        snb: vec_new(),
        sts: vec_new(),
        ste: vec_new(),
        fldo: vec_new(),
        flds: vec_new(),
        flde: vec_new(),
        fldty: vec_new(),
        ets: vec_new(),
        ete: vec_new(),
        varo: vec_new(),
        varns: vec_new(),
        varne: vec_new(),
        varps: vec_new(),
        varpe: vec_new(),
        varpay: vec_new(),
        clns: vec_new(),
        clne: vec_new(),
        clfo: vec_new(),
        clfs: vec_new(),
        clfe: vec_new(),
        clft: vec_new(),
        clmo: vec_new(),
        clms: vec_new(),
        clme: vec_new(),
        clmr: vec_new(),
        trns: vec_new(),
        trne: vec_new(),
        trmo: vec_new(),
        trms: vec_new(),
        trme: vec_new(),
        trmr: vec_new(),
        imns: vec_new(),
        imne: vec_new(),
        imtid: vec_new(),
        imcid: vec_new(),
        trpos: vec_new(),
        dgcid: vec_new(),
        dgfs: vec_new(),
        dgfe: vec_new(),
        dgfx: vec_new(),
        dgft: vec_new(),
        dgts: vec_new(),
        dgte: vec_new(),
        efs: vec_new(),
        efe: vec_new(),
        efoo: vec_new(),
        efos: vec_new(),
        efoe: vec_new(),
        efor: vec_new(),
        voff: 0,
        tpb: vec_new(),
        tpns: vec_new(),
        tpne: vec_new(),
        uftp: vec_new(),
        ufps: vec_new(),
        ufpe: vec_new(),
        ufpp: vec_new(),
        gia: vec_new(),
        girs: vec_new(),
        gire: vec_new(),
        consuming: false,
        curfn: 0 - 1,
        mvf: vec_new(),
        mvv: vec_new(),
        mode: mode,
        lastval: 0 - 1,
        mir_cur: 0,
        mir_nblk: 0,
        mvty: vec_new(),
        miblk: vec_new(),
        midst: vec_new(),
        miop: vec_new(),
        misym: vec_new(),
        mia: vec_new(),
        mib: vec_new(),
        mbpb: vec_new(),
        mbpv: vec_new(),
        mtb: vec_new(),
        mtk: vec_new(),
        mta: vec_new(),
        mtt: vec_new(),
        mte: vec_new(),
        mtjs: vec_new(),
        mtje: vec_new(),
        mtj: vec_new(),
        mvdv: vec_new(),
        mvdl: vec_new(),
        mir_lastvid: 0 - 1,
        mirout: vec_new(),
    };
    let mut garbage: Vec<u8> = vec_new();
    let mut out: Vec<u8> = vec_new();

    // Pass 1: brace-depth scan. Record top-level item NAMES only — `fn` (FnId 14+,
    // names in `ufs`/`ufe`) + `struct` (StructId, names copied into `snb`/`sts`/`ste`)
    // — in source order (`itempos`/`itemkind`); count user effects. NAMES first so
    // pass-1.5 field/return types (which may reference any struct) all resolve.
    let mut depth: i64 = 0;
    let mut ecount: i64 = 0;
    let mut itempos: Vec<i64> = vec_new();
    let mut itemkind: Vec<i64> = vec_new();
    let mut p1: i64 = 0;
    while p1 < ntok {
        let t1: i64 = kinds[p1];
        if t1 == 6 {
            depth = depth + 1;
            0
        } else if t1 == 7 {
            depth = depth - 1;
            0
        } else if depth == 0 {
            if t1 == 3 {
                push(&mut itempos, p1);
                push(&mut itemkind, 3);
                push(&mut ctx.ufs, starts[p1 + 1]);
                push(&mut ctx.ufe, ends[p1 + 1]);
                0
            } else if t1 == 52 {
                push(&mut itempos, p1);
                push(&mut itemkind, 52);
                let nss: i64 = starts[p1 + 1];
                let nen: i64 = ends[p1 + 1];
                let nst: i64 = len(ctx.snb);
                let mut nbi: i64 = nss;
                while nbi < nen {
                    push(&mut ctx.snb, src[nbi]);
                    nbi = nbi + 1;
                }
                push(&mut ctx.sts, nst);
                push(&mut ctx.ste, nst + (nen - nss));
                0
            } else if t1 == 53 {
                push(&mut itempos, p1);
                push(&mut itemkind, 53);
                let ess: i64 = starts[p1 + 1];
                let een: i64 = ends[p1 + 1];
                let est: i64 = len(ctx.snb);
                let mut ebi: i64 = ess;
                while ebi < een {
                    push(&mut ctx.snb, src[ebi]);
                    ebi = ebi + 1;
                }
                push(&mut ctx.ets, est);
                push(&mut ctx.ete, est + (een - ess));
                0
            } else if t1 == 56 {
                push(&mut itempos, p1);
                push(&mut itemkind, 56);
                let css: i64 = starts[p1 + 1];
                let cen: i64 = ends[p1 + 1];
                let cst: i64 = len(ctx.snb);
                let mut cbi: i64 = css;
                while cbi < cen {
                    push(&mut ctx.snb, src[cbi]);
                    cbi = cbi + 1;
                }
                push(&mut ctx.clns, cst);
                push(&mut ctx.clne, cst + (cen - css));
                0
            } else if t1 == 54 {
                push(&mut itempos, p1);
                push(&mut itemkind, 54);
                let tss: i64 = starts[p1 + 1];
                let ten: i64 = ends[p1 + 1];
                let tst: i64 = len(ctx.snb);
                let mut tbi: i64 = tss;
                while tbi < ten {
                    push(&mut ctx.snb, src[tbi]);
                    tbi = tbi + 1;
                }
                push(&mut ctx.trns, tst);
                push(&mut ctx.trne, tst + (ten - tss));
                push(&mut ctx.trpos, p1);
                0
            } else if t1 == 55 {
                push(&mut itempos, p1);
                push(&mut itemkind, 55);
                let hasn: bool = kinds[p1 + 1] != 60;
                let ist: i64 = len(ctx.snb);
                if hasn {
                    let iss: i64 = starts[p1 + 1];
                    let ien: i64 = ends[p1 + 1];
                    let mut ibi: i64 = iss;
                    while ibi < ien {
                        push(&mut ctx.snb, src[ibi]);
                        ibi = ibi + 1;
                    }
                    push(&mut ctx.imns, ist);
                    push(&mut ctx.imne, ist + (ien - iss));
                    0
                } else {
                    push(&mut ctx.imns, 0);
                    push(&mut ctx.imne, 0);
                    0
                };
                0
            } else if t1 == 57 {
                push(&mut itempos, p1);
                push(&mut itemkind, 57);
                push(&mut ctx.efs, starts[p1 + 1]);
                push(&mut ctx.efe, ends[p1 + 1]);
                ecount = ecount + 1;
                0
            } else {
                0
            }
        } else {
            0
        };
        p1 = p1 + 1;
    }

    // Pass 1.5: resolve fn return types (`ufret`, fn source order) + struct fields,
    // now that all top-level NAMES are registered.
    let ni: i64 = len(itempos);
    let mut q: i64 = 0;
    let mut sc2: i64 = 0;
    let mut ec2: i64 = 0;
    let mut cl2: i64 = 0;
    let mut tr2: i64 = 0;
    let mut ef2: i64 = 0;
    while q < ni {
        if itemkind[q] == 3 {
            scan_fn_sig(&kinds, &starts, &ends, &src, itempos[q], &mut ctx, &mut garbage);
            0
        } else if itemkind[q] == 52 {
            scan_struct_fields(&kinds, &starts, &ends, &src, itempos[q], sc2, &mut ctx, &mut garbage);
            sc2 = sc2 + 1;
            0
        } else if itemkind[q] == 53 {
            scan_enum_variants(&kinds, &starts, &ends, &src, itempos[q], ec2, &mut ctx, &mut garbage);
            ec2 = ec2 + 1;
            0
        } else if itemkind[q] == 56 {
            scan_class_members(&kinds, &starts, &ends, &src, itempos[q], cl2, &mut ctx, &mut garbage);
            cl2 = cl2 + 1;
            0
        } else if itemkind[q] == 54 {
            scan_trait_methods(&kinds, &starts, &ends, &src, itempos[q], tr2, &mut ctx, &mut garbage);
            tr2 = tr2 + 1;
            0
        } else if itemkind[q] == 55 {
            scan_impl_header(&kinds, &starts, &ends, &src, itempos[q], &mut ctx);
            0
        } else if itemkind[q] == 57 {
            scan_effect_ops(&kinds, &starts, &ends, &src, itempos[q], ef2, &mut ctx, &mut garbage);
            ef2 = ef2 + 1;
            0
        } else {
            0
        };
        q = q + 1;
    }

    // (4f-delegate) register the SYNTHESISED delegate impls (ImplId continues AFTER
    // all user impls; an unnamed `impl _` → a 0,0 name slot). Done before pass-2 so the
    // `l.write(…)` dispatch (group A) finds the synth impl via `impl_for_class`.
    let ndel: i64 = len(ctx.dgcid);
    let nuser: i64 = len(ctx.imns);
    let mut dr: i64 = 0;
    while dr < ndel {
        let dts: i64 = ctx.dgts[dr];
        let dte: i64 = ctx.dgte[dr];
        let dtid: i64 = trait_lookup_slice(&mut ctx, &src, dts, dte);
        let dcid: i64 = ctx.dgcid[dr];
        push(&mut ctx.imns, 0);
        push(&mut ctx.imne, 0);
        push(&mut ctx.imtid, dtid);
        push(&mut ctx.imcid, dcid);
        dr = dr + 1;
    }

    // Pass 2 — GROUP-ORDER emit (mirrors resolve / the Rust resolver: ALL fn bodies'
    // VarIds, THEN class bodies', THEN impl bodies' — lib.rs:2559 — but the DUMP is
    // SOURCE order). Each item is typed into the shared `itembuf` in GROUP order,
    // tagged with its source index (`rsrc`) + blob slice (`rbs`/`rbe`); then emitted
    // source-order. Group A = fns + structs + enums + traits + effects (fns advance
    // `nextvid`, the rest consume none); group B = classes; group C = impls. ⚠ the fn
    // region starts at `voff` (the Rust resolver assigns effect-op-param VarIds before
    // any fn body — ADR 0020), so every fn's VarIds are offset by the op-param count.
    // The env is VarId-indexed + append-only, so fill it with `voff` PHANTOM slots
    // first (the op-param VarIds are never referenced, but `env[voff]` — the first real
    // binding — must land at index voff).
    let vbase: i64 = ctx.voff;
    ctx.nextvid = vbase;
    let mut vph: i64 = 0;
    while vph < vbase {
        push(&mut ctx.env, 0);
        vph = vph + 1;
    }
    let mut itembuf: Vec<u8> = vec_new();
    let mut rsrc: Vec<i64> = vec_new();
    let mut rbs: Vec<i64> = vec_new();
    let mut rbe: Vec<i64> = vec_new();

    // Group A: fns + structs + enums + traits, in source order.
    let mut ia: i64 = 0;
    let mut fnct: i64 = 0;
    let mut sc3: i64 = 0;
    let mut ec3: i64 = 0;
    let mut tc3: i64 = 0;
    let mut ef3: i64 = 0;
    while ia < ni {
        let kda: i64 = itemkind[ia];
        if kda == 3 {
            let bsa: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 3, itempos[ia], fnct);
            push(&mut rsrc, ia);
            push(&mut rbs, bsa);
            push(&mut rbe, len(itembuf));
            fnct = fnct + 1;
            0
        } else if kda == 52 {
            let bss: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 52, itempos[ia], sc3);
            push(&mut rsrc, ia);
            push(&mut rbs, bss);
            push(&mut rbe, len(itembuf));
            sc3 = sc3 + 1;
            0
        } else if kda == 53 {
            let bse: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 53, itempos[ia], ec3);
            push(&mut rsrc, ia);
            push(&mut rbs, bse);
            push(&mut rbe, len(itembuf));
            ec3 = ec3 + 1;
            0
        } else if kda == 54 {
            let bst: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 54, itempos[ia], tc3);
            push(&mut rsrc, ia);
            push(&mut rbs, bst);
            push(&mut rbe, len(itembuf));
            tc3 = tc3 + 1;
            0
        } else if kda == 57 {
            let bsf: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 57, itempos[ia], ef3);
            push(&mut rsrc, ia);
            push(&mut rbs, bsf);
            push(&mut rbe, len(itembuf));
            ef3 = ef3 + 1;
            0
        } else {
            0
        };
        ia = ia + 1;
    }

    // Group B: classes (classvid = nextvid after fns).
    let mut ib: i64 = 0;
    let mut clct: i64 = 0;
    while ib < ni {
        if itemkind[ib] == 56 {
            let bsb: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 56, itempos[ib], clct);
            push(&mut rsrc, ib);
            push(&mut rbs, bsb);
            push(&mut rbe, len(itembuf));
            clct = clct + 1;
            0
        } else {
            0
        };
        ib = ib + 1;
    }

    // Group C: impls (implvid = nextvid after classes).
    let mut ic: i64 = 0;
    let mut imct: i64 = 0;
    while ic < ni {
        if itemkind[ic] == 55 {
            let bsc: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 55, itempos[ic], imct);
            push(&mut rsrc, ic);
            push(&mut rbs, bsc);
            push(&mut rbe, len(itembuf));
            imct = imct + 1;
            0
        } else {
            0
        };
        ic = ic + 1;
    }

    // Group D: SYNTHESISE delegate impls (ImplId + VarIds continue AFTER all user
    // impls — still the impl region). Each synth impl is recorded at its owning class's
    // SOURCE index, so it emits right after the class.
    let mut idd: i64 = 0;
    while idd < ndel {
        let dcid: i64 = ctx.dgcid[idd];
        // the owning class's source index = the (dcid)-th class item.
        let mut csrc: i64 = 0 - 1;
        let mut seen: i64 = 0;
        let mut qd: i64 = 0;
        while qd < ni {
            if csrc == 0 - 1 {
                if itemkind[qd] == 56 {
                    if seen == dcid {
                        csrc = qd;
                        0
                    } else {
                        0
                    };
                    seen = seen + 1;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            qd = qd + 1;
        }
        let bsd: i64 = len(itembuf);
        synth_delegate_impl(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, idd, nuser + idd);
        push(&mut rsrc, csrc);
        push(&mut rbs, bsd);
        push(&mut rbe, len(itembuf));
        idd = idd + 1;
    }

    // EMIT in source order: splice each item's `itembuf` slice (newline-separated).
    let nrec: i64 = len(rsrc);
    let mut si: i64 = 0;
    let mut first_item: bool = true;
    while si < ni {
        let mut j: i64 = 0;
        while j < nrec {
            if rsrc[j] == si {
                if first_item {
                    first_item = false;
                    0
                } else {
                    push(&mut out, '\n');
                    0
                };
                let mut bi: i64 = rbs[j];
                let bend: i64 = rbe[j];
                while bi < bend {
                    push(&mut out, itembuf[bi]);
                    bi = bi + 1;
                }
                0
            } else {
                0
            };
            j = j + 1;
        }
        si = si + 1;
    }

    // The built-in `Async` effect (id = user-effect count) dumps last.
    if first_item {
        0
    } else {
        push(&mut out, '\n');
        0
    };
    append_str(&mut out, "(effect #");
    append_int(&mut out, ecount);
    append_str(&mut out, " Async)");
    push(&mut out, '\n');

    // (6/N) mode 0 = the type dump (`snc types`); mode 1 = the moved-sources dump
    // (`snc borrow`, reusing this same build — ADR 0043).
    if mode == 0 {
        append_str(result, vec_to_array(out));
        0
    } else if mode == 1 {
        let _o: [u8] = vec_to_array(out);
        dump_moves(&mut ctx, &src, result);
        0
    } else {
        // (7/N) mode 2 = the MIR dump, accumulated per-fn in `ctx.mirout` during the
        // pass-2 walk. Discard the type dump; copy mirout's BYTES into `result` (NOT
        // vec_to_array — moving a Vec field out then dropping the struct double-frees).
        let _o2: [u8] = vec_to_array(out);
        let mn: i64 = len(ctx.mirout);
        let mut mi: i64 = 0;
        while mi < mn {
            push(result, ctx.mirout[mi]);
            mi = mi + 1;
        }
        0
    };
    let _it: [u8] = vec_to_array(itembuf);
    let _g: [u8] = vec_to_array(garbage);
    0
}

// (6/N) dump each user fn's moved-source set (ADR 0043 D2): `(fn #<id> <name> #<vid>…)`,
// the moved-from VarIds in ascending order (membership over the `mvf`/`mvv` side-table),
// one line per fn. (The `snc borrow` oracle's format.)
pub fn dump_moves(c: &mut TyCtx, src: &[u8], out: &mut Vec<u8>) -> i64 {
    let nf: i64 = len((*c).ufs);
    let nv: i64 = (*c).nextvid;
    let mut i: i64 = 0;
    while i < nf {
        append_str(out, "(fn #");
        append_int(out, 14 + i);
        push(out, ' ');
        append_slice(out, src, (*c).ufs[i], (*c).ufe[i]);
        let mut vid: i64 = 0;
        while vid < nv {
            let nm: i64 = len((*c).mvf);
            let mut j: i64 = 0;
            let mut found: bool = false;
            while j < nm {
                if (*c).mvf[j] == i {
                    if (*c).mvv[j] == vid {
                        found = true;
                        0
                    } else {
                        0
                    };
                    0
                } else {
                    0
                };
                j = j + 1;
            }
            if found {
                append_str(out, " #");
                append_int(out, vid);
                0
            } else {
                0
            };
            vid = vid + 1;
        }
        push(out, ')');
        push(out, '\n');
        i = i + 1;
    }
    0
}

// =============================================================================
// (7/N) MIR lowering (ADR 0044) — the mode-2 builder + dump. All pools are flat
// append-only parallel Vecs in TyCtx, tagged by block; reset PER FN. NO Vec
// index-assign (the resolve scope idiom for var_defs; tagged-pool scans for the
// per-block dump). Validated standalone by the (7a) probe.
// =============================================================================

fn clear_i64(v: &mut Vec<i64>) -> i64 {
    while len(*v) > 0 {
        let _x: i64 = pop(v);
        0
    }
    0
}

// Reset the per-fn MIR pools (between fns; value/block ids are per-fn).
fn mir_reset(c: &mut TyCtx) -> i64 {
    clear_i64(&mut (*c).mvty);
    clear_i64(&mut (*c).miblk);
    clear_i64(&mut (*c).midst);
    clear_i64(&mut (*c).miop);
    clear_i64(&mut (*c).misym);
    clear_i64(&mut (*c).mia);
    clear_i64(&mut (*c).mib);
    clear_i64(&mut (*c).mbpb);
    clear_i64(&mut (*c).mbpv);
    clear_i64(&mut (*c).mtb);
    clear_i64(&mut (*c).mtk);
    clear_i64(&mut (*c).mta);
    clear_i64(&mut (*c).mtt);
    clear_i64(&mut (*c).mte);
    clear_i64(&mut (*c).mtjs);
    clear_i64(&mut (*c).mtje);
    clear_i64(&mut (*c).mtj);
    clear_i64(&mut (*c).mvdv);
    clear_i64(&mut (*c).mvdl);
    (*c).mir_nblk = 0;
    (*c).mir_cur = 0;
    (*c).lastval = 0 - 1;
    0
}

fn mir_new_value(c: &mut TyCtx, ty: i64) -> i64 {
    let id: i64 = len((*c).mvty);
    push(&mut (*c).mvty, ty);
    id
}

fn mir_new_block(c: &mut TyCtx) -> i64 {
    let id: i64 = (*c).mir_nblk;
    (*c).mir_nblk = (*c).mir_nblk + 1;
    id
}

fn mir_add_param(c: &mut TyCtx, blk: i64, ty: i64) -> i64 {
    let v: i64 = mir_new_value(c, ty);
    push(&mut (*c).mbpb, blk);
    push(&mut (*c).mbpv, v);
    v
}

// Append an instruction (op, sub-code sym, operands a/b) to block `blk`.
fn mir_emit(c: &mut TyCtx, blk: i64, op: i64, sym: i64, a: i64, b: i64, ty: i64) -> i64 {
    let d: i64 = mir_new_value(c, ty);
    push(&mut (*c).miblk, blk);
    push(&mut (*c).midst, d);
    push(&mut (*c).miop, op);
    push(&mut (*c).misym, sym);
    push(&mut (*c).mia, a);
    push(&mut (*c).mib, b);
    d
}

fn mir_term_return(c: &mut TyCtx, blk: i64, v: i64) -> i64 {
    push(&mut (*c).mtb, blk);
    push(&mut (*c).mtk, 2);
    push(&mut (*c).mta, v);
    push(&mut (*c).mtt, 0 - 1);
    push(&mut (*c).mte, 0 - 1);
    push(&mut (*c).mtjs, 0);
    push(&mut (*c).mtje, 0);
    0
}

// (7b) a conditional branch (branch args are always empty — the Rust lowering
// passes values via the JUMPs to the merge, not the branch).
fn mir_term_branch(c: &mut TyCtx, blk: i64, cond: i64, tb: i64, eb: i64) -> i64 {
    push(&mut (*c).mtb, blk);
    push(&mut (*c).mtk, 1);
    push(&mut (*c).mta, cond);
    push(&mut (*c).mtt, tb);
    push(&mut (*c).mte, eb);
    push(&mut (*c).mtjs, 0);
    push(&mut (*c).mtje, 0);
    0
}

// (7b) an unconditional jump to `target`, passing `args` to its block params.
fn mir_term_jump(c: &mut TyCtx, blk: i64, target: i64, args: &Vec<i64>) -> i64 {
    let st: i64 = len((*c).mtj);
    let na: i64 = len(*args);
    let mut i: i64 = 0;
    while i < na {
        let a: i64 = (*args)[i];
        push(&mut (*c).mtj, a);
        i = i + 1;
    }
    let en: i64 = len((*c).mtj);
    push(&mut (*c).mtb, blk);
    push(&mut (*c).mtk, 0);
    push(&mut (*c).mta, target);
    push(&mut (*c).mtt, 0 - 1);
    push(&mut (*c).mte, 0 - 1);
    push(&mut (*c).mtjs, st);
    push(&mut (*c).mtje, en);
    0
}

// var_defs: append-only (var,val) pairs; newest-first lookup.
fn mir_vd_set(c: &mut TyCtx, var: i64, val: i64) -> i64 {
    push(&mut (*c).mvdv, var);
    push(&mut (*c).mvdl, val);
    0
}

fn mir_vd_get(c: &mut TyCtx, var: i64) -> i64 {
    let mut i: i64 = len((*c).mvdv) - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*c).mvdv[i] == var {
                found = (*c).mvdl[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// ---- the per-fn MIR dump (the oracle format; appended to `mirout`) ----------

// (7b) var_defs depth (the snapshot mark at a branch).
fn mir_vd_len(c: &mut TyCtx) -> i64 {
    len((*c).mvdv)
}

// (7b) newest-first lookup of `var` in var_defs[0..hi); -1 if absent.
fn mir_vd_lp(c: &mut TyCtx, hi: i64, var: i64) -> i64 {
    let mut i: i64 = hi - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*c).mvdv[i] == var {
                found = (*c).mvdl[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// (7b) newest-first lookup of `var` in var_defs[lo..hi); -1 if absent.
fn mir_vd_lr(c: &mut TyCtx, lo: i64, hi: i64, var: i64) -> i64 {
    let mut i: i64 = hi - 1;
    let mut found: i64 = 0 - 1;
    while i >= lo {
        if found < 0 {
            if (*c).mvdv[i] == var {
                found = (*c).mvdl[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// (7b) pop var_defs back to depth `s` (restore an arm's bindings off the stack).
fn mir_vd_trunc(c: &mut TyCtx, s: i64) -> i64 {
    while len((*c).mvdv) > s {
        let _a: i64 = pop(&mut (*c).mvdv);
        let _b: i64 = pop(&mut (*c).mvdl);
        0
    }
    0
}

// (7b) newest-first lookup of `var` in a side (var,val) list; -1 if absent.
fn mir_side_lookup(sv: &Vec<i64>, sval: &Vec<i64>, var: i64) -> i64 {
    let mut i: i64 = len(*sv) - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*sv)[i] == var {
                found = (*sval)[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// The dump writes to a buffer `out` (a LOCAL in the caller — NOT a `(*c).field`,
// since passing a ctx-field `&mut` to a user fn re-borrows `c`). `out` and `c` are
// distinct borrows. The caller (`type_fn`) folds `out` into the `mirout` FIELD via
// a `push` loop (a builtin — the only way to append to a Vec field of `*c`).
fn mir_put_ty(out: &mut Vec<u8>, c: &mut TyCtx, rty: i64) -> i64 {
    let mut tb: Vec<u8> = vec_new();
    render_type(&mut tb, rty, c);
    let a: [u8] = vec_to_array(tb);
    append_str(out, a);
    0
}

// A value DEFINITION: `v<N>:<ty>`.
fn mir_put_def(out: &mut Vec<u8>, c: &mut TyCtx, v: i64) -> i64 {
    push(out, 'v');
    append_int(out, v);
    push(out, ':');
    let vt: i64 = (*c).mvty[v];
    mir_put_ty(out, c, vt);
    0
}

// A value USE: the bare `v<N>`.
fn mir_put_use(out: &mut Vec<u8>, v: i64) -> i64 {
    push(out, 'v');
    append_int(out, v);
    0
}

fn mir_put_uop(out: &mut Vec<u8>, uop: i64) -> i64 {
    let s: [u8] = if uop == 1 {
        "-"
    } else if uop == 2 {
        "!"
    } else if uop == 4 {
        "&"
    } else if uop == 5 {
        "&mut"
    } else {
        "*"
    };
    append_str(out, s);
    0
}

fn mir_put_bop(out: &mut Vec<u8>, bop: i64) -> i64 {
    let s: [u8] = if bop == 1 {
        "+"
    } else if bop == 2 {
        "-"
    } else if bop == 3 {
        "*"
    } else if bop == 4 {
        "/"
    } else if bop == 5 {
        "&"
    } else if bop == 6 {
        "|"
    } else if bop == 7 {
        "^"
    } else if bop == 8 {
        "=="
    } else if bop == 9 {
        "!="
    } else if bop == 10 {
        "<"
    } else if bop == 11 {
        "<="
    } else if bop == 12 {
        ">"
    } else {
        ">="
    };
    append_str(out, s);
    0
}

fn mir_dump_inst(out: &mut Vec<u8>, c: &mut TyCtx, i: i64) -> i64 {
    push(out, '(');
    let d: i64 = (*c).midst[i];
    mir_put_def(out, c, d);
    push(out, ' ');
    let op: i64 = (*c).miop[i];
    let sym: i64 = (*c).misym[i];
    let a: i64 = (*c).mia[i];
    let b: i64 = (*c).mib[i];
    if op == 0 {
        append_str(out, "const_int ");
        append_int(out, a);
        0
    } else if op == 1 {
        append_str(out, "const_bool ");
        if a == 0 {
            append_str(out, "false")
        } else {
            append_str(out, "true")
        };
        0
    } else if op == 2 {
        append_str(out, "unary ");
        mir_put_uop(out, sym);
        push(out, ' ');
        mir_put_use(out, a);
        0
    } else if op == 3 {
        append_str(out, "binop ");
        mir_put_bop(out, sym);
        push(out, ' ');
        mir_put_use(out, a);
        push(out, ' ');
        mir_put_use(out, b);
        0
    } else {
        append_str(out, "cmp ");
        mir_put_bop(out, sym);
        push(out, ' ');
        mir_put_use(out, a);
        push(out, ' ');
        mir_put_use(out, b);
        0
    };
    push(out, ')');
    0
}

fn mir_dump_term(out: &mut Vec<u8>, c: &mut TyCtx, blk: i64) -> i64 {
    let n: i64 = len((*c).mtb);
    let mut i: i64 = 0;
    while i < n {
        if (*c).mtb[i] == blk {
            append_str(out, "(term ");
            let k: i64 = (*c).mtk[i];
            if k == 2 {
                append_str(out, "return");
                let rv: i64 = (*c).mta[i];
                if rv >= 0 {
                    push(out, ' ');
                    mir_put_use(out, rv);
                    0
                } else {
                    0
                };
                0
            } else if k == 0 {
                append_str(out, "jump b");
                let jt: i64 = (*c).mta[i];
                append_int(out, jt);
                let js: i64 = (*c).mtjs[i];
                let je: i64 = (*c).mtje[i];
                let mut a: i64 = js;
                while a < je {
                    push(out, ' ');
                    let av: i64 = (*c).mtj[a];
                    mir_put_use(out, av);
                    a = a + 1;
                }
                0
            } else {
                append_str(out, "branch ");
                let cv: i64 = (*c).mta[i];
                mir_put_use(out, cv);
                append_str(out, " (b");
                let bt: i64 = (*c).mtt[i];
                append_int(out, bt);
                append_str(out, ") (b");
                let be: i64 = (*c).mte[i];
                append_int(out, be);
                push(out, ')');
                0
            };
            push(out, ')');
            0
        } else {
            0
        };
        i = i + 1;
    }
    0
}

fn mir_dump_block(out: &mut Vec<u8>, c: &mut TyCtx, blk: i64) -> i64 {
    append_str(out, "(block b");
    append_int(out, blk);
    append_str(out, " (params");
    let np: i64 = len((*c).mbpb);
    let mut p: i64 = 0;
    while p < np {
        if (*c).mbpb[p] == blk {
            push(out, ' ');
            let pv: i64 = (*c).mbpv[p];
            mir_put_def(out, c, pv);
            0
        } else {
            0
        };
        p = p + 1;
    }
    push(out, ')');
    let ni: i64 = len((*c).miblk);
    let mut i: i64 = 0;
    while i < ni {
        if (*c).miblk[i] == blk {
            push(out, ' ');
            mir_dump_inst(out, c, i);
            0
        } else {
            0
        };
        i = i + 1;
    }
    push(out, ' ');
    mir_dump_term(out, c, blk);
    push(out, ')');
    0
}

// Write one fn's MIR (`(fn <name> <ret-ty> <block>…)`) into `out`.
fn mir_dump_fn(out: &mut Vec<u8>, c: &mut TyCtx, src: &[u8], name_s: i64, name_e: i64, rty: i64) -> i64 {
    append_str(out, "(fn ");
    append_slice(out, src, name_s, name_e);
    push(out, ' ');
    mir_put_ty(out, c, rty);
    let nb: i64 = (*c).mir_nblk;
    let mut b: i64 = 0;
    while b < nb {
        push(out, ' ');
        mir_dump_block(out, c, b);
        b = b + 1;
    }
    push(out, ')');
    push(out, '\n');
    0
}

// (6/N) `snc types` entry: build (mode 0) + print the type dump.
fn main() -> i64 {
    let inp_path: [u8] = "input.sentinel";
    let inp: [u8] = read_file(inp_path);
    let mut result: Vec<u8> = vec_new();
    run(inp, 0, &mut result);
    let arr: [u8] = vec_to_array(result);
    print_bytes(arr);
    0
}
