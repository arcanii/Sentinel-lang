// Strip one reference layer: `&T` / `&mut T` (kind 2, inner in `tb`) → `T`; else
// unchanged. A method receiver `c.m()` carries the class value, but a `&Class` /
// `&mut Class` (e.g. a `self` re-borrow) strips to the class.
fn strip_ref(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        h
    } else if (*c).tk[h - tbase()] == 2 {
        (*c).tb[h - tbase()]
    } else {
        h
    }
}

