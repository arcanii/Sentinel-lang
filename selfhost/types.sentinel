            append_str(out, pe);
            push(out, ' ');
            append_str(out, po);
            // (7c) MIR: perform funnels its args through Opaque.
            let pf_col: bool = (*c).mir_collecting;
            if mir_on(c) {
                (*c).mir_collecting = true;
                0
            } else {
                0
            };
            let pf_snap: i64 = if mir_on(c) {
                mir_margs_len(c)
            } else {
                0
            };
            dump_cargs(out, pa, src, c, gb);
            close_ty(out, pret, c);
            if mir_on(c) {
                (*c).mir_collecting = pf_col;
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_va(c, mc, 7, 0, pf_snap, pret);
                (*c).lastval = d;
                0
            } else {
                0
            };
            pret
        },
        // (4g) `handle body with { Eff.op(ps) => arm, … return v => arm }` →
        // `(handle <body :T> (arm #eid idx Eff op (#pvids) <arm-body>)… (return #vid
        // <body>)? :T)` — the handle's type is the body's type. Handler-arm params +
        // the return var bind VarIds in the enclosing fn region (scoped per-arm).
        Expr::Handle(hb, ha, hr) => {
            append_str(out, "(handle ");
            let bty: i64 = dump_texpr(out, hb, 0 - 1, src, c, gb);
            let hbv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            // (7c) MIR: a handle lowers ONLY its body -> Opaque([body]); the handler arms
            // + return arm are walked for the dump but NOT lowered (suppress their emits).
            let h_sup: bool = (*c).mir_suppress;
            if mir_on(c) {
                (*c).mir_suppress = true;
                0
            } else {
                0
            };
            dump_tharms(out, ha, src, c, gb);
            dump_tret(out, hr, bty, src, c, gb);
            if mir_on(c) {
                (*c).mir_suppress = h_sup;
                0
            } else {
                0
            };
            close_ty(out, bty, c);
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque1(c, mc, hbv, bty);
                (*c).lastval = d;
                0
            } else {
                0
            };
            bty
        },
        // (4d) `declassify(e)` strips one secret layer: `secret T → T` (ADR 0019 D6).
        // The inner is synthesized with no expectation; the node's type is its stripped
        // type. `(declassify <inner :secret T> :T)`.
        Expr::Declassify(di) => {
            append_str(out, "(declassify ");
            // (6/N) `declassify` consumes its (secret) operand.
            let svc: bool = (*c).consuming;
            (*c).consuming = true;
            let it: i64 = dump_texpr(out, di, 0 - 1, src, c, gb);
            let dinv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            (*c).consuming = svc;
            let rt: i64 = strip_secret(c, it);
            close_ty(out, rt, c);
            // (7c) MIR: `declassify` is the one taint sink (op 8) — result is the
            // non-secret view of the operand.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit(c, mc, 8, 0, dinv, 0, rt);
                (*c).lastval = d;
                0
            } else {
                0
            };
            rt
        },
        // (4i) char literal `'c'` → `(char N :u8)` (the decoded byte value, ADR 0033 D2:
        // `u8`). Widens like the other scalar leaves (a `secret u8` / `?u8` context).
        Expr::Char(cv) => {
            let w: bool = widen_pre(out, exp, 3, c);
            append_str(out, "(char ");
            append_int(out, cv);
            close_ty(out, 3, c);
            // (7c) MIR: a char literal is a public constant -> Opaque (no operands), u8.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque0(c, mc, 3);
                (*c).lastval = d;
                0
            } else {
                0
            };
            // (8c-3) codegen: a char literal is a u8 operand (no instruction).
            if cg_on(c) {
                (*c).cglk = 1;
                (*c).cglv = cv;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            widen_post(out, w, exp, 3, c)
        },
        // (4i) string literal `"…"` → `(str b0 b1 … :[u8])` (the decoded bytes, ADR 0033
        // D2: a string IS a `[u8]`). ⚠ `sb` is an owned `[u8]` only INDEXED in the byte
        // loop → `sink_name` it (by value) after, else it leaks (the parser's
        // `dump_str_body` lesson).
        Expr::Str(sb) => {
            let saty: i64 = mk_array(c, 3);
            let w: bool = widen_pre(out, exp, saty, c);
            append_str(out, "(str");
            let slen: i64 = len(sb);
            let mut sbi: i64 = 0;
            while sbi < slen {
                push(out, ' ');
                append_int(out, u8_to_i64(sb[sbi]));
                sbi = sbi + 1;
            }
            // (8c-3) codegen: a string literal IS a u8 array literal of constant bytes
            // — push each byte as a literal operand (i8), then reuse cg_emit_arraylit.
            // Must read `sb` BEFORE `sink_name` consumes it.
            if cg_on(c) {
                let s_snap: i64 = len((*c).cgak);
                let mut sci: i64 = 0;
                while sci < slen {
                    let sbv: i64 = u8_to_i64(sb[sci]);
                    push(&mut (*c).cgak, 1);
                    push(&mut (*c).cgav, sbv);
                    push(&mut (*c).cgat, 3);
                    sci = sci + 1;
                }
                cg_emit_arraylit(c, 3, s_snap);
                0
            } else {
                0
            };
            sink_name(gb, sb);
            close_ty(out, saty, c);
            // (7c) MIR: a string literal is a public constant -> Opaque (no operands), [u8].
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque0(c, mc, saty);
                (*c).lastval = d;
                0
            } else {
                0
            };
            mir_widen(c, w, exp);
            widen_post(out, w, exp, saty, c)
        },
        // (4i) `scope concurrent { block }` → `(scope <block :T> :T)`: the scope's value
        // IS the block's tail, so thread the expectation `exp` through (a `?T`-typed
        // scope widens its tail). Discharges the Async effect (effect-check is D1, out of
        // scope), so the type is just the body type.
        Expr::Scope(sbody) => {
            append_str(out, "(scope ");
            let sct: i64 = dump_texpr(out, sbody, exp, src, c, gb);
            close_ty(out, sct, c);
            sct
        },
        // (4i) `spawn <call>` → `(spawn <inner :U> :Task<U>)`: spawn wraps the spawned
        // expression's type U in a `Task`.
        Expr::Spawn(scall) => {
            append_str(out, "(spawn ");
            let spt: i64 = dump_texpr(out, scall, 0 - 1, src, c, gb);
            let spv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            let tkt: i64 = mk_task(c, spt);
            close_ty(out, tkt, c);
            // (7c) MIR: `spawn e` -> Opaque([e]) typed Task<U>.
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque1(c, mc, spv, tkt);
                (*c).lastval = d;
                0
            } else {
                0
            };
            tkt
        },
        // (4i) `<target>.await` → `(await <target :Task<U>> :U)`: await joins the task +
        // yields its result type U (the Task's element).
        Expr::Await(aw) => {
            append_str(out, "(await ");
            let awt: i64 = dump_texpr(out, aw, 0 - 1, src, c, gb);
            let awv: i64 = if mir_on(c) {
                (*c).lastval
            } else {
                0 - 1
            };
            let awr: i64 = task_elem_of(c, awt);
            close_ty(out, awr, c);
            // (7c) MIR: `t.await` -> Opaque([t]) typed U (the task's element).
            if mir_on(c) {
                let mc: i64 = (*c).mir_cur;
                let d: i64 = mir_emit_opaque1(c, mc, awv, awr);
                (*c).lastval = d;
                0
            } else {
                0
            };
            awr
        },
        // A defensive catch-all keeps the match exhaustive (no Expr variants remain).
        _ => {
            append_str(out, "(UNHANDLED");
            close_ty(out, 0, c);
            0
        },
    }
}

// (4e) A match-arm pattern's payload bindings: each binds a fresh VarId (in
// source order) into the arm's scope with its variant's payload type, and emits
// `(bind #vid name <type>)`. `pbase` is the variant's payload-slice base into
// `varpay`; `payidx` advances per bind. The name is emitted from `nb` AFTER
// `bind_name` copies it there (it consumes the AST `[u8]`).
fn dump_tbinds(out: &mut Vec<u8>, b: Binds, pbase: i64, payidx: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            let bvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            let pty: i64 = (*c).varpay[pbase + payidx];
            let nst: i64 = len((*c).nb);
            bind_name(c, nm, bvid, pty);
            // (8e-2) cg: bind the payload field — GEP the boxed payload struct's field
            // `payidx`, load it into a fresh hoisted slot, store, key the slot by VarId
            // (so the arm body's Var reads it). A `_` binding still gets a slot. NOT
            // drop-recorded (it aliases the box, freed by the scrutinee's enum drop).
            if cg_on(c) {
                let bfp: i64 = cg_dst(c);
                cgo_str(c, "getelementptr ");
                cg_emit_pstruct(c, (*c).cg_m_pj);
                cgo_str(c, ", ptr %v");
                cgo_int(c, (*c).cg_m_payload);
                cgo_str(c, ", i32 0, i32 ");
                cgo_int(c, payidx);
                cg_putc(c, '\n');
                let bld: i64 = cg_dst(c);
                cgo_str(c, "load ");
                cgo_ty(c, pty);
                cgo_str(c, ", ptr %v");
                cgo_int(c, bfp);
                cg_putc(c, '\n');
                let bsl: i64 = cg_alloca(c, pty);
                cgo_str(c, "  store ");
                cgo_ty(c, pty);
                cgo_str(c, " %v");
                cgo_int(c, bld);
                cgo_str(c, ", ptr %v");
                cgo_int(c, bsl);
                cg_putc(c, '\n');
                cg_slot_set(c, bvid, bsl);
                0
            } else {
                0
            };
            let nen: i64 = len((*c).nb);
            append_str(out, " (bind #");
            append_int(out, bvid);
            push(out, ' ');
            let mut bi: i64 = nst;
            while bi < nen {
                push(out, (*c).nb[bi]);
                bi = bi + 1;
            }
            push(out, ' ');
            render_type(out, pty, c);
            push(out, ')');
            dump_tbinds(out, rest, pbase, payidx + 1, c, gb)
        },
    }
}

// (4e) A match-arm pattern: `_` → `(pat _)`; `Enum::Variant(binds)` → `(pat vidx
// Variant (bind …)…)` — the variant_index replaces resolve's enum name; the binds
// take the variant's payload types.
fn dump_tpat(out: &mut Vec<u8>, p: Pattern, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match p {
        Pattern::PatWild => {
            append_str(out, "(pat _)");
            // (8e-2) cg: a wildcard arm has no tag check — signal the epilogue (-1).
            // (No emitting fixture uses one; the final-else body is a deferred case.)
            if cg_on(c) {
                (*c).cg_m_armnext = 0 - 1;
                0
            } else {
                0
            };
            0
        },
        Pattern::PatVariant(en, vn, bs) => {
            let eid: i64 = enum_lookup(c, &en);
            sink_name(gb, en);
            let vidx: i64 = variant_index(c, eid, &vn);
            let j: i64 = variant_flat(c, eid, vidx);
            let pbase: i64 = (*c).varps[j];
            // (8e-2) cg: the arm's tag check — `icmp eq tag, vidx`; branch to the arm
            // block (open it) or the next check. `cg_m_pj` carries `j` to the bind.
            if cg_on(c) {
                (*c).cg_m_pj = j;
                let pcmp: i64 = cg_dst(c);
                cgo_str(c, "icmp eq i32 %v");
                cgo_int(c, (*c).cg_m_tag);
                cgo_str(c, ", ");
                cgo_int(c, vidx);
                cg_putc(c, '\n');
                let parm: i64 = cg_fresh_block(c);
                let pnext: i64 = cg_fresh_block(c);
                cgo_str(c, "  br i1 %v");
                cgo_int(c, pcmp);
                cgo_str(c, ", label %bb");
                cgo_int(c, parm);
                cgo_str(c, ", label %bb");
                cgo_int(c, pnext);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, parm);
                cgo_str(c, ":\n");
                (*c).cg_m_armnext = pnext;
                0
            } else {
                0
            };
            append_str(out, "(pat ");
            append_int(out, vidx);
            push(out, ' ');
            append_str(out, vn);
            dump_tbinds(out, bs, pbase, 0, c, gb);
            push(out, ')');
            0
        },
    }
}

// (4e) match arms: snapshot the scope, dump the pattern (binding its payloads),
// type the body (threading the match's expectation `exp`), then TRUNCATE the scope
// back (the payloads are arm-local; VarIds stay monotonic). The match's type is the
// FIRST arm's body type (every arm shares it on clean fixtures).
fn dump_tarms(out: &mut Vec<u8>, a: Arms, exp: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        Arms::ArmEnd => 0 - 1,
        Arms::ArmCell(ap, abody, arest) => {
            append_str(out, " (arm ");
            let mark: i64 = len((*c).scs);
            // (8e-2) cg: reset the arm's next-block before the pattern sets it; capture it
            // into a LOCAL after, so a nested match in the body can't clobber it.
            if cg_on(c) {
                (*c).cg_m_armnext = 0 - 1;
                0
            } else {
                0
            };
            dump_tpat(out, ap, c, gb);
            let cg_arm_next: i64 = if cg_on(c) {
                (*c).cg_m_armnext
            } else {
                0 - 1
            };
            push(out, ' ');
            let bt: i64 = dump_texpr(out, abody, exp, src, c, gb);
            // (8e-2) cg: store the arm body's value to the result slot, branch to merge,
            // open the next-check block (a variant arm only — `cg_arm_next >= 0`).
            let cg_bk: i64 = if cg_on(c) {
                (*c).cglk
            } else {
                0
            };
            let cg_bv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            mir_collect(c);
            truncate_scope(c, mark);
            if cg_on(c) {
                if cg_arm_next >= 0 {
                    cgo_str(c, "  store ");
                    cgo_ty(c, exp);
                    cg_putc(c, ' ');
                    cgo_operand(c, cg_bk, cg_bv);
                    cgo_str(c, ", ptr %v");
                    cgo_int(c, (*c).cg_m_result);
                    cg_putc(c, '\n');
                    cgo_str(c, "  br label %bb");
                    cgo_int(c, (*c).cg_m_merge);
                    cg_putc(c, '\n');
                    cgo_str(c, "bb");
                    cgo_int(c, cg_arm_next);
                    cgo_str(c, ":\n");
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            push(out, ')');
            dump_tarms(out, arest, exp, src, c, gb);
            bt
        },
    }
}

// (4g) A handler arm's params: each binds a fresh VarId (source order) → `#vid`. ⚠
// bound with `i64` (every corpus op param is `i64`; the continuation `k` is only ever
// used as a resume-kont callee, never a typed var). A non-`i64` op param would need
// the op's param-type table (a follow-up).
fn dump_thparams(out: &mut Vec<u8>, b: Binds, c: &mut TyCtx, first: bool) -> i64 {
    match b {
        Binds::BindEnd => 0,
        Binds::BindCell(nm, rest) => {
            if first {
                0
            } else {
                push(out, ' ');
                0
            };
            let pvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, nm, pvid, 0);
            push(out, '#');
            append_int(out, pvid);
            dump_thparams(out, rest, c, false)
        },
    }
}

// (4g) handler arms → `(arm #eid op_idx Eff op (#pvids) <body>)` — params bind VarIds
// scoped to the arm (truncated after); the body is typed (sees the params + `k`).
fn dump_tharms(out: &mut Vec<u8>, a: HArms, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match a {
        HArms::HEnd => 0,
        HArms::HCell(hef, hop, hparams, hbody, hrest) => {
            let heid: i64 = effect_lookup(c, src, &hef);
            let hoidx: i64 = op_index_lookup(c, src, heid, &hop);
            append_str(out, " (arm #");
            append_int(out, heid);
            push(out, ' ');
            append_int(out, hoidx);
            push(out, ' ');
            append_str(out, hef);
            push(out, ' ');
            append_str(out, hop);
            append_str(out, " (");
            let mark: i64 = len((*c).scs);
            dump_thparams(out, hparams, c, true);
            append_str(out, ") ");
            dump_texpr(out, hbody, 0 - 1, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            dump_tharms(out, hrest, src, c, gb)
        },
    }
}

// (4g) the optional `return v => body` arm → `(return #vid <body>)`: `v` binds a
// VarId typed as the handle BODY's type `bty` (it names the body's value), scoped to
// the arm.
fn dump_tret(out: &mut Vec<u8>, r: Ret, bty: i64, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match r {
        Ret::NoRet => 0,
        Ret::YesRet(rnm, rbody) => {
            let mark: i64 = len((*c).scs);
            let rvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            bind_name(c, rnm, rvid, bty);
            append_str(out, " (return #");
            append_int(out, rvid);
            push(out, ' ');
            dump_texpr(out, rbody, 0 - 1, src, c, gb);
            truncate_scope(c, mark);
            push(out, ')');
            0
        },
    }
}

fn dump_tstmts(out: &mut Vec<u8>, st: Stmts, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match st {
        Stmts::SEnd => 0,
        Stmts::SCell(s, rest) => {
            push(out, ' ');
            dump_tstmt(out, s, src, c, gb);
            dump_tstmts(out, rest, src, c, gb)
        },
    }
}

fn dump_tstmt(out: &mut Vec<u8>, s: Stmt, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    match s {
        Stmt::SLet(lmf, lnm, lty, lval) => {
            // DURING-WALK binding: take the let's expected type from its annotation
            // FIRST (so a `?T` let widens a `T` value / types a `null`), resolve the
            // VALUE against it into a temp buffer (it may bind nested vars), THEN take
            // the let's VarId. The let's type is the annotation if present, else the
            // value's inferred type. Format: `(let #vid [mut] <type> <value>)`.
            let mut vbuf: Vec<u8> = vec_new();
            let letexp: i64 = tyopt_exp(c, lty, gb);
            // (6/N) a `let`'s RHS is CONSUMING (a bare-Var RHS moves the binding).
            let lsvc: bool = (*c).consuming;
            (*c).consuming = true;
            let valty: i64 = dump_texpr(&mut vbuf, lval, letexp, src, c, gb);
            (*c).consuming = lsvc;
            let lvid: i64 = (*c).nextvid;
            (*c).nextvid = (*c).nextvid + 1;
            let letty: i64 = if letexp == 0 - 1 {
                valty
            } else {
                letexp
            };
            bind_name(c, lnm, lvid, letty);
            // (7/N) MIR: the let's value is its current SSA value (the RHS's `lastval`).
            if mir_on(c) {
                let lv: i64 = (*c).lastval;
                mir_vd_set(c, lvid, lv);
                0
            } else {
                0
            };
            // (8/N) codegen: the RHS instructions are already in `cgout`; bind by an
            // alloca slot + store the RHS operand. Reads of this var load from the slot.
            if cg_on(c) {
                let rk: i64 = (*c).cglk;
                let rv: i64 = (*c).cglv;
                let cgslot: i64 = cg_alloca(c, letty);
                cg_store(c, letty, rk, rv, cgslot);
                cg_slot_set(c, lvid, cgslot);
                cg_drop_record(c, lvid, letty, cgslot);
                0
            } else {
                0
            };
            append_str(out, "(let #");
            append_int(out, lvid);
            push(out, ' ');
            if lmf {
                append_str(out, "mut ")
            } else {
                0
            };
            render_type(out, letty, c);
            push(out, ' ');
            append_str(out, vec_to_array(vbuf));
            push(out, ')');
            0
        },
        Stmt::SAssign(atgt, aval) => {
            append_str(out, "(assign ");
            // (6/N) the assign TARGET is a place (non-consuming); the VALUE is consuming.
            let asvc: bool = (*c).consuming;
            (*c).consuming = false;
            // (7c) MIR: the target is a PLACE, not a value — suppress its emits during
            // the (dump-only) target walk. A plain-Var target sets `mir_lastvid`; a
            // field/`*`-deref/index place sets it -1 (the wrapper arms).
            let as_sup: bool = (*c).mir_suppress;
            if mir_on(c) {
                (*c).mir_suppress = true;
                0
            } else {
                0
            };
            // (8/N) codegen: suppress the target's load (it's a place, not a value); the
            // Var arm records `cg_lastvid` so the store can find the slot.
            let cg_sup: bool = (*c).cg_suppress;
            if cg_on(c) {
                (*c).cg_suppress = true;
                0
            } else {
                0
            };
            let ttgt: i64 = dump_texpr(out, atgt, 0 - 1, src, c, gb);
            let tvid: i64 = if mir_on(c) {
                (*c).mir_suppress = as_sup;
                (*c).mir_lastvid
            } else {
                0 - 1
            };
            let cgtvid: i64 = if cg_on(c) {
                (*c).cg_suppress = cg_sup;
                (*c).cg_lastvid
            } else {
                0 - 1
            };
            // (8d) for a `*r =` deref target the place is r's pointer (left in the operand
            // by the Unary arm, cg_lastvid = -1); capture it BEFORE the value walk clobbers.
            let cgtpv: i64 = if cg_on(c) {
                (*c).cglv
            } else {
                0
            };
            (*c).consuming = true;
            push(out, ' ');
            dump_texpr(out, aval, 0 - 1, src, c, gb);
            // (7c) MIR: a plain-Var target rebinds var_defs to the RHS; a field/`*`-deref
            // store (no precise IR) funnels the value through Opaque (a store sink, typed
            // as the target).
            if mir_on(c) {
                let av: i64 = (*c).lastval;
                if tvid >= 0 {
                    mir_vd_set(c, tvid, av);
                    0
                } else {
                    let mc: i64 = (*c).mir_cur;
                    let _d: i64 = mir_emit_opaque1(c, mc, av, ttgt);
                    0
                };
                0
            } else {
                0
            };
            // (8/N) codegen: store the RHS operand into the target's place — a Var's alloca
            // slot (cgtvid >= 0), or (8d) THROUGH a `*r` deref pointer (cgtvid = -1, the
            // pointer reg in cgtpv; cg_store renders it as `ptr %v<cgtpv>`).
            if cg_on(c) {
                let asak: i64 = (*c).cglk;
                let asav: i64 = (*c).cglv;
                if cgtvid >= 0 {
                    let asslot: i64 = cg_slot_get(c, cgtvid);
                    cg_store(c, ttgt, asak, asav, asslot);
                    0
                } else {
                    cg_store(c, ttgt, asak, asav, cgtpv);
                    0
                };
                0
            } else {
                0
            };
            (*c).consuming = asvc;
            push(out, ')');
            0
        },
        Stmt::SWhile(wcond, wbody) => {
            append_str(out, "(while ");
            // (6/N) the cond is a read + the while body's value is discarded — both
            // non-consuming (call args inside still set their own consuming).
            let wsvc: bool = (*c).consuming;
            (*c).consuming = false;
            // (8b) cg: the loop CFG. Enter the cond block (the back-edge target).
            let mut cg_wc: i64 = 0 - 1;
            let mut cg_wb: i64 = 0 - 1;
            let mut cg_wa: i64 = 0 - 1;
            if cg_on(c) {
                cg_wc = cg_fresh_block(c);
                cg_wb = cg_fresh_block(c);
                cg_wa = cg_fresh_block(c);
                cgo_str(c, "  br label %bb");
                cgo_int(c, cg_wc);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_wc);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            dump_texpr(out, wcond, 0 - 1, src, c, gb);
            // (8b) cg: branch cond → body/after, open the body, register loop targets.
            if cg_on(c) {
                let cwk: i64 = (*c).cglk;
                let cwv: i64 = (*c).cglv;
                cgo_str(c, "  br i1 ");
                cgo_operand(c, cwk, cwv);
                cgo_str(c, ", label %bb");
                cgo_int(c, cg_wb);
                cgo_str(c, ", label %bb");
                cgo_int(c, cg_wa);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_wb);
                cgo_str(c, ":\n");
                push(&mut (*c).cg_loop_cond, cg_wc);
                push(&mut (*c).cg_loop_after, cg_wa);
                // (8d-drops-3) the body frame's drop floor = cgdv length NOW, before the
                // body Block arm pushes its frame; break/continue drain cgdv[floor..].
                push(&mut (*c).cg_loop_floor, len((*c).cgdv));
                0
            } else {
                0
            };
            push(out, ' ');
            dump_texpr(out, wbody, 0 - 1, src, c, gb);
            // (8b) cg: pop loop targets, back-edge to cond, open the after block.
            if cg_on(c) {
                let _pc: i64 = pop(&mut (*c).cg_loop_cond);
                let _pa: i64 = pop(&mut (*c).cg_loop_after);
                let _pf: i64 = pop(&mut (*c).cg_loop_floor);
                cgo_str(c, "  br label %bb");
                cgo_int(c, cg_wc);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, cg_wa);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            (*c).consuming = wsvc;
            push(out, ')');
            0
        },
        Stmt::SBreak => {
            append_str(out, "(break)");
            // (8b) cg: branch to the innermost loop's after block; park on a dead block.
            if cg_on(c) {
                let bn: i64 = len((*c).cg_loop_after);
                let bafter: i64 = (*c).cg_loop_after[bn - 1];
                // (8d-drops-3) drain the body frame(s) before branching out of the loop.
                let bfloor: i64 = (*c).cg_loop_floor[bn - 1];
                cg_drop_range(c, bfloor);
                cgo_str(c, "  br label %bb");
                cgo_int(c, bafter);
                cg_putc(c, '\n');
                let bdead: i64 = cg_fresh_block(c);
                cgo_str(c, "bb");
                cgo_int(c, bdead);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            0
        },
        Stmt::SContinue => {
            append_str(out, "(continue)");
            // (8b) cg: branch to the innermost loop's cond block; park on a dead block.
            if cg_on(c) {
                let kn: i64 = len((*c).cg_loop_cond);
                let kcond: i64 = (*c).cg_loop_cond[kn - 1];
                // (8d-drops-3) drain the body frame(s) before branching to the cond.
                let kfloor: i64 = (*c).cg_loop_floor[kn - 1];
                cg_drop_range(c, kfloor);
                cgo_str(c, "  br label %bb");
                cgo_int(c, kcond);
                cg_putc(c, '\n');
                let kdead: i64 = cg_fresh_block(c);
                cgo_str(c, "bb");
                cgo_int(c, kdead);
                cgo_str(c, ":\n");
                0
            } else {
                0
            };
            0
        },
        Stmt::SExpr(sx) => {
            append_str(out, "(expr ");
            // (6/N) an expr-statement's value is discarded → non-consuming (inner call
            // args still set their own consuming).
            let esvc: bool = (*c).consuming;
            (*c).consuming = false;
            dump_texpr(out, sx, 0 - 1, src, c, gb);
            (*c).consuming = esvc;
            push(out, ')');
            0
        },
    }
}

// The let's annotation type as an EXPECTATION (consuming the `TyOpt`): the interned
// annotation handle if present, else -1 (no expectation → the value's type is
// inferred). Taken before the value is walked, so a `?T` annotation widens the value.
fn tyopt_exp(c: &mut TyCtx, ty: TyOpt, gb: &mut Vec<u8>) -> i64 {
    match ty {
        TyOpt::NoTy => 0 - 1,
        TyOpt::SomeTy(t) => type_of_typeexpr(c, t, gb),
    }
}

// --- fn header parse --------------------------------------------------------

// Parse + emit a fn's params from tokens (mirrors resolve's `emit_params`): each
// `(param #vid [mut] <name> <type>)`, binding the param's VarId + its type in the
// env. Ends on `)` (kind 5); skips `,` (kind 29). `first` suppresses the leading
// space.
fn emit_tparams(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_tparams(out, k, s, e, src, cur, c, gb, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pty: i64 = type_of_typeexpr(c, pte, gb);
        let vid: i64 = (*c).nextvid;
        (*c).nextvid = (*c).nextvid + 1;
        bind_src(c, src, ns, ne, vid, pty);
        // (7/N) MIR: the param is an SSA param of the entry block; bind var_defs.
        if mir_on(c) {
            let mc: i64 = (*c).mir_cur;
            let pv: i64 = mir_add_param(c, mc, pty);
            mir_vd_set(c, vid, pv);
            0
        } else {
            0
        };
        // (8/N) codegen: hoist the param's alloca (recorded) + emit its store to cgbody
        // (the store is the first thing in the body; the alloca lands in the entry block).
        // The param index = len(cgpty) before the push (params record in order).
        if cg_on(c) {
            let cgpidx: i64 = len((*c).cgpty);
            let cgslot: i64 = cg_alloca(c, pty);
            cg_slot_set(c, vid, cgslot);
            cg_drop_record(c, vid, pty, cgslot);
            push(&mut (*c).cgpty, pty);
            cgo_str(c, "  store ");
            cgo_ty(c, pty);
            cgo_str(c, " %arg");
            cgo_int(c, cgpidx);
            cgo_str(c, ", ptr %v");
            cgo_int(c, cgslot);
            cg_putc(c, '\n');
            0
        } else {
            0
        };
        append_str(out, "(param #");
        append_int(out, vid);
        push(out, ' ');
        if pm {
            append_str(out, "mut ")
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        render_type(out, pty, c);
        push(out, ')');
        emit_tparams(out, k, s, e, src, cur, c, gb, false)
    }
}

// Type-check one top-level `fn`, emitting `(fn #id name (params) <ret> <block>)`.
fn type_fn(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, fnidx: i64) -> i64 {
    *cur = *cur + 1;            // skip `fn`
    let name_s: i64 = (*s)[*cur];
    let name_e: i64 = (*e)[*cur];
    *cur = *cur + 1;
    // (4h) set up the type-param scope so the params/body/return type as `<T#i>`;
    // `tp_setup` resets first (so a non-generic fn gets an empty scope) + advances
    // past `>` (or no-ops, leaving the cursor at `(`).
    tp_setup(c, k, s, e, src, cur);
    *cur = *cur + 1;           // skip `(`
    (*c).base = len((*c).scs);
    // (7/N) MIR: start this fn's lowering — fresh pools + an entry block (b0).
    // Params are added as the entry's SSA params by `emit_tparams` (mode 2).
    if mir_on(c) {
        mir_reset(c);
        let eb: i64 = mir_new_block(c);
        (*c).mir_cur = eb;
        0
    } else {
        0
    };
    // (8/N) codegen: reset the per-fn cg state; `main` gets the C-ABI i32-trunc return.
    if cg_on(c) {
        cg_reset(c);
        (*c).cgmain = cg_is_main(src, name_s, name_e);
        0
    } else {
        0
    };
    // (8d-drops) the param frame's mark (0 after cg_reset). `emit_tparams` records the
    // params into the drop pools; the body block (frame 1) drops its own locals; then
    // the param frame (frame 0) is freed below — matching the production scope-0/1 order.
    let cgpmark: i64 = if cg_on(c) {
        len((*c).cgdv)
    } else {
        0
    };
    append_str(out, "(fn #");
    append_int(out, 14 + fnidx);
    push(out, ' ');
    append_slice(out, src, name_s, name_e);
    append_str(out, " (");
    emit_tparams(out, k, s, e, src, cur, c, gb, true);
    append_str(out, ") ");
    *cur = *cur + 1;           // skip `->`
    let rte: TypeE = parse_type(k, s, e, src, cur);
    let rty: i64 = type_of_typeexpr(c, rte, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let body: Expr = parse_block(k, s, e, src, cur);
    render_type(out, rty, c);
    push(out, ' ');
    // (8/N) codegen: the body walk appends to cgbody (allocas recorded for hoisting); the
    // `define` header + entry-block allocas + ret are assembled into cgout at teardown.
    // (6/N) record this fn's moves: `curfn` = its idx (only top-level fn bodies — methods
    // aren't in `program.fns`), and the body's tail is CONSUMING (the returned value).
    (*c).curfn = fnidx;
    (*c).consuming = true;
    // The fn return type is the body's expectation — a `?T`-returning fn widens its
    // tail (`dump_texpr` on the body `Block` threads `rty` to the tail).
    dump_texpr(out, body, rty, src, c, gb);
    // (8d-drops) free the param frame (frame 0) — AFTER the body-block drops (emitted
    // inside the Block arm), BEFORE `curfn` is cleared (cg_is_moved keys on it).
    if cg_on(c) {
        cg_drop_frame(c, cgpmark);
        0
    } else {
        0
    };
    (*c).curfn = 0 - 1;
    // (7/N) MIR: the body's value (`lastval`) is the fn's return; terminate the
    // current block + dump this fn's MIR into `mirout`.
    if mir_on(c) {
        let bv: i64 = (*c).lastval;
        let cb: i64 = (*c).mir_cur;
        mir_term_return(c, cb, bv);
        if (*c).mode == 3 {
            // (7d) mode 3: verify this fn's MIR (leaks accumulate in `mirout`).
            mir_verify_fn(c);
            0
        } else {
            // mode 2: dump this fn's MIR into a LOCAL buffer (distinct from `c`), then
            // fold into the `mirout` FIELD via a `push` loop (a builtin works on a Vec
            // field of `*c`).
            let mut mb: Vec<u8> = vec_new();
            mir_dump_fn(&mut mb, c, src, name_s, name_e, rty);
            let mbn: i64 = len(mb);
            let mut mbi: i64 = 0;
            while mbi < mbn {
                push(&mut (*c).mirout, mb[mbi]);
                mbi = mbi + 1;
            }
            let _mbx: [u8] = vec_to_array(mb);
            0
        };
        0
    } else {
        0
    };
    // (8/N) codegen: assemble the fn into cgout — header + hoisted allocas + body + ret.
    if cg_on(c) {
        cg_emit_fn(c, src, name_s, name_e, rty);
        0
    } else {
        0
    };
    push(out, ')');
    // (4h) clear the type-param scope so a following NON-generic decl (whose pass-2
    // typing doesn't call `tp_setup`) doesn't see this fn's type-params.
    tp_reset(c);
    0
}

// PASS-1.5 signature scan (was `scan_fn_ret`): position a cursor at the `fn` token
// `p1`, set up its type-param scope (`<…>`), and record its full SIGNATURE into the
// fn tables — `ufret` (return handle), `uftp` (type-param count, 0 = non-generic),
// and `ufps`/`ufpe` (the param-type slice into `ufpp`). All four push once per fn in
// source order, so they stay index-aligned. The type-param scope is reset after.
// Lets a forward-declared (and possibly generic) fn type + infer correctly at calls.
fn scan_fn_sig(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;     // at name
    cur = cur + 1;                 // skip name
    tp_setup(c, k, s, e, src, &mut cur);   // parse `<…>` type-params (advances past `>`)
    let ntp: i64 = len((*c).tpns);
    cur = cur + 1;                 // skip `(`
    let ps: i64 = len((*c).ufpp);
    scan_paramtypes(k, s, e, src, &mut cur, c, gb);
    let pe: i64 = len((*c).ufpp);
    cur = cur + 1;                 // skip `->`
    let rte: TypeE = parse_type(k, s, e, src, &mut cur);
    let rty: i64 = type_of_typeexpr(c, rte, gb);
    push(&mut (*c).ufret, rty);
    push(&mut (*c).uftp, ntp);
    push(&mut (*c).ufps, ps);
    push(&mut (*c).ufpe, pe);
    tp_reset(c);
    0
}

// Walk a param list (no emit, no var-bind) recording each param's type handle into
// `ufpp` (for generic-call unification) — mirrors `emit_tparams`'s token walk under
// the active type-param scope. Ends past `)`.
fn scan_paramtypes(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_paramtypes(k, s, e, src, cur, c, gb)
    } else {
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;           // skip name
        *cur = *cur + 1;           // skip `:`
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pty: i64 = type_of_typeexpr(c, pte, gb);
        push(&mut (*c).ufpp, pty);
        scan_paramtypes(k, s, e, src, cur, c, gb)
    }
}

// (4c-1) emit a struct decl head from the struct + field tables:
// `(struct #sid Name (field name <type>)…)`.
fn type_struct(out: &mut Vec<u8>, c: &mut TyCtx, sid: i64) -> i64 {
    append_str(out, "(struct #");
    append_int(out, sid);
    push(out, ' ');
    let ns: i64 = (*c).sts[sid];
    let ne: i64 = (*c).ste[sid];
    let mut bi: i64 = ns;
    while bi < ne {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    let nf: i64 = len((*c).fldo);
    let mut i: i64 = 0;
    while i < nf {
        if (*c).fldo[i] == sid {
            append_str(out, " (field ");
            let fs: i64 = (*c).flds[i];
            let fe: i64 = (*c).flde[i];
            let mut fi2: i64 = fs;
            while fi2 < fe {
                push(out, (*c).snb[fi2]);
                fi2 = fi2 + 1;
            }
            push(out, ' ');
            let fh: i64 = (*c).fldty[i];
            render_type(out, fh, c);
            push(out, ')');
            0
        } else {
            0
        };
        i = i + 1;
    }
    push(out, ')');
    0
}

// PASS-1.5 struct-field scan: record each field `(StructId, name, type-handle)`
// into the field table. Runs after ALL struct NAMES are registered (pass 1), so
// a field type referencing another struct resolves.
fn scan_struct_fields(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, sid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;     // at name
    cur = cur + 1;                 // skip name
    // (4h) set up the struct's type-param scope so field types reference `<T#i>`
    // (`struct Box<T> { value: T }` → field `value: <T#0>`); `tp_setup` advances
    // past `>` (or no-ops, leaving the cursor at `{`).
    tp_setup(c, k, s, e, src, &mut cur);
    cur = cur + 1;                 // skip `{`
    scan_fields_loop(k, s, e, src, &mut cur, sid, c, gb);
    tp_reset(c)
}

fn scan_fields_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, sid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_fields_loop(k, s, e, src, cur, sid, c, gb)
    } else {
        let fnm_s: i64 = (*s)[*cur];
        let fnm_e: i64 = (*e)[*cur];
        *cur = *cur + 1;           // skip name
        *cur = *cur + 1;           // skip `:`
        let fte: TypeE = parse_type(k, s, e, src, cur);
        let fth: i64 = type_of_typeexpr(c, fte, gb);
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = fnm_s;
        while bi < fnm_e {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        push(&mut (*c).fldo, sid);
        push(&mut (*c).flds, bst);
        push(&mut (*c).flde, bst + (fnm_e - fnm_s));
        push(&mut (*c).fldty, fth);
        scan_fields_loop(k, s, e, src, cur, sid, c, gb)
    }
}

// (4e) emit an enum decl head from the enum + variant tables (UNCHANGED from
// resolve — payload types need no inference, but rendered from the interned
// handles): `(enum #eid Name (variant V <payload-types>…)…)`.
fn type_enum(out: &mut Vec<u8>, c: &mut TyCtx, eid: i64) -> i64 {
    append_str(out, "(enum #");
    append_int(out, eid);
    push(out, ' ');
    let ns: i64 = (*c).ets[eid];
    let ne: i64 = (*c).ete[eid];
    let mut bi: i64 = ns;
    while bi < ne {
        push(out, (*c).snb[bi]);
        bi = bi + 1;
    }
    let nv: i64 = len((*c).varo);
    let mut i: i64 = 0;
    while i < nv {
        if (*c).varo[i] == eid {
            append_str(out, " (variant ");
            let vs: i64 = (*c).varns[i];
            let ve: i64 = (*c).varne[i];
            let mut vi2: i64 = vs;
            while vi2 < ve {
                push(out, (*c).snb[vi2]);
                vi2 = vi2 + 1;
            }
            let ps: i64 = (*c).varps[i];
            let pe: i64 = (*c).varpe[i];
            let mut pj: i64 = ps;
            while pj < pe {
                push(out, ' ');
                let ph: i64 = (*c).varpay[pj];
                render_type(out, ph, c);
                pj = pj + 1;
            }
            push(out, ')');
            0
        } else {
            0
        };
        i = i + 1;
    }
    push(out, ')');
    0
}

// PASS-1.5 enum-variant scan: record each variant `(EnumId, name, payload-type
// slice)` into the variant table (payload types interned into `varpay`). Runs after
// ALL decl NAMES are registered (pass 1), so a payload type referencing any
// struct/enum resolves.
fn scan_enum_variants(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;     // at name
    cur = cur + 1;                 // skip name
    cur = cur + 1;                 // skip `{` (enums are non-generic)
    scan_evar_loop(k, s, e, src, &mut cur, eid, c, gb)
}

fn scan_evar_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_evar_loop(k, s, e, src, cur, eid, c, gb)
    } else {
        let vn_s: i64 = (*s)[*cur];
        let vn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;           // skip variant name
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = vn_s;
        while bi < vn_e {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        let pst: i64 = len((*c).varpay);
        if (*k)[*cur] == 4 {
            *cur = *cur + 1;       // skip `(`
            scan_payloads(k, s, e, src, cur, c, gb);
            0
        } else {
            0
        };
        let pen: i64 = len((*c).varpay);
        push(&mut (*c).varo, eid);
        push(&mut (*c).varns, bst);
        push(&mut (*c).varne, bst + (vn_e - vn_s));
        push(&mut (*c).varps, pst);
        push(&mut (*c).varpe, pen);
        scan_evar_loop(k, s, e, src, cur, eid, c, gb)
    }
}

// Parse + intern a variant's positional payload types into `varpay`. Ends past `)`.
fn scan_payloads(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_payloads(k, s, e, src, cur, c, gb)
    } else {
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pth: i64 = type_of_typeexpr(c, pte, gb);
        push(&mut (*c).varpay, pth);
        scan_payloads(k, s, e, src, cur, c, gb)
    }
}

// --- (4f) class decl scanning + emit ---------------------------------------

// `init` is lexed as a plain ident; detect it by its 4 bytes (mirror resolve).
fn is_init_slice(src: &[u8], st: i64, en: i64) -> bool {
    if en - st != 4 {
        false
    } else {
        ((*src)[st] == 'i') && ((*src)[st + 1] == 'n') && ((*src)[st + 2] == 'i') && ((*src)[st + 3] == 't')
    }
}

// Parse a `self: &Self` / `self: &mut Self` receiver from `(` (cursor at `self`);
// return whether it is `&mut` (exclusive). Advances past `Self`.
fn tparse_self_kind(k: &Vec<i64>, cur: &mut i64) -> bool {
    *cur = *cur + 1;             // skip `self`
    *cur = *cur + 1;             // skip `:`
    *cur = *cur + 1;             // skip `&`
    let excl: bool = (*k)[*cur] == 46;
    if excl {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;             // skip `Self`
    excl
}

// Skip a `( … )` list (no nested parens in Sentinel param/type syntax). Cursor at `(`.
fn skip_paren_list(k: &Vec<i64>, cur: &mut i64) -> i64 {
    *cur = *cur + 1;             // skip `(`
    while (*k)[*cur] != 5 {
        *cur = *cur + 1;
    }
    *cur = *cur + 1;             // skip `)`
    0
}

// Skip a `{ … }` brace-balanced block. Cursor at `{`.
fn skip_brace_block(k: &Vec<i64>, cur: &mut i64) -> i64 {
    *cur = *cur + 1;             // skip `{`
    let mut depth: i64 = 1;
    while depth > 0 {
        let t: i64 = (*k)[*cur];
        if t == 6 {
            depth = depth + 1;
            0
        } else if t == 7 {
            depth = depth - 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;
    }
    0
}

// Skip to past the next `;` (kind 44) — a delegate decl (synthesis is 4f-delegate).
fn skip_to_semi(k: &Vec<i64>, cur: &mut i64) -> i64 {
    while (*k)[*cur] != 44 {
        *cur = *cur + 1;
    }
    *cur = *cur + 1;
    0
}

// PASS-1.5 class-field scan: record `(ClassId, name, type)` into the class-field
// table. Cursor at `let`.
fn scan_cfield(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `let`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `;`
    let bst: i64 = len((*c).snb);
    let mut bi: i64 = fn_s;
    while bi < fn_e {
        push(&mut (*c).snb, (*src)[bi]);
        bi = bi + 1;
    }
    push(&mut (*c).clfo, cid);
    push(&mut (*c).clfs, bst);
    push(&mut (*c).clfe, bst + (fn_e - fn_s));
    push(&mut (*c).clft, fth);
    0
}

// PASS-1.5 class-method scan: record `(ClassId, name, return-type)` + SKIP the body.
// Cursor at `fn`.
fn scan_cmethod(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    skip_paren_list(k, cur);     // skip `( self… params )`
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let bst: i64 = len((*c).snb);
    let mut bi: i64 = mn_s;
    while bi < mn_e {
        push(&mut (*c).snb, (*src)[bi]);
        bi = bi + 1;
    }
    push(&mut (*c).clmo, cid);
    push(&mut (*c).clms, bst);
    push(&mut (*c).clme, bst + (mn_e - mn_s));
    push(&mut (*c).clmr, mrth);
    skip_brace_block(k, cur);    // skip the method body
    0
}

// PASS-1.5 delegate scan: `delegate name : T to Trait ;` records a delegate record
// driving the synthesised forwarding impl (group D). ⚠ (4i) the class FIELD + its
// index (`dgfx`) are NOT registered here — they are APPENDED after `scan_cmem_loop`
// (`register_delegate_fields`), so the delegate field comes AFTER all regular fields
// regardless of source order (the oracle buckets regular fields first, delegates
// last — c4_go_no_go declares `delegate` BEFORE a `let`). dgfx therefore lags dgcid
// until that post-pass (nothing reads it until pass 2's synthesis).
fn scan_cdelegate(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `delegate`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip field name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `to`
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip trait name
    *cur = *cur + 1;             // skip `;`
    push(&mut (*c).dgcid, cid);
    push(&mut (*c).dgfs, fn_s);
    push(&mut (*c).dgfe, fn_e);
    push(&mut (*c).dgft, fth);
    push(&mut (*c).dgts, tr_s);
    push(&mut (*c).dgte, tr_e);
    0
}

// (4i) Append the delegate fields for delegate records `[dg0, dg1)` (the ones added
// by THIS class's `scan_cmem_loop`) to the class-field table — AFTER all its regular
// `let` fields — and push each field's index into `dgfx` (which stayed aligned with
// `dgcid` across classes, since each class appends its delegate fields contiguously).
fn register_delegate_fields(c: &mut TyCtx, src: &[u8], cid: i64, dg0: i64, dg1: i64) -> i64 {
    let mut di: i64 = dg0;
    while di < dg1 {
        let dfs: i64 = (*c).dgfs[di];
        let dfe: i64 = (*c).dgfe[di];
        let dft: i64 = (*c).dgft[di];
        // the field index = the current count of fields already registered for `cid`.
        let nf: i64 = len((*c).clfo);
        let mut fi: i64 = 0;
        let mut fcount: i64 = 0;
        while fi < nf {
            if (*c).clfo[fi] == cid {
                fcount = fcount + 1;
                0
            } else {
                0
            };
            fi = fi + 1;
        }
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = dfs;
        while bi < dfe {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        push(&mut (*c).clfo, cid);
        push(&mut (*c).clfs, bst);
        push(&mut (*c).clfe, bst + (dfe - dfs));
        push(&mut (*c).clft, dft);
        push(&mut (*c).dgfx, fcount);
        di = di + 1;
    }
    0
}

fn scan_class_members(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `class`
    cur = cur + 1;               // skip name
    cur = cur + 1;               // skip `{`
    // (4i) scan regular fields/methods/init + record delegate metadata, THEN append the
    // delegate fields after all regular fields (the oracle's field order).
    let dg0: i64 = len((*c).dgcid);
    scan_cmem_loop(k, s, e, src, &mut cur, cid, c, gb);
    let dg1: i64 = len((*c).dgcid);
    register_delegate_fields(c, src, cid, dg0, dg1)
}

fn scan_cmem_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, cid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;         // skip a per-item `pub`
        0
    } else {
        0
    };
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 45 {
        scan_cfield(k, s, e, src, cur, cid, c, gb);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    } else if t == 3 {
        scan_cmethod(k, s, e, src, cur, cid, c, gb);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    } else if is_init_slice(src, (*s)[*cur], (*e)[*cur]) {
        *cur = *cur + 1;         // skip `init`
        skip_paren_list(k, cur);
        skip_brace_block(k, cur);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    } else {
        scan_cdelegate(k, s, e, src, cur, cid, c, gb);
        scan_cmem_loop(k, s, e, src, cur, cid, c, gb)
    }
}

// (4f) emit a class field head: ` (field name <type>)`. Cursor at `let`.
fn tclass_field(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `let`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `;`
    append_str(buf, " (field ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    render_type(buf, fth, c);
    push(buf, ')');
    0
}

// (4f) emit + type a class init: ` (init #selfvid (params) <typed-body>)`. The init's
// `self` is SYNTHETIC (no receiver token) → bind the literal `self`, typed as the
// class. Cursor at `init`.
fn tclass_init(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    (*c).base = len((*c).scs);
    *cur = *cur + 1;             // skip `init`
    *cur = *cur + 1;             // skip `(`
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let clty: i64 = mk_class(c, cid);
    bind_name(c, "self", selfvid, clty);
    append_str(buf, " (init #");
    append_int(buf, selfvid);
    append_str(buf, " (");
    emit_tparams(buf, k, s, e, src, cur, c, gb, true);
    append_str(buf, ") ");
    let ibody: Expr = parse_block(k, s, e, src, cur);
    dump_texpr(buf, ibody, 0 - 1, src, c, gb);
    push(buf, ')');
    0
}

// (4f) emit + type a class/impl method: ` (method #selfvid name <kind> (params) ret
// <typed-body>)`. `self` is the receiver token, typed as the owning class. Cursor at
// `fn`. The body's expectation is the return type (so a `?T`/secret method widens).
fn tmethod(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    (*c).base = len((*c).scs);
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `(`
    let self_s: i64 = (*s)[*cur];
    let self_e: i64 = (*e)[*cur];
    let excl: bool = tparse_self_kind(k, cur);
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let clty: i64 = mk_class(c, cid);
    bind_src(c, src, self_s, self_e, selfvid, clty);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(buf, " (method #");
    append_int(buf, selfvid);
    push(buf, ' ');
    append_slice(buf, src, mn_s, mn_e);
    push(buf, ' ');
    append_str(buf, skw);
    append_str(buf, " (");
    emit_tparams(buf, k, s, e, src, cur, c, gb, true);
    append_str(buf, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    let mbody: Expr = parse_block(k, s, e, src, cur);
    render_type(buf, mrth, c);
    push(buf, ' ');
    dump_texpr(buf, mbody, mrth, src, c, gb);
    push(buf, ')');
    0
}

// (4f-delegate) emit a delegate's class FIELD ` (field name <type>)` (into the
// delegate-field bucket — after explicit fields). Cursor at `delegate`.
fn tclass_delegate_field(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `delegate`
    let fn_s: i64 = (*s)[*cur];
    let fn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `:`
    let fte: TypeE = parse_type(k, s, e, src, cur);
    let fth: i64 = type_of_typeexpr(c, fte, gb);
    *cur = *cur + 1;             // skip `to`
    *cur = *cur + 1;             // skip trait name
    *cur = *cur + 1;             // skip `;`
    append_str(buf, " (field ");
    append_slice(buf, src, fn_s, fn_e);
    push(buf, ' ');
    render_type(buf, fth, c);
    push(buf, ')');
    0
}

// (4f) walk a class body, BUCKETING items into fields / delegate-fields / init /
// methods buffers (mirror resolve / the parser — the dump emits explicit fields,
// then delegate fields, then init, then methods).
fn tclass_items(fbuf: &mut Vec<u8>, dfbuf: &mut Vec<u8>, ibuf: &mut Vec<u8>, mbuf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    if (*k)[*cur] == 59 {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 45 {
        tclass_field(fbuf, k, s, e, src, cur, c, gb);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else if t == 3 {
        tmethod(mbuf, k, s, e, src, cur, c, gb, cid);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else if is_init_slice(src, (*s)[*cur], (*e)[*cur]) {
        tclass_init(ibuf, k, s, e, src, cur, c, gb, cid);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    } else {
        tclass_delegate_field(dfbuf, k, s, e, src, cur, c, gb);
        tclass_items(fbuf, dfbuf, ibuf, mbuf, k, s, e, src, cur, c, gb, cid)
    }
}

// (4f) emit a class decl head `(class #cid Name (field …) (init …)? (method …)…)`.
fn type_class(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    *cur = *cur + 1;             // skip `class`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `{`
    let mut fbuf: Vec<u8> = vec_new();
    let mut dfbuf: Vec<u8> = vec_new();
    let mut ibuf: Vec<u8> = vec_new();
    let mut mbuf: Vec<u8> = vec_new();
    tclass_items(&mut fbuf, &mut dfbuf, &mut ibuf, &mut mbuf, k, s, e, src, cur, c, gb, cid);
    append_str(out, "(class #");
    append_int(out, cid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    append_str(out, vec_to_array(fbuf));
    append_str(out, vec_to_array(dfbuf));
    append_str(out, vec_to_array(ibuf));
    append_str(out, vec_to_array(mbuf));
    push(out, ')');
    0
}

// --- (4f) trait + impl decl scanning + emit --------------------------------

// Compare a `src` slice [ss,se) to an `snb` slice [bs,be).
fn src_eq_snb(c: &mut TyCtx, bs: i64, be: i64, src: &[u8], ss: i64, se: i64) -> bool {
    if be - bs != se - ss {
        false
    } else {
        let n: i64 = be - bs;
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < n {
            if (*c).snb[bs + i] != (*src)[ss + i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Resolve a `src` slice to a TraitId / ClassId, or -1.
fn trait_lookup_slice(c: &mut TyCtx, src: &[u8], ss: i64, se: i64) -> i64 {
    let n: i64 = len((*c).trns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if src_eq_snb(c, (*c).trns[i], (*c).trne[i], src, ss, se) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

fn class_lookup_slice(c: &mut TyCtx, src: &[u8], ss: i64, se: i64) -> i64 {
    let n: i64 = len((*c).clns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if src_eq_snb(c, (*c).clns[i], (*c).clne[i], src, ss, se) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// PASS-1.5 trait-method scan: record `(TraitId, name, return-type)` into the
// trait-method table (sigs only — no bodies/VarIds).
fn scan_trait_methods(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, tid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `trait`
    cur = cur + 1;               // skip name
    cur = cur + 1;               // skip `{`
    scan_trm_loop(k, s, e, src, &mut cur, tid, c, gb)
}

fn scan_trm_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, tid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else {
        *cur = *cur + 1;         // skip `fn`
        let mn_s: i64 = (*s)[*cur];
        let mn_e: i64 = (*e)[*cur];
        *cur = *cur + 1;         // skip name
        skip_paren_list(k, cur);
        *cur = *cur + 1;         // skip `->`
        let mret: TypeE = parse_type(k, s, e, src, cur);
        let mrth: i64 = type_of_typeexpr(c, mret, gb);
        if (*k)[*cur] == 24 {
            skip_effect_row(k, cur)
        } else {
            0
        };
        *cur = *cur + 1;         // skip `;`
        let bst: i64 = len((*c).snb);
        let mut bi: i64 = mn_s;
        while bi < mn_e {
            push(&mut (*c).snb, (*src)[bi]);
            bi = bi + 1;
        }
        push(&mut (*c).trmo, tid);
        push(&mut (*c).trms, bst);
        push(&mut (*c).trme, bst + (mn_e - mn_s));
        push(&mut (*c).trmr, mrth);
        scan_trm_loop(k, s, e, src, cur, tid, c, gb)
    }
}

// PASS-1.5 impl-header scan: resolve the impl's trait + target class, push into the
// impl table (aligned by ImplId with the pass-1 name registration). The header is
// `impl [Name as]? Trait for Type {`.
fn scan_impl_header(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, c: &mut TyCtx) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `impl`
    if (*k)[cur] != 60 {
        cur = cur + 1;           // skip the impl name (present unless next is `as`)
        0
    } else {
        0
    };
    cur = cur + 1;               // skip `as`
    let tr_s: i64 = (*s)[cur];
    let tr_e: i64 = (*e)[cur];
    cur = cur + 1;               // trait name
    cur = cur + 1;               // skip `for`
    let ty_s: i64 = (*s)[cur];
    let ty_e: i64 = (*e)[cur];
    let tid: i64 = trait_lookup_slice(c, src, tr_s, tr_e);
    let cid: i64 = class_lookup_slice(c, src, ty_s, ty_e);
    push(&mut (*c).imtid, tid);
    push(&mut (*c).imcid, cid);
    0
}

// (4f) trait-method sig params: ` (param [mut] name <type>)…` — NO VarIds (sigs).
fn emit_trait_params(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, first: bool) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        emit_trait_params(out, k, s, e, src, cur, c, gb, first)
    } else {
        if first {
            0
        } else {
            push(out, ' ');
            0
        };
        let pm: bool = (*k)[*cur] == 46;
        if pm {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        let ns: i64 = (*s)[*cur];
        let ne: i64 = (*e)[*cur];
        *cur = *cur + 1;
        *cur = *cur + 1;         // skip `:`
        let pte: TypeE = parse_type(k, s, e, src, cur);
        let pth: i64 = type_of_typeexpr(c, pte, gb);
        append_str(out, "(param ");
        if pm {
            append_str(out, "mut ")
        } else {
            0
        };
        append_slice(out, src, ns, ne);
        push(out, ' ');
        render_type(out, pth, c);
        push(out, ')');
        emit_trait_params(out, k, s, e, src, cur, c, gb, false)
    }
}

// (4f) one trait method sig head: ` (method name <kind> (params) ret`. Cursor at `fn`.
fn ttrait_method_head(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `(`
    let excl: bool = tparse_self_kind(k, cur);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(out, " (method ");
    append_slice(out, src, mn_s, mn_e);
    push(out, ' ');
    append_str(out, skw);
    append_str(out, " (");
    emit_trait_params(out, k, s, e, src, cur, c, gb, true);
    append_str(out, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    render_type(out, mrth, c);
    0
}

fn ttrait_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else {
        ttrait_method_head(out, k, s, e, src, cur, c, gb);
        *cur = *cur + 1;         // skip `;`
        push(out, ')');
        ttrait_methods(out, k, s, e, src, cur, c, gb)
    }
}

// (4f) emit a trait decl head `(trait #tid Name (method name kind (params) ret)…)`.
fn type_trait(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, tid: i64) -> i64 {
    *cur = *cur + 1;             // skip `trait`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `{`
    append_str(out, "(trait #");
    append_int(out, tid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    ttrait_methods(out, k, s, e, src, cur, c, gb);
    push(out, ')');
    0
}

// (4f) impl methods: each reuses `tmethod` (self typed as the impl's class). The
// per-method `pub` is skipped.
fn timpl_methods(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 59 {
        *cur = *cur + 1;         // skip a per-method `pub`
        timpl_methods(out, k, s, e, src, cur, c, gb, cid)
    } else {
        tmethod(out, k, s, e, src, cur, c, gb, cid);
        timpl_methods(out, k, s, e, src, cur, c, gb, cid)
    }
}

// (4f) emit an impl decl head `(impl #iid name #tid Trait class#cid Type (method …)…)`
// with TYPED method bodies. The trait + class were resolved in pass-1.5 (`imtid`/
// `imcid`). The header is `impl [Name as]? Trait for Type {`.
fn type_impl(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, iid: i64) -> i64 {
    *cur = *cur + 1;             // skip `impl`
    let has_name: bool = (*k)[*cur] != 60;
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    if has_name {
        *cur = *cur + 1;
        0
    } else {
        0
    };
    *cur = *cur + 1;             // skip `as`
    let tr_s: i64 = (*s)[*cur];
    let tr_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // trait name
    *cur = *cur + 1;             // skip `for`
    let ty_s: i64 = (*s)[*cur];
    let ty_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // type name
    *cur = *cur + 1;             // skip `{`
    let tid: i64 = (*c).imtid[iid];
    let cid: i64 = (*c).imcid[iid];
    append_str(out, "(impl #");
    append_int(out, iid);
    push(out, ' ');
    if has_name {
        append_slice(out, src, nm_s, nm_e);
        0
    } else {
        push(out, '_');
        0
    };
    push(out, ' ');
    push(out, '#');
    append_int(out, tid);
    push(out, ' ');
    append_slice(out, src, tr_s, tr_e);
    append_str(out, " class#");
    append_int(out, cid);
    push(out, ' ');
    append_slice(out, src, ty_s, ty_e);
    timpl_methods(out, k, s, e, src, cur, c, gb, cid);
    push(out, ')');
    0
}

// --- (4f-delegate) forwarding-impl synthesis (ADR 0040 A12) -----------------
// `class C { delegate f: T to Tr; }` synthesises `impl _ as Tr for C` whose every
// method (from Tr's sigs) is `fn m(self,p…) { self.f.m(p…) }` — a method-dispatch on
// the delegate field. The body is SYNTHESISED (no source), emitted directly.

// The forwarding receiver `(field (var #selfvid :Class) name fidx :FieldType)`.
fn synth_receiver(buf: &mut Vec<u8>, c: &mut TyCtx, clty: i64, selfvid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64, src: &[u8]) -> i64 {
    append_str(buf, "(field (var #");
    append_int(buf, selfvid);
    append_str(buf, " :");
    render_type(buf, clty, c);
    append_str(buf, ") ");
    append_slice(buf, src, fld_s, fld_e);
    push(buf, ' ');
    append_int(buf, fidx);
    append_str(buf, " :");
    render_type(buf, fty, c);
    push(buf, ')');
    0
}

// The forwarding args ` (var #pvid :ptype)…` (the synth method's params, by VarId).
fn synth_args(buf: &mut Vec<u8>, c: &mut TyCtx, pv0: i64, pvn: i64) -> i64 {
    let mut pv: i64 = pv0;
    while pv < pvn {
        let pty: i64 = env_get(c, pv);
        append_str(buf, " (var #");
        append_int(buf, pv);
        append_str(buf, " :");
        render_type(buf, pty, c);
        push(buf, ')');
        pv = pv + 1;
    }
    0
}

// The forwarding body: a method-dispatch of `m` on `self.field` (the SAME split as a
// real method call — the field's class's own method vs a default-impl method).
fn synth_forward(buf: &mut Vec<u8>, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64, selfvid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64, mn_s: i64, mn_e: i64, src: &[u8], pv0: i64, pvn: i64, mrth: i64) -> i64 {
    // build the method name as a `[u8]` for the dispatch lookups, then sink it.
    let mut mnbuf: Vec<u8> = vec_new();
    let mut mi: i64 = mn_s;
    while mi < mn_e {
        push(&mut mnbuf, (*src)[mi]);
        mi = mi + 1;
    }
    let mn_arr: [u8] = vec_to_array(mnbuf);
    let rcid: i64 = class_of_handle(c, strip_ref(c, fty));
    let own: bool = class_has_method(c, rcid, &mn_arr);
    let oidx: i64 = if own {
        class_method_index(c, rcid, &mn_arr)
    } else {
        0 - 1
    };
    let iid: i64 = if own {
        0 - 1
    } else {
        impl_for_class(c, rcid, &mn_arr)
    };
    let itid: i64 = impl_trait_of(c, iid);
    let iidx: i64 = if own {
        0 - 1
    } else {
        trait_method_index(c, itid, &mn_arr)
    };
    sink_name(gb, mn_arr);
    let clty: i64 = mk_class(c, cid);
    if own {
        append_str(buf, "(method #");
        append_int(buf, rcid);
        push(buf, ' ');
        append_int(buf, oidx);
        push(buf, ' ');
        synth_receiver(buf, c, clty, selfvid, fld_s, fld_e, fidx, fty, src);
        push(buf, ' ');
        append_slice(buf, src, mn_s, mn_e);
        synth_args(buf, c, pv0, pvn);
        append_str(buf, " :");
        render_type(buf, mrth, c);
        push(buf, ')');
        0
    } else {
        append_str(buf, "(impl-method #");
        append_int(buf, iid);
        push(buf, ' ');
        append_int(buf, iidx);
        push(buf, ' ');
        synth_receiver(buf, c, clty, selfvid, fld_s, fld_e, fidx, fty, src);
        push(buf, ' ');
        append_slice(buf, src, mn_s, mn_e);
        synth_args(buf, c, pv0, pvn);
        append_str(buf, " :");
        render_type(buf, mrth, c);
        push(buf, ')');
        0
    }
}

// One synthesised forwarding method (from a trait method SIG; cursor at `fn`): the
// `self` (synthetic, typed as the delegating class) + params get fresh VarIds; the
// body forwards to `self.field.m(params)`.
fn synth_one_method(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64) -> i64 {
    (*c).base = len((*c).scs);
    *cur = *cur + 1;             // skip `fn`
    let mn_s: i64 = (*s)[*cur];
    let mn_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `(`
    let excl: bool = tparse_self_kind(k, cur);
    let selfvid: i64 = (*c).nextvid;
    (*c).nextvid = (*c).nextvid + 1;
    let clty: i64 = mk_class(c, cid);
    bind_name(c, "self", selfvid, clty);
    let skw: [u8] = if excl {
        "exclusive"
    } else {
        "shared"
    };
    append_str(buf, " (method #");
    append_int(buf, selfvid);
    push(buf, ' ');
    append_slice(buf, src, mn_s, mn_e);
    push(buf, ' ');
    append_str(buf, skw);
    append_str(buf, " (");
    let pv0: i64 = (*c).nextvid;
    emit_tparams(buf, k, s, e, src, cur, c, gb, true);
    let pvn: i64 = (*c).nextvid;
    append_str(buf, ") ");
    *cur = *cur + 1;             // skip `->`
    let mret: TypeE = parse_type(k, s, e, src, cur);
    let mrth: i64 = type_of_typeexpr(c, mret, gb);
    if (*k)[*cur] == 24 {
        skip_effect_row(k, cur)
    } else {
        0
    };
    render_type(buf, mrth, c);
    append_str(buf, " (block ");
    synth_forward(buf, c, gb, cid, selfvid, fld_s, fld_e, fidx, fty, mn_s, mn_e, src, pv0, pvn, mrth);
    append_str(buf, " :");
    render_type(buf, mrth, c);
    push(buf, ')');             // close block
    push(buf, ')');             // close method
    0
}

fn synth_methods(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, cid: i64, fld_s: i64, fld_e: i64, fidx: i64, fty: i64) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        0
    } else {
        synth_one_method(buf, k, s, e, src, cur, c, gb, cid, fld_s, fld_e, fidx, fty);
        *cur = *cur + 1;         // skip `;`
        synth_methods(buf, k, s, e, src, cur, c, gb, cid, fld_s, fld_e, fidx, fty)
    }
}

// (4f-delegate) synthesise `(impl #iid _ #tid Trait class#cid Class (method …)…)` for
// the `didx`-th delegate — re-walk the trait's method sigs, forwarding each.
fn synth_delegate_impl(buf: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, didx: i64, iid: i64) -> i64 {
    let cid: i64 = (*c).dgcid[didx];
    let trt_s: i64 = (*c).dgts[didx];
    let trt_e: i64 = (*c).dgte[didx];
    let fld_s: i64 = (*c).dgfs[didx];
    let fld_e: i64 = (*c).dgfe[didx];
    let fidx: i64 = (*c).dgfx[didx];
    let fty: i64 = (*c).dgft[didx];
    let tid: i64 = trait_lookup_slice(c, src, trt_s, trt_e);
    append_str(buf, "(impl #");
    append_int(buf, iid);
    append_str(buf, " _ #");
    append_int(buf, tid);
    push(buf, ' ');
    append_slice(buf, src, trt_s, trt_e);
    append_str(buf, " class#");
    append_int(buf, cid);
    push(buf, ' ');
    let cn_s: i64 = (*c).clns[cid];
    let cn_e: i64 = (*c).clne[cid];
    let mut ci: i64 = cn_s;
    while ci < cn_e {
        push(buf, (*c).snb[ci]);
        ci = ci + 1;
    }
    let tpos: i64 = (*c).trpos[tid];
    let mut tcur: i64 = tpos + 1;   // skip `trait`
    tcur = tcur + 1;                // skip name
    tcur = tcur + 1;                // skip `{`
    synth_methods(buf, k, s, e, src, &mut tcur, c, gb, cid, fld_s, fld_e, fidx, fty);
    push(buf, ')');
    0
}

// --- (4g) effect decl scanning + emit --------------------------------------

// PASS-1.5: scan an effect's op params (counting them into `voff` — they consume
// global VarIds before any fn body, ADR 0020 — + disposing their types). Cursor at `(`.
fn scan_op_params(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    *cur = *cur + 1;             // skip `(`
    scan_opp_loop(k, s, e, src, cur, c, gb)
}

fn scan_opp_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 5 {
        *cur = *cur + 1;
        0
    } else if t == 29 {
        *cur = *cur + 1;
        scan_opp_loop(k, s, e, src, cur, c, gb)
    } else {
        if (*k)[*cur] == 46 {
            *cur = *cur + 1;
            0
        } else {
            0
        };
        *cur = *cur + 1;         // skip name
        *cur = *cur + 1;         // skip `:`
        let pte: TypeE = parse_type(k, s, e, src, cur);
        type_of_typeexpr(c, pte, gb);
        (*c).voff = (*c).voff + 1;
        scan_opp_loop(k, s, e, src, cur, c, gb)
    }
}

// PASS-1.5 effect-op scan: record each op `(EffectId, name, return-type)` into the
// op table + count its params into `voff`.
fn scan_effect_ops(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], p1: i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let mut cur: i64 = p1 + 1;   // skip `effect`
    cur = cur + 1;               // skip name
    cur = cur + 1;               // skip `{`
    scan_eop_loop(k, s, e, src, &mut cur, eid, c, gb)
}

fn scan_eop_loop(k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, eid: i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        scan_eop_loop(k, s, e, src, cur, eid, c, gb)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;         // skip op name
        scan_op_params(k, s, e, src, cur, c, gb);
        let rth: i64 = if (*k)[*cur] == 8 {
            *cur = *cur + 1;     // skip `->`
            let rt: TypeE = parse_type(k, s, e, src, cur);
            type_of_typeexpr(c, rt, gb)
        } else {
            0
        };
        push(&mut (*c).efoo, eid);
        push(&mut (*c).efos, on_s);
        push(&mut (*c).efoe, on_e);
        push(&mut (*c).efor, rth);
        scan_eop_loop(k, s, e, src, cur, eid, c, gb)
    }
}

// (4g) effect op heads: ` (op name (params) ret)…` (op params reuse the no-VarId
// trait-param emitter). Cursor at the first op (after the body `{`).
fn teffect_ops(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>) -> i64 {
    let t: i64 = (*k)[*cur];
    if t == 7 {
        *cur = *cur + 1;
        0
    } else if t == 44 {
        *cur = *cur + 1;
        teffect_ops(out, k, s, e, src, cur, c, gb)
    } else {
        let on_s: i64 = (*s)[*cur];
        let on_e: i64 = (*e)[*cur];
        *cur = *cur + 1;         // skip op name
        *cur = *cur + 1;         // skip `(`
        append_str(out, " (op ");
        append_slice(out, src, on_s, on_e);
        append_str(out, " (");
        emit_trait_params(out, k, s, e, src, cur, c, gb, true);
        append_str(out, ") ");
        if (*k)[*cur] == 8 {
            *cur = *cur + 1;     // skip `->`
            let rt: TypeE = parse_type(k, s, e, src, cur);
            let rth: i64 = type_of_typeexpr(c, rt, gb);
            render_type(out, rth, c);
            0
        } else {
            push(out, '_');
            0
        };
        push(out, ')');
        teffect_ops(out, k, s, e, src, cur, c, gb)
    }
}

// (4g) emit an effect decl head `(effect #eid Name (op name (params) ret)…)`.
fn type_effect(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64, c: &mut TyCtx, gb: &mut Vec<u8>, eid: i64) -> i64 {
    *cur = *cur + 1;             // skip `effect`
    let nm_s: i64 = (*s)[*cur];
    let nm_e: i64 = (*e)[*cur];
    *cur = *cur + 1;             // skip name
    *cur = *cur + 1;             // skip `{`
    append_str(out, "(effect #");
    append_int(out, eid);
    push(out, ' ');
    append_slice(out, src, nm_s, nm_e);
    teffect_ops(out, k, s, e, src, cur, c, gb);
    push(out, ')');
    0
}

// Dispatch one top-level item on its kind (a SINGLE helper re-passing the `&mut`
// PARAMS — main's local `&mut out`/`&mut ctx` would conflict across sibling-if
// tails, ADR 0038 A2). `idx` = the fn index (FnId-14) or the StructId.
fn type_item(out: &mut Vec<u8>, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], c: &mut TyCtx, gb: &mut Vec<u8>, kind: i64, pos: i64, idx: i64) -> i64 {
    if kind == 3 {
        let mut cur: i64 = pos;
        type_fn(out, k, s, e, src, &mut cur, c, gb, idx)
    } else if kind == 52 {
        type_struct(out, c, idx)
    } else if kind == 53 {
        type_enum(out, c, idx)
    } else if kind == 56 {
        let mut curc: i64 = pos;
        type_class(out, k, s, e, src, &mut curc, c, gb, idx)
    } else if kind == 54 {
        let mut curt: i64 = pos;
        type_trait(out, k, s, e, src, &mut curt, c, gb, idx)
    } else if kind == 55 {
        let mut curi: i64 = pos;
        type_impl(out, k, s, e, src, &mut curi, c, gb, idx)
    } else if kind == 57 {
        let mut cure: i64 = pos;
        type_effect(out, k, s, e, src, &mut cure, c, gb, idx)
    } else {
        0
    }
}

// (6/N) the shared build pipeline (ADR 0043 D3 reuse): parse → resolve → type-check
// the whole program, computing the typed dump + the moved-sources side-table. `mode`
// 0 → write the `snc types` dump to `result`; mode 1 → write the `snc borrow`
// moved-sources dump (reused by `selfhost/borrow.sentinel`). `src` is consumed.
pub fn run(src: [u8], mode: i64, result: &mut Vec<u8>) -> i64 {
    let n: i64 = len(src);
    let mut kinds: Vec<i64> = vec_new();
    let mut starts: Vec<i64> = vec_new();
    let mut ends: Vec<i64> = vec_new();
    tokenize(&src, n, &mut kinds, &mut starts, &mut ends);
    let ntok: i64 = len(kinds);

    let mut ctx: TyCtx = TyCtx {
        tk: vec_new(),
        ta: vec_new(),
        tb: vec_new(),
        env: vec_new(),
        nb: vec_new(),
        scs: vec_new(),
        sce: vec_new(),
        scv: vec_new(),
        base: 0,
        nextvid: 0,
        ufs: vec_new(),
        ufe: vec_new(),
        ufret: vec_new(),
        snb: vec_new(),
        sts: vec_new(),
        ste: vec_new(),
        fldo: vec_new(),
        flds: vec_new(),
        flde: vec_new(),
        fldty: vec_new(),
        ets: vec_new(),
        ete: vec_new(),
        varo: vec_new(),
        varns: vec_new(),
        varne: vec_new(),
        varps: vec_new(),
        varpe: vec_new(),
        varpay: vec_new(),
        clns: vec_new(),
        clne: vec_new(),
        clfo: vec_new(),
        clfs: vec_new(),
        clfe: vec_new(),
        clft: vec_new(),
        clmo: vec_new(),
        clms: vec_new(),
        clme: vec_new(),
        clmr: vec_new(),
        trns: vec_new(),
        trne: vec_new(),
        trmo: vec_new(),
        trms: vec_new(),
        trme: vec_new(),
        trmr: vec_new(),
        imns: vec_new(),
        imne: vec_new(),
        imtid: vec_new(),
        imcid: vec_new(),
        trpos: vec_new(),
        dgcid: vec_new(),
        dgfs: vec_new(),
        dgfe: vec_new(),
        dgfx: vec_new(),
        dgft: vec_new(),
        dgts: vec_new(),
        dgte: vec_new(),
        efs: vec_new(),
        efe: vec_new(),
        efoo: vec_new(),
        efos: vec_new(),
        efoe: vec_new(),
        efor: vec_new(),
        voff: 0,
        tpb: vec_new(),
        tpns: vec_new(),
        tpne: vec_new(),
        uftp: vec_new(),
        ufps: vec_new(),
        ufpe: vec_new(),
        ufpp: vec_new(),
        gia: vec_new(),
        girs: vec_new(),
        gire: vec_new(),
        consuming: false,
        curfn: 0 - 1,
        mvf: vec_new(),
        mvv: vec_new(),
        mode: mode,
        lastval: 0 - 1,
        mir_cur: 0,
        mir_nblk: 0,
        mvty: vec_new(),
        miblk: vec_new(),
        midst: vec_new(),
        miop: vec_new(),
        misym: vec_new(),
        mia: vec_new(),
        mib: vec_new(),
        mbpb: vec_new(),
        mbpv: vec_new(),
        mtb: vec_new(),
        mtk: vec_new(),
        mta: vec_new(),
        mtt: vec_new(),
        mte: vec_new(),
        mtjs: vec_new(),
        mtje: vec_new(),
        mtj: vec_new(),
        mvdv: vec_new(),
        mvdl: vec_new(),
        mir_lastvid: 0 - 1,
        margs: vec_new(),
        mias: vec_new(),
        miae: vec_new(),
        miargs: vec_new(),
        mir_collecting: false,
        mir_suppress: false,
        mirout: vec_new(),
        cgnext: 0,
        cglk: 0,
        cglv: 0,
        cgsv: vec_new(),
        cgsr: vec_new(),
        cgpty: vec_new(),
        cgmain: false,
        cgak: vec_new(),
        cgav: vec_new(),
        cgat: vec_new(),
        cg_collecting: false,
        cg_used_alloc: false,
        cg_used_realloc: false,
        cg_used_panic: false,
        cg_used_streq: false,
        cg_used_rdfile: false,
        cg_used_wrfile: false,
        cg_used_prbytes: false,
        cg_used_memcpy: false,
        cg_used_free: false,
        cgdv: vec_new(),
        cgdt: vec_new(),
        cgds: vec_new(),
        cg_suppress: false,
        cg_lastvid: 0 - 1,
        cgbody: vec_new(),
        cgalloca_sl: vec_new(),
        cgalloca_ty: vec_new(),
        cg_to_body: false,
        cgblk: 0,
        cg_loop_cond: vec_new(),
        cg_loop_after: vec_new(),
        cg_loop_floor: vec_new(),
        cg_m_tag: 0 - 1,
        cg_m_payload: 0 - 1,
        cg_m_result: 0 - 1,
        cg_m_merge: 0 - 1,
        cg_m_armnext: 0 - 1,
        cg_m_pj: 0 - 1,
        cgout: vec_new(),
    };
    let mut garbage: Vec<u8> = vec_new();
    let mut out: Vec<u8> = vec_new();

    // Pass 1: brace-depth scan. Record top-level item NAMES only — `fn` (FnId 14+,
    // names in `ufs`/`ufe`) + `struct` (StructId, names copied into `snb`/`sts`/`ste`)
    // — in source order (`itempos`/`itemkind`); count user effects. NAMES first so
    // pass-1.5 field/return types (which may reference any struct) all resolve.
    let mut depth: i64 = 0;
    let mut ecount: i64 = 0;
    let mut itempos: Vec<i64> = vec_new();
    let mut itemkind: Vec<i64> = vec_new();
    let mut p1: i64 = 0;
    while p1 < ntok {
        let t1: i64 = kinds[p1];
        if t1 == 6 {
            depth = depth + 1;
            0
        } else if t1 == 7 {
            depth = depth - 1;
            0
        } else if depth == 0 {
            if t1 == 3 {
                push(&mut itempos, p1);
                push(&mut itemkind, 3);
                push(&mut ctx.ufs, starts[p1 + 1]);
                push(&mut ctx.ufe, ends[p1 + 1]);
                0
            } else if t1 == 52 {
                push(&mut itempos, p1);
                push(&mut itemkind, 52);
                let nss: i64 = starts[p1 + 1];
                let nen: i64 = ends[p1 + 1];
                let nst: i64 = len(ctx.snb);
                let mut nbi: i64 = nss;
                while nbi < nen {
                    push(&mut ctx.snb, src[nbi]);
                    nbi = nbi + 1;
                }
                push(&mut ctx.sts, nst);
                push(&mut ctx.ste, nst + (nen - nss));
                0
            } else if t1 == 53 {
                push(&mut itempos, p1);
                push(&mut itemkind, 53);
                let ess: i64 = starts[p1 + 1];
                let een: i64 = ends[p1 + 1];
                let est: i64 = len(ctx.snb);
                let mut ebi: i64 = ess;
                while ebi < een {
                    push(&mut ctx.snb, src[ebi]);
                    ebi = ebi + 1;
                }
                push(&mut ctx.ets, est);
                push(&mut ctx.ete, est + (een - ess));
                0
            } else if t1 == 56 {
                push(&mut itempos, p1);
                push(&mut itemkind, 56);
                let css: i64 = starts[p1 + 1];
                let cen: i64 = ends[p1 + 1];
                let cst: i64 = len(ctx.snb);
                let mut cbi: i64 = css;
                while cbi < cen {
                    push(&mut ctx.snb, src[cbi]);
                    cbi = cbi + 1;
                }
                push(&mut ctx.clns, cst);
                push(&mut ctx.clne, cst + (cen - css));
                0
            } else if t1 == 54 {
                push(&mut itempos, p1);
                push(&mut itemkind, 54);
                let tss: i64 = starts[p1 + 1];
                let ten: i64 = ends[p1 + 1];
                let tst: i64 = len(ctx.snb);
                let mut tbi: i64 = tss;
                while tbi < ten {
                    push(&mut ctx.snb, src[tbi]);
                    tbi = tbi + 1;
                }
                push(&mut ctx.trns, tst);
                push(&mut ctx.trne, tst + (ten - tss));
                push(&mut ctx.trpos, p1);
                0
            } else if t1 == 55 {
                push(&mut itempos, p1);
                push(&mut itemkind, 55);
                let hasn: bool = kinds[p1 + 1] != 60;
                let ist: i64 = len(ctx.snb);
                if hasn {
                    let iss: i64 = starts[p1 + 1];
                    let ien: i64 = ends[p1 + 1];
                    let mut ibi: i64 = iss;
                    while ibi < ien {
                        push(&mut ctx.snb, src[ibi]);
                        ibi = ibi + 1;
                    }
                    push(&mut ctx.imns, ist);
                    push(&mut ctx.imne, ist + (ien - iss));
                    0
                } else {
                    push(&mut ctx.imns, 0);
                    push(&mut ctx.imne, 0);
                    0
                };
                0
            } else if t1 == 57 {
                push(&mut itempos, p1);
                push(&mut itemkind, 57);
                push(&mut ctx.efs, starts[p1 + 1]);
                push(&mut ctx.efe, ends[p1 + 1]);
                ecount = ecount + 1;
                0
            } else {
                0
            }
        } else {
            0
        };
        p1 = p1 + 1;
    }

    // Pass 1.5: resolve fn return types (`ufret`, fn source order) + struct fields,
    // now that all top-level NAMES are registered.
    let ni: i64 = len(itempos);
    let mut q: i64 = 0;
    let mut sc2: i64 = 0;
    let mut ec2: i64 = 0;
    let mut cl2: i64 = 0;
    let mut tr2: i64 = 0;
    let mut ef2: i64 = 0;
    while q < ni {
        if itemkind[q] == 3 {
            scan_fn_sig(&kinds, &starts, &ends, &src, itempos[q], &mut ctx, &mut garbage);
            0
        } else if itemkind[q] == 52 {
            scan_struct_fields(&kinds, &starts, &ends, &src, itempos[q], sc2, &mut ctx, &mut garbage);
            sc2 = sc2 + 1;
            0
        } else if itemkind[q] == 53 {
            scan_enum_variants(&kinds, &starts, &ends, &src, itempos[q], ec2, &mut ctx, &mut garbage);
            ec2 = ec2 + 1;
            0
        } else if itemkind[q] == 56 {
            scan_class_members(&kinds, &starts, &ends, &src, itempos[q], cl2, &mut ctx, &mut garbage);
            cl2 = cl2 + 1;
            0
        } else if itemkind[q] == 54 {
            scan_trait_methods(&kinds, &starts, &ends, &src, itempos[q], tr2, &mut ctx, &mut garbage);
            tr2 = tr2 + 1;
            0
        } else if itemkind[q] == 55 {
            scan_impl_header(&kinds, &starts, &ends, &src, itempos[q], &mut ctx);
            0
        } else if itemkind[q] == 57 {
            scan_effect_ops(&kinds, &starts, &ends, &src, itempos[q], ef2, &mut ctx, &mut garbage);
            ef2 = ef2 + 1;
            0
        } else {
            0
        };
        q = q + 1;
    }

    // (4f-delegate) register the SYNTHESISED delegate impls (ImplId continues AFTER
    // all user impls; an unnamed `impl _` → a 0,0 name slot). Done before pass-2 so the
    // `l.write(…)` dispatch (group A) finds the synth impl via `impl_for_class`.
    let ndel: i64 = len(ctx.dgcid);
    let nuser: i64 = len(ctx.imns);
    let mut dr: i64 = 0;
    while dr < ndel {
        let dts: i64 = ctx.dgts[dr];
        let dte: i64 = ctx.dgte[dr];
        let dtid: i64 = trait_lookup_slice(&mut ctx, &src, dts, dte);
        let dcid: i64 = ctx.dgcid[dr];
        push(&mut ctx.imns, 0);
        push(&mut ctx.imne, 0);
        push(&mut ctx.imtid, dtid);
        push(&mut ctx.imcid, dcid);
        dr = dr + 1;
    }

    // Pass 2 — GROUP-ORDER emit (mirrors resolve / the Rust resolver: ALL fn bodies'
    // VarIds, THEN class bodies', THEN impl bodies' — lib.rs:2559 — but the DUMP is
    // SOURCE order). Each item is typed into the shared `itembuf` in GROUP order,
    // tagged with its source index (`rsrc`) + blob slice (`rbs`/`rbe`); then emitted
    // source-order. Group A = fns + structs + enums + traits + effects (fns advance
    // `nextvid`, the rest consume none); group B = classes; group C = impls. ⚠ the fn
    // region starts at `voff` (the Rust resolver assigns effect-op-param VarIds before
    // any fn body — ADR 0020), so every fn's VarIds are offset by the op-param count.
    // The env is VarId-indexed + append-only, so fill it with `voff` PHANTOM slots
    // first (the op-param VarIds are never referenced, but `env[voff]` — the first real
    // binding — must land at index voff).
    let vbase: i64 = ctx.voff;
    ctx.nextvid = vbase;
    let mut vph: i64 = 0;
    while vph < vbase {
        push(&mut ctx.env, 0);
        vph = vph + 1;
    }
    let mut itembuf: Vec<u8> = vec_new();
    let mut rsrc: Vec<i64> = vec_new();
    let mut rbs: Vec<i64> = vec_new();
    let mut rbe: Vec<i64> = vec_new();

    // Group A: fns + structs + enums + traits, in source order.
    let mut ia: i64 = 0;
    let mut fnct: i64 = 0;
    let mut sc3: i64 = 0;
    let mut ec3: i64 = 0;
    let mut tc3: i64 = 0;
    let mut ef3: i64 = 0;
    while ia < ni {
        let kda: i64 = itemkind[ia];
        if kda == 3 {
            let bsa: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 3, itempos[ia], fnct);
            push(&mut rsrc, ia);
            push(&mut rbs, bsa);
            push(&mut rbe, len(itembuf));
            fnct = fnct + 1;
            0
        } else if kda == 52 {
            let bss: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 52, itempos[ia], sc3);
            push(&mut rsrc, ia);
            push(&mut rbs, bss);
            push(&mut rbe, len(itembuf));
            sc3 = sc3 + 1;
            0
        } else if kda == 53 {
            let bse: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 53, itempos[ia], ec3);
            push(&mut rsrc, ia);
            push(&mut rbs, bse);
            push(&mut rbe, len(itembuf));
            ec3 = ec3 + 1;
            0
        } else if kda == 54 {
            let bst: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 54, itempos[ia], tc3);
            push(&mut rsrc, ia);
            push(&mut rbs, bst);
            push(&mut rbe, len(itembuf));
            tc3 = tc3 + 1;
            0
        } else if kda == 57 {
            let bsf: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 57, itempos[ia], ef3);
            push(&mut rsrc, ia);
            push(&mut rbs, bsf);
            push(&mut rbe, len(itembuf));
            ef3 = ef3 + 1;
            0
        } else {
            0
        };
        ia = ia + 1;
    }

    // Group B: classes (classvid = nextvid after fns).
    let mut ib: i64 = 0;
    let mut clct: i64 = 0;
    while ib < ni {
        if itemkind[ib] == 56 {
            let bsb: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 56, itempos[ib], clct);
            push(&mut rsrc, ib);
            push(&mut rbs, bsb);
            push(&mut rbe, len(itembuf));
            clct = clct + 1;
            0
        } else {
            0
        };
        ib = ib + 1;
    }

    // Group C: impls (implvid = nextvid after classes).
    let mut ic: i64 = 0;
    let mut imct: i64 = 0;
    while ic < ni {
        if itemkind[ic] == 55 {
            let bsc: i64 = len(itembuf);
            type_item(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, 55, itempos[ic], imct);
            push(&mut rsrc, ic);
            push(&mut rbs, bsc);
            push(&mut rbe, len(itembuf));
            imct = imct + 1;
            0
        } else {
            0
        };
        ic = ic + 1;
    }

    // Group D: SYNTHESISE delegate impls (ImplId + VarIds continue AFTER all user
    // impls — still the impl region). Each synth impl is recorded at its owning class's
    // SOURCE index, so it emits right after the class.
    let mut idd: i64 = 0;
    while idd < ndel {
        let dcid: i64 = ctx.dgcid[idd];
        // the owning class's source index = the (dcid)-th class item.
        let mut csrc: i64 = 0 - 1;
        let mut seen: i64 = 0;
        let mut qd: i64 = 0;
        while qd < ni {
            if csrc == 0 - 1 {
                if itemkind[qd] == 56 {
                    if seen == dcid {
                        csrc = qd;
                        0
                    } else {
                        0
                    };
                    seen = seen + 1;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            qd = qd + 1;
        }
        let bsd: i64 = len(itembuf);
        synth_delegate_impl(&mut itembuf, &kinds, &starts, &ends, &src, &mut ctx, &mut garbage, idd, nuser + idd);
        push(&mut rsrc, csrc);
        push(&mut rbs, bsd);
        push(&mut rbe, len(itembuf));
        idd = idd + 1;
    }

    // EMIT in source order: splice each item's `itembuf` slice (newline-separated).
    let nrec: i64 = len(rsrc);
    let mut si: i64 = 0;
    let mut first_item: bool = true;
    while si < ni {
        let mut j: i64 = 0;
        while j < nrec {
            if rsrc[j] == si {
                if first_item {
                    first_item = false;
                    0
                } else {
                    push(&mut out, '\n');
                    0
                };
                let mut bi: i64 = rbs[j];
                let bend: i64 = rbe[j];
                while bi < bend {
                    push(&mut out, itembuf[bi]);
                    bi = bi + 1;
                }
                0
            } else {
                0
            };
            j = j + 1;
        }
        si = si + 1;
    }

    // The built-in `Async` effect (id = user-effect count) dumps last.
    if first_item {
        0
    } else {
        push(&mut out, '\n');
        0
    };
    append_str(&mut out, "(effect #");
    append_int(&mut out, ecount);
    append_str(&mut out, " Async)");
    push(&mut out, '\n');

    // (6/N) mode 0 = the type dump (`snc types`); mode 1 = the moved-sources dump
    // (`snc borrow`, reusing this same build — ADR 0043).
    if mode == 0 {
        append_str(result, vec_to_array(out));
        0
    } else if mode == 1 {
        let _o: [u8] = vec_to_array(out);
        dump_moves(&mut ctx, &src, result);
        0
    } else if mode == 4 {
        // (8/N) mode 4 = the codegen .ll, accumulated per-fn in `ctx.cgout` during the
        // pass-2 walk (ADR 0045). Discard the type dump; write the module preamble then
        // copy cgout's BYTES into `result` (NOT vec_to_array — moving a Vec field out then
        // dropping the struct double-frees, as for mirout).
        let _o4: [u8] = vec_to_array(out);
        append_str(result, "target triple = \"arm64-apple-darwin\"\n\n");
        cg_pass0(result, &mut ctx);
        // (8c-2/8d) runtime-symbol declarations — only the symbols the bodies used,
        // in a FIXED order (matching the oracle), so a program using none stays
        // byte-identical to 8c-1.
        if ctx.cg_used_alloc {
            append_str(result, "declare ptr @sentinel_alloc(i64)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_realloc {
            append_str(result, "declare ptr @sentinel_realloc(ptr, i64)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_free {
            append_str(result, "declare void @sentinel_free(ptr)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_panic {
            append_str(result, "declare void @sentinel_panic_oob(i64, i64)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_streq {
            append_str(result, "declare i1 @sentinel_str_eq(ptr, i64, ptr, i64)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_rdfile {
            append_str(result, "declare ptr @sentinel_read_file(ptr, i64, ptr)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_wrfile {
            append_str(result, "declare i64 @sentinel_write_file(ptr, i64, ptr, i64)\n");
            0
        } else {
            0
        };
        if ctx.cg_used_prbytes {
            append_str(result, "declare i64 @sentinel_print_bytes(ptr, i64)\n");
            0
        } else {
            0
        };
        // (8d-Vec-2) the `llvm.memcpy` intrinsic declares LAST — after the
        // `sentinel_*` runtime-symbol group (it is an `@llvm.*` intrinsic, not a
        // runtime symbol), matching the oracle's `RuntimeSyms::emit_declares`.
        if ctx.cg_used_memcpy {
            append_str(result, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n");
            0
        } else {
            0
        };
        let cg_anydecl: bool = ctx.cg_used_alloc || ctx.cg_used_realloc || ctx.cg_used_free || ctx.cg_used_panic || ctx.cg_used_streq || ctx.cg_used_rdfile || ctx.cg_used_wrfile || ctx.cg_used_prbytes || ctx.cg_used_memcpy;
        if cg_anydecl {
            push(result, '\n');
            0
        } else {
            0
        };
        let cn: i64 = len(ctx.cgout);
        let mut ci: i64 = 0;
        while ci < cn {
            push(result, ctx.cgout[ci]);
            ci = ci + 1;
        }
        0
    } else {
        // (7/N) mode 2 = the MIR dump, accumulated per-fn in `ctx.mirout` during the
        // pass-2 walk. Discard the type dump; copy mirout's BYTES into `result` (NOT
        // vec_to_array — moving a Vec field out then dropping the struct double-frees).
        let _o2: [u8] = vec_to_array(out);
        let mn: i64 = len(ctx.mirout);
        let mut mi: i64 = 0;
        while mi < mn {
            push(result, ctx.mirout[mi]);
            mi = mi + 1;
        }
        0
    };
    let _it: [u8] = vec_to_array(itembuf);
    let _g: [u8] = vec_to_array(garbage);
    0
}

// (6/N) dump each user fn's moved-source set (ADR 0043 D2): `(fn #<id> <name> #<vid>…)`,
// the moved-from VarIds in ascending order (membership over the `mvf`/`mvv` side-table),
// one line per fn. (The `snc borrow` oracle's format.)
pub fn dump_moves(c: &mut TyCtx, src: &[u8], out: &mut Vec<u8>) -> i64 {
    let nf: i64 = len((*c).ufs);
    let nv: i64 = (*c).nextvid;
    let mut i: i64 = 0;
    while i < nf {
        append_str(out, "(fn #");
        append_int(out, 14 + i);
        push(out, ' ');
        append_slice(out, src, (*c).ufs[i], (*c).ufe[i]);
        let mut vid: i64 = 0;
        while vid < nv {
            let nm: i64 = len((*c).mvf);
            let mut j: i64 = 0;
            let mut found: bool = false;
            while j < nm {
                if (*c).mvf[j] == i {
                    if (*c).mvv[j] == vid {
                        found = true;
                        0
                    } else {
                        0
                    };
                    0
                } else {
                    0
                };
                j = j + 1;
            }
            if found {
                append_str(out, " #");
                append_int(out, vid);
                0
            } else {
                0
            };
            vid = vid + 1;
        }
        push(out, ')');
        push(out, '\n');
        i = i + 1;
    }
    0
}

// =============================================================================
// (7/N) MIR lowering (ADR 0044) — the mode-2 builder + dump. All pools are flat
// append-only parallel Vecs in TyCtx, tagged by block; reset PER FN. NO Vec
// index-assign (the resolve scope idiom for var_defs; tagged-pool scans for the
// per-block dump). Validated standalone by the (7a) probe.
// =============================================================================

fn clear_i64(v: &mut Vec<i64>) -> i64 {
    while len(*v) > 0 {
        let _x: i64 = pop(v);
        0
    }
    0
}

fn clear_u8(v: &mut Vec<u8>) -> i64 {
    while len(*v) > 0 {
        let _x: u8 = pop(v);
        0
    }
    0
}

// (7d) the MIR pools are built for mode 2 (dump the MIR) AND mode 3 (build, then run
// the const-time verifier over it). The per-fn dump-vs-verify differs (in `type_fn`).
fn mir_on(c: &mut TyCtx) -> bool {
    if (*c).mode == 2 {
        true
    } else if (*c).mode == 3 {
        true
    } else {
        false
    }
}

// (8/N) ADR 0045: the codegen .ll side-build is mode 4 (separate from the MIR side-build,
// so the two never co-fire — `mir_on` is now mode 2/3 only).
fn cg_on(c: &mut TyCtx) -> bool {
    (*c).mode == 4
}

// =============================================================================
// (8/N) codegen .ll emission (ADR 0045) — the mode-4 side-build. Text is pushed
// DIRECTLY onto `(*c).cgout` via the BUILTIN `push` (the only thing allowed to take
// `&mut (*c).field`); the `cgo_*` helpers consume any `[u8]` arg by value, so no
// local-buffer-fold is needed. Operands thread through `cglk`/`cglv`. NO phi —
// every binding is an alloca slot (`cgsv`/`cgsr`), reads load, writes store.
// =============================================================================

// Is the fn-name src slice exactly `main`? (byte-compare; no allocation → leak-free.)
fn cg_is_main(src: &[u8], st: i64, en: i64) -> bool {
    if en - st != 4 {
        false
    } else if (*src)[st] == 'm' {
        if (*src)[st + 1] == 'a' {
            if (*src)[st + 2] == 'i' {
                (*src)[st + 3] == 'n'
            } else {
                false
            }
        } else {
            false
        }
    } else {
        false
    }
}

// Reset the per-fn codegen state (between fns; `cgout` is NOT reset — it accumulates).
fn cg_reset(c: &mut TyCtx) -> i64 {
    clear_i64(&mut (*c).cgsv);
    clear_i64(&mut (*c).cgsr);
    clear_i64(&mut (*c).cgpty);
    clear_i64(&mut (*c).cgak);
    clear_i64(&mut (*c).cgav);
    clear_i64(&mut (*c).cgat);
    clear_u8(&mut (*c).cgbody);
    clear_i64(&mut (*c).cgalloca_sl);
    clear_i64(&mut (*c).cgalloca_ty);
    clear_i64(&mut (*c).cg_loop_cond);
    clear_i64(&mut (*c).cg_loop_after);
    clear_i64(&mut (*c).cg_loop_floor);
    clear_i64(&mut (*c).cgdv);
    clear_i64(&mut (*c).cgdt);
    clear_i64(&mut (*c).cgds);
    (*c).cgnext = 0;
    (*c).cglk = 0;
    (*c).cglv = 0;
    (*c).cg_lastvid = 0 - 1;
    (*c).cgblk = 0;
    (*c).cg_to_body = true;   // the body walk routes cg_putc → cgbody
    0
}

fn cg_fresh(c: &mut TyCtx) -> i64 {
    let n: i64 = (*c).cgnext;
    (*c).cgnext = n + 1;
    n
}

// A fresh basic-block label number (`bbN`); `entry` is the implicit first block.
fn cg_fresh_block(c: &mut TyCtx) -> i64 {
    let b: i64 = (*c).cgblk;
    (*c).cgblk = b + 1;
    b
}

// Route one byte to cgbody (during the body walk) or cgout (at teardown — the
// header, the hoisted allocas, the return).
fn cg_putc(c: &mut TyCtx, b: u8) -> i64 {
    if (*c).cg_to_body {
        push(&mut (*c).cgbody, b);
        0
    } else {
        push(&mut (*c).cgout, b);
        0
    }
}

fn cg_slot_set(c: &mut TyCtx, vid: i64, slot: i64) -> i64 {
    push(&mut (*c).cgsv, vid);
    push(&mut (*c).cgsr, slot);
    0
}

// newest-first lookup of a VarId's alloca slot; -1 if unbound.
fn cg_slot_get(c: &mut TyCtx, vid: i64) -> i64 {
    let mut i: i64 = len((*c).cgsv) - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*c).cgsv[i] == vid {
                found = (*c).cgsr[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// --- raw output primitives (push directly onto (*c).cgout via the builtin) ----

// push the bytes of `s` (consumed by value → drops at exit).
fn cgo_str(c: &mut TyCtx, s: [u8]) -> i64 {
    let n: i64 = len(s);
    let mut i: i64 = 0;
    while i < n {
        cg_putc(c, s[i]);
        i = i + 1;
    }
    0
}

// push the bytes of `src[st..en]`.
fn cgo_slice(c: &mut TyCtx, src: &[u8], st: i64, en: i64) -> i64 {
    let mut i: i64 = st;
    while i < en {
        cg_putc(c, (*src)[i]);
        i = i + 1;
    }
    0
}

// push `n` in decimal.
fn cgo_int(c: &mut TyCtx, n: i64) -> i64 {
    if n < 0 {
        cg_putc(c, i64_to_u8(45));
        cgo_int_pos(c, 0 - n)
    } else {
        cgo_int_pos(c, n)
    }
}

fn cgo_int_pos(c: &mut TyCtx, n: i64) -> i64 {
    if n >= 10 {
        cgo_int_pos(c, n / 10);
        0
    } else {
        0
    };
    let d: i64 = n - (n / 10) * 10;
    cg_putc(c, i64_to_u8(48 + d));
    0
}

// the .ll scalar type for a handle (8a): 0 i64 / 1 i32 / 2 bool→i1 / 3 u8→i8.
// True iff `h` is an array type `[T]` (interner kind 1).
fn cg_is_array(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 1
    }
}

// True iff `h` is a reference type `&T`/`&mut T` (interner kind 2).
fn cg_is_ref(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 2
    }
}

// True iff `h` is a `Vec<T>` (interner kind 11).
fn cg_is_vec(c: &mut TyCtx, h: i64) -> bool {
    if h < tbase() {
        false
    } else {
        (*c).tk[h - tbase()] == 11
    }
}

fn cgo_ty(c: &mut TyCtx, h: i64) -> i64 {
    if h == 0 {
        cgo_str(c, "i64")
    } else if h == 1 {
        cgo_str(c, "i32")
    } else if h == 2 {
        cgo_str(c, "i1")
    } else if h == 3 {
        cgo_str(c, "i8")
    } else {
        // (8c-1) a user struct is the Pass-0 named aggregate `%Struct.N` (N =
        // StructId). (8c-2) `[T]` is the abi-v1 `{ i64, ptr }` (one inline literal
        // for every element type). Other compounds (refs/Vec/enum/generic) are
        // later slices → the i64 fallback (their fixtures Err in the oracle and
        // are skipped, so the fallback bytes are never compared).
        let sid: i64 = struct_of_handle(c, h);
        if sid >= 0 {
            cgo_str(c, "%Struct.");
            cgo_int(c, sid)
        } else if cg_is_array(c, h) {
            cgo_str(c, "{ i64, ptr }")
        } else if cg_is_ref(c, h) {
            cgo_str(c, "ptr")
        } else if cg_is_vec(c, h) {
            cgo_str(c, "{ i64, i64, ptr }")
        } else if enum_of_handle(c, h) >= 0 {
            cgo_str(c, "{ i32, ptr }")
        } else {
            cgo_str(c, "i64")
        }
    }
}

// (8c-1) the LLVM type for handle `h`, written to an ARBITRARY buffer `out` (Pass 0
// writes struct decls into `result`, not the cg buffer, so it can't route through
// `cgo_ty`/`cg_putc`). Mirrors `cgo_ty`'s mapping exactly.
fn ll_type_to(out: &mut Vec<u8>, c: &mut TyCtx, h: i64) -> i64 {
    if h == 0 {
        append_str(out, "i64")
    } else if h == 1 {
        append_str(out, "i32")
    } else if h == 2 {
        append_str(out, "i1")
    } else if h == 3 {
        append_str(out, "i8")
    } else {
        let sid: i64 = struct_of_handle(c, h);
        if sid >= 0 {
            append_str(out, "%Struct.");
            append_int(out, sid)
        } else if cg_is_array(c, h) {
            append_str(out, "{ i64, ptr }")
        } else if cg_is_ref(c, h) {
            append_str(out, "ptr")
        } else if cg_is_vec(c, h) {
            append_str(out, "{ i64, i64, ptr }")
        } else if enum_of_handle(c, h) >= 0 {
            append_str(out, "{ i32, ptr }")
        } else {
            append_str(out, "i64")
        }
    }
}

// (8c-1) Pass 0: emit `%Struct.N = type { <field-ll-types> }` for every struct in
// StructId order (= the oracle's `program.structs` order); an empty struct → `type
// {}`. Field types come from the flat field table (`fldo`/`fldty`), filtered by
// owner StructId, in declaration order. Generic structs are Bar B (8h) — no
// oracle-emitting fixture declares one, so iterating all structs matches the
// oracle's `type_params.is_empty()` skip for the Bar-A subset (ADR 0045 A4).
fn cg_pass0(out: &mut Vec<u8>, c: &mut TyCtx) -> i64 {
    let ns: i64 = len((*c).sts);
    let mut sid: i64 = 0;
    let mut any: bool = false;
    while sid < ns {
        append_str(out, "%Struct.");
        append_int(out, sid);
        append_str(out, " = type {");
        let nf: i64 = len((*c).fldo);
        let mut i: i64 = 0;
        let mut first: bool = true;
        while i < nf {
            if (*c).fldo[i] == sid {
                if first {
                    push(out, ' ');
                    first = false;
                    0
                } else {
                    append_str(out, ", ")
                };
                let fh: i64 = (*c).fldty[i];
                ll_type_to(out, c, fh);
                0
            } else {
                0
            };
            i = i + 1;
        }
        if first {
            0
        } else {
            push(out, ' ')
        };
        append_str(out, "}\n");
        any = true;
        sid = sid + 1;
    }
    if any {
        push(out, '\n')
    } else {
        0
    };
    0
}

// an operand: a register `%vN` (kind 0), an integer literal (kind 1), or (8d-Vec)
// the empty-`Vec` constant (kind 2 — `vec_new()`'s value, the same for every elem).
fn cgo_operand(c: &mut TyCtx, kind: i64, val: i64) -> i64 {
    if kind == 0 {
        cgo_str(c, "%v");
        cgo_int(c, val)
    } else if kind == 1 {
        cgo_int(c, val)
    } else {
        cgo_str(c, "{ i64 0, i64 0, ptr null }")
    }
}

// `  %vD = ` (the dest prefix); returns D + advances the counter.
fn cg_dst(c: &mut TyCtx) -> i64 {
    let d: i64 = cg_fresh(c);
    cgo_str(c, "  %v");
    cgo_int(c, d);
    cgo_str(c, " = ");
    d
}

// set the threaded operand to register D.
fn cg_reg(c: &mut TyCtx, d: i64) -> i64 {
    (*c).cglk = 0;
    (*c).cglv = d;
    0
}

// --- per-instruction emitters (each sets `cglast` to its dest, where it has one) --

// `  %vD = <op> <ty> <l>, <r>` (binop).
fn cg_bin(c: &mut TyCtx, op: [u8], ty: i64, lk: i64, lv: i64, rk: i64, rv: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, op);
    cg_putc(c, ' ');
    cgo_ty(c, ty);
    cg_putc(c, ' ');
    cgo_operand(c, lk, lv);
    cgo_str(c, ", ");
    cgo_operand(c, rk, rv);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = icmp <pred> <ty> <l>, <r>`.
fn cg_cmp(c: &mut TyCtx, pred: [u8], ty: i64, lk: i64, lv: i64, rk: i64, rv: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "icmp ");
    cgo_str(c, pred);
    cg_putc(c, ' ');
    cgo_ty(c, ty);
    cg_putc(c, ' ');
    cgo_operand(c, lk, lv);
    cgo_str(c, ", ");
    cgo_operand(c, rk, rv);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = sub <ty> 0, <op>` (integer negate).
fn cg_neg(c: &mut TyCtx, ty: i64, k: i64, v: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "sub ");
    cgo_ty(c, ty);
    cgo_str(c, " 0, ");
    cgo_operand(c, k, v);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = xor i1 <op>, 1` (logical not).
fn cg_not(c: &mut TyCtx, k: i64, v: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "xor i1 ");
    cgo_operand(c, k, v);
    cgo_str(c, ", 1");
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = <op> <fromty> <operand> to <toty>` (zext / trunc).
fn cg_conv(c: &mut TyCtx, op: [u8], fromty: i64, k: i64, v: i64, toty: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, op);
    cg_putc(c, ' ');
    cgo_ty(c, fromty);
    cg_putc(c, ' ');
    cgo_operand(c, k, v);
    cgo_str(c, " to ");
    cgo_ty(c, toty);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  %vD = load <ty>, ptr %v<slot>`.
fn cg_load(c: &mut TyCtx, ty: i64, slot: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "load ");
    cgo_ty(c, ty);
    cgo_str(c, ", ptr %v");
    cgo_int(c, slot);
    cg_putc(c, '\n');
    cg_reg(c, d);
    d
}

// `  store <ty> <op>, ptr %v<slot>` (no dest).
fn cg_store(c: &mut TyCtx, ty: i64, k: i64, v: i64, slot: i64) -> i64 {
    cgo_str(c, "  store ");
    cgo_ty(c, ty);
    cg_putc(c, ' ');
    cgo_operand(c, k, v);
    cgo_str(c, ", ptr %v");
    cgo_int(c, slot);
    cg_putc(c, '\n');
    0
}

// `  %vS = alloca <ty>`; returns the slot S.
// Reserve an alloca slot — RECORD (slot, type) for hoisting to the entry block at
// teardown (no inline text); the slot `%vN` is referenced by stores/loads in cgbody.
fn cg_alloca(c: &mut TyCtx, ty: i64) -> i64 {
    let slot: i64 = cg_fresh(c);
    push(&mut (*c).cgalloca_sl, slot);
    push(&mut (*c).cgalloca_ty, ty);
    slot
}

// (8d-drops) record a scope-drop entry: (VarId, type, alloca slot). Called for each
// param + `let` so the owning block frees it (if un-moved) at exit.
fn cg_drop_record(c: &mut TyCtx, vid: i64, ty: i64, slot: i64) -> i64 {
    push(&mut (*c).cgdv, vid);
    push(&mut (*c).cgdt, ty);
    push(&mut (*c).cgds, slot);
    0
}

// (8d-drops) is `vid` a moved source of fn `fnidx`? Scans the borrow analysis's
// `mvf`/`mvv` side-table (the same set `snc borrow` dumps) — a moved binding is owned
// + dropped by its consumer (incl. a tail-returned value, recorded as a consuming
// move), so it is skipped at scope exit. Mirrors `DropPlan::moved_sources_for`.
fn cg_is_moved(c: &mut TyCtx, fnidx: i64, vid: i64) -> bool {
    let n: i64 = len((*c).mvf);
    let mut i: i64 = 0;
    let mut found: bool = false;
    while i < n {
        if (*c).mvf[i] == fnidx {
            if (*c).mvv[i] == vid {
                found = true;
                0
            } else {
                0
            }
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// (8d-drops-2) does a value of type `ty` own heap that scope-exit must `sentinel_free`?
// An array / `Vec` always does; a struct does iff some field does (recursive — a struct
// of only scalars drops nothing). Bar-B shapes don't emit → false. Mirrors `needs_drop`.
fn cg_needs_drop(c: &mut TyCtx, ty: i64) -> bool {
    if cg_is_array(c, ty) {
        true
    } else if cg_is_vec(c, ty) {
        true
    } else {
        let nsid: i64 = struct_of_handle(c, ty);
        if nsid >= 0 {
            let nf: i64 = len((*c).fldo);
            let mut i: i64 = 0;
            let mut any: bool = false;
            while i < nf {
                if (*c).fldo[i] == nsid {
                    let ft: i64 = (*c).fldty[i];
                    if cg_needs_drop(c, ft) {
                        any = true;
                        0
                    } else {
                        0
                    }
                } else {
                    0
                };
                i = i + 1;
            }
            any
        } else {
            // (8e-1) an enum needs a drop iff some variant carries a payload (a
            // pure-unit enum boxes nothing). No recursion (box-free-only).
            let neid: i64 = enum_of_handle(c, ty);
            if neid >= 0 {
                let nv: i64 = len((*c).varo);
                let mut vi: i64 = 0;
                let mut vany: bool = false;
                while vi < nv {
                    if (*c).varo[vi] == neid {
                        if (*c).varpe[vi] > (*c).varps[vi] {
                            vany = true;
                            0
                        } else {
                            0
                        }
                    } else {
                        0
                    };
                    vi = vi + 1;
                }
                vany
            } else {
                false
            }
        }
    }
}

// (8d-drops) `sentinel_free` a value of type `ty` living AT `slot` (a `%vN` — an alloca
// slot, or a struct-field GEP register when recursing): an array `[T]` (`{ i64, ptr }`)
// frees its data pointer (field 1); a `Vec<T>` (`{ i64, i64, ptr }`) frees field 2
// (`sentinel_free(null)` is a safe no-op); a struct (8d-drops-2) GEPs into each
// drop-needing field (declaration order) and recurses. Primitives / refs → nothing.
// Mirrors the oracle's `emit_drop_for_binding` / `emit_drop_struct_fields`.
fn cg_emit_drop(c: &mut TyCtx, ty: i64, slot: i64) -> i64 {
    if cg_is_array(c, ty) {
        let adv: i64 = cg_dst(c);
        cgo_str(c, "load { i64, ptr }, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        let add: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, ptr } %v");
        cgo_int(c, adv);
        cgo_str(c, ", 1\n");
        cgo_str(c, "  call void @sentinel_free(ptr %v");
        cgo_int(c, add);
        cgo_str(c, ")\n");
        (*c).cg_used_free = true;
        0
    } else if cg_is_vec(c, ty) {
        let vdv: i64 = cg_dst(c);
        cgo_str(c, "load { i64, i64, ptr }, ptr %v");
        cgo_int(c, slot);
        cg_putc(c, '\n');
        let vdd: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, i64, ptr } %v");
        cgo_int(c, vdv);
        cgo_str(c, ", 2\n");
        cgo_str(c, "  call void @sentinel_free(ptr %v");
        cgo_int(c, vdd);
        cgo_str(c, ")\n");
        (*c).cg_used_free = true;
        0
    } else {
        // (8d-drops-2) a struct: GEP each drop-needing field (declaration order) and
        // recurse. `fidx` counts EVERY field (the GEP index is the field's position),
        // emitting only for the heap-backed ones.
        let ssid: i64 = struct_of_handle(c, ty);
        if ssid >= 0 {
            let snf: i64 = len((*c).fldo);
            let mut si: i64 = 0;
            let mut fidx: i64 = 0;
            while si < snf {
                if (*c).fldo[si] == ssid {
                    let sft: i64 = (*c).fldty[si];
                    if cg_needs_drop(c, sft) {
                        let sfp: i64 = cg_dst(c);
                        cgo_str(c, "getelementptr %Struct.");
                        cgo_int(c, ssid);
                        cgo_str(c, ", ptr %v");
                        cgo_int(c, slot);
                        cgo_str(c, ", i32 0, i32 ");
                        cgo_int(c, fidx);
                        cg_putc(c, '\n');
                        cg_emit_drop(c, sft, sfp);
                        0
                    } else {
                        0
                    };
                    fidx = fidx + 1;
                    0
                } else {
                    0
                };
                si = si + 1;
            }
            0
        } else {
            // (8e-1) an enum: load `{ i32, ptr }`, null-check the payload, free it (the
            // box). Box-free-only — recursive payload-field drop is deferred (the D.1b
            // limit, matching production).
            let edid: i64 = enum_of_handle(c, ty);
            if edid >= 0 {
                let edv: i64 = cg_dst(c);
                cgo_str(c, "load { i32, ptr }, ptr %v");
                cgo_int(c, slot);
                cg_putc(c, '\n');
                let edpl: i64 = cg_dst(c);
                cgo_str(c, "extractvalue { i32, ptr } %v");
                cgo_int(c, edv);
                cgo_str(c, ", 1\n");
                let ednn: i64 = cg_dst(c);
                cgo_str(c, "icmp eq ptr %v");
                cgo_int(c, edpl);
                cgo_str(c, ", null\n");
                let edfb: i64 = cg_fresh_block(c);
                let edab: i64 = cg_fresh_block(c);
                cgo_str(c, "  br i1 %v");
                cgo_int(c, ednn);
                cgo_str(c, ", label %bb");
                cgo_int(c, edab);
                cgo_str(c, ", label %bb");
                cgo_int(c, edfb);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, edfb);
                cgo_str(c, ":\n");
                cgo_str(c, "  call void @sentinel_free(ptr %v");
                cgo_int(c, edpl);
                cgo_str(c, ")\n");
                (*c).cg_used_free = true;
                cgo_str(c, "  br label %bb");
                cgo_int(c, edab);
                cg_putc(c, '\n');
                cgo_str(c, "bb");
                cgo_int(c, edab);
                cgo_str(c, ":\n");
                0
            } else {
                0
            }
        }
    }
}

// (8d-drops) free the top scope frame [mark..]: the un-moved heap-backed bindings in
// REVERSE declaration order, then truncate the pools back to `mark`. Called at each
// block's exit (body-block + nested blocks via the Block arm; the param frame in
// `type_fn`). Frames nest LIFO via the recursive walk, so `mark` is a local — no stack.
fn cg_drop_frame(c: &mut TyCtx, mark: i64) -> i64 {
    let mut i: i64 = len((*c).cgdv) - 1;
    while i >= mark {
        let vid: i64 = (*c).cgdv[i];
        let ty: i64 = (*c).cgdt[i];
        let slot: i64 = (*c).cgds[i];
        if cg_is_moved(c, (*c).curfn, vid) {
            0
        } else {
            cg_emit_drop(c, ty, slot)
        };
        i = i - 1;
    }
    while len((*c).cgdv) > mark {
        let _a: i64 = pop(&mut (*c).cgdv);
        let _b: i64 = pop(&mut (*c).cgdt);
        let _s: i64 = pop(&mut (*c).cgds);
        0
    }
    0
}

// (8d-drops-3) drain (free) the un-moved heap-backed bindings of cgdv[floor..] in
// REVERSE order — the per-iteration drops on a `break`/`continue` early-exit path. Does
// NOT truncate: the (now-dead) remainder of each block still truncates via its Block-arm
// `cg_drop_frame`, so each runtime path frees once. Reversing the flat cgdv[floor..]
// == the oracle's top-down per-frame reverse (concatenated frames reverse identically).
fn cg_drop_range(c: &mut TyCtx, floor: i64) -> i64 {
    let mut i: i64 = len((*c).cgdv) - 1;
    while i >= floor {
        let vid: i64 = (*c).cgdv[i];
        let ty: i64 = (*c).cgdt[i];
        let slot: i64 = (*c).cgds[i];
        if cg_is_moved(c, (*c).curfn, vid) {
            0
        } else {
            cg_emit_drop(c, ty, slot)
        };
        i = i - 1;
    }
    0
}

// collect one call arg (its operand + type) onto the arg stacks (gated).
fn cg_collect(c: &mut TyCtx, at: i64) -> i64 {
    if cg_on(c) {
        if (*c).cg_collecting {
            push(&mut (*c).cgak, (*c).cglk);
            push(&mut (*c).cgav, (*c).cglv);
            push(&mut (*c).cgat, at);
            0
        } else {
            0
        };
        0
    } else {
        0
    }
}

// (8e-1) emit a variant's payload struct type literal `{ t0, t1, … }` (the flat
// variant index `j` = `variant_flat(eid, vidx)`; payloads are `varpay[varps[j]..]`).
// Only called for a non-empty payload (a unit variant uses a null payload, no struct).
fn cg_emit_pstruct(c: &mut TyCtx, j: i64) -> i64 {
    let ps: i64 = (*c).varps[j];
    let pe: i64 = (*c).varpe[j];
    cgo_str(c, "{ ");
    let mut k: i64 = ps;
    let mut first: bool = true;
    while k < pe {
        if first {
            first = false;
            0
        } else {
            cgo_str(c, ", ");
            0
        };
        cgo_ty(c, (*c).varpay[k]);
        k = k + 1;
    }
    cgo_str(c, " }")
}

// (8e-1) emit an enum construction `{ i32 tag, ptr payload }` from the args collected
// at `cgak[snap..]`. A unit variant (no args) gets a null payload; else build the
// payload struct (insertvalue chain), heap-box it (GEP-sizeof + alloc + store), and
// point the enum at it. Sets the result operand; pops the consumed args. Mirrors the
// oracle's `lower_enum_construct`.
fn cg_emit_enum_construct(c: &mut TyCtx, eid: i64, vidx: i64, snap: i64) -> i64 {
    let nargs: i64 = len((*c).cgak) - snap;
    let mut boxreg: i64 = 0 - 1;
    if nargs > 0 {
        let j: i64 = variant_flat(c, eid, vidx);
        let mut aggreg: i64 = 0 - 1;
        let mut i: i64 = 0;
        while i < nargs {
            let fk: i64 = (*c).cgak[snap + i];
            let fv: i64 = (*c).cgav[snap + i];
            let ft: i64 = (*c).cgat[snap + i];
            let d: i64 = cg_dst(c);
            cgo_str(c, "insertvalue ");
            cg_emit_pstruct(c, j);
            cg_putc(c, ' ');
            if aggreg < 0 {
                cgo_str(c, "undef")
            } else {
                cgo_str(c, "%v");
                cgo_int(c, aggreg)
            };
            cgo_str(c, ", ");
            cgo_ty(c, ft);
            cg_putc(c, ' ');
            cgo_operand(c, fk, fv);
            cgo_str(c, ", ");
            cgo_int(c, i);
            cg_putc(c, '\n');
            aggreg = d;
            i = i + 1;
        }
        let szr: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cg_emit_pstruct(c, j);
        cgo_str(c, ", ptr null, i64 1\n");
        let szir: i64 = cg_dst(c);
        cgo_str(c, "ptrtoint ptr %v");
        cgo_int(c, szr);
        cgo_str(c, " to i64\n");
        let br: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
        cgo_int(c, szir);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        cgo_str(c, "  store ");
        cg_emit_pstruct(c, j);
        cgo_str(c, " %v");
        cgo_int(c, aggreg);
        cgo_str(c, ", ptr %v");
        cgo_int(c, br);
        cg_putc(c, '\n');
        boxreg = br;
        0
    } else {
        0
    };
    let e0: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i32, ptr } undef, i32 ");
    cgo_int(c, vidx);
    cgo_str(c, ", 0\n");
    let e1: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i32, ptr } %v");
    cgo_int(c, e0);
    cgo_str(c, ", ptr ");
    if boxreg < 0 {
        cgo_str(c, "null")
    } else {
        cgo_str(c, "%v");
        cgo_int(c, boxreg)
    };
    cgo_str(c, ", 1\n");
    cg_reg(c, e1);
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    0
}

// emit a call (or the u8<->i64 width builtins): consume the arg slice [snap..],
// truncate it, set the result operand. fid 5 = u8_to_i64 (zext), 6 = i64_to_u8
// (trunc), >=14 = a user fn. Other builtins are not yet ported (no emit).
fn cg_emit_call(c: &mut TyCtx, src: &[u8], fid: i64, snap: i64, rty: i64) -> i64 {
    if fid == 5 {
        let ak: i64 = (*c).cgak[snap];
        let av: i64 = (*c).cgav[snap];
        cg_conv(c, "zext", 3, ak, av, 0);
        0
    } else if fid == 6 {
        let bk: i64 = (*c).cgak[snap];
        let bv: i64 = (*c).cgav[snap];
        cg_conv(c, "trunc", 0, bk, bv, 3);
        0
    } else if fid == 3 {
        // (8c-2/8d) len = extractvalue <agg> <coll>, 0 — `<agg>` is the arg's actual
        // type (`{i64,ptr}` for `[T]`, `{i64,i64,ptr}` for `Vec<T>`; len is field 0).
        let lk: i64 = (*c).cgak[snap];
        let lv: i64 = (*c).cgav[snap];
        let lt: i64 = (*c).cgat[snap];
        let ld: i64 = cg_dst(c);
        cgo_str(c, "extractvalue ");
        cgo_ty(c, lt);
        cg_putc(c, ' ');
        cgo_operand(c, lk, lv);
        cgo_str(c, ", 0\n");
        cg_reg(c, ld);
        0
    } else if fid == 4 {
        // (8d) str_eq(a, b): decompose each [u8], call sentinel_str_eq -> i1.
        let s_ak: i64 = (*c).cgak[snap];
        let s_av: i64 = (*c).cgav[snap];
        let s_bk: i64 = (*c).cgak[snap + 1];
        let s_bv: i64 = (*c).cgav[snap + 1];
        let al: i64 = cg_lenptr(c, s_ak, s_av);
        let bl: i64 = cg_lenptr(c, s_bk, s_bv);
        let d2: i64 = cg_dst(c);
        cgo_str(c, "call i1 @sentinel_str_eq(ptr %v");
        cgo_int(c, al + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, al);
        cgo_str(c, ", ptr %v");
        cgo_int(c, bl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, bl);
        cgo_str(c, ")\n");
        (*c).cg_used_streq = true;
        cg_reg(c, d2);
        0
    } else if fid == 13 {
        // (8d) print_bytes(d): decompose [u8], call sentinel_print_bytes -> i64.
        let p_dk: i64 = (*c).cgak[snap];
        let p_dv: i64 = (*c).cgav[snap];
        let pdl: i64 = cg_lenptr(c, p_dk, p_dv);
        let d3: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_print_bytes(ptr %v");
        cgo_int(c, pdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pdl);
        cgo_str(c, ")\n");
        (*c).cg_used_prbytes = true;
        cg_reg(c, d3);
        0
    } else if fid == 12 {
        // (8d) write_file(path, data) -> i64.
        let w_pk: i64 = (*c).cgak[snap];
        let w_pv: i64 = (*c).cgav[snap];
        let w_dk: i64 = (*c).cgak[snap + 1];
        let w_dv: i64 = (*c).cgav[snap + 1];
        let wpl: i64 = cg_lenptr(c, w_pk, w_pv);
        let wdl: i64 = cg_lenptr(c, w_dk, w_dv);
        let d4: i64 = cg_dst(c);
        cgo_str(c, "call i64 @sentinel_write_file(ptr %v");
        cgo_int(c, wpl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, wpl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, wdl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, wdl);
        cgo_str(c, ")\n");
        (*c).cg_used_wrfile = true;
        cg_reg(c, d4);
        0
    } else if fid == 11 {
        // (8d) read_file(path) -> [u8]: call, then reassemble {len, data}.
        let r_pk: i64 = (*c).cgak[snap];
        let r_pv: i64 = (*c).cgav[snap];
        let rpl: i64 = cg_lenptr(c, r_pk, r_pv);
        let rslot: i64 = cg_alloca(c, 0);
        let rdata: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_read_file(ptr %v");
        cgo_int(c, rpl + 1);
        cgo_str(c, ", i64 %v");
        cgo_int(c, rpl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, rslot);
        cgo_str(c, ")\n");
        (*c).cg_used_rdfile = true;
        let rrlen: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, rslot);
        cg_putc(c, '\n');
        let ra0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } undef, i64 %v");
        cgo_int(c, rrlen);
        cgo_str(c, ", 0\n");
        let ra1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } %v");
        cgo_int(c, ra0);
        cgo_str(c, ", ptr %v");
        cgo_int(c, rdata);
        cgo_str(c, ", 1\n");
        cg_reg(c, ra1);
        0
    } else if fid == 7 {
        // (8d-Vec) vec_new() = the empty-Vec constant operand (kind 2).
        (*c).cglk = 2;
        (*c).cglv = 0;
        0
    } else if fid == 8 {
        // (8d-Vec) push(&mut v, x): grow if len==cap (realloc), store x, bump len.
        // Returns i64 0. Field GEPs through the &mut Vec pointer (cgak[snap]).
        let pu_pk: i64 = (*c).cgak[snap];
        let pu_pv: i64 = (*c).cgav[snap];
        let pu_rt: i64 = (*c).cgat[snap];
        let pu_xk: i64 = (*c).cgak[snap + 1];
        let pu_xv: i64 = (*c).cgav[snap + 1];
        let pu_sr: i64 = strip_ref(c, pu_rt);
        let pu_e: i64 = vec_elem_of(c, pu_sr);
        let pu_lp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, pu_pk, pu_pv);
        cgo_str(c, ", i32 0, i32 0\n");
        let pu_dp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, pu_pk, pu_pv);
        cgo_str(c, ", i32 0, i32 2\n");
        let pu_cp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, pu_pk, pu_pv);
        cgo_str(c, ", i32 0, i32 1\n");
        let pu_lv: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, pu_lp);
        cg_putc(c, '\n');
        let pu_cv: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, pu_cp);
        cg_putc(c, '\n');
        let pu_ng: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, pu_lv);
        cgo_str(c, ", %v");
        cgo_int(c, pu_cv);
        cg_putc(c, '\n');
        let pu_gb: i64 = cg_fresh_block(c);
        let pu_cb: i64 = cg_fresh_block(c);
        cgo_str(c, "  br i1 %v");
        cgo_int(c, pu_ng);
        cgo_str(c, ", label %bb");
        cgo_int(c, pu_gb);
        cgo_str(c, ", label %bb");
        cgo_int(c, pu_cb);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, pu_gb);
        cgo_str(c, ":\n");
        let pu_od: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, pu_dp);
        cg_putc(c, '\n');
        let pu_cx: i64 = cg_dst(c);
        cgo_str(c, "mul i64 %v");
        cgo_int(c, pu_cv);
        cgo_str(c, ", 2\n");
        let pu_cz: i64 = cg_dst(c);
        cgo_str(c, "icmp eq i64 %v");
        cgo_int(c, pu_cv);
        cgo_str(c, ", 0\n");
        let pu_nc: i64 = cg_dst(c);
        cgo_str(c, "select i1 %v");
        cgo_int(c, pu_cz);
        cgo_str(c, ", i64 1, i64 %v");
        cgo_int(c, pu_cx);
        cg_putc(c, '\n');
        let pu_sz: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, pu_e);
        cgo_str(c, ", ptr null, i64 1\n");
        let pu_szi: i64 = cg_dst(c);
        cgo_str(c, "ptrtoint ptr %v");
        cgo_int(c, pu_sz);
        cgo_str(c, " to i64\n");
        let pu_ns: i64 = cg_dst(c);
        cgo_str(c, "mul i64 %v");
        cgo_int(c, pu_nc);
        cgo_str(c, ", %v");
        cgo_int(c, pu_szi);
        cg_putc(c, '\n');
        let pu_nd: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_realloc(ptr %v");
        cgo_int(c, pu_od);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pu_ns);
        cgo_str(c, ")\n");
        (*c).cg_used_realloc = true;
        cgo_str(c, "  store i64 %v");
        cgo_int(c, pu_nc);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_cp);
        cg_putc(c, '\n');
        cgo_str(c, "  store ptr %v");
        cgo_int(c, pu_nd);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_dp);
        cg_putc(c, '\n');
        cgo_str(c, "  br label %bb");
        cgo_int(c, pu_cb);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, pu_cb);
        cgo_str(c, ":\n");
        let pu_dd: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, pu_dp);
        cg_putc(c, '\n');
        let pu_sl: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, pu_e);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_dd);
        cgo_str(c, ", i64 %v");
        cgo_int(c, pu_lv);
        cg_putc(c, '\n');
        cgo_str(c, "  store ");
        cgo_ty(c, pu_e);
        cg_putc(c, ' ');
        cgo_operand(c, pu_xk, pu_xv);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_sl);
        cg_putc(c, '\n');
        let pu_nl: i64 = cg_dst(c);
        cgo_str(c, "add i64 %v");
        cgo_int(c, pu_lv);
        cgo_str(c, ", 1\n");
        cgo_str(c, "  store i64 %v");
        cgo_int(c, pu_nl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, pu_lp);
        cg_putc(c, '\n');
        (*c).cglk = 1;
        (*c).cglv = 0;
        0
    } else if fid == 9 {
        // (8d-Vec) pop(&mut v) -> T: empty-check (OOB trap), decrement len, return
        // data[len-1].
        let po_pk: i64 = (*c).cgak[snap];
        let po_pv: i64 = (*c).cgav[snap];
        let po_rt: i64 = (*c).cgat[snap];
        let po_sr: i64 = strip_ref(c, po_rt);
        let po_e: i64 = vec_elem_of(c, po_sr);
        let po_lp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, po_pk, po_pv);
        cgo_str(c, ", i32 0, i32 0\n");
        let po_dp: i64 = cg_dst(c);
        cgo_str(c, "getelementptr { i64, i64, ptr }, ptr ");
        cgo_operand(c, po_pk, po_pv);
        cgo_str(c, ", i32 0, i32 2\n");
        let po_lv: i64 = cg_dst(c);
        cgo_str(c, "load i64, ptr %v");
        cgo_int(c, po_lp);
        cg_putc(c, '\n');
        let po_nl: i64 = cg_dst(c);
        cgo_str(c, "sub i64 %v");
        cgo_int(c, po_lv);
        cgo_str(c, ", 1\n");
        let po_ne: i64 = cg_dst(c);
        cgo_str(c, "icmp sge i64 %v");
        cgo_int(c, po_nl);
        cgo_str(c, ", 0\n");
        let po_ok: i64 = cg_fresh_block(c);
        let po_em: i64 = cg_fresh_block(c);
        cgo_str(c, "  br i1 %v");
        cgo_int(c, po_ne);
        cgo_str(c, ", label %bb");
        cgo_int(c, po_ok);
        cgo_str(c, ", label %bb");
        cgo_int(c, po_em);
        cg_putc(c, '\n');
        cgo_str(c, "bb");
        cgo_int(c, po_em);
        cgo_str(c, ":\n");
        cgo_str(c, "  call void @sentinel_panic_oob(i64 %v");
        cgo_int(c, po_nl);
        cgo_str(c, ", i64 %v");
        cgo_int(c, po_lv);
        cgo_str(c, ")\n");
        (*c).cg_used_panic = true;
        cgo_str(c, "  unreachable\n");
        cgo_str(c, "bb");
        cgo_int(c, po_ok);
        cgo_str(c, ":\n");
        let po_dd: i64 = cg_dst(c);
        cgo_str(c, "load ptr, ptr %v");
        cgo_int(c, po_dp);
        cg_putc(c, '\n');
        let po_ep: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, po_e);
        cgo_str(c, ", ptr %v");
        cgo_int(c, po_dd);
        cgo_str(c, ", i64 %v");
        cgo_int(c, po_nl);
        cg_putc(c, '\n');
        let po_ev: i64 = cg_dst(c);
        cgo_str(c, "load ");
        cgo_ty(c, po_e);
        cgo_str(c, ", ptr %v");
        cgo_int(c, po_ep);
        cg_putc(c, '\n');
        cgo_str(c, "  store i64 %v");
        cgo_int(c, po_nl);
        cgo_str(c, ", ptr %v");
        cgo_int(c, po_lp);
        cg_putc(c, '\n');
        cg_reg(c, po_ev);
        0
    } else if fid == 10 {
        // (8d-Vec-2) vec_to_array(v: Vec<T>) -> [T]: copy the live `len` elements
        // into a fresh heap buffer, build an owned [T] { i64 len, ptr data }. The
        // Vec is passed by VALUE ({i64,i64,ptr}), so `data` is field 2. Non-consuming
        // — the array is an independent copy, so both drop their buffers at scope exit.
        let vt_vk: i64 = (*c).cgak[snap];
        let vt_vv: i64 = (*c).cgav[snap];
        let vt_rt: i64 = (*c).cgat[snap];
        let vt_e: i64 = vec_elem_of(c, vt_rt);
        let vt_len: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, i64, ptr } ");
        cgo_operand(c, vt_vk, vt_vv);
        cgo_str(c, ", 0\n");
        let vt_src: i64 = cg_dst(c);
        cgo_str(c, "extractvalue { i64, i64, ptr } ");
        cgo_operand(c, vt_vk, vt_vv);
        cgo_str(c, ", 2\n");
        let vt_sz: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, vt_e);
        cgo_str(c, ", ptr null, i64 %v");
        cgo_int(c, vt_len);
        cg_putc(c, '\n');
        let vt_szi: i64 = cg_dst(c);
        cgo_str(c, "ptrtoint ptr %v");
        cgo_int(c, vt_sz);
        cgo_str(c, " to i64\n");
        let vt_dest: i64 = cg_dst(c);
        cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
        cgo_int(c, vt_szi);
        cgo_str(c, ")\n");
        (*c).cg_used_alloc = true;
        cgo_str(c, "  call void @llvm.memcpy.p0.p0.i64(ptr %v");
        cgo_int(c, vt_dest);
        cgo_str(c, ", ptr %v");
        cgo_int(c, vt_src);
        cgo_str(c, ", i64 %v");
        cgo_int(c, vt_szi);
        cgo_str(c, ", i1 false)\n");
        (*c).cg_used_memcpy = true;
        let vt_a0: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } undef, i64 %v");
        cgo_int(c, vt_len);
        cgo_str(c, ", 0\n");
        let vt_a1: i64 = cg_dst(c);
        cgo_str(c, "insertvalue { i64, ptr } %v");
        cgo_int(c, vt_a0);
        cgo_str(c, ", ptr %v");
        cgo_int(c, vt_dest);
        cgo_str(c, ", 1\n");
        cg_reg(c, vt_a1);
        0
    } else if fid >= 14 {
        let d: i64 = cg_dst(c);
        cgo_str(c, "call ");
        cgo_ty(c, rty);
        cgo_str(c, " @");
        let us: i64 = (*c).ufs[fid - 14];
        let ue: i64 = (*c).ufe[fid - 14];
        cgo_slice(c, src, us, ue);
        cg_putc(c, '(');
        let n: i64 = len((*c).cgak);
        let mut i: i64 = snap;
        let mut first: bool = true;
        while i < n {
            if first {
                first = false;
                0
            } else {
                cgo_str(c, ", ");
                0
            };
            let aty: i64 = (*c).cgat[i];
            let aok: i64 = (*c).cgak[i];
            let aov: i64 = (*c).cgav[i];
            cgo_ty(c, aty);
            cg_putc(c, ' ');
            cgo_operand(c, aok, aov);
            i = i + 1;
        }
        cg_putc(c, ')');
        cg_putc(c, '\n');
        cg_reg(c, d);
        0
    } else {
        0
    };
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    0
}

// `define <ret> @<name>(<ptys> %argN) {\nentry:\n` + each param's alloca + store.
// Called after the params are parsed (slots reserved + types in `cgpty` by the
// emit_tparams hook) and `rty` known, before the body walk.
// Teardown: ASSEMBLE the fn into cgout — the `define` header, the entry block (the
// HOISTED allocas first), the buffered body (cgbody), then the return + `}`. Called
// after the body walk; flips cg_putc to target cgout. The body's value (`cglast`) is
// the fn's return (captured first — the header/ret emission advances cgnext for main's
// trunc temp, which must continue after the body's numbering).

// (8c-1) `  %vD = extractvalue <ty> <op>, <idx>` (a struct field read); sets the
// threaded operand to the dest register.
fn cg_extract(c: &mut TyCtx, tyh: i64, opk: i64, opv: i64, idx: i64) -> i64 {
    let d: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tyh);
    cg_putc(c, ' ');
    cgo_operand(c, opk, opv);
    cgo_str(c, ", ");
    cgo_int(c, idx);
    cg_putc(c, '\n');
    cg_reg(c, d)
}

// (8c-1) emit a struct literal's `insertvalue` chain over the field operands
// collected on the arg stacks since `snap` (building from `undef`); sets the
// threaded operand to the final aggregate register; pops the stacks back to `snap`.
// (`(*c).cgat[i]` is bound to a local before `cgo_ty` — passing it inline while `c`
// is `&mut` re-borrows `c`, the A2 quirk.)
fn cg_emit_structlit(c: &mut TyCtx, styh: i64, snap: i64) -> i64 {
    let n: i64 = len((*c).cgak);
    let mut prev: i64 = 0 - 1;
    let mut idx: i64 = 0;
    let mut i: i64 = snap;
    while i < n {
        let d: i64 = cg_dst(c);
        cgo_str(c, "insertvalue ");
        cgo_ty(c, styh);
        cg_putc(c, ' ');
        if prev < 0 {
            cgo_str(c, "undef")
        } else {
            cgo_str(c, "%v");
            cgo_int(c, prev)
        };
        cgo_str(c, ", ");
        let aty: i64 = (*c).cgat[i];
        cgo_ty(c, aty);
        cg_putc(c, ' ');
        let aok: i64 = (*c).cgak[i];
        let aov: i64 = (*c).cgav[i];
        cgo_operand(c, aok, aov);
        cgo_str(c, ", ");
        cgo_int(c, idx);
        cg_putc(c, '\n');
        prev = d;
        idx = idx + 1;
        i = i + 1;
    }
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, prev)
}

// (8d) decompose a `[u8]`/`{ i64, ptr }` operand into its (len, ptr) for a runtime
// builtin: emit `%vL = extractvalue { i64, ptr } <op>, 0` then `%v(L+1) =
// extractvalue …, 1`; return L (the len reg; the ptr reg is L+1, the very next).
fn cg_lenptr(c: &mut TyCtx, opk: i64, opv: i64) -> i64 {
    let l: i64 = cg_dst(c);
    cgo_str(c, "extractvalue { i64, ptr } ");
    cgo_operand(c, opk, opv);
    cgo_str(c, ", 0\n");
    let _p: i64 = cg_dst(c);
    cgo_str(c, "extractvalue { i64, ptr } ");
    cgo_operand(c, opk, opv);
    cgo_str(c, ", 1\n");
    l
}

// (8c-2) emit an array literal: heap alloc (`n * sizeof(elem)` via the GEP-sizeof
// idiom + `sentinel_alloc`) + per-element GEP-store over the operands collected
// since `snap` + the abi-v1 `{ i64 len, ptr data }`. Sets the threaded operand to
// the aggregate register; pops the arg stacks back to `snap`.
fn cg_emit_arraylit(c: &mut TyCtx, ety: i64, snap: i64) -> i64 {
    let top: i64 = len((*c).cgak);
    let n: i64 = top - snap;
    let sz: i64 = cg_dst(c);
    cgo_str(c, "getelementptr ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr null, i64 ");
    cgo_int(c, n);
    cg_putc(c, '\n');
    let szi: i64 = cg_dst(c);
    cgo_str(c, "ptrtoint ptr %v");
    cgo_int(c, sz);
    cgo_str(c, " to i64\n");
    let data: i64 = cg_dst(c);
    cgo_str(c, "call ptr @sentinel_alloc(i64 %v");
    cgo_int(c, szi);
    cgo_str(c, ")\n");
    (*c).cg_used_alloc = true;
    let mut i: i64 = snap;
    let mut ix: i64 = 0;
    while i < top {
        let ep: i64 = cg_dst(c);
        cgo_str(c, "getelementptr ");
        cgo_ty(c, ety);
        cgo_str(c, ", ptr %v");
        cgo_int(c, data);
        cgo_str(c, ", i64 ");
        cgo_int(c, ix);
        cg_putc(c, '\n');
        cgo_str(c, "  store ");
        cgo_ty(c, ety);
        cg_putc(c, ' ');
        let ek: i64 = (*c).cgak[i];
        let ev: i64 = (*c).cgav[i];
        cgo_operand(c, ek, ev);
        cgo_str(c, ", ptr %v");
        cgo_int(c, ep);
        cg_putc(c, '\n');
        i = i + 1;
        ix = ix + 1;
    }
    let a0: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i64, ptr } undef, i64 ");
    cgo_int(c, n);
    cgo_str(c, ", 0\n");
    let a1: i64 = cg_dst(c);
    cgo_str(c, "insertvalue { i64, ptr } %v");
    cgo_int(c, a0);
    cgo_str(c, ", ptr %v");
    cgo_int(c, data);
    cgo_str(c, ", 1\n");
    while len((*c).cgak) > snap {
        let _a: i64 = pop(&mut (*c).cgak);
        let _b: i64 = pop(&mut (*c).cgav);
        let _t: i64 = pop(&mut (*c).cgat);
        0
    }
    cg_reg(c, a1)
}

// (8c-2) emit `a[i]`: extract len(0)/data(1), bounds-check (0 <= i < len, else
// `sentinel_panic_oob` + `unreachable`), then GEP+load. Sets the operand to the
// loaded value. Blocks: oob first (dead-ends), ok second (continues).
fn cg_emit_index(c: &mut TyCtx, ety: i64, tty: i64, tk: i64, tv: i64, ik: i64, iv: i64) -> i64 {
    // `<agg>` is the target's actual type (`{i64,ptr}` for `[T]` with data at field 1,
    // `{i64,i64,ptr}` for `Vec<T>` with data at field 2; len is field 0 for both).
    let ln: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tty);
    cg_putc(c, ' ');
    cgo_operand(c, tk, tv);
    cgo_str(c, ", 0\n");
    let dat: i64 = cg_dst(c);
    cgo_str(c, "extractvalue ");
    cgo_ty(c, tty);
    cg_putc(c, ' ');
    cgo_operand(c, tk, tv);
    cgo_str(c, ", ");
    if cg_is_vec(c, tty) {
        cgo_int(c, 2)
    } else {
        cgo_int(c, 1)
    };
    cg_putc(c, '\n');
    let ge: i64 = cg_dst(c);
    cgo_str(c, "icmp sge i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", 0\n");
    let lt: i64 = cg_dst(c);
    cgo_str(c, "icmp slt i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", %v");
    cgo_int(c, ln);
    cg_putc(c, '\n');
    let inb: i64 = cg_dst(c);
    cgo_str(c, "and i1 %v");
    cgo_int(c, ge);
    cgo_str(c, ", %v");
    cgo_int(c, lt);
    cg_putc(c, '\n');
    let oob: i64 = cg_fresh_block(c);
    let ok: i64 = cg_fresh_block(c);
    cgo_str(c, "  br i1 %v");
    cgo_int(c, inb);
    cgo_str(c, ", label %bb");
    cgo_int(c, ok);
    cgo_str(c, ", label %bb");
    cgo_int(c, oob);
    cg_putc(c, '\n');
    cgo_str(c, "bb");
    cgo_int(c, oob);
    cgo_str(c, ":\n");
    cgo_str(c, "  call void @sentinel_panic_oob(i64 ");
    cgo_operand(c, ik, iv);
    cgo_str(c, ", i64 %v");
    cgo_int(c, ln);
    cgo_str(c, ")\n");
    (*c).cg_used_panic = true;
    cgo_str(c, "  unreachable\n");
    cgo_str(c, "bb");
    cgo_int(c, ok);
    cgo_str(c, ":\n");
    let ep: i64 = cg_dst(c);
    cgo_str(c, "getelementptr ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr %v");
    cgo_int(c, dat);
    cgo_str(c, ", i64 ");
    cgo_operand(c, ik, iv);
    cg_putc(c, '\n');
    let v: i64 = cg_dst(c);
    cgo_str(c, "load ");
    cgo_ty(c, ety);
    cgo_str(c, ", ptr %v");
    cgo_int(c, ep);
    cg_putc(c, '\n');
    cg_reg(c, v)
}

fn cg_emit_fn(c: &mut TyCtx, src: &[u8], name_s: i64, name_e: i64, rty: i64) -> i64 {
    let bk: i64 = (*c).cglk;
    let bv: i64 = (*c).cglv;
    (*c).cg_to_body = false;
    cgo_str(c, "define ");
    if (*c).cgmain {
        cgo_str(c, "i32")
    } else {
        cgo_ty(c, rty)
    };
    cgo_str(c, " @");
    cgo_slice(c, src, name_s, name_e);
    cg_putc(c, '(');
    let np: i64 = len((*c).cgpty);
    let mut i: i64 = 0;
    while i < np {
        if i > 0 {
            cgo_str(c, ", ")
        } else {
            0
        };
        let pty: i64 = (*c).cgpty[i];
        cgo_ty(c, pty);
        cgo_str(c, " %arg");
        cgo_int(c, i);
        i = i + 1;
    }
    cgo_str(c, ") {\nentry:\n");
    // the HOISTED allocas (params + lets + if-results), in reservation order.
    let na: i64 = len((*c).cgalloca_sl);
    let mut ai: i64 = 0;
    while ai < na {
        let asl: i64 = (*c).cgalloca_sl[ai];
        let aty: i64 = (*c).cgalloca_ty[ai];
        cgo_str(c, "  %v");
        cgo_int(c, asl);
        cgo_str(c, " = alloca ");
        cgo_ty(c, aty);
        cg_putc(c, '\n');
        ai = ai + 1;
    }
    // the buffered body (cgbody) — folded into cgout via the builtin push.
    let nb: i64 = len((*c).cgbody);
    let mut bi: i64 = 0;
    while bi < nb {
        let byte: u8 = (*c).cgbody[bi];
        push(&mut (*c).cgout, byte);
        bi = bi + 1;
    }
    // the return (main truncates its i64 body to i32 — the C ABI).
    if (*c).cgmain {
        let d: i64 = cg_dst(c);
        cgo_str(c, "trunc i64 ");
        cgo_operand(c, bk, bv);
        cgo_str(c, " to i32\n");
        cgo_str(c, "  ret i32 %v");
        cgo_int(c, d);
        cg_putc(c, '\n');
        0
    } else {
        cgo_str(c, "  ret ");
        cgo_ty(c, rty);
        cg_putc(c, ' ');
        cgo_operand(c, bk, bv);
        cg_putc(c, '\n');
        0
    };
    cgo_str(c, "}\n\n");
    0
}

// Reset the per-fn MIR pools (between fns; value/block ids are per-fn).
fn mir_reset(c: &mut TyCtx) -> i64 {
    clear_i64(&mut (*c).mvty);
    clear_i64(&mut (*c).miblk);
    clear_i64(&mut (*c).midst);
    clear_i64(&mut (*c).miop);
    clear_i64(&mut (*c).misym);
    clear_i64(&mut (*c).mia);
    clear_i64(&mut (*c).mib);
    clear_i64(&mut (*c).mbpb);
    clear_i64(&mut (*c).mbpv);
    clear_i64(&mut (*c).mtb);
    clear_i64(&mut (*c).mtk);
    clear_i64(&mut (*c).mta);
    clear_i64(&mut (*c).mtt);
    clear_i64(&mut (*c).mte);
    clear_i64(&mut (*c).mtjs);
    clear_i64(&mut (*c).mtje);
    clear_i64(&mut (*c).mtj);
    clear_i64(&mut (*c).mvdv);
    clear_i64(&mut (*c).mvdl);
    clear_i64(&mut (*c).margs);
    clear_i64(&mut (*c).mias);
    clear_i64(&mut (*c).miae);
    clear_i64(&mut (*c).miargs);
    (*c).mir_nblk = 0;
    (*c).mir_cur = 0;
    (*c).lastval = 0 - 1;
    0
}

fn mir_new_value(c: &mut TyCtx, ty: i64) -> i64 {
    let id: i64 = len((*c).mvty);
    push(&mut (*c).mvty, ty);
    id
}

fn mir_new_block(c: &mut TyCtx) -> i64 {
    let id: i64 = (*c).mir_nblk;
    (*c).mir_nblk = (*c).mir_nblk + 1;
    id
}

fn mir_add_param(c: &mut TyCtx, blk: i64, ty: i64) -> i64 {
    let v: i64 = mir_new_value(c, ty);
    push(&mut (*c).mbpb, blk);
    push(&mut (*c).mbpv, v);
    v
}

// Append an instruction (op, sub-code sym, operands a/b) to block `blk`.
fn mir_emit(c: &mut TyCtx, blk: i64, op: i64, sym: i64, a: i64, b: i64, ty: i64) -> i64 {
    if (*c).mir_suppress {
        0 - 1
    } else {
        let d: i64 = mir_new_value(c, ty);
        push(&mut (*c).miblk, blk);
        push(&mut (*c).midst, d);
        push(&mut (*c).miop, op);
        push(&mut (*c).misym, sym);
        push(&mut (*c).mia, a);
        push(&mut (*c).mib, b);
        push(&mut (*c).mias, 0);
        push(&mut (*c).miae, 0);
        d
    }
}

// (7c) a variadic inst (op 6 call / op 7 opaque): the operands are margs[snap..] —
// copied into the flat `miargs` pool (recording the per-inst slice), then margs is
// truncated back to `snap`. `fidsym` holds the callee FnId for a call (else 0).
fn mir_emit_va(c: &mut TyCtx, blk: i64, op: i64, fidsym: i64, snap: i64, ty: i64) -> i64 {
    if (*c).mir_suppress {
        while len((*c).margs) > snap {
            let _x: i64 = pop(&mut (*c).margs);
            0
        }
        0 - 1
    } else {
        mir_emit_va_do(c, blk, op, fidsym, snap, ty)
    }
}

fn mir_emit_va_do(c: &mut TyCtx, blk: i64, op: i64, fidsym: i64, snap: i64, ty: i64) -> i64 {
    let d: i64 = mir_new_value(c, ty);
    let mas: i64 = len((*c).miargs);
    let mn: i64 = len((*c).margs);
    let mut i: i64 = snap;
    while i < mn {
        let av: i64 = (*c).margs[i];
        push(&mut (*c).miargs, av);
        i = i + 1;
    }
    let mae: i64 = len((*c).miargs);
    while len((*c).margs) > snap {
        let _x: i64 = pop(&mut (*c).margs);
        0
    }
    push(&mut (*c).miblk, blk);
    push(&mut (*c).midst, d);
    push(&mut (*c).miop, op);
    push(&mut (*c).misym, fidsym);
    push(&mut (*c).mia, 0);
    push(&mut (*c).mib, 0);
    push(&mut (*c).mias, mas);
    push(&mut (*c).miae, mae);
    d
}

// (7c) push a child's MirValue onto the operand stack (called by the arg-list
// walkers under mode 2); returns the stack depth BEFORE the push is irrelevant —
// callers snapshot `len(margs)` themselves.
fn mir_margs_push(c: &mut TyCtx, v: i64) -> i64 {
    push(&mut (*c).margs, v);
    0
}

// (7c) an Opaque with NO operands (a public constant: null / char / string lit).
fn mir_emit_opaque0(c: &mut TyCtx, blk: i64, ty: i64) -> i64 {
    let snap: i64 = len((*c).margs);
    mir_emit_va(c, blk, 7, 0, snap, ty)
}

// (7c) an Opaque with ONE operand (a field read, a widen, spawn/await, …).
fn mir_emit_opaque1(c: &mut TyCtx, blk: i64, a: i64, ty: i64) -> i64 {
    let snap: i64 = len((*c).margs);
    push(&mut (*c).margs, a);
    mir_emit_va(c, blk, 7, 0, snap, ty)
}

fn mir_margs_len(c: &mut TyCtx) -> i64 {
    len((*c).margs)
}

// (7c) push the just-walked child's MirValue onto the operand stack IFF a variadic
// arm is collecting (called by the shared arg-list walkers after each element).
fn mir_collect(c: &mut TyCtx) -> i64 {
    if mir_on(c) {
        if (*c).mir_collecting {
            let v: i64 = (*c).lastval;
            push(&mut (*c).margs, v);
            0
        } else {
            0
        };
        0
    } else {
        0
    };
    0
}

// (7c) at a widen site (`w` = the dump emitted a `(widen-* …)` wrapper), the MIR
// adds an Opaque value wrapping the node's value, typed as `exp` — matching the
// Rust's explicit `WidenToSecret`/`WidenToNullable` node (a dump-time wrapper here,
// an IR node there, lowered to `Opaque([inner])`).
fn mir_widen(c: &mut TyCtx, w: bool, exp: i64) -> i64 {
    if mir_on(c) {
        if w {
            let iv: i64 = (*c).lastval;
            let mc: i64 = (*c).mir_cur;
            let snap: i64 = mir_margs_len(c);
            mir_margs_push(c, iv);
            let d: i64 = mir_emit_va(c, mc, 7, 0, snap, exp);
            (*c).lastval = d;
            0
        } else {
            0
        };
        0
    } else {
        0
    };
    0
}

fn mir_term_return(c: &mut TyCtx, blk: i64, v: i64) -> i64 {
    push(&mut (*c).mtb, blk);
    push(&mut (*c).mtk, 2);
    push(&mut (*c).mta, v);
    push(&mut (*c).mtt, 0 - 1);
    push(&mut (*c).mte, 0 - 1);
    push(&mut (*c).mtjs, 0);
    push(&mut (*c).mtje, 0);
    0
}

// (7b) a conditional branch (branch args are always empty — the Rust lowering
// passes values via the JUMPs to the merge, not the branch).
fn mir_term_branch(c: &mut TyCtx, blk: i64, cond: i64, tb: i64, eb: i64) -> i64 {
    push(&mut (*c).mtb, blk);
    push(&mut (*c).mtk, 1);
    push(&mut (*c).mta, cond);
    push(&mut (*c).mtt, tb);
    push(&mut (*c).mte, eb);
    push(&mut (*c).mtjs, 0);
    push(&mut (*c).mtje, 0);
    0
}

// (7b) an unconditional jump to `target`, passing `args` to its block params.
fn mir_term_jump(c: &mut TyCtx, blk: i64, target: i64, args: &Vec<i64>) -> i64 {
    let st: i64 = len((*c).mtj);
    let na: i64 = len(*args);
    let mut i: i64 = 0;
    while i < na {
        let a: i64 = (*args)[i];
        push(&mut (*c).mtj, a);
        i = i + 1;
    }
    let en: i64 = len((*c).mtj);
    push(&mut (*c).mtb, blk);
    push(&mut (*c).mtk, 0);
    push(&mut (*c).mta, target);
    push(&mut (*c).mtt, 0 - 1);
    push(&mut (*c).mte, 0 - 1);
    push(&mut (*c).mtjs, st);
    push(&mut (*c).mtje, en);
    0
}

// var_defs: append-only (var,val) pairs; newest-first lookup.
fn mir_vd_set(c: &mut TyCtx, var: i64, val: i64) -> i64 {
    push(&mut (*c).mvdv, var);
    push(&mut (*c).mvdl, val);
    0
}

fn mir_vd_get(c: &mut TyCtx, var: i64) -> i64 {
    let mut i: i64 = len((*c).mvdv) - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*c).mvdv[i] == var {
                found = (*c).mvdl[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// ---- the per-fn MIR dump (the oracle format; appended to `mirout`) ----------

// (7b) var_defs depth (the snapshot mark at a branch).
fn mir_vd_len(c: &mut TyCtx) -> i64 {
    len((*c).mvdv)
}

// (7b) newest-first lookup of `var` in var_defs[0..hi); -1 if absent.
fn mir_vd_lp(c: &mut TyCtx, hi: i64, var: i64) -> i64 {
    let mut i: i64 = hi - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*c).mvdv[i] == var {
                found = (*c).mvdl[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// (7b) newest-first lookup of `var` in var_defs[lo..hi); -1 if absent.
fn mir_vd_lr(c: &mut TyCtx, lo: i64, hi: i64, var: i64) -> i64 {
    let mut i: i64 = hi - 1;
    let mut found: i64 = 0 - 1;
    while i >= lo {
        if found < 0 {
            if (*c).mvdv[i] == var {
                found = (*c).mvdl[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// (7b) pop var_defs back to depth `s` (restore an arm's bindings off the stack).
fn mir_vd_trunc(c: &mut TyCtx, s: i64) -> i64 {
    while len((*c).mvdv) > s {
        let _a: i64 = pop(&mut (*c).mvdv);
        let _b: i64 = pop(&mut (*c).mvdl);
        0
    }
    0
}

// (7b) newest-first lookup of `var` in a side (var,val) list; -1 if absent.
fn mir_side_lookup(sv: &Vec<i64>, sval: &Vec<i64>, var: i64) -> i64 {
    let mut i: i64 = len(*sv) - 1;
    let mut found: i64 = 0 - 1;
    while i >= 0 {
        if found < 0 {
            if (*sv)[i] == var {
                found = (*sval)[i];
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i - 1;
    }
    found
}

// The dump writes to a buffer `out` (a LOCAL in the caller — NOT a `(*c).field`,
// since passing a ctx-field `&mut` to a user fn re-borrows `c`). `out` and `c` are
// distinct borrows. The caller (`type_fn`) folds `out` into the `mirout` FIELD via
// a `push` loop (a builtin — the only way to append to a Vec field of `*c`).
fn mir_put_ty(out: &mut Vec<u8>, c: &mut TyCtx, rty: i64) -> i64 {
    let mut tb: Vec<u8> = vec_new();
    render_type(&mut tb, rty, c);
    let a: [u8] = vec_to_array(tb);
    append_str(out, a);
    0
}

// A value DEFINITION: `v<N>:<ty>`.
fn mir_put_def(out: &mut Vec<u8>, c: &mut TyCtx, v: i64) -> i64 {
    push(out, 'v');
    append_int(out, v);
    push(out, ':');
    let vt: i64 = (*c).mvty[v];
    mir_put_ty(out, c, vt);
    0
}

// A value USE: the bare `v<N>`.
fn mir_put_use(out: &mut Vec<u8>, v: i64) -> i64 {
    push(out, 'v');
    append_int(out, v);
    0
}

fn mir_put_uop(out: &mut Vec<u8>, uop: i64) -> i64 {
    let s: [u8] = if uop == 1 {
        "-"
    } else if uop == 2 {
        "!"
    } else if uop == 4 {
        "&"
    } else if uop == 5 {
        "&mut"
    } else {
        "*"
    };
    append_str(out, s);
    0
}

fn mir_put_bop(out: &mut Vec<u8>, bop: i64) -> i64 {
    let s: [u8] = if bop == 1 {
        "+"
    } else if bop == 2 {
        "-"
    } else if bop == 3 {
        "*"
    } else if bop == 4 {
        "/"
    } else if bop == 5 {
        "&"
    } else if bop == 6 {
        "|"
    } else if bop == 7 {
        "^"
    } else if bop == 8 {
        "=="
    } else if bop == 9 {
        "!="
    } else if bop == 10 {
        "<"
    } else if bop == 11 {
        "<="
    } else if bop == 12 {
        ">"
    } else {
        ">="
    };
    append_str(out, s);
    0
}

// (7c) render a variadic inst's args slice (` v<arg>` each) from miargs[mias..miae].
fn mir_dump_args(out: &mut Vec<u8>, c: &mut TyCtx, i: i64) -> i64 {
    let s: i64 = (*c).mias[i];
    let e: i64 = (*c).miae[i];
    let mut j: i64 = s;
    while j < e {
        push(out, ' ');
        let av: i64 = (*c).miargs[j];
        mir_put_use(out, av);
        j = j + 1;
    }
    0
}

fn mir_dump_inst(out: &mut Vec<u8>, c: &mut TyCtx, src: &[u8], i: i64) -> i64 {
    push(out, '(');
    let d: i64 = (*c).midst[i];
    mir_put_def(out, c, d);
    push(out, ' ');
    let op: i64 = (*c).miop[i];
    let sym: i64 = (*c).misym[i];
    let a: i64 = (*c).mia[i];
    let b: i64 = (*c).mib[i];
    if op == 0 {
        append_str(out, "const_int ");
        append_int(out, a);
        0
    } else if op == 1 {
        append_str(out, "const_bool ");
        if a == 0 {
            append_str(out, "false")
        } else {
            append_str(out, "true")
        };
        0
    } else if op == 2 {
        append_str(out, "unary ");
        mir_put_uop(out, sym);
        push(out, ' ');
        mir_put_use(out, a);
        0
    } else if op == 3 {
        append_str(out, "binop ");
        mir_put_bop(out, sym);
        push(out, ' ');
        mir_put_use(out, a);
        push(out, ' ');
        mir_put_use(out, b);
        0
    } else if op == 4 {
        append_str(out, "cmp ");
        mir_put_bop(out, sym);
        push(out, ' ');
        mir_put_use(out, a);
        push(out, ' ');
        mir_put_use(out, b);
        0
    } else if op == 5 {
        // load: base (a) + optional index (b, -1 = a `*p` deref).
        append_str(out, "load ");
        mir_put_use(out, a);
        if b >= 0 {
            push(out, ' ');
            mir_put_use(out, b);
            0
        } else {
            0
        };
        0
    } else if op == 6 {
        // call: callee name (the FnId is in `sym`) + the args slice.
        append_str(out, "call ");
        mir_put_callee(out, c, src, sym);
        mir_dump_args(out, c, i);
        0
    } else if op == 8 {
        // declassify: the one taint sink (operand in `a`).
        append_str(out, "declassify ");
        mir_put_use(out, a);
        0
    } else {
        // opaque (op 7): just the operand args slice.
        append_str(out, "opaque");
        mir_dump_args(out, c, i);
        0
    };
    push(out, ')');
    0
}

fn mir_dump_term(out: &mut Vec<u8>, c: &mut TyCtx, blk: i64) -> i64 {
    let n: i64 = len((*c).mtb);
    let mut i: i64 = 0;
    while i < n {
        if (*c).mtb[i] == blk {
            append_str(out, "(term ");
            let k: i64 = (*c).mtk[i];
            if k == 2 {
                append_str(out, "return");
                let rv: i64 = (*c).mta[i];
                if rv >= 0 {
                    push(out, ' ');
                    mir_put_use(out, rv);
                    0
                } else {
                    0
                };
                0
            } else if k == 0 {
                append_str(out, "jump b");
                let jt: i64 = (*c).mta[i];
                append_int(out, jt);
                let js: i64 = (*c).mtjs[i];
                let je: i64 = (*c).mtje[i];
                let mut a: i64 = js;
                while a < je {
                    push(out, ' ');
                    let av: i64 = (*c).mtj[a];
                    mir_put_use(out, av);
                    a = a + 1;
                }
                0
            } else {
                append_str(out, "branch ");
                let cv: i64 = (*c).mta[i];
                mir_put_use(out, cv);
                append_str(out, " (b");
                let bt: i64 = (*c).mtt[i];
                append_int(out, bt);
                append_str(out, ") (b");
                let be: i64 = (*c).mte[i];
                append_int(out, be);
                push(out, ')');
                0
            };
            push(out, ')');
            0
        } else {
            0
        };
        i = i + 1;
    }
    0
}

fn mir_dump_block(out: &mut Vec<u8>, c: &mut TyCtx, src: &[u8], blk: i64) -> i64 {
    append_str(out, "(block b");
    append_int(out, blk);
    append_str(out, " (params");
    let np: i64 = len((*c).mbpb);
    let mut p: i64 = 0;
    while p < np {
        if (*c).mbpb[p] == blk {
            push(out, ' ');
            let pv: i64 = (*c).mbpv[p];
            mir_put_def(out, c, pv);
            0
        } else {
            0
        };
        p = p + 1;
    }
    push(out, ')');
    let ni: i64 = len((*c).miblk);
    let mut i: i64 = 0;
    while i < ni {
        if (*c).miblk[i] == blk {
            push(out, ' ');
            mir_dump_inst(out, c, src, i);
            0
        } else {
            0
        };
        i = i + 1;
    }
    push(out, ' ');
    mir_dump_term(out, c, blk);
    push(out, ')');
    0
}

// (7c) render a call's callee name: a USER fn (FnId >= 14) from `ufs`/`ufe` via
// `src`; else a builtin's fixed name (FnId 0..=13 — the resolve/runtime map).
fn mir_put_callee(out: &mut Vec<u8>, c: &mut TyCtx, src: &[u8], fid: i64) -> i64 {
    if fid >= 14 {
        let s: i64 = (*c).ufs[fid - 14];
        let e: i64 = (*c).ufe[fid - 14];
        append_slice(out, src, s, e);
        0
    } else {
        let nm: [u8] = if fid == 0 {
            "print"
        } else if fid == 1 {
            "unwrap_or"
        } else if fid == 2 {
            "is_some"
        } else if fid == 3 {
            "len"
        } else if fid == 4 {
            "str_eq"
        } else if fid == 5 {
            "u8_to_i64"
        } else if fid == 6 {
            "i64_to_u8"
        } else if fid == 7 {
            "vec_new"
        } else if fid == 8 {
            "push"
        } else if fid == 9 {
            "pop"
        } else if fid == 10 {
            "vec_to_array"
        } else if fid == 11 {
            "read_file"
        } else if fid == 12 {
            "write_file"
        } else {
            "print_bytes"
        };
        append_str(out, nm);
        0
    }
}

// Write one fn's MIR (`(fn <name> <ret-ty> <block>…)`) into `out`.
fn mir_dump_fn(out: &mut Vec<u8>, c: &mut TyCtx, src: &[u8], name_s: i64, name_e: i64, rty: i64) -> i64 {
    append_str(out, "(fn ");
    append_slice(out, src, name_s, name_e);
    push(out, ' ');
    mir_put_ty(out, c, rty);
    let nb: i64 = (*c).mir_nblk;
    let mut b: i64 = 0;
    while b < nb {
        push(out, ' ');
        mir_dump_block(out, c, src, b);
        b = b + 1;
    }
    push(out, ')');
    push(out, '\n');
    0
}

// =============================================================================
// (7d) the const-time verifier (ADR 0044 D6) — `verify_constant_time` over the
// per-fn MIR: a `secret` value reaching a Branch cond / a Load index or base / a
// Binary(Div) divisor is a leak. Taint is read straight off each value's type
// (`is_secret` — the typer already computed the fixpoint). Leaks append to `mirout`
// in fn -> block -> inst -> terminator order (one `(leak <SinkKind>)` per line).
// =============================================================================

// A MirValue is tainted iff its type handle is `secret` (interner kind 3).
fn mir_val_secret(c: &mut TyCtx, v: i64) -> bool {
    if v < 0 {
        false
    } else {
        let h: i64 = (*c).mvty[v];
        is_secret(c, h)
    }
}

// Append `(leak <SinkKind>)` to `mirout` (via a local buffer + push-fold — a
// ctx-field `&mut` can't go to a user fn). kind 0 Branch / 1 MemoryIndex /
// 2 MemoryAddress / 3 Division.
fn mir_emit_leak(c: &mut TyCtx, kind: i64) -> i64 {
    let mut lb: Vec<u8> = vec_new();
    append_str(&mut lb, "(leak ");
    let nm: [u8] = if kind == 0 {
        "Branch"
    } else if kind == 1 {
        "MemoryIndex"
    } else if kind == 2 {
        "MemoryAddress"
    } else {
        "Division"
    };
    append_str(&mut lb, nm);
    push(&mut lb, ')');
    push(&mut lb, '\n');
    let n: i64 = len(lb);
    let mut i: i64 = 0;
    while i < n {
        push(&mut (*c).mirout, lb[i]);
        i = i + 1;
    }
    let _x: [u8] = vec_to_array(lb);
    0
}

// Verify the current fn's MIR (block order; insts then the terminator per block).
fn mir_verify_fn(c: &mut TyCtx) -> i64 {
    let nb: i64 = (*c).mir_nblk;
    let mut b: i64 = 0;
    while b < nb {
        let ni: i64 = len((*c).miblk);
        let mut i: i64 = 0;
        while i < ni {
            if (*c).miblk[i] == b {
                let op: i64 = (*c).miop[i];
                if op == 5 {
                    // load: a secret index (memory index) then a secret base (address).
                    let idx: i64 = (*c).mib[i];
                    if idx >= 0 {
                        if mir_val_secret(c, idx) {
                            mir_emit_leak(c, 1);
                            0
                        } else {
                            0
                        };
                        0
                    } else {
                        0
                    };
                    let base: i64 = (*c).mia[i];
                    if mir_val_secret(c, base) {
                        mir_emit_leak(c, 2);
                        0
                    } else {
                        0
                    };
                    0
                } else if op == 3 {
                    // binop: a secret divisor of an integer division (bop 4 = `/`).
                    if (*c).misym[i] == 4 {
                        let dv: i64 = (*c).mib[i];
                        if mir_val_secret(c, dv) {
                            mir_emit_leak(c, 3);
                            0
                        } else {
                            0
                        };
                        0
                    } else {
                        0
                    };
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            i = i + 1;
        }
        // terminator: a secret branch condition.
        let nt: i64 = len((*c).mtb);
        let mut t: i64 = 0;
        while t < nt {
            if (*c).mtb[t] == b {
                if (*c).mtk[t] == 1 {
                    let cond: i64 = (*c).mta[t];
                    if mir_val_secret(c, cond) {
                        mir_emit_leak(c, 0);
                        0
                    } else {
                        0
                    };
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            t = t + 1;
        }
        b = b + 1;
    }
    0
}

// (6/N) `snc types` entry: build (mode 0) + print the type dump.
fn main() -> i64 {
    let inp_path: [u8] = "input.sentinel";
    let inp: [u8] = read_file(inp_path);
    let mut result: Vec<u8> = vec_new();
    run(inp, 0, &mut result);
    let arr: [u8] = vec_to_array(result);
    print_bytes(arr);
    0
}
