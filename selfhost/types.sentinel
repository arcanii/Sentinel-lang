// selfhost/types.sentinel — the FOURTH compiler stage in Sentinel (ADR 0041).
//
// (4b) milestone-1: the SCALAR skeleton. Type-checks paramful `fn`s over the
// scalar grammar (int/bool lits, var refs, unary, binop/cmp/logic, `if`, blocks,
// `let` with inference, calls) and emits the `snc types` dump — the `snc resolve`
// S-expr EXTENDED with each expression node's inferred Type (a trailing ` :<type>`)
// — byte-for-byte. Differentially validated against `snc types` (the oracle in
// crates/sentinel-driver/src/types_dump.rs).
//
// ARCHITECTURE (ADR 0041 D3, refined at the build — see the ADR A3 amendment): the
// types stage needs ALL of resolve's name-binding machinery PLUS a type interner +
// a VarId->type env, and resolve's `RCtx` cannot be extended with type fields across
// a module boundary (and two-context threading is clunky). So `types.sentinel` is
// SELF-CONTAINED with one `TyCtx` bundle (resolve's name tables + the type interner
// + the env), importing only the PARSER (the AST + parse fns). It reuses resolve's
// IDIOMS as its own code.
//
// THE TYPE REPRESENTATION (ADR 0041 D4, probe-verified A1): a `Type` is an integer
// "type-handle". Scalars are fixed codes below BASE (i64=0/i32=1/bool=2/u8=3);
// compound types are interned into the flat parallel `tk`/`ta`/`tb` arrays
// (handle = BASE + index), hash-consed so structural equality is integer `==`.
// `render_type` walks handles to the structural text (the `type_display` form);
// the VarId->type env is APPEND-ONLY (`env[vid] = h` is IndexAssignNotSupported —
// push in VarId order, index-read).

module types;
part borrow;
part cg;
part mir;

use parser::Expr;
use parser::Stmts;
use parser::Stmt;
use parser::TypeE;
use parser::TyArgs;
use parser::TyOpt;
use parser::Args;
use parser::Fields;
use parser::Arms;
use parser::Pattern;
use parser::Binds;
use parser::HArms;
use parser::Ret;
use parser::tokenize;
use parser::guard_nesting;
use parser::parse_block;
use parser::parse_expr;
use parser::parse_type;
use parser::slice_of;
use parser::skip_effect_row;
use parser::append_int;
use parser::append_str;
use parser::append_slice;

// The type-check context: the type interner + the VarId->type env + the scope
// (name blob) + the user-fn table. One `&mut TyCtx` threaded through the walk
// (field access ALWAYS `(*c).field`; never move a Vec field out).
struct TyCtx {
    // --- type interner (handles >= BASE index these; hash-consed) ---
    tk: Vec<i64>,    // compound kind tag: 1 Array / 2 Ref / 3 Secret / 4 Nullable
    ta: Vec<i64>,    // payload A: inner-handle (Array/Secret/Nullable) | mut-flag (Ref)
    tb: Vec<i64>,    // payload B: inner-handle (Ref)
    // --- VarId -> type env (append-only, vid-indexed; vid == push order) ---
    env: Vec<i64>,
    // --- scope: name blob + slices + VarIds (resolve's NAME-BLOB model) ---
    nb: Vec<u8>,
    scs: Vec<i64>,
    sce: Vec<i64>,
    scv: Vec<i64>,
    base: i64,       // the current item's scope floor (array index)
    nextvid: i64,    // the active VarId counter
    // --- user-fn table: name slices (FnId = 21 + idx) + return-type handle ---
    ufs: Vec<i64>,
    ufe: Vec<i64>,
    ufret: Vec<i64>,
    // --- struct table: names live in `snb` (a struct-name blob, so render_type
    //     needs no `src`); StructId = index. `sts`/`ste` = blob offsets. ---
    snb: Vec<u8>,
    sts: Vec<i64>,
    ste: Vec<i64>,
    // --- field table (flat, one entry per struct field, in StructId order) ---
    fldo: Vec<i64>,   // owner StructId
    flds: Vec<i64>,   // field-name blob start (into `snb`)
    flde: Vec<i64>,   // field-name blob end
    fldty: Vec<i64>,  // field type handle
    // --- (4e) enum table: names live in `snb`; EnumId = index. ---
    ets: Vec<i64>,    // enum-name blob start (into `snb`)
    ete: Vec<i64>,    // enum-name blob end
    // --- (4e) variant table (flat, one entry per variant, grouped by EnumId in
    //     declaration order) — payload types are a flat slice into `varpay`. ---
    varo: Vec<i64>,   // owner EnumId
    varns: Vec<i64>,  // variant-name blob start (into `snb`)
    varne: Vec<i64>,  // variant-name blob end
    varps: Vec<i64>,  // payload-type slice start (into `varpay`)
    varpe: Vec<i64>,  // payload-type slice end
    varpay: Vec<i64>, // flat payload type handles
    // --- (4f) class table: names in `snb`; ClassId = index ---
    clns: Vec<i64>,   // class-name blob start (into `snb`)
    clne: Vec<i64>,   // class-name blob end
    // class fields (flat, one entry per field, owner ClassId)
    clfo: Vec<i64>,   // owner ClassId
    clfs: Vec<i64>,   // field-name blob start (into `snb`)
    clfe: Vec<i64>,   // field-name blob end
    clft: Vec<i64>,   // field type handle
    // class methods (flat, one entry per method, owner ClassId) — for dispatch
    clmo: Vec<i64>,   // owner ClassId
    clms: Vec<i64>,   // method-name blob start (into `snb`)
    clme: Vec<i64>,   // method-name blob end
    clmr: Vec<i64>,   // method return-type handle
    // --- (4f) trait table: names in `snb`; TraitId = index ---
    trns: Vec<i64>,
    trne: Vec<i64>,
    // trait methods (flat, owner TraitId) — name + return type
    trmo: Vec<i64>,
    trms: Vec<i64>,
    trme: Vec<i64>,
    trmr: Vec<i64>,
    // --- (4f) impl table: ImplId = index ---
    imns: Vec<i64>,   // impl name start (0,0 slot for a default/unnamed impl)
    imne: Vec<i64>,   // impl name end
    imtid: Vec<i64>,  // the impl's TraitId
    imcid: Vec<i64>,  // the impl's target ClassId
    trpos: Vec<i64>,  // trait token position (TraitId → token index; for delegate re-walk)
    // --- (4f-delegate) delegate records → synthesised forwarding impls ---
    dgcid: Vec<i64>,  // owning ClassId
    dgfs: Vec<i64>,   // delegate field-name src start
    dgfe: Vec<i64>,   // delegate field-name src end
    dgfx: Vec<i64>,   // delegate field index in the owning class
    dgft: Vec<i64>,   // delegate field type handle
    dgts: Vec<i64>,   // delegate trait-name src start
    dgte: Vec<i64>,   // delegate trait-name src end
    // --- (4g) effect table (names + op list keyed on SRC, as the perform/handle
    //     emit the effect/op names from the AST). EffectId = index. ---
    efs: Vec<i64>,    // effect name src start
    efe: Vec<i64>,    // effect name src end
    efoo: Vec<i64>,   // effect-op list: owner EffectId (one entry per op)
    efos: Vec<i64>,   // op name src start
    efoe: Vec<i64>,   // op name src end
    efor: Vec<i64>,   // op return-type handle
    voff: i64,        // effect-op-param count → the fn-region VarId base (ADR 0020)
    // --- (4h) generics ---------------------------------------------------------
    // Type-param scope: active while a generic decl's signature/body is typed; the
    // param INDEX is the position in this list. Names are copied into `tpb` (a
    // dedicated blob — `type_of_typeexpr` has no `src`, so it compares against this
    // blob). Reset to empty per decl (type-params don't nest in this language).
    tpb: Vec<u8>,     // type-param name blob
    tpns: Vec<i64>,   // type-param name start (into `tpb`)
    tpne: Vec<i64>,   // type-param name end (into `tpb`)
    // User-fn generic signature info (indexed by FnId-14, same order as `ufret`).
    uftp: Vec<i64>,   // type-param count (0 = non-generic)
    ufeff: Vec<i64>,  // (Bar B / effects c35b) 1 = effecting fn (non-Async effect row;
                      //   Kont* ABI — returns ptr, a call to it yields ptr), else 0
    ufps: Vec<i64>,   // param-type slice start (into `ufpp`)
    ufpe: Vec<i64>,   // param-type slice end
    ufpp: Vec<i64>,   // flat param-type handles (declaration order)
    // Generic-instance arg pool + per-instance arg-slice records. The
    // GenericInstance interner kind (10) stores the record index in `tb`;
    // hash-cons keys on the StructId (`ta`) + the arg CONTENT (ADR 0041 A1).
    gia: Vec<i64>,    // flat pool of generic-instance arg handles
    girs: Vec<i64>,   // per-record arg-slice start (into `gia`)
    gire: Vec<i64>,   // per-record arg-slice end (into `gia`)
    // --- (6/N) borrow-check move analysis (ADR 0043 A1) — a side-pass fused into the
    //     pass-2 walk: record each non-Copy `Var` used in a CONSUMING position. ---
    consuming: bool,  // is the current walk position consuming (a move) vs a borrow/read?
    curfn: i64,       // the top-level fn idx being typed (-1 outside a fn body → no record)
    mvf: Vec<i64>,    // moved-source records: owner fn idx
    mvv: Vec<i64>,    // moved-source records: the moved VarId (paired with `mvf`)
    // (ADR 0046) PARTIAL-move records — a Move-typed `base.field` consumed by value
    // (returned / passed by value) moves ONLY that field, not the whole `base`. Codegen
    // elides the field from `base`'s recursive drop; the mode-1 dump emits `#base.field`.
    // Triple-parallel with `mff` (owner fn idx) / `mfv` (base VarId) / `mfi` (field index).
    mff: Vec<i64>,    // partial-move records: owner fn idx
    mfv: Vec<i64>,    // partial-move records: the base VarId (paired with `mff`)
    mfi: Vec<i64>,    // partial-move records: the moved field index (paired with `mff`)
    // (ADR 0046) the just-dumped expression's base VarId IFF it is a DIRECT `Var` read,
    // else -1 — the mode-independent analogue of the cg-only `cg_lastvid`. Reset to -1 at
    // every `dump_texpr` entry; set to the resolved VarId by the `Var` arm. The
    // FieldAccess arm reads it (right after the target dump) to detect a `base.field`
    // PARTIAL move on a directly-named base.
    mvbv: i64,
    // --- (7/N) MIR lowering (ADR 0044) — built ONLY under `mode == 2` as a guarded
    //     side-effect of the pass-2 walk; PER-FN (reset in `type_fn`). Everything is
    //     a flat append-only parallel-Vec pool tagged by block (so out-of-order block
    //     construction still groups per block in the dump) — NO Vec index-assign. ---
    mode: i64,        // run mode: 0 = type dump, 1 = borrow moves, 2 = MIR
    lastval: i64,     // the MirValue most-recently produced (threaded to parents)
    mir_cur: i64,     // the current block id (insts/params append here)
    mir_nblk: i64,    // block count (= next block id)
    mvty: Vec<i64>,   // value table: type handle per MirValue (index = value id)
    miblk: Vec<i64>,  // insts, tagged by block: the owning block
    midst: Vec<i64>,  // inst dest MirValue
    miop: Vec<i64>,   // inst opcode: 0 const_int, 1 const_bool, 2 unary, 3 binop, 4 cmp
    misym: Vec<i64>,  // inst sub-code: unary uop / binop|cmp bop
    mia: Vec<i64>,    // inst operand a (const: immediate; unary: value; binop/cmp: left)
    mib: Vec<i64>,    // inst operand b (binop/cmp: right value)
    mbpb: Vec<i64>,   // block params, tagged by block: the owning block
    mbpv: Vec<i64>,   // block param MirValue
    mtb: Vec<i64>,    // terminators, tagged by block: the owning block (one per block)
    mtk: Vec<i64>,    // term kind: 0 jump, 1 branch, 2 return
    mta: Vec<i64>,    // term a: jump target / branch cond / return value (-1 = none)
    mtt: Vec<i64>,    // term then-block (branch)
    mte: Vec<i64>,    // term else-block (branch)
    mtjs: Vec<i64>,   // term jump-args slice start (into mtj)
    mtje: Vec<i64>,   // term jump-args slice end
    mtj: Vec<i64>,    // flat jump-args pool
    mvdv: Vec<i64>,   // var_defs (append-only): VarId
    mvdl: Vec<i64>,   // var_defs (append-only): current MirValue (paired with mvdv)
    mir_lastvid: i64, // the VarId the most-recent `Var` node resolved to (for assign)
    // (7c) variadic-op operands (call / opaque). `margs` is a STACK the arg-list
    // walkers push each child's MirValue onto; an emit copies margs[snap..] into the
    // flat `miargs` pool (recording the per-inst slice mias/miae) + truncates margs.
    margs: Vec<i64>,  // the operand-collection stack
    mias: Vec<i64>,   // per-inst args slice start (into miargs); 0 for fixed-arity ops
    miae: Vec<i64>,   // per-inst args slice end
    miargs: Vec<i64>, // flat inst-args pool
    mir_collecting: bool, // true while a variadic arm walks its args (gates the margs push,
                          // so a shared arg-walker in a non-collecting context can't pollute)
    mir_suppress: bool,   // true while walking a PLACE the IR doesn't lower as a value (an
                          // assign target, a handle arm) — emits are no-ops there
    mirout: Vec<u8>,  // accumulated per-fn MIR dump (the mode-2 result)
    // --- (8/N) codegen .ll emission (ADR 0045) — built ONLY under `mode == 4`, a fused
    //     side-build mirroring the mode-2 MIR machinery. PER-FN state reset in `type_fn`
    //     via `cg_reset`; `cgout` accumulates ALL fns (the mode-4 result). Straight-line
    //     (8a): ONE block, in-order; alloca/load/store (NO phi). Operands are threaded via
    //     `cglk`/`cglv` (kind 0 register `%vN` / 1 literal; value). ---
    cgnext: i64,      // per-fn SSA temp/slot counter (`%vN`)
    cglk: i64,        // last operand KIND: 0 register, 1 literal
    cglv: i64,        // last operand VALUE: the register N (kind 0) or the literal (kind 1)
    cgsv: Vec<i64>,   // slot pool (append-only): VarId
    cgsr: Vec<i64>,   // slot pool: the binding's alloca `%vN` (paired with cgsv)
    cgpty: Vec<i64>,  // this fn's param type handles (for the `define` header, in order)
    cgmain: bool,     // is the current fn `main`? (the C-ABI i32-trunc return)
    cgak: Vec<i64>,   // call-arg stack: operand kind
    cgav: Vec<i64>,   // call-arg stack: operand value
    cgat: Vec<i64>,   // call-arg stack: operand type handle
    cg_collecting: bool, // true while a call walks its args (gates cg_collect)
    cg_used_alloc: bool, // (8c-2) module emits `declare sentinel_alloc` iff set
    cg_used_realloc: bool, // (8d-Vec) `declare sentinel_realloc`
    cg_used_panic: bool, // (8c-2) module emits `declare sentinel_panic_oob` iff set
    cg_used_streq: bool, // (8d) `declare sentinel_str_eq`
    cg_used_rdfile: bool, // (8d) `declare sentinel_read_file`
    cg_used_wrfile: bool, // (8d) `declare sentinel_write_file`
    cg_used_print: bool, // (Bar B) `declare sentinel_print` (the print builtin, FnId 0)
    cg_used_prbytes: bool, // (8d) `declare sentinel_print_bytes`
    cg_used_memcpy: bool, // (8d-Vec-2) `declare void @llvm.memcpy.p0.p0.i64` (vec_to_array)
    cg_used_free: bool, // (8d-drops) `declare void @sentinel_free` (scope-exit heap drops)
    // (8d-drops) per-block scope frames for drop emission: each bound var (param /
    // `let`) records (VarId, type, slot); a block's exit frees the un-moved
    // heap-backed ones in reverse order. Frames nest via the recursive Block walk —
    // each block remembers its entry length (a mark) and truncates back to it.
    cgdv: Vec<i64>,   // scope-drop pool (append-only): VarId
    cgdt: Vec<i64>,   // scope-drop pool: the binding's type handle
    cgds: Vec<i64>,   // scope-drop pool: the binding's alloca `%vN` (paired with cgdv)
    cg_suppress: bool,   // true while walking an assign target (the Var arm records, no load)
    // (c36a) the program's tokens, COPIED for re-parsing handle `return` arm bodies at
    // each pure-drain site (the return arm lowers inline, but move semantics bar reusing
    // the parsed Expr). Populated once in `run` ONLY when mode 4 + a `return` token is
    // present (the selfhost compiler has no handlers → these stay empty there).
    cgtk: Vec<i64>,
    cgts: Vec<i64>,
    cgte: Vec<i64>,
    cg_ret_on: bool,   // (c36a) the enclosing handle has a non-identity `return v => body`
    cg_ret_ntok: i64,  // (c36a) the return var's token index (re-slice the name per site)
    cg_ret_tok0: i64,  // (c36a) the return body's start-token index (re-parse per site)
    cg_ph: i64,       // (c35d) inside an embedded-perform RESUMER: the placeholder slot
                      //   holding the resumed value (the Perform arm emits a load from it,
                      //   not a perform call); -1 everywhere else
    cg_lastvid: i64,  // the VarId the most-recent Var node resolved to (for assign)
    // (8b) the body is buffered per-fn so ALLOCAS can be HOISTED to the entry block
    // (the if-result type is known only mid-walk; loop-body allocas must not re-run per
    // iteration, ADR 0036). `cg_to_body` routes `cg_putc`: true during the walk (→ cgbody),
    // false at teardown (→ cgout, for the header/hoisted-allocas/ret).
    cgbody: Vec<u8>,       // the per-fn body .ll (folded into cgout at teardown)
    cgalloca_sl: Vec<i64>, // hoisted alloca slots (the %vN)
    cgalloca_ty: Vec<i64>, // hoisted alloca types (paired with cgalloca_sl)
    cg_to_body: bool,      // route cg_putc to cgbody (walk) vs cgout (teardown)
    cgblk: i64,            // per-fn basic-block label counter (bbN; entry is implicit)
    cg_loop_cond: Vec<i64>, // enclosing loops' cond-block labels (continue target)
    cg_loop_after: Vec<i64>,// enclosing loops' after-block labels (break target)
    cg_loop_floor: Vec<i64>,// (8d-drops-3) enclosing loops' scope-drop floor (the cgdv
                            // length at loop-body entry; break/continue drain cgdv[floor..])
    // (8e-2) match state: SET in the `Expr::Match` arm (the per-match cg_m_tag/payload/
    // result/merge are SAVED+RESTORED around `dump_tarms` for nested matches); cg_m_pj /
    // cg_m_armnext are transient (set in `dump_tpat`, used immediately / captured into a
    // local in `dump_tarms` before the body). The if-else-chain over the variant arms.
    cg_m_tag: i64,    // the scrutinee's tag register (icmp eq i32 tag, vidx per arm)
    cg_m_payload: i64,// the scrutinee's payload-ptr register (GEP the bound fields)
    cg_m_result: i64, // the result alloca slot (each arm stores its body value here)
    cg_m_merge: i64,  // the merge block (each arm branches here; the load follows)
    cg_m_armnext: i64,// the current arm's next-check block (set in dump_tpat; -1 = wildcard)
    cg_m_pj: i64,     // the current variant's flat index (for cg_emit_pstruct in the bind)
    cg_m_wild: bool,  // (8g) true once a `_` arm emitted the final-else body+br (the match epilogue then skips `unreachable`); save/restored around dump_tarms for nesting
    // (Bar B / generics-b) MONOMORPHIZATION. Generic fns are SKIPPED in the mode-4 main
    // walk + RE-WALKED once per instance. Recorded instances: `cgmono_fid[i]` = the
    // generic fn id, `cgmono_as[i]`/`cgmono_ae[i]` = its concrete-arg slice into the flat
    // `cgmono_pool`. `cggfn_id`/`cggfn_pos` = each generic fn's id → `fn`-token position
    // (for the re-walk). During a re-walk `cg_mono_on` is set + `cg_mono_args` holds the
    // instance's concrete args (so `type_of_typeexpr` resolves `T` → concrete and
    // `cg_emit_fn` mangles the symbol). `cg_targs` = the just-inferred type-args of a
    // generic CALL (set by `dump_generic_call`, read by `cg_emit_call` for the callee).
    cgmono_fid: Vec<i64>,
    cgmono_as: Vec<i64>,
    cgmono_ae: Vec<i64>,
    cgmono_pool: Vec<i64>,
    cggfn_id: Vec<i64>,
    cggfn_pos: Vec<i64>,
    cg_mono_on: bool,
    cg_mono_args: Vec<i64>,
    cg_targs: Vec<i64>,
    cgout: Vec<u8>,   // accumulated .ll across all fns (the mode-4 result)
    // (Bar B / classes) class init / method / impl-method DEFINEs. The pass-2 walk is
    // GROUPED (fns, then classes, then impls, then delegate-synth), so accumulating
    // every class/impl method here + appending it AFTER `cgout` (the fns + mono) yields
    // the oracle's order (all fns, then all class methods, then all impl methods). A
    // method has the pointer ABI: `self` is the FIRST param `ptr %arg0` (the live class
    // storage), declared params follow as `%arg1..`. `cg_to_cls` routes the header/
    // allocas/ret here (the body walk still targets cgbody, copied in at assembly).
    cgcls: Vec<u8>,
    cg_to_cls: bool,     // route cg_putc → cgcls (during a method DEFINE assembly)
    cg_self_var: i64,    // the synthetic `self` VarId inside a method (-1 outside) — its
                         // pointer IS `%arg0` (no alloca), so a `Var(self)` load / lvalue
                         // GEP / method-receiver uses `%arg0` (operand kind 4).
    cg_arg_base: i64,    // param `%arg` offset (0 = a free fn; 1 = a method — self is %arg0)
    cgm_pfx_kind: i64,   // current method-owner kind: 0 = class method, 1 = impl method
    cgm_named: bool,     // (impl method) the impl is NAMED (a `Plus`/`Doubling` prefix) vs default
    cgm_nm_s: i64,       // (impl method) impl-name `src` slice start (when cgm_named)
    cgm_nm_e: i64,       // impl-name `src` slice end
    cgm_type_cid: i64,   // the owning/target class (→ `%Class`/className via `snb`)
    cgm_trait_tid: i64,  // (impl method) the trait (→ traitName via `snb`)
    // (Bar B / effects, ADR 0020) the kont runtime symbols used (→ declares) + the
    // enclosing `handle`'s dispatch state (the if-else-chain mirror of the oracle).
    cg_used_perform: bool,   // declare sentinel_perform_op
    cg_used_resume: bool,    // declare sentinel_kont_resume
    cg_used_consume: bool,   // declare sentinel_kont_consume_pure
    cg_used_kontpure: bool,  // (c35b) declare sentinel_kont_pure (wrap a pure value)
    cg_used_kontpush: bool,  // (c35c) declare sentinel_kont_push (push a captured frame)
    // (concurrency / ADR 0024) the structured-concurrency runtime declares + state.
    cg_used_taskspawn: bool,
    cg_used_taskawait: bool,
    cg_used_scopeenter: bool,
    cg_used_scoperegister: bool,
    cg_used_scopeexit: bool,
    cg_used_channelnew: bool,
    cg_used_channelsend: bool,
    cg_used_channelrecv: bool,
    cg_used_channelclose: bool,
    cg_scope: i64,         // the enclosing `scope`'s *ScopeCtx register (-1 = no scope)
    cg_spawn_t: Vec<i64>,  // spawn-target FnIds (sorted+deduped) → one wrapper each at end
    cg_eff: bool,     // (c35b) is the fn being emitted effecting (Kont* ABI: ret ptr)?
    cg_tailk: bool,   // (c35b) did the just-lowered body tail produce a kont (a direct
                      //   perform / call-to-effecting)? else a pure tail → kont_pure-wrap
    cg_h_opid: i64,   // the current handle's loaded op_id register (for the arm icmps)
    cg_h_ck: i64,     // the current handle's loaded kont register (arm-param GEP + kont slot)
    cg_h_loop: i64,   // the dispatch loop block (a `k(v)` bubble re-enters it)
    cg_h_cks: i64,    // the current_kont_slot (a bubble stores the new kont here)
    cg_h_rslot: i64,  // the result memory cell (each arm / the pure case stores here)
    cg_h_merge: i64,  // the merge block (each arm / pure branches here; the load follows)
    cg_h_depth: i64,  // (c36b) dynamic handle nesting depth; `> 1` ⇒ this handle is nested
                      //   (its result is a Kont* the enclosing handle dispatches on)
}

fn tbase() -> i64 { 100 }

// --- name comparison (resolve idioms) ---------------------------------------

fn name_eq_src(src: &[u8], st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*src)[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

fn name_eq_lit(q: &[u8], lit: [u8]) -> bool {
    let qn: i64 = len(*q);
    let ln: i64 = len(lit);
    if qn != ln {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < ln {
            if (*q)[i] != lit[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare a blob slice `nb[st..en]` to the query name `q`.
fn blob_eq(c: &mut TyCtx, st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*c).nb[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Compare a struct-name-blob slice `snb[st..en]` to the query name `q` (the
// struct/field tables key on `snb`, NOT the scope blob `nb`).
fn snb_eq(c: &mut TyCtx, st: i64, en: i64, q: &[u8]) -> bool {
    let qn: i64 = len(*q);
    if en - st != qn {
        false
    } else {
        let mut i: i64 = 0;
        let mut ok: bool = true;
        while i < qn {
            if (*c).snb[st + i] != (*q)[i] {
                ok = false;
                0
            } else {
                0
            };
            i = i + 1;
        }
        ok
    }
}

// Sink a discarded owned `[u8]` (a resolved-away name) into the garbage Vec.
fn sink_name(gb: &mut Vec<u8>, name: [u8]) -> i64 {
    let n: i64 = len(name);
    let mut i: i64 = 0;
    while i < n {
        push(gb, name[i]);
        i = i + 1;
    }
    0
}

// --- the type interner (ADR 0041 D4) ----------------------------------------

// Hash-cons: linear-scan for `(kind, a, b)`; return the existing handle else
// append. Structurally-equal types share a handle → equality is integer `==`.
fn intern_type(c: &mut TyCtx, kind: i64, a: i64, b: i64) -> i64 {
    let n: i64 = len((*c).tk);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).tk[i] == kind {
                if (*c).ta[i] == a {
                    if (*c).tb[i] == b {
                        found = tbase() + i;
                        0
                    } else {
                        0
                    };
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    if found == 0 - 1 {
        push(&mut (*c).tk, kind);
        push(&mut (*c).ta, a);
        push(&mut (*c).tb, b);
        tbase() + n
    } else {
        found
    }
}

fn mk_array(c: &mut TyCtx, inner: i64) -> i64 { intern_type(c, 1, inner, 0) }
fn mk_ref(c: &mut TyCtx, m: i64, inner: i64) -> i64 { intern_type(c, 2, m, inner) }
fn mk_secret(c: &mut TyCtx, inner: i64) -> i64 { intern_type(c, 3, inner, 0) }
fn mk_nullable(c: &mut TyCtx, inner: i64) -> i64 { intern_type(c, 4, inner, 0) }
// (4h) a type-parameter handle, indexed by its position in the decl's `<…>` list
// (interner kind 9; renders `<T#idx>`). The name is always `T` in the dump (only
// the index distinguishes them, matching the Rust `type_display`).
fn mk_tparam(c: &mut TyCtx, idx: i64) -> i64 { intern_type(c, 9, idx, 0) }
// (4i) a growable `Vec<T>` handle (interner kind 11; a = element type handle);
// renders `Vec<T>`. The D.3 collections type — distinct from `[T]` (kind 1).
fn mk_vec(c: &mut TyCtx, elem: i64) -> i64 { intern_type(c, 11, elem, 0) }
// (4i) a `Task<T>` handle (interner kind 12; a = the spawned result type); renders
// `Task<T>`. The C4.4 structured-concurrency type (`spawn e → Task<U>`).
fn mk_task(c: &mut TyCtx, elem: i64) -> i64 { intern_type(c, 12, elem, 0) }
// (ADR 0066 M1.2) a `Channel<T>` handle (interner kind 13; a = the element type
// handle); renders `Channel<T>`. Lowers to an opaque `ptr` (*SentinelChannel).
fn mk_channel(c: &mut TyCtx, elem: i64) -> i64 { intern_type(c, 13, elem, 0) }

// --- (4h) type-param scope --------------------------------------------------

// Resolve a type-name query `q` to its type-param INDEX (position in the active
// `<…>` list), or -1 if `q` is not an in-scope type-param. Compares against `tpb`.
fn tp_lookup(c: &mut TyCtx, q: &[u8]) -> i64 {
    let qn: i64 = len(*q);
    let n: i64 = len((*c).tpns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            let st: i64 = (*c).tpns[i];
            let en: i64 = (*c).tpne[i];
            if en - st == qn {
                let mut j: i64 = 0;
                let mut ok: bool = true;
                while j < qn {
                    if (*c).tpb[st + j] != (*q)[j] {
                        ok = false;
                        0
                    } else {
                        0
                    };
                    j = j + 1;
                }
                if ok {
                    found = i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Clear the type-param scope (called at the start of each generic decl's typing —
// type-params don't nest in this language, so a full reset is correct).
fn tp_reset(c: &mut TyCtx) -> i64 {
    let mut t: i64 = len((*c).tpns);
    while t > 0 {
        pop(&mut (*c).tpns);
        pop(&mut (*c).tpne);
        t = t - 1;
    }
    let mut b: i64 = len((*c).tpb);
    while b > 0 {
        pop(&mut (*c).tpb);
        b = b - 1;
    }
    0
}

// If the cursor sits at a `<` (token 15), copy the type-param NAMES into the scope
// (resetting it first) and advance the cursor past the closing `>` (17); else just
// reset. Mirrors `skip_type_params`'s `<`/`>` depth walk, recording the first ident
// after each `<`/`,` (so a hypothetical `<T: Bound>` records only `T`).
fn tp_setup(c: &mut TyCtx, k: &Vec<i64>, s: &Vec<i64>, e: &Vec<i64>, src: &[u8], cur: &mut i64) -> i64 {
    tp_reset(c);
    if (*k)[*cur] != 15 {
        0
    } else {
        *cur = *cur + 1;            // skip `<`
        let mut depth: i64 = 1;
        let mut wantn: bool = true;
        while depth > 0 {
            let t: i64 = (*k)[*cur];
            if t == 15 {
                depth = depth + 1;
                0
            } else if t == 17 {
                depth = depth - 1;
                0
            } else if depth == 1 {
                if t == 29 {
                    wantn = true;
                    0
                } else if wantn {
                    let ns: i64 = (*s)[*cur];
                    let ne: i64 = (*e)[*cur];
                    let bst: i64 = len((*c).tpb);
                    let mut bi: i64 = ns;
                    while bi < ne {
                        push(&mut (*c).tpb, (*src)[bi]);
                        bi = bi + 1;
                    }
                    push(&mut (*c).tpns, bst);
                    push(&mut (*c).tpne, bst + (ne - ns));
                    wantn = false;
                    0
                } else {
                    0
                }
            } else {
                0
            };
            *cur = *cur + 1;
        }
        0
    }
}

// --- (4h) generic-instance interner -----------------------------------------

// A generic-instance handle `Decl<args>` (interner kind 10): the StructId lives in
// `ta`, an arg-slice RECORD index in `tb`. Hash-cons on the StructId + the arg-list
// CONTENT (ADR 0041 A1), so two `Pair<i64,i64>`s share one handle. The arg list is
// appended to the `gia` pool; `girs`/`gire` record its (start,end) slice.
fn mk_generic(c: &mut TyCtx, declid: i64, args: &Vec<i64>) -> i64 {
    let na: i64 = len(*args);
    let n: i64 = len((*c).tk);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if (*c).tk[i] == 10 {
                if (*c).ta[i] == declid {
                    let rec: i64 = (*c).tb[i];
                    let rs: i64 = (*c).girs[rec];
                    let re: i64 = (*c).gire[rec];
                    if re - rs == na {
                        let mut j: i64 = 0;
                        let mut ok: bool = true;
                        while j < na {
                            if (*c).gia[rs + j] != (*args)[j] {
                                ok = false;
                                0
                            } else {
                                0
                            };
                            j = j + 1;
                        }
                        if ok {
                            found = tbase() + i;
                            0
                        } else {
                            0
                        };
                        0
                    } else {
                        0
                    };
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    if found == 0 - 1 {
        let rs2: i64 = len((*c).gia);
        let mut j2: i64 = 0;
        while j2 < na {
            let av: i64 = (*args)[j2];
            push(&mut (*c).gia, av);
            j2 = j2 + 1;
        }
        let re2: i64 = len((*c).gia);
        let rec2: i64 = len((*c).girs);
        push(&mut (*c).girs, rs2);
        push(&mut (*c).gire, re2);
        let ni: i64 = len((*c).tk);
        push(&mut (*c).tk, 10);
        push(&mut (*c).ta, declid);
        push(&mut (*c).tb, rec2);
        tbase() + ni
    } else {
        found
    }
}

// If `h` is a generic instance (kind 10), its decl StructId; else -1.
fn gi_decl_of(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0 - 1
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 10 {
            (*c).ta[idx]
        } else {
            0 - 1
        }
    }
}

// The arg-slice start of a generic instance (assumes `h` is kind 10).
fn gi_argstart(c: &mut TyCtx, h: i64) -> i64 {
    let rec: i64 = (*c).tb[h - tbase()];
    (*c).girs[rec]
}

// The arg-slice end of a generic instance (assumes `h` is kind 10).
fn gi_argend(c: &mut TyCtx, h: i64) -> i64 {
    let rec: i64 = (*c).tb[h - tbase()];
    (*c).gire[rec]
}

// Scalar codes: i64=0, i32=1, bool=2, u8=3. -1 if `q` is not a scalar name.
fn scalar_code(q: &[u8]) -> i64 {
    if name_eq_lit(q, "i64") {
        0
    } else if name_eq_lit(q, "i32") {
        1
    } else if name_eq_lit(q, "bool") {
        2
    } else if name_eq_lit(q, "u8") {
        3
    } else {
        0 - 1
    }
}

// ADR 0049: bit width of a scalar type handle — i64(0)=64, i32(1)=32, u8(3)=8.
fn scalar_bits(h: i64) -> i64 {
    if h == 1 {
        32
    } else if h == 3 {
        8
    } else {
        64
    }
}

// Render a scalar handle (< BASE) structurally.
fn render_scalar(out: &mut Vec<u8>, h: i64) -> i64 {
    if h == 0 {
        append_str(out, "i64")
    } else if h == 1 {
        append_str(out, "i32")
    } else if h == 2 {
        append_str(out, "bool")
    } else if h == 3 {
        append_str(out, "u8")
    } else {
        append_str(out, "?T")
    }
}

// Render a type handle structurally — the `type_display` form (no interner IDs).
fn render_type(out: &mut Vec<u8>, h: i64, c: &mut TyCtx) -> i64 {
    if h < tbase() {
        render_scalar(out, h)
    } else {
        let idx: i64 = h - tbase();
        let k: i64 = (*c).tk[idx];
        let a: i64 = (*c).ta[idx];
        let b: i64 = (*c).tb[idx];
        if k == 1 {
            push(out, '[');
            render_type(out, a, c);
            push(out, ']');
            0
        } else if k == 2 {
            push(out, '&');
            if a == 1 {
                append_str(out, "mut ")
            } else {
                0
            };
            render_type(out, b, c);
            0
        } else if k == 3 {
            append_str(out, "secret ");
            render_type(out, a, c);
            0
        } else if k == 4 {
            push(out, '?');
            render_type(out, a, c);
            0
        } else if k == 6 {
            // Struct: render its name from the struct-name blob (a = StructId).
            let bs: i64 = (*c).sts[a];
            let be: i64 = (*c).ste[a];
            let mut bi: i64 = bs;
            while bi < be {
                push(out, (*c).snb[bi]);
                bi = bi + 1;
            }
            0
        } else if k == 7 {
            // Enum: render its name from the enum-name blob (a = EnumId).
            let es: i64 = (*c).ets[a];
            let ee: i64 = (*c).ete[a];
            let mut ei: i64 = es;
            while ei < ee {
                push(out, (*c).snb[ei]);
                ei = ei + 1;
            }
            0
        } else if k == 8 {
            // Class: render its name from the class-name blob (a = ClassId).
            let cs: i64 = (*c).clns[a];
            let ce: i64 = (*c).clne[a];
            let mut ci: i64 = cs;
            while ci < ce {
                push(out, (*c).snb[ci]);
                ci = ci + 1;
            }
            0
        } else if k == 9 {
            // (4h) TypeParam: `<T#idx>` (a = param index).
            append_str(out, "<T#");
            append_int(out, a);
            push(out, '>')
        } else if k == 10 {
            // (4h) GenericInstance: `Decl<arg0, arg1, …>` (a = StructId, b = the
            // arg-slice record index). Args are comma-space separated (the type
            // render uses `, `; the `(targs …)` list uses spaces — distinct).
            let gs: i64 = (*c).sts[a];
            let ge: i64 = (*c).ste[a];
            let mut gi: i64 = gs;
            while gi < ge {
                push(out, (*c).snb[gi]);
                gi = gi + 1;
            }
            push(out, '<');
            let grec: i64 = b;
            let grs: i64 = (*c).girs[grec];
            let gre: i64 = (*c).gire[grec];
            let mut ga: i64 = grs;
            while ga < gre {
                if ga > grs {
                    append_str(out, ", ")
                } else {
                    0
                };
                let ah: i64 = (*c).gia[ga];
                render_type(out, ah, c);
                ga = ga + 1;
            }
            push(out, '>')
        } else if k == 11 {
            // (4i) Vec<T>: `Vec<` + element + `>`.
            append_str(out, "Vec<");
            render_type(out, a, c);
            push(out, '>')
        } else if k == 12 {
            // (4i) Task<T>: `Task<` + result type + `>`.
            append_str(out, "Task<");
            render_type(out, a, c);
            push(out, '>')
        } else if k == 13 {
            // (ADR 0066 M1.2) Channel<T>: `Channel<` + element + `>`.
            append_str(out, "Channel<");
            render_type(out, a, c);
            push(out, '>')
        } else {
            append_str(out, "??")
        }
    }
}

fn mk_struct(c: &mut TyCtx, sid: i64) -> i64 { intern_type(c, 6, sid, 0) }

// Resolve a struct name (a query `[u8]`) to its StructId (its index in the struct
// table), or -1. Compares against the struct-name blob.
fn struct_lookup(c: &mut TyCtx, q: &[u8]) -> i64 {
    let n: i64 = len((*c).sts);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if snb_eq(c, (*c).sts[i], (*c).ste[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// The StructId underlying a type handle (a struct type, kind 6), or -1.
fn struct_of_handle(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0 - 1
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 6 {
            (*c).ta[idx]
        } else {
            0 - 1
        }
    }
}

// --- (4e) enum / variant tables --------------------------------------------

// The `Enum` type handle for EnumId `eid` (interner kind 7; render → its name).
fn mk_enum(c: &mut TyCtx, eid: i64) -> i64 { intern_type(c, 7, eid, 0) }

// Resolve an enum name (a query `[u8]`) to its EnumId, or -1. Keyed on `snb`.
fn enum_lookup(c: &mut TyCtx, q: &[u8]) -> i64 {
    let n: i64 = len((*c).ets);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if snb_eq(c, (*c).ets[i], (*c).ete[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// The EnumId underlying a type handle (an enum type, kind 7), or -1.
fn enum_of_handle(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0 - 1
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 7 {
            (*c).ta[idx]
        } else {
            0 - 1
        }
    }
}

// The variant index (0-based, decl order) of variant `q` in enum `eid`, or -1.
fn variant_index(c: &mut TyCtx, eid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).varo);
    let mut i: i64 = 0;
    let mut idx: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if (*c).varo[i] == eid {
            if found == 0 - 1 {
                if snb_eq(c, (*c).varns[i], (*c).varne[i], q) {
                    found = idx;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            idx = idx + 1;
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// The FLAT variant-table index of the `vidx`-th variant of enum `eid` (so its
// payload slice is `varps[j]..varpe[j]`), or -1.
fn variant_flat(c: &mut TyCtx, eid: i64, vidx: i64) -> i64 {
    let n: i64 = len((*c).varo);
    let mut i: i64 = 0;
    let mut idx: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if (*c).varo[i] == eid {
            if idx == vidx {
                if found == 0 - 1 {
                    found = i;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            idx = idx + 1;
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// Pop the scope (name blob slices + VarIds) back to `mark` — a match arm's payload
// bindings are scoped to that arm only (VarIds stay monotonic; the env is NOT
// popped — it is VarId-indexed + append-only).
fn truncate_scope(c: &mut TyCtx, mark: i64) -> i64 {
    let mut t: i64 = len((*c).scs);
    while t > mark {
        pop(&mut (*c).scs);
        pop(&mut (*c).sce);
        pop(&mut (*c).scv);
        t = t - 1;
    }
    0
}

// --- (4f) class / method tables --------------------------------------------

// The `Class` type handle for ClassId `cid` (interner kind 8; render → its name).
fn mk_class(c: &mut TyCtx, cid: i64) -> i64 { intern_type(c, 8, cid, 0) }

// Resolve a class name (a query `[u8]`) to its ClassId, or -1. Keyed on `snb`.
fn class_lookup(c: &mut TyCtx, q: &[u8]) -> i64 {
    let n: i64 = len((*c).clns);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if found == 0 - 1 {
            if snb_eq(c, (*c).clns[i], (*c).clne[i], q) {
                found = i;
                0
            } else {
                0
            };
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// The ClassId underlying a type handle (a class type, kind 8), or -1.
fn class_of_handle(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        0 - 1
    } else {
        let idx: i64 = h - tbase();
        if (*c).tk[idx] == 8 {
            (*c).ta[idx]
        } else {
            0 - 1
        }
    }
}

// Strip one reference layer: `&T` / `&mut T` (kind 2, inner in `tb`) → `T`; else
// unchanged. A method receiver `c.m()` carries the class value, but a `&Class` /
// `&mut Class` (e.g. a `self` re-borrow) strips to the class.
fn strip_ref(c: &mut TyCtx, h: i64) -> i64 {
    if h < tbase() {
        h
    } else if (*c).tk[h - tbase()] == 2 {
        (*c).tb[h - tbase()]
    } else {
        h
    }
}

// The field index (0-based, decl order) of class field `q` in class `cid`, or -1.
fn class_field_index(c: &mut TyCtx, cid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).clfo);
    let mut i: i64 = 0;
    let mut idx: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if (*c).clfo[i] == cid {
            if found == 0 - 1 {
                if snb_eq(c, (*c).clfs[i], (*c).clfe[i], q) {
                    found = idx;
                    0
                } else {
                    0
                };
                0
            } else {
                0
            };
            idx = idx + 1;
            0
        } else {
            0
        };
        i = i + 1;
    }
    found
}

// The type handle of class field `q` in class `cid`, or -1.
fn class_field_type(c: &mut TyCtx, cid: i64, q: &[u8]) -> i64 {
    let n: i64 = len((*c).clfo);
    let mut i: i64 = 0;
    let mut found: i64 = 0 - 1;
    while i < n {
        if (*c).clfo[i] == cid {
            if found == 0 - 1 {
