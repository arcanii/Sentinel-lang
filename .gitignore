# Build artifacts
/target/
**/target/
**/*.rs.bk
*.pdb
# `snc build` / `snc build --separate` emit object files (and, for the
# separate-compilation incremental cache, `.o.fp` fingerprint sidecars)
# beside the linked output.
*.o
*.o.fp

# Cargo lock for libraries is committed; this is a workspace with
# the snc binary, so Cargo.lock IS committed at the workspace root.

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test snapshots that are pending review
*.snap.new

# Local environment overrides
.env
.env.local

# Generated documentation builds
/book/

# BMad Method install + Claude Code skills (local tooling, not versioned)
/_bmad/
/.claude/