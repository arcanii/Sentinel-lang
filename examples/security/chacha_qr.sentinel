// examples/security/chacha_qr.sentinel — a true 32-bit ChaCha quarter-round.
//
// The ChaCha quarter-round (RFC 8439 §2.1) is the canonical ARX (add / rotate /
// xor) crypto primitive, defined on 32-bit words. Here it runs over four SECRET
// `i32` words: the adds wrap mod 2^32 (`add i32`), the xors are bitwise, and the
// rotations are by PUBLIC constants (16/12/8/7) via `std::security::ct::ct_rotl32`
// — so the whole permutation is branch-free and constant-time over secret state.
//
// This needs the `as` integer cast (ADR 0049) to construct the 32-bit words: a
// literal is `i64`, and `LITERAL as i32` truncates to the 32-bit value (the high
// bit makes a value like 0x9b8d6f43 a negative `i32` — the same bit pattern).
//
// Self-checking against the RFC 8439 §2.1.1 test vector
//   in:  a=0x11111111 b=0x01020304 c=0x9b8d6f43 d=0x01234567
//   out: a=0xea2a92f4 b=0xcb1cf8ce c=0x4581472e d=0x5881c4bb
// (constants written as unsigned decimals; `as i32` truncates to the i32 value).
// The compiler's constant-time check verifies the whole round on every build, so
// this program compiling at all is the guarantee. Exit 42 = the round reproduced
// the reference output.
use std::security::ct::ct_rotl32;

fn main() -> i64 {
    let mut a: secret i32 = 286331153 as i32;   // 0x11111111
    let mut b: secret i32 = 16909060 as i32;    // 0x01020304
    let mut c: secret i32 = 2609737539 as i32;  // 0x9b8d6f43
    let mut d: secret i32 = 19088743 as i32;    // 0x01234567

    // The quarter-round: add, xor, rotate-left-by-public-constant.
    a = a + b;
    d = d ^ a;
    d = ct_rotl32(d, 16);

    c = c + d;
    b = b ^ c;
    b = ct_rotl32(b, 12);

    a = a + b;
    d = d ^ a;
    d = ct_rotl32(d, 8);

    c = c + d;
    b = b ^ c;
    b = ct_rotl32(b, 7);

    let ra: i32 = declassify(a);
    let rb: i32 = declassify(b);
    let rc: i32 = declassify(c);
    let rd: i32 = declassify(d);

    if ra == (3928658676 as i32)        // 0xea2a92f4
        && rb == (3407673550 as i32)    // 0xcb1cf8ce
        && rc == (1166100270 as i32)    // 0x4581472e
        && rd == (1484899515 as i32)    // 0x5881c4bb
    {
        42
    } else {
        0
    }
}
