// examples/security/sha256.sentinel — constant-time SHA-256 over three NIST vectors.
//
// Hashes three secret messages with std::security::sha256 and checks each 32-byte
// digest against the published FIPS 180-4 / NIST value:
//   * "abc"          (single block)
//   * ""             (the empty message — a single all-padding block)
//   * 100 * 'a'      (a MULTI-BLOCK message: 100 bytes pads to 128 = 2 blocks, so
//                     it exercises the block loop and the 64-bit length encoding)
//
// CONSTANT-TIME DISCIPLINE. Each message is built as a `[secret u8]`, so the
// message CONTENT is secret and the library hashes it through branch-free ops
// only — the digest comes back `[secret u8]`. The compiler's constant-time check
// proves on every build that no secret byte reached a branch, a memory index, or
// a divisor (the message LENGTH is public, so the padding / block count / loop
// bounds are public). The ONLY declassify boundary is HERE in the example: we
// declassify each digest byte purely to XOR-diff it against the expected public
// constant — exactly the sanctioned "reduce branch-free, declassify the final
// accumulator" pattern of a tag verify.
//
// Exit 42 = all three digests matched their NIST vector byte-for-byte (the
// OR-accumulated per-byte diff `bad` is zero).
use std::security::sha256::sha256;

fn main() -> i64 {
    let mut bad: i64 = 0;

    // ---- Vector 1: SHA-256("abc"). Bytes 97, 98, 99.
    let mut m1: Vec<secret u8> = vec_new();
    push(&mut m1, i64_to_u8(97));
    push(&mut m1, i64_to_u8(98));
    push(&mut m1, i64_to_u8(99));
    let d1: [secret u8] = sha256(vec_to_array(m1));
    let e1: [i64] = [
        186, 120, 22, 191, 143, 1, 207, 234, 65, 65, 64, 222, 93, 174, 34, 35,
        176, 3, 97, 163, 150, 23, 122, 156, 180, 16, 255, 97, 242, 0, 21, 173
    ];
    let mut i1: i64 = 0;
    while i1 < 32 {
        bad = bad | (u8_to_i64(declassify(d1[i1])) ^ e1[i1]);
        i1 = i1 + 1;
    }

    // ---- Vector 2: SHA-256("") — the empty message.
    let m2: Vec<secret u8> = vec_new();
    let d2: [secret u8] = sha256(vec_to_array(m2));
    let e2: [i64] = [
        227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36,
        39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85
    ];
    let mut i2: i64 = 0;
    while i2 < 32 {
        bad = bad | (u8_to_i64(declassify(d2[i2])) ^ e2[i2]);
        i2 = i2 + 1;
    }

    // ---- Vector 3: SHA-256(100 * 'a') — a 2-block message ('a' = byte 97).
    let mut m3: Vec<secret u8> = vec_new();
    let mut p3: i64 = 0;
    while p3 < 100 {
        push(&mut m3, i64_to_u8(97));
        p3 = p3 + 1;
    }
    let d3: [secret u8] = sha256(vec_to_array(m3));
    let e3: [i64] = [
        40, 22, 89, 120, 136, 228, 160, 211, 163, 107, 130, 184, 51, 22, 171, 50,
        104, 14, 184, 240, 15, 140, 211, 185, 4, 214, 129, 36, 109, 40, 90, 14
    ];
    let mut i3: i64 = 0;
    while i3 < 32 {
        bad = bad | (u8_to_i64(declassify(d3[i3])) ^ e3[i3]);
        i3 = i3 + 1;
    }

    if bad == 0 { 42 } else { 0 }
}
