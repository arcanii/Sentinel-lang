// examples/security/chacha20_block.sentinel — a full ChaCha20 block.
//
// The ChaCha20 block function (RFC 8439 §2.3) is the keystream core of the
// ChaCha20 stream cipher: 20 rounds of the ARX quarter-round over a 16-word state,
// then add the original state back (the feed-forward). Here the whole 16-word
// state is SECRET (`[secret i32]`, ADR 0047) and is permuted IN PLACE via mutable
// index assignment (ADR 0050), inside `std::security::chacha20::chacha20_block` —
// the reusable block this example shares with the ChaCha20 stream cipher.
//
// Every operation on the secret state is data-independent (32-bit wrapping adds,
// XORs, rotations by PUBLIC constants), so the compiler's constant-time check
// verifies the whole block on every build — this program compiling at all is the
// guarantee.
//
// Self-checking against the RFC 8439 §2.3.2 test vector (key = 00:01:..:1f,
// nonce = 00:00:00:09:00:00:00:4a:00:00:00:00, counter = 1). Exit 42 = the block
// reproduced the reference keystream block (all 16 output words matched).
use std::security::chacha20::chacha20_block;

fn main() -> i64 {
    // The initial 16-word state: constants | key (8) | counter | nonce (3), each a
    // 32-bit word built with the `as i32` cast (a literal is `i64`).
    let w0: secret i32 = 1634760805 as i32;   // 0x61707865
    let w1: secret i32 = 857760878 as i32;    // 0x3320646e
    let w2: secret i32 = 2036477234 as i32;   // 0x79622d32
    let w3: secret i32 = 1797285236 as i32;   // 0x6b206574
    let w4: secret i32 = 50462976 as i32;     // 0x03020100
    let w5: secret i32 = 117835012 as i32;    // 0x07060504
    let w6: secret i32 = 185207048 as i32;    // 0x0b0a0908
    let w7: secret i32 = 252579084 as i32;    // 0x0f0e0d0c
    let w8: secret i32 = 319951120 as i32;    // 0x13121110
    let w9: secret i32 = 387323156 as i32;    // 0x17161514
    let w10: secret i32 = 454695192 as i32;   // 0x1b1a1918
    let w11: secret i32 = 522067228 as i32;   // 0x1f1e1d1c
    let w12: secret i32 = 1 as i32;           // counter
    let w13: secret i32 = 150994944 as i32;   // 0x09000000
    let w14: secret i32 = 1241513984 as i32;  // 0x4a000000
    let w15: secret i32 = 0 as i32;
    let state: [secret i32] = [w0, w1, w2, w3, w4, w5, w6, w7,
                               w8, w9, w10, w11, w12, w13, w14, w15];

    let out: [secret i32] = chacha20_block(state);

    // Verify against the RFC 8439 §2.3.2 output block: declassify each word and
    // OR-accumulate the XOR-diff into a public accumulator that is 0 iff every
    // word matched (the `as i64` widens the i32 diff for the reduction).
    let exp: [i32] = [
        3840405776 as i32, 358169553 as i32, 534581072 as i32, 3295748259 as i32,
        3354710471 as i32, 57196595 as i32, 2594841092 as i32, 1315755203 as i32,
        1180992210 as i32, 162176775 as i32, 98026004 as i32, 2718075865 as i32,
        3516666549 as i32, 3108902622 as i32, 3900952779 as i32, 1312575650 as i32
    ];
    let mut bad: i64 = 0;
    let mut j: i64 = 0;
    while j < 16 {
        let got: i32 = declassify(out[j]);
        let diff: i32 = got ^ exp[j];
        bad = bad | (diff as i64);
        j = j + 1;
    }
    if bad == 0 { 42 } else { 0 }
}
