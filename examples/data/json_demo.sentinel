// examples/data/json_demo.sentinel — exercises std::data::json (parse + serialize) and
// checks it against expected results. Exit 42 = JSON round-trips and parses correctly.
//
// This doubles as the feature test for the JSON library: a parse∘serialize round-trip
// over a comprehensive document and atoms (numbers, strings, booleans, null, nested
// arrays + objects), whitespace insensitivity, string escapes, and a parse-then-`match`
// extraction. The value is a cons-list recursive enum; serialize CONSUMES it.
use std::data::json::Json;
use std::data::json::json_parse;
use std::data::json::json_stringify;
use std::bytes::bytes::eq;
use std::test::check;
use std::test::report;

// round-trip: parse `doc`, serialize, and require the output equals `doc` (so `doc`
// must be canonical — no insignificant whitespace).
fn rt(doc: [u8]) -> i64 {
    let v: Json = json_parse(&doc);
    let out: [u8] = json_stringify(v);
    if eq(&out, &doc) { 0 } else { 1 }
}

// parse `doc`, serialize, and require the output equals `exp` (for non-canonical input).
fn rt2(doc: [u8], exp: [u8]) -> i64 {
    let v: Json = json_parse(&doc);
    let out: [u8] = json_stringify(v);
    if eq(&out, &exp) { 0 } else { 1 }
}

// parse `doc` and, if it is a number, return its value (else a sentinel).
fn num_of(doc: [u8]) -> i64 {
    let v: Json = json_parse(&doc);
    match v {
        Json::Num(n) => n,
        Json::Float(f) => f as i64,    // a float IS a number — its integer part
        Json::Null => 0 - 999,
        Json::Bool(b) => 0 - 999,
        Json::Str(s) => 0 - 999,
        Json::ArrNil => 0 - 999,
        Json::ArrCons(a, b) => 0 - 999,
        Json::ObjNil => 0 - 999,
        Json::ObjCons(k, vv, r) => 0 - 999,
    }
}

fn main() -> i64 {
    let mut passed: i64 = 0;
    let mut e: i64 = 0;   // per-section error accumulator

    // ---- atoms round-trip ----
    e = 0;
    e = e + rt("42");
    e = e + rt("-7");
    e = e + rt("0");
    e = e + rt("true");
    e = e + rt("false");
    e = e + rt("null");
    e = e + rt("\"hi\"");
    e = e + rt("[]");
    e = e + rt("{}");
    passed = passed + check("atoms round-trip (number / bool / null / string / [] / {})", e == 0);

    // ---- composites round-trip ----
    e = 0;
    e = e + rt("[1,2,3]");
    e = e + rt("[[1],[2,3]]");
    e = e + rt("{\"x\":1}");
    e = e + rt("{\"a\":[1,2],\"b\":{\"c\":true}}");
    passed = passed + check("nested arrays + objects round-trip", e == 0);

    // ---- a comprehensive canonical document ----
    e = 0;
    e = e + rt("{\"name\":\"sentinel\",\"n\":42,\"neg\":-7,\"ok\":true,\"no\":false,\"nil\":null,\"tags\":[\"a\",\"b\"],\"nested\":{\"x\":1}}");
    passed = passed + check("comprehensive canonical document round-trip", e == 0);

    // ---- whitespace insensitivity (non-canonical input -> canonical output) ----
    e = 0;
    e = e + rt2("[ 1 ,  2 , 3 ]", "[1,2,3]");
    e = e + rt2("{ \"a\" : 1 , \"b\" : 2 }", "{\"a\":1,\"b\":2}");
    passed = passed + check("whitespace insensitivity (non-canonical -> canonical)", e == 0);

    // ---- string escapes: a JSON string containing a quote and a backslash ----
    e = 0;
    e = e + rt("\"a\\\"b\"");      // JSON string  "a\"b"  round-trips
    e = e + rt("\"c\\\\d\"");      // JSON string  "c\\d"  round-trips
    passed = passed + check("string escapes (quote, backslash)", e == 0);

    // ---- float numbers now round-trip (ADR 0058; was a dropped fraction) ----
    e = 0;
    e = e + rt2("3.75", "3.75");
    e = e + rt2("-2.5", "-2.5");
    e = e + rt2("0.625", "0.625");
    e = e + rt2("1.5e2", "150.0");        // exponent -> canonical decimal
    e = e + rt2("3.14159", "3.14159");
    e = e + rt2("[1,2.5,3]", "[1,2.5,3]"); // ints and floats coexist in an array
    e = e + rt2("{\"pi\":3.14159,\"n\":42}", "{\"pi\":3.14159,\"n\":42}");
    // an integer (no '.'/exponent) stays an integer (Num, not Float)
    e = e + rt2("100", "100");
    passed = passed + check("float numbers round-trip, ints stay ints (ADR 0058)", e == 0);

    // ---- parse then match ----
    e = 0;
    e = e + (if num_of("42") == 42 { 0 } else { 1 });
    e = e + (if num_of("-100") == 0 - 100 { 0 } else { 1 });
    e = e + (if num_of("true") == 0 - 999 { 0 } else { 1 });   // not a number
    passed = passed + check("parse then match-extract a number", e == 0);

    report(passed, 7)
}
