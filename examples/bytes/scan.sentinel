// examples/bytes/scan.sentinel — scan and build byte strings with std::bytes.
//
// Ordinary (public) `[u8]` processing: find a byte, count occurrences, check a
// prefix, and build a fresh buffer. Exit 42 means every utility returned the
// expected result. (Contrast `examples/security/*`, which keep their data
// `secret` and stay branch-free; this is the everyday, non-secret counterpart.)
use std::bytes::bytes::find;
use std::bytes::bytes::count;
use std::bytes::bytes::contains;
use std::bytes::bytes::starts_with;
use std::bytes::bytes::eq;
use std::bytes::bytes::repeat;
use std::test::check;
use std::test::report;

fn main() -> i64 {
    // Borrow `s` (`&s`) so each utility reads it without consuming it.
    let s: [u8] = "hello, world";
    let prefix: [u8] = "hello";

    let comma: i64 = find(&s, ',');          // index 5
    let ells: i64 = count(&s, 'l');          // l at 2, 3, 10 -> 3

    let aaa: [u8] = repeat('a', 4);          // "aaaa"
    let four: i64 = count(&aaa, 'a');        // 4

    let mut passed: i64 = 0;
    passed = passed + check("find ',' in \"hello, world\" == 5", comma == 5);
    passed = passed + check("count 'l' == 3", ells == 3);
    passed = passed + check("contains 'w'", contains(&s, 'w'));
    passed = passed + check("starts_with \"hello\"", starts_with(&s, &prefix));
    passed = passed + check("eq(s, s)", eq(&s, &s));
    passed = passed + check("count 'a' in repeat('a',4) == 4", four == 4);

    report(passed, 6)
}
