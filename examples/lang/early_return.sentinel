// examples/lang/early_return.sentinel — explicit early `return` (ADR 0065).
//
// `return expr` exits the enclosing function immediately instead of falling
// through to the tail. It is a DIVERGENT expression: valid as a branch tail
// (`if guard { return x } else { … }`), so a function can bail out early
// (C/Go/Rust style) rather than nesting. Drops are correct across an early
// return — a heap binding live when the return fires is freed on the early-exit
// path AND on the fall-through path (never leaked, never double-freed). The
// constant-time guarantee is unchanged: `return` is unconditional control flow,
// not a branch on a value, so it is no new leak sink (a secret `if`-condition is
// still rejected at the `if`). Exit 42 = every check held.
use std::test::check;

// Early return as a guard: bail out on the error case up front instead of
// wrapping the real work in an else.
fn checked_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0 - 1
    } else {
        a / b
    }
}

// A heap binding (`buf`) is live when the early return fires. On the `present`
// path it is read then dropped by the early-exit drops; on the fall-through
// path it is dropped at scope end — exactly once on either path.
fn first_or_default(present: bool, fallback: i64) -> i64 {
    let buf: [u8] = "payload";
    if present {
        return len(buf)
    } else {
        fallback
    }
}

fn main() -> i64 {
    let mut passed: i64 = 0;
    passed = passed + check("checked_div(84, 2) == 42", checked_div(84, 2) == 42);
    passed = passed + check("checked_div(5, 0) == -1 (early-return guard)", checked_div(5, 0) == 0 - 1);
    passed = passed + check("first_or_default(true, 9) == 7 (heap live across return)", first_or_default(true, 9) == 7);
    passed = passed + check("first_or_default(false, 9) == 9", first_or_default(false, 9) == 9);

    // Early return on success; otherwise fall through to the failure code.
    if passed == 4 {
        return 42
    } else {
        0
    }
}
