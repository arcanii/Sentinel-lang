// std::security::ct — constant-time primitives over `secret` scalars.
//
// Every function here is BRANCH-FREE: it computes on `secret` values using only
// the data-independent operators (`^ & | + -`), never an `if`/`while` on a
// secret, never a secret array index, never a secret divisor. The compiler's
// constant-time check (`sentinel::mir::secret_leak`) verifies this on every
// build — if any of these leaked, `snc build` would reject the module. So a
// successful build of any program that uses this library is itself a proof that
// the constant-time discipline held across the call graph.
//
// The one sanctioned escape is `declassify`, which the CALLER applies to a final
// accumulator once the timing-sensitive work is done (e.g. the equality bit of a
// MAC/tag verify). These primitives stay in the `secret` domain so they compose;
// the caller decides when a result is safe to branch on.
//
// NOTE (language gap, tracked): a clean 0/1 `ct_eq` and a `ct_lt` need to
// broadcast a sign/MSB into a full-width mask (`x >> (W-1)`), which needs shift
// operators — Sentinel has none yet. Until shifts land, equality is expressed as
// "XOR-diff is zero": `ct_diff` + `ct_combine` produce a secret accumulator that
// is 0 iff all inputs matched, and the caller `declassify`s + compares `== 0`.

// XOR difference of two secret words: `0` iff `a == b`, nonzero otherwise. The
// building block of a constant-time equality — XOR each pair, then OR-reduce the
// diffs with `ct_combine`.
pub fn ct_diff(a: secret i64, b: secret i64) -> secret i64 {
    a ^ b
}

// OR-accumulate a difference into a running accumulator. `ct_combine(acc,
// ct_diff(a, b))` folds another pair into a "any difference seen" accumulator
// that is `0` iff every folded pair was equal.
pub fn ct_combine(acc: secret i64, diff: secret i64) -> secret i64 {
    acc | diff
}

// Bitwise NOT, branch-free: `x ^ 0xFFFF...FF`. The all-ones constant `0 - 1`
// widens public -> secret in operand position (ADR 0051), so it needs no
// pre-bound `secret`.
pub fn ct_not(x: secret i64) -> secret i64 {
    x ^ (0 - 1)
}

// Turn a secret selector bit (`0` or `1`) into a full-width mask: `0 -> 0`,
// `1 -> -1` (all ones). Branch-free via two's-complement negation; the public
// `0` widens to secret in operand position (ADR 0051).
pub fn ct_mask(bit: secret i64) -> secret i64 {
    0 - bit
}

// Branch-free select: returns `a` when `mask` is all-ones, `b` when `mask` is
// all-zeros. `(a & mask) | (b & ~mask)` — no branch on the secret selector.
pub fn ct_select(mask: secret i64, a: secret i64, b: secret i64) -> secret i64 {
    let nmask: secret i64 = ct_not(mask);
    (a & mask) | (b & nmask)
}

// Constant-time compare of two equal-length SECRET byte buffers (ADR 0047 —
// `[secret u8]`, arrays of secret elements). Returns a secret accumulator that
// is `0` iff every byte matched, nonzero otherwise — the variable-length analogue
// of `ct_diff` for a whole buffer (a tag / MAC verify).
//
// Constant-time by construction: the loop runs a FIXED number of iterations (the
// PUBLIC length `len(a)`) and indexes with a PUBLIC counter, so neither the
// iteration count nor the access pattern depends on the secret contents — there
// is no data-dependent early-out. Each `a[i]`/`b[i]` comes back `secret u8`, so
// the XOR/OR reduction stays in the secret domain; the caller `declassify`s the
// final accumulator and compares it against zero. The compiler's constant-time
// check verifies the whole path.
//
// Precondition: `len(a) == len(b)` (a real tag/MAC compare fixes the width). If
// `b` is shorter, an out-of-bounds index traps.
pub fn ct_memcmp(a: [secret u8], b: [secret u8]) -> secret u8 {
    let n: i64 = len(a);
    let zero: u8 = i64_to_u8(0);
    let mut acc: secret u8 = zero;   // u8 -> secret u8 widen
    let mut i: i64 = 0;
    while i < n {
        acc = acc | (a[i] ^ b[i]);   // public index i; secret bytes
        i = i + 1;
    }
    acc
}

// Constant-time rotate-left of a 64-bit SECRET word by a PUBLIC amount (ADR
// 0048). A rotation by a public/constant amount has data-independent latency —
// constant-time — so the `secret` value's timing does not leak. (A SECRET
// amount would be a variable-time shift; the compiler rejects that.) This is the
// rotate an ARX construction needs on its secret state. Masked like
// `std::bits::bits::rotl64` so a rotate by 0/64 is the identity.
pub fn ct_rotl64(x: secret i64, n: i64) -> secret i64 {
    let w: i64 = 64;
    let mask: i64 = 63;
    (x << (n & mask)) | (x >> ((w - n) & mask))
}

// Constant-time rotate-left of a 32-bit SECRET word by a PUBLIC amount — the
// 32-bit twin of `ct_rotl64` (ADR 0048 shifts + ADR 0049 i32). This is the
// rotate a 32-bit ARX construction (ChaCha) needs on its secret state: the
// logical `>>` zero-fills from bit 31, so `(x << k) | (x >> (32 - k))` is a true
// 32-bit rotate. Masked (`& 31`) so a rotate by 0/32 is the identity.
pub fn ct_rotl32(x: secret i32, n: i64) -> secret i32 {
    let w: i64 = 32;
    let mask: i64 = 31;
    (x << (n & mask)) | (x >> ((w - n) & mask))
}

// Constant-time rotate-RIGHT of a 32-bit SECRET word by a PUBLIC amount — the
// mirror of `ct_rotl32` (ADR 0048 shifts + ADR 0049 i32). This is the rotate
// SHA-256 needs on its secret state (Σ0/Σ1/σ0/σ1): the logical `>>` zero-fills
// from bit 31, so `(x >> k) | (x << (32 - k))` is a true 32-bit right-rotate.
// Masked (`& 31`) so a rotate by 0/32 is the identity. The amount `n` is PUBLIC
// (a SECRET shift amount would be variable-time and the compiler rejects it).
pub fn ct_rotr32(x: secret i32, n: i64) -> secret i32 {
    let w: i64 = 32;
    let mask: i64 = 31;
    (x >> (n & mask)) | (x << ((w - n) & mask))
}

// Constant-time rotate-RIGHT of a 64-bit SECRET word by a PUBLIC amount — the
// 64-bit twin of `ct_rotr32` and the mirror of `ct_rotl64`. This is the rotate
// SHA-512 needs on its secret state (Σ0/Σ1/σ0/σ1 over 64-bit words): the logical
// `>>` zero-fills from bit 63, so `(x >> k) | (x << (64 - k))` is a true 64-bit
// right-rotate. Masked (`& 63`) so a rotate by 0/64 is the identity. The amount
// `n` is PUBLIC (a SECRET shift amount would be variable-time and is rejected).
pub fn ct_rotr64(x: secret i64, n: i64) -> secret i64 {
    let w: i64 = 64;
    let mask: i64 = 63;
    (x >> (n & mask)) | (x << ((w - n) & mask))
}

// Constant-time equality of two GROWABLE secret byte buffers — the
// variable-length sibling of `ct_memcmp` (ADR 0052 `Vec<secret T>`). Where
// `ct_memcmp` compares fixed-size `[secret u8]` literals, this compares
// `Vec<secret u8>` buffers built up by `push` at run time, so the width need not
// be known when the code is written — the shape of an auth-tag / MAC verify over
// a message whose length is a run-time value.
//
// Constant-time by construction, exactly as `ct_memcmp`: the loop runs a FIXED
// number of iterations (the PUBLIC length `len(a)`) and indexes with a PUBLIC
// counter, so neither the iteration count nor the access pattern depends on the
// secret contents — no data-dependent early-out. Each `a[i]`/`b[i]` comes back
// `secret u8` (a `Vec<secret u8>` element; the buffer's pointer/length/capacity
// stay public), so the XOR/OR reduction stays in the secret domain; the caller
// `declassify`s the final accumulator and compares it against zero. The
// compiler's constant-time check verifies the whole path.
//
// The buffers are consumed (a `Vec` is Move), so the caller builds fresh ones
// per compare. Precondition: `len(a) == len(b)` (a real tag compare fixes the
// width); if `b` is shorter, an out-of-bounds index traps.
pub fn ct_vec_eq(a: Vec<secret u8>, b: Vec<secret u8>) -> secret u8 {
    let n: i64 = len(a);
    let zero: u8 = i64_to_u8(0);
    let mut acc: secret u8 = zero;   // u8 -> secret u8 widen
    let mut i: i64 = 0;
    while i < n {
        acc = acc | (a[i] ^ b[i]);   // public index i; secret bytes
        i = i + 1;
    }
    acc
}
