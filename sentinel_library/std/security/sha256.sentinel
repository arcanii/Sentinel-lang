// std::security::sha256 — a constant-time SHA-256 over a SECRET message (FIPS 180-4).
//
// SHA-256 hashes a `[secret u8]` message into a 32-byte SECRET digest. The whole
// compression is BRANCH-FREE over `secret i32` words: 32-bit wrapping adds, XORs,
// ANDs, and rotations / logical shifts by PUBLIC constants (via
// `std::security::ct::ct_rotr32`). The message CONTENT is secret and flows only
// through these data-independent ops; the message LENGTH is PUBLIC, so the
// padding amount, the block count, and every loop bound / array index are public
// — the access pattern never depends on the secret bytes. So a successful build
// of any program that hashes is itself a proof that the constant-time discipline
// held: the compiler's constant-time check (`sentinel::mir::secret_leak`) rejects
// any secret value reaching a branch, a memory index, or a divisor.
//
// The digest stays SECRET — nothing is declassified inside this library. A caller
// that wants to compare a digest (a tag verify) reduces the secret bytes
// branch-free and declassifies only the final accumulator.
//
// Implementation notes (the Sentinel constant-time idioms):
//   * A word is a `secret i32`; 32-bit wrapping arithmetic is the native `secret
//     i32` arithmetic. Mixed secret/public WIDENS, so a public round constant
//     `K[i]` adds straight into a secret accumulator (ADR 0051).
//   * The message schedule W is a `Vec<secret i32>` (ADR 0052): 16 big-endian
//     block words pushed, then 48 computed words pushed; indexed by a PUBLIC
//     counter.
//   * The padded message is a `Vec<secret u8>` (ADR 0052) — the secret message
//     bytes, then the PUBLIC padding (0x80, zeros, the 64-bit big-endian length)
//     pushed in (a public byte widens to `secret u8` at the push arg, ADR 0051),
//     then bridged to `[secret u8]` with `vec_to_array` (ADR 0053) and indexed by
//     a PUBLIC counter.
//   * Ch uses the no-NOT identity `g ^ (e & (f ^ g))` (Sentinel has no bitwise
//     NOT); Maj uses only `&`/`^`.
//   * A word -> 4 big-endian bytes is `(w >> (8*(3-j))) as u8` — a secret `>>` by
//     a public amount then an `as u8` cast that PRESERVES secrecy (ADR 0049).
use Sentinel::ct::ct_rotr32;

// Ch(e, f, g) = (e AND f) XOR ((NOT e) AND g). Sentinel has no bitwise NOT, so
// use the equivalent no-NOT identity: g ^ (e & (f ^ g)). Selects bit-for-bit
// from f where e is 1 and from g where e is 0 — branch-free.
fn ch(e: secret i32, f: secret i32, g: secret i32) -> secret i32 {
    g ^ (e & (f ^ g))
}

// Maj(a, b, c) = (a AND b) XOR (a AND c) XOR (b AND c) — the majority bit of the
// three inputs at each position. Only `&` and `^`, no NOT.
fn maj(a: secret i32, b: secret i32, c: secret i32) -> secret i32 {
    (a & b) ^ (a & c) ^ (b & c)
}

// Σ0(x) = ROTR(x, 2) ^ ROTR(x, 13) ^ ROTR(x, 22) — the working-var `a` mixer.
fn big_sigma0(x: secret i32) -> secret i32 {
    ct_rotr32(x, 2) ^ ct_rotr32(x, 13) ^ ct_rotr32(x, 22)
}

// Σ1(x) = ROTR(x, 6) ^ ROTR(x, 11) ^ ROTR(x, 25) — the working-var `e` mixer.
fn big_sigma1(x: secret i32) -> secret i32 {
    ct_rotr32(x, 6) ^ ct_rotr32(x, 11) ^ ct_rotr32(x, 25)
}

// σ0(x) = ROTR(x, 7) ^ ROTR(x, 18) ^ SHR(x, 3) — a message-schedule mixer. SHR
// is the logical right shift `>>` (zero-fill), exactly SHA-256's SHR.
fn small_sigma0(x: secret i32) -> secret i32 {
    ct_rotr32(x, 7) ^ ct_rotr32(x, 18) ^ (x >> 3)
}

// σ1(x) = ROTR(x, 17) ^ ROTR(x, 19) ^ SHR(x, 10) — a message-schedule mixer.
fn small_sigma1(x: secret i32) -> secret i32 {
    ct_rotr32(x, 17) ^ ct_rotr32(x, 19) ^ (x >> 10)
}

// Build the 64 round constants K (FIPS 180-4 §4.2.2) as a `Vec<secret i32>`. The
// public i32 constants widen to `secret i32` at each push arg (ADR 0051) so they
// add straight into the secret round accumulators.
fn k_constants() -> Vec<secret i32> {
    let mut k: Vec<secret i32> = vec_new();
    push(&mut k, 1116352408 as i32);  push(&mut k, 1899447441 as i32);
    push(&mut k, -1245643825 as i32); push(&mut k, -373957723 as i32);
    push(&mut k, 961987163 as i32);   push(&mut k, 1508970993 as i32);
    push(&mut k, -1841331548 as i32); push(&mut k, -1424204075 as i32);
    push(&mut k, -670586216 as i32);  push(&mut k, 310598401 as i32);
    push(&mut k, 607225278 as i32);   push(&mut k, 1426881987 as i32);
    push(&mut k, 1925078388 as i32);  push(&mut k, -2132889090 as i32);
    push(&mut k, -1680079193 as i32); push(&mut k, -1046744716 as i32);
    push(&mut k, -459576895 as i32);  push(&mut k, -272742522 as i32);
    push(&mut k, 264347078 as i32);   push(&mut k, 604807628 as i32);
    push(&mut k, 770255983 as i32);   push(&mut k, 1249150122 as i32);
    push(&mut k, 1555081692 as i32);  push(&mut k, 1996064986 as i32);
    push(&mut k, -1740746414 as i32); push(&mut k, -1473132947 as i32);
    push(&mut k, -1341970488 as i32); push(&mut k, -1084653625 as i32);
    push(&mut k, -958395405 as i32);  push(&mut k, -710438585 as i32);
    push(&mut k, 113926993 as i32);   push(&mut k, 338241895 as i32);
    push(&mut k, 666307205 as i32);   push(&mut k, 773529912 as i32);
    push(&mut k, 1294757372 as i32);  push(&mut k, 1396182291 as i32);
    push(&mut k, 1695183700 as i32);  push(&mut k, 1986661051 as i32);
    push(&mut k, -2117940946 as i32); push(&mut k, -1838011259 as i32);
    push(&mut k, -1564481375 as i32); push(&mut k, -1474664885 as i32);
    push(&mut k, -1035236496 as i32); push(&mut k, -949202525 as i32);
    push(&mut k, -778901479 as i32);  push(&mut k, -694614492 as i32);
    push(&mut k, -200395387 as i32);  push(&mut k, 275423344 as i32);
    push(&mut k, 430227734 as i32);   push(&mut k, 506948616 as i32);
    push(&mut k, 659060556 as i32);   push(&mut k, 883997877 as i32);
    push(&mut k, 958139571 as i32);   push(&mut k, 1322822218 as i32);
    push(&mut k, 1537002063 as i32);  push(&mut k, 1747873779 as i32);
    push(&mut k, 1955562222 as i32);  push(&mut k, 2024104815 as i32);
    push(&mut k, -2067236844 as i32); push(&mut k, -1933114872 as i32);
    push(&mut k, -1866530822 as i32); push(&mut k, -1538233109 as i32);
    push(&mut k, -1090935817 as i32); push(&mut k, -965641998 as i32);
    k
}

// Compress one 64-byte block (FIPS 180-4 §6.2.2) into the running state H. The
// state H is an 8-word `[secret i32]` mutated IN PLACE (ADR 0050) so it is never
// threaded by value through the block loop (which would move it — the poly1305
// pattern); the read-only block buffer `parr` and round-constant table `k` cross
// as borrows for the same reason. The 64-byte block is `(*parr)[base..base+64]`
// (indexed by the PUBLIC `base`). Builds the 64-word schedule W, runs 64 rounds
// over the working vars seeded from H, then adds a..h back into H. All secret
// words flow only through branch-free ops; every index is public.
fn compress_block(h8: &mut [secret i32], parr: &[secret u8], base: i64, k: &Vec<secret i32>) -> i64 {
    // ---- Build the message schedule W (a `Vec<secret i32>`, 64 words).
    // W[0..16]: the 16 big-endian words of this block. Each word is 4 secret
    // bytes assembled big-endian; the `(secret u8) as i32` cast zero-extends and
    // preserves secrecy (ADR 0049), and the shift amounts are public.
    let mut w: Vec<secret i32> = vec_new();
    let mut t: i64 = 0;
    while t < 16 {
        let off: i64 = base + t * 4;
        let b0: secret i32 = (*parr)[off] as i32;
        let b1: secret i32 = (*parr)[off + 1] as i32;
        let b2: secret i32 = (*parr)[off + 2] as i32;
        let b3: secret i32 = (*parr)[off + 3] as i32;
        let word: secret i32 = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
        push(&mut w, word);
        t = t + 1;
    }
    // W[16..64]: W[i] = σ1(W[i-2]) + W[i-7] + σ0(W[i-15]) + W[i-16]. The indices
    // are public; the 32-bit adds wrap.
    let mut i: i64 = 16;
    while i < 64 {
        let s1: secret i32 = small_sigma1(w[i - 2]);
        let s0: secret i32 = small_sigma0(w[i - 15]);
        let wi: secret i32 = s1 + w[i - 7] + s0 + w[i - 16];
        push(&mut w, wi);
        i = i + 1;
    }

    // ---- Seed the working vars from the running state H (Copy index-reads).
    let mut a: secret i32 = (*h8)[0];
    let mut b: secret i32 = (*h8)[1];
    let mut c: secret i32 = (*h8)[2];
    let mut d: secret i32 = (*h8)[3];
    let mut e: secret i32 = (*h8)[4];
    let mut f: secret i32 = (*h8)[5];
    let mut g: secret i32 = (*h8)[6];
    let mut hh: secret i32 = (*h8)[7];

    // ---- 64 rounds (FIPS 180-4 §6.2.2 step 3). The public K[r] widens to secret
    // and adds into the secret T1; the working-var rotation is explicit.
    let mut r: i64 = 0;
    while r < 64 {
        let t1: secret i32 = hh + big_sigma1(e) + ch(e, f, g) + (*k)[r] + w[r];
        let t2: secret i32 = big_sigma0(a) + maj(a, b, c);
        hh = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        r = r + 1;
    }

    // ---- Add the working vars back into the running state IN PLACE (32-bit
    // wrapping). Index-assign (ADR 0050) so H is not moved.
    (*h8)[0] = (*h8)[0] + a;
    (*h8)[1] = (*h8)[1] + b;
    (*h8)[2] = (*h8)[2] + c;
    (*h8)[3] = (*h8)[3] + d;
    (*h8)[4] = (*h8)[4] + e;
    (*h8)[5] = (*h8)[5] + f;
    (*h8)[6] = (*h8)[6] + g;
    (*h8)[7] = (*h8)[7] + hh;
    0
}

// SHA-256 of a SECRET message `msg` (FIPS 180-4). Returns the 32-byte SECRET
// digest as a `[secret u8]` (big-endian serialization of the 8 final hash words).
// The message length is PUBLIC, so the padding, block count, and all indices are
// public; the message content is secret and never reaches a branch or an index.
pub fn sha256(msg: [secret u8]) -> [secret u8] {
    let mlen: i64 = len(msg);

    // ---- Pad (FIPS 180-4 §5.1.1): append 0x80, then zero bytes until the length
    // is 56 mod 64, then the 64-bit big-endian message bit-length. The amount of
    // padding depends only on the PUBLIC message length, so it is computed with
    // public arithmetic (no `%`: x mod 64 = x - (x/64)*64) and pushed as PUBLIC
    // bytes that widen to `secret u8` at the push arg.
    let mut padded: Vec<secret u8> = vec_new();
    let mut j: i64 = 0;
    while j < mlen {
        push(&mut padded, msg[j]);   // secret message byte
        j = j + 1;
    }
    // The mandatory 0x80 terminator.
    push(&mut padded, i64_to_u8(128));
    // Zero-pad until total length ≡ 56 (mod 64). After the 0x80 the length is
    // mlen+1; we want (mlen+1+pad) mod 64 == 56.
    let after_one: i64 = mlen + 1;
    let rem: i64 = after_one - (after_one / 64) * 64;   // (mlen+1) mod 64
    let zeros: i64 = (56 + 64 - rem) - ((56 + 64 - rem) / 64) * 64;  // (56 - rem) mod 64
    let mut z: i64 = 0;
    while z < zeros {
        push(&mut padded, i64_to_u8(0));
        z = z + 1;
    }
    // The 64-bit big-endian message bit-length (mlen * 8). Byte k (k = 0..7) is
    // (bitlen >> (8 * (7 - k))) & 255 — a PUBLIC computation.
    let bitlen: i64 = mlen * 8;
    let mut k8: i64 = 0;
    while k8 < 8 {
        let shift: i64 = 8 * (7 - k8);
        let lb: i64 = (bitlen >> shift) & 255;
        push(&mut padded, i64_to_u8(lb));
        k8 = k8 + 1;
    }
    let parr: [secret u8] = vec_to_array(padded);
    let total: i64 = len(parr);

    // ---- Init the running state H = H0 (FIPS 180-4 §5.3.3) as an 8-word
    // `[secret i32]` mutated in place across the block loop (ADR 0050). The public
    // i32 constants widen to `secret i32` in the array literal (ADR 0051).
    let mut h8: [secret i32] = [
        1779033703 as i32,  -1150833019 as i32,
        1013904242 as i32,  -1521486534 as i32,
        1359893119 as i32,  -1694144372 as i32,
        528734635 as i32,    1541459225 as i32
    ];
    let k: Vec<secret i32> = k_constants();

    // ---- Compress each 64-byte block, mutating H in place. The block count =
    // total/64 is PUBLIC; `parr` and `k` cross as borrows (not moved by the loop).
    let nblocks: i64 = total / 64;
    let mut blk: i64 = 0;
    while blk < nblocks {
        compress_block(&mut h8, &parr, blk * 64, &k);
        blk = blk + 1;
    }

    // ---- Serialize the 8 final hash words big-endian into the 32-byte SECRET
    // digest. Byte j of word w is (w >> (8*(3-j))) as u8 — secret `>>` by a public
    // amount then an `as u8` cast that PRESERVES secrecy. The digest stays secret.
    let mut out: Vec<secret u8> = vec_new();
    push_word_be(&mut out, h8[0]);
    push_word_be(&mut out, h8[1]);
    push_word_be(&mut out, h8[2]);
    push_word_be(&mut out, h8[3]);
    push_word_be(&mut out, h8[4]);
    push_word_be(&mut out, h8[5]);
    push_word_be(&mut out, h8[6]);
    push_word_be(&mut out, h8[7]);
    vec_to_array(out)
}

// Append the 4 big-endian bytes of a SECRET 32-bit word `w` to the secret digest
// buffer. Byte j (j = 0..3) is (w >> (8*(3-j))) as u8 — the high byte first. The
// `>>` is by a PUBLIC amount and the `as u8` cast PRESERVES secrecy, so the bytes
// stay secret (no declassify).
fn push_word_be(out: &mut Vec<secret u8>, w: secret i32) -> i64 {
    let mut j: i64 = 0;
    while j < 4 {
        let shift: i64 = 8 * (3 - j);
        let byte: secret u8 = (w >> shift) as u8;
        push(out, byte);
        j = j + 1;
    }
    0
}
