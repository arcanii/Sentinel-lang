// Sentinel::secrets — the public⇄secret boundary vocabulary (ADR 0064).
//
// The two most fundamental operations in the language: crossing the `secret`
// boundary in each direction. `widen` lifts public bytes INTO the secret domain
// (so they can flow through constant-time code); `reveal` declassifies a whole
// `[secret u8]` buffer back to public, byte-by-byte.
//
// These were copy-pasted byte-identical across the crypto library and the trust
// tools (`examples/export/crypto_lib`, `tools/trust/{sign,keygen}_core`); they
// live here once — in the `Sentinel::` core base — so every program that crosses
// the boundary shares one definition.
//
// CONSTANT-TIME NOTE: `widen` is the sanctioned public→secret operand widen (ADR
// 0051) packaged as a buffer lift — it adds no escape hatch. `reveal` is built on
// the per-scalar `declassify` SPECIAL FORM (the only sanctioned way to drop the
// `secret` qualifier); it packages that one escape — applied deliberately when a
// value is safe to make public (a public key, a signature, a wire-bound message)
// — it does not introduce a new one. There is no array-level `declassify`, so
// `reveal` loops the per-scalar form.

// Widen a public byte buffer into a `[secret u8]` — lift public bytes into the
// secret domain (the ADR 0051 public→secret widen at the `push`, applied per byte).
pub fn widen(src: &[u8]) -> [secret u8] {
    let n: i64 = len(*src);
    let mut v: Vec<secret u8> = vec_new();
    let mut i: i64 = 0;
    while i < n {
        push(&mut v, (*src)[i]);
        i = i + 1;
    }
    vec_to_array(v)
}

// Declassify a `[secret u8]` to `[u8]`, byte-by-byte — the sanctioned public
// output of a whole buffer (a public key / signature / wire message). `declassify`
// is per-scalar, so this loops it.
pub fn reveal(d: [secret u8]) -> [u8] {
    let n: i64 = len(d);
    let mut out: Vec<u8> = vec_new();
    let mut i: i64 = 0;
    while i < n {
        push(&mut out, declassify(d[i]));
        i = i + 1;
    }
    vec_to_array(out)
}
