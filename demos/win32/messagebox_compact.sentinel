// demos/win32/messagebox_compact.sentinel
//
// The COMPACT, library-using counterpart to messagebox.sentinel: instead of
// redeclaring the Win32 bindings inline, it `use`s the std::sys::win32 library
// (which in turn uses std::c) — so the whole program is a few lines. user32
// self-links via the library's `extern "C" link("user32")`, so NO `--link`.
//
// BUILD: this file `use`s the std::sys::win32 library, which lives under the repo
// `sentinel_library/std/` tree (ADR 0064) — not adjacent to demos/. Point snc at
// the library root with `--lib-path` (ADR 0037 point 12: fallback module-search
// dirs tried after the entry file's own dir), so it builds IN PLACE — no copy
// needed. From the repo root (Windows):
//   snc build demos\win32\messagebox_compact.sentinel -o %TEMP%\messagebox_compact.exe --lib-path sentinel_library
//   %TEMP%\messagebox_compact.exe   (prints screen size, beeps, pops a box)
// (Or `set SNC_LIB_PATH=sentinel_library` once and drop the flag — every snc subcommand honors it.)

use std::sys::win32::screen_width;
use std::sys::win32::screen_height;
use std::sys::win32::beep;
use std::sys::win32::message_box;

fn main() -> i64 {
    print(screen_width());
    print(screen_height());
    beep();
    let text: [u8] = "Hello from Sentinel on Win32!";
    let caption: [u8] = "Sentinel";
    message_box(&text, &caption)
}
