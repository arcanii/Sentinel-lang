// ADR 0075 A3 (registers D102, D103, D104): a handler arm's remainder is replayed after a
// bubbling `k(v)` only in the shapes A3 argues give ADR 0020 D3's answer; everywhere else the
// bubble aborts (class (A)).
//
// The first group are arms the amendment refuses, each over a body that performs ONCE: the
// `k(v)` never bubbles, so the abort path is emitted and never taken, and the corpus
// differential holds `scg`'s emission of it to the oracle's byte for byte. Each would answer
// wrongly, or by luck, if it bubbled. The second group are arms it keeps, each over a body
// that bubbles, and each answers D3's value.
effect Io { read() -> i64; write() -> i64; }
effect Lg { log() -> i64; }
effect Em { emit(x: i64) -> i64; }
enum E { A(i64), B }

fn one() -> i64 ! { Io } { perform Io.read() }
fn lg_once() -> i64 ! { Lg } { perform Lg.log() }
fn emit_once() -> i64 ! { Em } { perform Em.emit(3) }
fn two() -> i64 ! { Io } {
    let a: i64 = perform Io.read();
    let b: i64 = perform Io.write();
    a + b
}
fn reads() -> i64 ! { Io } {
    let a: i64 = perform Io.read();
    let b: i64 = perform Io.read();
    let c: i64 = perform Io.read();
    a + b + c
}

// Refused: another op arm has a remainder of its own (10).
fn two_remainders() -> i64 {
    handle one() with { Io.read(k) => k(1) * 10, Io.write(k) => k(2) + 5 }
}

// Refused: another op arm answers without resuming (10).
fn sibling_answers() -> i64 {
    handle one() with { Io.read(k) => k(1) * 10, Io.write(k) => 7 }
}

// Refused: the `return` arm does more than return its value ((1 + 5) * 10 = 60).
fn return_arm_adds() -> i64 {
    handle one() with { Io.read(k) => k(1) * 10, return v => v + 5 }
}

// Refused: the remainder reads the arm's own parameter (0 + 3 = 3).
fn reads_its_parameter() -> i64 {
    handle emit_once() with { Em.emit(n, k) => k(0) + n }
}

// Refused: the remainder writes a `let mut` (1 + 101 = 102).
fn writes_a_let_mut() -> i64 {
    let mut base: i64 = 100;
    let x: i64 = handle one() with { Io.read(k) => { let r: i64 = k(1); base = base + 1; r } };
    x + base
}

// Refused: the remainder reads a `mut` parameter ((1 + 4) + 4 = 9).
fn reads_a_mut_param(mut base: i64) -> i64 {
    base = base + 2;
    let x: i64 = handle one() with { Io.read(k) => k(1) + base };
    x + base
}

// Refused: a `let mut` bound in the arm before its `k(v)`, which the `k(v)`'s argument
// writes: the replay binds it again and does not run the argument (1 + 7 = 8).
fn arm_local_let_mut() -> i64 {
    handle one() with { Io.read(k) => { let mut m: i64 = 0; let r: i64 = k({ m = 7; 1 }); r + m } }
}

// Refused: a captured `let mut` bound in a `while` body (2 + 3 = 5), an `if` branch (1 + 3 =
// 4) and a `match` arm (1 + 6 = 7).
fn let_mut_in_a_loop() -> i64 {
    let mut i: i64 = 0;
    let mut s: i64 = 0;
    while i < 2 {
        let mut t: i64 = i;
        t = t + 1;
        s = s + handle one() with { Io.read(k) => k(1) + t };
        i = i + 1;
    }
    s
}
fn let_mut_in_a_branch(c: bool) -> i64 {
    if c {
        let mut t: i64 = 2;
        t = t + 1;
        handle one() with { Io.read(k) => k(1) + t }
    } else {
        0
    }
}
fn let_mut_in_a_match() -> i64 {
    match E::A(5) {
        E::A(n) => {
            let mut t: i64 = n;
            t = t + 1;
            handle one() with { Io.read(k) => k(1) + t }
        },
        E::B => 0,
    }
}

// Refused: a `mut` parameter of an impl method, of a class `init`, and a `let mut` of a
// class method (2 + 1 + 1 = 4, 4 + 1 + 1 = 6, and 10 + 6 + 1 = 17).
trait Bump { fn bump(self: &Self, x: i64) -> i64; }
struct Job { n: i64 }
impl as Bump for Job {
    fn bump(self: &Self, mut x: i64) -> i64 {
        x = x + self.n;
        handle one() with { Io.read(k) => k(1) + x }
    }
}
class Acc {
    let n: i64;
    pub init(mut n0: i64) {
        n0 = n0 + 1;
        self.n = handle one() with { Io.read(k) => k(1) + n0 };
        0
    }
    pub fn add(self: &Self, d: i64) -> i64 {
        let mut e: i64 = d;
        e = e + self.n;
        handle one() with { Io.read(k) => k(1) + e }
    }
}

// Refused: the arm returns after its `k(v)`, beside another op arm (returns 11).
fn returns_beside_a_sibling() -> i64 {
    let x: i64 = handle one() with { Io.read(k) => return k(1) + 10, Io.write(k) => k(2) };
    x + 1000
}

// Refused: the inner `handle` is nested in the outer one, and the outer one's body is a
// `handle` (1 + 10 = 11; the outer arm is never entered).
fn nested() -> i64 {
    handle (handle lg_once() with { Lg.log(k) => k(1) + 10 }) with { Io.read(k) => k(5) + 1 }
}

// Refused: a lone arm that returns after its `k(v)`, in a nested `handle` (returns 11).
fn nested_lone_return() -> i64 {
    let x: i64 = handle (handle lg_once() with { Lg.log(k) => return k(1) + 10 }) with {
        Io.read(k) => k(5),
    };
    x + 1000
}

// Refused: two `k(v)`s, the arm returning on every path, are not class (X) (returns 1).
fn two_resumes_return() -> i64 {
    handle one() with {
        Io.read(k) => { let a: i64 = k(1); if a > 100 { return k(2) } else { return a } },
    }
}

// Kept: a lone arm whose remainder reads nothing (3 + 30 = 33).
fn replayed() -> i64 {
    handle reads() with { Io.read(k) => k(1) + 10 }
}

// Kept: the other op arm resumes once in tail position ((1 + 2) * 10 = 30).
fn beside_a_tail_arm() -> i64 {
    handle two() with { Io.read(k) => k(1) * 10, Io.write(k) => k(2) }
}

// Kept: as above, with a `handle` statement inside the tail arm, lowered before the replayed
// arm is judged ((1 + 2) * 10 = 30). (A `handle` inside an arm whose value is used is
// register D81.)
fn beside_an_arm_holding_a_handle() -> i64 {
    handle two() with {
        Io.write(k) => { handle lg_once() with { Lg.log(j) => j(1) }; k(2) },
        Io.read(k) => k(1) * 10,
    }
}

// Kept: the `return` arm returns its value (33).
fn identity_return_arm() -> i64 {
    handle reads() with { Io.read(k) => k(1) + 10, return v => v }
}

// Kept: the other op arm may return before its tail `k(v)`; that abandons the remainder
// pending in the activation, as it does under D3 (5 when it returns, else 30 + 1000).
fn sibling_returns_first(stop: bool) -> i64 {
    let x: i64 = handle two() with {
        Io.read(k) => k(1) * 10,
        Io.write(k) => { if stop { return 5 } else { 0 }; k(2) },
    };
    x + 1000
}

// Kept: the remainder reads an immutable binding (3 + 300 = 303).
fn reads_an_immutable() -> i64 {
    let base: i64 = 100;
    handle reads() with { Io.read(k) => k(1) + base }
}

// Kept: a lone arm that returns after its `k(v)` (the innermost entry returns 3 + 10 = 13).
fn lone_return() -> i64 {
    let x: i64 = handle reads() with { Io.read(k) => return k(1) + 10 };
    x + 1000
}

fn main() -> i64 {
    let j: Job = Job { n: 1 };
    let a: Acc = Acc::init(4);
    let refused: i64 = two_remainders() + sibling_answers() + return_arm_adds()
        + reads_its_parameter() + writes_a_let_mut() + reads_a_mut_param(2)
        + j.bump(2) + a.add(10) + arm_local_let_mut() + let_mut_in_a_loop()
        + let_mut_in_a_branch(true) + let_mut_in_a_match()
        + returns_beside_a_sibling() + nested() + nested_lone_return() + two_resumes_return();
    let kept: i64 = replayed() + beside_a_tail_arm() + beside_an_arm_holding_a_handle()
        + identity_return_arm() + sibling_returns_first(true)
        + sibling_returns_first(false) + reads_an_immutable() + lone_return();
    // refused = 10 + 10 + 60 + 3 + 102 + 9 + 4 + 17 + 8 + 5 + 4 + 7 + 11 + 11 + 11 + 1 = 273;
    // kept = 33 + 30 + 30 + 33 + 5 + 1030 + 303 + 13 = 1477
    refused + kept - 1708
}
