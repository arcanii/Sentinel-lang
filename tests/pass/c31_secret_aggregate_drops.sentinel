// ADR 0019 D5 (register D158): a `secret T` drops as its inner type does. A `secret`-qualified
// array, string, `Vec`, enum, struct or class is freed or released as the same value without
// the qualifier is, and a struct's drop walks a `secret`-qualified field like any other.
// inkwell always stripped the qualifier before it picked a drop; the oracle's `needs_drop`
// answered `false` for a `secret T` and its drop had no arm for one, and `scg`'s
// `cg_needs_drop` and `cg_emit_drop` dispatched on the qualified type, so in their output
// such a binding or parameter was never dropped and a struct walk skipped such a field.
//
// A `secret` aggregate has no field access, indexing or method call, so each shape reads its
// contents back through `declassify`, which moves its operand, as passing one by value does.
// Each shape runs 2,000 times, so a freed cell is reused by the next round, and `churn` takes
// over freed cells before each shape reads its values back. A drop the change added on a path
// that moved the value (flag ignored), of a field a move took, of a binding that `declassify` or
// a widening moved, or of a parameter a callee owns frees an array twice or releases a
// `Shared` twice (the runtime's debug refcount check aborts), or reads a cell a later
// allocation took over and answers wrong. A drop the change left out is a leak, which this
// exit code cannot see: `tests/llvm.rs` counts them.
//
// Exit 42 = all 12 shapes held on every round, and `keep` still holds 10.

struct H { s: Shared<i64>, a: [i64] }
struct G { a: secret [i64], b: [i64], h: secret H }
struct W { c: C, n: i64 }
struct Bx<T> { v: T, n: i64 }
struct Two<T> { v: T, w: T }

enum SE { A(secret [i64]), Hh(secret H), Z }
enum E { P([i64]), Q }

effect Io { read() -> i64; }

class C {
    let s: Shared<i64>;
    let n: i64;
    pub init(s: Shared<i64>, n: i64) { self.s = s; self.n = n; 0 }
    pub fn get(self: &Self) -> i64 { shared_get(self.s) + self.n }
}

// A class holding a `secret` struct (ADR 0071 A4: its drop releases the handle inside).
class CH {
    let h: secret H;
    let n: i64;
    pub init(h: secret H) { self.h = h; self.n = 1; 0 }
    pub fn get(self: &Self) -> i64 { self.n }
}

// An init and methods with `secret` parameters: the init stores one into a field and
// consumes the other; `m` consumes its parameters on one path; `keep_h` never reads its own.
class K {
    let h: secret H;
    let n: i64;
    pub init(h: secret H, a: secret [i64], n: i64) { self.h = h; self.n = n + eat(a); 0 }
    pub fn m(self: &Self, v: secret [i64], h: secret H, c: bool) -> i64 { if c { eat(v) + eat_h(h) } else { self.n } }
    pub fn keep_h(self: &Self, h: secret H) -> i64 { self.n }
}

fn eat(v: secret [i64]) -> i64 { let p: [i64] = declassify(v); p[0] }
fn eat_h(h: secret H) -> i64 { let p: H = declassify(h); shared_get(p.s) + p.a[0] }
fn eat_c(k: secret C) -> i64 { let c: C = declassify(k); c.get() }
fn eat_w(w: secret W) -> i64 { let p: W = declassify(w); p.c.get() + p.n }
fn eat_s(s: secret [u8]) -> i64 { let p: [u8] = declassify(s); (p[0] as i64) + len(p) }
fn eat_v(v: secret Vec<i64>) -> i64 { let p: Vec<i64> = declassify(v); p[0] }
fn consume(v: [i64]) -> i64 { v[0] }
fn take<T>(x: T) -> i64 { 1 }
fn idg<T>(x: T) -> T { x }
fn wrap<T>(x: T) -> Bx<T> { Bx { v: x, n: 1 } }
fn first<T>(t: Two<T>) -> T { t.v }
fn first_or<T>(t: Two<T>, c: bool, d: T) -> T { if c { t.v } else { d } }

fn churn() -> i64 {
    let mut i: i64 = 0;
    while i < 4 { let a: [i64] = [7777, 7777]; let b: [i64] = [7777]; let s: Shared<i64> = shared_new(7777); i = i + 1; }
    0
}

// Moved on one path: each drop at the end is behind the binding's moved flag. Answers 1.
fn one_path(n: i64, keep: Shared<i64>) -> i64 {
    let a: secret [i64] = [n, 2];
    let h: secret H = H { s: shared_new(n), a: [n] };
    let k: secret C = C::init(keep, n);
    let r: i64 = if n > 0 { eat(a) + eat_h(h) + eat_c(k) } else { 0 };
    churn();
    if n > 0 { if r == n + 2 * n + 10 + n { 1 } else { 0 } } else { 1 }
}

// `secret` parameters, moved on one path. Answers 1.
fn sub(a: secret [i64], h: secret H, k: secret C, c: bool) -> i64 { if c { eat(a) + eat_h(h) + eat_c(k) } else { 0 } }
fn params(n: i64, keep: Shared<i64>) -> i64 {
    let r: i64 = sub([n, 2], H { s: shared_new(n), a: [n] }, C::init(keep, n), n > 0);
    churn();
    if n > 0 { if r == 4 * n + 10 { 1 } else { 0 } } else { 1 }
}

// Assigned (ADR 0077 A2): the old value is dropped at the assignment, after a move on one
// path behind the flag; and assigned a public array, which the widening moves. Answers 1.
fn assigned(n: i64, keep: Shared<i64>) -> i64 {
    let mut a: secret [i64] = [n, 2];
    a = [n + 1, 2];
    let mut h: secret H = H { s: shared_new(n), a: [n] };
    h = H { s: keep, a: [n + 2] };
    let mut k: secret C = C::init(keep, n);
    k = C::init(shared_new(n), n + 3);
    let mut b: secret [i64] = [n];
    let r: i64 = if n > 0 { eat(b) } else { 0 };
    b = [r + 1];
    let p: [i64] = [n + 4];
    let mut q: secret [i64] = [0];
    q = p;
    churn();
    let t: i64 = eat(a) + eat_h(h) + eat_c(k) + eat(q);
    if t == (n + 1) + (10 + n + 2) + (2 * n + 3) + (n + 4) { 1 } else { 0 }
}

// A struct's `secret` fields (ADR 0046, ADR 0077 D5): a field moved, a field moved on one
// path (its own flag), and the binding assigned after that. Answers 1.
fn partial(n: i64, keep: Shared<i64>) -> i64 {
    let g: G = G { a: [n, 1], b: [n, 2], h: H { s: shared_new(n), a: [n] } };
    let r: i64 = eat(g.a);
    let q: G = G { a: [n, 1], b: [n, 2], h: H { s: keep, a: [n] } };
    let t: i64 = if n > 0 { eat_h(q.h) } else { 0 };
    let mut w: G = G { a: [n, 1], b: [n, 2], h: H { s: shared_new(n), a: [n] } };
    let u: i64 = if n > 0 { eat(w.a) } else { 0 };
    w = G { a: [n, 3], b: [n, 4], h: H { s: keep, a: [n] } };
    churn();
    let ok: bool = r == n && g.b[0] == n && q.b[1] == 2 && w.b[1] == 4;
    if ok { if n > 0 { if t == 10 + n && u == n { 1 } else { 0 } } else { 1 } } else { 0 }
}

// Passed to an init and to methods (their parameter frames). Answers 1.
fn methods(n: i64, keep: Shared<i64>) -> i64 {
    let h: secret H = H { s: shared_new(n), a: [n] };
    let a: secret [i64] = [n, 5];
    let k: K = K::init(h, a, 1);
    let r: i64 = k.m([n, 1], H { s: keep, a: [n] }, n > 0);
    let h2: secret H = H { s: keep, a: [n] };
    let r2: i64 = k.keep_h(h2);
    let k2: K = K::init(H { s: keep, a: [n] }, [n], 2);
    churn();
    if n > 0 { if r == n + 10 + n && r2 == n + 1 { 1 } else { 0 } } else { if r == n + 1 && r2 == n + 1 { 1 } else { 0 } }
}

// Where effects reify: an effecting fn's `secret` parameters, which the frame-pushing
// parent drops (ADR 0077 A1), one of them moved on one path; `secret` locals of handler
// arms, of an arm's replayed remainder and of a `return` arm; and an effecting body's own
// `secret` locals, one assigned, before its `perform`. Answers 1.
fn par(a: secret [i64], h: secret H) -> i64 ! { Io } {
    let x: i64 = perform Io.read();
    let y: i64 = perform Io.read();
    x + y
}
fn par_moved(a: secret [i64], c: i64) -> i64 ! { Io } {
    let x: i64 = { let z: i64 = if c > 0 { eat(a) } else { 0 }; perform Io.read() };
    let y: i64 = perform Io.read();
    x + y
}
fn ask() -> i64 ! { Io } { perform Io.read() }
fn ask2() -> i64 ! { Io } { let a: i64 = perform Io.read(); let b: i64 = perform Io.read(); a + b }
fn body_s(n: i64) -> i64 ! { Io } { let mut a: secret [i64] = [n]; a = [n + 1]; let h: secret H = H { s: shared_new(n), a: [n] }; perform Io.read() }
fn effects(n: i64, keep: Shared<i64>) -> i64 {
    let r0: i64 = handle par([n, 1], H { s: keep, a: [n] }) with { Io.read(k) => k(10) };
    let q0: i64 = handle par_moved([n, 1], n) with { Io.read(k) => k(1) };
    let mut a: secret [i64] = [1, 2];
    let r: i64 = handle ask() with { Io.read(k) => { a = [n, 2]; let b: secret H = H { s: keep, a: [n] }; k(1) } };
    let q: i64 = handle ask2() with { Io.read(k) => { let x: i64 = k(1); let mut b: secret [i64] = [x, 1]; b = [x, 2]; x + eat(b) } };
    let p: i64 = handle ask() with { Io.read(k) => k(1), return x => { let mut b: secret [i64] = [x, n]; b = [n, x]; eat(b) - n + 1 } };
    let o: i64 = handle body_s(n) with { Io.read(k) => k(20) };
    let m: i64 = handle ask() with { Io.read(k) => { let c: secret [i64] = [n, 3]; k(eat(c)) } };
    churn();
    if r0 == 20 && q0 == 2 && r == 1 && eat(a) == n && q == 8 && p == 1 && o == 20 && m == n { 1 } else { 0 }
}

// Enum payloads: a `secret` binding and a struct's `secret` field moved into a payload, a
// payload matched through a reference and consumed by value, a `secret` enum binding (its
// drop frees the box), one declassified and matched on one path. Answers 1.
fn rd(e: SE) -> i64 { match e { SE::A(x) => eat(x), SE::Hh(h) => eat_h(h), SE::Z => 0 } }
fn kind(e: &SE) -> i64 { match *e { SE::A(x) => 1, SE::Hh(h) => 2, SE::Z => 3 } }
fn payloads(n: i64, keep: Shared<i64>) -> i64 {
    let a: secret [i64] = [n, 1];
    let e: SE = SE::A(a);
    let fh: secret H = H { s: keep, a: [n] };
    let f: SE = SE::Hh(fh);
    let g: G = G { a: [n, 2], b: [n], h: H { s: keep, a: [n] } };
    let e2: SE = SE::A(g.a);
    let k1: i64 = kind(&e) + kind(&f) + kind(&e2);
    let s: secret E = E::P([n, 3]);
    let s2: secret E = E::Q;
    let t: secret E = E::P([n, 4]);
    let u: i64 = if n > 0 { let pe: E = declassify(t); match pe { E::P(v) => v[0], E::Q => 0 } } else { 0 };
    churn();
    let r: i64 = rd(e) + rd(f) + rd(e2) + rd(SE::Z);
    if r == n + (10 + n) + n && k1 == 4 && g.b[0] == n { if n > 0 { if u == n { 1 } else { 0 } } else { 1 } } else { 0 }
}

// `declassify` and widening: each moves its operand, on every path or on one; a `secret`
// value returned, widened from a parameter, and chosen by an `if`. Answers 1.
fn mk_s(n: i64) -> secret [i64] { [n, 1] }
fn mk_p(p: [i64]) -> secret [i64] { p }
fn mk_h(n: i64, k: Shared<i64>) -> secret H { H { s: k, a: [n] } }
fn routes(n: i64, keep: Shared<i64>) -> i64 {
    let a: secret [i64] = [n, 1];
    let p: [i64] = declassify(a);
    let h: secret H = H { s: shared_new(n), a: [n] };
    let hp: H = declassify(h);
    let b: secret [i64] = [n, 2];
    let r1: i64 = consume(declassify(b));
    let c: secret [i64] = [n, 3];
    let r2: i64 = if n > 0 { consume(declassify(c)) } else { 0 };
    let q: [i64] = [n, 4];
    let w: secret [i64] = q;
    let q2: [i64] = [n, 5];
    let r3: i64 = eat(q2);
    let x: [i64] = [n, 6];
    let y: [i64] = [n, 7];
    let z: secret [i64] = if n > 0 { x } else { y };
    let g: H = H { s: keep, a: [n] };
    let gs: secret H = g;
    let m1: secret [i64] = mk_s(n);
    let m2: secret [i64] = mk_p([n, 8]);
    let m3: secret H = mk_h(n, keep);
    churn();
    let ok: bool = p[0] == n && shared_get(hp.s) == n && hp.a[0] == n && r1 == n && r3 == n;
    let ok2: bool = eat(w) == n && eat(z) == n && eat_h(gs) == 10 + n && eat(m1) == n && eat(m2) == n && eat_h(m3) == 10 + n;
    if ok && ok2 { if n > 0 { if r2 == n { 1 } else { 0 } } else { 1 } } else { 0 }
}

// A loop body's `secret` locals, drained by `continue` and `break` and at the body's end,
// one of them moved on one iteration. Answers 1.
fn loops(n: i64, keep: Shared<i64>) -> i64 {
    let out: secret [i64] = [n, 0];
    let mut j: i64 = 0;
    let mut acc: i64 = 0;
    while j < 6 {
        let w: secret H = H { s: keep, a: [j] };
        let v: secret [i64] = [j, 1];
        let r: i64 = if j == 1 { eat(v) } else { 0 };
        j = j + 1;
        if j == 2 { continue; 0 } else { 0 };
        let x: secret [i64] = [j, 2];
        if j == 5 { break; 0 } else { 0 };
        acc = acc + eat(x) + r;
    }
    churn();
    if acc == 3 + 4 + 1 && eat(out) == n { 1 } else { 0 }
}

// Generic fns and generic structs at `secret` types: an instance's parameter, its
// `secret`-typed field, and such a field moved out, on every path and on one. Answers 1.
fn generics(n: i64, keep: Shared<i64>) -> i64 {
    let a: secret [i64] = [n, 1];
    let r: i64 = take(a);
    let h: secret H = H { s: shared_new(n), a: [n] };
    let r2: i64 = take(h);
    let b: secret [i64] = idg([n, 2]);
    let bx: Bx<secret [i64]> = Bx { v: [n, 3], n: 1 };
    let bh: Bx<secret H> = wrap(H { s: keep, a: [n] });
    let c: secret [i64] = [n, 4];
    let bc: Bx<secret [i64]> = wrap(c);
    let t1: Two<secret [i64]> = Two { v: [n, 5], w: [n, 6] };
    let f1: secret [i64] = first(t1);
    let t2: Two<secret H> = Two { v: H { s: shared_new(n), a: [n] }, w: H { s: keep, a: [n] } };
    let f2: secret H = first_or(t2, n > 0, H { s: keep, a: [n] });
    churn();
    let e2: i64 = eat_h(f2);
    let ok: bool = if n > 0 { e2 == 2 * n } else { e2 == 10 + n };
    if ok && r + r2 == 2 && eat(b) == n && eat(f1) == n && bx.n + bh.n + bc.n == 3 { 1 } else { 0 }
}

// A `secret` string and `Vec`, a `secret` struct holding a class, a class holding a `secret`
// struct, and an array of `secret` elements (dropped before the change too). The classes come
// first: a class's heap fields are never freed (register D137), so a cell one of them took
// after a value was freed would hide that value's second free. Answers 1.
fn others(n: i64, keep: Shared<i64>) -> i64 {
    let ch: CH = CH::init(H { s: shared_new(n), a: [n] });
    let sch: secret CH = CH::init(H { s: keep, a: [n] });
    let s: secret [u8] = "abc";
    let t: secret [u8] = "defg";
    let mut v: Vec<i64> = vec_new();
    push(&mut v, n);
    let sv: secret Vec<i64> = v;
    let mut v2: Vec<i64> = vec_new();
    push(&mut v2, n + 1);
    let sv2: secret Vec<i64> = v2;
    let w: secret W = W { c: C::init(keep, n), n: 1 };
    let w2: secret W = W { c: C::init(shared_new(n), n), n: 1 };
    let z: secret i64 = n;
    let el: [secret i64] = [z, z];
    let r: i64 = if n > 0 { eat_s(t) + eat_v(sv2) + eat_w(w2) } else { 0 };
    churn();
    let ok: bool = eat_s(s) == 97 + 3 && eat_v(sv) == n && ch.get() == 1 && declassify(el[0]) == n;
    if ok { if n > 0 { if r == (100 + 4) + (n + 1) + (2 * n + 1) { 1 } else { 0 } } else { 1 } } else { 0 }
}

// A `return` drains the frames that hold `secret` bindings. Answers 1.
fn early_sub(n: i64, keep: Shared<i64>) -> i64 {
    let a: secret [i64] = [n, 1];
    let h: secret H = H { s: keep, a: [n] };
    if n > 0 { return eat(a) - n + 1 } else { 0 };
    let k: secret C = C::init(keep, n);
    eat_h(h) - 10 - n + 1
}
fn early(n: i64, keep: Shared<i64>) -> i64 { let r: i64 = early_sub(n, keep); churn(); r }

fn main() -> i64 {
    let keep: Shared<i64> = shared_new(10);
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 2000 {
        let n: i64 = i - 1000;
        acc = acc + one_path(n, keep) + params(n, keep) + assigned(n, keep) + partial(n, keep)
            + methods(n, keep) + effects(n, keep) + payloads(n, keep) + routes(n, keep)
            + loops(n, keep) + generics(n, keep) + others(n, keep) + early(n, keep);
        i = i + 1;
    }
    // 12 a round, 2000 rounds: 24000
    if acc == 24000 && shared_get(keep) == 10 { 42 } else { 2 }
}
