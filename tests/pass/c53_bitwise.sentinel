// C5.3 / ADR 0027 D10 (c53_bitwise): bitwise `& | ^` on public ints,
// pinning precedence — `&` binds tighter than `^` binds tighter than `|`.
//
//   5 & 6 ^ 3 | 8
//     = ((5 & 6) ^ 3) | 8     // & > ^ > |
//     = (4 ^ 3) | 8
//     = 7 | 8
//     = 15
//
// A right-associative or flat misparse would give 5 (`5 & (6 ^ (3 | 8))`),
// so exit 15 discriminates the precedence.
fn main() -> i64 {
    5 & 6 ^ 3 | 8
}
