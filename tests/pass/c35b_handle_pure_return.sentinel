// C3.5(b) / ADR 0020 D4 + D7: ADR 0020 D4's default
// `return v => v` arm at the runtime layer. do_work() is declared
// `! { Io }` but its body is the pure expression `41 + 1` — never
// reaches a perform. The effecting ABI wraps the pure value via
// sentinel_kont_pure (op_id = PURE_RETURN_OP_ID); main's handle
// dispatches the pure-return case and recovers the value.
//
// Expected: exit code 42.

effect Io {
    read() -> i64;
}

fn do_work() -> i64 ! { Io } {
    41 + 1
}

fn main() -> i64 {
    handle do_work() with {
        Io.read(k) => k(0)
    }
}
