// ADR 0016 A3: a type that mentions no type parameter is complete under substitution, so a
// `[secret S]` over a struct, which substitution does not round-trip, is still returned,
// received and held in a generic struct's concrete field. (Widening a public `[S]` into it is
// pinned in sentinel-types' table: the self-hosted typer omits that widen, register D191.)
// 1 + 1 + 40 = 42.

struct S {
    a: i64,
}

struct Bx<T> {
    tag: T,
    keys: [secret S],
}

fn keep(x: [secret S]) -> [secret S] {
    x
}

fn count(x: [secret S]) -> i64 {
    len(x)
}

fn main() -> i64 {
    let p: [secret S] = [S { a: 1 }];
    let q = keep(p);
    let k: [secret S] = [S { a: 2 }];
    let b: Bx<i64> = Bx { tag: 40, keys: k };
    let n: i64 = b.tag;
    count(q) + count(b.keys) + n
}
