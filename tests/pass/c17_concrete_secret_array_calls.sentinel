// ADR 0016 A3: a type that mentions no type parameter is complete under substitution, so a
// `[secret S]` over a struct, which substitution does not round-trip, is still returned,
// received and held in a generic struct's concrete field, including in an instance a generic
// call makes, whose fields the instance walk checks. (Widening a public `[S]` into it is pinned
// in sentinel-types' table: the self-hosted typer omits that widen, register D191.)
// 1 + 1 + 39 + 1 + 0 = 42.

struct S {
    a: i64,
}

struct Bx<T> {
    tag: T,
    keys: [secret S],
}

fn keep(x: [secret S]) -> [secret S] {
    x
}

fn count(x: [secret S]) -> i64 {
    len(x)
}

fn mkb<T>(t: T, k: [secret S]) -> Bx<T> {
    Bx { tag: t, keys: k }
}

fn main() -> i64 {
    let p: [secret S] = [S { a: 1 }];
    let q = keep(p);
    let k: [secret S] = [S { a: 2 }];
    let b: Bx<i64> = Bx { tag: 39, keys: k };
    let n: i64 = b.tag;
    let k2: [secret S] = [S { a: 3 }];
    let b2 = mkb(0, k2);
    let m: i64 = b2.tag;
    count(q) + count(b.keys) + n + count(b2.keys) + m
}
