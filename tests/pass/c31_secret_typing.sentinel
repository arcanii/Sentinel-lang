// C3.1 / ADR 0019 D5 + D6: secret types intern + declassify
// strips. Implicit T -> secret T widening at let-annotation
// boundaries lets `let pw: secret i64 = 42;` compile.
//
//   stored = secret(42) via implicit widen
//   declassify(stored) -> 42
//   print(42 + 8) -> "50"
fn unwrap(s: secret i64) -> i64 {
    declassify(s)
}

fn main() -> i64 {
    let stored: secret i64 = 42;
    let raw: i64 = unwrap(stored);
    print(raw + 8)
}
