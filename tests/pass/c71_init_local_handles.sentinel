// Register D154: an init's statements get a frame of their own, so a `Shared` / `Mutex`
// an init's local holds is released at the init's exit. inkwell passes an init its
// handle arguments without a clone (ADR 0071 A1) and its parameter frame keeps them (A2),
// so a local that duplicates a parameter's unit must take a unit of its own (a clone), or
// releasing the local frees the caller's cell. Each case loops 2000 times; `churn`
// allocates cells of the same size after the init returns, so a freed cell is reused
// and the caller's read sees another value, or the debug runtime's refcount check
// aborts. Every case answered the same before the fix, which left those locals' units
// held: this holds the new release to no more than was counted, and the leak it closes
// is pinned by an inkwell IR test. The oracle and `scg` released these locals already.
// Exit 42 = all cases held.

struct H { s: Shared<i64>, n: i64 }
struct HA { s: Shared<i64>, a: [i64] }
struct HN { inner: HA, n: i64 }
struct B<T> { v: T, n: i64 }

class K {
    let s: Shared<i64>;
    pub init(s: Shared<i64>) { self.s = s; 0 }
    pub fn get(self: &Self) -> i64 { shared_get(self.s) }
}

// a local let-bound from a parameter, a parameter's field, and a block over one
class LP {
    let n: i64;
    pub init(s: Shared<i64>, h: H) {
        let a: Shared<i64> = s;
        let b: Shared<i64> = h.s;
        let c: Shared<i64> = { s };
        self.n = shared_get(a) + shared_get(b) + shared_get(c);
        0
    }
}

// a `Mutex` local from a parameter, and a guard on it
class LM {
    let n: i64;
    pub init(m: Mutex<i64>) {
        let mm: Mutex<i64> = m;
        let g = lock(mm);
        self.n = if is_some(g) { *g } else { 0 };
        0
    }
}

// a parameter's handle held in a struct local, a generic instance local and a class local
class LS {
    let n: i64;
    pub init(s: Shared<i64>) {
        let hh: H = H { s: s, n: 1 };
        let bb: B<Shared<i64>> = B { v: s, n: 1 };
        let kk: K = K::init(s);
        self.n = shared_get(hh.s) + shared_get(bb.v) + kk.get();
        0
    }
}

// a parameter-derived local stored into a field, and a struct local moved into one
class LF {
    let s: Shared<i64>;
    let h: H;
    pub init(s: Shared<i64>) {
        let a: Shared<i64> = s;
        self.s = a;
        let hh: H = H { s: s, n: 1 };
        self.h = hh;
        0
    }
    pub fn get(self: &Self) -> i64 { shared_get(self.s) + shared_get(self.h.s) }
}

// a struct moved out of a struct parameter's field into a local
class LN {
    let n: i64;
    pub init(hn: HN) {
        let inner: HA = hn.inner;
        self.n = shared_get(inner.s) + inner.a[0];
        0
    }
}

// a local moved on one path only (ADR 0077: dropped under its moved flag)
class LC {
    let n: i64;
    pub init(s: Shared<i64>, c: bool) {
        let hh: HA = HA { s: s, a: [1] };
        if c { eat(hh); 0 } else { 0 };
        self.n = 1;
        0
    }
}

// a local overwritten with a parameter
class LR {
    let n: i64;
    pub init(s: Shared<i64>) {
        let mut h: Shared<i64> = shared_new(7);
        h = s;
        self.n = shared_get(h);
        0
    }
}

// a local moved on one path, then overwritten from a parameter (ADR 0077 D6: the old value
// is dropped under its flag), and a local read through a reference parameter
class LX {
    let n: i64;
    pub init(s: Shared<i64>, hr: &H, c: bool) {
        let mut x: HA = HA { s: s, a: [1] };
        if c { eat(x); 0 } else { 0 };
        x = HA { s: s, a: [2] };
        let y: Shared<i64> = (*hr).s;
        self.n = shared_get(y);
        0
    }
}

fn eat(h: HA) -> i64 { shared_get(h.s) + h.a[0] }

fn churn() -> i64 {
    let mut i: i64 = 0;
    while i < 50 { let o: Shared<i64> = shared_new(999); i = i + 1; }
    0
}

fn churn_m() -> i64 {
    let mut i: i64 = 0;
    while i < 50 { let o: Mutex<i64> = mutex_new(999); i = i + 1; }
    0
}

fn let_from_param() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let r: i64 = { let k: LP = LP::init(s, H { s: s, n: 1 }); k.n };
        churn();
        ok = ok && r == 126 && shared_get(s) == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn mutex_from_param() -> i64 {
    let m: Mutex<i64> = mutex_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let r: i64 = { let k: LM = LM::init(m); k.n };
        churn_m();
        let g = lock(m);
        let v: i64 = if is_some(g) { *g } else { 0 };
        ok = ok && r == 42 && v == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn held_locals() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let r: i64 = { let k: LS = LS::init(s); k.n };
        churn();
        ok = ok && r == 126 && shared_get(s) == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn stored_into_field() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let k: LF = LF::init(s);
        churn();
        ok = ok && k.get() == 84 && shared_get(s) == 42;
        i = i + 1;
    }
    churn();
    if ok && shared_get(s) == 42 { 1 } else { 0 }
}

fn moved_out_of_param() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let r: i64 = { let k: LN = LN::init(HN { inner: HA { s: s, a: [1] }, n: 1 }); k.n };
        churn();
        ok = ok && r == 43 && shared_get(s) == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn moved_on_one_path() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let c: bool = i / 2 * 2 == i;
        let r: i64 = { let k: LC = LC::init(s, c); k.n };
        churn();
        ok = ok && r == 1 && shared_get(s) == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn overwritten() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let r: i64 = { let k: LR = LR::init(s); k.n };
        churn();
        ok = ok && r == 42 && shared_get(s) == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn overwritten_after_move() -> i64 {
    let s: Shared<i64> = shared_new(42);
    let hh: H = H { s: s, n: 1 };
    let mut i: i64 = 0;
    let mut ok: bool = true;
    while i < 2000 {
        let c: bool = i / 2 * 2 == i;
        let r: i64 = { let k: LX = LX::init(s, &hh, c); k.n };
        churn();
        ok = ok && r == 42 && shared_get(s) == 42 && shared_get(hh.s) == 42;
        i = i + 1;
    }
    if ok { 1 } else { 0 }
}

fn main() -> i64 {
    let n: i64 = let_from_param() + mutex_from_param() + held_locals() + stored_into_field()
        + moved_out_of_param() + moved_on_one_path() + overwritten() + overwritten_after_move();
    if n == 8 { 42 } else { n }
}
