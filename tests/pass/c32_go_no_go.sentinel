// C3.2 phase-go per ADR 0019 D1 + D2 + D4 + D13: effect rows
// + effect_check_query salsa pass + main-must-be-effect-free.
//
// Exercises:
//   - Top-level `effect E { ... }` declaration (D4)
//   - Postfix `! { Op1, Op2 }` annotation on fn signatures (D1)
//   - Effect propagation through call sites (D2: annotation as
//     constraint; annotated fn calling annotated fn passes when
//     the annotations match)
//   - `fn main` with empty effect row (D13)
//
// At C3.2 minimum there's no `perform` (handlers + perform land
// at ADR 0020), so annotated fns are TRUSTED declarations:
// they promise to use the listed effects, the body just has to
// not exceed the annotation. The check_inner / check_outer
// chain below demonstrates annotation-as-constraint working
// across a fn boundary.
//
// main calls only effect-free fns (pure_compute), so its
// inferred row is empty and the D13 invariant is satisfied.
//
// pure_compute(12) = 12 + 30 = 42 -> stdout "42", exit 0.
effect Io {
    log(msg: i64) -> i64;
}

fn check_inner() -> i64 ! { Io } {
    0
}

fn check_outer() -> i64 ! { Io } {
    check_inner()
}

fn pure_compute(x: i64) -> i64 {
    x + 30
}

fn main() -> i64 {
    print(pure_compute(12))
}
