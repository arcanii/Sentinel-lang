// ADR 0077 D6: `x = e` into a binding that has a moved flag drops the old value unless the
// flag says it was moved, stores the new one, and stores the flag back `false`, so the new
// value is dropped at the scope's end on every path. Before, a binding moved anywhere was
// never dropped, so the new value leaked even on the path that had moved the old one
// (measured, `after_a_join` down that path 600,000 times: 36.1 MiB before, 8.4 after).

fn consume(v: [i64]) -> i64 { v[0] }

// maybe moved, then assigned
fn after_a_join(n: i64) -> i64 {
    let mut v: [i64] = [1, 2, 3, 4];
    let r: i64 = if n < 0 { consume(v) } else { 0 };
    v = [5, 6, 7, 8];
    r
}

// moved, then assigned on every iteration of a loop: each assignment drops the value the
// one before it stored
fn in_a_loop() -> i64 {
    let mut v: [i64] = [1, 2];
    let r: i64 = consume(v);
    let mut j: i64 = 0;
    while j < 3 {
        v = [j, j];
        j = j + 1;
    }
    r
}

fn main() -> i64 {
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 2000 {
        acc = acc + after_a_join(0 - 1) + after_a_join(1) + in_a_loop();
        i = i + 1;
    }
    // a round: 1 + 0 + 1
    if acc == 4000 { 42 } else { 1 }
}
