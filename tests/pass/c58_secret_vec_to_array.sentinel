// c58: vec_to_array over a secret Vec (ADR 0053) — the `Vec<secret u8> →
// [secret u8]` bridge. A growable secret buffer (ADR 0052) is built with
// vec_new + push, then converted to a `[secret u8]` array with `vec_to_array`
// (whose result type runs through the secret-aware array substitution demote
// `to_array_elem_subst`, else it falls back to `[T]`). The array is then indexed
// (each element `secret u8`, a public index → the constant-time taint) and
// reduced branch-free; only the final accumulator is declassified. The
// self-hosted `scg` reads the element structurally (`vec_elem_of`) and lowers it
// byte-for-byte identically to `snc` across all 8 stage differentials.
//
// Each secret byte is formed by widening a `u8` VARIABLE (the let-widen `scg`
// mirrors), not a call result (ADR 0052 A5), so the differential stays
// byte-identical. 40 ^ 8 ^ 10 = 42. Exit 42.
fn main() -> i64 {
    let mut v: Vec<secret u8> = vec_new();
    let a: u8 = i64_to_u8(40);
    let sa: secret u8 = a;
    push(&mut v, sa);
    let b: u8 = i64_to_u8(8);
    let sb: secret u8 = b;
    push(&mut v, sb);
    let c: u8 = i64_to_u8(10);
    let sc: secret u8 = c;
    push(&mut v, sc);

    // The bridge: Vec<secret u8> -> [secret u8] (ADR 0053).
    let arr: [secret u8] = vec_to_array(v);

    // Branch-free XOR reduction over the secret array, public index + length.
    let z: u8 = i64_to_u8(0);
    let mut acc: secret u8 = z;
    let n: i64 = len(arr);
    let mut i: i64 = 0;
    while i < n {
        acc = acc ^ arr[i];     // arr[i] : secret u8
        i = i + 1;
    }

    u8_to_i64(declassify(acc))
}
