// c57: Vec<secret u8> (ADR 0052) — growable buffers of secret elements. A
// `Vec<secret u8>` is built with vec_new + push, one element is overwritten in
// place (index-assign, ADR 0050), and elements read back come out `secret u8`
// (a PUBLIC index → the constant-time taint, while the buffer's pointer /
// length / capacity stay public). The reduction is branch-free; only the final
// accumulator is declassified. `vec_new<T>() -> Vec<T>` instantiated with
// `T := secret u8` exercises the secret-aware substitution round-trip
// (`Vec<T>[T:=secret u8] = Vec<secret u8>`). The self-hosted `scg` already
// represents `Vec<secret u8>` structurally (mk_vec(mk_secret(u8))) and emits it
// byte-for-byte identically to `snc` across all 8 selfhost stage differentials.
//
// Each secret byte is formed by binding the public `u8` to a variable and then
// widening the VARIABLE to `secret u8` (the var/literal let-widen `scg` mirrors)
// — NOT by widening a call result directly (a `secret u8` let-widen from a CALL
// is snc-side only today), so the differential stays byte-identical. Exit 42.
fn main() -> i64 {
    // Build [0, 1, 2, 3, 4, 5] as a growable buffer of SECRET bytes.
    let mut buf: Vec<secret u8> = vec_new();
    let mut i: i64 = 0;
    while i < 6 {
        let p: u8 = i64_to_u8(i);       // public byte
        let sb: secret u8 = p;          // widen the variable → secret u8
        push(&mut buf, sb);             // push an already-secret element
        i = i + 1;
    }

    // Overwrite element 0 in place (index-assign over a secret element).
    let pv: u8 = i64_to_u8(43);
    let nv: secret u8 = pv;
    buf[0] = nv;                        // buf = [43, 1, 2, 3, 4, 5]

    // Branch-free XOR reduction over the secret bytes, public index + length.
    let pz: u8 = i64_to_u8(0);
    let mut acc: secret u8 = pz;
    let n: i64 = len(buf);
    let mut j: i64 = 0;
    while j < n {
        acc = acc ^ buf[j];             // buf[j] : secret u8
        j = j + 1;
    }

    // 43 ^ 1 ^ 2 ^ 3 ^ 4 ^ 5 = 42. Declassify only the final accumulator.
    u8_to_i64(declassify(acc))
}
