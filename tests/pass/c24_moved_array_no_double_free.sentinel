// C2.4 / ADR 0017 D8: when `arr` is moved into `consume(arr)`,
// the borrow checker records arr in moved_sources; codegen skips
// arr's drop at main's scope exit (the consumer is responsible).
// `consume` then drops `xs` (its param) at its own scope exit.
// Tests that we don't double-free.
// arr = [11, 22, 33]; sum = 11 + 22 + 33 = 66 -> exit 66.
fn consume(xs: [i64]) -> i64 {
    xs[0] + xs[1] + xs[2]
}

fn main() -> i64 {
    let arr: [i64] = [11, 22, 33];
    consume(arr)
}
