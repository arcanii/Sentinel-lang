// Secret-flow conformance (review F3 / P2.2), the accept side: a secret may
// flow through a field, a call, and a `match` freely — the constructs are NOT
// over-rejected. The secret is combined with ARITHMETIC only (no branch,
// index, or divisor), so it never reaches a sink, and `declassify` releases
// the result. This is the counterpart to the c52_secret_via_* rejections: the
// taint survives the funnels (so a real leak would be caught), yet a
// genuinely constant-time use compiles. 40 + 40 = 80.
struct Holder {
    v: secret i64,
}

enum Pick {
    First,
    Second,
}

fn passthrough(s: secret i64) -> secret i64 {
    s
}

fn choose(p: Pick, a: secret i64, b: secret i64) -> secret i64 {
    match p {
        Pick::First => a,
        Pick::Second => b,
    }
}

fn main() -> i64 {
    let h: Holder = Holder { v: 40 };
    let x: secret i64 = passthrough(h.v); // through a field + a call
    let two: secret i64 = 2;
    let y: secret i64 = choose(Pick::First, x, two); // through a match arm
    declassify(x + y) // arithmetic only — no sink
}
