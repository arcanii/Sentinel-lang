// C1.7.5 / ADR 0016: same generic fn, two distinct instantiations.
// `pick<T>` gets monomorphized into `pick__i64` and `pick__bool`,
// each emitted as its own LLVM fn.
fn pick<T>(cond: bool, a: T, b: T) -> T {
    if cond { a } else { b }
}

fn to_i64(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

fn main() -> i64 {
    let n: i64 = pick(true, 41, 99);
    let b: bool = pick(false, true, false);
    print(n + to_i64(b))
}
