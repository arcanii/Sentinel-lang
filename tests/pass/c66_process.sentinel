// ADR 0066 M2.1: subprocess spawn + the `Subprocess` capability effect (D7).
// `process_spawn(path: [u8], args: [[u8]]) -> Process` + `process_wait(Process)
// -> i64`, over `std::process::Command`. `process_spawn` carries the built-in
// `Subprocess` effect, so `spawner` (which calls it) DECLARES `! { Subprocess }`
// (the capability is visible in the type); the effect then BUBBLES to `main`
// (unlike `Async`, which a `scope` discharges) — `main` may carry `Subprocess`.
//
// This fixture exercises: the two builtins' lowering (decompose the `[u8]` path +
// `[[u8]]` argv; `Process` = ptr), the `! { Subprocess }` annotation (Pass-2:
// inferred ⊆ declared), and the bubble-to-`main`. The real spawn is GUARDED
// behind a runtime-false flag for cross-platform determinism (a genuine
// cross-platform spawn needs per-OS path/args, ADR 0062); the process IR + the
// effect rows still emit (both branches lower), so the self-host differential
// covers them, and the `sentinel_process_*` runtime unit tests cover the real
// spawn. Exit 42.

fn spawner(argv: [[u8]]) -> i64 ! { Subprocess } {
    let p = process_spawn("cmd", argv);
    process_wait(p)
}

fn main() -> i64 {
    let probe: bool = false;
    if probe {
        let argv: [[u8]] = ["/c", "exit 7"];
        spawner(argv)
    } else {
        42
    }
}
