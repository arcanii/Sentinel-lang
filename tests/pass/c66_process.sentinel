// ADR 0066 M2.1/M2.2: subprocess spawn + byte-pipe IPC + the `Subprocess`
// capability effect (D7). `process_spawn(path: [u8], args: [[u8]]) -> Process`,
// `process_wait(Process) -> i64`, and the M2.2 byte pipes `process_write(Process,
// [u8]) -> i64` / `process_read(Process) -> [u8]`, all over `std::process`.
// `process_spawn` carries the built-in `Subprocess` effect, so `spawner` (which
// calls it) DECLARES `! { Subprocess }` (the capability is visible in the type);
// the effect then BUBBLES to `main` (unlike `Async`, which a `scope` discharges)
// — `main` may carry `Subprocess`. The pipe payloads are public `[u8]`, so a
// `secret` can never cross the process boundary (the D8 cross-process fence).
//
// This fixture exercises: the four builtins' lowering (decompose the `[u8]` path,
// `[[u8]]` argv + `[u8]` write payload; assemble the `[u8]` read result;
// `Process` = ptr), the `! { Subprocess }` annotation (Pass-2: inferred ⊆
// declared), and the bubble-to-`main`. The real spawn is GUARDED behind a
// runtime-false flag for cross-platform determinism (a genuine cross-platform
// spawn needs per-OS path/args, ADR 0062); the process IR + the effect rows still
// emit (both branches lower), so the self-host differential covers them, and the
// `sentinel_process_*` runtime unit tests cover the real spawn + pipe round-trip.
// Exit 42.

fn spawner(argv: [[u8]]) -> i64 ! { Subprocess } {
    let p = process_spawn("cmd", argv);
    let input: [u8] = "hello";
    let w = process_write(p, input);
    let out: [u8] = process_read(p);
    process_wait(p) + w + len(out)
}

fn main() -> i64 {
    let probe: bool = false;
    if probe {
        let argv: [[u8]] = ["/c", "exit 7"];
        spawner(argv)
    } else {
        42
    }
}
