// C5.2 / ADR 0026 D9 — a branch-free constant-time primitive that passes
// the D5 verification (`c52_secret_ct`). `ct_select` chooses between two
// secrets using only arithmetic — a masked select `c*a + (1-c)*b`, with
// `c` a secret 0/1 mask — so there is no secret-dependent branch, memory
// index, or division: `verify_constant_time` accepts it. (The ADR's
// XOR-accumulate MAC compare needs bitwise ops, which are not in the
// surface yet; the arithmetic masked select is the available cswap-style
// constant-time primitive.) `main` declassifies the chosen value as the
// process exit code.
fn ct_select(c: secret i64, a: secret i64, b: secret i64) -> secret i64 {
    let one: secret i64 = 1;
    c * a + (one - c) * b
}

fn main() -> i64 {
    let cond: secret i64 = 1;
    let x: secret i64 = 42;
    let y: secret i64 = 7;
    declassify(ct_select(cond, x, y))
}
