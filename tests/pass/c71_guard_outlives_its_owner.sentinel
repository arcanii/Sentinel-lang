// Register D155: a guard owns a refcount unit of its mutex. `lock` used to hand the guard
// the cell without a unit of its own, on the ground that a guard's unlock always comes
// before its owner's release, by reverse declaration order. Moving the owner breaks that:
// when the struct holding the `Mutex` is passed by value, or bound anew in an inner block,
// its drop releases the cell's last unit while the guard still holds the lock, so the
// locked cell was freed under the guard, which then read, wrote and unlocked freed memory.
// The debug runtime's assertion turned that into an abort, which is what each of the first
// six cases here did before the fix; a release build of the runtime did not. A successful
// lock now takes a unit, and the guard's unlock gives it back after unlocking.
//
// The first six cases move the owner away while its guard is held, allocate new mutexes
// (which would reuse a freed cell), then read through the guard (`moved_into_call` also
// writes). Since the guard keeps its cell alive, an unlock that never happens no longer
// aborts at its owner's release, so `relocks_after_scope` checks the unlock directly: it
// locks the same mutex again after a block scope, after loop iterations that end in
// `continue` and `break`, after a callee's early `return` and its fall-through, after a
// method's `return` and fall-through, and after a guard handed to a generic callee, each
// of which must have unlocked it (a missed unlock makes the next `lock` time out and the
// following `*g` abort). The same runtime serves all three back ends. Exit 42 = every case
// held.

struct H { m: Mutex<i64>, n: i64 }
struct O { inner: H, k: i64 }
struct B<T> { v: T, n: i64 }
struct HS { m: Mutex<secret i64>, n: i64 }

fn eat(h: H) -> i64 { h.n }
fn eat_o(o: O) -> i64 { o.k }
fn eat_b(b: B<Mutex<i64>>) -> i64 { b.n }
fn eat_hs(h: HS) -> i64 { h.n }

fn churn() -> i64 {
    let mut i: i64 = 0;
    while i < 1000 { let c: Mutex<i64> = mutex_new(9); i = i + 1; }
    0
}

fn moved_into_call() -> i64 {
    let h: H = H { m: mutex_new(42), n: 1 };
    let g = lock(h.m);
    eat(h);
    churn();
    let before: i64 = *g;
    *g = 43;
    if before == 42 && *g == 43 { 1 } else { 0 }
}

fn rebound_in_a_block() -> i64 {
    let h: H = H { m: mutex_new(42), n: 1 };
    let g = lock(h.m);
    let n: i64 = { let h2: H = h; h2.n };
    churn();
    if n == 1 && *g == 42 { 1 } else { 0 }
}

fn nested_owner() -> i64 {
    let o: O = O { inner: H { m: mutex_new(42), n: 1 }, k: 2 };
    let g = lock(o.inner.m);
    eat_o(o);
    churn();
    if *g == 42 { 1 } else { 0 }
}

fn generic_owner() -> i64 {
    let b: B<Mutex<i64>> = B { v: mutex_new(42), n: 1 };
    let g = lock(b.v);
    eat_b(b);
    churn();
    if *g == 42 { 1 } else { 0 }
}

fn secret_owner() -> i64 {
    let sv: secret i64 = 42;
    let h: HS = HS { m: mutex_new(sv), n: 1 };
    let g = lock(h.m);
    eat_hs(h);
    churn();
    let v: secret i64 = *g;
    if declassify(v) == 42 { 1 } else { 0 }
}

fn in_a_loop() -> i64 {
    let mut i: i64 = 0;
    let mut ok: i64 = 0;
    while i < 100 {
        let h: H = H { m: mutex_new(i), n: 1 };
        let g = lock(h.m);
        eat(h);
        let c: Mutex<i64> = mutex_new(9);
        ok = ok + (if *g == i { 1 } else { 0 });
        i = i + 1;
    }
    if ok == 100 { 1 } else { 0 }
}

fn early(m: Mutex<i64>, c: bool) -> i64 {
    let g = lock(m);
    if c { return 1 } else { 0 };
    *g
}

class Locker {
    let n: i64;
    pub init() { self.n = 0; 0 }
    pub fn lk(self: &Self, m: Mutex<i64>, c: bool) -> i64 {
        let g = lock(m);
        if c { return 1 } else { 0 };
        *g
    }
}

fn take_guard<T>(x: T) -> i64 { 1 }

fn relocks_after_scope() -> i64 {
    let m: Mutex<i64> = mutex_new(1);
    let a: i64 = { let ga = lock(m); *ga = 2; 0 };
    let mut i: i64 = 0;
    while i < 100 {
        let gl = lock(m);
        *gl = *gl + 4;
        i = i + 1;
        if i == 10 { break; 0 } else { 0 };
        if i == 3 { continue; 0 } else { 0 };
    }
    let r1: i64 = early(m, true);
    let r2: i64 = early(m, false);
    let lc: Locker = Locker::init();
    let r3: i64 = lc.lk(m, true);
    let r4: i64 = lc.lk(m, false);
    let r5: i64 = { let gp = lock(m); take_guard(gp) };
    let g2 = lock(m);
    if a == 0 && r1 == 1 && r2 == 42 && r3 == 1 && r4 == 42 && r5 == 1 && *g2 == 42 { 1 } else { 0 }
}

fn main() -> i64 {
    let n: i64 = moved_into_call() + rebound_in_a_block() + nested_owner() + generic_owner()
        + secret_owner() + in_a_loop() + relocks_after_scope();
    if n == 7 { 42 } else { n }
}
