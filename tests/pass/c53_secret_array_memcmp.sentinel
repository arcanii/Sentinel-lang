// c53: constant-time memcmp over `[secret u8]` (ADR 0047 — arrays of secret
// elements). Exercises a secret byte buffer as a parameter + an array literal of
// secret bytes + indexing (which yields `secret u8`) + `len`, all passing the
// constant-time check. A public-index loop over the full length XOR/OR-reduces
// the secret bytes; only the final accumulator is declassified. Equal buffers
// reduce to 0; a one-byte-tampered buffer reduces to nonzero. Exit 42.
fn ct_memcmp(a: [secret u8], b: [secret u8]) -> secret u8 {
    let n: i64 = len(a);
    let zero: u8 = i64_to_u8(0);
    let mut acc: secret u8 = zero;
    let mut i: i64 = 0;
    while i < n {
        acc = acc | (a[i] ^ b[i]);
        i = i + 1;
    }
    acc
}

fn main() -> i64 {
    let h: secret u8 = 'h';
    let m: secret u8 = 'm';
    let a: secret u8 = 'a';
    let c: secret u8 = 'c';
    let x: secret u8 = 'X';
    let t1: [secret u8] = [h, m, a, c];
    let t2: [secret u8] = [h, m, a, c];
    let t3: [secret u8] = [h, m, a, c];
    let t4: [secret u8] = [h, m, a, x];
    let zero: u8 = i64_to_u8(0);
    let eq: u8 = declassify(ct_memcmp(t1, t2));
    let ne: u8 = declassify(ct_memcmp(t3, t4));
    if eq == zero && ne != zero { 42 } else { 0 }
}
