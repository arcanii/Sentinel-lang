// D.5 (1/N) / ADR 0036: loops — the `while` loop.
//
// `while` is a STATEMENT (not an expression; a loop has no value). It
// lowers to a backward CFG branch (cond -> body -> cond), and the body
// is its own scope, dropped EACH ITERATION (ADR 0036 D5). Loop-carried
// state is a `let mut` outside the loop mutated by `Assign` (the
// termination driver); a `let` inside the body is per-iteration.
//
// Exercises:
//   - a counter loop summing 1..=10 (= 55),
//   - a `Vec<i64>` built by `push`ing in a loop (loop-carried), then
//     `len` + `v[i]`,
//   - a body that allocates a `[u8]` each iteration (100x) — per-iteration
//     drop keeps it leak-free (no accumulation), and the body alloca is
//     hoisted to the entry block so the stack does not grow per pass.
//
// Leak-free under `leaks --atExit`. Exit = 55 + len(v) + v[4] + count/100
//                                       = 55 +   5    +  4   +   300/100
//                                       = 55 +   5    +  4   +    3      = 67.

fn main() -> i64 {
    // Counter loop: sum 1..=10.
    let mut total: i64 = 0;
    let mut i: i64 = 1;
    while i <= 10 {
        total = total + i;
        i = i + 1;
    }

    // Build a Vec<i64> by pushing in a loop: [0, 1, 2, 3, 4].
    let mut v: Vec<i64> = vec_new();
    let mut j: i64 = 0;
    while j < 5 {
        push(&mut v, j);
        j = j + 1;
    }

    // A body that allocates each iteration — per-iteration drop (leak-free).
    let mut k: i64 = 0;
    let mut count: i64 = 0;
    while k < 100 {
        let s: [u8] = "tok";
        count = count + len(s);
        k = k + 1;
    }

    total + len(v) + v[4] + (count / 100)
}
