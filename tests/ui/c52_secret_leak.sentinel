// C5.2 / ADR 0026 D5 — the constant-time verification rejects a
// secret-dependent short-circuit. `a && b` on two `secret bool`s
// type-checks (the C3.1 `SecretBranch` rejection only covers `if`), but
// it lowers to a secret-conditional branch — a timing leak the MIR D5
// pass catches with `sentinel::mir::secret_leak`.
fn leaky(a: secret bool, b: secret bool) -> secret bool {
    a && b
}

fn main() -> i64 {
    0
}
