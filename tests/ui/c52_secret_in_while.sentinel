// Secret-flow conformance (review F3 / P2.2): a secret reaching a `while`
// LOOP condition is a timing leak, rejected by the same C3.1 `SecretBranch`
// rule (`sentinel::types::secret_branch`) as an `if` condition — extended to
// `while` when D.5 loops landed, so a secret-dependent loop bound can't slip
// past the constant-time check. The diagnostic names the actual construct
// (`while`, not `if`). Companion to `c52_secret_in_if`.
fn main() -> i64 {
    let s: secret bool = true;
    while s {
    }
    0
}
