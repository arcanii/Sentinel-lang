// Secret-flow conformance (ADR 0050 A7): what an assignment's place computes is
// lowered to MIR like any other expression — here the block that computes the
// reference a `*` store writes through — so the `&&` short-circuit on `secret`
// operands inside it is a secret-dependent branch the MIR D5 pass catches with
// `sentinel::mir::secret_leak`.
fn idb(s: secret bool) -> secret bool {
    s
}

fn store(a: secret bool, b: secret bool) -> i64 {
    let mut n: i64 = 0;
    {
        let r: &mut i64 = &mut n;
        *{ let t: secret bool = idb(a) && b; r } = 5;
        0
    };
    n
}

fn main() -> i64 {
    store(true, false)
}
