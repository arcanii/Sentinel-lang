// Refusal parity (ADR 0041 A16): the oracle refuses a `?` over a type no nullable holds (a `secret bool`) with `sentinel::types::unknown_type`, and every
// self-hosted driver makes the same refusal with the same message.
fn f(s: secret bool) -> i64 {
    let o: ?secret bool = s;
    0
}

fn main() -> i64 {
    f(true)
}
