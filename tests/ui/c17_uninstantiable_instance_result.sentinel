// ADR 0016 A3: a generic call may not make a generic instance whose field the substitution
// does not build at its arguments. `mk(n)` returns a `P<?i64>`, whose field `?T` would need a
// `?(?i64)`, which has no form. Surfaces UninstantiableType at the call.

struct P<T> {
    v: ?T,
    w: i64,
}

fn mk<T>(a: T) -> P<T> {
    P { v: null, w: 7 }
}

fn main() -> i64 {
    let n: ?i64 = 3;
    let p = mk(n);
    p.w
}
