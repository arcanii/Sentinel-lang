// Phase D.1 / ADR 0032: `match` takes a bare enum. A `secret` enum is refused: the arm taken
// would depend on the secret tag, and the payload would come out public. Surfaces
// MatchScrutineeNotEnum at the scrutinee.

enum E { A, B(i64) }

fn pick(e: secret E) -> i64 {
    match e {
        E::A => 0,
        E::B(v) => v,
    }
}

fn main() -> i64 {
    0
}
