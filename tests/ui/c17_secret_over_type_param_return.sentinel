// ADR 0016 A3 (ADR 0019 D5): a `secret` over a type parameter is refused where it is
// written. Substitution leaves such a `secret` as written, so an instance of `seal` would
// keep the declaration's `T`. Surfaces SecretOverTypeParam at the return type.

fn seal<T>(a: T) -> secret T {
    a
}

fn main() -> i64 {
    0
}
