// Secret-flow conformance (review F3 / P2.2): a secret reaching an `if`
// condition is rejected at the SOURCE level (the C3.1 `SecretBranch` rule,
// `sentinel::types::secret_branch`) — before the MIR D5 pass. This is the
// first of the two enforcement layers: the type checker rejects the direct
// secret sinks (`if`, secret index, secret divisor); the MIR pass is the
// backstop for the short-circuit (`&&`/`||`) that type-checks.
fn main() -> i64 {
    let s: secret bool = true;
    if s {
        1
    } else {
        0
    }
}
