// ADR 0016 A2: the comparison in a generic body is checked as written, at type `T`, so it
// is refused even when every call instantiates `T` at a type a comparison accepts: here
// `secret i64`, whose comparison is a `secret bool`. Surfaces Mismatch at the left operand
// of the generic body, before `main` is checked.

fn lt<T>(a: T, b: T) -> bool {
    a < b
}

fn main() -> i64 {
    let x: secret i64 = 3;
    let y: secret i64 = 5;
    let c = lt(x, y);
    0
}
