// tests/ui/c65_secret_join_guarded.sentinel — secrets reaching a branch through the joins
// register D59 changed, refused by the self-hosted verifier as by the oracle.
//
// `xs[if i < len(xs) { i } else { return s }]` does not diverge — only its index's else arm
// does — so under a `secret bool` annotation the type checker widens it to secret, and the
// `&&` that follows branches on a secret. The constant-time pass reports one leak in each
// function but `mk` and `main`, and the differentials hold the self-hosted verifier to the
// same verdicts:
//
//   * `pick` — the self-hosted pipeline decided "did this node diverge?" from a flag meaning
//     "the last node walked was a `return`", so it skipped that widen, typed the value public
//     and its verifier reported nothing (pre-existing);
//   * `join` — the same value in the live arm of an `if` whose then arm returns. The old
//     pipeline caught it only by accident, typing the `if` from the `return`; a join chosen
//     correctly but fed the unwidened arm went public, and an intermediate cut of register D59
//     missed it;
//   * `reset_dead`, `while_ret`, `inner_match_last`, `second_arm`, `first_arm_inner` — one per
//     line of the self-hosted typer's divergence bookkeeping (a block's reset, a block's
//     restore, a match's "every arm diverged" restore, its first-live-arm reset, and that
//     reset's restore): delete the line and that function's value goes public and its
//     verifier reports nothing. The last two bind WITHOUT an annotation on purpose: the
//     type-choice lines pick a match's type, and under a `secret` annotation the widen
//     re-secrets a mistyped match whenever it did not diverge.

fn pick(xs: [bool], i: i64, s: secret bool) -> secret bool {
    let m: secret bool = xs[if i < len(xs) { i } else { return s }];
    m && s
}

fn join(c: bool, bs: [bool], t: secret bool) -> secret bool {
    let x: secret bool = if c { return t } else { bs[if c { 0 } else { return t }] };
    x && t
}

enum E {
    A,
    B(i64),
}

fn mk(n: i64) -> E {
    if n == 0 {
        E::A
    } else {
        E::B(n)
    }
}

fn reset_dead(b: bool, c: bool, bs: [bool], t: secret bool) -> bool {
    if b {
        return false;
        let x: secret bool = if c { return false } else { bs[0] };
        declassify(x && t)
    } else {
        true
    }
}

fn while_ret(c: bool, c2: bool, bs: [bool], t: secret bool) -> bool {
    let x: secret bool = if c { return false } else { while c2 { return false; } bs[0] };
    declassify(x && t)
}

fn inner_match_last(c: bool, n: i64, m: i64, bs: [bool], t: secret bool) -> bool {
    let x: secret bool = if c { return false } else { match mk(n) { E::A => bs[0], E::B(v) => match mk(m) { E::A => return false, E::B(w) => return true } } };
    declassify(x && t)
}

fn second_arm(n: i64, m: i64, t: secret bool) -> bool {
    match mk(n) {
        E::A => false,
        E::B(v) => {
            let q = match mk(m) { E::A => t, E::B(w) => t };
            declassify(q && t)
        }
    }
}

fn first_arm_inner(n: i64, m: i64, bs: [bool], t: secret bool) -> bool {
    let x = match mk(n) { E::A => { let q: bool = match mk(m) { E::A => bs[0], E::B(w) => false }; t }, E::B(v) => t };
    declassify(x && t)
}

fn main() -> i64 {
    0
}
