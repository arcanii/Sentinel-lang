// Secret-flow conformance (ADR 0026 A2): `snc build`'s constant-time gate checks a
// class `init`'s body as it checks a free fn's, so the `&&` short-circuit on `secret`
// operands below is a secret-dependent branch caught with `sentinel::mir::secret_leak`.
fn idb(s: secret bool) -> secret bool {
    s
}

class K {
    let n: i64;
    pub init(a: secret bool, b: secret bool) {
        let t: secret bool = idb(a) && b;
        self.n = 1;
        0
    }
}

fn main() -> i64 {
    let k = K::init(true, false);
    0
}
