// Secret-flow conformance (review F3 / P2.2): taint must SURVIVE a `match`.
// Each arm yields a `secret bool`, so the match result is `secret bool` even
// though the whole `match` funnels through `MirOp::Opaque` (scrutinee + arm
// bodies). The downstream `m && s` short-circuit is then a secret-dependent
// branch the MIR D5 pass rejects (`sentinel::mir::secret_leak`).
enum E {
    A,
    B,
}

fn leaky(e: E, s: secret bool, t: secret bool) -> secret bool {
    let m: secret bool = match e {
        E::A => s,
        E::B => t,
    };
    m && s
}

fn main() -> i64 {
    0
}
