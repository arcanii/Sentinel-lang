// ADR 0071 M1.4c (D6): a secret read out of a `Mutex<secret T>` is STILL a secret
// for every downstream check — branching on it is rejected exactly as branching on
// any other secret is (`sentinel::types::secret_branch`; the types stage catches an
// `if` on a secret condition before MIR's `secret_leak` sees it, which is also why
// this fixture is excluded from the types-stage self-host differential corpus).
//
// This is D6's second named fixture, and it is the one that proves the container
// did not become a laundering hole: `*g` yields `secret i64`, so `if *g > 0` is a
// secret-dependent branch — a timing channel — and must be rejected even though
// the value arrived via a lock. (Holding a lock is public control data; the
// PROTECTED VALUE is not.) If this program ever compiles, secret shared state has
// silently untainted its contents and the constant-time guarantee is broken.
fn main() -> i64 {
    let b: secret i64 = 6;
    let m = mutex_new(b);
    let g = lock(m);
    if *g > 0 { 1 } else { 0 }
}
