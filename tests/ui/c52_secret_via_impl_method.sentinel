// Secret-flow conformance (ADR 0026 A2): `snc build`'s constant-time gate checks an impl
// method's body as it checks a free fn's, so the `&&` short-circuit on `secret`
// operands below is a secret-dependent branch caught with `sentinel::mir::secret_leak`.
fn idb(s: secret bool) -> secret bool {
    s
}

struct P {
    n: i64,
}

trait T {
    fn m(self: &Self, a: secret bool, b: secret bool) -> i64;
}

impl as T for P {
    fn m(self: &Self, a: secret bool, b: secret bool) -> i64 {
        let t: secret bool = idb(a) && b;
        self.n
    }
}

fn main() -> i64 {
    let p = P { n: 1 };
    p.m(true, false)
}
