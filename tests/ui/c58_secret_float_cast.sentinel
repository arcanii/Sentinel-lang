// ADR 0058, the fence's other half: casting a `secret` integer to `f64` would make the
// `secret f64` that cannot be written, so the cast is refused (`declassify` first for a public
// float). Surfaces SecretFloat at the cast.

fn main() -> i64 {
    let s: secret i64 = 3;
    let f = s as f64;
    0
}
