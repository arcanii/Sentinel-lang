// A generic instance makes no `secret f64` either: `secret T` passes through substitution
// unchanged, so `B<f64>`'s field stays an abstract `secret T`, as it does at every instance,
// and arithmetic on it is a type error. Surfaces Mismatch at the left operand.

struct B<T> { v: secret T }

fn sq(b: B<f64>) -> i64 {
    let z = b.v * b.v;
    0
}

fn main() -> i64 {
    0
}
