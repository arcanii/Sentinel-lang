// A generic instance makes no `secret f64` either: substitution leaves `secret T` as
// written, so `B<f64>`'s field cannot be instantiated (ADR 0016 A3), at this instance as at
// every other, and reading it is refused. Surfaces UninstantiableType at the field.

struct B<T> { v: secret T }

fn sq(b: B<f64>) -> i64 {
    let z = b.v * b.v;
    0
}

fn main() -> i64 {
    0
}
