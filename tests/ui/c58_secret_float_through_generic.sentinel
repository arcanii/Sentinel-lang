// A generic instance makes no `secret f64` either: a `secret` over a type parameter is
// refused where it is written (ADR 0016 A3), so `B`'s field is never a `secret f64` at
// `B<f64>`. Surfaces SecretOverTypeParam at the field's type.

struct B<T> { v: secret T }

fn sq(b: B<f64>) -> i64 {
    let z = b.v * b.v;
    0
}

fn main() -> i64 {
    0
}
