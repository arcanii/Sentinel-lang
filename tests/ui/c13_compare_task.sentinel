// ADR 0016 A2: a comparison takes scalar operands, so two `Task` handles are refused.
// Surfaces Mismatch at the left operand.

fn work() -> i64 {
    1
}

fn same() -> bool {
    scope concurrent {
        let t = spawn work();
        let u = spawn work();
        t == u
    }
}

fn main() -> i64 {
    0
}
