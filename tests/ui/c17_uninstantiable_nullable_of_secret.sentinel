// ADR 0016 A3: `?T` has no form at `T := secret i64` either (a nullable holds no
// `secret`), so this call's return type cannot be instantiated. Surfaces
// UninstantiableType at the call.

fn wrap<T>(a: T) -> ?T {
    a
}

fn main() -> i64 {
    let s: secret i64 = 3;
    let w = wrap(s);
    0
}
