// Secret-flow conformance (review F3 / P2.2): the `||` short-circuit, the
// companion to `c52_secret_leak`'s `&&`. `a || b` on two `secret bool`s
// type-checks (the C3.1 `SecretBranch` source rejection covers only `if`), but
// lowers to a secret-dependent branch the MIR D5 pass rejects
// (`sentinel::mir::secret_leak`). Both short-circuit operators are sinks.
fn leaky(a: secret bool, b: secret bool) -> secret bool {
    a || b
}

fn main() -> i64 {
    0
}
