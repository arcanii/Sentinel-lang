// ADR 0016 A2: an array of `secret` elements is refused as any array is. A comparison's
// result is `secret bool` when an operand's outer type is `secret`; an array's elements are
// not its outer type, which is why a comparison takes scalars only. Surfaces Mismatch at the
// left operand.

fn same(a: [secret i64], b: [secret i64]) -> bool {
    a == b
}

fn main() -> i64 {
    0
}
