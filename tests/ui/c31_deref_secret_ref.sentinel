// C3.1 / ADR 0019 D7: dereferencing a `secret &T` (a secret POINTER, distinct from `& secret T`,
// a pointer to a secret) makes the address read depend on the secret, which leaks through the
// cache. Surfaces SecretInRefDeref at the operand.

fn read(r: secret &i64) -> secret i64 {
    *r
}

fn main() -> i64 {
    0
}
