// C4.4 / ADR 0024 D7: at C4.4 minimum `Task<T>` is restricted to
// `Task<i64>`. Spawning a fn whose return type isn't `i64` (here
// `bool`) is rejected with SpawnResultMustBeI64.
//
// Expected: compile error `sentinel::types::spawn_result_must_be_i64`.

fn flag() -> bool {
    true
}

fn main() -> i64 {
    spawn flag();
    0
}
