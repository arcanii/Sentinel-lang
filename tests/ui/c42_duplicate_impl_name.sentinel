// C4.2 (2/N) / ADR 0023 D8: two named impls sharing the same name
// are rejected at resolve (Pass 0e coherence check). Named impls
// must be uniquely named within their scope.
//
// Expected: snc rejects with `sentinel::resolve::duplicate_impl_name`.

trait Writer {
    fn write(self: &mut Self, data: i64) -> i64;
}

class FileSink {
    let count: i64;
    pub init() {
        self.count = 0;
        0
    }
}

impl Doubling as Writer for FileSink {
    fn write(self: &mut Self, data: i64) -> i64 {
        data
    }
}

impl Doubling as Writer for FileSink {
    fn write(self: &mut Self, data: i64) -> i64 {
        data * 2
    }
}

fn main() -> i64 { 0 }
