// ADR 0016 A2: the rule reads the operand's type once an outer `secret` is stripped, so a
// `secret` array is refused as an array is (its `secret` is no scalar's). Surfaces Mismatch at
// the left operand.

fn same(a: secret [i64], b: secret [i64]) -> secret bool {
    a == b
}

fn main() -> i64 {
    0
}
