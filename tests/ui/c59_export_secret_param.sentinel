// The FFI secret fence at an `export "C"` fn (ADR 0059): its C caller is outside the verified
// constant-time region, so a `secret` parameter is refused (a secret crosses only through an
// explicit `declassify` inside the export). Surfaces ExternFfiType at the parameter.

export "C" fn mix(x: secret i64) -> i64 {
    declassify(x)
}

fn main() -> i64 {
    0
}
