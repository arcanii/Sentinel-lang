// ADR 0071 D2 amendment A1: a `Shared` handle cannot be `secret`-qualified. A handle is a
// pointer to a refcounted cell, not a value to keep secret; the secret belongs inside the
// container, `Shared<secret T>` (ADR 0071 D6). Surfaces SecretHandle at the annotation.

fn main() -> i64 {
    let s: Shared<i64> = shared_new(5);
    let v: secret Shared<i64> = s;
    shared_get(s)
}
