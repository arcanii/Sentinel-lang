// Secret-flow conformance (ADR 0026 A1): a handler arm's body is lowered to MIR like
// any other expression, so the `&&` short-circuit on `secret` operands in the arm
// below is a secret-dependent branch the MIR D5 pass catches with
// `sentinel::mir::secret_leak`, exactly as it would be in the handled body.
effect Io { read() -> i64; }

fn idb(s: secret bool) -> secret bool {
    s
}

fn one() -> i64 ! { Io } {
    let a: i64 = perform Io.read();
    a
}

fn run(a: secret bool, b: secret bool) -> i64 {
    handle one() with {
        Io.read(k) => {
            let t: secret bool = idb(a) && b;
            k(1)
        }
    }
}

fn main() -> i64 {
    run(true, false)
}
