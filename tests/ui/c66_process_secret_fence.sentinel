// ADR 0066 M2.2 / D8: the cross-process secret fence. The byte-pipe IPC payload
// is the PUBLIC type `[u8]`, so a `secret`-tainted byte array (`[secret u8]`, ADR
// 0047) cannot cross the process boundary — `process_write`'s second parameter is
// `[u8]`, and `[secret u8]` is a distinct type (`secret u8 != u8`, with no
// implicit secret->public coercion), so the call is rejected as a type mismatch.
// `declassify` remains the only sanctioned way to send formerly-secret data over a
// pipe — structurally the same fence the FFI boundary enforces. The program is
// rejected at the type level, before any runtime concern.
fn leak(secret_byte: secret u8) -> i64 ! { Subprocess } {
    let argv: [[u8]] = [];
    let p = process_spawn("cmd", argv);
    let payload: [secret u8] = [secret_byte];
    process_write(p, payload)
}

fn main() -> i64 {
    0
}
