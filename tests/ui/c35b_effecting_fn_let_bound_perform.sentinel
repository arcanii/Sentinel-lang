// C3.5(b) / ADR 0020 D7: an effecting fn whose body let-binds
// the result of a perform requires per-evaluation-site frame
// reification (capturing "the rest of the fn after the let")
// — that's C3.5(c) / C3.6. At C3.5(b) codegen surfaces
// `sentinel::codegen::effecting_fn_body_not_direct` and bails.

effect Io {
    read() -> i64;
}

fn do_work() -> i64 ! { Io } {
    let logged: i64 = perform Io.read();
    logged + 1
}

fn main() -> i64 {
    handle do_work() with {
        Io.read(k) => k(41)
    }
}
