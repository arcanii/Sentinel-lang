// Secret-flow conformance (review F3 / P2.2): taint must SURVIVE a function
// call. `idb(a)` funnels a `secret bool` through `MirOp::Call` (a conservative,
// non-precise lowering), but its result type stays `secret bool`, so the
// `&& b` short-circuit is still a secret-dependent branch the MIR D5 pass
// catches with `sentinel::mir::secret_leak`. If the Call funnel dropped the
// taint, this would compile — a constant-time false negative.
fn idb(s: secret bool) -> secret bool {
    s
}

fn leaky(a: secret bool, b: secret bool) -> secret bool {
    idb(a) && b
}

fn main() -> i64 {
    0
}
