// Secret-flow conformance (review F3 / P2.2): a secret-dependent memory
// address is a timing leak. Indexing `a[s]` with a `secret i64` is rejected
// at the SOURCE level (`sentinel::types::index_not_int` — an index must be a
// public integer), so a secret never reaches the `Load` index sink.
fn main() -> i64 {
    let a: [i64] = [1, 2, 3];
    let s: secret i64 = 1;
    a[s]
}
