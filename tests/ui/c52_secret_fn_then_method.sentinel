// Secret-flow conformance (ADR 0026 A2): `snc build`'s constant-time gate verifies each body
// once. The free fn `leaky`, written right before the class, branches on a `secret` (the `&&`
// short-circuit), and so does the class's method `pick`, written right after its `init`; the
// `init` and the method `get` after `pick` have none: the gate reports exactly two
// `sentinel::mir::secret_leak`s. (The self-hosted code generator verifies the `init` and each
// method in a function of its own, so it reports each leak once too.)
fn idb(s: secret bool) -> secret bool {
    s
}

fn main() -> i64 {
    let k = K::init();
    k.get()
}

fn leaky(a: secret bool, b: secret bool) -> secret bool {
    idb(a) && b
}

class K {
    let n: i64;
    pub init() {
        self.n = 1;
        0
    }
    pub fn pick(self: &Self, a: secret bool, b: secret bool) -> secret bool {
        idb(a) && b
    }
    pub fn get(self: &Self) -> i64 {
        self.n
    }
}
