// Secret-flow conformance (ADR 0026 A1): a handle's `return` arm is lowered to MIR
// like its operation arms, so the `&&` short-circuit on `secret` operands in it is a
// secret-dependent branch the MIR D5 pass catches with `sentinel::mir::secret_leak`.
effect Io { read() -> i64; }

fn idb(s: secret bool) -> secret bool {
    s
}

fn one() -> i64 ! { Io } {
    let a: i64 = perform Io.read();
    a
}

fn run(a: secret bool, b: secret bool) -> i64 {
    handle one() with {
        Io.read(k) => k(1),
        return v => {
            let t: secret bool = idb(a) && b;
            v
        }
    }
}

fn main() -> i64 {
    run(true, false)
}
