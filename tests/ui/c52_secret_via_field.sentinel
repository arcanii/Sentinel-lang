// Secret-flow conformance (review F3 / P2.2): taint must SURVIVE a struct
// field access. A `secret bool` field, read as `v.b`, funnels through
// `MirOp::Opaque` (the conservative struct/field lowering), but its result
// type stays `secret bool`, so `v.b && other` is a secret-dependent
// short-circuit branch the MIR D5 pass rejects (`sentinel::mir::secret_leak`).
struct S {
    b: secret bool,
}

fn leaky(v: S, other: secret bool) -> secret bool {
    v.b && other
}

fn main() -> i64 {
    0
}
