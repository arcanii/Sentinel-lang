// ADR 0070 D4 (generalized): a bare fn name used as a value is eligible only
// if the referenced fn is non-generic, non-builtin, effect-free, and takes
// EXACTLY one word-scalar param + returns a word-scalar. `add` takes TWO
// params (arity, not type shape, is the problem — a wrong-arity fn is
// ineligible under any Fn<T,R> instantiation), so it cannot be used as a
// value — surfaces FnValueSignatureNotSupported (a typed rejection, not a
// silent "use the wrong arity").
fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn apply_to(op: Fn<i64, i64>, x: i64) -> i64 {
    apply(op, x)
}

fn main() -> i64 {
    let op = add;
    apply_to(op, 1)
}
