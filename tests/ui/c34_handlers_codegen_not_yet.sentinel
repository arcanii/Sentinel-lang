// C3.4 / ADR 0020 D9: the handler surface parses, resolves, type-
// checks, effect-checks (Io is discharged by the handle, so main's
// row is empty), and borrow-checks. Codegen is the only missing
// piece — it surfaces `sentinel::codegen::handlers_not_yet_supported`
// at C3.4. Lands at C3.5 (perform codegen) + C3.6 (handle codegen)
// per ADR 0020 D9.

effect Io {
    read() -> i64;
}

fn do_work() -> i64 ! { Io } {
    perform Io.read()
}

fn main() -> i64 {
    handle do_work() with {
        Io.read(k) => k(42)
    }
}
