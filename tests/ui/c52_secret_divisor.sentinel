// Secret-flow conformance (review F3 / P2.2): division is variable-latency, so
// a secret divisor is a timing leak. `a / b` with a `secret i64` divisor is
// rejected at the SOURCE level (`sentinel::types::secret_divisor`), so a secret
// never reaches the `Binary(Div)` divisor sink. (The `declassify` wrapper is
// irrelevant — the division itself is rejected before its result is used.)
fn main() -> i64 {
    let a: secret i64 = 100;
    let b: secret i64 = 5;
    declassify(a / b)
}
