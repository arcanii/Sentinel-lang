// Register D97 (ADR 0041 A14): a struct literal may not name a field its struct does not
// declare. `snc` has always refused this; the self-hosted typer now refuses it too, with
// the same code, where it used to type the literal anyway.
// Surfaces UnknownField at `zzz`.

struct P { lo: i64, hi: i64 }

fn main() -> i64 {
    let p = P { zzz: 1, lo: 2, hi: 3 };
    p.lo
}
