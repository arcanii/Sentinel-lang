// ADR 0066 M1.2b: a `Channel<T>` type annotation whose element is not `i64` is
// rejected at the M1.2b minimum — channels carry `i64` (the singleton the channel
// builtins are typed against); generic word-scalar/aggregate element types are a
// follow-on. Here a `Channel<bool>` parameter surfaces ChannelElementNotSupported.
fn worker(ch: Channel<bool>) -> i64 {
    0
}

fn main() -> i64 {
    0
}
