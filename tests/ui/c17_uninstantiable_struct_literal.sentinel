// ADR 0016 A3: a generic struct literal's field type must be instantiable at the instance's
// type arguments. `P<?i64>`'s field `?T` would need a `?(?i64)`, which has no form.
// Surfaces UninstantiableType at the field.

struct P<T> {
    v: ?T,
}

fn main() -> i64 {
    let p: P<?i64> = P { v: null };
    0
}
