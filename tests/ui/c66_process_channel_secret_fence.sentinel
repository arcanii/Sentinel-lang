// ADR 0066 M2.3 / D8: the cross-process secret fence for the typed framed channel.
// `process_send(p, v)` carries the PUBLIC element type `i64`, so a `secret i64`
// cannot cross the process boundary — `secret i64 != i64`, with no implicit
// secret->public coercion, so the call is rejected as a type mismatch. `declassify`
// remains the only sanctioned way to send formerly-secret data over a pipe (or the
// M2.4 `SealedChannel<secret T>`, its own ADR) — structurally the same fence the FFI
// and M2.2 byte-pipe boundaries enforce. The program is rejected at the type level,
// before any runtime concern.
fn leak(s: secret i64) -> i64 ! { Subprocess } {
    let argv: [[u8]] = [];
    let p = process_spawn("cmd", argv);
    process_send(p, s)
}

fn main() -> i64 {
    0
}
